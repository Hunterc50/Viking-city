      <Item class="StringValue" referent="3">
        <Properties>
          <string name="Name">_HowToUse</string>
          <string name="Value">Drop your own models (meshes) in this folder to replace the built-in ones. Name each one exactly like a slot: Longhouse, Cottage, Woodcutter, Quarry, Farm, Storehouse, Palisade, Tree_Pine, Tree_Birch, Rock, Bush, Dock, Deer, Axe, Pickaxe, Bow (Axe/Pickaxe/Bow must be Tools with a Handle). Anything missing uses the built-in version.</string>
        </Properties>
      </Item>
