-- Sea battles: ship health, broadside volleys (F at the helm) and ramming.
Config.Naval = {
	KarveHull = 120,
	LongshipHull = 220,
	VolleyDamage = 14, -- per arrow hit on a ship; 5 arrows a volley
	VolleyArrows = 5,
	VolleyRange = 80,
	VolleyCooldown = 3,
	RamDamage = 60, -- at full speed (longships hit 1.5x harder)
	RamSelfDamage = 12,
