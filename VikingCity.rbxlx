          <X>700</X>
          <Y>-8</Y>
          <Z>0</Z>
        </Vector3>
        <Vector3 name="size">
          <X>2400</X>
          <Y>16</Y>
          <Z>2048</Z>
        </Vector3>
        <token name="TopSurface">0</token>
      </Properties>
    </Item>
    <Item class="BoolValue" referent="73">
      <Properties>
        <string name="Name">ShowModelWorkshop</string>
        <bool name="Value">false</bool>
      </Properties>
    </Item>
    <Item class="SpawnLocation" referent="74">
      <Properties>
        <string name="Name">SpawnLocation</string>
        <bool name="Anchored">true</bool>
        <Color3uint8 name="Color3uint8">7889218</Color3uint8>
        <int name="Duration">0</int>
        <token name="Material">528</token>
        <Vector3 name="Position">
          <X>80</X>
          <Y>0.5</Y>
          <Z>-30</Z>
        </Vector3>
        <Vector3 name="size">
          <X>12</X>
          <Y>1</Y>
          <Z>12</Z>
        </Vector3>
        <token name="TopSurface">0</token>
      </Properties>
    </Item>
    <Item class="Part" referent="75">
      <Properties>
        <string name="Name">WelcomeSign</string>
        <bool name="Anchored">true</bool>
        <Color3uint8 name="Color3uint8">5060132</Color3uint8>
        <token name="Material">512</token>
        <Vector3 name="Position">
          <X>80</X>
          <Y>9</Y>
          <Z>-44</Z>
        </Vector3>
        <Vector3 name="size">
          <X>30</X>
          <Y>10</Y>
          <Z>1</Z>
        </Vector3>
      </Properties>
      <Item class="SurfaceGui" referent="76">
        <Properties>
          <string name="Name">BackText</string>
          <token name="Face">2</token>
          <float name="PixelsPerStud">20</float>
        </Properties>
        <Item class="TextLabel" referent="77">
          <Properties>
            <string name="Name">Text</string>
            <Color3 name="BackgroundColor3">
              <R>0.13</R>
              <G>0.11</G>
              <B>0.09</B>
            </Color3>
