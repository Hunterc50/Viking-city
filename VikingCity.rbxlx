      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--[[
	Config
	All the numbers that shape the game live here, so you can tweak balance
	without touching any game logic. Shared by the server and the client.
]]

local Config = {}

-- World / grid ------------------------------------------------------------
Config.CELL = 8 -- studs per grid cell
Config.PLOT_CELLS = 20 -- each colony plot is 20 x 20 cells
Config.PLOT_GAP = 48 -- studs of wilderness between neighbouring plots
Config.MAX_PLOTS = 8
Config.GROUND_Y = 1 -- height of the top of the plot ground

-- Simulation --------------------------------------------------------------
Config.TICK = 1 -- seconds between simulation steps
Config.DAY_LENGTH = 60 -- real seconds per in-game day

-- Resources ---------------------------------------------------------------
Config.ResourceOrder = { "Wood", "Stone", "Food", "Hides", "Silver", "Lore" }
Config.StartingResources = { Wood = 80, Stone = 20, Food = 40, Hides = 0, Silver = 0, Lore = 0 }
Config.BaseStorage = 200 -- max of each resource before any storehouse

-- Villagers ---------------------------------------------------------------
Config.Villagers = {
	Starting = 3,
	FoodPerAdultPerSecond = 0.1, -- 6 food per adult per day
	FoodPerChildPerSecond = 0.05,
	BabyDays = 1, -- babies toddle after a parent for their first day
	DaysToAdulthood = 3, -- then children play, and grow up after 3 days
	ElderAge = 30, -- adults grey and grow beards after 30 days
	MarriageChancePerDay = 0.5, -- two single adults may marry and share a home
	WalkSpeed = 7, -- studs per second for the little villager figures

	BirthMinHappiness = 50,
	BirthChancePerDay = 0.6,

	ImmigrationMinHappiness = 65,
	ImmigrationChancePerDay = 0.5,
	ImmigrationMaxGroup = 3,

	LeaveBelowHappiness = 25,
}

Config.Names = {
	"Astrid", "Bjarni", "Sigrid", "Leif", "Ingrid", "Gunnar", "Solveig", "Ulf",
	"Hilda", "Toke", "Runa", "Arne", "Halla", "Knut", "Ylva", "Sven",
	"Thyra", "Orm", "Gudrun", "Ketil", "Eydis", "Hakon", "Brynja", "Vali",
	"Ragna", "Dagr", "Signy", "Asger", "Tove", "Hrolf",
}

-- Fictional neighbouring tribes that send immigrants.
Config.Tribes = { "Ravenfjord clan", "Ashvale folk", "Stormholm kin", "Elkmarsh tribe", "Greywater clan" }

-- Wild resource nodes on each plot -----------------------------------------
Config.Nodes = {
	-- Tool = which tool must be held to gather it (nil = bare hands)
	-- Hits = swings needed with the right tool (better tools need fewer)
	Tree = { Count = 34, Regrow = 22, Gives = "Wood", Amount = 10, Action = "Chop", Hold = 0.8, Tool = "Axe", Hits = 5 },
	Rock = { Count = 12, Regrow = 4, Gives = "Stone", Amount = 8, Action = "Mine", Hold = 1.2, Tool = "Pickaxe", Hits = 6 },
	Bush = { Count = 10, Regrow = 6, Gives = "Food", Amount = 6, Action = "Forage", Hold = 0.6 },
}
Config.NodeRegrowInterval = 20 -- seconds between regrowth attempts

Config.AutosaveSeconds = 60 -- how often villages are saved

-- Buildings ---------------------------------------------------------------
--[[
	Size      = footprint in cells {x, z} before rotation
	Cost      = resources spent to place it
	Housing   = villagers it can shelter
	Workers   = job slots
	Produces  = resource per worker per second (scaled by happiness)
	Storage   = extra capacity for every resource
]]
Config.Buildings = {
	Longhouse = {
		Display = "Longhouse",
		Description = "Shelter for 5 villagers. Free housing attracts births and immigrants.",
		Size = { 4, 2 },
		Cost = { Wood = 40, Stone = 10 },
		Housing = 5,
	},
	Cottage = {
		Display = "A-frame Cottage",
		Description = "A small steep-roofed home for 3 villagers.",
		Size = { 2, 2 },
		Cost = { Wood = 25 },
		Housing = 3,
	},
	Woodcutter = {
		Display = "Woodcutter",
		Description = "2 workers fell timber.",
		Size = { 2, 2 },
		Cost = { Wood = 20 },
		Workers = 2,
		Produces = { Wood = 0.5 },
	},
	Quarry = {
		Display = "Quarry",
		Description = "2 workers cut stone.",
		Size = { 2, 2 },
		Cost = { Wood = 30 },
		Workers = 2,
		Produces = { Stone = 0.3 },
	},
	Farm = {
		Display = "Barley Farm",
		Description = "2 workers grow food.",
		Size = { 3, 3 },
		Cost = { Wood = 25 },
		Workers = 2,
		Produces = { Food = 0.4 },
	},
	Storehouse = {
		Display = "Storehouse",
		Description = "+200 storage for every resource.",
		Size = { 2, 3 },
		Cost = { Wood = 40, Stone = 20 },
		Storage = 200,
	},
	LoreHall = {
		Display = "Lore Hall",
		Description = "2 skalds gather Lore, which pays for research (press T).",
		Size = { 3, 2 },
		Cost = { Wood = 50, Stone = 20 },
		Workers = 2,
		Produces = { Lore = 0.12 },
	},
	Smithy = {
		Display = "Smithy",
		Description = "A forge. Needed to research gear. 1 smith makes silver goods.",
		Size = { 2, 2 },
		Cost = { Wood = 30, Stone = 30 },
		Workers = 1,
		Produces = { Silver = 0.05 },
	},
	Shrine = {
		Display = "Shrine",
		Description = "Standing stones and a carved idol. +5 happiness; unlocks the patron paths.",
		Size = { 2, 2 },
		Cost = { Stone = 40, Silver = 10 },
		Happiness = 5,
	},
	Shipyard = {
		Display = "Shipyard",
		Description = "Builds ships. Needed to research boats; launch them from your dock.",
		Size = { 3, 4 },
		Cost = { Wood = 90, Stone = 20 },
	},
	HuntingLodge = {
		Display = "Hunting Lodge",
		Description = "2 hunters bring back meat and hides.",
		Size = { 2, 2 },
		Cost = { Wood = 30, Hides = 4 },
		Workers = 2,
		Produces = { Food = 0.25, Hides = 0.04 },
		Requires = "Trapping",
	},
	GreatHall = {
		Display = "Great Hall",
		Description = "A chieftain's hall for 10 people. +5 happiness.",
		Size = { 5, 3 },
		Cost = { Wood = 140, Stone = 60, Silver = 20 },
		Housing = 10,
		Happiness = 5,
		Requires = "Chieftainship",
	},
	Palisade = {
		Display = "Palisade",
		Description = "A section of sharpened-log wall. Raiders must hack through it, which slows them down. Place many in a row.",
		Size = { 1, 1 },
		Cost = { Wood = 3 },
	},
	Watchtower = {
		Display = "Watchtower",
		Description = "A tall lookout. Its archer shoots at raiders who attack your village.",
		Size = { 2, 2 },
		Cost = { Wood = 40, Stone = 15 },
		Workers = 1,
	},
}

-- Tabs of the build menu, in order, and the buildings on each tab.
-- Icon is an emoji shown on the tab and on each building card.
Config.BuildCategories = {
	{ Name = "Housing", Icon = "🏠", Buildings = { "Longhouse", "Cottage", "GreatHall" } },
	{ Name = "Production", Icon = "🌾", Buildings = { "Farm", "Woodcutter", "Quarry", "HuntingLodge", "Storehouse" } },
	{ Name = "Lore & Craft", Icon = "📜", Buildings = { "LoreHall", "Smithy" } },
	{ Name = "Faith", Icon = "🔥", Buildings = { "Shrine" } },
	{ Name = "War & Sea", Icon = "⚔️", Buildings = { "Palisade", "Watchtower", "Shipyard" } },
}

Config.BuildingIcons = {
	Longhouse = "🏠", Cottage = "🏡", GreatHall = "🏰",
	Farm = "🌾", Woodcutter = "🪓", Quarry = "⛏️", HuntingLodge = "🦌", Storehouse = "📦",
	LoreHall = "📜", Smithy = "⚒️", Shrine = "🗿", Palisade = "🛡️", Watchtower = "🏹", Shipyard = "⛵",
}

-- Every building in menu order (built from the tabs above).
Config.BuildOrder = {}
for _, category in Config.BuildCategories do
	for _, b in category.Buildings do
		table.insert(Config.BuildOrder, b)
	end
end

-- Tools every player carries (built in ModelFactory.tool).
Config.Tools = { "Axe", "Pickaxe", "Bow", "Torch", "Sword" }

-- Wildlife ------------------------------------------------------------------
Config.Wildlife = {
	DeerPerPlot = 4, -- deer roaming the meadow behind each plot
	RespawnSeconds = 45,
	Speed = 9,
	FleeSpeed = 22,
	FleeDistance = 22, -- deer bolt when a player gets this close
	Meat = 15, -- Food from one deer
	Hides = 2,
}

-- The rival village you can raid ---------------------------------------------
Config.Rival = {
	Name = "Greywater Hold",
	Center = Vector3.new(-170, 1, 100), -- west end of the valley, past plot 1
	Radius = 92, -- palisade ring
	Defenders = 9, -- axemen who charge
	Archers = 4, -- bowmen who hold the walls and shoot from range
	DefenderHealth = 150,
	DefenderDamage = 14,
	ArcherDamage = 9,
	ArcherRange = 95,
	ArcherCooldown = 2.6,
	DefenderAggro = 70, -- studs from the village centre they will chase you
	Villagers = 4, -- folk you can offer a new home once the guards fall
	ChestLoot = { Food = 120, Silver = 45, Wood = 70, Hides = 6 },
	BurnSeconds = 25,
	RegenSeconds = 300, -- after a raid the hold rebuilds itself in 5 minutes
}

-- A second, smaller hold at the far east end of the valley, past the last
-- plot. Its gate faces west, toward the player plots.
Config.Rival2 = {
	Name = "Ravensfell",
	Center = Vector3.new(Config.MAX_PLOTS * (Config.PLOT_CELLS * Config.CELL + Config.PLOT_GAP) - Config.PLOT_GAP + 170, 1, 90),
	Radius = 72,
	GateAngle = math.pi,
	Defenders = 7,
	Archers = 3,
	DefenderHealth = 130,
	DefenderDamage = 12,
	ArcherDamage = 8,
	ArcherRange = 90,
	ArcherCooldown = 2.8,
	DefenderAggro = 60,
	Villagers = 3,
	ChestLoot = { Food = 90, Silver = 35, Stone = 60, Hides = 4 },
	BurnSeconds = 25,
	RegenSeconds = 300,
	Layout = {
		{ "Longhouse", Vector3.new(0, 0, 36) },
		{ "Cottage", Vector3.new(-40, 0, -18) },
		{ "Cottage", Vector3.new(40, 0, -20) },
		{ "Smithy", Vector3.new(-38, 0, 24) },
		{ "Storehouse", Vector3.new(0, 0, -42) },
	},
}

-- Every rival hold in the valley.
Config.Rivals = { Config.Rival, Config.Rival2 }

Config.Combat = {
	-- melee damage per blow by what you're holding: tools barely scratch,
	-- the Sword is the real weapon
	MeleeDamage = { Axe = 8, Pickaxe = 8, Sword = 40 },
	ArrowDamage = 50,
	StrikeRange = 8,
	StrikeCooldown = 0.6,
}

-- Trading at the stall on your beach. Each offer swaps Give for Get.
-- Prices shift with the seasons (Season = multiplier on what you GIVE).
Config.Trade = {
	Offers = {
		{ Give = { Wood = 40 }, Get = { Silver = 4 } },
		{ Give = { Stone = 30 }, Get = { Silver = 4 } },
		{ Give = { Food = 50 }, Get = { Silver = 5 }, Season = { Autumn = 0.8, Winter = 1.6 } },
		{ Give = { Hides = 4 }, Get = { Silver = 6 } },
		{ Give = { Silver = 5 }, Get = { Food = 40 }, Season = { Winter = 1.6, Summer = 0.8 } },
		{ Give = { Silver = 5 }, Get = { Wood = 50 } },
		{ Give = { Silver = 6 }, Get = { Stone = 40 } },
		{ Give = { Silver = 10 }, Get = { Lore = 8 } },
	},
}

-- The saga: a chain of goals that teaches the game, shown top left.
-- Kind: "stat" (something you did, counted), "building", "population",
-- "tech" (number researched). Rewards are added when a goal is done.
Config.Quests = {
	{ Title = "Fell your first trees", Text = "Press 1 for the Axe, walk up to a tree and click to swing until it falls.", Kind = "stat", Stat = "chop", Goal = 3, Reward = { Wood = 15 } },
	{ Title = "Plant barley", Text = "Open the Production tab and build a Barley Farm so nobody starves.", Kind = "building", Building = "Farm", Goal = 1, Reward = { Food = 20 } },
	{ Title = "A woodcutter's hut", Text = "Build a Woodcutter. Idle villagers will take the jobs.", Kind = "building", Building = "Woodcutter", Goal = 1, Reward = { Wood = 20 } },
	{ Title = "Break some stone", Text = "Press 2 for the Pickaxe, walk up to a rock and click to swing until it breaks.", Kind = "stat", Stat = "mine", Goal = 2, Reward = { Stone = 15 } },
	{ Title = "The hunt", Text = "Press 3 for the Bow and shoot a deer in the meadow behind your plot.", Kind = "stat", Stat = "deer", Goal = 1, Reward = { Food = 20 } },
	{ Title = "Strike a bargain", Text = "Visit Ottar's stall on your beach (hold E) and make a trade.", Kind = "stat", Stat = "trade", Goal = 1, Reward = { Silver = 5 } },
	{ Title = "Room to grow", Text = "Build an A-frame Cottage (Housing tab). Free beds bring babies and newcomers.", Kind = "building", Building = "Cottage", Goal = 1, Reward = { Wood = 20, Stone = 10 } },
	{ Title = "Keepers of lore", Text = "Build a Lore Hall. Its skalds earn Lore for research.", Kind = "building", Building = "LoreHall", Goal = 1, Reward = { Lore = 10 } },
	{ Title = "New knowledge", Text = "Press T and research anything.", Kind = "tech", Goal = 1, Reward = { Wood = 30 } },
	{ Title = "A growing village", Text = "Reach 8 people. Keep everyone fed, housed and happy.", Kind = "population", Goal = 8, Reward = { Silver = 10 } },
	{ Title = "Plunder Greywater", Text = "Walk west to Greywater Hold, beat its guards and plunder a chest (E).", Kind = "stat", Stat = "plunder", Goal = 1, Reward = { Silver = 10 } },
	{ Title = "Shipwrights", Text = "Build a Shipyard (War & Sea tab).", Kind = "building", Building = "Shipyard", Goal = 1, Reward = { Wood = 40 } },
	{ Title = "Take to the sea", Text = "Research Karve (T), then hold E at the end of your jetty to launch.", Kind = "stat", Stat = "launch", Goal = 1, Reward = { Food = 30 } },
	{ Title = "Master of the fjord", Text = "Sink the Greywater Raider ship: F for volleys, or ram it at full speed.", Kind = "stat", Stat = "sunk", Goal = 1, Reward = { Silver = 20 } },
	{ Title = "Hold the line", Text = "Build a Watchtower, then beat off a raid on your village.", Kind = "stat", Stat = "defend", Goal = 1, Reward = { Silver = 15, Wood = 40 } },
	{ Title = "A chieftain's hall", Text = "Research Chieftainship and build a Great Hall.", Kind = "building", Building = "GreatHall", Goal = 1, Reward = { Silver = 30, Lore = 20 } },
}

-- Rival warbands raid YOUR village every few days. Fight them off, build
-- Palisades to slow them and Watchtowers (with an archer) to shoot them.
-- Raiders who reach your stores carry off a share; nothing is destroyed.
Config.VillageRaids = {
	Enabled = true,
	FirstDay = 4, -- no raids before this day
	EveryDays = { 2, 4 }, -- then one every 2 to 4 days
	WarningSeconds = 40,
	BaseRaiders = 2, -- plus one per 4 days survived, up to MaxRaiders
	MaxRaiders = 8,
	RaiderHealth = 90,
	RaiderDamage = 9,
	StealShare = 0.12, -- each raider who reaches the stores takes 12% of each resource
	StealCap = 60,
	TowerRange = 75,
	TowerDamage = 30,
	TowerCooldown = 2,
	Reward = { Silver = 10, Hides = 2 }, -- for beating off the whole warband
	LeaveAfter = 150, -- seconds before the raiders give up and go home
}

-- Raiding other players' villages (they must be in the same server).
-- Villages are never destroyed: the raider fights the village militia and,
-- if every militia falls, plunders a share of the stores.
Config.TownRaid = {
	MinDay = 3, -- both villages must have reached this day (newcomer protection)
	ShieldSeconds = 600, -- a raided village can't be raided again for 10 minutes
	FailedShieldSeconds = 120,
	AttackerCooldown = 300, -- a raider must wait 5 minutes between raids
	Duration = 150, -- seconds to win the raid
	MilitiaPerAdult = 0.5,
	MinMilitia = 2,
	MaxMilitia = 6,
	MilitiaHealth = 90,
	MilitiaDamage = 8,
	LootShare = 0.2, -- the victor takes 20% of each resource...
	LootCap = 150, -- ...but at most this much of each
}

-- Sea battles: ship health, broadside volleys (F at the helm) and ramming.
Config.Naval = {
	KarveHull = 120,
	LongshipHull = 220,
	VolleyDamage = 14, -- per arrow hit on a ship; 5 arrows a volley
	VolleyArrows = 5,
	VolleyRange = 80,
	VolleyCooldown = 3,
	RamDamage = 60, -- at full speed (longships hit 1.5x harder)
	RamSelfDamage = 12,
	RepairPerSecond = 4, -- hull repaired while moored by your jetty
	-- the Greywater raider ship that patrols the fjord
	RaiderHull = 180,
	RaiderSpeed = 26,
	RaiderAggro = 150,
	RaiderRespawn = 180,
	RaiderLoot = { Silver = 25, Food = 30, Wood = 40 },
}

Config.Bow = {
	Range = 140,
	Cooldown = 0.9,
	ArrowSpeed = 160,
}

Config.DemolishRefund = 0.5 -- fraction of the cost returned

-- Research ------------------------------------------------------------------
--[[
	Each tech: Branch, Name, Description, Cost, Requires (other tech ids),
	Building (a building you must own first), Group (only one tech per group,
	used for the patron paths). Effects are read by the services via
	ColonyService:Has(colony, id).
]]
Config.TechBranches = { "Buildings", "Gear", "Boats", "Culture", "Religion" }
Config.Tech = {
	-- Buildings
	CropRotation = { Branch = "Buildings", Name = "Crop Rotation", Description = "Farms grow 25% more.", Cost = { Lore = 15 } },
	Masonry = { Branch = "Buildings", Name = "Masonry", Description = "Quarries cut 30% more stone, and you break rocks faster.", Cost = { Lore = 20 } },
	Trapping = { Branch = "Buildings", Name = "Trapping", Description = "Unlocks the Hunting Lodge.", Cost = { Lore = 20 } },
	Chieftainship = { Branch = "Buildings", Name = "Chieftainship", Description = "Unlocks the Great Hall.", Cost = { Lore = 60, Silver = 20 }, Requires = { "Masonry" } },
	-- Gear (needs a Smithy)
	IronAxes = { Branch = "Gear", Name = "Iron Blades", Description = "Chop 50% more wood with fewer swings, and your Sword hits 50% harder.", Cost = { Lore = 20, Stone = 30 }, Building = "Smithy" },
	Longbows = { Branch = "Gear", Name = "Yew Longbows", Description = "Arrows hit 50% harder and fly further.", Cost = { Lore = 25, Wood = 40 }, Building = "Smithy" },
	ChainMail = { Branch = "Gear", Name = "Ring Mail", Description = "You have 150 health instead of 100.", Cost = { Lore = 40, Silver = 25 }, Building = "Smithy", Requires = { "IronAxes" } },
	SteelEdges = { Branch = "Gear", Name = "Steel Edges", Description = "Sword blows hit twice as hard.", Cost = { Lore = 60, Silver = 30 }, Building = "Smithy", Requires = { "IronAxes" } },
	-- Boats (needs a Shipyard)
	Karve = { Branch = "Boats", Name = "Karve", Description = "Launch a small boat from your dock and sail the fjord.", Cost = { Lore = 30, Wood = 80 }, Building = "Shipyard" },
	Longship = { Branch = "Boats", Name = "Longship", Description = "Launch a fast war longship instead.", Cost = { Lore = 70, Wood = 150, Silver = 20 }, Building = "Shipyard", Requires = { "Karve" } },
	SeaRaiders = { Branch = "Boats", Name = "Sea Raiders", Description = "Plunder 50% more from chests.", Cost = { Lore = 50 }, Requires = { "Karve" } },
	-- Culture
	SagaTellers = { Branch = "Culture", Name = "Saga Tellers", Description = "Lore Halls gather 50% more lore.", Cost = { Lore = 20 } },
	Feasting = { Branch = "Culture", Name = "Feasting", Description = "+10 happiness.", Cost = { Lore = 30, Food = 60 } },
	Woodcraft = { Branch = "Culture", Name = "Woodcraft", Description = "Woodcutters work 30% faster.", Cost = { Lore = 25 } },
	OpenArms = { Branch = "Culture", Name = "Open Arms", Description = "Twice as many immigrants arrive.", Cost = { Lore = 45 }, Requires = { "Feasting" } },
	-- Religion (needs a Shrine; pick ONE patron path)
	PathStorm = { Branch = "Religion", Name = "Path of the Storm", Description = "Patron of the sea: raids plunder 50% more, guards hit you 30% softer.", Cost = { Lore = 40 }, Building = "Shrine", Group = "Patron" },
	PathHearth = { Branch = "Religion", Name = "Path of the Hearth", Description = "Patron of home: twice the births, +10 happiness.", Cost = { Lore = 40 }, Building = "Shrine", Group = "Patron" },
	PathWoods = { Branch = "Religion", Name = "Path of the Deep Woods", Description = "Patron of the wild: double hand gathering and hunting.", Cost = { Lore = 40 }, Building = "Shrine", Group = "Patron" },
	MidwinterRite = { Branch = "Religion", Name = "Midwinter Rite", Description = "Winter no longer makes your people eat more.", Cost = { Lore = 50, Food = 40 }, Building = "Shrine" },
}

-- Seasons -------------------------------------------------------------------
-- The year turns for everyone on the server. Each season lasts SeasonSeconds.
Config.SeasonSeconds = 180
Config.Seasons = {
	{ Name = "Summer", FarmRate = 1.25, FoodUse = 1.0 },
	{ Name = "Autumn", FarmRate = 0.8, FoodUse = 1.0 },
	{ Name = "Winter", FarmRate = 0, FoodUse = 1.5 }, -- frozen fields, cold bellies
	{ Name = "Spring", FarmRate = 0.9, FoodUse = 1.0 },
}

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">Grid</string>
          <string name="Source"><![CDATA[--[[
	Grid
	Pure math helpers for the building grid. Cells are addressed by integer
	(x, z) starting at 0 in the plot's corner. A building is placed by its
	minimum corner cell plus a rotation (0 = default, 1 = turned 90 degrees).
]]

local Config = require(script.Parent.Config)

local Grid = {}

local CELL = Config.CELL
local N = Config.PLOT_CELLS

Grid.PLOT_SIZE = CELL * N

function Grid.key(x: number, z: number): string
	return x .. "," .. z
end

-- World-space corner (min x, min z, ground top) of plot number `index` (1-based).
function Grid.plotOrigin(index: number): Vector3
	return Vector3.new((index - 1) * (Grid.PLOT_SIZE + Config.PLOT_GAP), Config.GROUND_Y, 0)
end

-- Footprint in cells after rotation.
function Grid.footprint(buildingType: string, rot: number): (number, number)
	local def = Config.Buildings[buildingType]
	local sx, sz = def.Size[1], def.Size[2]
	if rot % 2 == 1 then
		return sz, sx
	end
	return sx, sz
end

function Grid.inBounds(cx: number, cz: number, sx: number, sz: number): boolean
	return cx >= 0 and cz >= 0 and cx + sx <= N and cz + sz <= N
end

-- Calls fn(x, z) for every cell covered by the rectangle.
function Grid.eachCell(cx: number, cz: number, sx: number, sz: number, fn: (number, number) -> ())
	for x = cx, cx + sx - 1 do
		for z = cz, cz + sz - 1 do
			fn(x, z)
		end
	end
end

-- `blocked` is a set: { ["x,z"] = true/anything }.
function Grid.canPlace(blocked, cx: number, cz: number, sx: number, sz: number): (boolean, string?)
	if not Grid.inBounds(cx, cz, sx, sz) then
		return false, "Outside your land"
	end
	local free = true
	Grid.eachCell(cx, cz, sx, sz, function(x, z)
		if blocked[Grid.key(x, z)] then
			free = false
		end
	end)
	if not free then
		return false, "Something is in the way (clear trees and rocks first)"
	end
	return true, nil
end

-- World position of the centre of a rectangle of cells, at ground level.
function Grid.rectCenter(origin: Vector3, cx: number, cz: number, sx: number, sz: number): Vector3
	return origin + Vector3.new((cx + sx / 2) * CELL, 0, (cz + sz / 2) * CELL)
end

-- The CFrame a building model should be pivoted to.
function Grid.buildingCFrame(origin: Vector3, cx: number, cz: number, sx: number, sz: number, rot: number): CFrame
	return CFrame.new(Grid.rectCenter(origin, cx, cz, sx, sz)) * CFrame.Angles(0, rot * math.pi / 2, 0)
end

-- Converts a world point to the min-corner cell of a footprint centred on it.
function Grid.worldToCell(origin: Vector3, pos: Vector3, sx: number, sz: number): (number, number)
	local local_ = pos - origin
	local cx = math.floor(local_.X / CELL - sx / 2 + 0.5)
	local cz = math.floor(local_.Z / CELL - sz / 2 + 0.5)
	return cx, cz
end

function Grid.canAfford(resources, cost): boolean
	for name, amount in cost do
		if (resources[name] or 0) < amount then
			return false
		end
	end
	return true
end

function Grid.costText(cost): string
	local parts = {}
	for _, name in Config.ResourceOrder do
		if cost[name] then
			table.insert(parts, cost[name] .. " " .. name)
		end
	end
	return table.concat(parts, "  ")
end

return Grid
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">ModelFactory</string>
          <string name="Source"><![CDATA[--[[
	ModelFactory
	Builds every model in the game out of plain Parts, so the game needs no
	imported assets. Every model is built around (0, 0, 0) = centre of its
	footprint at ground level, and its WorldPivot is set there, so callers just
	do model:PivotTo(cframe).

	MESH SWAP: put a model (or Tool) in ReplicatedStorage > Assets with one of
	the slot names in ModelFactory.Slots and the game uses it instead of the
	part-built version. Buildings are scaled to fit their footprint.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(script.Parent.Config)

local ModelFactory = {}

local CELL = Config.CELL
local V3 = Vector3.new

local Colors = {
	Wood = Color3.fromRGB(128, 90, 58),
	DarkWood = Color3.fromRGB(74, 52, 36),
	Weathered = Color3.fromRGB(104, 92, 78),
	Thatch = Color3.fromRGB(176, 146, 88),
	Shingle = Color3.fromRGB(86, 62, 44),
	Turf = Color3.fromRGB(88, 112, 58),
	Stone = Color3.fromRGB(124, 124, 120),
	Soil = Color3.fromRGB(92, 66, 44),
	Barley = Color3.fromRGB(206, 178, 92),
	Pine = Color3.fromRGB(38, 70, 44),
	PineLight = Color3.fromRGB(52, 86, 50),
	Leaf = Color3.fromRGB(70, 112, 56),
	Birch = Color3.fromRGB(222, 218, 205),
	Berry = Color3.fromRGB(170, 34, 46),
	Skin = Color3.fromRGB(234, 196, 160),
	Lantern = Color3.fromRGB(255, 170, 80),
	Iron = Color3.fromRGB(90, 92, 98),
}
ModelFactory.Colors = Colors

local Tunics = {
	Color3.fromRGB(150, 60, 50),
	Color3.fromRGB(60, 86, 130),
	Color3.fromRGB(86, 110, 66),
	Color3.fromRGB(168, 138, 82),
	Color3.fromRGB(108, 78, 112),
	Color3.fromRGB(122, 112, 100),
}
local Hair = {
	Color3.fromRGB(196, 150, 80),
	Color3.fromRGB(150, 74, 40),
	Color3.fromRGB(80, 56, 38),
	Color3.fromRGB(220, 200, 150),
}

local function addPart(model: Instance, props)
	local p = Instance.new(props.Class or "Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if props.Shape then
		p.Shape = props.Shape
	end
	p.Size = props.Size
	p.CFrame = props.CFrame or CFrame.new(props.Position or Vector3.zero)
	p.Color = props.Color or Colors.Wood
	p.Material = props.Material or Enum.Material.Wood
	p.Name = props.Name or "Part"
	if props.CanCollide == false then
		p.CanCollide = false
	end
	p.Parent = model
	return p
end
ModelFactory.addPart = addPart

-- A vertical log (cylinder) standing at `pos` (its bottom on pos.Y).
local function post(model, pos: Vector3, height: number, diameter: number, color: Color3?)
	return addPart(model, {
		Shape = Enum.PartType.Cylinder,
		Size = V3(height, diameter, diameter),
		CFrame = CFrame.new(pos + V3(0, height / 2, 0)) * CFrame.Angles(0, 0, math.pi / 2),
		Color = color or Colors.DarkWood,
	})
end

local function lantern(model, cf: CFrame)
	local l = addPart(model, {
		Name = "Lantern",
		Size = V3(0.6, 0.8, 0.6),
		CFrame = cf,
		Color = Colors.Lantern,
		Material = Enum.Material.Neon,
		CanCollide = false,
	})
	local light = Instance.new("PointLight")
	light.Color = Colors.Lantern
	light.Range = 16
	light.Brightness = 1.4
	light.Shadows = true
	light.Parent = l
end

local function smoke(model, cf: CFrame)
	local hole = addPart(model, {
		Name = "SmokeHole",
		Size = V3(1.6, 0.8, 1.6),
		CFrame = cf,
		Color = Colors.DarkWood,
	})
	local s = Instance.new("Smoke")
	s.Color = Color3.fromRGB(210, 205, 200)
	s.Opacity = 0.12
	s.RiseVelocity = 3
	s.Size = 1.5
	s.Parent = hole
end

--[[
	A timber hall: stone footing, plank walls with log banding, a pitched
	roof (ridge along local X), filled gable ends, crossed carved boards at
	both gables, a door on the -Z side, a lantern and optional chimney smoke.
	o = { w, d, wallH, roof = "thatch" | "shingle" | "turf", pitch, smoke, lantern }
]]
local function hall(model, cf: CFrame, o)
	local w, d, wallH = o.w, o.d, o.wallH
	local base = 1
	addPart(model, {
		Name = "Foundation",
		Size = V3(w + 1.2, 1, d + 1.2),
		CFrame = cf * CFrame.new(0, 0.5, 0),
		Color = Colors.Stone,
		Material = Enum.Material.Cobblestone,
	})
	addPart(model, {
		Name = "Walls",
		Size = V3(w, wallH, d),
		CFrame = cf * CFrame.new(0, base + wallH / 2, 0),
		Color = Colors.Wood,
		Material = Enum.Material.WoodPlanks,
	})
	-- horizontal log banding on the long sides
	local bands = math.floor(wallH / 1.5)
	for i = 1, bands do
		for _, side in { 1, -1 } do
			addPart(model, {
				Name = "Log",
				Size = V3(w + 0.8, 0.4, 0.4),
				CFrame = cf * CFrame.new(0, base + i * 1.5 - 0.3, side * (d / 2 + 0.15)),
				Color = Colors.DarkWood,
			})
		end
	end
	-- corner posts
	for _, sx in { 1, -1 } do
		for _, sz in { 1, -1 } do
			addPart(model, {
				Size = V3(0.9, wallH, 0.9),
				CFrame = cf * CFrame.new(sx * w / 2, base + wallH / 2, sz * d / 2),
				Color = Colors.DarkWood,
			})
		end
	end

	-- roof
	local roofColor = Colors.Thatch
	local roofMaterial = Enum.Material.Grass
	if o.roof == "shingle" then
		roofColor, roofMaterial = Colors.Shingle, Enum.Material.WoodPlanks
	elseif o.roof == "turf" then
		roofColor, roofMaterial = Colors.Turf, Enum.Material.Grass
	end
	local wallTop = base + wallH
	local angle = math.rad(o.pitch or 38)
	local halfD = d / 2 + 1.6
	local rise = halfD * math.tan(angle)
	local slope = halfD / math.cos(angle) + 0.6
	local ridgeY = wallTop + rise
	for _, side in { 1, -1 } do
		addPart(model, {
			Name = "Roof",
			Size = V3(w + 2.6, 1, slope),
			CFrame = cf * CFrame.new(0, wallTop + rise / 2, side * halfD / 2) * CFrame.Angles(side * angle, 0, 0),
			Color = roofColor,
			Material = roofMaterial,
		})
	end
	addPart(model, {
		Name = "Ridge",
		Size = V3(w + 3, 0.9, 0.9),
		CFrame = cf * CFrame.new(0, ridgeY + 0.2, 0),
		Color = Colors.DarkWood,
	})

	-- gable ends: stepped planks filling the triangle under the roof
	local steps = 5
	local stepH = rise / steps
	for _, sx in { 1, -1 } do
		for k = 1, steps do
			local hw = math.min(d / 2, halfD * (1 - (k - 0.5) / steps))
			if hw > 0.3 then
				addPart(model, {
					Name = "Gable",
					Size = V3(0.6, stepH + 0.05, hw * 2),
					CFrame = cf * CFrame.new(sx * w / 2, wallTop + (k - 0.5) * stepH, 0),
					Color = Colors.Weathered,
					Material = Enum.Material.WoodPlanks,
				})
			end
		end
		-- crossed carved boards that stick up past the ridge like horns
		for _, side in { 1, -1 } do
			addPart(model, {
				Name = "GableBoard",
				Size = V3(0.5, 0.7, slope + 3.2),
				CFrame = cf
					* CFrame.new(sx * (w / 2 + 1.2), ridgeY + 0.3, 0)
					* CFrame.Angles(side * angle, 0, 0)
					* CFrame.new(0, 0, side * (slope / 2 - 1.6)),
				Color = Colors.DarkWood,
			})
		end
	end

	-- door with frame
	addPart(model, {
		Name = "DoorFrame",
		Size = V3(4, 5.8, 0.3),
		CFrame = cf * CFrame.new(0, base + 2.9, -d / 2 - 0.1),
		Color = Colors.DarkWood,
	})
	addPart(model, {
		Name = "Door",
		Size = V3(3, 5, 0.3),
		CFrame = cf * CFrame.new(0, base + 2.5, -d / 2 - 0.25),
		Color = Color3.fromRGB(60, 40, 28),
		Material = Enum.Material.WoodPlanks,
	})
	if o.lantern ~= false then
		lantern(model, cf * CFrame.new(2.8, base + 4.6, -d / 2 - 0.6))
	end

	-- dark eave trim where the roof overhangs the walls
	for _, side in { 1, -1 } do
		addPart(model, {
			Name = "Eave",
			Size = V3(w + 2.7, 0.35, 0.5),
			CFrame = cf * CFrame.new(0, wallTop + 0.05, side * (halfD - 0.1)),
			Color = Colors.DarkWood,
			CanCollide = false,
		})
	end

	-- carved dragon heads rising from both ends of the ridge
	if o.dragons ~= false and w >= 12 then
		for _, sx in { 1, -1 } do
			local root = cf * CFrame.new(sx * (w / 2 + 1.5), ridgeY + 0.4, 0)
			local neck = root
			for _ = 1, 3 do
				neck = neck * CFrame.Angles(0, 0, sx * math.rad(-18)) * CFrame.new(sx * 0.55, 0.7, 0)
				addPart(model, { Name = "Dragon", Size = V3(0.55, 1.5, 0.5), CFrame = neck, Color = Colors.DarkWood, CanCollide = false })
			end
			local head = neck * CFrame.new(sx * 0.5, 0.9, 0)
			addPart(model, { Name = "Dragon", Size = V3(1.5, 0.7, 0.6), CFrame = head, Color = Colors.DarkWood, CanCollide = false })
			addPart(model, { Name = "Dragon", Size = V3(0.5, 0.5, 0.15), CFrame = head * CFrame.new(-sx * 0.3, 0.5, 0) * CFrame.Angles(0, 0, sx * 0.5), Color = Colors.DarkWood, CanCollide = false })
			for _, ez in { 0.32, -0.32 } do
				addPart(model, { Name = "DragonEye", Shape = Enum.PartType.Ball, Size = Vector3.one * 0.16, CFrame = head * CFrame.new(sx * 0.35, 0.12, ez), Color = Color3.fromRGB(220, 160, 60), Material = Enum.Material.Neon, CanCollide = false })
			end
		end
	end

	-- painted round shields hung along both long walls
	if o.shields ~= false then
		local palette = { Color3.fromRGB(150, 40, 36), Color3.fromRGB(226, 214, 186), Color3.fromRGB(46, 70, 120), Color3.fromRGB(196, 150, 60) }
		local count = math.max(2, math.floor(w / 7))
		for _, side in { 1, -1 } do
			for k = 1, count do
				local x = -w / 2 + (k - 0.5) * (w / count)
				if side == 1 or math.abs(x) > 3 then -- keep the door clear
					local at = cf * CFrame.new(x, base + wallH * 0.62, side * (d / 2 + 0.45)) * CFrame.Angles(0, math.pi / 2, 0)
					addPart(model, { Name = "Shield", Shape = Enum.PartType.Cylinder, Size = V3(0.25, 2.2, 2.2), CFrame = at, Color = palette[(k + (side == 1 and 0 or 2)) % #palette + 1], Material = Enum.Material.Wood, CanCollide = false })
					addPart(model, { Name = "ShieldBoss", Shape = Enum.PartType.Ball, Size = Vector3.one * 0.55, CFrame = at * CFrame.new(side * 0.15, 0, 0), Color = Colors.Iron, Material = Enum.Material.Metal, CanCollide = false })
				end
			end
		end
	end
	if o.smoke then
		smoke(model, cf * CFrame.new(w * 0.22, ridgeY + 0.6, 0))
	end
end

local function logPile(model, cf: CFrame)
	local offsets = { V3(0, 0.6, -1.3), V3(0, 0.6, 0), V3(0, 0.6, 1.3), V3(0, 1.7, -0.65), V3(0, 1.7, 0.65), V3(0, 2.8, 0) }
	for i, offset in offsets do
		addPart(model, {
			Name = "Log" .. i,
			Shape = Enum.PartType.Cylinder,
			Size = V3(6, 1.2, 1.2),
			CFrame = cf * CFrame.new(offset),
			Color = i % 2 == 0 and Colors.Wood or Colors.DarkWood,
		})
	end
end

local function fence(model, w: number, d: number, gapSide: boolean?)
	-- posts every ~4 studs with two rails, leaving a gap on the -Z side
	local hw, hd = w / 2 - 0.6, d / 2 - 0.6
	local corners = { V3(-hw, 0, -hd), V3(hw, 0, -hd), V3(hw, 0, hd), V3(-hw, 0, hd) }
	for i = 1, 4 do
		local a, b = corners[i], corners[i % 4 + 1]
		local len = (b - a).Magnitude
		local mid = (a + b) / 2
		local isGap = gapSide and i == 1
		local n = math.max(1, math.floor(len / 4))
		for j = 0, n do
			local p = a:Lerp(b, j / n)
			post(model, p, 2.6, 0.45)
		end
		if not isGap then
			for _, y in { 1, 2.1 } do
				addPart(model, {
					Name = "Rail",
					Size = V3(len, 0.25, 0.25),
					CFrame = CFrame.lookAt(mid + V3(0, y, 0), b + V3(0, y, 0)) * CFrame.Angles(0, math.pi / 2, 0),
					Color = Colors.Weathered,
				})
			end
		end
	end
end

local Builders = {}

local function campfire(model, pos: Vector3)
	for i = 1, 8 do
		local a = i / 8 * math.pi * 2
		addPart(model, {
			Name = "FireStone",
			Size = V3(0.9, 0.6, 0.9),
			CFrame = CFrame.new(pos + V3(math.cos(a) * 1.5, 0.3, math.sin(a) * 1.5)) * CFrame.Angles(0, a, 0),
			Color = Colors.Stone,
			Material = Enum.Material.Slate,
		})
	end
	for i = 1, 3 do
		addPart(model, {
			Name = "FireLog",
			Size = V3(0.4, 0.4, 2.2),
			CFrame = CFrame.new(pos + V3(0, 0.4, 0)) * CFrame.Angles(0, i * math.pi / 3, 0.15),
			Color = Colors.DarkWood,
			CanCollide = false,
		})
	end
	local core = addPart(model, {
		Name = "Embers",
		Size = V3(1, 0.3, 1),
		Position = pos + V3(0, 0.3, 0),
		Color = Color3.fromRGB(255, 110, 40),
		Material = Enum.Material.Neon,
		CanCollide = false,
	})
	local fire = Instance.new("Fire")
	fire.Size = 3
	fire.Heat = 6
	fire.Color = Color3.fromRGB(255, 140, 50)
	fire.SecondaryColor = Color3.fromRGB(255, 60, 20)
	fire.Parent = core
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 150, 70)
	light.Range = 22
	light.Brightness = 2
	light.Shadows = true
	light.Parent = core
end
ModelFactory.campfire = campfire

function Builders.Longhouse(model, w, d)
	hall(model, CFrame.new(), { w = w - 4, d = d - 5, wallH = 7, roof = "thatch", smoke = true })
	campfire(model, V3(-w / 2 + 4, 0, -d / 2 + 1.2))
	-- a carved post with a banner by the door
	post(model, V3(w / 2 - 4, 0, -d / 2 + 1), 9, 0.5)
	addPart(model, { Name = "Banner", Size = V3(0.15, 3.6, 2), Position = V3(w / 2 - 4, 6.6, -d / 2 + 2.1), Color = Color3.fromRGB(150, 40, 36), Material = Enum.Material.Fabric, CanCollide = false })
	-- barrels and a chopping block by the door
	for i, x in { 3.4, 4.6 } do
		addPart(model, { Name = "Barrel", Shape = Enum.PartType.Cylinder, Size = V3(1.8, 1.4, 1.4), CFrame = CFrame.new(x, 1.9, -d / 2 + 2.2 + i * 0.2) * CFrame.Angles(0, 0, math.pi / 2), Color = Color3.fromRGB(120, 84, 52) })
	end
	addPart(model, { Name = "Block", Shape = Enum.PartType.Cylinder, Size = V3(1.2, 1.6, 1.6), CFrame = CFrame.new(-4.5, 1.6, -d / 2 + 2.4) * CFrame.Angles(0, 0, math.pi / 2), Color = Colors.Wood })
end

function Builders.Cottage(model, w, d)
	-- A steep A-frame: the roof reaches the ground, ridge runs along local Z.
	local base = 0.8
	addPart(model, {
		Name = "Foundation",
		Size = V3(w - 2, base, d - 2),
		Position = V3(0, base / 2, 0),
		Color = Colors.Stone,
		Material = Enum.Material.Cobblestone,
	})
	local depth = d - 3
	local halfW = (w - 3) / 2
	local angle = math.rad(62)
	local rise = halfW * math.tan(angle)
	local slope = halfW / math.cos(angle) + 0.4
	for _, side in { 1, -1 } do
		addPart(model, {
			Name = "Roof",
			Size = V3(slope, 0.9, depth + 1.6),
			CFrame = CFrame.new(side * halfW / 2, base + rise / 2, 0) * CFrame.Angles(0, 0, -side * angle),
			Color = Colors.Shingle,
			Material = Enum.Material.WoodPlanks,
		})
	end
	local steps = 7
	local stepH = rise / steps
	for _, sz in { 1, -1 } do
		for k = 1, steps do
			local hw = halfW * (1 - (k - 0.5) / steps)
			addPart(model, {
				Name = "Gable",
				Size = V3(hw * 2, stepH + 0.05, 0.6),
				Position = V3(0, base + (k - 0.5) * stepH, sz * depth / 2),
				Color = Colors.Wood,
				Material = Enum.Material.WoodPlanks,
			})
		end
	end
	-- crossed boards on the front gable
	for _, side in { 1, -1 } do
		addPart(model, {
			Name = "GableBoard",
			Size = V3(slope + 3, 0.6, 0.5),
			CFrame = CFrame.new(0, base + rise, -depth / 2 - 0.9) * CFrame.Angles(0, 0, -side * angle) * CFrame.new(side * (slope / 2 - 1.5), 0, 0),
			Color = Colors.DarkWood,
		})
	end
	addPart(model, { Name = "Door", Size = V3(2.6, 4.4, 0.3), Position = V3(0, base + 2.2, -depth / 2 - 0.4), Color = Color3.fromRGB(60, 40, 28), Material = Enum.Material.WoodPlanks })
	addPart(model, { Name = "Window", Size = V3(1.2, 1.2, 0.2), Position = V3(0, base + 6.5, -depth / 2 - 0.35), Color = Colors.Lantern, Material = Enum.Material.Neon })
	lantern(model, CFrame.new(2.2, base + 3.6, -depth / 2 - 0.8))
	smoke(model, CFrame.new(0, base + rise + 0.3, depth / 4))
end

function Builders.Woodcutter(model, w, d)
	hall(model, CFrame.new(-2, 0, 2.5), { w = 9, d = 7, wallH = 5, roof = "shingle", smoke = false })
	logPile(model, CFrame.new(3, 0, -4.5))
	addPart(model, {
		Name = "Stump",
		Shape = Enum.PartType.Cylinder,
		Size = V3(1.4, 2.2, 2.2),
		CFrame = CFrame.new(5, 0.7, 3) * CFrame.Angles(0, 0, math.pi / 2),
		Color = Colors.Wood,
	})
	-- an axe stuck in the stump
	addPart(model, { Size = V3(0.25, 2.2, 0.25), CFrame = CFrame.new(5, 2.4, 3) * CFrame.Angles(0, 0, 0.5), Color = Colors.Wood })
	addPart(model, { Size = V3(0.9, 0.7, 0.15), CFrame = CFrame.new(5.3, 1.6, 3), Color = Colors.Iron, Material = Enum.Material.Metal })
end

function Builders.Quarry(model, w, d)
	addPart(model, {
		Size = V3(w - 1, 0.4, d - 1),
		Position = V3(0, 0.2, 0),
		Color = Color3.fromRGB(110, 108, 104),
		Material = Enum.Material.Slate,
	})
	local blocks = {
		{ V3(-3, 1.5, -3), V3(4, 2.6, 3) },
		{ V3(3, 1.2, -2), V3(3, 2, 3) },
		{ V3(-2.5, 2.2, 3), V3(5, 4, 4) },
		{ V3(4, 0.9, 4), V3(2, 1.4, 2) },
		{ V3(0.5, 0.8, 0), V3(2.4, 1.2, 1.6) },
	}
	for _, b in blocks do
		addPart(model, { Size = b[2], Position = b[1], Color = Colors.Stone, Material = Enum.Material.Slate })
	end
	-- wooden lifting crane
	post(model, V3(5.5, 0, -5.5), 8, 0.7)
	addPart(model, { Size = V3(0.5, 0.5, 7), Position = V3(5.5, 7.8, -2.5), Color = Colors.DarkWood })
	addPart(model, { Size = V3(0.12, 4, 0.12), Position = V3(5.5, 5.8, 0.6), Color = Colors.Thatch, Material = Enum.Material.Fabric })
	addPart(model, { Size = V3(1.2, 1, 1.2), Position = V3(5.5, 3.3, 0.6), Color = Colors.Stone, Material = Enum.Material.Slate })
end

function Builders.Farm(model, w, d)
	addPart(model, {
		Size = V3(w - 1, 0.3, d - 1),
		Position = V3(0, 0.15, 0),
		Color = Colors.Soil,
		Material = Enum.Material.Ground,
	})
	local rows = 8
	for i = 1, rows do
		local z = -d / 2 + 2.2 + (i - 1) * ((d - 4.4) / (rows - 1))
		addPart(model, {
			Name = "Barley",
			Size = V3(w - 4, 1.2, 1.5),
			Position = V3(0, 0.9, z),
			Color = i % 2 == 0 and Colors.Barley or Color3.fromRGB(184, 168, 84),
			Material = Enum.Material.Grass,
		})
	end
	fence(model, w, d, true)
	-- scarecrow
	post(model, V3(w / 4, 0, d / 4 - 1), 5, 0.3, Colors.Wood)
	addPart(model, { Size = V3(3, 0.3, 0.3), Position = V3(w / 4, 4, d / 4 - 1), Color = Colors.Wood })
	addPart(model, { Size = V3(1.3, 1.8, 0.6), Position = V3(w / 4, 3.4, d / 4 - 1), Color = Color3.fromRGB(120, 60, 50), Material = Enum.Material.Fabric })
	addPart(model, { Shape = Enum.PartType.Ball, Size = Vector3.one * 1, Position = V3(w / 4, 5.1, d / 4 - 1), Color = Colors.Thatch, Material = Enum.Material.Fabric })
end

function Builders.Storehouse(model, w, d)
	-- raised on stilts to keep goods dry; ridge along the long Z side
	for _, x in { -1, 1 } do
		for _, z in { -1, 0, 1 } do
			post(model, V3(x * (w / 2 - 2.5), 0, z * (d / 2 - 3)), 2, 1)
		end
	end
	hall(model, CFrame.new(0, 1, 0) * CFrame.Angles(0, math.pi / 2, 0), { w = d - 5, d = w - 5, wallH = 6, roof = "shingle", smoke = false })
	for i, pos in { V3(-4, 1, -10.3), V3(-1.6, 1, -10.3), V3(4.5, 1, -10.3) } do
		addPart(model, {
			Name = "Crate" .. i,
			Size = V3(2, 2, 2),
			Position = pos,
			Color = Colors.Wood,
			Material = Enum.Material.WoodPlanks,
		})
	end
	addPart(model, {
		Name = "Barrel",
		Shape = Enum.PartType.Cylinder,
		Size = V3(2.2, 1.8, 1.8),
		CFrame = CFrame.new(5.5, 1.1, 9.5) * CFrame.Angles(0, 0, math.pi / 2),
		Color = Colors.Wood,
	})
end

function Builders.Palisade(model, w, d)
	-- five sharpened logs in a row along local X, tied with a beam
	local n = 5
	for i = 1, n do
		local x = -w / 2 + (i - 0.5) * (w / n)
		local h = 8 + ((i * 37) % 7) / 6
		post(model, V3(x, 0, 0), h, 1.55, i % 2 == 0 and Colors.Wood or Colors.Weathered)
		addPart(model, {
			Name = "Point",
			Size = V3(1.05, 1.05, 1.05),
			CFrame = CFrame.new(x, h, 0) * CFrame.Angles(math.pi / 4, 0, math.pi / 4),
			Color = Colors.Weathered,
		})
	end
	addPart(model, { Name = "Beam", Size = V3(w, 0.5, 0.4), Position = V3(0, 3, 0.9), Color = Colors.DarkWood })
	addPart(model, { Name = "Beam", Size = V3(w, 0.5, 0.4), Position = V3(0, 6, 0.9), Color = Colors.DarkWood })
end

function Builders.Watchtower(model, w, d)
	-- four tall legs, a plank deck with a railing and a little shingle roof
	local h = 14
	local hw, hd = w / 2 - 2, d / 2 - 2
	for _, c in { V3(-hw, 0, -hd), V3(hw, 0, -hd), V3(-hw, 0, hd), V3(hw, 0, hd) } do
		post(model, c, h + 4, 0.9)
	end
	for _, y in { 4, 9 } do
		for _, side in { 1, -1 } do
			addPart(model, { Name = "Brace", Size = V3(hw * 2, 0.4, 0.4), Position = V3(0, y, side * hd), Color = Colors.DarkWood })
			addPart(model, { Name = "Brace", Size = V3(0.4, 0.4, hd * 2), Position = V3(side * hw, y, 0), Color = Colors.DarkWood })
		end
	end
	addPart(model, { Name = "Deck", Size = V3(hw * 2 + 3, 0.6, hd * 2 + 3), Position = V3(0, h, 0), Color = Colors.Wood, Material = Enum.Material.WoodPlanks })
	for _, side in { 1, -1 } do
		addPart(model, { Name = "Rail", Size = V3(hw * 2 + 3, 1.2, 0.3), Position = V3(0, h + 0.9, side * (hd + 1.4)), Color = Colors.DarkWood })
		addPart(model, { Name = "Rail", Size = V3(0.3, 1.2, hd * 2 + 3), Position = V3(side * (hw + 1.4), h + 0.9, 0), Color = Colors.DarkWood })
	end
	for _, side in { 1, -1 } do
		addPart(model, {
			Name = "Roof",
			Size = V3(hw * 2 + 4, 0.5, hd + 2.6),
			CFrame = CFrame.new(0, h + 4.9, side * (hd / 2 + 0.9)) * CFrame.Angles(side * math.rad(32), 0, 0),
			Color = Colors.Shingle,
			Material = Enum.Material.WoodPlanks,
		})
	end
	-- a ladder up the front
	for y = 1, h - 1, 1.5 do
		addPart(model, { Name = "Rung", Size = V3(1.8, 0.25, 0.25), Position = V3(0, y, -hd - 0.6), Color = Colors.Wood })
	end
	lantern(model, CFrame.new(hw + 1, h + 2.5, -hd - 1))
	model:SetAttribute("ArcherPost", V3(0, h + 0.4, 0))
end

local function runestone(model, pos: Vector3, h: number, turn: number)
	local stone = addPart(model, {
		Name = "Runestone",
		Size = V3(2.4, h, 0.9),
		CFrame = CFrame.new(pos + V3(0, h / 2, 0)) * CFrame.Angles(0, turn, 0.04),
		Color = Color3.fromRGB(120, 120, 116),
		Material = Enum.Material.Slate,
	})
	-- carved band of runes, faintly glowing
	addPart(model, {
		Name = "Runes",
		Size = V3(0.25, h * 0.8, 0.95),
		CFrame = stone.CFrame * CFrame.new(-0.6, 0, 0),
		Color = Color3.fromRGB(110, 170, 230),
		Material = Enum.Material.Neon,
		CanCollide = false,
	}).Transparency = 0.55
	return stone
end

function Builders.LoreHall(model, w, d)
	hall(model, CFrame.new(0, 0, 2), { w = w - 4, d = d - 7, wallH = 6, roof = "turf", smoke = true })
	runestone(model, V3(-6, 0, -d / 2 + 2), 5, 0.2)
	runestone(model, V3(6, 0, -d / 2 + 2), 4.2, -0.25)
	-- carved story pole by the door
	post(model, V3(0, 0, -d / 2 + 1.4), 7, 0.6, Colors.Weathered)
	addPart(model, { Name = "Carving", Size = V3(0.9, 1.2, 0.9), Position = V3(0, 7.2, -d / 2 + 1.4), Color = Color3.fromRGB(150, 40, 36), Material = Enum.Material.Wood })
end

function Builders.Smithy(model, w, d)
	-- an open-sided forge shed: four posts and a shingle roof
	for _, x in { -1, 1 } do
		for _, z in { -1, 1 } do
			post(model, V3(x * (w / 2 - 1.5), 0, z * (d / 2 - 1.5)), 7, 0.8)
		end
	end
	addPart(model, { Name = "Floor", Size = V3(w - 1, 0.4, d - 1), Position = V3(0, 0.2, 0), Color = Color3.fromRGB(80, 74, 66), Material = Enum.Material.Cobblestone })
	for _, side in { 1, -1 } do
		addPart(model, {
			Name = "Roof",
			Size = V3(w + 1, 0.8, d / 2 + 2),
			CFrame = CFrame.new(0, 8.6, side * (d / 4)) * CFrame.Angles(side * math.rad(24), 0, 0),
			Color = Colors.Shingle,
			Material = Enum.Material.WoodPlanks,
		})
	end
	-- stone forge with glowing coals
	addPart(model, { Name = "Forge", Size = V3(4, 3, 3.5), Position = V3(-3, 1.5, 2.5), Color = Colors.Stone, Material = Enum.Material.Cobblestone })
	local coals = addPart(model, { Name = "Coals", Size = V3(3, 0.4, 2.4), Position = V3(-3, 3.1, 2.5), Color = Color3.fromRGB(255, 100, 30), Material = Enum.Material.Neon })
	local fire = Instance.new("Fire")
	fire.Size = 3
	fire.Heat = 8
	fire.Parent = coals
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 120, 50)
	light.Range = 20
	light.Brightness = 2.5
	light.Shadows = true
	light.Parent = coals
	smoke(model, CFrame.new(-3, 9.6, 2.5))
	-- anvil on a stump
	addPart(model, { Shape = Enum.PartType.Cylinder, Size = V3(1.8, 1.8, 1.8), CFrame = CFrame.new(3, 0.9, 0) * CFrame.Angles(0, 0, math.pi / 2), Color = Colors.Wood })
	addPart(model, { Name = "Anvil", Size = V3(2.2, 0.9, 1), Position = V3(3, 2.25, 0), Color = Colors.Iron, Material = Enum.Material.Metal })
	addPart(model, { Size = V3(0.8, 0.5, 0.6), Position = V3(4.3, 2.45, 0), Color = Colors.Iron, Material = Enum.Material.Metal })
	-- quenching barrel
	addPart(model, { Shape = Enum.PartType.Cylinder, Size = V3(2.4, 2, 2), CFrame = CFrame.new(4, 1.2, 4.5) * CFrame.Angles(0, 0, math.pi / 2), Color = Colors.Wood })
end

function Builders.Shrine(model, w, d)
	-- a ring of standing stones around a carved idol, with two fire bowls
	addPart(model, { Name = "Floor", Size = V3(w - 2, 0.3, d - 2), Position = V3(0, 0.15, 0), Color = Color3.fromRGB(110, 100, 86), Material = Enum.Material.Pebble })
	for i = 1, 7 do
		local a = i / 7 * math.pi * 2
		local h = 4 + (i % 3) * 0.8
		addPart(model, {
			Name = "StandingStone",
			Size = V3(1.3, h, 0.8),
			CFrame = CFrame.new(math.cos(a) * 5.6, h / 2, math.sin(a) * 5.6) * CFrame.Angles(0, -a, 0.05),
			Color = Color3.fromRGB(116, 118, 114),
			Material = Enum.Material.Slate,
		})
	end
	post(model, V3(0, 0, 0), 8, 1, Colors.Weathered)
	addPart(model, { Name = "IdolFace", Size = V3(1.3, 1.6, 1.3), Position = V3(0, 6.6, 0), Color = Color3.fromRGB(96, 70, 48), Material = Enum.Material.Wood })
	for _, x in { -1, 1 } do
		addPart(model, { Size = V3(0.5, 3, 0.5), Position = V3(x * 1.1, 8.6, 0), CFrame = CFrame.new(x * 1.1, 8.4, 0) * CFrame.Angles(0, 0, -x * 0.5), Color = Color3.fromRGB(220, 205, 180) })
		local bowl = addPart(model, { Name = "FireBowl", Size = V3(1.4, 0.6, 1.4), Position = V3(x * 2.6, 2.3, -2.6), Color = Colors.Iron, Material = Enum.Material.Metal })
		post(model, V3(x * 2.6, 0, -2.6), 2, 0.3, Colors.Iron)
		local fire = Instance.new("Fire")
		fire.Size = 2
		fire.Heat = 6
		fire.Parent = bowl
		local light = Instance.new("PointLight")
		light.Color = Color3.fromRGB(255, 140, 60)
		light.Range = 14
		light.Brightness = 1.6
		light.Parent = bowl
	end
end

function Builders.Shipyard(model, w, d)
	-- a slipway with a longship hull taking shape on it, plus timber stacks
	addPart(model, { Name = "Slipway", Size = V3(10, 0.6, d - 2), Position = V3(-3, 0.3, 0), Color = Colors.Weathered, Material = Enum.Material.WoodPlanks })
	addPart(model, { Name = "Keel", Size = V3(1, 0.8, d - 6), Position = V3(-3, 1, 0), Color = Colors.Wood })
	for i = 1, 7 do
		local z = -d / 2 + 4 + (i - 1) * ((d - 8) / 6)
		local width = 3.5 + math.sin(i / 8 * math.pi) * 3
		for _, side in { 1, -1 } do
			addPart(model, {
				Name = "Rib",
				Size = V3(0.4, 4.5, 0.4),
				CFrame = CFrame.new(-3 + side * width / 2, 3, z) * CFrame.Angles(0, 0, side * 0.45),
				Color = Colors.Wood,
			})
		end
	end
	for _, side in { 1, -1 } do
		addPart(model, { Name = "Strake", Size = V3(0.35, 0.9, d - 10), CFrame = CFrame.new(-3 + side * 4.3, 1.6, 0) * CFrame.Angles(0, 0, side * 0.45), Color = Color3.fromRGB(96, 68, 46), Material = Enum.Material.WoodPlanks })
	end
	-- prow post rising at one end
	for k = 0, 4 do
		addPart(model, { Name = "Prow", Size = V3(0.5, 1.4, 0.8), CFrame = CFrame.new(-3, 2 + k * 1.2, -d / 2 + 2.5 - math.sin(k * 0.4) * 1.2) * CFrame.Angles(-k * 0.2, 0, 0), Color = Colors.DarkWood })
	end
	logPile(model, CFrame.new(w / 2 - 4, 0, 6) * CFrame.Angles(0, math.pi / 2, 0))
	logPile(model, CFrame.new(w / 2 - 4, 0, -6) * CFrame.Angles(0, math.pi / 2, 0))
	-- lifting frame
	post(model, V3(w / 2 - 3, 0, -d / 2 + 2), 10, 0.7)
	post(model, V3(-w / 2 + 1, 0, -d / 2 + 2), 10, 0.7)
	addPart(model, { Name = "Beam", Size = V3(w - 2, 0.6, 0.6), Position = V3(1, 10, -d / 2 + 2), Color = Colors.DarkWood })
end

function Builders.HuntingLodge(model, w, d)
	hall(model, CFrame.new(-1.5, 0, 2.5), { w = 9, d = 7, wallH = 5, roof = "thatch", smoke = true })
	-- hide drying rack
	post(model, V3(2, 0, -5), 5, 0.4)
	post(model, V3(6.5, 0, -5), 5, 0.4)
	addPart(model, { Size = V3(5, 0.3, 0.3), Position = V3(4.25, 4.8, -5), Color = Colors.DarkWood })
	for i = 1, 2 do
		addPart(model, { Name = "Hide", Size = V3(1.8, 3, 0.15), Position = V3(2.9 + (i - 1) * 2.4, 3.2, -5), Color = Color3.fromRGB(160, 116, 80), Material = Enum.Material.Fabric, CanCollide = false })
	end
	-- antlers over the door
	for _, x in { -1, 1 } do
		addPart(model, { Size = V3(0.2, 1.8, 0.2), CFrame = CFrame.new(-1.5 + x * 0.8, 6.8, -1.2) * CFrame.Angles(0, 0, -x * 0.6), Color = Color3.fromRGB(220, 205, 180) })
	end
end

function Builders.GreatHall(model, w, d)
	hall(model, CFrame.new(), { w = w - 4, d = d - 6, wallH = 9, roof = "shingle", pitch = 42, smoke = true })
	-- tall carved pillars at the entrance and a pair of braziers
	for _, x in { -5, 5 } do
		post(model, V3(x, 0, -d / 2 + 2), 12, 1.1, Colors.DarkWood)
		addPart(model, { Name = "Carving", Size = V3(1.4, 1.4, 1.4), Position = V3(x, 12.4, -d / 2 + 2), Color = Color3.fromRGB(170, 130, 50), Material = Enum.Material.Wood })
	end
	campfire(model, V3(-w / 2 + 4, 0, -d / 2 + 2))
	campfire(model, V3(w / 2 - 4, 0, -d / 2 + 2))
	-- red and gold banners along the long wall
	for i = -2, 2 do
		addPart(model, { Name = "Banner", Size = V3(1.8, 3.4, 0.12), Position = V3(i * 6, 6.5, -(d - 6) / 2 - 0.5), Color = i % 2 == 0 and Color3.fromRGB(150, 40, 36) or Color3.fromRGB(190, 150, 60), Material = Enum.Material.Fabric, CanCollide = false })
	end
end

-- Builds a building model for `buildingType` in its unrotated orientation.
function ModelFactory.building(buildingType: string): Model
	local def = Config.Buildings[buildingType]
	local w, d = def.Size[1] * CELL, def.Size[2] * CELL
	local model = Instance.new("Model")
	model.Name = buildingType
	local builder = Builders[buildingType]
	if builder then
		builder(model, w, d)
	else
		addPart(model, { Size = V3(w - 1, 4, d - 1), Position = V3(0, 2, 0) })
	end
	model.WorldPivot = CFrame.new()
	return model
end

-- Makes a model see-through and non-solid, for the placement preview.
function ModelFactory.makeGhost(model: Model)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.Transparency = 0.45
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
			d.CastShadow = false
		elseif d:IsA("Smoke") or d:IsA("Light") then
			d.Enabled = false
		end
	end
end

-- Trees ----------------------------------------------------------------------

-- A layered pine. Returns model, trunk.
function ModelFactory.pine(rng: Random, scale: number?): (Model, BasePart)
	local s = scale or rng:NextNumber(0.85, 1.5)
	local model = Instance.new("Model")
	model.Name = "Pine"
	local trunk = post(model, Vector3.zero, 7 * s, 1.2 * s)
	trunk.Name = "Trunk"
	local tiers = 5
	local twist = rng:NextNumber(0, math.pi)
	for i = 1, tiers do
		local t = (i - 1) / (tiers - 1)
		local width = (7.5 - 5.6 * t) * s
		addPart(model, {
			Name = "Needles",
			Size = V3(width, 2.4 * s, width),
			CFrame = CFrame.new(0, (3.6 + i * 2.5) * s, 0) * CFrame.Angles(0, twist + i * math.pi / 4, 0),
			Color = i % 2 == 0 and Colors.PineLight or Colors.Pine,
			Material = Enum.Material.Grass,
			CanCollide = false,
		})
	end
	addPart(model, {
		Name = "Tip",
		Size = V3(1.2 * s, 2.4 * s, 1.2 * s),
		Position = V3(0, (3.6 + tiers * 2.5 + 2) * s, 0),
		Color = Colors.Pine,
		Material = Enum.Material.Grass,
		CanCollide = false,
	})
	model.WorldPivot = CFrame.new()
	return model, trunk
end

-- A round-crowned birch. Returns model, trunk.
function ModelFactory.birch(rng: Random, scale: number?): (Model, BasePart)
	local s = scale or rng:NextNumber(0.85, 1.3)
	local model = Instance.new("Model")
	model.Name = "Birch"
	local trunk = post(model, Vector3.zero, 9 * s, 1 * s, Colors.Birch)
	trunk.Name = "Trunk"
	for i = 1, 3 do
		local a = i * 2.1 + rng:NextNumber(0, 1)
		addPart(model, {
			Name = "Leaves",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * rng:NextNumber(4.5, 6.5) * s,
			Position = V3(math.cos(a) * 1.6 * s, (8.5 + i * 0.8) * s, math.sin(a) * 1.6 * s),
			Color = i == 2 and Colors.Leaf or Color3.fromRGB(96, 134, 64),
			Material = Enum.Material.Grass,
			CanCollide = false,
		})
	end
	model.WorldPivot = CFrame.new()
	return model, trunk
end

-- A tall, narrow spruce with drooping tiers. Returns model, trunk.
function ModelFactory.spruce(rng: Random, scale: number?): (Model, BasePart)
	local s = scale or rng:NextNumber(1, 1.6)
	local model = Instance.new("Model")
	model.Name = "Spruce"
	local trunk = post(model, Vector3.zero, 6 * s, 1 * s)
	trunk.Name = "Trunk"
	local tiers = 8
	local twist = rng:NextNumber(0, math.pi)
	for i = 1, tiers do
		local t = (i - 1) / (tiers - 1)
		local width = (5.4 - 4.4 * t) * s
		addPart(model, {
			Name = "Needles",
			Size = V3(width, 1.9 * s, width),
			CFrame = CFrame.new(0, (2.6 + i * 1.75) * s, 0) * CFrame.Angles(0, twist + i * 0.7, 0) * CFrame.Angles(0.12, 0, 0.12),
			Color = i % 2 == 0 and Color3.fromRGB(34, 60, 42) or Color3.fromRGB(28, 52, 38),
			Material = Enum.Material.Grass,
			CanCollide = false,
		})
	end
	addPart(model, {
		Name = "Tip",
		Size = V3(0.8 * s, 2.6 * s, 0.8 * s),
		Position = V3(0, (2.6 + tiers * 1.75 + 1.8) * s, 0),
		Color = Color3.fromRGB(30, 56, 40),
		Material = Enum.Material.Grass,
		CanCollide = false,
	})
	model.WorldPivot = CFrame.new()
	return model, trunk
end

-- A low, dense juniper shrub.
function ModelFactory.juniper(rng: Random, scale: number?): Model
	local s = scale or rng:NextNumber(0.7, 1.3)
	local model = Instance.new("Model")
	model.Name = "Juniper"
	for i = 1, 4 do
		local h = rng:NextNumber(1.6, 3.2) * s
		addPart(model, {
			Name = "Juniper",
			Size = V3(rng:NextNumber(1.4, 2.2) * s, h, rng:NextNumber(1.4, 2.2) * s),
			CFrame = CFrame.new(rng:NextNumber(-1, 1) * s, h / 2, rng:NextNumber(-1, 1) * s) * CFrame.Angles(0, rng:NextNumber(0, 3), rng:NextNumber(-0.2, 0.2)),
			Color = Color3.fromRGB(48, 76, 56),
			Material = Enum.Material.Grass,
			CanCollide = false,
		})
	end
	model.WorldPivot = CFrame.new()
	return model
end

-- A fern: a fan of fronds close to the ground.
function ModelFactory.fern(rng: Random, scale: number?): Model
	local s = scale or rng:NextNumber(0.8, 1.4)
	local model = Instance.new("Model")
	model.Name = "Fern"
	local n = 6
	local turn = rng:NextNumber(0, math.pi)
	for i = 1, n do
		local a = turn + i / n * math.pi * 2
		addPart(model, {
			Name = "Fern",
			Size = V3(0.7 * s, 0.08, 2.6 * s),
			CFrame = CFrame.Angles(0, a, 0) * CFrame.new(0, 0.7 * s, -1.1 * s) * CFrame.Angles(math.rad(28), 0, 0),
			Color = Color3.fromRGB(70, 112, 48),
			Material = Enum.Material.Grass,
			CanCollide = false,
		})
	end
	model.WorldPivot = CFrame.new()
	return model
end

-- A boulder cluster. Returns model, main part.
function ModelFactory.boulder(rng: Random, scale: number?): (Model, BasePart)
	local s = scale or 1
	local model = Instance.new("Model")
	model.Name = "Boulder"
	local main
	for i = 1, 3 do
		local size = V3(rng:NextNumber(2.5, 5), rng:NextNumber(1.8, 3.5), rng:NextNumber(2.5, 5)) * s * (i == 1 and 1.2 or 0.8)
		local p = addPart(model, {
			Name = i == 1 and "Rock" or "RockBit",
			Size = size,
			CFrame = CFrame.new(rng:NextNumber(-1.5, 1.5) * s * (i - 1), size.Y / 2 - 0.4, rng:NextNumber(-1.5, 1.5) * s * (i - 1))
				* CFrame.Angles(rng:NextNumber(-0.25, 0.25), rng:NextNumber(0, math.pi), rng:NextNumber(-0.25, 0.25)),
			Color = i == 1 and Colors.Stone or Color3.fromRGB(108, 110, 106),
			Material = Enum.Material.Slate,
		})
		main = main or p
	end
	if rng:NextNumber() < 0.6 then
		-- a cap of moss on top of the biggest stone
		local top = main.CFrame * CFrame.new(0, main.Size.Y / 2 - 0.15, 0)
		addPart(model, {
			Name = "Moss",
			Size = V3(main.Size.X * 0.85, 0.45, main.Size.Z * 0.85),
			CFrame = top,
			Color = Color3.fromRGB(84, 110, 56),
			Material = Enum.Material.LeafyGrass,
			CanCollide = false,
		})
	end
	model.WorldPivot = CFrame.new()
	return model, main
end

-- Wild resource nodes. Returns the model and the part the prompt goes on.
function ModelFactory.node(kind: string, rng: Random): (Model, BasePart)
	if kind == "Tree" then
		local r = rng:NextNumber()
		if r < 0.45 then
			return ModelFactory.pine(rng)
		elseif r < 0.75 then
			return ModelFactory.spruce(rng)
		end
		return ModelFactory.birch(rng)
	elseif kind == "Rock" then
		return ModelFactory.boulder(rng)
	end
	-- Bush
	local model = Instance.new("Model")
	model.Name = "Bush"
	local main = addPart(model, {
		Name = "Bush",
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * 3.6,
		Position = V3(0, 1.4, 0),
		Color = Colors.Leaf,
		Material = Enum.Material.Grass,
	})
	for i = 1, 6 do
		local a = i / 6 * math.pi * 2
		addPart(model, {
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * 0.6,
			Position = V3(math.cos(a) * 1.55, 1.6 + (i % 2) * 0.6, math.sin(a) * 1.55),
			Color = Colors.Berry,
			Material = Enum.Material.SmoothPlastic,
			CanCollide = false,
		})
	end
	model.WorldPivot = CFrame.new()
	return model, main
end

-- A wooden jetty running along local -Z from (0,0,0), `length` studs long.
function ModelFactory.dock(length: number): Model
	local model = Instance.new("Model")
	model.Name = "Dock"
	addPart(model, {
		Name = "Deck",
		Size = V3(6, 0.5, length),
		Position = V3(0, 1.2, -length / 2),
		Color = Colors.Weathered,
		Material = Enum.Material.WoodPlanks,
	})
	for z = 0, length, 6 do
		for _, x in { -2.8, 2.8 } do
			post(model, V3(x, -8, -z), 10, 0.7)
		end
	end
	-- a little rowing boat tied up at the end
	addPart(model, { Name = "Boat", Size = V3(3, 1.2, 9), Position = V3(-5.5, 0.1, -length + 4), Color = Colors.Wood, Material = Enum.Material.WoodPlanks })
	addPart(model, { Size = V3(2.2, 0.3, 7.6), Position = V3(-5.5, 0.6, -length + 4), Color = Colors.DarkWood })
	model.WorldPivot = CFrame.new()
	return model
end

-- A longship, bow toward local -Z, pivot at the waterline in the middle.
function ModelFactory.longship(length: number?, sailColor: Color3?): Model
	local L = length or 44
	local model = Instance.new("Model")
	model.Name = "Longship"
	local maxW = L * 0.2
	local segs = 12
	local segLen = L / segs
	local hullColor = Color3.fromRGB(96, 68, 46)
	for i = 1, segs do
		local t = (i - 0.5) / segs
		local width = maxW * math.sin(math.pi * t) ^ 0.55
		local z = -L / 2 + (i - 0.5) * segLen
		local rise = (math.abs(t - 0.5) * 2) ^ 3 * 2.5 -- the hull sweeps up at both ends
		addPart(model, {
			Name = "Keel",
			Size = V3(math.max(width * 0.55, 0.8), 0.5, segLen + 0.2),
			Position = V3(0, -1.2 + rise * 0.5, z),
			Color = hullColor,
			Material = Enum.Material.WoodPlanks,
		})
		for _, side in { 1, -1 } do
			for strake = 0, 1 do
				addPart(model, {
					Name = "Strake",
					Size = V3(0.35, 1.3, segLen + 0.3),
					CFrame = CFrame.new(side * (width / 2 - 0.3 + strake * 0.45), -0.4 + strake * 1.15 + rise, z) * CFrame.Angles(0, 0, side * math.rad(22 + strake * 10)),
					Color = strake == 0 and hullColor or Color3.fromRGB(80, 56, 38),
					Material = Enum.Material.WoodPlanks,
				})
			end
		end
	end
	-- curling prow and stern posts
	for _, dir in { -1, 1 } do
		for k = 0, 6 do
			local a = k / 6 * math.pi * 0.9
			addPart(model, {
				Name = dir < 0 and "Prow" or "Stern",
				Size = V3(0.5, 1.4, 0.9),
				CFrame = CFrame.new(0, 1.5 + math.sin(a) * 3.2 + k * 0.35, dir * (L / 2 + math.cos(a) * 0.2 - 0.8 + math.sin(a) * 1.4)) * CFrame.Angles(dir * a * 0.7, 0, 0),
				Color = Color3.fromRGB(74, 52, 36),
			})
		end
	end
	-- deck, mast, yard and striped sail
	addPart(model, { Name = "Deck", Size = V3(maxW * 0.8, 0.3, L * 0.72), Position = V3(0, -0.3, 0), Color = Colors.Weathered, Material = Enum.Material.WoodPlanks })
	post(model, V3(0, -0.3, -1), 20, 0.7)
	addPart(model, { Name = "Yard", Size = V3(16, 0.5, 0.5), Position = V3(0, 18, -1.3), Color = Colors.DarkWood })
	local stripeColor = sailColor or Color3.fromRGB(160, 40, 36)
	for i = 1, 5 do
		addPart(model, {
			Name = "Sail",
			Size = V3(3, 11, 0.2),
			Position = V3(-6 + (i - 1) * 3, 12.3, -1.6),
			Color = i % 2 == 0 and Color3.fromRGB(236, 228, 210) or stripeColor,
			Material = Enum.Material.Fabric,
			CanCollide = false,
		})
	end
	-- round shields along both sides
	local shieldColors = { Color3.fromRGB(200, 160, 50), Color3.fromRGB(160, 44, 40), Color3.fromRGB(50, 80, 130), Color3.fromRGB(230, 225, 210) }
	for _, side in { 1, -1 } do
		for i = 1, 8 do
			local z = -L * 0.3 + (i - 1) * (L * 0.6 / 7)
			local t = (z + L / 2) / L
			local width = maxW * math.sin(math.pi * t) ^ 0.55
			addPart(model, {
				Name = "Shield",
				Shape = Enum.PartType.Cylinder,
				Size = V3(0.3, 2, 2),
				Position = V3(side * (width / 2 + 0.6), 1.3, z),
				Color = shieldColors[(i + (side > 0 and 0 or 1)) % 4 + 1],
				Material = Enum.Material.Wood,
				CanCollide = false,
			})
			addPart(model, {
				Name = "Oar",
				Size = V3(7, 0.25, 0.25),
				CFrame = CFrame.new(side * (width / 2 + 3), 0, z + 0.9) * CFrame.Angles(0, 0, side * math.rad(-25)),
				Color = Colors.Wood,
				CanCollide = false,
			})
		end
	end
	model.WorldPivot = CFrame.new()
	return model
end

-- Wildlife --------------------------------------------------------------------

-- A deer. The Body is anchored and moved by the server; other parts are
-- welded to it. GroundOffset attribute = body centre height above ground.
function ModelFactory.deer(rng: Random): Model
	local model = Instance.new("Model")
	model.Name = "Deer"
	local coat = Color3.fromRGB(140 + rng:NextInteger(-12, 12), 98, 60)
	local body = Instance.new("Part")
	body.Name = "Body"
	body.Anchored = true
	body.CanCollide = false
	body.Size = V3(1.6, 1.6, 3.6)
	body.Color = coat
	body.Material = Enum.Material.Fabric
	body.CFrame = CFrame.new(0, 3, 0)
	body.Parent = model

	local function attach(name, size, offset: CFrame, color, shape)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.Color = color or coat
		p.Material = Enum.Material.Fabric
		if shape then
			p.Shape = shape
		end
		p.Anchored = false
		p.CanCollide = false
		p.Massless = true
		p.CFrame = body.CFrame * offset
		p.Parent = model
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = body
		weld.Part1 = p
		weld.Parent = p
		return p
	end
	for _, x in { -0.55, 0.55 } do
		for _, z in { -1.3, 1.3 } do
			attach("Leg", V3(0.35, 2.3, 0.35), CFrame.new(x, -1.9, z), Color3.fromRGB(110, 78, 50))
		end
	end
	attach("Neck", V3(0.7, 1.8, 0.7), CFrame.new(0, 1.1, -1.7) * CFrame.Angles(math.rad(-25), 0, 0))
	attach("Head", V3(0.8, 0.8, 1.5), CFrame.new(0, 2, -2.3))
	attach("Tail", V3(0.4, 0.5, 0.3), CFrame.new(0, 0.5, 1.9), Color3.fromRGB(235, 225, 210))
	for _, x in { -0.4, 0.4 } do
		attach("Antler", V3(0.15, 1.4, 0.15), CFrame.new(x, 2.9, -2.1) * CFrame.Angles(0, 0, x * 0.9), Color3.fromRGB(220, 205, 180))
	end
	model.PrimaryPart = body
	model:SetAttribute("GroundOffset", 3)
	return model
end

-- A flying arrow (visual only).
function ModelFactory.arrow(): BasePart
	local shaft = Instance.new("Part")
	shaft.Name = "Arrow"
	shaft.Anchored = true
	shaft.CanCollide = false
	shaft.CanQuery = false
	shaft.Size = V3(0.12, 0.12, 2.6)
	shaft.Color = Colors.Wood
	shaft.Material = Enum.Material.Wood
	local tip = Instance.new("Part")
	tip.Name = "Tip"
	tip.Anchored = false
	tip.Massless = true
	tip.CanCollide = false
	tip.CanQuery = false
	tip.Size = V3(0.25, 0.25, 0.4)
	tip.Color = Colors.Iron
	tip.Material = Enum.Material.Metal
	tip.CFrame = shaft.CFrame * CFrame.new(0, 0, -1.4)
	tip.Parent = shaft
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = shaft
	weld.Part1 = tip
	weld.Parent = tip
	return shaft
end

-- Villagers -------------------------------------------------------------------

-- A small villager figure. The body is anchored and moved by the server;
-- the head, hair and legs are welded to it so they follow.
-- GroundOffset attribute = body centre height above ground.
-- stage: "baby", "child", "adult" or "elder" (defaults from isChild).
-- Arms and legs hang from Welds whose C0 the client swings while walking
-- (attributes Hip = joint CFrame, HalfLen = half the limb length).
function ModelFactory.villager(name: string, isChild: boolean, rng: Random, stage: string?): Model
	stage = stage or (isChild and "child" or "adult")
	local s = ({ baby = 0.45, child = 0.65, adult = 1, elder = 0.95 })[stage] or 1
	local model = Instance.new("Model")
	model.Name = name
	model:SetAttribute("Villager", true)
	model:SetAttribute("Stage", stage)

	local legH = 1.1 * s
	local bodyH = 1.8 * s
	local body = Instance.new("Part")
	body.Name = "Body"
	body.Anchored = true
	body.CanCollide = false
	body.Size = V3(1.5, bodyH, 0.95) * V3(s, 1, s)
	body.Color = stage == "baby" and Color3.fromRGB(226, 216, 196) or Tunics[rng:NextInteger(1, #Tunics)]
	body.Material = Enum.Material.Fabric
	body.CFrame = CFrame.new(0, legH + bodyH / 2, 0)
	body.Parent = model

	local function attach(partName, size, offset: CFrame, color, material, shape)
		local p = Instance.new("Part")
		p.Name = partName
		if shape then
			p.Shape = shape
		end
		p.Anchored = false
		p.CanCollide = false
		p.CanQuery = false
		p.Massless = true
		p.Size = size
		p.Color = color
		p.Material = material
		p.CFrame = body.CFrame * offset
		p.Parent = model
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = body
		weld.Part1 = p
		weld.Parent = p
		return p
	end

	-- a limb hanging from `hip` (in body space), swung by its Weld
	local function limb(partName, size: Vector3, hip: CFrame, color, side: number)
		local p = Instance.new("Part")
		p.Name = partName
		p.Anchored = false
		p.CanCollide = false
		p.CanQuery = false
		p.Massless = true
		p.Size = size
		p.Color = color
		p.Material = Enum.Material.Fabric
		p.CFrame = body.CFrame * hip * CFrame.new(0, -size.Y / 2, 0)
		p.Parent = model
		local weld = Instance.new("Weld")
		weld.Name = "Joint"
		weld.Part0 = body
		weld.Part1 = p
		weld.C0 = hip * CFrame.new(0, -size.Y / 2, 0)
		weld.Parent = p
		p:SetAttribute("Hip", hip)
		p:SetAttribute("HalfLen", size.Y / 2)
		p:SetAttribute("Side", side)
		return p
	end

	local hairColor = stage == "elder" and Color3.fromRGB(210, 210, 214) or Hair[rng:NextInteger(1, #Hair)]
	attach("Head", Vector3.one * 1.1 * s * (stage == "baby" and 1.25 or 1), CFrame.new(0, bodyH / 2 + 0.55 * s, 0), Colors.Skin, Enum.Material.SmoothPlastic, Enum.PartType.Ball)
	if stage ~= "baby" then
		attach("Hair", V3(1.15, 0.5, 1.15) * s, CFrame.new(0, bodyH / 2 + 0.95 * s, 0.1 * s), hairColor, Enum.Material.Fabric)
	end
	if stage == "elder" then
		attach("Beard", V3(0.8, 0.7, 0.3) * s, CFrame.new(0, bodyH / 2 + 0.2 * s, -0.5 * s), hairColor, Enum.Material.Fabric)
	end
	attach("Belt", V3(1.55 * s, 0.25 * s, 1 * s), CFrame.new(0, -bodyH * 0.15, 0), Colors.DarkWood, Enum.Material.Fabric)
	for i, x in { -0.35, 0.35 } do
		limb("Leg", V3(0.5 * s, legH, 0.6 * s), CFrame.new(x * s, -bodyH / 2, 0), Color3.fromRGB(70, 62, 54), i == 1 and 1 or -1)
	end
	for i, x in { -0.95, 0.95 } do
		limb("Arm", V3(0.4 * s, bodyH * 0.8, 0.45 * s), CFrame.new(x * s, bodyH / 2 - 0.1 * s, 0), body.Color:Lerp(Color3.new(0, 0, 0), 0.15), i == 1 and -1 or 1)
	end

	local tag = Instance.new("BillboardGui")
	tag.Name = "NameTag"
	tag.Size = UDim2.fromOffset(140, 22)
	tag.StudsOffset = V3(0, bodyH / 2 + 1.8 * s, 0)
	tag.MaxDistance = 60
	tag.Adornee = body
	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamMedium
	label.TextSize = 13
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.5
	label.Text = name
	label.Parent = tag
	tag.Parent = body

	model.PrimaryPart = body
	model:SetAttribute("GroundOffset", legH + bodyH / 2)
	return model
end

-- Tools -----------------------------------------------------------------------

-- Builds a hand tool ("Axe", "Pickaxe", "Bow" or "Torch") that players hold.
function ModelFactory.tool(kind: string): Tool
	local tool = Instance.new("Tool")
	tool.Name = kind
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	tool.ToolTip = ({ Axe = "Chop trees, fight", Pickaxe = "Mine rocks", Bow = "Shoot deer and enemies", Torch = "Set enemy buildings alight (F)", Sword = "Your weapon: click to fight" })[kind] or kind

	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = V3(0.3, 3.6, 0.3)
	handle.Color = Colors.Wood
	handle.Material = Enum.Material.Wood
	handle.CanCollide = false
	handle.Massless = true
	handle.Parent = tool

	local function head(size, offset: CFrame)
		local p = Instance.new("Part")
		p.Name = "Head"
		p.Size = size
		p.Color = Colors.Iron
		p.Material = Enum.Material.Metal
		p.CanCollide = false
		p.Massless = true
		p.CFrame = handle.CFrame * offset
		p.Parent = tool
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = handle
		weld.Part1 = p
		weld.Parent = p
	end
	if kind == "Torch" then
		handle.Size = V3(0.35, 3, 0.35)
		local flame = Instance.new("Part")
		flame.Name = "Flame"
		flame.Size = V3(0.6, 0.7, 0.6)
		flame.Color = Color3.fromRGB(255, 150, 60)
		flame.Material = Enum.Material.Neon
		flame.CanCollide = false
		flame.Massless = true
		flame.CFrame = handle.CFrame * CFrame.new(0, 1.7, 0)
		flame.Parent = tool
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = handle
		weld.Part1 = flame
		weld.Parent = flame
		local fire = Instance.new("Fire")
		fire.Size = 2
		fire.Heat = 7
		fire.Parent = flame
		local light = Instance.new("PointLight")
		light.Color = Colors.Lantern
		light.Range = 18
		light.Brightness = 2
		light.Parent = flame
		tool.Grip = CFrame.new(0, -0.8, 0)
		return tool
	elseif kind == "Bow" then
		-- the handle is the grip; two angled limbs and a string make the bow
		handle.Size = V3(0.3, 1, 0.3)
		local function limb(size, offset: CFrame, color, material)
			local p = Instance.new("Part")
			p.Name = "Limb"
			p.Size = size
			p.Color = color
			p.Material = material
			p.CanCollide = false
			p.Massless = true
			p.CFrame = handle.CFrame * offset
			p.Parent = tool
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = handle
			weld.Part1 = p
			weld.Parent = p
		end
		limb(V3(0.25, 2.2, 0.25), CFrame.new(0, 1.4, 0.3) * CFrame.Angles(math.rad(-15), 0, 0), Colors.DarkWood, Enum.Material.Wood)
		limb(V3(0.25, 2.2, 0.25), CFrame.new(0, -1.4, 0.3) * CFrame.Angles(math.rad(15), 0, 0), Colors.DarkWood, Enum.Material.Wood)
		limb(V3(0.06, 4.9, 0.06), CFrame.new(0, 0, 0.9), Color3.fromRGB(230, 225, 210), Enum.Material.Fabric)
		tool.Grip = CFrame.new(0, 0, 0) * CFrame.Angles(0, math.pi / 2, 0)
		return tool
	elseif kind == "Sword" then
		-- a short grip, a crossguard and a long double-edged blade
		handle.Size = V3(0.3, 1.2, 0.3)
		handle.Color = Colors.DarkWood
		head(V3(0.35, 0.35, 0.35), CFrame.new(0, -0.7, 0)) -- pommel
		head(V3(0.25, 0.25, 1.6), CFrame.new(0, 0.7, 0)) -- crossguard
		head(V3(0.12, 3.8, 0.4), CFrame.new(0, 2.7, 0)) -- blade
		tool.Grip = CFrame.new(0, -0.2, 0)
		return tool
	elseif kind == "Axe" then
		head(V3(0.25, 1, 1.3), CFrame.new(0, 1.4, -0.7))
	else
		head(V3(0.25, 0.4, 3), CFrame.new(0, 1.6, 0))
		head(V3(0.2, 0.3, 0.6), CFrame.new(0, 1.5, -1.6) * CFrame.Angles(math.rad(25), 0, 0))
		head(V3(0.2, 0.3, 0.6), CFrame.new(0, 1.5, 1.6) * CFrame.Angles(math.rad(-25), 0, 0))
	end
	-- hold it near the bottom of the shaft
	tool.Grip = CFrame.new(0, -1.2, 0)
	return tool
end

-- Mesh swap ---------------------------------------------------------------------
--[[
	If ReplicatedStorage.Assets has a child named after a slot below, that
	model is used instead of the part-built one. Its pivot is moved to the
	bottom-centre of the model automatically, so it sits on the ground.
]]
ModelFactory.Slots = {
	"Longhouse", "Cottage", "Woodcutter", "Quarry", "Farm", "Storehouse", "Palisade",
	"LoreHall", "Smithy", "Shrine", "Shipyard", "HuntingLodge", "GreatHall", "Watchtower",
	"Tree_Pine", "Tree_Spruce", "Tree_Birch", "Rock", "Bush", "Dock", "Deer",
	"Axe", "Pickaxe", "Bow", "Torch", "Longship",
}

-- Models laid out in Workspace > ModelWorkshop (see bakeTemplates) are
-- looked at first, so edits made there in Studio are used straight away.
local function customAsset(name: string): Instance?
	local workshop = workspace:FindFirstChild("ModelWorkshop")
	local item = workshop and workshop:FindFirstChild(name)
	if not item then
		local folder = ReplicatedStorage:FindFirstChild("Assets")
		item = folder and folder:FindFirstChild(name)
	end
	return item and item:Clone() or nil
end
ModelFactory.customAsset = customAsset

local function largestPart(model: Model): BasePart?
	local best, bestVolume = nil, -1
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			local v = d.Size.X * d.Size.Y * d.Size.Z
			if v > bestVolume then
				best, bestVolume = d, v
			end
		end
	end
	return best
end

-- Wraps loose parts in a Model, anchors it, optionally scales it to fit
-- `fit` (x/z), and puts its pivot at the bottom-centre at (0, 0, 0).
local function prepare(item: Instance, anchored: boolean, fit: Vector3?, scale: number?): Model
	local model: Model
	if item:IsA("Model") then
		model = item
	else
		model = Instance.new("Model")
		model.Name = item.Name
		item.Parent = model
	end
	-- free models can hide scripts inside; never run them
	for _, d in model:GetDescendants() do
		if d:IsA("LuaSourceContainer") then
			d:Destroy()
		end
	end
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = anchored
		end
	end
	local _, size = model:GetBoundingBox()
	local factor = scale or 1
	-- Templates (baked from the built-in models) already have the right size,
	-- so they are kept exactly as you shaped them.
	if fit and not model:GetAttribute("Template") and size.X > 0 and size.Z > 0 then
		factor *= math.min(fit.X / size.X, fit.Z / size.Z)
	end
	if math.abs(factor - 1) > 0.01 then
		model:ScaleTo(model:GetScale() * factor)
	end
	local cf, newSize = model:GetBoundingBox()
	model.WorldPivot = CFrame.new(cf.Position - Vector3.new(0, newSize.Y / 2, 0))
	model:PivotTo(CFrame.new())
	return model
end

local partBuilt = {
	building = ModelFactory.building,
	pine = ModelFactory.pine,
	spruce = ModelFactory.spruce,
	birch = ModelFactory.birch,
	boulder = ModelFactory.boulder,
	node = ModelFactory.node,
	dock = ModelFactory.dock,
	deer = ModelFactory.deer,
	tool = ModelFactory.tool,
}

function ModelFactory.building(buildingType: string): Model
	local custom = customAsset(buildingType)
	if custom then
		local def = Config.Buildings[buildingType]
		local model = prepare(custom, true, V3(def.Size[1] * CELL * 0.96, 0, def.Size[2] * CELL * 0.96))
		model.Name = buildingType
		return model
	end
	return partBuilt.building(buildingType)
end

local function customTree(slot: string, rng: Random, scale: number?)
	local custom = customAsset(slot)
	if not custom then
		return nil
	end
	local model = prepare(custom, true, nil, scale or rng:NextNumber(0.85, 1.4))
	return model, largestPart(model)
end

function ModelFactory.pine(rng: Random, scale: number?): (Model, BasePart)
	local model, main = customTree("Tree_Pine", rng, scale)
	if model then
		return model, main
	end
	return partBuilt.pine(rng, scale)
end

function ModelFactory.birch(rng: Random, scale: number?): (Model, BasePart)
	local model, main = customTree("Tree_Birch", rng, scale)
	if model then
		return model, main
	end
	return partBuilt.birch(rng, scale)
end

function ModelFactory.spruce(rng: Random, scale: number?): (Model, BasePart)
	local model, main = customTree("Tree_Spruce", rng, scale)
	if model then
		return model, main
	end
	return partBuilt.spruce(rng, scale)
end

function ModelFactory.boulder(rng: Random, scale: number?): (Model, BasePart)
	local model, main = customTree("Rock", rng, scale)
	if model then
		return model, main
	end
	return partBuilt.boulder(rng, scale)
end

function ModelFactory.node(kind: string, rng: Random): (Model, BasePart)
	if kind == "Bush" then
		local model, main = customTree("Bush", rng, 1)
		if model then
			return model, main
		end
	end
	return partBuilt.node(kind, rng)
end

function ModelFactory.dock(length: number): Model
	local custom = customAsset("Dock")
	if custom then
		return prepare(custom, true)
	end
	return partBuilt.dock(length)
end

function ModelFactory.deer(rng: Random): Model
	local custom = customAsset("Deer")
	if not custom then
		return partBuilt.deer(rng)
	end
	local model = prepare(custom, false)
	model.Name = "Deer"
	local body = model.PrimaryPart or largestPart(model)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.CanCollide = false
			if d ~= body then
				d.Massless = true
				local weld = Instance.new("WeldConstraint")
				weld.Part0 = body
				weld.Part1 = d
				weld.Parent = d
			end
		end
	end
	body.Anchored = true
	model.PrimaryPart = body
	model:SetAttribute("GroundOffset", body.Position.Y)
	return model
end

local partLongship = ModelFactory.longship
function ModelFactory.longship(length: number?, sailColor: Color3?): Model
	local custom = customAsset("Longship")
	if custom then
		return prepare(custom, true)
	end
	return partLongship(length, sailColor)
end

function ModelFactory.tool(kind: string): Tool
	local custom = customAsset(kind)
	if custom and custom:IsA("Tool") then
		custom.Name = kind
		for _, d in custom:GetDescendants() do
			if d:IsA("LuaSourceContainer") then
				d:Destroy() -- the game drives its tools itself
			end
		end
		return custom
	end
	return partBuilt.tool(kind)
end

-- Editing models in Studio ------------------------------------------------------
--[[
	bakeTemplates() is run once from Studio's Command Bar (in edit mode, not
	while playing):
	    require(game.ServerScriptService.Server.EditTools).Setup()
	It puts a copy of every built-in model into Workspace > ModelWorkshop, in
	a row you can see and edit. When the game starts, the server moves them
	into ReplicatedStorage > Assets and uses them everywhere. Delete one to go
	back to the built-in version (which has more random variety for trees).
]]
local function moveBy(item: Instance, offset: CFrame)
	if item:IsA("PVInstance") then
		item:PivotTo(offset * item:GetPivot())
		return
	end
	for _, d in item:GetDescendants() do
		if d:IsA("BasePart") then
			d.CFrame = offset * d.CFrame
		end
	end
end

function ModelFactory.bakeTemplates(): number
	local workshop = workspace:FindFirstChild("ModelWorkshop")
	if not workshop then
		workshop = Instance.new("Folder")
		workshop.Name = "ModelWorkshop"
		workshop.Parent = workspace
	end
	local rng = Random.new(7)
	local makers = {
		Tree_Pine = function()
			return partBuilt.pine(rng, 1)
		end,
		Tree_Spruce = function()
			return partBuilt.spruce(rng, 1)
		end,
		Tree_Birch = function()
			return partBuilt.birch(rng, 1)
		end,
		Rock = function()
			return partBuilt.boulder(rng, 1)
		end,
		Bush = function()
			return partBuilt.node("Bush", rng)
		end,
		Dock = function()
			return partBuilt.dock(48)
		end,
		Deer = function()
			return partBuilt.deer(rng)
		end,
	}
	for _, kind in Config.Tools do
		makers[kind] = function()
			return partBuilt.tool(kind)
		end
	end
	for b in Config.Buildings do
		makers[b] = function()
			return partBuilt.building(b)
		end
	end

	-- Lay them out in a row in the meadow behind the first plot.
	local x, z, made = -20, 200, 0
	for _, slot in ModelFactory.Slots do
		local make = makers[slot]
		if make and not workshop:FindFirstChild(slot) then
			-- Start from your own model if one is already in Assets.
			local own = customAsset(slot)
			local item = own or make()
			item.Name = slot
			if not own then
				item:SetAttribute("Template", true)
			end
			local width = 8
			if item:IsA("Model") then
				local _, size = item:GetBoundingBox()
				width = math.max(size.X, size.Z, 6)
			end
			x += width / 2 + 6
			local hit = workspace:Raycast(V3(x, 400, z), V3(0, -800, 0))
			local y = hit and hit.Position.Y or 1
			if item:IsA("Tool") then
				local handle = item:FindFirstChild("Handle")
				if handle then
					moveBy(item, CFrame.new(V3(x, y + 2.5, z) - handle.Position))
				end
			else
				item:PivotTo(CFrame.new(x, y, z))
			end
			item.Parent = workshop
			x += width / 2
			made += 1
		end
	end
	return made
end

-- Called by the server as the game starts: hands the workshop models to the
-- game (ReplicatedStorage > Assets) and clears them out of the world.
function ModelFactory.collectWorkshop()
	local workshop = workspace:FindFirstChild("ModelWorkshop")
	if not workshop then
		return
	end
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	if not assets then
		assets = Instance.new("Folder")
		assets.Name = "Assets"
		assets.Parent = ReplicatedStorage
	end
	for _, item in workshop:GetChildren() do
		local handle = item:IsA("Tool") and item:FindFirstChild("Handle")
		if handle and handle:IsA("BasePart") then
			handle.CanTouch = true
		end
		local old = assets:FindFirstChild(item.Name)
		if old then
			old:Destroy()
		end
		item.Parent = assets
	end
	workshop:Destroy()
end

return ModelFactory
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[--[[
	Remotes
	The server creates the network objects; the client waits for them.
	Require this module from either side and use e.g. Remotes.PlaceBuilding.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local EVENTS = {
	"ColonyState", -- server -> client: full colony snapshot every tick
	"Notify", -- server -> client: short message for the toast feed
	"ShootArrow", -- client -> server: (aimPosition) when the Bow is used
	"Strike", -- client -> server: an Axe swing (server finds who it hits)
	"BoatInput", -- client -> server: (throttle, steer) while sailing
	"OpenTrade", -- server -> client: you're at a trading stall, show the trade window
	"BoatFire", -- client -> server: loose a volley from your ship (F at the helm)
}

local FUNCTIONS = {
	"PlaceBuilding", -- client -> server: (type, cx, cz, rot) -> ok, message
	"DemolishBuilding", -- client -> server: (buildingId) -> ok, message
	"Research", -- client -> server: (techId) -> ok, message
	"Trade", -- client -> server: (offerIndex) -> ok, message
}

local Remotes = {}

if RunService:IsServer() then
	local folder = Instance.new("Folder")
	folder.Name = "Remotes"
	for _, name in EVENTS do
		local remote = Instance.new("RemoteEvent")
		remote.Name = name
		remote.Parent = folder
		Remotes[name] = remote
	end
	for _, name in FUNCTIONS do
		local remote = Instance.new("RemoteFunction")
		remote.Name = name
		remote.Parent = folder
		Remotes[name] = remote
	end
	folder.Parent = ReplicatedStorage
else
	local folder = ReplicatedStorage:WaitForChild("Remotes")
	for _, name in EVENTS do
		Remotes[name] = folder:WaitForChild(name)
	end
	for _, name in FUNCTIONS do
		Remotes[name] = folder:WaitForChild(name)
	end
end

return Remotes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">Sounds</string>
          <string name="Source"><![CDATA[--[[
	Sounds
	Every sound in the game, by slot name. To change one, put a different
	sound's ID in its slot, written like "rbxassetid://1234567890".

	How to find a sound in Studio:
	  1. Open the Toolbox (View or Window menu > Toolbox).
	  2. Pick the Audio tab (the music-note icon), search e.g. "wind",
	     "ocean waves", "viking", "war horn", "fire crackle".
	  3. Click a sound to listen. Right-click it > Copy Asset ID.
	  4. In the Explorer open ReplicatedStorage > Shared and double-click
	     Sounds (this script). Paste the number between the quotes, after
	     rbxassetid://  e.g.  Wind = "rbxassetid://9112854440",
	  5. Press Play.
	An empty slot ("") is silent. The ones filled in already are Roblox's
	built-in sounds that come with every Roblox install.
]]

local Sounds = {}

Sounds.Slots = {
	-- background, loops forever (empty until you pick one you like)
	Music = { Id = "", Volume = 0.25 }, -- a calm Nordic / folk track
	Wind = { Id = "", Volume = 0.3 }, -- soft wind
	Birds = { Id = "", Volume = 0.25 }, -- daytime birdsong (quiet at night)
	Waves = { Id = "", Volume = 0.45 }, -- sea on the shore (louder near the fjord)
	Fire = { Id = "", Volume = 0.6 }, -- crackling flames on burning buildings

	-- one-off effects
	Chop = { Id = "rbxasset://sounds/swordslash.wav", Volume = 0.5, Pitch = 0.6 },
	Mine = { Id = "rbxasset://sounds/swordlunge.wav", Volume = 0.5, Pitch = 0.55 },
	Swing = { Id = "rbxasset://sounds/swordslash.wav", Volume = 0.6, Pitch = 1 },
	Bow = { Id = "rbxasset://sounds/swordlunge.wav", Volume = 0.5, Pitch = 1.7 },
	Build = { Id = "rbxasset://sounds/action_jump_land.mp3", Volume = 0.8, Pitch = 0.6 },
	Splash = { Id = "rbxasset://sounds/impact_water.mp3", Volume = 1, Pitch = 0.7 },
	QuestDone = { Id = "rbxasset://sounds/unsheath.wav", Volume = 0.5, Pitch = 1 },
	WarHorn = { Id = "", Volume = 1 }, -- a long horn blast when a raid begins
}

-- Plays slot `name` once, at a part or a position (or everywhere if nil).
function Sounds.play(name: string, where: (BasePart | Vector3)?)
	local slot = Sounds.Slots[name]
	if not slot or slot.Id == "" then
		return
	end
	local sound = Instance.new("Sound")
	sound.SoundId = slot.Id
	sound.Volume = slot.Volume or 0.5
	sound.PlaybackSpeed = slot.Pitch or 1
	sound.RollOffMaxDistance = 160
	local holder
	if typeof(where) == "Vector3" then
		holder = Instance.new("Attachment")
		holder.WorldPosition = where
		holder.Parent = workspace.Terrain
		sound.Parent = holder
	elseif typeof(where) == "Instance" then
		sound.Parent = where
	else
		sound.Parent = workspace
	end
	sound:Play()
	task.delay(8, function()
		sound:Destroy()
		if holder then
			holder:Destroy()
		end
	end)
end

-- A looping sound inside `parent` for slot `name`, or nil if the slot is empty.
function Sounds.loop(name: string, parent: Instance): Sound?
	local slot = Sounds.Slots[name]
	if not slot or slot.Id == "" then
		return nil
	end
	local sound = Instance.new("Sound")
	sound.Name = name
	sound.SoundId = slot.Id
	sound.Volume = slot.Volume or 0.5
	sound.PlaybackSpeed = slot.Pitch or 1
	sound.Looped = true
	sound.Parent = parent
	sound:Play()
	return sound
end

return Sounds
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="10">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="11">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--[[
	Server entry point.
	Loads every ModuleScript in the Services folder, calls :Init() on all of
	them (set-up, no cross-service calls yet), then :Start() (begin running).
	To add a new system, drop a new module in src/server/Services.
]]

local servicesFolder = script:WaitForChild("Services")

-- Models you edited in Workspace > ModelWorkshop become the game's models.
local ModelFactory = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("ModelFactory"))
local okCollect, errCollect = pcall(ModelFactory.collectWorkshop)
if not okCollect then
	warn("[VikingCity] couldn't use ModelWorkshop: " .. tostring(errCollect))
end

local services = {}
for _, module in servicesFolder:GetChildren() do
	if module:IsA("ModuleScript") then
		services[module.Name] = require(module)
	end
end

-- Each service starts on its own, so one error can't stop the whole game.
for name, service in services do
	if service.Init then
		local ok, err = pcall(service.Init, service, services)
		if not ok then
			warn("[VikingCity] " .. name .. " failed to set up: " .. tostring(err))
		end
	end
end

-- Workspace > ShowModelWorkshop ticked: lay out every model in the meadow
-- while playing, so it can be copied (Ctrl+C), then pasted back in after
-- pressing Stop, where it can be edited and saved.
local show = workspace:FindFirstChild("ShowModelWorkshop")
if show and show:IsA("BoolValue") and show.Value then
	local ok, err = pcall(function()
		ModelFactory.bakeTemplates()
		for _, item in workspace.ModelWorkshop:GetChildren() do
			local handle = item:IsA("Tool") and item:FindFirstChild("Handle")
			if handle and handle:IsA("BasePart") then
				handle.CanTouch = false -- so walking past doesn't pick the tool up
			end
		end
	end)
	if not ok then
		warn("[VikingCity] couldn't lay out ModelWorkshop: " .. tostring(err))
	end
	print("[VikingCity] ModelWorkshop is in Workspace: copy it, press Stop, paste it into Workspace")
end

for name, service in services do
	if service.Start then
		task.spawn(function()
			service:Start()
		end)
	end
	print("[VikingCity] started " .. name)
end
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">EditTools</string>
          <string name="Source"><![CDATA[--[[
	EditTools
	Run from Studio's Command Bar (View > Command Bar) while NOT playing:

	    require(game.ServerScriptService.Server.EditTools).Setup()

	It does two things, so you can see and change the game's world and
	models in edit mode, then save them in your place:
	  1. builds the whole valley (terrain, forests, rocks, docks, lighting)
	     into Workspace, and marks it as saved so the game doesn't rebuild it
	  2. puts a copy of every building, tree, rock, bush, deer and tool in
	     Workspace > ModelWorkshop, in a row in the meadow behind your plot

	Studio may freeze for up to a minute while it builds. Run it once; run
	it again later only if you want to start the valley from scratch (your
	ModelWorkshop edits are kept).

	Other commands:
	    require(game.ServerScriptService.Server.EditTools).Models()  -- only step 2
	    require(game.ServerScriptService.Server.EditTools).Reset()   -- undo step 1
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local EditTools = {}

local function factory()
	return require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ModelFactory"))
end

function EditTools.Models()
	local made = factory().bakeTemplates()
	print("[EditTools] added " .. made .. " models to Workspace > ModelWorkshop")
end

function EditTools.Setup()
	local start = os.clock()
	local WorldService = require(script.Parent:WaitForChild("Services"):WaitForChild("WorldService"))
	WorldService:Bake()
	EditTools.Models()
	print(string.format("[EditTools] done in %.0f seconds. Now File > Save to File As to keep it.", os.clock() - start))
end

-- Throws the saved valley away, so the game builds a fresh one each time again.
function EditTools.Reset()
	for _, name in { "Scenery", "ShoreFoam" } do
		local old = workspace:FindFirstChild(name)
		if old then
			old:Destroy()
		end
	end
	workspace.Terrain:Clear()
	workspace:SetAttribute("WorldBaked", nil)
	print("[EditTools] saved valley removed; the game will build a new one when you press Play")
end

return EditTools
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="13">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">BoatService</string>
            <string name="Source"><![CDATA[--[[
	BoatService
	Sailing and sea battles.

	Research Karve (needs a Shipyard) and walk to the end of the jetty in
	front of your plot: hold E to launch a boat and take the helm.
	  W/S  row forward and back      A/D  steer
	  F    loose a volley of arrows at the nearest enemy ship
	  Space jump off
	Ram an enemy at speed to smash its hull. Every ship has a hull bar; at
	zero it sinks and the crew swims for it. Sink a ship and you take its
	cargo. Research Longship for a bigger, faster, tougher war ship.

	A Greywater raider longship patrols the fjord and attacks player ships
	that come close. It comes back a few minutes after you sink it.
	Boats stay on the water: land, sand and ice stop them, so you can beach
	one near Greywater Hold for a raid.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Sounds = require(Shared.Sounds)
local Grid = require(Shared.Grid)
local Remotes = require(Shared.Remotes)
local ModelFactory = require(Shared.ModelFactory)

local BoatService = {}

local N = Config.Naval
local services
local ships = {} -- [ship] = true, every ship afloat (players' and raiders)
local boats = {} -- [player] = ship
local inputs = {} -- [player] = { throttle, steer }
local rng = Random.new()

local KINDS = {
	Karve = { length = 26, speed = 24, turn = 0.9, sail = Color3.fromRGB(200, 190, 170), hull = N.KarveHull, ram = 1 },
	Longship = { length = 44, speed = 38, turn = 0.6, sail = Color3.fromRGB(160, 40, 36), hull = N.LongshipHull, ram = 1.5 },
	Raider = { length = 40, speed = N.RaiderSpeed, turn = 0.55, sail = Color3.fromRGB(40, 50, 70), hull = N.RaiderHull, ram = 1.3 },
}

function BoatService:Init(allServices)
	services = allServices
end

local waterParams = RaycastParams.new()
waterParams.FilterType = Enum.RaycastFilterType.Include
waterParams.IgnoreWater = false

local function isWater(pos: Vector3): boolean
	waterParams.FilterDescendantsInstances = { workspace.Terrain }
	local hit = workspace:Raycast(pos + Vector3.new(0, 30, 0), Vector3.new(0, -60, 0), waterParams)
	return hit ~= nil and hit.Material == Enum.Material.Water
end

-- Hull bar ------------------------------------------------------------------

local function makeHullBar(ship)
	local anchor = ship.model.PrimaryPart or ship.model:FindFirstChildWhichIsA("BasePart", true)
	local gui = Instance.new("BillboardGui")
	gui.Name = "HullBar"
	gui.Size = UDim2.fromOffset(150, 30)
	gui.StudsOffsetWorldSpace = Vector3.new(0, 26, 0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 260
	gui.Adornee = anchor
	local title = Instance.new("TextLabel")
	title.BackgroundTransparency = 1
	title.Size = UDim2.new(1, 0, 0, 16)
	title.Font = Enum.Font.GothamBold
	title.TextSize = 14
	title.TextColor3 = ship.owner and Color3.fromRGB(245, 235, 215) or Color3.fromRGB(240, 120, 100)
	title.TextStrokeTransparency = 0.4
	title.Text = ship.title
	title.Parent = gui
	local back = Instance.new("Frame")
	back.Position = UDim2.fromOffset(10, 18)
	back.Size = UDim2.new(1, -20, 0, 8)
	back.BackgroundColor3 = Color3.fromRGB(30, 22, 18)
	back.BorderSizePixel = 0
	back.Parent = gui
	local fill = Instance.new("Frame")
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = Color3.fromRGB(120, 200, 100)
	fill.BorderSizePixel = 0
	fill.Parent = back
	gui.Parent = ship.model
	ship.bar = fill
end

local function updateBar(ship)
	if ship.bar then
		local t = math.clamp(ship.hp / ship.maxHp, 0, 1)
		ship.bar.Size = UDim2.fromScale(t, 1)
		ship.bar.BackgroundColor3 = Color3.fromRGB(230, 90, 70):Lerp(Color3.fromRGB(120, 200, 100), t)
	end
end

-- Ships ---------------------------------------------------------------------

local function newShip(kindName: string, start: CFrame, owner: Player?, title: string)
	local kind = KINDS[kindName]
	local model = ModelFactory.longship(kind.length, kind.sail)
	model.Name = title
	model:SetAttribute("Ship", true)
	model:SetAttribute("OwnerUserId", owner and owner.UserId or 0)
	model:PivotTo(start)
	model.Parent = workspace
	local ship = {
		kind = kindName,
		model = model,
		owner = owner,
		title = title,
		cf = start,
		speed = 0,
		maxSpeed = kind.speed,
		turn = kind.turn,
		length = kind.length,
		ramPower = kind.ram,
		hp = kind.hull,
		maxHp = kind.hull,
		idle = 0,
		lastVolley = 0,
		lastRam = 0,
	}
	makeHullBar(ship)
	ships[ship] = true
	return ship
end

local function destroyShip(ship)
	ships[ship] = nil
	if ship.owner and boats[ship.owner] == ship then
		boats[ship.owner] = nil
	end
	if ship.model then
		ship.model:Destroy()
	end
end

local function removeBoat(player: Player)
	local ship = boats[player]
	if ship then
		destroyShip(ship)
	end
end

local function notify(player: Player?, text: string, kind: string)
	if player then
		local colony = services.ColonyService:Get(player)
		if colony then
			services.ColonyService:Notify(colony, text, kind)
		end
	end
end

local function jettyCFrame(player: Player): CFrame?
	local colony = services.ColonyService:Get(player)
	if not colony then
		return nil
	end
	local o = Grid.plotOrigin(colony.plotIndex)
	return CFrame.new(o.X + Grid.PLOT_SIZE * 0.25, 4, -70)
end

local function sink(ship, attacker: Player?)
	if ship.sinking then
		return
	end
	ship.sinking = true
	ships[ship] = nil
	if ship.owner and boats[ship.owner] == ship then
		boats[ship.owner] = nil
	end

	-- the crew jumps clear and is fished out at their jetty
	local seat = ship.seat
	local occupant = seat and seat.Occupant
	if occupant then
		occupant.Sit = false
		occupant.Jump = true
		local player = Players:GetPlayerFromCharacter(occupant.Parent)
		task.delay(2.5, function()
			local cf = player and jettyCFrame(player)
			if cf and player.Character then
				player.Character:PivotTo(cf)
			end
		end)
	end

	if ship.owner then
		notify(ship.owner, "Your ship has been sunk! Build another at the jetty.", "bad")
	end
	if attacker then
		local colony = services.ColonyService:Get(attacker)
		if colony and ship.owner ~= attacker then
			local loot = ship.owner and { Silver = 8, Food = 15 } or N.RaiderLoot
			for res, amount in loot do
				services.ColonyService:Add(colony, res, amount)
			end
			services.QuestService:Count(colony, "sunk")
			services.ColonyService:Notify(colony, ship.title .. " sinks beneath the waves! Plundered " .. Grid.costText(loot), "raid")
		end
	end

	Sounds.play("Splash", ship.cf.Position)
	-- list, settle and slip under
	local model = ship.model
	local startCf = ship.cf
	local tilt = rng:NextNumber(-1, 1) > 0 and 1 or -1
	task.spawn(function()
		local t0 = os.clock()
		while model.Parent and os.clock() - t0 < 6 do
			local t = (os.clock() - t0) / 6
			model:PivotTo(startCf * CFrame.new(0, -t * t * 22, 0) * CFrame.Angles(t * 0.5, 0, tilt * t * 0.9))
			task.wait()
		end
		model:Destroy()
	end)
	if ship.kind == "Raider" then
		task.delay(N.RaiderRespawn, function()
			BoatService:SpawnRaider()
		end)
	end
end

local function damage(ship, amount: number, attacker: Player?)
	if ship.sinking or not ships[ship] then
		return
	end
	ship.hp -= amount
	updateBar(ship)
	if ship.hp <= 0 then
		sink(ship, attacker)
	end
end

-- Combat --------------------------------------------------------------------

-- An arrow from a player's bow landed on `inst`: if it's part of an enemy ship, hurt it.
function BoatService:ArrowHit(inst: Instance, player: Player)
	for ship in ships do
		if ship.owner ~= player and inst:IsDescendantOf(ship.model) then
			damage(ship, N.VolleyDamage * 0.6, player)
			return
		end
	end
end

-- Distance from a point to a ship's keel line (so long ships are hit along their length).
local function distanceToShip(ship, point: Vector3): number
	local half = ship.length / 2
	local rel = ship.cf:PointToObjectSpace(point)
	local z = math.clamp(rel.Z, -half, half)
	return (Vector3.new(rel.X, 0, rel.Z - z)).Magnitude
end

local function isEnemy(a, b): boolean
	if a == b or b.sinking then
		return false
	end
	if a.owner == nil and b.owner == nil then
		return false -- raiders don't fight each other
	end
	return a.owner ~= b.owner
end

local function nearestEnemy(ship, range: number)
	local best, bestDist = nil, range
	for other in ships do
		-- raiders leave you alone in your own harbour
		local safe = ship.owner == nil and other.dock ~= nil and (other.cf.Position - other.dock).Magnitude < 50
		if isEnemy(ship, other) and not safe then
			local d = (other.cf.Position - ship.cf.Position).Magnitude
			if d < bestDist then
				best, bestDist = other, d
			end
		end
	end
	return best
end

local function volley(ship)
	local now = os.clock()
	local cooldown = ship.owner and N.VolleyCooldown or N.VolleyCooldown * 1.7
	if ship.sinking or now - ship.lastVolley < cooldown then
		return false
	end
	local target = nearestEnemy(ship, N.VolleyRange)
	if not target then
		return false
	end
	ship.lastVolley = now
	Sounds.play("Bow", ship.cf.Position)
	local attacker = ship.owner
	local hits = 0
	local accuracy = attacker and 0.75 or 0.55
	if attacker and services.ColonyService:Has(services.ColonyService:Get(attacker), "Longbows") then
		accuracy = 0.9
	end
	for i = 1, N.VolleyArrows do
		local from = ship.cf * CFrame.new(rng:NextNumber(-2, 2), 4, (i - N.VolleyArrows / 2) * ship.length / (N.VolleyArrows + 1))
		local hit = rng:NextNumber() < accuracy
		local aim = target.cf * CFrame.new(rng:NextNumber(-2, 2), 3, rng:NextNumber(-target.length / 2.5, target.length / 2.5))
		local to = hit and aim.Position or (aim.Position + Vector3.new(rng:NextNumber(-10, 10), -3, rng:NextNumber(-10, 10)))
		if hit then
			hits += 1
		end
		task.delay(i * 0.08, function()
			local arrow = ModelFactory.arrow()
			local mid = (from.Position + to) / 2 + Vector3.new(0, (to - from.Position).Magnitude * 0.15, 0)
			arrow.CFrame = CFrame.lookAt(from.Position, mid)
			arrow.Parent = workspace
			local flight = (to - from.Position).Magnitude / 120
			TweenService:Create(arrow, TweenInfo.new(flight / 2, Enum.EasingStyle.Linear), { CFrame = CFrame.lookAt(mid, to) }):Play()
			task.delay(flight / 2, function()
				if arrow.Parent then
					TweenService:Create(arrow, TweenInfo.new(flight / 2, Enum.EasingStyle.Linear), { CFrame = CFrame.lookAt(to, to + (to - mid).Unit) }):Play()
				end
			end)
			Debris:AddItem(arrow, flight + 2)
		end)
	end
	local flight = (target.cf.Position - ship.cf.Position).Magnitude / 120
	task.delay(flight, function()
		damage(target, hits * N.VolleyDamage, attacker)
	end)
	return true
end

local function checkRam(ship, now: number)
	if ship.sinking or now - ship.lastRam < 1.5 or ship.speed < ship.maxSpeed * 0.45 then
		return
	end
	local bow = ship.cf.Position + ship.cf.LookVector * ship.length / 2
	for other in ships do
		if other ~= ship and not other.sinking and distanceToShip(other, bow) < 5.5 then
			ship.lastRam = now
			local force = ship.speed / ship.maxSpeed
			if isEnemy(ship, other) then
				damage(other, N.RamDamage * ship.ramPower * force, ship.owner)
			end
			damage(ship, N.RamSelfDamage * force, other.owner)
			other.cf += ship.cf.LookVector * 4
			ship.speed = -ship.speed * 0.3
			notify(ship.owner, "RAM! Timber splinters!", "gain")
			notify(other.owner, "You've been rammed!", "bad")
			return
		end
	end
end

-- Movement shared by every ship. Returns the turn rate used (for the roll).
local function steerShip(ship, throttle: number, steerInput: number, step: number): number
	local target = throttle * ship.maxSpeed * (throttle < 0 and 0.4 or 1)
	ship.speed += (target - ship.speed) * math.min(1, step * 0.8)
	local turnRate = steerInput * ship.turn * math.clamp(math.abs(ship.speed) / 10, 0.25, 1)
	local heading = ship.cf * CFrame.Angles(0, -turnRate * step, 0)
	local nextPos = heading.Position + heading.LookVector * ship.speed * step
	if isWater(nextPos + heading.LookVector * 8 * math.sign(ship.speed)) then
		ship.cf = CFrame.new(nextPos) * heading.Rotation
	else
		ship.speed = 0 -- ran aground
		ship.cf = heading
	end
	return turnRate
end

-- The raider's brain: patrol, then close in, keep broadside on, and loose volleys.
local function raiderThink(ship): (number, number)
	local target = nearestEnemy(ship, N.RaiderAggro)
	local goal
	if target then
		local d = (target.cf.Position - ship.cf.Position).Magnitude
		if d > 45 then
			goal = target.cf.Position
		else
			-- circle the target so the archers have a clear line
			local side = ship.cf.RightVector
			goal = ship.cf.Position + ship.cf.LookVector * 30 + side * 10
		end
		volley(ship)
	else
		if not ship.waypoint or (ship.waypoint - ship.cf.Position).Magnitude < 20 then
			for _ = 1, 12 do
				local p = Vector3.new(rng:NextNumber(-320, 520), 0, rng:NextNumber(-230, -120))
				if isWater(p) then
					ship.waypoint = p
					break
				end
			end
		end
		goal = ship.waypoint or ship.cf.Position
	end
	local localGoal = ship.cf:PointToObjectSpace(goal)
	local steer = math.clamp(localGoal.X / 20, -1, 1)
	local throttle = target and 1 or 0.6
	if ship.speed < 1 and ship.stuckSince and os.clock() - ship.stuckSince > 3 then
		ship.waypoint = nil
		steer = 1
		throttle = -1
	end
	if math.abs(ship.speed) < 1 then
		ship.stuckSince = ship.stuckSince or os.clock()
	else
		ship.stuckSince = nil
	end
	return throttle, steer
end

function BoatService:SpawnRaider()
	for _ = 1, 30 do
		local p = Vector3.new(rng:NextNumber(-250, 400), 0, rng:NextNumber(-220, -140))
		if isWater(p) then
			newShip("Raider", CFrame.new(p) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0), nil, "Greywater Raider")
			return
		end
	end
	task.delay(30, function()
		self:SpawnRaider()
	end)
end

-- Launching -----------------------------------------------------------------

local function launch(player: Player, dockIndex: number)
	local ColonyService = services.ColonyService
	local colony = ColonyService:Get(player)
	if not colony then
		return
	end
	if colony.plotIndex ~= dockIndex then
		ColonyService:Notify(colony, "This is someone else's jetty. Use the one in front of your plot.", "bad")
		return
	end
	local kindName = ColonyService:Has(colony, "Longship") and "Longship" or (ColonyService:Has(colony, "Karve") and "Karve")
	if not kindName then
		ColonyService:Notify(colony, "Build a Shipyard and research Karve first (press T).", "bad")
		return
	end
	local kind = KINDS[kindName]
	removeBoat(player)

	local o = Grid.plotOrigin(dockIndex)
	local start = CFrame.new(o.X + Grid.PLOT_SIZE * 0.25 - 16, 0, -100)
	local ship = newShip(kindName, start, player, player.DisplayName .. "'s " .. kindName)
	local seat = Instance.new("Seat")
	seat.Name = "Helm"
	seat.Anchored = true
	seat.Size = Vector3.new(2, 0.6, 2)
	seat.Color = Color3.fromRGB(90, 64, 44)
	seat.Material = Enum.Material.Wood
	seat.CFrame = start * CFrame.new(0, 0.2, kind.length * 0.32)
	seat:SetAttribute("Boat", true)
	seat.Parent = ship.model
	ship.seat = seat
	ship.dock = start.Position
	boats[player] = ship
	Sounds.play("Splash", start.Position)
	services.QuestService:Count(colony, "launch")

	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		character:PivotTo(seat.CFrame * CFrame.new(0, 3, 0))
		task.wait(0.1)
		seat:Sit(humanoid)
	end
	ColonyService:Notify(colony, "Your " .. kindName .. " is in the water! W/S row, A/D steer, F volley of arrows, ram enemies at speed.", "good")
end

function BoatService:Start()
	-- a launch prompt at the end of every plot's jetty
	for i = 1, Config.MAX_PLOTS do
		local o = Grid.plotOrigin(i)
		local anchor = Instance.new("Part")
		anchor.Name = "LaunchPoint"
		anchor.Anchored = true
		anchor.CanCollide = false
		anchor.CanQuery = false
		anchor.Transparency = 1
		anchor.Size = Vector3.new(1, 1, 1)
		anchor.Position = Vector3.new(o.X + Grid.PLOT_SIZE * 0.25, 3, -76)
		anchor.Parent = workspace
		local prompt = Instance.new("ProximityPrompt")
		prompt.ActionText = "Launch boat"
		prompt.ObjectText = "Jetty"
		prompt.HoldDuration = 1
		prompt.MaxActivationDistance = 12
		prompt.RequiresLineOfSight = false
		prompt.Parent = anchor
		prompt.Triggered:Connect(function(player)
			launch(player, i)
		end)
	end

	Remotes.BoatInput.OnServerEvent:Connect(function(player, throttle, steer)
		if typeof(throttle) ~= "number" or typeof(steer) ~= "number" or throttle ~= throttle or steer ~= steer then
			return
		end
		inputs[player] = { math.clamp(throttle, -1, 1), math.clamp(steer, -1, 1) }
	end)
	Remotes.BoatFire.OnServerEvent:Connect(function(player)
		local ship = boats[player]
		if ship and ship.seat and ship.seat.Occupant and ship.seat.Occupant.Parent == player.Character then
			if not volley(ship) and os.clock() - ship.lastVolley >= N.VolleyCooldown then
				notify(player, "No enemy ship in bow range (" .. N.VolleyRange .. " studs).", "info")
			end
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		removeBoat(player)
		inputs[player] = nil
	end)

	self:SpawnRaider()

	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		if accumulator < 1 / 30 then
			return
		end
		local step = accumulator
		accumulator = 0
		local now = os.clock()
		for ship in ships do
			local throttle, steer = 0, 0
			if ship.owner then
				local occupied = ship.seat.Occupant ~= nil
				if occupied then
					ship.idle = 0
					local input = inputs[ship.owner] or { 0, 0 }
					throttle, steer = input[1], input[2]
				else
					ship.idle += step
					if ship.idle > 90 then
						destroyShip(ship)
						continue
					end
				end
				-- moored near your own jetty: the shipwrights patch the hull
				if ship.hp < ship.maxHp and (ship.cf.Position - ship.dock).Magnitude < 40 then
					ship.hp = math.min(ship.maxHp, ship.hp + N.RepairPerSecond * step)
					updateBar(ship)
				end
			else
				throttle, steer = raiderThink(ship)
			end
			local turnRate = steerShip(ship, throttle, steer, step)
			checkRam(ship, now)
			if ships[ship] then
				local bob = math.sin(now * 1.3 + ship.length) * 0.25
				local roll = math.sin(now * 0.9) * math.rad(2) - turnRate * 0.08
				local pitch = math.sin(now * 1.1) * math.rad(1)
				ship.model:PivotTo(ship.cf * CFrame.new(0, bob, 0) * CFrame.Angles(pitch, 0, roll))
			end
		end
	end)
end

return BoatService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">BuildingService</string>
            <string name="Source"><![CDATA[--[[
	BuildingService
	Validates and performs building placement and demolition requested by
	clients. The server always re-checks everything (cost, bounds, overlap)
	because clients can't be trusted.
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Sounds = require(Shared.Sounds)
local Grid = require(Shared.Grid)
local Remotes = require(Shared.Remotes)
local ModelFactory = require(Shared.ModelFactory)

local BuildingService = {}

local services

function BuildingService:Init(allServices)
	services = allServices
end

-- Construction effect: the building rises out of the ground in a puff of dust.
local function raiseUp(model: Model, finalCFrame: CFrame)
	local _, size = model:GetBoundingBox()
	local depth = size.Y + 1
	local dust = Instance.new("Part")
	dust.Anchored = true
	dust.CanCollide = false
	dust.CanQuery = false
	dust.Transparency = 1
	dust.Size = Vector3.new(size.X, 1, size.Z)
	dust.CFrame = finalCFrame
	dust.Parent = model.Parent
	local puff = Instance.new("Smoke")
	puff.Color = Color3.fromRGB(150, 130, 100)
	puff.Opacity = 0.25
	puff.RiseVelocity = 2
	puff.Size = math.max(size.X, size.Z) / 3
	puff.Parent = dust
	task.spawn(function()
		local duration = 1.2
		local start = os.clock()
		while model.Parent do
			local t = math.min((os.clock() - start) / duration, 1)
			local e = 1 - (1 - t) ^ 3 -- ease out
			model:PivotTo(finalCFrame * CFrame.new(0, -depth * (1 - e), 0))
			if t >= 1 then
				break
			end
			task.wait()
		end
		puff.Enabled = false
		task.wait(2)
		dust:Destroy()
	end)
end

-- Creates the building without any checks or cost. Returns the building record.
function BuildingService:Create(colony, buildingType: string, cx: number, cz: number, rot: number, animate: boolean?)
	local ColonyService = services.ColonyService
	local sx, sz = Grid.footprint(buildingType, rot)
	local id = ColonyService:NewId(colony)

	local model = ModelFactory.building(buildingType)
	model.Name = buildingType .. "_" .. id
	model:SetAttribute("BuildingId", id)
	model:SetAttribute("BuildingType", buildingType)
	model:SetAttribute("OwnerUserId", colony.player.UserId)
	local finalCFrame = Grid.buildingCFrame(colony.origin, cx, cz, sx, sz, rot)
	model:PivotTo(finalCFrame)
	services.SeasonService:ApplyTo(model) -- e.g. snow on the roof in winter
	model.Parent = colony.plot.Buildings
	if animate then
		raiseUp(model, finalCFrame)
	end

	local building = {
		id = id,
		type = buildingType,
		cx = cx,
		cz = cz,
		rot = rot,
		sx = sx,
		sz = sz,
		model = model,
		center = Grid.rectCenter(colony.origin, cx, cz, sx, sz),
	}
	colony.buildings[id] = building

	Grid.eachCell(cx, cz, sx, sz, function(x, z)
		ColonyService:Block(colony, x, z, "building")
	end)
	return building
end

function BuildingService:PlaceStarting(colony)
	local sx, sz = Grid.footprint("Longhouse", 0)
	local cx = math.floor((Config.PLOT_CELLS - sx) / 2)
	local cz = math.floor((Config.PLOT_CELLS - sz) / 2)
	self:Create(colony, "Longhouse", cx, cz, 0)
end

function BuildingService:TryPlace(player: Player, buildingType, cx, cz, rot)
	local ColonyService = services.ColonyService
	local colony = ColonyService:Get(player)
	if not colony then
		return false, "Your colony isn't ready yet"
	end
	-- Validate the types of everything the client sent.
	if typeof(buildingType) ~= "string" or not Config.Buildings[buildingType] then
		return false, "Unknown building"
	end
	if typeof(cx) ~= "number" or typeof(cz) ~= "number" or typeof(rot) ~= "number" then
		return false, "Bad position"
	end
	cx, cz, rot = math.floor(cx), math.floor(cz), math.floor(rot) % 4
	if rot ~= rot or cx ~= cx or cz ~= cz then -- NaN / infinity guard
		return false, "Bad position"
	end

	local def = Config.Buildings[buildingType]
	if def.Requires and not ColonyService:Has(colony, def.Requires) then
		return false, "Research " .. Config.Tech[def.Requires].Name .. " first (press T)"
	end
	local sx, sz = Grid.footprint(buildingType, rot)
	local ok, reason = Grid.canPlace(colony.blocked, cx, cz, sx, sz)
	if not ok then
		return false, reason
	end
	if not ColonyService:Spend(colony, def.Cost) then
		return false, "Not enough resources (" .. Grid.costText(def.Cost) .. ")"
	end

	local building = self:Create(colony, buildingType, cx, cz, rot, true)
	Sounds.play("Build", building.center)
	ColonyService:Sync(colony)
	return true, def.Display .. " built"
end

function BuildingService:TryDemolish(player: Player, id)
	local ColonyService = services.ColonyService
	local colony = ColonyService:Get(player)
	if not colony or typeof(id) ~= "number" then
		return false, "Nothing to demolish"
	end
	local building = colony.buildings[id]
	if not building then
		return false, "That isn't yours"
	end
	local def = Config.Buildings[building.type]
	if def.Housing then
		local homes = 0
		for _, b in colony.buildings do
			if Config.Buildings[b.type].Housing then
				homes += 1
			end
		end
		if homes <= 1 then
			return false, "You can't tear down your last home"
		end
	end

	colony.buildings[id] = nil
	building.model:Destroy()
	Grid.eachCell(building.cx, building.cz, building.sx, building.sz, function(x, z)
		ColonyService:Unblock(colony, x, z)
	end)
	for name, amount in def.Cost do
		ColonyService:Add(colony, name, math.floor(amount * Config.DemolishRefund))
	end
	services.VillagerService:OnBuildingRemoved(colony, id)
	ColonyService:Sync(colony)
	return true, def.Display .. " demolished"
end

function BuildingService:Start()
	Remotes.PlaceBuilding.OnServerInvoke = function(player, buildingType, cx, cz, rot)
		return self:TryPlace(player, buildingType, cx, cz, rot)
	end
	Remotes.DemolishBuilding.OnServerInvoke = function(player, id)
		return self:TryDemolish(player, id)
	end
end

return BuildingService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">ColonyService</string>
            <string name="Source"><![CDATA[--[[
	ColonyService
	Owns each player's colony: resources, the grid of blocked cells, and the
	main simulation loop. Other services read and change the colony table
	through the helpers here, and ColonyService sends a snapshot to the
	player's HUD every tick.

	colony = {
		player, plotIndex, origin, plot,
		resources = { Wood = n, Stone = n, Food = n },
		blocked = { ["x,z"] = "building" | "node" },
		buildings = { [id] = building },
		villagers = { [id] = villager },
		nodes = { [key] = node },
		happiness, day, dayTimer, starving, nextId, gridDirty,
	}
]]

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Grid = require(Shared.Grid)
local Remotes = require(Shared.Remotes)

local ColonyService = {}

local services
local colonies = {} -- [player] = colony

function ColonyService:Init(allServices)
	services = allServices
end

function ColonyService:Get(player: Player)
	return colonies[player]
end

function ColonyService:All()
	return colonies
end

-- Has this colony researched `techId`?
function ColonyService:Has(colony, techId: string): boolean
	return colony ~= nil and colony.tech[techId] == true
end

function ColonyService:HasBuilding(colony, buildingType: string): boolean
	for _, b in colony.buildings do
		if b.type == buildingType then
			return true
		end
	end
	return false
end

function ColonyService:NewId(colony): number
	colony.nextId += 1
	return colony.nextId
end

-- Resources -----------------------------------------------------------------

function ColonyService:Storage(colony): number
	local total = Config.BaseStorage
	for _, b in colony.buildings do
		total += Config.Buildings[b.type].Storage or 0
	end
	return total
end

function ColonyService:Housing(colony): number
	local total = 0
	for _, b in colony.buildings do
		total += Config.Buildings[b.type].Housing or 0
	end
	return total
end

function ColonyService:Add(colony, resource: string, amount: number)
	local cap = self:Storage(colony)
	colony.resources[resource] = math.clamp((colony.resources[resource] or 0) + amount, 0, cap)
end

function ColonyService:CanAfford(colony, cost): boolean
	return Grid.canAfford(colony.resources, cost)
end

function ColonyService:Spend(colony, cost): boolean
	if not self:CanAfford(colony, cost) then
		return false
	end
	for name, amount in cost do
		colony.resources[name] -= amount
	end
	return true
end

-- Grid ----------------------------------------------------------------------

function ColonyService:Block(colony, x: number, z: number, what: string)
	colony.blocked[Grid.key(x, z)] = what
	colony.gridDirty = true
end

function ColonyService:Unblock(colony, x: number, z: number)
	colony.blocked[Grid.key(x, z)] = nil
	colony.gridDirty = true
end

-- Messages ------------------------------------------------------------------

function ColonyService:Notify(colony, text: string, kind: string?)
	Remotes.Notify:FireClient(colony.player, text, kind or "info")
end

-- Sync ----------------------------------------------------------------------

function ColonyService:Sync(colony)
	local adults, children, workers = 0, 0, 0
	for _, v in colony.villagers do
		if v.isChild then
			children += 1
		else
			adults += 1
			if v.job then
				workers += 1
			end
		end
	end

	local resources = {}
	for _, name in Config.ResourceOrder do
		resources[name] = math.floor(colony.resources[name] or 0)
	end

	local state = {
		resources = resources,
		storage = self:Storage(colony),
		population = adults + children,
		adults = adults,
		children = children,
		workers = workers,
		idle = adults - workers,
		housing = self:Housing(colony),
		happiness = math.floor(colony.happiness + 0.5),
		starving = colony.starving,
		day = colony.day,
		season = workspace:GetAttribute("Season") or "Summer",
		tech = (function()
			local list = {}
			for id in colony.tech do
				table.insert(list, id)
			end
			return list
		end)(),
		buildingTypes = (function()
			local set = {}
			for _, b in colony.buildings do
				set[b.type] = true
			end
			return set
		end)(),
		dayProgress = colony.dayTimer / Config.DAY_LENGTH,
		quest = services.QuestService:State(colony),
	}

	if colony.gridDirty then
		local blocked = {}
		for key in colony.blocked do
			table.insert(blocked, key)
		end
		state.blocked = blocked
		colony.gridDirty = false
	end

	Remotes.ColonyState:FireClient(colony.player, state)
end

-- Lifecycle -----------------------------------------------------------------

function ColonyService:Create(player: Player)
	local index, origin, plot = services.PlotService:Assign(player)
	if not index then
		return
	end

	local colony = {
		player = player,
		plotIndex = index,
		origin = origin,
		plot = plot,
		resources = table.clone(Config.StartingResources),
		blocked = {},
		buildings = {},
		villagers = {},
		nodes = {},
		tech = {},
		stats = {},
		quest = 1,
		happiness = 60,
		day = 1,
		dayTimer = 0,
		starving = false,
		nextId = 0,
		gridDirty = true,
	}
	local SaveService = services.SaveService
	local data, canSave = SaveService:Load(player)
	if not player.Parent then
		return -- left while loading
	end
	colony.canSave = canSave
	colonies[player] = colony
	player:SetAttribute("PlotIndex", index) -- for the minimap

	if data then
		SaveService:Restore(colony, data)
	else
		services.BuildingService:PlaceStarting(colony)
		services.VillagerService:SpawnStarting(colony)
	end
	services.ResourceNodeService:SpawnInitial(colony)

	if data then
		self:Notify(colony, "Welcome back! Your village is as you left it (day " .. colony.day .. ").", "good")
	else
		self:Notify(colony, "Your people have landed. Build a farm and a woodcutter to get started!", "good")
	end
	if not canSave then
		task.delay(4, function()
			self:Notify(colony, SaveService:WhyOff(), "bad")
		end)
	end
	self:Sync(colony)
end

function ColonyService:Start()
	Players.PlayerAdded:Connect(function(player)
		self:Create(player)
	end)
	for _, player in Players:GetPlayers() do
		if not colonies[player] then
			self:Create(player)
		end
	end
	Players.PlayerRemoving:Connect(function(player)
		local colony = colonies[player]
		if colony then
			services.SaveService:Save(colony)
			services.VillagerService:Cleanup(colony)
		end
		colonies[player] = nil
	end)

	-- Main simulation loop.
	while true do
		local dt = task.wait(Config.TICK)
		for _, colony in colonies do
			local ok, err = pcall(function()
				services.VillagerService:Tick(colony, dt)
				services.ResourceNodeService:Tick(colony, dt)
				self:Sync(colony)
			end)
			if not ok then
				warn("[ColonyService] tick error: " .. tostring(err))
			end
		end
	end
end

return ColonyService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">PlotService</string>
            <string name="Source"><![CDATA[--[[
	PlotService
	Gives each player their own square of land, builds the ground for it,
	and moves their character there when they spawn.
]]

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Grid = require(Shared.Grid)

local PlotService = {}

local plotsFolder: Folder
local used = {} -- [index] = player

local function makePart(props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in props do
		p[k] = v
	end
	return p
end

function PlotService:Init()
	plotsFolder = Instance.new("Folder")
	plotsFolder.Name = "Plots"
	plotsFolder.Parent = workspace
end

function PlotService:Start()
	Players.PlayerRemoving:Connect(function(player)
		self:Release(player)
	end)
end

-- Returns plotIndex, origin, plotModel. Called by ColonyService.
function PlotService:Assign(player: Player)
	local index
	for i = 1, Config.MAX_PLOTS do
		if not used[i] then
			index = i
			break
		end
	end
	if not index then
		warn("[PlotService] no free plots for " .. player.Name)
		return nil
	end
	used[index] = player

	local origin = Grid.plotOrigin(index)
	local size = Grid.PLOT_SIZE

	local plot = Instance.new("Model")
	plot.Name = "Plot_" .. index
	plot:SetAttribute("OwnerUserId", player.UserId)

	makePart({
		-- Invisible: the grass you see is Terrain (WorldService). This part
		-- is what the build preview aims at.
		Name = "Ground",
		Size = Vector3.new(size, 1, size),
		Position = origin + Vector3.new(size / 2, -0.5, size / 2),
		Transparency = 1,
		CanCollide = false,
		Parent = plot,
	})
	-- Wooden marker posts at the corners so you can see your borders.
	for _, x in { 0, size } do
		for _, z in { 0, size } do
			makePart({
				Name = "BorderPost",
				Size = Vector3.new(1, 6, 1),
				Position = origin + Vector3.new(x, 3, z),
				Color = Color3.fromRGB(78, 54, 36),
				Material = Enum.Material.Wood,
				Parent = plot,
			})
		end
	end

	local sign = Instance.new("BillboardGui")
	sign.Size = UDim2.fromOffset(260, 40)
	sign.StudsOffset = Vector3.new(0, 4, 0)
	sign.MaxDistance = 400
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.TextScaled = true
	label.TextColor3 = Color3.fromRGB(255, 240, 210)
	label.TextStrokeTransparency = 0.4
	label.Text = player.DisplayName .. "'s settlement"
	label.Parent = sign
	sign.Parent = plot:FindFirstChild("BorderPost")

	for _, name in { "Buildings", "Nodes", "Villagers" } do
		local f = Instance.new("Folder")
		f.Name = name
		f.Parent = plot
	end

	plot.Parent = plotsFolder

	player:SetAttribute("PlotIndex", index)
	player:SetAttribute("PlotOrigin", origin)
	player.CameraMaxZoomDistance = 160

	local function spawnAtPlot(character: Model)
		task.defer(function()
			character:PivotTo(CFrame.new(origin + Vector3.new(size / 2, 4, -Config.CELL)) * CFrame.Angles(0, math.pi, 0))
		end)
	end
	player.CharacterAdded:Connect(spawnAtPlot)
	if player.Character then
		spawnAtPlot(player.Character)
	end

	return index, origin, plot
end

function PlotService:Release(player: Player)
	for i, p in used do
		if p == player then
			used[i] = nil
			local plot = plotsFolder:FindFirstChild("Plot_" .. i)
			if plot then
				plot:Destroy()
			end
		end
	end
end

return PlotService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">QuestService</string>
            <string name="Source"><![CDATA[--[[
	QuestService
	The saga: Config.Quests is a chain of goals that walks a new player
	through the game (chop, farm, hunt, build, research, raid, sail...).
	One goal is active at a time; finishing it pays its reward and opens
	the next. Progress is sent to the HUD with the colony snapshot and
	saved with the village.

	Other services report things the player did with
	QuestService:Count(colony, "chop" | "mine" | "deer" | "plunder" | ...).
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Grid = require(Shared.Grid)

local QuestService = {}

local services

function QuestService:Init(allServices)
	services = allServices
end

function QuestService:Count(colony, stat: string, amount: number?)
	if not colony then
		return
	end
	colony.stats = colony.stats or {}
	colony.stats[stat] = (colony.stats[stat] or 0) + (amount or 1)
	self:Check(colony)
end

local function progress(colony, quest): number
	if quest.Kind == "stat" then
		-- things you did before the goal opened count too
		return colony.stats and colony.stats[quest.Stat] or 0
	elseif quest.Kind == "building" then
		local n = 0
		for _, b in colony.buildings do
			if b.type == quest.Building then
				n += 1
			end
		end
		return n
	elseif quest.Kind == "population" then
		local n = 0
		for _ in colony.villagers do
			n += 1
		end
		return n
	elseif quest.Kind == "tech" then
		local n = 0
		for _ in colony.tech do
			n += 1
		end
		return n
	end
	return 0
end

function QuestService:Check(colony)
	colony.quest = colony.quest or 1
	local quest = Config.Quests[colony.quest]
	if not quest then
		return
	end
	if progress(colony, quest) >= quest.Goal then
		local ColonyService = services.ColonyService
		for res, amount in quest.Reward or {} do
			ColonyService:Add(colony, res, amount)
		end
		ColonyService:Notify(colony, "Saga: \"" .. quest.Title .. "\" done! +" .. Grid.costText(quest.Reward or {}), "quest")
		colony.quest += 1
		self:Check(colony) -- the next one may already be done
	end
end

-- What the HUD shows.
function QuestService:State(colony)
	local index = colony.quest or 1
	local quest = Config.Quests[index]
	if not quest then
		return { done = true, index = index, total = #Config.Quests }
	end
	return {
		index = index,
		total = #Config.Quests,
		title = quest.Title,
		text = quest.Text,
		have = math.min(progress(colony, quest), quest.Goal),
		goal = quest.Goal,
		reward = Grid.costText(quest.Reward or {}),
	}
end

function QuestService:Start()
	-- buildings, population and research are checked once a second
	while true do
		task.wait(1)
		for _, colony in services.ColonyService:All() do
			self:Check(colony)
		end
	end
end

return QuestService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">RaidService</string>
            <string name="Source"><![CDATA[--[[
	RaidService
	Rival NPC villages behind palisades (Config.Rivals): Greywater Hold at
	the west end of the valley (walk past plot 1) and Ravensfell at the far
	east end. You can raid them:

	  - Sound the war horn at the gate (optional) and the guards form a
	    shield wall, then charge.
	  - Fight the guards with the Axe (click) or the Bow.
	  - Hold the Torch and press F at a building to set it alight. Fire
	    chars it black and can spread to neighbours. Buildings are never
	    deleted, only scorched.
	  - Plunder the chests by the storehouses for food, silver and wood.
	  - Once every guard has fallen, the hold's villagers may accept your
	    offer of a new home and join your settlement (needs free housing).

	After a raid the hold rebuilds itself (fires out, walls repaired, chests
	refilled, guards back) after Config.Rival.RegenSeconds.
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Sounds = require(Shared.Sounds)
local ModelFactory = require(Shared.ModelFactory)

local RaidService = {}

local services
-- Builds one rival hold from its settings (an entry of Config.Rivals).
local function newHold(R)
	local hold = { def = R }
	local rng = Random.new()
	local folder: Folder
	local statusLabel: TextLabel

	local state = {
		raidedAt = nil, -- os.clock() of the first hostile act, nil when peaceful
		alarm = false, -- guards hunt anyone nearby
		buildings = {},
		chests = {},
		defenders = {},
		folk = {},
		horn = nil,
	}

	local CENTER = R.Center
	-- the gate faces this way (0 = east, toward the player plots from the west end)
	local GATE = R.GateAngle or 0
	local gateDir = Vector3.new(math.cos(GATE), 0, math.sin(GATE))
	local gateSide = Vector3.new(-gateDir.Z, 0, gateDir.X)
	local CHAR = Color3.fromRGB(34, 28, 24)
	local WALK_ANIM = "rbxassetid://507777826"
	local IDLE_ANIM = "rbxassetid://507766388"


	local function flat(v: Vector3): Vector3
		return Vector3.new(v.X, 0, v.Z)
	end

	local function notifyAll(text: string, kind: string)
		local ColonyService = services.ColonyService
		for _, colony in ColonyService:All() do
			ColonyService:Notify(colony, text, kind)
		end
	end

	local function markRaid()
		if not state.raidedAt then
			state.raidedAt = os.clock()
		end
	end

	local function makePrompt(parent: Instance, action: string, objectText: string, key: Enum.KeyCode, holdTime: number)
		local prompt = Instance.new("ProximityPrompt")
		prompt.ActionText = action
		prompt.ObjectText = objectText
		prompt.KeyboardKeyCode = key
		prompt.HoldDuration = holdTime
		prompt.MaxActivationDistance = 14
		prompt.RequiresLineOfSight = false
		prompt.Parent = parent
		return prompt
	end

	local function anchorPart(cf: CFrame, parent: Instance): BasePart
		local p = Instance.new("Part")
		p.Name = "PromptAnchor"
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.Transparency = 1
		p.Size = Vector3.new(1, 1, 1)
		p.CFrame = cf
		p.Parent = parent
		return p
	end

	-- Fire ------------------------------------------------------------------------

	local function ignite(building)
		if building.burning then
			return
		end
		building.burning = true
		building.firePrompt.Enabled = false
		markRaid()

		local parts = {}
		for _, d in building.model:GetDescendants() do
			if d:IsA("BasePart") and d.Name ~= "PromptAnchor" then
				if d:GetAttribute("PreBurnColor") == nil then
					d:SetAttribute("PreBurnColor", d.Color)
					d:SetAttribute("PreBurnTransparency", d.Transparency)
				end
				table.insert(parts, d)
				TweenService:Create(d, TweenInfo.new(R.BurnSeconds), { Color = CHAR }):Play()
			end
		end
		-- flames on a handful of the bigger parts
		table.sort(parts, function(a, b)
			return a.Size.Magnitude > b.Size.Magnitude
		end)
		local flames = {}
		for i = 1, math.min(6, #parts) do
			local part = parts[i]
			local fire = Instance.new("Fire")
			fire.Name = "BurnFx"
			fire.Size = 9
			fire.Heat = 16
			fire.Color = Color3.fromRGB(255, 130, 40)
			fire.SecondaryColor = Color3.fromRGB(255, 50, 10)
			fire.Parent = part
			local smoke = Instance.new("Smoke")
			smoke.Name = "BurnFx"
			smoke.Color = Color3.fromRGB(40, 36, 34)
			smoke.Opacity = 0.35
			smoke.RiseVelocity = 9
			smoke.Size = 7
			smoke.Parent = part
			local light = Instance.new("PointLight")
			light.Name = "BurnFx"
			light.Color = Color3.fromRGB(255, 120, 40)
			light.Range = 34
			light.Brightness = 3
			light.Parent = part
			table.insert(flames, { fire = fire, light = light })
			if i == 1 then
				local crackle = Sounds.loop("Fire", part)
				if crackle then
					crackle.Name = "BurnFx"
				end
			end
		end

		-- spread to close neighbours, then die down to embers
		task.delay(8, function()
			for _, other in state.buildings do
				if other ~= building and not other.burning and (other.position - building.position).Magnitude < 48 and rng:NextNumber() < 0.45 then
					ignite(other)
				end
			end
		end)
		task.delay(R.BurnSeconds, function()
			if not building.burning then
				return
			end
			for _, f in flames do
				f.fire.Size = 3
				f.light.Brightness = 1
			end
			for _, part in parts do
				if part.Name == "Roof" or part.Name == "Gable" then
					part.Transparency = 0.45 -- burned through
				end
			end
		end)
	end

	local function restoreBuilding(building)
		building.burning = false
		building.firePrompt.Enabled = true
		for _, d in building.model:GetDescendants() do
			if d.Name == "BurnFx" then
				d:Destroy()
			elseif d:IsA("BasePart") and d:GetAttribute("PreBurnColor") then
				d.Color = d:GetAttribute("PreBurnColor")
				d.Transparency = d:GetAttribute("PreBurnTransparency") or 0
			end
		end
	end

	-- Chests ----------------------------------------------------------------------

	local function makeChest(cf: CFrame)
		local model = Instance.new("Model")
		model.Name = "LootChest"
		local add = ModelFactory.addPart
		add(model, { Name = "Box", Size = Vector3.new(4, 2.2, 2.6), CFrame = cf * CFrame.new(0, 1.1, 0), Color = Color3.fromRGB(110, 70, 40), Material = Enum.Material.WoodPlanks })
		local lid = add(model, { Name = "Lid", Size = Vector3.new(4.1, 0.6, 2.7), CFrame = cf * CFrame.new(0, 2.5, 0), Color = Color3.fromRGB(96, 60, 34), Material = Enum.Material.WoodPlanks })
		for _, x in { -1.4, 1.4 } do
			add(model, { Name = "Band", Size = Vector3.new(0.3, 2.9, 2.8), CFrame = cf * CFrame.new(x, 1.4, 0), Color = Color3.fromRGB(70, 70, 76), Material = Enum.Material.Metal })
		end
		local glint = add(model, { Name = "Silver", Size = Vector3.new(3, 0.4, 1.8), CFrame = cf * CFrame.new(0, 2.15, 0), Color = Color3.fromRGB(220, 220, 230), Material = Enum.Material.Foil })
		local light = Instance.new("PointLight")
		light.Color = Color3.fromRGB(255, 230, 160)
		light.Range = 8
		light.Brightness = 0.8
		light.Parent = glint
		model.Parent = folder

		local chest = { model = model, lid = lid, lidClosed = lid.CFrame, hinge = cf * CFrame.new(0, 2.5, 1.3), looted = false }
		chest.prompt = makePrompt(lid, "Plunder", "Chest", Enum.KeyCode.E, 1.5)
		chest.prompt.Triggered:Connect(function(player)
			if chest.looted then
				return
			end
			local ColonyService = services.ColonyService
			local colony = ColonyService:Get(player)
			if not colony then
				return
			end
			chest.looted = true
			chest.prompt.Enabled = false
			services.QuestService:Count(colony, "plunder")
			markRaid()
			-- swing the lid open
			lid.CFrame = chest.hinge * CFrame.Angles(math.rad(-100), 0, 0) * chest.hinge:Inverse() * chest.lidClosed
			local parts = {}
			local mult = 1
			if ColonyService:Has(colony, "SeaRaiders") then
				mult *= 1.5
			end
			if ColonyService:Has(colony, "PathStorm") then
				mult *= 1.5
			end
			for resource, base in R.ChestLoot do
				local amount = math.floor(base * mult)
				ColonyService:Add(colony, resource, amount)
				table.insert(parts, "+" .. amount .. " " .. resource)
			end
			ColonyService:Notify(colony, "Plundered! " .. table.concat(parts, ", "), "gain")
			ColonyService:Sync(colony)
		end)
		table.insert(state.chests, chest)
	end

	-- Guards ----------------------------------------------------------------------

	local function weld(part: BasePart, to: BasePart)
		local w = Instance.new("WeldConstraint")
		w.Part0 = to
		w.Part1 = part
		w.Parent = part
	end

	local function gear(parent: Model, attachTo: BasePart, name: string, size: Vector3, offset: CFrame, color: Color3, material, shape)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.Color = color
		p.Material = material or Enum.Material.Metal
		if shape then
			p.Shape = shape
		end
		p.CanCollide = false
		p.Massless = true
		p.CFrame = attachTo.CFrame * offset
		p.Parent = parent
		weld(p, attachTo)
		return p
	end

	local shieldColors = { Color3.fromRGB(46, 70, 120), Color3.fromRGB(220, 214, 200), Color3.fromRGB(40, 90, 80) }

	local archerShoot -- defined below (archers use it from the guard loop)

	local function spawnDefender(post: Vector3, archer: boolean?)
		local desc = Instance.new("HumanoidDescription")
		local skin = Color3.fromRGB(226, 186, 150)
		desc.HeadColor = skin
		desc.LeftArmColor = skin
		desc.RightArmColor = skin
		desc.TorsoColor = Color3.fromRGB(58, 66, 84)
		desc.LeftLegColor = Color3.fromRGB(60, 52, 44)
		desc.RightLegColor = Color3.fromRGB(60, 52, 44)
		local ok, model = pcall(function()
			return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
		end)
		if not ok or not model then
			warn("[RaidService] could not create guard: " .. tostring(model))
			return
		end
		local title = archer and "Greywater Archer" or "Greywater Guard"
		model.Name = title
		model:SetAttribute("Defender", true)
		local humanoid = model:FindFirstChildOfClass("Humanoid")
		humanoid.DisplayName = title
		humanoid.MaxHealth = R.DefenderHealth
		humanoid.Health = R.DefenderHealth
		humanoid.WalkSpeed = 13
		humanoid.NameDisplayDistance = 60
		humanoid.HealthDisplayDistance = 60

		local head = model:FindFirstChild("Head")
		local leftHand = model:FindFirstChild("LeftHand")
		local rightHand = model:FindFirstChild("RightHand")
		if head then
			gear(model, head, "Helmet", Vector3.new(1.35, 0.7, 1.35), CFrame.new(0, 0.45, 0), Color3.fromRGB(90, 92, 98), Enum.Material.Metal, Enum.PartType.Ball)
			gear(model, head, "NoseGuard", Vector3.new(0.15, 0.6, 0.15), CFrame.new(0, 0.1, -0.62), Color3.fromRGB(90, 92, 98))
		end
		if archer and leftHand then
			gear(model, leftHand, "BowLimb", Vector3.new(0.2, 4.2, 0.2), CFrame.new(0, 0, -0.3), Color3.fromRGB(80, 56, 36), Enum.Material.Wood)
		elseif leftHand then
			gear(model, leftHand, "Shield", Vector3.new(0.3, 3.4, 3.4), CFrame.new(-0.3, 0, 0), shieldColors[rng:NextInteger(1, #shieldColors)], Enum.Material.Wood, Enum.PartType.Cylinder)
		end
		if rightHand and not archer then
			gear(model, rightHand, "Haft", Vector3.new(0.25, 3.2, 0.25), CFrame.new(0, -0.6, -0.4) * CFrame.Angles(math.rad(90), 0, 0), Color3.fromRGB(110, 76, 46), Enum.Material.Wood)
			gear(model, rightHand, "AxeHead", Vector3.new(0.2, 1, 1.1), CFrame.new(0, 0.1, -1.9), Color3.fromRGB(120, 122, 130))
		end

		model:PivotTo(CFrame.new(post + Vector3.new(0, 3, 0)) * CFrame.Angles(0, math.pi / 2, 0))
		model.Parent = folder.Guards
		local root = model:FindFirstChild("HumanoidRootPart")
		if root then
			pcall(function()
				root:SetNetworkOwner(nil)
			end)
		end

		-- walk / idle animations (Roblox's standard R15 ones)
		local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator", humanoid)
		local tracks = {}
		pcall(function()
			local walk = Instance.new("Animation")
			walk.AnimationId = WALK_ANIM
			tracks.walk = animator:LoadAnimation(walk)
			local idle = Instance.new("Animation")
			idle.AnimationId = IDLE_ANIM
			tracks.idle = animator:LoadAnimation(idle)
			tracks.idle:Play()
		end)
		humanoid.Running:Connect(function(speed)
			if not tracks.walk then
				return
			end
			if speed > 0.5 and not tracks.walk.IsPlaying then
				tracks.walk:Play()
			elseif speed <= 0.5 and tracks.walk.IsPlaying then
				tracks.walk:Stop()
			end
		end)

		local guard = { model = model, humanoid = humanoid, root = root, post = post, home = post, lastHit = 0, rightHand = rightHand, archer = archer }
		humanoid.Died:Connect(function()
			guard.dead = true
			markRaid()
			task.delay(6, function()
				model:Destroy()
			end)
			local alive = 0
			for _, g in state.defenders do
				if not g.dead then
					alive += 1
				end
			end
			if alive == 0 then
				notifyAll(R.Name .. " has fallen! Its people may accept a new home with you.", "raid")
				for _, f in state.folk do
					f.prompt.Enabled = true
				end
			end
		end)
		table.insert(state.defenders, guard)
	end

	-- Called by ToolService when an axe blow or arrow lands on a guard.
	function hold:DamageDefender(model: Model, amount: number, attacker: Player)
		local humanoid = model:FindFirstChildOfClass("Humanoid")
		if not humanoid or humanoid.Health <= 0 then
			return
		end
		humanoid:TakeDamage(amount)
		if not state.alarm then
			state.alarm = true
			notifyAll(attacker.DisplayName .. " is raiding " .. R.Name .. "!", "raid")
		end
		markRaid()
	end

	function hold:FindDefender(inst: Instance?): Model?
		while inst and inst ~= workspace do
			if inst:IsA("Model") and inst:GetAttribute("Defender") then
				return inst
			end
			inst = inst.Parent
		end
		return nil
	end

	-- Guards within reach of `player`, in front of them. Used for axe blows.
	function hold:DefendersNear(position: Vector3, look: Vector3, range: number)
		local found = {}
		for _, g in state.defenders do
			if not g.dead and g.root then
				local offset = flat(g.root.Position - position)
				if offset.Magnitude <= range and (offset.Magnitude < 2 or offset.Unit:Dot(flat(look).Unit) > 0.2) then
					table.insert(found, g.model)
				end
			end
		end
		return found
	end

	local function nearestTarget(from: Vector3, maxDist: number): (Model?, number)
		local best, bestDist = nil, maxDist
		for _, player in Players:GetPlayers() do
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")
			local hum = character and character:FindFirstChildOfClass("Humanoid")
			if root and hum and hum.Health > 0 then
				local inTerritory = flat(root.Position - CENTER).Magnitude < R.DefenderAggro
				local d = (root.Position - from).Magnitude
				if (inTerritory or state.alarm) and d < bestDist then
					best, bestDist = character, d
				end
			end
		end
		return best, bestDist
	end

	local function swingAxe(guard)
		local hand = guard.rightHand
		if not hand then
			return
		end
		-- a quick lean forward with the axe arm
		local shoulder = guard.model:FindFirstChild("RightUpperArm")
		local motor = shoulder and shoulder:FindFirstChild("RightShoulder")
		if motor and motor:IsA("Motor6D") then
			task.spawn(function()
				motor.Transform = CFrame.Angles(math.rad(-110), 0, 0)
				task.wait(0.2)
				motor.Transform = CFrame.new()
			end)
		end
	end

	-- Archers hold their tower and loose arrows at raiders in range.
	archerShoot = function(g, now: number)
		if now - g.lastHit < R.ArcherCooldown then
			return
		end
		local target = nearestTarget(g.root.Position, R.ArcherRange)
		local troot = target and target:FindFirstChild("HumanoidRootPart")
		if not troot then
			return
		end
		g.lastHit = now
		local from = g.root.Position + Vector3.new(0, 1.5, 0)
		g.root.CFrame = CFrame.lookAt(g.root.Position, Vector3.new(troot.Position.X, g.root.Position.Y, troot.Position.Z))
		local hit = rng:NextNumber() < 0.6
		local to = hit and troot.Position or (troot.Position + Vector3.new(rng:NextNumber(-6, 6), -2, rng:NextNumber(-6, 6)))
		local arrow = ModelFactory.arrow()
		arrow.CFrame = CFrame.lookAt(from, to)
		arrow.Parent = workspace
		Sounds.play("Bow", from)
		local flight = (to - from).Magnitude / 140
		TweenService:Create(arrow, TweenInfo.new(flight, Enum.EasingStyle.Linear), { CFrame = CFrame.lookAt(to, to + (to - from).Unit) }):Play()
		task.delay(flight + 2, function()
			arrow:Destroy()
		end)
		if hit then
			task.delay(flight, function()
				local hum = target:FindFirstChildOfClass("Humanoid")
				if hum then
					local victim = Players:GetPlayerFromCharacter(target)
					local colony = victim and services.ColonyService:Get(victim)
					hum:TakeDamage(R.ArcherDamage * (services.ColonyService:Has(colony, "PathStorm") and 0.7 or 1))
				end
			end)
		end
	end

	local function guardLoop()
		while true do
			task.wait(0.25)
			local now = os.clock()
			for _, g in state.defenders do
				if g.archer and not g.dead and g.root then
					archerShoot(g, now)
				elseif not g.dead and g.root then
					local target, dist = nearestTarget(g.root.Position, state.alarm and R.DefenderAggro * 1.6 or R.DefenderAggro)
					if target then
						local troot = target:FindFirstChild("HumanoidRootPart")
						g.humanoid:MoveTo(troot.Position)
						if dist < 6 and now - g.lastHit > 1.1 then
							g.lastHit = now
							swingAxe(g)
							local hum = target:FindFirstChildOfClass("Humanoid")
							if hum then
								local victim = Players:GetPlayerFromCharacter(target)
								local colony = victim and services.ColonyService:Get(victim)
								local damage = R.DefenderDamage
								if services.ColonyService:Has(colony, "PathStorm") then
									damage *= 0.7
								end
								hum:TakeDamage(damage)
							end
						end
					elseif flat(g.root.Position - g.post).Magnitude > 3 then
						g.humanoid:MoveTo(g.post)
					end
				end
			end
		end
	end

	-- Folk (the hold's villagers) ---------------------------------------------------

	local function spawnFolk()
		local model = ModelFactory.villager(Config.Names[rng:NextInteger(1, #Config.Names)], false, rng)
		local offset = model:GetAttribute("GroundOffset")
		local pos = CENTER + Vector3.new(rng:NextNumber(-25, 25), 0, rng:NextNumber(-25, 25))
		model:PivotTo(CFrame.new(pos + Vector3.new(0, offset, 0)))
		model.Parent = folder.Folk
		local folk = { model = model, offset = offset, busyUntil = 0 }
		folk.prompt = makePrompt(model.PrimaryPart, "Offer a new home", model.Name .. " of " .. R.Name, Enum.KeyCode.E, 1)
		folk.prompt.Enabled = false
		folk.prompt.Triggered:Connect(function(player)
			local ColonyService = services.ColonyService
			local colony = ColonyService:Get(player)
			if not colony or not model.Parent then
				return
			end
			local pop = 0
			for _ in colony.villagers do
				pop += 1
			end
			if ColonyService:Housing(colony) - pop <= 0 then
				ColonyService:Notify(colony, "You need a free home first. Build a longhouse or cottage.", "bad")
				return
			end
			local name = model.Name
			model:Destroy()
			table.remove(state.folk, table.find(state.folk, folk))
			local v = services.VillagerService:Add(colony, false, colony.origin + Vector3.new(80, 0, -6))
			v.name = name
			local tag = v.model:FindFirstChild("NameTag", true)
			if tag and tag:FindFirstChild("Label") then
				tag.Label.Text = name
			end
			ColonyService:Notify(colony, name .. " of " .. R.Name .. " accepted a new home in your settlement.", "good")
			ColonyService:Sync(colony)
		end)
		table.insert(state.folk, folk)
	end

	local function folkLoop()
		while true do
			task.wait(1)
			local now = os.clock()
			for _, f in state.folk do
				local body = f.model.PrimaryPart
				if body and now >= f.busyUntil then
					local fearful = state.alarm
					local target = CENTER + Vector3.new(rng:NextNumber(-30, 30), 0, rng:NextNumber(10, 45) * (fearful and 1 or (rng:NextNumber() < 0.5 and -1 or 1)))
					local from = body.Position
					local to = Vector3.new(target.X, CENTER.Y + f.offset, target.Z)
					local flatDir = flat(to - from)
					if flatDir.Magnitude > 1 then
						local t = flatDir.Magnitude / (fearful and 12 or 5)
						body.CFrame = CFrame.lookAt(from, from + flatDir)
						TweenService:Create(body, TweenInfo.new(t, Enum.EasingStyle.Linear), { CFrame = CFrame.lookAt(to, to + flatDir) }):Play()
						f.busyUntil = now + t + rng:NextNumber(2, 6)
					end
				end
			end
		end
	end

	-- Building the hold -------------------------------------------------------------

	local LAYOUT = R.Layout or {
		{ "Longhouse", Vector3.new(0, 0, 52) },
		{ "Cottage", Vector3.new(-55, 0, -30) },
		{ "Cottage", Vector3.new(55, 0, -32) },
		{ "Cottage", Vector3.new(-62, 0, 35) },
		{ "Cottage", Vector3.new(60, 0, 40) },
		{ "Storehouse", Vector3.new(-30, 0, -58) },
		{ "Storehouse", Vector3.new(30, 0, -58) },
	}

	local function buildHold()
		folder = Instance.new("Folder")
		folder.Name = "RivalVillage_" .. R.Name:gsub("%s", "")
		for _, name in { "Guards", "Folk" } do
			local f = Instance.new("Folder")
			f.Name = name
			f.Parent = folder
		end
		folder.Parent = workspace

		for _, entry in LAYOUT do
			local kind, offset = entry[1], entry[2]
			local pos = CENTER + offset
			local cf = CFrame.lookAt(pos, Vector3.new(CENTER.X, pos.Y, CENTER.Z))
			local model = ModelFactory.building(kind)
			model:PivotTo(cf)
			model:SetAttribute("RivalBuilding", true)
			model.Parent = folder
			local building = { model = model, position = pos, kind = kind, burning = false }
			local anchor = anchorPart(cf * CFrame.new(0, 4, 0), model)
			building.firePrompt = makePrompt(anchor, "Set alight", kind, Enum.KeyCode.F, 1)
			building.firePrompt.MaxActivationDistance = 18
			building.firePrompt.Triggered:Connect(function(player)
				if not services.ToolService:IsHolding(player, "Torch") then
					local colony = services.ColonyService:Get(player)
					if colony then
						services.ColonyService:Notify(colony, "Hold your Torch first (press 4)", "bad")
					end
					return
				end
				if not state.alarm then
					state.alarm = true
					notifyAll(player.DisplayName .. " is raiding " .. R.Name .. "!", "raid")
				end
				ignite(building)
			end)
			table.insert(state.buildings, building)
			if kind == "Storehouse" then
				makeChest(cf * CFrame.new(0, 0, -15))
			end
		end

		-- the village square
		local square = Instance.new("Model")
		square.Name = "Square"
		ModelFactory.campfire(square, CENTER)
		square.Parent = folder

		-- palisade ring with a gate facing east, toward the player settlements
		local segments = math.floor(2 * math.pi * R.Radius / Config.CELL)
		for i = 0, segments - 1 do
			local a = i / segments * math.pi * 2
			local fromGate = a - GATE
			if math.abs(math.atan2(math.sin(fromGate), math.cos(fromGate))) > 0.2 then
				local pos = CENTER + Vector3.new(math.cos(a) * R.Radius, 0, math.sin(a) * R.Radius)
				local wall = ModelFactory.building("Palisade")
				wall:PivotTo(CFrame.lookAt(pos, Vector3.new(CENTER.X, pos.Y, CENTER.Z)))
				wall.Parent = folder
			end
		end

		-- the war horn on a post just outside the gate
		local gate = CENTER + gateDir * (R.Radius + 10) + gateSide * 14
		local hornModel = Instance.new("Model")
		hornModel.Name = "WarHorn"
		local add = ModelFactory.addPart
		add(hornModel, { Size = Vector3.new(0.8, 7, 0.8), Position = gate + Vector3.new(0, 3.5, 0), Color = Color3.fromRGB(74, 52, 36) })
		for k = 0, 4 do
			add(hornModel, {
				Name = "Horn",
				Size = Vector3.new(0.5 + k * 0.18, 0.5 + k * 0.18, 0.9),
				CFrame = CFrame.new(gate + Vector3.new(0, 6.2 + math.sin(k * 0.5) * 0.6, -0.6 - k * 0.7)) * CFrame.Angles(k * 0.25, 0, 0),
				Color = Color3.fromRGB(230, 214, 180),
				Material = Enum.Material.SmoothPlastic,
			})
		end
		hornModel.Parent = folder
		state.hornPrompt = makePrompt(hornModel:FindFirstChild("Horn"), "Sound the war horn", R.Name, Enum.KeyCode.E, 1.5)
		state.hornPrompt.Triggered:Connect(function(player)
			state.hornPrompt.Enabled = false
			Sounds.play("WarHorn", CENTER)
			markRaid()
			notifyAll("The war horn sounds! " .. R.Name .. " forms a shield wall!", "raid")
			-- guards line up shoulder to shoulder at the gate, then charge
			local n = #state.defenders
			for i, g in state.defenders do
				g.post = CENTER + gateDir * (R.Radius - 14) + gateSide * ((i - (n + 1) / 2) * 3.6)
			end
			task.delay(7, function()
				state.alarm = true
			end)
		end)

		-- a status sign above the hold
		local signPart = anchorPart(CFrame.new(CENTER + Vector3.new(0, 30, 0)), folder)
		local sign = Instance.new("BillboardGui")
		sign.Size = UDim2.fromOffset(320, 60)
		sign.MaxDistance = 600
		sign.AlwaysOnTop = true
		sign.Parent = signPart
		local title = Instance.new("TextLabel")
		title.Size = UDim2.new(1, 0, 0.55, 0)
		title.BackgroundTransparency = 1
		title.Font = Enum.Font.Fantasy
		title.TextScaled = true
		title.TextColor3 = Color3.fromRGB(232, 206, 150)
		title.TextStrokeTransparency = 0.3
		title.Text = R.Name
		title.Parent = sign
		statusLabel = Instance.new("TextLabel")
		statusLabel.Position = UDim2.fromScale(0, 0.58)
		statusLabel.Size = UDim2.new(1, 0, 0.42, 0)
		statusLabel.BackgroundTransparency = 1
		statusLabel.Font = Enum.Font.GothamMedium
		statusLabel.TextScaled = true
		statusLabel.TextColor3 = Color3.fromRGB(240, 235, 225)
		statusLabel.TextStrokeTransparency = 0.4
		statusLabel.Parent = sign
	end

	local function populate()
		for i = 1, R.Defenders do
			local a = (i / R.Defenders) * math.pi * 2
			spawnDefender(CENTER + Vector3.new(math.cos(a) * 28, 0, math.sin(a) * 28))
		end
		-- archers on wooden towers just inside the palisade
		for i = 1, R.Archers do
			local a = (i / R.Archers) * math.pi * 2 + math.pi / R.Archers
			local p = CENTER + Vector3.new(math.cos(a) * (R.Radius - 14), 0, math.sin(a) * (R.Radius - 14))
			if not folder:FindFirstChild("Tower" .. i) then
				local tower = Instance.new("Model")
				tower.Name = "Tower" .. i
				for _, c in { { -2, -2 }, { 2, -2 }, { -2, 2 }, { 2, 2 } } do
					ModelFactory.addPart(tower, { Name = "Leg", Size = Vector3.new(0.8, 9, 0.8), Position = p + Vector3.new(c[1], 4.5, c[2]), Color = Color3.fromRGB(96, 70, 48) })
				end
				ModelFactory.addPart(tower, { Name = "Deck", Size = Vector3.new(6, 0.8, 6), Position = p + Vector3.new(0, 9, 0), Color = Color3.fromRGB(110, 80, 54), Material = Enum.Material.WoodPlanks })
				tower.Parent = folder
			end
			spawnDefender(p + Vector3.new(0, 9.4, 0), true)
		end
		for _ = 1, R.Villagers do
			spawnFolk()
		end
	end

	local function rebuild()
		for _, b in state.buildings do
			restoreBuilding(b)
		end
		for _, c in state.chests do
			c.looted = false
			c.prompt.Enabled = true
			c.lid.CFrame = c.lidClosed
		end
		for _, g in state.defenders do
			if not g.dead then
				g.model:Destroy()
			end
		end
		state.defenders = {}
		for _, f in state.folk do
			f.model:Destroy()
		end
		state.folk = {}
		populate()
		state.alarm = false
		state.raidedAt = nil
		state.hornPrompt.Enabled = true
		notifyAll(R.Name .. " has rebuilt its walls and restocked its stores.", "info")
	end

	function hold:Start()
		buildHold()
		hold.folder = folder
		populate()
		task.spawn(guardLoop)
		task.spawn(folkLoop)

		while true do
			task.wait(1)
			if state.raidedAt then
				local left = R.RegenSeconds - (os.clock() - state.raidedAt)
				if left <= 0 then
					rebuild()
				else
					local secs = math.floor(left)
					statusLabel.Text = string.format("Raided! Rebuilds in %d:%02d", secs // 60, secs % 60)
					statusLabel.TextColor3 = Color3.fromRGB(255, 150, 120)
				end
			end
			if not state.raidedAt then
				statusLabel.Text = "Guarded. Raid it for food and silver"
				statusLabel.TextColor3 = Color3.fromRGB(240, 235, 225)
			end
		end
	end

	return hold
end

function RaidService:Init(allServices)
	services = allServices
end

local holds = {}

local function holdOf(model: Instance)
	for _, h in holds do
		if h.folder and model:IsDescendantOf(h.folder) then
			return h
		end
	end
	return nil
end

-- Called by ToolService when an axe blow or arrow lands on a guard.
function RaidService:DamageDefender(model: Model, amount: number, attacker: Player)
	local h = holdOf(model)
	if h then
		h:DamageDefender(model, amount, attacker)
	end
end

function RaidService:FindDefender(inst: Instance?): Model?
	while inst and inst ~= workspace do
		if inst:IsA("Model") and inst:GetAttribute("Defender") then
			return inst
		end
		inst = inst.Parent
	end
	return nil
end

-- Guards within reach, in front of `look`, from every hold. Used for melee blows.
function RaidService:DefendersNear(position: Vector3, look: Vector3, range: number)
	local found = {}
	for _, h in holds do
		for _, m in h:DefendersNear(position, look, range) do
			table.insert(found, m)
		end
	end
	return found
end

function RaidService:Start()
	for _, def in Config.Rivals do
		local h = newHold(def)
		table.insert(holds, h)
		task.spawn(function()
			h:Start()
		end)
	end
end

return RaidService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">ResourceNodeService</string>
            <string name="Source"><![CDATA[--[[
	ResourceNodeService
	Scatters trees, rocks and berry bushes on each plot. Walk up to a tree
	with the Axe (or a rock with the Pickaxe) and click to swing: chips fly,
	it shakes, a bar shows how many blows are left, then the tree topples or
	the rock breaks apart. Better tools (Iron Blades, Steel Edges, Masonry)
	need fewer blows. Berries are picked by hand: hold E. Gathering also
	clears land for building. Nodes slowly regrow.
]]

local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Sounds = require(Shared.Sounds)
local Grid = require(Shared.Grid)
local ModelFactory = require(Shared.ModelFactory)

local ResourceNodeService = {}

local services
local rng = Random.new()

function ResourceNodeService:Init(allServices)
	services = allServices
end

local function randomFreeCell(colony)
	for _ = 1, 60 do
		local x = rng:NextInteger(0, Config.PLOT_CELLS - 1)
		local z = rng:NextInteger(0, Config.PLOT_CELLS - 1)
		if not colony.blocked[Grid.key(x, z)] then
			return x, z
		end
	end
	return nil
end

local function countKind(colony, kind: string): number
	local n = 0
	for _, node in colony.nodes do
		if node.kind == kind then
			n += 1
		end
	end
	return n
end

function ResourceNodeService:Spawn(colony, kind: string, x: number, z: number)
	local ColonyService = services.ColonyService
	local def = Config.Nodes[kind]
	local key = Grid.key(x, z)

	local model, main = ModelFactory.node(kind, rng)
	local jitter = Vector3.new(rng:NextNumber(-1.5, 1.5), 0, rng:NextNumber(-1.5, 1.5))
	model:PivotTo(CFrame.new(Grid.rectCenter(colony.origin, x, z, 1, 1) + jitter) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0))
	services.SeasonService:ApplyTo(model)
	model.Parent = colony.plot.Nodes

	local node = { kind = kind, x = x, z = z, model = model, main = main, key = key, hp = def.Hits, maxHp = def.Hits }
	colony.nodes[key] = node
	ColonyService:Block(colony, x, z, "node")

	if def.Hits then
		return -- trees and rocks are cut by swinging the tool at them (see Hit)
	end

	-- berries are picked by hand: hold E
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = def.Action
	prompt.ObjectText = "Berry bush"
	prompt.HoldDuration = def.Hold
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.Parent = main
	prompt.Triggered:Connect(function(player)
		if player ~= colony.player or colony.nodes[key] ~= node then
			return
		end
		Sounds.play("Chop", model:GetPivot().Position)
		ResourceNodeService:Harvest(colony, node)
		model:Destroy()
	end)
end

-- Gives the node's resources and frees its cell.
function ResourceNodeService:Harvest(colony, node)
	local ColonyService = services.ColonyService
	local def = Config.Nodes[node.kind]
	colony.nodes[node.key] = nil
	ColonyService:Unblock(colony, node.x, node.z)
	services.QuestService:Count(colony, node.kind == "Rock" and "mine" or (node.kind == "Tree" and "chop" or "forage"))
	local amount = def.Amount
	if node.kind == "Tree" and ColonyService:Has(colony, "IronAxes") then
		amount *= 1.5
	end
	if ColonyService:Has(colony, "PathWoods") then
		amount *= 2
	end
	amount = math.floor(amount)
	ColonyService:Add(colony, def.Gives, amount)
	ColonyService:Notify(colony, "+" .. amount .. " " .. def.Gives, "gain")
	ColonyService:Sync(colony)
end

-- Little bits flying off with each blow: wood chips or stone grit and sparks.
local function chips(at: Vector3, stone: boolean)
	local holder = Instance.new("Attachment")
	holder.WorldPosition = at
	holder.Parent = workspace.Terrain
	local p = Instance.new("ParticleEmitter")
	p.Rate = 0
	p.Lifetime = NumberRange.new(0.4, 0.9)
	p.Speed = NumberRange.new(8, 16)
	p.SpreadAngle = Vector2.new(60, 60)
	p.Acceleration = Vector3.new(0, -40, 0)
	p.Size = NumberSequence.new(stone and 0.25 or 0.35, 0.1)
	p.Color = ColorSequence.new(stone and Color3.fromRGB(170, 168, 160) or Color3.fromRGB(196, 150, 96))
	p.Parent = holder
	p:Emit(stone and 10 or 14)
	if stone then
		local spark = Instance.new("ParticleEmitter")
		spark.Rate = 0
		spark.LightEmission = 1
		spark.Lifetime = NumberRange.new(0.15, 0.3)
		spark.Speed = NumberRange.new(14, 22)
		spark.SpreadAngle = Vector2.new(70, 70)
		spark.Size = NumberSequence.new(0.15, 0)
		spark.Color = ColorSequence.new(Color3.fromRGB(255, 210, 120))
		spark.Parent = holder
		spark:Emit(6)
	end
	task.delay(2, function()
		holder:Destroy()
	end)
end

local function healthBar(node)
	if node.bar then
		return node.bar
	end
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(70, 8)
	gui.StudsOffsetWorldSpace = Vector3.new(0, node.kind == "Tree" and 9 or 5, 0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 40
	gui.Adornee = node.main
	local back = Instance.new("Frame")
	back.Size = UDim2.fromScale(1, 1)
	back.BackgroundColor3 = Color3.fromRGB(30, 24, 18)
	back.BorderSizePixel = 0
	back.Parent = gui
	local fill = Instance.new("Frame")
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = node.kind == "Tree" and Color3.fromRGB(150, 200, 90) or Color3.fromRGB(190, 190, 200)
	fill.BorderSizePixel = 0
	fill.Parent = back
	gui.Parent = node.model
	node.bar = fill
	return fill
end

local function shake(model: Model)
	local base = model:GetPivot()
	task.spawn(function()
		for i = 1, 6 do
			if not model.Parent then
				return
			end
			local a = math.rad(2.2) * (7 - i) / 6 * (i % 2 == 0 and 1 or -1)
			model:PivotTo(base * CFrame.Angles(a, 0, a * 0.6))
			task.wait(0.03)
		end
		if model.Parent then
			model:PivotTo(base)
		end
	end)
end

-- The tree topples away from you, or the rock breaks apart, then fades.
local function fell(node, from: Vector3)
	local model = node.model
	local base = model:GetPivot()
	if node.kind == "Tree" then
		local away = Vector3.new(base.Position.X - from.X, 0, base.Position.Z - from.Z)
		away = away.Magnitude > 0.1 and away.Unit or Vector3.new(1, 0, 0)
		local axis = Vector3.new(0, 1, 0):Cross(away)
		task.spawn(function()
			local t0 = os.clock()
			while model.Parent do
				local t = math.min((os.clock() - t0) / 1.3, 1)
				local angle = (t * t) * math.rad(88)
				model:PivotTo(CFrame.fromAxisAngle(axis, angle) * (base - base.Position) + base.Position)
				if t >= 1 then
					break
				end
				task.wait()
			end
			Sounds.play("Build", base.Position + away * 8)
			task.wait(1.5)
			for _, d in model:GetDescendants() do
				if d:IsA("BasePart") then
					TweenService:Create(d, TweenInfo.new(1), { Transparency = 1 }):Play()
				end
			end
			task.wait(1)
			model:Destroy()
		end)
	else
		for _, d in model:GetDescendants() do
			if d:IsA("BasePart") then
				d.Anchored = false
				d.CanCollide = true
				d:ApplyImpulse(Vector3.new(rng:NextNumber(-1, 1), 1.5, rng:NextNumber(-1, 1)) * d.AssemblyMass * 18)
				TweenService:Create(d, TweenInfo.new(2.5), { Size = d.Size * 0.4 }):Play()
			end
		end
		task.delay(2.5, function()
			model:Destroy()
		end)
	end
end

-- A swing from `player` holding `toolName`: hits the nearest tree or rock in
-- front of them. Returns true if it hit something.
function ResourceNodeService:Hit(player: Player, toolName: string, root: BasePart): boolean
	local ColonyService = services.ColonyService
	local colony = ColonyService:Get(player)
	if not colony then
		return false
	end
	local best, bestDist = nil, 9
	for _, node in colony.nodes do
		if node.hp and node.model.Parent then
			local p = node.model:GetPivot().Position
			local offset = Vector3.new(p.X - root.Position.X, 0, p.Z - root.Position.Z)
			local d = offset.Magnitude
			local facing = d < 3 or offset.Unit:Dot(Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z).Unit) > 0.3
			if d < bestDist and facing then
				best, bestDist = node, d
			end
		end
	end
	if not best then
		return false
	end
	local def = Config.Nodes[best.kind]
	if def.Tool ~= toolName then
		if toolName ~= "Sword" then
			local slot = table.find(Config.Tools, def.Tool) or 1
			ColonyService:Notify(colony, "Use the " .. def.Tool .. " for that (press " .. slot .. ")", "bad")
		end
		return false
	end
	local power = 1
	if best.kind == "Tree" then
		power = ColonyService:Has(colony, "SteelEdges") and 2 or (ColonyService:Has(colony, "IronAxes") and 1.5 or 1)
	elseif best.kind == "Rock" then
		power = ColonyService:Has(colony, "Masonry") and 1.5 or 1
	end
	best.hp -= power
	local p = best.model:GetPivot().Position
	local at = Vector3.new(p.X, p.Y + (best.kind == "Tree" and 2.5 or 1.5), p.Z):Lerp(root.Position, 0.25)
	Sounds.play(best.kind == "Rock" and "Mine" or "Chop", at)
	chips(at, best.kind == "Rock")
	local bar = healthBar(best)
	bar.Size = UDim2.fromScale(math.max(best.hp, 0) / best.maxHp, 1)
	if best.hp <= 0 then
		best.hp = nil
		if best.bar then
			best.bar.Parent.Parent:Destroy()
		end
		self:Harvest(colony, best)
		fell(best, root.Position)
	else
		shake(best.model)
	end
	return true
end

function ResourceNodeService:SpawnInitial(colony)
	for kind, def in Config.Nodes do
		for _ = 1, def.Count do
			local x, z = randomFreeCell(colony)
			if x then
				self:Spawn(colony, kind, x, z)
			end
		end
	end
end

function ResourceNodeService:Tick(colony, dt: number)
	colony.regrowTimer = (colony.regrowTimer or 0) + dt
	if colony.regrowTimer < Config.NodeRegrowInterval then
		return
	end
	colony.regrowTimer = 0
	for kind, def in Config.Nodes do
		if def.Regrow > 0 and countKind(colony, kind) < def.Regrow then
			local x, z = randomFreeCell(colony)
			if x then
				self:Spawn(colony, kind, x, z)
			end
		end
	end
end

return ResourceNodeService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">SaveService</string>
            <string name="Source"><![CDATA[--[[
	SaveService
	Saves each player's village with a DataStore, so it's still there next
	time: buildings (type and spot), resources, research, villagers (name,
	age, child or adult), happiness and the day count.

	Saves every Config.AutosaveSeconds, when the player leaves, and when the
	server shuts down. Loading happens in ColonyService:Create.

	DataStores only work in a PUBLISHED place with API access turned on
	(Studio: File > Publish to Roblox, then Game Settings > Security >
	"Enable Studio Access to API Services"). Without that, the game runs
	normally and simply tells the player that saving is off.

	If loading fails (DataStores down), saving is switched off for that
	player for the session, so a fresh village can never overwrite a good save.
]]

local DataStoreService = game:GetService("DataStoreService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)

local SaveService = {}

local services
local store = nil
local storeError = nil
local SAVE_VERSION = 1

function SaveService:Init(allServices)
	services = allServices
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore("VikingCity_Villages_v1")
	end)
	if ok then
		store = result
	else
		storeError = tostring(result)
	end
end

local function keyFor(player: Player): string
	return "village_" .. player.UserId
end

-- Loads a player's saved village. Returns data or nil, and whether saving is safe.
function SaveService:Load(player: Player): (any, boolean)
	if not store then
		return nil, false
	end
	local data
	local ok, err
	for attempt = 1, 3 do
		ok, err = pcall(function()
			data = store:GetAsync(keyFor(player))
		end)
		if ok then
			break
		end
		task.wait(attempt)
	end
	if not ok then
		warn("[SaveService] couldn't load " .. player.Name .. ": " .. tostring(err))
		storeError = tostring(err)
		return nil, false
	end
	if type(data) ~= "table" or data.version ~= SAVE_VERSION then
		return nil, true
	end
	return data, true
end

-- Turns a colony into plain data a DataStore can hold.
function SaveService:Snapshot(colony)
	local buildings = {}
	for _, b in colony.buildings do
		table.insert(buildings, { t = b.type, x = b.cx, z = b.cz, r = b.rot })
	end
	local villagers = {}
	local index = {}
	for _, v in colony.villagers do
		table.insert(villagers, v)
		index[v.id] = #villagers
	end
	for i, v in villagers do
		local parents = {}
		for _, pid in v.parents or {} do
			table.insert(parents, index[pid])
		end
		villagers[i] = { n = v.name, c = v.isChild, a = v.age, p = v.partner and index[v.partner], f = parents }
	end
	local resources = {}
	for name, amount in colony.resources do
		resources[name] = math.floor(amount)
	end
	local tech = {}
	for id in colony.tech do
		table.insert(tech, id)
	end
	return {
		version = SAVE_VERSION,
		savedAt = os.time(),
		resources = resources,
		tech = tech,
		buildings = buildings,
		villagers = villagers,
		happiness = colony.happiness,
		day = colony.day,
		quest = colony.quest,
		stats = colony.stats,
	}
end

-- Rebuilds a colony from saved data (called on a fresh, empty colony).
function SaveService:Restore(colony, data)
	for name, amount in data.resources or {} do
		if type(amount) == "number" then
			colony.resources[name] = amount
		end
	end
	for _, id in data.tech or {} do
		if Config.Tech[id] then
			colony.tech[id] = true
		end
	end
	colony.happiness = tonumber(data.happiness) or colony.happiness
	colony.day = tonumber(data.day) or colony.day
	colony.quest = tonumber(data.quest) or 1
	if type(data.stats) == "table" then
		for k, n in data.stats do
			if type(k) == "string" and type(n) == "number" then
				colony.stats[k] = n
			end
		end
	end

	local placed = 0
	for _, b in data.buildings or {} do
		if Config.Buildings[b.t] then
			local ok, err = pcall(function()
				services.BuildingService:Create(colony, b.t, b.x, b.z, b.r)
			end)
			if ok then
				placed += 1
			else
				warn("[SaveService] skipped a " .. tostring(b.t) .. ": " .. tostring(err))
			end
		end
	end
	if placed == 0 then
		services.BuildingService:PlaceStarting(colony)
	end

	local villagers = data.villagers or {}
	local made = {}
	for i, saved in villagers do
		made[i] = services.VillagerService:Add(colony, saved.c == true, nil, type(saved.n) == "string" and saved.n or nil, tonumber(saved.a) or 0)
	end
	-- re-link families
	for i, saved in villagers do
		local v = made[i]
		local partner = saved.p and made[saved.p]
		if partner then
			v.partner = partner.id
		end
		if type(saved.f) == "table" then
			v.parents = {}
			for _, pi in saved.f do
				if made[pi] then
					table.insert(v.parents, made[pi].id)
				end
			end
		end
	end
	for _, v in made do
		services.VillagerService:RefreshLabel(colony, v)
	end
	if #villagers == 0 then
		services.VillagerService:SpawnStarting(colony)
	end
	task.defer(function()
		services.ToolService:ApplyArmor(colony.player)
	end)
end

function SaveService:Save(colony)
	if not store or not colony.canSave then
		return
	end
	local data = self:Snapshot(colony)
	local key = keyFor(colony.player)
	task.spawn(function()
		local ok, err = pcall(function()
			store:SetAsync(key, data)
		end)
		if not ok then
			warn("[SaveService] save failed: " .. tostring(err))
		end
	end)
end

-- Explains in the message feed why saving is off.
function SaveService:WhyOff(): string
	local e = (storeError or ""):lower()
	if e:find("403") or e:find("publish") or e:find("api") then
		return "Saving is off: publish the game and turn on API access in Game Settings > Security (see README)."
	end
	return "Saving is off right now (DataStores unavailable). Your village won't be saved this time."
end

function SaveService:Start()
	game:BindToClose(function()
		for _, colony in services.ColonyService:All() do
			if colony.canSave then
				pcall(function()
					store:SetAsync(keyFor(colony.player), self:Snapshot(colony))
				end)
			end
		end
	end)

	while true do
		task.wait(Config.AutosaveSeconds)
		for _, colony in services.ColonyService:All() do
			self:Save(colony)
		end
	end
end

return SaveService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">SeasonService</string>
            <string name="Source"><![CDATA[--[[
	SeasonService
	Turns the year: Summer -> Autumn -> Winter -> Spring, each lasting
	Config.SeasonSeconds. A season changes how the world looks:
	  Spring  fresh light-green leaves, young green barley
	  Summer  full green, golden barley
	  Autumn  birches turn gold and orange, ferns go rust-red, grass yellows
	  Winter  snow on the ground, roofs and trees, birches bare, the fjord's
	          edges freeze, and snow falls (the snowfall is drawn on clients)
	and how the colony works (Config.Seasons): farms stop in winter and
	everyone eats more.

	The current season is stored as workspace attributes "Season" (name) and
	"SeasonIndex" so the client can react (snowfall, falling leaves, HUD).
]]

local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)

local SeasonService = {}

local services
local Terrain = Workspace.Terrain
local M = Enum.Material
local currentIndex = 1

local SNOW = Color3.fromRGB(236, 240, 246)

-- Terrain colours per season, by material.
local TERRAIN = {
	Summer = { Grass = Color3.fromRGB(88, 118, 58), LeafyGrass = Color3.fromRGB(78, 106, 52), Ground = Color3.fromRGB(104, 88, 64) },
	Autumn = { Grass = Color3.fromRGB(126, 118, 62), LeafyGrass = Color3.fromRGB(132, 96, 52), Ground = Color3.fromRGB(110, 86, 60) },
	Winter = { Grass = Color3.fromRGB(226, 230, 238), LeafyGrass = Color3.fromRGB(214, 220, 228), Ground = Color3.fromRGB(190, 190, 196) },
	Spring = { Grass = Color3.fromRGB(100, 136, 62), LeafyGrass = Color3.fromRGB(90, 128, 58), Ground = Color3.fromRGB(100, 84, 62) },
}

function SeasonService:Init(allServices)
	services = allServices
end

function SeasonService:Current()
	return Config.Seasons[currentIndex]
end

-- A stable pseudo-random 0..1 per part, so a birch keeps its autumn colour.
local function hash(part: BasePart): number
	local p = part.Position
	return (math.sin(p.X * 12.9898 + p.Z * 78.233) * 43758.5453) % 1
end

local function base(part: BasePart): Color3
	local c = part:GetAttribute("BaseColor")
	if not c then
		c = part.Color
		part:SetAttribute("BaseColor", c)
	end
	return c
end

local function paint(part: BasePart, season: string)
	local name = part.Name
	if name == "Needles" or name == "Tip" then
		local c = base(part)
		if season == "Winter" then
			part.Color = c:Lerp(SNOW, 0.5)
		elseif season == "Spring" then
			part.Color = c:Lerp(Color3.fromRGB(70, 110, 60), 0.2)
		else
			part.Color = c
		end
	elseif name == "Leaves" then
		local c = base(part)
		part.Transparency = 0
		if season == "Spring" then
			part.Color = Color3.fromRGB(128, 176, 84)
		elseif season == "Autumn" then
			local golds = { Color3.fromRGB(222, 176, 58), Color3.fromRGB(206, 120, 42), Color3.fromRGB(190, 150, 50), Color3.fromRGB(170, 70, 36) }
			part.Color = golds[math.floor(hash(part) * #golds) + 1]
		elseif season == "Winter" then
			part.Transparency = 1 -- bare branches
		else
			part.Color = c
		end
	elseif name == "Fern" then
		local c = base(part)
		if season == "Autumn" then
			part.Color = Color3.fromRGB(150, 70, 38)
		elseif season == "Winter" then
			part.Color = Color3.fromRGB(170, 150, 120):Lerp(SNOW, 0.6)
		else
			part.Color = c
		end
	elseif name == "Juniper" or name == "Bush" then
		local c = base(part)
		part.Color = season == "Winter" and c:Lerp(SNOW, 0.45) or c
	elseif name == "Moss" then
		local c = base(part)
		part.Color = season == "Winter" and c:Lerp(SNOW, 0.8) or (season == "Autumn" and c:Lerp(Color3.fromRGB(130, 110, 60), 0.4) or c)
	elseif name == "Roof" then
		local c = base(part)
		part.Color = season == "Winter" and c:Lerp(SNOW, 0.8) or c
	elseif name == "Barley" then
		local c = base(part)
		if season == "Spring" then
			part.Color = Color3.fromRGB(104, 146, 66)
		elseif season == "Autumn" then
			part.Color = c:Lerp(Color3.fromRGB(170, 130, 70), 0.4)
		elseif season == "Winter" then
			part.Color = Color3.fromRGB(110, 92, 70):Lerp(SNOW, 0.6) -- fallow and frosted
		else
			part.Color = c
		end
	end
end

-- Paints every part inside `root` for the current season. Called for the
-- whole world on a season change, and for each new building or tree.
function SeasonService:ApplyTo(root: Instance)
	local season = self:Current().Name
	for _, d in root:GetDescendants() do
		if d:IsA("BasePart") then
			paint(d, season)
		end
	end
end

local frozen = false
local function setIce(on: boolean)
	if on == frozen then
		return
	end
	frozen = on
	-- freeze a band of shallow water along both shores
	local from, to = M.Water, M.Glacier
	if not on then
		from, to = M.Glacier, M.Water
	end
	local bands = {
		Region3.new(Vector3.new(-1200, -12, -112), Vector3.new(3200, 0, -36)),
		Region3.new(Vector3.new(-1200, -12, -640), Vector3.new(3200, 0, -520)),
	}
	for _, region in bands do
		Terrain:ReplaceMaterial(region:ExpandToGrid(4), 4, from, to)
	end
end

local function apply(index: number, announce: boolean)
	currentIndex = index
	local season = Config.Seasons[index]
	Workspace:SetAttribute("Season", season.Name)
	Workspace:SetAttribute("SeasonIndex", index)

	for material, color in TERRAIN[season.Name] do
		Terrain:SetMaterialColor(M[material], color)
	end
	Terrain:SetMaterialColor(M.Glacier, Color3.fromRGB(196, 222, 236))
	setIce(season.Name == "Winter")
	SeasonService:ApplyTo(Workspace)

	if announce then
		local lines = {
			Summer = "Summer is here. Long days and golden fields.",
			Autumn = "Autumn has come. Harvest what you can and fill your stores.",
			Winter = "Winter has come! Farms lie frozen and your people eat more.",
			Spring = "Spring thaw. The fields can be sown again.",
		}
		local ColonyService = services.ColonyService
		for _, colony in ColonyService:All() do
			ColonyService:Notify(colony, lines[season.Name], season.Name == "Winter" and "bad" or "good")
		end
	end
end

function SeasonService:Start()
	-- WorldService builds the world during Init, so it is ready here.
	apply(1, false)
	while true do
		task.wait(Config.SeasonSeconds)
		apply(currentIndex % #Config.Seasons + 1, true)
	end
end

return SeasonService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">TechService</string>
            <string name="Source"><![CDATA[--[[
	TechService
	Research. Players spend Lore (made in a Lore Hall) and sometimes other
	resources to unlock techs from Config.Tech. Some techs need a building
	(Smithy, Shipyard, Shrine) or other techs first, and patron paths are
	exclusive: a settlement follows only one.

	Effects are read where they matter through ColonyService:Has(colony, id).
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Grid = require(Shared.Grid)
local Remotes = require(Shared.Remotes)

local TechService = {}

local services

function TechService:Init(allServices)
	services = allServices
end

-- Returns ok, reason for whether `colony` can research `id` right now.
function TechService:CanResearch(colony, id: string): (boolean, string?)
	local tech = Config.Tech[id]
	if not tech then
		return false, "Unknown research"
	end
	local ColonyService = services.ColonyService
	if colony.tech[id] then
		return false, "Already known"
	end
	for _, req in tech.Requires or {} do
		if not colony.tech[req] then
			return false, "Needs " .. Config.Tech[req].Name
		end
	end
	if tech.Building and not ColonyService:HasBuilding(colony, tech.Building) then
		return false, "Build a " .. Config.Buildings[tech.Building].Display .. " first"
	end
	if tech.Group then
		for known in colony.tech do
			if Config.Tech[known].Group == tech.Group then
				return false, "You already follow " .. Config.Tech[known].Name
			end
		end
	end
	if not Grid.canAfford(colony.resources, tech.Cost) then
		return false, "Needs " .. Grid.costText(tech.Cost)
	end
	return true, nil
end

function TechService:Research(player: Player, id)
	local ColonyService = services.ColonyService
	local colony = ColonyService:Get(player)
	if not colony or typeof(id) ~= "string" then
		return false, "Not ready"
	end
	local ok, reason = self:CanResearch(colony, id)
	if not ok then
		return false, reason
	end
	ColonyService:Spend(colony, Config.Tech[id].Cost)
	colony.tech[id] = true
	if id == "ChainMail" or id == "IronAxes" or id == "SteelEdges" then
		services.ToolService:ApplyArmor(player)
	end
	ColonyService:Notify(colony, "Researched " .. Config.Tech[id].Name .. "! " .. Config.Tech[id].Description, "good")
	ColonyService:Sync(colony)
	return true, Config.Tech[id].Name .. " researched"
end

function TechService:Start()
	Remotes.Research.OnServerInvoke = function(player, id)
		return self:Research(player, id)
	end
end

return TechService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">ToolService</string>
            <string name="Source"><![CDATA[--[[
	ToolService
	Gives every player an Axe, a Pickaxe and a Bow each time they spawn
	(keys 1, 2, 3), and handles Bow shots: the client sends where it aimed,
	the server checks the shot, flies an arrow and tells WildlifeService if a
	deer was hit.
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Sounds = require(Shared.Sounds)
local Remotes = require(Shared.Remotes)
local ModelFactory = require(Shared.ModelFactory)

local ToolService = {}

local services
local lastShot = {} -- [player] = os.clock()

function ToolService:Init(allServices)
	services = allServices
end

-- Ring Mail research gives 150 health.
-- Welds a piece of gear to a body part (removed with the character).
local function wear(character: Model, onto: BasePart, name: string, size: Vector3, offset: CFrame, color: Color3, material, shape)
	local old = character:FindFirstChild(name)
	if old then
		old:Destroy()
	end
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = material or Enum.Material.Metal
	if shape then
		p.Shape = shape
	end
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.CFrame = onto.CFrame * offset
	p.Parent = character
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = onto
	weld.Part1 = p
	weld.Parent = p
	return p
end

-- Research shows on your Viking: chain mail and a helmet with Chain Mail,
-- darker iron then bright steel axe heads with Iron Axes / Steel Edges.
function ToolService:ApplyGear(player: Player)
	local character = player.Character
	local colony = services.ColonyService:Get(player)
	if not character or not colony then
		return
	end
	local Has = function(id)
		return services.ColonyService:Has(colony, id)
	end
	if Has("ChainMail") then
		local torso = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
		local head = character:FindFirstChild("Head")
		local mail = Color3.fromRGB(128, 130, 136)
		if torso then
			wear(character, torso, "GearMail", torso.Size + Vector3.new(0.12, 0.3, 0.12), CFrame.new(0, -0.1, 0), mail, Enum.Material.DiamondPlate)
		end
		local lower = character:FindFirstChild("LowerTorso")
		if lower then
			wear(character, lower, "GearSkirt", lower.Size + Vector3.new(0.14, 0.5, 0.14), CFrame.new(0, -0.2, 0), mail, Enum.Material.DiamondPlate)
		end
		if head then
			wear(character, head, "GearHelm", Vector3.new(1.3, 0.75, 1.3), CFrame.new(0, 0.38, 0), Color3.fromRGB(96, 98, 104), Enum.Material.Metal, Enum.PartType.Ball)
			wear(character, head, "GearNose", Vector3.new(0.14, 0.55, 0.14), CFrame.new(0, 0.05, -0.6), Color3.fromRGB(96, 98, 104), Enum.Material.Metal)
		end
	end
	local steel = Has("SteelEdges")
	local iron = Has("IronAxes")
	if steel or iron then
		local containers = { player:FindFirstChild("Backpack"), character }
		for _, c in containers do
			for _, toolName in { "Axe", "Sword" } do
				local axe = c and c:FindFirstChild(toolName) -- the axe or the sword
				if axe and axe:IsA("Tool") then
					for _, d in axe:GetChildren() do
						if d:IsA("BasePart") and d.Name == "Head" then
							d.Color = steel and Color3.fromRGB(210, 215, 225) or Color3.fromRGB(80, 82, 90)
							d.Material = steel and Enum.Material.Foil or Enum.Material.Metal
						end
					end
				end
			end
		end
	end
end

function ToolService:ApplyArmor(player: Player)
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	local colony = services.ColonyService:Get(player)
	if humanoid and services.ColonyService:Has(colony, "ChainMail") then
		humanoid.MaxHealth = 150
		humanoid.Health = math.max(humanoid.Health, 150)
	end
	self:ApplyGear(player)
end

-- True if the player is currently holding the named tool.
function ToolService:IsHolding(player: Player, toolName: string): boolean
	local character = player.Character
	local tool = character and character:FindFirstChildOfClass("Tool")
	return tool ~= nil and tool.Name == toolName
end

local function giveTools(player: Player)
	local backpack = player:WaitForChild("Backpack")
	for _, name in Config.Tools do
		if not backpack:FindFirstChild(name) and not (player.Character and player.Character:FindFirstChild(name)) then
			ModelFactory.tool(name).Parent = backpack
		end
	end
end

local function findDeer(inst: Instance?): Model?
	while inst and inst ~= workspace do
		if inst:IsA("Model") and inst:GetAttribute("DeerId") then
			return inst
		end
		inst = inst.Parent
	end
	return nil
end

local function shoot(player: Player, aim)
	if typeof(aim) ~= "Vector3" or aim ~= aim then
		return
	end
	local now = os.clock()
	if lastShot[player] and now - lastShot[player] < Config.Bow.Cooldown then
		return
	end
	if not ToolService:IsHolding(player, "Bow") then
		return
	end
	local character = player.Character
	local head = character and character:FindFirstChild("Head")
	if not head then
		return
	end
	lastShot[player] = now

	local origin = head.Position + Vector3.new(0, 0.3, 0)
	local delta = aim - origin
	if delta.Magnitude < 1 then
		return
	end
	local colony = services.ColonyService:Get(player)
	local longbows = services.ColonyService:Has(colony, "Longbows")
	local dir = delta.Unit * (Config.Bow.Range + (longbows and 60 or 0))
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character }
	local hit = workspace:Raycast(origin, dir, params)
	local endPoint = hit and hit.Position or origin + dir

	Sounds.play("Bow", head)
	-- the visible arrow
	local arrow = ModelFactory.arrow()
	arrow.CFrame = CFrame.lookAt(origin, endPoint)
	arrow.Parent = workspace
	local flight = (endPoint - origin).Magnitude / Config.Bow.ArrowSpeed
	TweenService:Create(arrow, TweenInfo.new(flight, Enum.EasingStyle.Linear), { CFrame = CFrame.lookAt(endPoint, endPoint + dir) }):Play()
	Debris:AddItem(arrow, flight + 3)

	local deer = hit and findDeer(hit.Instance)
	if deer then
		task.delay(flight, function()
			services.WildlifeService:Kill(deer, player)
		end)
	end
	local guard = hit and services.RaidService:FindDefender(hit.Instance)
	if guard then
		task.delay(flight, function()
			services.RaidService:DamageDefender(guard, Config.Combat.ArrowDamage * (longbows and 1.5 or 1), player)
		end)
	end
	local raider = hit and services.VillageDefenseService:FindRaider(hit.Instance)
	if raider then
		task.delay(flight, function()
			services.VillageDefenseService:DamageRaider(raider, Config.Combat.ArrowDamage * (longbows and 1.5 or 1))
		end)
	end
	local militia = hit and services.TownRaidService:FindMilitia(hit.Instance)
	if militia then
		task.delay(flight, function()
			services.TownRaidService:DamageMilitia(militia, Config.Combat.ArrowDamage * (longbows and 1.5 or 1), player)
		end)
	end
	if hit then
		task.delay(flight, function()
			services.BoatService:ArrowHit(hit.Instance, player)
		end)
	end
end

local lastStrike = {}
local function strike(player: Player)
	local now = os.clock()
	if lastStrike[player] and now - lastStrike[player] < Config.Combat.StrikeCooldown then
		return
	end
	local character = player.Character
	local held = character and character:FindFirstChildOfClass("Tool")
	local base = held and Config.Combat.MeleeDamage[held.Name]
	if not base then
		return
	end
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	lastStrike[player] = now
	Sounds.play("Swing", root)
	if held.Name ~= "Sword" then
		services.ResourceNodeService:Hit(player, held.Name, root)
	end
	local colony = services.ColonyService:Get(player)
	local damage = base
	if held.Name == "Sword" then
		if services.ColonyService:Has(colony, "SteelEdges") then
			damage *= 2
		elseif services.ColonyService:Has(colony, "IronAxes") then
			damage *= 1.5
		end
	end
	for _, guard in services.RaidService:DefendersNear(root.Position, root.CFrame.LookVector, Config.Combat.StrikeRange) do
		services.RaidService:DamageDefender(guard, damage, player)
	end
	for _, raider in services.VillageDefenseService:RaidersNear(root.Position, root.CFrame.LookVector, Config.Combat.StrikeRange) do
		services.VillageDefenseService:DamageRaider(raider, damage)
	end
	for _, militia in services.TownRaidService:MilitiaNear(root.Position, root.CFrame.LookVector, Config.Combat.StrikeRange) do
		services.TownRaidService:DamageMilitia(militia, damage, player)
	end
end

function ToolService:Start()
	local function onPlayer(player: Player)
		player.CharacterAdded:Connect(function(character)
			giveTools(player)
			character:WaitForChild("Head", 5)
			task.wait(0.5) -- let the avatar's look load first
			ToolService:ApplyArmor(player)
		end)
		if player.Character then
			giveTools(player)
		end
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in Players:GetPlayers() do
		onPlayer(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		lastShot[player] = nil
		lastStrike[player] = nil
	end)

	Remotes.ShootArrow.OnServerEvent:Connect(shoot)
	Remotes.Strike.OnServerEvent:Connect(strike)
end

return ToolService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">TownRaidService</string>
            <string name="Source"><![CDATA[--[[
	TownRaidService
	Raid other players' villages, Clash-of-Clans style. Each plot has a war
	horn post on its west edge. Another player can hold E on it to start a
	raid:
	  - the village calls up its militia (half its adults, 2 to 6 fighters)
	  - beat every militia within Config.TownRaid.Duration seconds
	  - then plunder the chest by their longhouse: you take a share of their
	    stores (20%, at most 150 of each resource)
	Villages are never destroyed and no buildings are harmed. A raided
	village gets a shield so it can't be raided again for a while, new
	villages are protected for their first days, and raiders have a cooldown.
]]

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Sounds = require(Shared.Sounds)
local Grid = require(Shared.Grid)
local ModelFactory = require(Shared.ModelFactory)

local TownRaidService = {}

local T = Config.TownRaid
local services
local folder: Folder
local raids = {} -- [targetPlayer] = raid
local shields = {} -- [userId] = os.clock() until which a village is shielded
local cooldowns = {} -- [userId] = os.clock() until which a player can't raid
local WALK_ANIM = "rbxassetid://507777826"

function TownRaidService:Init(allServices)
	services = allServices
	folder = Instance.new("Folder")
	folder.Name = "TownRaids"
	folder.Parent = workspace
end

local function notify(player: Player?, text: string, kind: string?)
	local colony = player and services.ColonyService:Get(player)
	if colony then
		services.ColonyService:Notify(colony, text, kind)
	end
end

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

local function villageCentre(colony): Vector3
	for _, b in colony.buildings do
		if Config.Buildings[b.type].Housing then
			return b.center
		end
	end
	return colony.origin + Vector3.new(Grid.PLOT_SIZE / 2, 0, Grid.PLOT_SIZE / 2)
end

-- Militia ---------------------------------------------------------------------

local function spawnMilitia(raid, pos: Vector3, ownerName: string)
	local desc = Instance.new("HumanoidDescription")
	local skin = Color3.fromRGB(226, 186, 150)
	desc.HeadColor = skin
	desc.LeftArmColor = skin
	desc.RightArmColor = skin
	desc.TorsoColor = Color3.fromRGB(120, 50, 40)
	desc.LeftLegColor = Color3.fromRGB(70, 56, 44)
	desc.RightLegColor = Color3.fromRGB(70, 56, 44)
	local ok, model = pcall(function()
		return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	end)
	if not ok or not model then
		warn("[TownRaidService] could not create militia: " .. tostring(model))
		return
	end
	model.Name = ownerName .. "'s Militia"
	model:SetAttribute("Militia", true)
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	humanoid.DisplayName = ownerName .. "'s Militia"
	humanoid.MaxHealth = T.MilitiaHealth
	humanoid.Health = T.MilitiaHealth
	humanoid.WalkSpeed = 14
	local rightHand = model:FindFirstChild("RightHand")
	if rightHand then
		local spear = Instance.new("Part")
		spear.Name = "Spear"
		spear.Size = Vector3.new(0.25, 0.25, 6)
		spear.Color = Color3.fromRGB(110, 76, 46)
		spear.Material = Enum.Material.Wood
		spear.CanCollide = false
		spear.Massless = true
		spear.CFrame = rightHand.CFrame * CFrame.new(0, 0, -1.5)
		spear.Parent = model
		local w = Instance.new("WeldConstraint")
		w.Part0 = rightHand
		w.Part1 = spear
		w.Parent = spear
	end
	model:PivotTo(CFrame.new(pos + Vector3.new(0, 3, 0)))
	model.Parent = folder
	local root = model:FindFirstChild("HumanoidRootPart")
	if root then
		pcall(function()
			root:SetNetworkOwner(nil)
		end)
	end
	local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator", humanoid)
	local walkTrack
	pcall(function()
		local anim = Instance.new("Animation")
		anim.AnimationId = WALK_ANIM
		walkTrack = animator:LoadAnimation(anim)
	end)
	humanoid.Running:Connect(function(speed)
		if walkTrack then
			if speed > 0.5 and not walkTrack.IsPlaying then
				walkTrack:Play()
			elseif speed <= 0.5 and walkTrack.IsPlaying then
				walkTrack:Stop()
			end
		end
	end)
	local m = { model = model, humanoid = humanoid, root = root, lastHit = 0 }
	humanoid.Died:Connect(function()
		m.dead = true
		task.delay(5, function()
			model:Destroy()
		end)
		TownRaidService:CheckWon(raid)
	end)
	table.insert(raid.militia, m)
end

-- Raids -----------------------------------------------------------------------

local function endRaid(raid, won: boolean, reason: string?)
	if raid.over then
		return
	end
	raid.over = true
	raids[raid.target] = nil
	for _, m in raid.militia do
		if m.model.Parent then
			m.model:Destroy()
		end
	end
	if raid.chest then
		raid.chest:Destroy()
	end
	if raid.diedConn then
		raid.diedConn:Disconnect()
	end
	local now = os.clock()
	cooldowns[raid.attacker.UserId] = now + T.AttackerCooldown
	shields[raid.target.UserId] = now + (won and T.ShieldSeconds or T.FailedShieldSeconds)
	if not won then
		notify(raid.attacker, "The raid on " .. raid.target.DisplayName .. "'s village failed" .. (reason and (": " .. reason) or "."), "bad")
		notify(raid.target, "Your militia drove off " .. raid.attacker.DisplayName .. "! Your stores are safe.", "good")
	end
end

local function plunder(raid, player: Player)
	if raid.over or player ~= raid.attacker or not raid.won then
		return
	end
	local ColonyService = services.ColonyService
	local attacker = ColonyService:Get(raid.attacker)
	local target = ColonyService:Get(raid.target)
	if not attacker or not target then
		endRaid(raid, false, "the village is gone")
		return
	end
	local mult = 1
	if ColonyService:Has(attacker, "SeaRaiders") then
		mult *= 1.25
	end
	local taken = {}
	for _, res in Config.ResourceOrder do
		if res ~= "Lore" then
			local amount = math.floor(math.min((target.resources[res] or 0) * T.LootShare * mult, T.LootCap))
			if amount > 0 then
				target.resources[res] -= amount
				ColonyService:Add(attacker, res, amount)
				taken[res] = amount
			end
		end
	end
	local text = next(taken) and Grid.costText(taken) or "nothing (their stores were empty)"
	ColonyService:Notify(attacker, "Victory! You carried off " .. text .. " from " .. raid.target.DisplayName .. ".", "raid")
	ColonyService:Notify(target, raid.attacker.DisplayName .. " plundered " .. text .. ". Your village is shielded for " .. math.floor(T.ShieldSeconds / 60) .. " minutes.", "bad")
	ColonyService:Sync(attacker)
	ColonyService:Sync(target)
	endRaid(raid, true)
end

function TownRaidService:CheckWon(raid)
	if raid.over or raid.won then
		return
	end
	for _, m in raid.militia do
		if not m.dead then
			return
		end
	end
	raid.won = true
	notify(raid.attacker, "The militia has fallen! Plunder the chest by their longhouse (hold E).", "raid")
	notify(raid.target, "Your militia has fallen! " .. raid.attacker.DisplayName .. " is going for your stores.", "bad")

	local centre = villageCentre(services.ColonyService:Get(raid.target))
	local chest = Instance.new("Model")
	chest.Name = "RaidChest"
	local add = ModelFactory.addPart
	local cf = CFrame.new(centre + Vector3.new(0, 0, -12))
	local box = add(chest, { Name = "Box", Size = Vector3.new(4, 2.2, 2.6), CFrame = cf * CFrame.new(0, 1.1, 0), Color = Color3.fromRGB(110, 70, 40), Material = Enum.Material.WoodPlanks })
	add(chest, { Name = "Silver", Size = Vector3.new(3, 0.4, 1.8), CFrame = cf * CFrame.new(0, 2.4, 0), Color = Color3.fromRGB(220, 220, 230), Material = Enum.Material.Foil })
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 220, 150)
	light.Range = 10
	light.Parent = box
	chest.Parent = folder
	raid.chest = chest
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Plunder"
	prompt.ObjectText = raid.target.DisplayName .. "'s stores"
	prompt.HoldDuration = 2
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.Parent = box
	prompt.Triggered:Connect(function(player)
		plunder(raid, player)
	end)
end

local function canRaid(attacker: Player, target: Player): (boolean, string?)
	local ColonyService = services.ColonyService
	local a, t = ColonyService:Get(attacker), ColonyService:Get(target)
	if attacker == target then
		return false, "This is your own village's war horn."
	end
	if not a or not t then
		return false, "That village isn't ready."
	end
	local now = os.clock()
	if raids[target] then
		return false, target.DisplayName .. "'s village is already under attack."
	end
	for _, r in raids do
		if r.attacker == attacker then
			return false, "You're already raiding someone."
		end
	end
	if (shields[target.UserId] or 0) > now then
		return false, target.DisplayName .. "'s village is shielded for " .. math.ceil((shields[target.UserId] - now) / 60) .. " more minute(s)."
	end
	if (cooldowns[attacker.UserId] or 0) > now then
		return false, "Your warriors are resting. Raid again in " .. math.ceil(cooldowns[attacker.UserId] - now) .. "s."
	end
	if a.day < T.MinDay then
		return false, "Your village must reach day " .. T.MinDay .. " before raiding others."
	end
	if t.day < T.MinDay then
		return false, target.DisplayName .. "'s village is too new to raid (protected until day " .. T.MinDay .. ")."
	end
	return true, nil
end

local function startRaid(attacker: Player, target: Player)
	local ok, reason = canRaid(attacker, target)
	if not ok then
		notify(attacker, reason, "bad")
		return
	end
	local colony = services.ColonyService:Get(target)
	local adults = 0
	for _, v in colony.villagers do
		if not v.isChild then
			adults += 1
		end
	end
	local count = math.clamp(math.floor(adults * T.MilitiaPerAdult), T.MinMilitia, T.MaxMilitia)
	local raid = { attacker = attacker, target = target, militia = {}, endsAt = os.clock() + T.Duration }
	raids[target] = raid
	local centre = villageCentre(colony)
	for i = 1, count do
		local a = i / count * math.pi * 2
		local p = centre + Vector3.new(math.cos(a) * 10, 0, math.sin(a) * 10)
		local y = services.WorldService:GroundHeight(p.X, p.Z)
		spawnMilitia(raid, Vector3.new(p.X, y, p.Z), target.DisplayName)
	end
	local hum = attacker.Character and attacker.Character:FindFirstChildOfClass("Humanoid")
	if hum then
		raid.diedConn = hum.Died:Connect(function()
			endRaid(raid, false, "you fell in battle")
		end)
	end
	Sounds.play("WarHorn", centre)
	notify(attacker, "RAID on " .. target.DisplayName .. "'s village! Defeat " .. count .. " militia in " .. T.Duration .. "s.", "raid")
	notify(target, attacker.DisplayName .. " sounds the war horn! Your militia (" .. count .. ") takes up arms.", "raid")
end

-- Combat hooks used by ToolService -----------------------------------------------

function TownRaidService:FindMilitia(inst: Instance?): Model?
	while inst and inst ~= workspace do
		if inst:IsA("Model") and inst:GetAttribute("Militia") then
			return inst
		end
		inst = inst.Parent
	end
	return nil
end

function TownRaidService:MilitiaNear(position: Vector3, look: Vector3, range: number)
	local found = {}
	for _, raid in raids do
		for _, m in raid.militia do
			if not m.dead and m.root then
				local offset = flat(m.root.Position - position)
				if offset.Magnitude <= range and (offset.Magnitude < 2 or offset.Unit:Dot(flat(look).Unit) > 0.2) then
					table.insert(found, m.model)
				end
			end
		end
	end
	return found
end

function TownRaidService:DamageMilitia(model: Model, amount: number, attacker: Player)
	local raid
	for _, r in raids do
		for _, m in r.militia do
			if m.model == model then
				raid = r
			end
		end
	end
	if not raid or raid.attacker ~= attacker then
		return -- only the raider fights the militia
	end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.Health > 0 then
		humanoid:TakeDamage(amount)
	end
end

-- Loop ------------------------------------------------------------------------

function TownRaidService:Start()
	-- a war horn post on the west edge of every plot
	for i = 1, Config.MAX_PLOTS do
		local o = Grid.plotOrigin(i)
		local x, z = o.X - 6, o.Z + Grid.PLOT_SIZE / 2
		local y = services.WorldService:GroundHeight(x, z)
		local post = Instance.new("Part")
		post.Name = "WarHornPost"
		post.Anchored = true
		post.Size = Vector3.new(0.8, 6, 0.8)
		post.Position = Vector3.new(x, y + 3, z)
		post.Color = Color3.fromRGB(96, 70, 48)
		post.Material = Enum.Material.Wood
		post.Parent = folder
		local horn = Instance.new("Part")
		horn.Name = "Horn"
		horn.Anchored = true
		horn.CanCollide = false
		horn.Shape = Enum.PartType.Cylinder
		horn.Size = Vector3.new(2.4, 0.6, 0.6)
		horn.CFrame = CFrame.new(x, y + 5.6, z) * CFrame.Angles(0, 0, math.rad(20))
		horn.Color = Color3.fromRGB(226, 214, 186)
		horn.Material = Enum.Material.SmoothPlastic
		horn.Parent = folder
		local prompt = Instance.new("ProximityPrompt")
		prompt.ActionText = "Raid this village"
		prompt.ObjectText = "War horn"
		prompt.HoldDuration = 1.5
		prompt.MaxActivationDistance = 10
		prompt.RequiresLineOfSight = false
		prompt.Parent = post
		prompt.Triggered:Connect(function(player)
			for _, target in Players:GetPlayers() do
				local colony = services.ColonyService:Get(target)
				if colony and colony.plotIndex == i then
					startRaid(player, target)
					return
				end
			end
			notify(player, "Nobody lives here yet.", "info")
		end)
	end

	Players.PlayerRemoving:Connect(function(player)
		for _, raid in raids do
			if raid.attacker == player or raid.target == player then
				endRaid(raid, false, "a chieftain left")
			end
		end
	end)

	while true do
		task.wait(0.25)
		local now = os.clock()
		for _, raid in raids do
			if now > raid.endsAt and not raid.over then
				endRaid(raid, false, "time ran out")
				continue
			end
			local character = raid.attacker.Character
			local troot = character and character:FindFirstChild("HumanoidRootPart")
			local thum = character and character:FindFirstChildOfClass("Humanoid")
			for _, m in raid.militia do
				if not m.dead and m.root and troot and thum and thum.Health > 0 then
					local dist = (troot.Position - m.root.Position).Magnitude
					m.humanoid:MoveTo(troot.Position)
					if dist < 6.5 and now - m.lastHit > 1.2 then
						m.lastHit = now
						thum:TakeDamage(T.MilitiaDamage)
					end
				end
			end
		end
	end
end

return TownRaidService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">TradeService</string>
            <string name="Source"><![CDATA[--[[
	TradeService
	A trader's stall on the beach in front of every plot. Hold E there to
	open the trade window and swap goods for silver (or silver for goods).
	Prices follow the seasons: food is dear in winter and cheap at harvest.
	Offers are in Config.Trade.
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Grid = require(Shared.Grid)
local Remotes = require(Shared.Remotes)
local ModelFactory = require(Shared.ModelFactory)
local Sounds = require(Shared.Sounds)

local TradeService = {}

local services
local stalls = {} -- [plotIndex] = position

function TradeService:Init(allServices)
	services = allServices
end

-- What offer `i` costs right now (season-adjusted), and what it gives.
function TradeService.Price(i: number, season: string?)
	local offer = Config.Trade.Offers[i]
	if not offer then
		return nil, nil
	end
	local mult = offer.Season and offer.Season[season or "Summer"] or 1
	local give = {}
	for res, n in offer.Give do
		give[res] = math.max(1, math.floor(n * mult + 0.5))
	end
	return give, offer.Get
end

local function nearStall(player: Player): boolean
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not root then
		return false
	end
	for _, pos in stalls do
		if (root.Position - pos).Magnitude < 18 then
			return true
		end
	end
	return false
end

function TradeService:Trade(player: Player, i)
	local ColonyService = services.ColonyService
	local colony = ColonyService:Get(player)
	if not colony or typeof(i) ~= "number" then
		return false, "Not ready"
	end
	if not nearStall(player) then
		return false, "Walk back to the trader's stall"
	end
	local give, get = TradeService.Price(math.floor(i), workspace:GetAttribute("Season"))
	if not give then
		return false, "Unknown offer"
	end
	if not ColonyService:Spend(colony, give) then
		return false, "You need " .. Grid.costText(give)
	end
	for res, n in get do
		ColonyService:Add(colony, res, n)
	end
	services.QuestService:Count(colony, "trade")
	Sounds.play("Build", player.Character and player.Character:FindFirstChild("HumanoidRootPart"))
	ColonyService:Sync(colony)
	return true, "Traded " .. Grid.costText(give) .. " for " .. Grid.costText(get)
end

local function buildStall(index: number)
	local o = Grid.plotOrigin(index)
	local x, z = o.X + 100, -16
	local y = services.WorldService:GroundHeight(x, z)
	local base = CFrame.new(x, y, z)
	local model = Instance.new("Model")
	model.Name = "TraderStall"
	local add = ModelFactory.addPart
	local wood = Color3.fromRGB(110, 78, 50)
	for _, c in { { -4, -2.5 }, { 4, -2.5 }, { -4, 2.5 }, { 4, 2.5 } } do
		add(model, { Name = "Post", Size = Vector3.new(0.6, 7, 0.6), CFrame = base * CFrame.new(c[1], 3.5, c[2]), Color = wood })
	end
	add(model, { Name = "Counter", Size = Vector3.new(9, 3, 2), CFrame = base * CFrame.new(0, 1.5, -2.2), Color = Color3.fromRGB(96, 68, 44), Material = Enum.Material.WoodPlanks })
	-- striped awning
	for i = 0, 4 do
		add(model, {
			Name = "Awning",
			Size = Vector3.new(1.9, 0.2, 6.6),
			CFrame = base * CFrame.new(-3.8 + i * 1.9, 7.3, 0) * CFrame.Angles(math.rad(-12), 0, 0),
			Color = i % 2 == 0 and Color3.fromRGB(160, 46, 40) or Color3.fromRGB(226, 214, 186),
			Material = Enum.Material.Fabric,
			CanCollide = false,
		})
	end
	-- goods on the counter
	add(model, { Name = "Crate", Size = Vector3.new(1.6, 1.4, 1.4), CFrame = base * CFrame.new(-3, 3.7, -2.2), Color = Color3.fromRGB(150, 110, 70) })
	add(model, { Name = "Pelts", Size = Vector3.new(2.4, 0.4, 1.4), CFrame = base * CFrame.new(0, 3.2, -2.2), Color = Color3.fromRGB(140, 96, 60), Material = Enum.Material.Fabric })
	add(model, { Name = "Silver", Size = Vector3.new(1.2, 0.5, 1.2), CFrame = base * CFrame.new(3, 3.25, -2.2), Color = Color3.fromRGB(220, 220, 230), Material = Enum.Material.Foil })
	local trader = ModelFactory.villager("Ottar the Trader", false, Random.new(index), "elder")
	local offset = trader:GetAttribute("GroundOffset") or 2
	trader:PivotTo(base * CFrame.new(0, offset, 0.5) * CFrame.Angles(0, math.pi, 0))
	trader.Parent = model
	model.Parent = workspace

	local anchor = model:FindFirstChild("Counter")
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Trade"
	prompt.ObjectText = "Ottar's stall"
	prompt.HoldDuration = 0.3
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.Parent = anchor
	prompt.Triggered:Connect(function(player)
		Remotes.OpenTrade:FireClient(player)
	end)
	stalls[index] = Vector3.new(x, y, z)
end

function TradeService:Start()
	for i = 1, Config.MAX_PLOTS do
		buildStall(i)
	end
	Remotes.Trade.OnServerInvoke = function(player, i)
		return self:Trade(player, i)
	end
end

return TradeService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">VillageDefenseService</string>
            <string name="Source"><![CDATA[--[[
	VillageDefenseService
	Every few days (Config.VillageRaids) a warband from one of the rival
	holds raids YOUR village:
	  - you get a warning first, then they march in from the edge of your plot
	  - they head for your stores (Storehouse, or your Longhouse)
	  - Palisades are in the way: they have to stop and hack through (the
	    wall is down for a while, then your people put it back up)
	  - Watchtowers with an archer at work shoot them; you fight with your
	    Sword and Bow
	  - every raider who reaches the stores carries off a share and leaves
	Nothing is ever destroyed. Beat the whole warband for a reward.
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Grid = require(Shared.Grid)
local ModelFactory = require(Shared.ModelFactory)
local Sounds = require(Shared.Sounds)

local VillageDefenseService = {}

local VR = Config.VillageRaids
local services
local rng = Random.new()
local folder: Folder
local raids = {} -- [colony] = raid
local WALK_ANIM = "rbxassetid://507777826"

function VillageDefenseService:Init(allServices)
	services = allServices
	folder = Instance.new("Folder")
	folder.Name = "VillageRaiders"
	folder.Parent = workspace
end

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

local function notify(colony, text: string, kind: string?)
	services.ColonyService:Notify(colony, text, kind)
end

-- Where the raiders are going: a storehouse, else any home.
local function storesOf(colony)
	local best
	for _, b in colony.buildings do
		if b.type == "Storehouse" then
			return b
		end
		if not best and Config.Buildings[b.type].Housing then
			best = b
		end
	end
	return best
end

local function spawnRaider(raid, pos: Vector3, holdName: string)
	local desc = Instance.new("HumanoidDescription")
	local skin = Color3.fromRGB(220, 182, 146)
	desc.HeadColor = skin
	desc.LeftArmColor = skin
	desc.RightArmColor = skin
	desc.TorsoColor = Color3.fromRGB(46, 52, 70)
	desc.LeftLegColor = Color3.fromRGB(50, 44, 38)
	desc.RightLegColor = Color3.fromRGB(50, 44, 38)
	local ok, model = pcall(function()
		return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	end)
	if not ok or not model then
		warn("[VillageDefenseService] could not create raider: " .. tostring(model))
		return
	end
	model.Name = holdName .. " Raider"
	model:SetAttribute("Raider", true)
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	humanoid.DisplayName = holdName .. " Raider"
	humanoid.MaxHealth = VR.RaiderHealth
	humanoid.Health = VR.RaiderHealth
	humanoid.WalkSpeed = 12
	local head = model:FindFirstChild("Head")
	local hand = model:FindFirstChild("RightHand")
	local function gear(onto, name, size, offset, color, material, shape)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.Color = color
		p.Material = material or Enum.Material.Metal
		if shape then
			p.Shape = shape
		end
		p.CanCollide = false
		p.Massless = true
		p.CFrame = onto.CFrame * offset
		p.Parent = model
		local w = Instance.new("WeldConstraint")
		w.Part0 = onto
		w.Part1 = p
		w.Parent = p
	end
	if head then
		gear(head, "Helmet", Vector3.new(1.35, 0.7, 1.35), CFrame.new(0, 0.45, 0), Color3.fromRGB(70, 72, 78), Enum.Material.Metal, Enum.PartType.Ball)
	end
	if hand then
		gear(hand, "Haft", Vector3.new(0.25, 3.2, 0.25), CFrame.new(0, -0.6, -0.4) * CFrame.Angles(math.rad(90), 0, 0), Color3.fromRGB(110, 76, 46), Enum.Material.Wood)
		gear(hand, "AxeHead", Vector3.new(0.2, 1, 1.1), CFrame.new(0, 0.1, -1.9), Color3.fromRGB(120, 122, 130))
	end
	model:PivotTo(CFrame.new(pos + Vector3.new(0, 3, 0)))
	model.Parent = folder
	local root = model:FindFirstChild("HumanoidRootPart")
	if root then
		pcall(function()
			root:SetNetworkOwner(nil)
		end)
	end
	local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator", humanoid)
	local walkTrack
	pcall(function()
		local anim = Instance.new("Animation")
		anim.AnimationId = WALK_ANIM
		walkTrack = animator:LoadAnimation(anim)
	end)
	humanoid.Running:Connect(function(speed)
		if walkTrack then
			if speed > 0.5 and not walkTrack.IsPlaying then
				walkTrack:Play()
			elseif speed <= 0.5 and walkTrack.IsPlaying then
				walkTrack:Stop()
			end
		end
	end)
	local r = { model = model, humanoid = humanoid, root = root, lastHit = 0, lastPos = pos, stuckFor = 0 }
	humanoid.Died:Connect(function()
		r.dead = true
		task.delay(5, function()
			model:Destroy()
		end)
		VillageDefenseService:CheckBeaten(raid)
	end)
	table.insert(raid.raiders, r)
end

-- Raid lifecycle ----------------------------------------------------------------

local function endRaid(raid, text: string?, kind: string?)
	if raid.over then
		return
	end
	raid.over = true
	raids[raid.colony] = nil
	for _, r in raid.raiders do
		if not r.dead and r.model.Parent then
			r.model:Destroy()
		end
	end
	raid.colony.nextRaidDay = raid.colony.day + rng:NextInteger(VR.EveryDays[1], VR.EveryDays[2])
	if text then
		notify(raid.colony, text, kind)
	end
end

function VillageDefenseService:CheckBeaten(raid)
	if raid.over then
		return
	end
	local fought = 0
	for _, r in raid.raiders do
		if not r.dead and not r.fled then
			return
		end
		if r.dead then
			fought += 1
		end
	end
	local colony = raid.colony
	if fought > 0 and raid.stolen == 0 then
		for res, n in VR.Reward do
			services.ColonyService:Add(colony, res, n)
		end
		colony.happiness = math.min(100, colony.happiness + 8)
		services.QuestService:Count(colony, "defend")
		endRaid(raid, "The " .. raid.hold .. " warband is beaten! Your people cheer. +" .. Grid.costText(VR.Reward), "raid")
	elseif raid.stolen > 0 then
		endRaid(raid, "The raiders are gone, but they carried off some of your stores. Build Watchtowers and Palisades!", "bad")
	else
		endRaid(raid)
	end
end

local function steal(raid, r)
	local colony = raid.colony
	local taken = {}
	for _, res in Config.ResourceOrder do
		if res ~= "Lore" then
			local n = math.floor(math.min((colony.resources[res] or 0) * VR.StealShare, VR.StealCap))
			if n > 0 then
				colony.resources[res] -= n
				taken[res] = n
			end
		end
	end
	raid.stolen += 1
	r.fled = true
	notify(colony, "A raider reached your stores and ran off with " .. (next(taken) and Grid.costText(taken) or "nothing") .. "!", "bad")
	TweenService:Create(r.root, TweenInfo.new(0.6), { Transparency = 1 }):Play()
	task.delay(0.6, function()
		if r.model.Parent then
			r.model:Destroy()
		end
	end)
	services.ColonyService:Sync(colony)
	VillageDefenseService:CheckBeaten(raid)
end

-- A palisade in the way gets hacked down for a while (never destroyed).
local function breach(colony, near: Vector3): boolean
	for _, b in colony.buildings do
		if b.type == "Palisade" and not b.breached and flat(b.center - near).Magnitude < 9 then
			b.breached = true
			for _, p in b.model:GetDescendants() do
				if p:IsA("BasePart") then
					p:SetAttribute("PreBreach", p.Transparency)
					p.Transparency = 0.75
					p.CanCollide = false
				end
			end
			notify(colony, "Raiders are hacking through your palisade!", "bad")
			task.delay(30, function()
				b.breached = false
				if b.model.Parent then
					for _, p in b.model:GetDescendants() do
						if p:IsA("BasePart") then
							p.Transparency = p:GetAttribute("PreBreach") or 0
							p.CanCollide = true
						end
					end
				end
			end)
			return true
		end
	end
	return false
end

local function startRaid(colony)
	local hold = Config.Rivals[rng:NextInteger(1, #Config.Rivals)]
	local count = math.min(VR.BaseRaiders + math.floor(colony.day / 4), VR.MaxRaiders)
	local raid = { colony = colony, raiders = {}, stolen = 0, hold = hold.Name, startedAt = os.clock() }
	raids[colony] = raid
	-- they come from the side of the plot nearest their hold
	local o = colony.origin
	local fromWest = hold.Center.X < o.X
	local x = fromWest and (o.X - 14) or (o.X + Grid.PLOT_SIZE + 14)
	for i = 1, count do
		local z = o.Z + Grid.PLOT_SIZE * 0.3 + i * 6
		local y = services.WorldService:GroundHeight(x, z)
		spawnRaider(raid, Vector3.new(x + rng:NextNumber(-3, 3), y, z), hold.Name)
	end
	Sounds.play("WarHorn", Vector3.new(x, o.Y, o.Z + Grid.PLOT_SIZE / 2))
	notify(colony, "RAID! " .. count .. " " .. hold.Name .. " raiders storm your village!", "raid")
end

local function warnOf(colony)
	local hold = Config.Rivals[rng:NextInteger(1, #Config.Rivals)]
	colony.raidWarned = true
	notify(colony, "Scouts report a " .. hold.Name .. " warband marching on your village! They arrive in " .. VR.WarningSeconds .. " seconds.", "raid")
	task.delay(VR.WarningSeconds, function()
		colony.raidWarned = false
		if colony.player.Parent and services.ColonyService:Get(colony.player) == colony then
			startRaid(colony)
		end
	end)
end

-- Tick ------------------------------------------------------------------------

local function towerArrow(from: Vector3, to: Vector3)
	local arrow = ModelFactory.arrow()
	arrow.CFrame = CFrame.lookAt(from, to)
	arrow.Parent = workspace
	local flight = (to - from).Magnitude / 150
	TweenService:Create(arrow, TweenInfo.new(flight, Enum.EasingStyle.Linear), { CFrame = CFrame.lookAt(to, to + (to - from).Unit) }):Play()
	task.delay(flight + 2, function()
		arrow:Destroy()
	end)
	Sounds.play("Bow", from)
	return flight
end

local function tickRaid(raid, now: number, step: number)
	local colony = raid.colony
	if now - raid.startedAt > VR.LeaveAfter then
		for _, r in raid.raiders do
			r.fled = true
		end
		endRaid(raid, "The raiders lost heart and went home.", "info")
		return
	end
	local stores = storesOf(colony)
	local character = colony.player.Character
	local proot = character and character:FindFirstChild("HumanoidRootPart")
	local phum = character and character:FindFirstChildOfClass("Humanoid")

	for _, r in raid.raiders do
		if not r.dead and not r.fled and r.root then
			local pos = r.root.Position
			local goal = stores and stores.center or (colony.origin + Vector3.new(Grid.PLOT_SIZE / 2, 0, Grid.PLOT_SIZE / 2))
			local nearPlayer = proot and phum and phum.Health > 0 and (proot.Position - pos).Magnitude < 22
			if nearPlayer then
				r.humanoid:MoveTo(proot.Position)
				if (proot.Position - pos).Magnitude < 6 and now - r.lastHit > 1.2 then
					r.lastHit = now
					local dmg = VR.RaiderDamage * (services.ColonyService:Has(colony, "PathStorm") and 0.7 or 1)
					phum:TakeDamage(dmg)
				end
			else
				r.humanoid:MoveTo(goal)
				if flat(goal - pos).Magnitude < 11 then
					steal(raid, r)
					continue
				end
			end
			-- stuck against a wall? hack through it
			if (pos - r.lastPos).Magnitude < 0.6 * step * 4 then
				r.stuckFor += step
				if r.stuckFor > 2 and breach(colony, pos) then
					r.stuckFor = 0
				end
			else
				r.stuckFor = 0
			end
			r.lastPos = pos
		end
	end

	-- watchtowers with an archer at work shoot the nearest raider
	local manned = {}
	for _, v in colony.villagers do
		if v.job then
			manned[v.job] = true
		end
	end
	for id, b in colony.buildings do
		if b.type == "Watchtower" and manned[id] and now - (b.lastShot or 0) > VR.TowerCooldown then
			local top = b.center + Vector3.new(0, 15.5, 0)
			local target, best = nil, VR.TowerRange
			for _, r in raid.raiders do
				if not r.dead and not r.fled and r.root then
					local d = (r.root.Position - top).Magnitude
					if d < best then
						target, best = r, d
					end
				end
			end
			if target then
				b.lastShot = now
				local flight = towerArrow(top, target.root.Position)
				task.delay(flight, function()
					if not target.dead then
						target.humanoid:TakeDamage(VR.TowerDamage)
					end
				end)
			end
		end
	end
end

-- Combat hooks for ToolService -----------------------------------------------------

function VillageDefenseService:FindRaider(inst: Instance?): Model?
	while inst and inst ~= workspace do
		if inst:IsA("Model") and inst:GetAttribute("Raider") then
			return inst
		end
		inst = inst.Parent
	end
	return nil
end

function VillageDefenseService:RaidersNear(position: Vector3, look: Vector3, range: number)
	local found = {}
	for _, raid in raids do
		for _, r in raid.raiders do
			if not r.dead and not r.fled and r.root then
				local offset = flat(r.root.Position - position)
				if offset.Magnitude <= range and (offset.Magnitude < 2 or offset.Unit:Dot(flat(look).Unit) > 0.2) then
					table.insert(found, r.model)
				end
			end
		end
	end
	return found
end

function VillageDefenseService:DamageRaider(model: Model, amount: number)
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.Health > 0 then
		humanoid:TakeDamage(amount)
	end
end

function VillageDefenseService:Start()
	if not VR.Enabled then
		return
	end
	local last = os.clock()
	while true do
		task.wait(0.25)
		local now = os.clock()
		local step = now - last
		last = now
		for _, colony in services.ColonyService:All() do
			colony.nextRaidDay = colony.nextRaidDay or math.max(VR.FirstDay, colony.day + 2)
			local raid = raids[colony]
			if raid then
				tickRaid(raid, now, step)
			elseif not colony.raidWarned and colony.day >= colony.nextRaidDay then
				warnOf(colony)
			end
		end
	end
end

return VillageDefenseService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">VillagerService</string>
            <string name="Source"><![CDATA[--[[
	VillagerService
	Your people. Each villager is a record plus a small figure that walks
	around the plot. Every tick this service:
	  1. gives idle adults a job at a building with a free slot
	  2. lets workers produce resources
	  3. feeds everyone (and notices starvation)
	  4. moves happiness toward a target based on food and shelter
	  5. once per in-game day: villagers age (baby -> child -> adult ->
	     elder), single adults may marry and share a home, married couples
	     have babies, immigrants arrive from neighbouring tribes, or unhappy
	     villagers leave
	Families: a child is named after a parent (Astrid Bjornsdottir), keeps
	close to its parents while small, and lives in the family home.
	  6. moves the little figures around
]]

local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Grid = require(Shared.Grid)
local ModelFactory = require(Shared.ModelFactory)

local VillagerService = {}

local services
local rng = Random.new()
local V = Config.Villagers

function VillagerService:Init(allServices)
	services = allServices
end

-- Helpers -------------------------------------------------------------------

local function counts(colony)
	local adults, children = 0, 0
	for _, v in colony.villagers do
		if v.isChild then
			children += 1
		else
			adults += 1
		end
	end
	return adults, children
end

local function clampToPlot(colony, pos: Vector3): Vector3
	local o = colony.origin
	local size = Grid.PLOT_SIZE
	return Vector3.new(math.clamp(pos.X, o.X + 2, o.X + size - 2), o.Y, math.clamp(pos.Z, o.Z + 2, o.Z + size - 2))
end

-- A random spot just outside the edge of a building.
local function pointNear(colony, building): Vector3
	local hx = building.sx * Config.CELL / 2 + 2
	local hz = building.sz * Config.CELL / 2 + 2
	local p
	if rng:NextNumber() < 0.5 then
		p = building.center + Vector3.new(rng:NextNumber(-hx, hx), 0, (rng:NextNumber() < 0.5 and -hz or hz))
	else
		p = building.center + Vector3.new((rng:NextNumber() < 0.5 and -hx or hx), 0, rng:NextNumber(-hz, hz))
	end
	return clampToPlot(colony, p)
end

local function randomHome(colony)
	local homes = {}
	for _, b in colony.buildings do
		if Config.Buildings[b.type].Housing then
			table.insert(homes, b)
		end
	end
	if #homes == 0 then
		return nil
	end
	return homes[rng:NextInteger(1, #homes)]
end

local function stageOf(v): string
	if v.isChild then
		return (v.age < V.BabyDays) and "baby" or "child"
	end
	return (v.age >= V.ElderAge) and "elder" or "adult"
end

-- The villager's home building (kept with their family), picking one if needed.
local function homeOf(colony, v)
	local home = v.home and colony.buildings[v.home]
	if home then
		return home
	end
	local partner = v.partner and colony.villagers[v.partner]
	home = partner and partner.home and colony.buildings[partner.home]
	if not home and v.parents then
		for _, pid in v.parents do
			local parent = colony.villagers[pid]
			home = parent and parent.home and colony.buildings[parent.home]
			if home then
				break
			end
		end
	end
	home = home or randomHome(colony)
	v.home = home and home.id or nil
	return home
end

local function firstName(v): string
	return (string.split(v.name, " "))[1]
end

local function updateLabel(colony, v)
	local label = v.model:FindFirstChild("NameTag", true)
	label = label and label:FindFirstChild("Label")
	if not label then
		return
	end
	local stage = stageOf(v)
	local heart = v.partner and colony.villagers[v.partner] and " ♥" or ""
	if stage == "baby" or stage == "child" then
		label.Text = v.name .. " (" .. stage .. ")"
	elseif v.job and colony.buildings[v.job] then
		label.Text = v.name .. heart .. " (" .. Config.Buildings[colony.buildings[v.job].type].Display .. ")"
	else
		label.Text = v.name .. heart .. (stage == "elder" and " (elder)" or "")
	end
end

local function makeModel(colony, v, groundPos: Vector3)
	if v.model then
		v.model:Destroy()
	end
	v.stage = stageOf(v)
	v.model = ModelFactory.villager(v.name, v.isChild, rng, v.stage)
	v.body = v.model.PrimaryPart
	v.height = v.model:GetAttribute("GroundOffset") or v.body.Size.Y / 2
	v.model:PivotTo(CFrame.new(groundPos + Vector3.new(0, v.height, 0)))
	v.model.Parent = colony.plot.Villagers
	v.busyUntil = 0
	updateLabel(colony, v)
end

-- Redraws the name tag (after a name or age is restored from a save).
function VillagerService:RefreshLabel(colony, v)
	updateLabel(colony, v)
end

-- Adding / removing ---------------------------------------------------------

function VillagerService:Add(colony, isChild: boolean, groundPos: Vector3?, name: string?, age: number?)
	local id = services.ColonyService:NewId(colony)
	local v = {
		id = id,
		name = name or Config.Names[rng:NextInteger(1, #Config.Names)],
		isChild = isChild,
		-- days lived here; newcomers arrive as grown adults
		age = age or (isChild and 0 or rng:NextInteger(4, 12)),
		job = nil,
	}
	if not groundPos then
		local home = randomHome(colony)
		groundPos = home and pointNear(colony, home) or colony.origin + Vector3.new(Grid.PLOT_SIZE / 2, 0, Grid.PLOT_SIZE / 2)
	end
	makeModel(colony, v, groundPos)
	colony.villagers[id] = v
	return v
end

function VillagerService:Remove(colony, v)
	colony.villagers[v.id] = nil
	local partner = v.partner and colony.villagers[v.partner]
	if partner then
		partner.partner = nil
		updateLabel(colony, partner)
	end
	if v.model then
		v.model:Destroy()
	end
end

function VillagerService:SpawnStarting(colony)
	local first = {}
	for i = 1, V.Starting do
		first[i] = self:Add(colony, false)
	end
	-- the first two settlers are a married couple
	if first[1] and first[2] then
		first[1].partner, first[2].partner = first[2].id, first[1].id
		local home = homeOf(colony, first[1])
		first[2].home = home and home.id or nil
		updateLabel(colony, first[1])
		updateLabel(colony, first[2])
	end
end

function VillagerService:OnBuildingRemoved(colony, buildingId: number)
	for _, v in colony.villagers do
		if v.job == buildingId then
			v.job = nil
			updateLabel(colony, v)
		end
	end
end

function VillagerService:Cleanup(colony)
	-- Models live inside the plot, which PlotService destroys.
	colony.villagers = {}
end

-- Simulation steps ------------------------------------------------------------

local function assignJobs(colony)
	local filled = {}
	for _, v in colony.villagers do
		if v.job then
			if colony.buildings[v.job] then
				filled[v.job] = (filled[v.job] or 0) + 1
			else
				v.job = nil
			end
		end
	end

	local openings = {}
	for id, b in colony.buildings do
		local slots = Config.Buildings[b.type].Workers or 0
		for _ = 1, slots - (filled[id] or 0) do
			table.insert(openings, id)
		end
	end
	table.sort(openings)

	for _, v in colony.villagers do
		if #openings == 0 then
			break
		end
		if not v.isChild and not v.job then
			v.job = table.remove(openings, 1)
			v.busyUntil = 0 -- walk to work right away
			updateLabel(colony, v)
		end
	end
end

local function produce(colony, dt: number)
	local ColonyService = services.ColonyService
	local efficiency = 0.5 + colony.happiness / 200
	if colony.starving then
		efficiency *= 0.5
	end
	local workers = {}
	for _, v in colony.villagers do
		if v.job then
			workers[v.job] = (workers[v.job] or 0) + 1
		end
	end
	local season = services.SeasonService:Current()
	for id, b in colony.buildings do
		local produces = Config.Buildings[b.type].Produces
		local n = workers[id]
		if produces and n then
			for resource, rate in produces do
				-- crops only grow outside winter
				local seasonal = b.type == "Farm" and season.FarmRate or 1
				local bonus = 1
				if b.type == "Farm" and ColonyService:Has(colony, "CropRotation") then
					bonus *= 1.25
				elseif b.type == "Quarry" and ColonyService:Has(colony, "Masonry") then
					bonus *= 1.3
				elseif b.type == "Woodcutter" and ColonyService:Has(colony, "Woodcraft") then
					bonus *= 1.3
				elseif b.type == "LoreHall" and ColonyService:Has(colony, "SagaTellers") then
					bonus *= 1.5
				end
				ColonyService:Add(colony, resource, rate * n * dt * efficiency * seasonal * bonus)
			end
		end
	end
end

local function eat(colony, dt: number)
	local adults, children = counts(colony)
	local foodUse = services.SeasonService:Current().FoodUse
	if services.ColonyService:Has(colony, "MidwinterRite") then
		foodUse = 1
	end
	local need = (adults * V.FoodPerAdultPerSecond + children * V.FoodPerChildPerSecond) * dt * foodUse
	local food = colony.resources.Food or 0
	local wasStarving = colony.starving
	if food >= need then
		colony.resources.Food = food - need
		colony.starving = false
	else
		colony.resources.Food = 0
		colony.starving = need > 0
	end
	if colony.starving and not wasStarving then
		services.ColonyService:Notify(colony, "Your people are starving! Build farms or forage berries.", "bad")
	end
end

local function updateHappiness(colony, dt: number)
	local adults, children = counts(colony)
	local pop = adults + children
	local housing = services.ColonyService:Housing(colony)
	local dailyFood = adults * V.FoodPerAdultPerSecond * Config.DAY_LENGTH

	local target = 55
	if colony.starving then
		target -= 45
	elseif (colony.resources.Food or 0) >= dailyFood * 2 then
		target += 15 -- two days of food in store
	end
	local homeless = math.max(0, pop - housing)
	target -= homeless * 8
	-- buildings and traits that cheer people up (each building type counts once)
	local cheered = {}
	for _, b in colony.buildings do
		local bonus = Config.Buildings[b.type].Happiness
		if bonus and not cheered[b.type] then
			cheered[b.type] = true
			target += bonus
		end
	end
	local ColonyService = services.ColonyService
	if ColonyService:Has(colony, "Feasting") then
		target += 10
	end
	if ColonyService:Has(colony, "PathHearth") then
		target += 10
	end
	target = math.clamp(target, 0, 100)

	colony.happiness += (target - colony.happiness) * math.min(1, 0.05 * dt)
	colony.homeless = homeless
end

local function newDay(self, colony)
	local ColonyService = services.ColonyService
	colony.day += 1

	-- Everyone ages: babies start walking, children come of age, adults grey.
	for _, v in colony.villagers do
		v.age += 1
		if v.isChild and v.age >= V.DaysToAdulthood then
			v.isChild = false
		end
		local stage = stageOf(v)
		if stage ~= v.stage then
			makeModel(colony, v, v.body.Position - Vector3.new(0, v.height, 0))
			if stage == "child" then
				ColonyService:Notify(colony, v.name .. " is toddling about on their own now.", "info")
			elseif stage == "adult" then
				ColonyService:Notify(colony, v.name .. " has come of age and can now work.", "good")
			elseif stage == "elder" then
				ColonyService:Notify(colony, v.name .. " is now one of the village elders.", "info")
			end
		end
	end

	-- Two single adults may marry and move into one home.
	if rng:NextNumber() < V.MarriageChancePerDay then
		local singles = {}
		for _, v in colony.villagers do
			if not v.isChild and not (v.partner and colony.villagers[v.partner]) then
				v.partner = nil
				table.insert(singles, v)
			end
		end
		if #singles >= 2 then
			local a = table.remove(singles, rng:NextInteger(1, #singles))
			local b = table.remove(singles, rng:NextInteger(1, #singles))
			a.partner, b.partner = b.id, a.id
			local home = homeOf(colony, a)
			b.home = home and home.id or nil
			updateLabel(colony, a)
			updateLabel(colony, b)
			ColonyService:Notify(colony, a.name .. " and " .. b.name .. " were wed! They share a home now.", "good")
		end
	end

	local adults, children = counts(colony)
	local free = ColonyService:Housing(colony) - adults - children
	local h = colony.happiness

	-- Unhappy people leave first.
	if h < V.LeaveBelowHappiness and adults > 1 then
		for _, v in colony.villagers do
			if not v.isChild then
				ColonyService:Notify(colony, v.name .. " was unhappy and left the settlement.", "bad")
				self:Remove(colony, v)
				break
			end
		end
		return
	end

	-- Births: a married couple has a baby, named after one of them.
	local couples = {}
	for _, v in colony.villagers do
		local partner = v.partner and colony.villagers[v.partner]
		if partner and v.id < partner.id and not v.isChild then
			table.insert(couples, { v, partner })
		end
	end
	if #couples > 0 and free > 0 and not colony.starving and h >= V.BirthMinHappiness and rng:NextNumber() < V.BirthChancePerDay * (ColonyService:Has(colony, "PathHearth") and 2 or 1) then
		local couple = couples[rng:NextInteger(1, #couples)]
		local namesake = couple[rng:NextInteger(1, 2)]
		local daughter = rng:NextNumber() < 0.5
		local name = Config.Names[rng:NextInteger(1, #Config.Names)] .. " " .. firstName(namesake) .. (daughter and "sdottir" or "sson")
		local home = homeOf(colony, couple[1])
		local spawnAt = couple[1].body and (couple[1].body.Position - Vector3.new(0, couple[1].height, 0)) or nil
		local v = self:Add(colony, true, spawnAt, name)
		v.parents = { couple[1].id, couple[2].id }
		v.home = home and home.id or nil
		free -= 1
		ColonyService:Notify(colony, couple[1].name .. " and " .. couple[2].name .. " had a baby: " .. name .. "!", "good")
	end

	-- Immigration from neighbouring tribes.
	if free > 0 and not colony.starving and h >= V.ImmigrationMinHappiness and rng:NextNumber() < V.ImmigrationChancePerDay then
		local maxGroup = V.ImmigrationMaxGroup * (ColonyService:Has(colony, "OpenArms") and 2 or 1)
		local n = rng:NextInteger(1, math.min(maxGroup, free))
		local tribe = Config.Tribes[rng:NextInteger(1, #Config.Tribes)]
		local arrival = colony.origin + Vector3.new(rng:NextNumber(10, Grid.PLOT_SIZE - 10), 0, -4)
		for _ = 1, n do
			self:Add(colony, false, arrival + Vector3.new(rng:NextNumber(-3, 3), 0, 0))
		end
		ColonyService:Notify(colony, n .. (n == 1 and " settler" or " settlers") .. " from the " .. tribe .. " joined you.", "good")
	elseif free <= 0 and h >= V.ImmigrationMinHappiness then
		ColonyService:Notify(colony, "Travellers passed by, but you had no free housing. Build a longhouse!", "info")
	end
end

local function walk(colony, v, now: number)
	if now < v.busyUntil or not v.body then
		return
	end
	local target
	local job = v.job and colony.buildings[v.job]
	local stage = v.stage or stageOf(v)
	-- little ones stay close to a parent
	local parent
	if stage == "baby" or stage == "child" then
		for _, pid in v.parents or {} do
			local p = colony.villagers[pid]
			if p and p.body and (not parent or rng:NextNumber() < 0.5) then
				parent = p
			end
		end
	end
	if parent and rng:NextNumber() < (stage == "baby" and 0.9 or 0.55) then
		target = clampToPlot(colony, parent.body.Position + Vector3.new(rng:NextNumber(-4, 4), 0, rng:NextNumber(-4, 4)))
	elseif job and rng:NextNumber() < 0.85 then
		target = pointNear(colony, job)
	else
		local home = homeOf(colony, v)
		local wander = stage == "child" and 30 or (stage == "baby" and 6 or 20)
		if home and rng:NextNumber() < 0.7 then
			target = pointNear(colony, home)
		else
			target = clampToPlot(colony, v.body.Position + Vector3.new(rng:NextNumber(-wander, wander), 0, rng:NextNumber(-wander, wander)))
		end
	end

	local from = v.body.Position
	local to = Vector3.new(target.X, colony.origin.Y + v.height, target.Z)
	local flat = Vector3.new(to.X - from.X, 0, to.Z - from.Z)
	local dist = flat.Magnitude
	if dist < 1 then
		v.busyUntil = now + 2
		return
	end
	local speed = V.WalkSpeed * (({ baby = 0.45, child = 1.25, elder = 0.7 })[stage] or 1)
	local duration = dist / speed
	v.body.CFrame = CFrame.lookAt(from, from + flat)
	TweenService:Create(v.body, TweenInfo.new(duration, Enum.EasingStyle.Linear), { CFrame = CFrame.lookAt(to, to + flat) }):Play()
	-- workers linger at their job; others idle a while
	v.busyUntil = now + duration + rng:NextNumber(job and 3 or 2, job and 8 or 6)
end

function VillagerService:Tick(colony, dt: number)
	assignJobs(colony)
	produce(colony, dt)
	eat(colony, dt)
	updateHappiness(colony, dt)

	colony.dayTimer += dt
	if colony.dayTimer >= Config.DAY_LENGTH then
		colony.dayTimer -= Config.DAY_LENGTH
		newDay(self, colony)
	end

	local now = os.clock()
	for _, v in colony.villagers do
		walk(colony, v, now)
	end
end

return VillagerService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">WildlifeService</string>
            <string name="Source"><![CDATA[--[[
	WildlifeService
	Deer graze in the meadow behind each plot. They wander slowly and bolt
	when a player comes close, so you hunt them with the Bow from a distance.
	A deer gives meat (Food) and Hides, then a new one wanders in later.
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Grid = require(Shared.Grid)
local ModelFactory = require(Shared.ModelFactory)

local WildlifeService = {}

local W = Config.Wildlife
local services
local rng = Random.new()
local folder: Folder
local herd = {} -- [model] = deer record
local nextId = 0

local MEADOW_MIN_Z, MEADOW_MAX_Z = Grid.PLOT_SIZE + 18, Grid.PLOT_SIZE + 105

function WildlifeService:Init(allServices)
	services = allServices
end

local function areaFor(index: number)
	local o = Grid.plotOrigin(index)
	return { minX = o.X - 16, maxX = o.X + Grid.PLOT_SIZE + 16, minZ = MEADOW_MIN_Z, maxZ = MEADOW_MAX_Z, plot = index }
end

local function clampToArea(area, x: number, z: number): (number, number)
	return math.clamp(x, area.minX, area.maxX), math.clamp(z, area.minZ, area.maxZ)
end

local function moveTo(deer, x: number, z: number, speed: number)
	local body = deer.body
	local from = body.Position
	local y = services.WorldService:GroundHeight(x, z) + deer.offset
	local to = Vector3.new(x, y, z)
	local flat = Vector3.new(to.X - from.X, 0, to.Z - from.Z)
	if flat.Magnitude < 1 then
		return 0
	end
	local duration = flat.Magnitude / speed
	body.CFrame = CFrame.lookAt(from, from + flat)
	if deer.tween then
		deer.tween:Cancel()
	end
	deer.tween = TweenService:Create(body, TweenInfo.new(duration, Enum.EasingStyle.Linear), { CFrame = CFrame.lookAt(to, to + flat) })
	deer.tween:Play()
	return duration
end

function WildlifeService:Spawn(area)
	nextId += 1
	local model = ModelFactory.deer(rng)
	model:SetAttribute("DeerId", nextId)
	local x = rng:NextNumber(area.minX, area.maxX)
	local z = rng:NextNumber(area.minZ, area.maxZ)
	local offset = model:GetAttribute("GroundOffset")
	model:PivotTo(CFrame.new(x, services.WorldService:GroundHeight(x, z) + offset, z) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0))
	model.Parent = folder

	herd[model] = {
		model = model,
		body = model.PrimaryPart,
		offset = offset,
		area = area,
		busyUntil = 0,
	}
end

-- Called by ToolService when an arrow hits a deer.
function WildlifeService:Kill(model: Model, hunter: Player)
	local deer = herd[model]
	if not deer then
		return
	end
	herd[model] = nil
	if deer.tween then
		deer.tween:Cancel()
	end
	-- topple over, then vanish
	deer.body.CFrame = deer.body.CFrame * CFrame.new(0, -1.2, 0) * CFrame.Angles(0, 0, math.pi / 2)
	task.delay(2, function()
		model:Destroy()
	end)

	local ColonyService = services.ColonyService
	local colony = ColonyService:Get(hunter)
	if colony then
		local mult = ColonyService:Has(colony, "PathWoods") and 2 or 1
		ColonyService:Add(colony, "Food", W.Meat * mult)
		ColonyService:Add(colony, "Hides", W.Hides * mult)
		services.QuestService:Count(colony, "deer")
		ColonyService:Notify(colony, "Deer hunted! +" .. W.Meat * mult .. " Food, +" .. W.Hides * mult .. " Hides", "gain")
		ColonyService:Sync(colony)
	end

	task.delay(W.RespawnSeconds, function()
		self:Spawn(deer.area)
	end)
end

local function nearestPlayer(pos: Vector3): (Vector3?, number)
	local best, bestDist = nil, math.huge
	for _, player in Players:GetPlayers() do
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if root then
			local d = (root.Position - pos).Magnitude
			if d < bestDist then
				best, bestDist = root.Position, d
			end
		end
	end
	return best, bestDist
end

function WildlifeService:Start()
	folder = Instance.new("Folder")
	folder.Name = "Wildlife"
	folder.Parent = workspace

	for i = 1, Config.MAX_PLOTS do
		local area = areaFor(i)
		for _ = 1, W.DeerPerPlot do
			self:Spawn(area)
		end
	end

	while true do
		task.wait(0.4)
		local now = os.clock()
		for _, deer in herd do
			local pos = deer.body.Position
			local threat, dist = nearestPlayer(pos)
			if threat and dist < W.FleeDistance and not deer.fleeing then
				-- bolt directly away
				local away = Vector3.new(pos.X - threat.X, 0, pos.Z - threat.Z)
				away = away.Magnitude > 0.1 and away.Unit or Vector3.new(0, 0, 1)
				local x, z = clampToArea(deer.area, pos.X + away.X * 40, pos.Z + away.Z * 40)
				local t = moveTo(deer, x, z, W.FleeSpeed)
				deer.fleeing = true
				deer.busyUntil = now + t + 1
			elseif now >= deer.busyUntil then
				deer.fleeing = false
				local x, z = clampToArea(deer.area, pos.X + rng:NextNumber(-25, 25), pos.Z + rng:NextNumber(-25, 25))
				local t = moveTo(deer, x, z, W.Speed * rng:NextNumber(0.4, 1))
				deer.busyUntil = now + t + rng:NextNumber(3, 9) -- graze a while
			end
		end
	end
end

return WildlifeService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">WorldService</string>
            <string name="Source"><![CDATA[--[[
	WorldService
	Builds the world when the server starts: a Nordic valley made of Terrain,
	generated from layered noise (a heightmap) so it looks natural, then
	painted by height and steepness: grass and meadow flowers in the valley,
	bare rock and slate on cliffs, snow above the snowline, sand and mud at
	the fjord. The build area stays perfectly flat.

	Layout (looking from the lake toward the mountains):
	  z < -44      a fjord lake, with a far shore and peaks across the water
	  z -44..0     sandy beach and docks, then a dirt path in front of each plot
	  z 0..160     the row of player plots (grass)
	  z 160..270   an open meadow where deer roam
	  z 270..470   pine forest, rolling hills and rock outcrops
	  z 480+       snow-capped mountains
	Also sets up warm afternoon light, haze, sky and colour grading.

	Everything here is decoration: change the numbers freely.
]]

local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Grid = require(Shared.Grid)
local ModelFactory = require(Shared.ModelFactory)

local WorldService = {}

local Terrain = workspace.Terrain
local M = Enum.Material
local rng = Random.new(1066) -- fixed seed: the valley looks the same every time

local PLOTS_END_X = Config.MAX_PLOTS * (Grid.PLOT_SIZE + Config.PLOT_GAP) - Config.PLOT_GAP
local TOP = Config.GROUND_Y
local VOXEL = 4

-- World bounds (multiples of 4 so they line up with the terrain voxel grid)
local MIN_X = -760
local MAX_X = math.ceil((PLOTS_END_X + 760) / VOXEL) * VOXEL
local MIN_Z, MAX_Z = -800, 840

-- The flat, buildable part of the valley
-- (extends west to hold the rival village, Config.Rival)
local FLAT_MIN_X, FLAT_MAX_X = -290, PLOTS_END_X + 40
for _, rival in Config.Rivals do
	FLAT_MIN_X = math.min(FLAT_MIN_X, rival.Center.X - rival.Radius - 30)
	FLAT_MAX_X = math.max(FLAT_MAX_X, rival.Center.X + rival.Radius + 30)
end
local FLAT_MIN_Z, FLAT_MAX_Z = -40, Grid.PLOT_SIZE + 115
local SHORE_Z = -40 -- where the beach starts to slope into the fjord
local SEED = 7.31

-- Noise helpers ---------------------------------------------------------------

local function smooth(edge0: number, edge1: number, x: number): number
	local t = math.clamp((x - edge0) / (edge1 - edge0), 0, 1)
	return t * t * (3 - 2 * t)
end

local function lerp(a: number, b: number, t: number): number
	return a + (b - a) * t
end

-- fractal noise, roughly -0.5..0.5
local function fbm(x: number, z: number, freq: number, octaves: number, salt: number): number
	local amp, sum, norm = 1, 0, 0
	for o = 1, octaves do
		sum += math.noise(x * freq, z * freq, SEED + salt + o * 17.3) * amp
		norm += amp
		amp *= 0.5
		freq *= 2
	end
	return sum / norm
end

-- ridged noise, 0..1, sharp crests: good for mountain ridges
local function ridged(x: number, z: number, freq: number, octaves: number): number
	local amp, sum, norm = 1, 0, 0
	for o = 1, octaves do
		local n = 1 - math.abs(math.noise(x * freq, z * freq, SEED + 91 + o * 31.7) * 1.6)
		n = math.max(n, 0)
		sum += n * n * amp
		norm += amp
		amp *= 0.5
		freq *= 2.1
	end
	return sum / norm
end

-- 0 outside the build zone, 1 inside, with a soft 60-stud edge
local function flatMask(x: number, z: number): number
	local fx = math.min(smooth(FLAT_MIN_X - 60, FLAT_MIN_X, x), smooth(FLAT_MAX_X + 60, FLAT_MAX_X, x))
	local fz = math.min(smooth(FLAT_MIN_Z - 70, FLAT_MIN_Z, z), smooth(FLAT_MAX_Z + 90, FLAT_MAX_Z, z))
	return math.min(fx, fz)
end

local function mountainMask(x: number, z: number): (number, number)
	local wobble = fbm(x, z, 1 / 320, 2, 5) * 160
	local back = smooth(380, 660, z + wobble)
	local far = smooth(-540, -720, z - wobble * 0.5)
	local side = math.max(smooth(FLAT_MIN_X - 220, FLAT_MIN_X - 520, x + wobble), smooth(FLAT_MAX_X + 220, FLAT_MAX_X + 520, x + wobble))
	return math.max(back, far, side), far
end

-- The height of the land at x, z
local function heightAt(x: number, z: number): number
	local m, far = mountainMask(x, z)
	local mountains = m * (40 + 210 * ridged(x, z, 1 / 380, 5))
	local hills = 26 * (fbm(x, z, 1 / 170, 4, 1) + 0.5) * smooth(200, 340, z)
	local detail = fbm(x, z, 1 / 36, 2, 3) * 2.5
	local h = TOP + hills + mountains + detail

	-- the fjord: slope down from the beach, rise again at the far shore
	if z < SHORE_Z then
		local lake = smooth(SHORE_Z, SHORE_Z - 80, z) * (1 - far)
		-- shallow near the beach, dropping into a deep dark channel
		local bed = lerp(-5, -42, smooth(SHORE_Z - 20, SHORE_Z - 260, z) * (1 - far)) + fbm(x, z, 1 / 90, 3, 7) * 6
		h = lerp(h, bed, lake)
	end

	return lerp(h, TOP, flatMask(x, z))
end

local function inPlotArea(x: number, z: number): boolean
	if z < -50 or z > Grid.PLOT_SIZE + 12 then
		return false
	end
	for i = 1, Config.MAX_PLOTS do
		local o = Grid.plotOrigin(i)
		if x > o.X - 8 and x < o.X + Grid.PLOT_SIZE + 8 then
			return true
		end
	end
	return false
end

local function inRivalArea(x: number, z: number): boolean
	for _, rival in Config.Rivals do
		local dx, dz = x - rival.Center.X, z - rival.Center.Z
		if dx * dx + dz * dz < (rival.Radius + 22) ^ 2 then
			return true
		end
	end
	return false
end

local function inApron(x: number, z: number): boolean
	if z < -16 or z > 0 then
		return false
	end
	for i = 1, Config.MAX_PLOTS do
		local o = Grid.plotOrigin(i)
		if x >= o.X and x <= o.X + Grid.PLOT_SIZE then
			return true
		end
	end
	return false
end

local function groundAt(x: number, z: number): RaycastResult?
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { Terrain }
	return workspace:Raycast(Vector3.new(x, 600, z), Vector3.new(0, -700, 0), params)
end

-- Picks the surface material from height, steepness and position.
local function surfaceMaterial(x: number, z: number, h: number, slope: number)
	if inApron(x, z) then
		return M.Ground
	end
	if inPlotArea(x, z) then
		return M.Grass
	end
	if inRivalArea(x, z) then
		local dx, dz = x - RIVAL.Center.X, z - RIVAL.Center.Z
		return (dx * dx + dz * dz < 36 * 36 or fbm(x, z, 1 / 25, 2, 41) > 0.2) and M.Ground or M.Grass
	end
	if h < -6 then
		return M.Mud
	end
	if h < 3 and z < SHORE_Z + 12 then
		return M.Sand
	end
	local snowline = 150 + fbm(x, z, 1 / 80, 2, 11) * 50
	if h > snowline and slope < 1.3 then
		return M.Snow
	end
	if slope > 1.15 then
		return M.Rock
	end
	if slope > 0.75 then
		return M.Slate
	end
	if h > snowline - 45 then
		return fbm(x, z, 1 / 30, 2, 13) > 0 and M.Rock or M.Ground
	end
	local n = fbm(x, z, 1 / 70, 3, 17)
	if n > 0.22 then
		return M.LeafyGrass
	elseif n < -0.28 then
		return M.Ground
	end
	return M.Grass
end

local function buildTerrain()
	Terrain:Clear()

	-- Materials and water look
	Terrain:SetMaterialColor(M.Grass, Color3.fromRGB(88, 118, 58))
	Terrain:SetMaterialColor(M.LeafyGrass, Color3.fromRGB(78, 106, 52))
	Terrain:SetMaterialColor(M.Rock, Color3.fromRGB(104, 104, 102))
	Terrain:SetMaterialColor(M.Slate, Color3.fromRGB(88, 90, 88))
	Terrain:SetMaterialColor(M.Snow, Color3.fromRGB(240, 244, 250))
	Terrain:SetMaterialColor(M.Sand, Color3.fromRGB(176, 164, 134))
	Terrain:SetMaterialColor(M.Ground, Color3.fromRGB(104, 88, 64))
	Terrain:SetMaterialColor(M.Mud, Color3.fromRGB(62, 56, 46))
	-- deep fjord teal: low transparency so depth reads as colour, full
	-- reflectance so the sky and mountains mirror in it
	Terrain.WaterColor = Color3.fromRGB(22, 50, 60)
	Terrain.WaterTransparency = 0.18
	Terrain.WaterReflectance = 1
	Terrain.WaterWaveSize = 0.16
	Terrain.WaterWaveSpeed = 9
	pcall(function()
		Terrain.Decoration = true -- animated grass blades on Grass
	end)

	-- 1. Heightmap: one height per 4x4-stud column
	local nx = (MAX_X - MIN_X) // VOXEL
	local nz = (MAX_Z - MIN_Z) // VOXEL
	local heights = table.create(nx + 2)
	local budget = os.clock()
	for i = 0, nx + 1 do
		local row = table.create(nz + 2)
		local x = MIN_X + (i - 0.5) * VOXEL
		for k = 0, nz + 1 do
			row[k] = heightAt(x, MIN_Z + (k - 0.5) * VOXEL)
		end
		heights[i] = row
		if os.clock() - budget > 0.05 then
			if RunService:IsRunning() then
				task.wait()
			end
			budget = os.clock()
		end
	end

	-- 2. Write voxels chunk by chunk
	local CHUNK = 32
	for ci = 1, nx, CHUNK do
		for ck = 1, nz, CHUNK do
			local ci2 = math.min(ci + CHUNK - 1, nx)
			local ck2 = math.min(ck + CHUNK - 1, nz)
			local lo, hi = math.huge, -math.huge
			for i = ci, ci2 do
				local row = heights[i]
				for k = ck, ck2 do
					local h = row[k]
					lo = math.min(lo, h)
					hi = math.max(hi, h)
				end
			end
			hi = math.max(hi, 0) -- room for water
			local yMin = math.floor((lo - 14) / VOXEL) * VOXEL
			local yMax = math.ceil((hi + 1) / VOXEL) * VOXEL
			local ny = (yMax - yMin) // VOXEL

			local materials = table.create(ci2 - ci + 1)
			local occupancy = table.create(ci2 - ci + 1)
			for i = ci, ci2 do
				local mx, ox = table.create(ny), table.create(ny)
				local x = MIN_X + (i - 0.5) * VOXEL
				local row, rowL, rowR = heights[i], heights[i - 1], heights[i + 1]
				for j = 1, ny do
					mx[j] = table.create(ck2 - ck + 1)
					ox[j] = table.create(ck2 - ck + 1)
				end
				for k = ck, ck2 do
					local z = MIN_Z + (k - 0.5) * VOXEL
					local h = row[k]
					local slope = math.max(math.abs(rowR[k] - rowL[k]), math.abs(row[k + 1] - row[k - 1])) / (2 * VOXEL)
					local surface = surfaceMaterial(x, z, h, slope)
					local under = (surface == M.Grass or surface == M.LeafyGrass) and M.Ground or surface
					local kk = k - ck + 1
					for j = 1, ny do
						local y0 = yMin + (j - 1) * VOXEL
						local mat, occ
						if h >= y0 + VOXEL then
							local depth = h - (y0 + VOXEL)
							occ = 1
							if depth < 3 then
								mat = surface
							elseif depth < 9 then
								mat = under
							else
								mat = M.Rock
							end
						elseif h > y0 then
							occ = (h - y0) / VOXEL
							mat = surface
						elseif y0 + VOXEL <= 0 then
							occ = 1
							mat = M.Water
						else
							occ = 0
							mat = M.Air
						end
						mx[j][kk] = mat
						ox[j][kk] = occ
					end
				end
				materials[i - ci + 1] = mx
				occupancy[i - ci + 1] = ox
			end

			local regionMin = Vector3.new(MIN_X + (ci - 1) * VOXEL, yMin, MIN_Z + (ck - 1) * VOXEL)
			local regionMax = Vector3.new(MIN_X + ci2 * VOXEL, yMax, MIN_Z + ck2 * VOXEL)
			Terrain:WriteVoxels(Region3.new(regionMin, regionMax), VOXEL, materials, occupancy)

			if os.clock() - budget > 0.05 then
				if RunService:IsRunning() then
					task.wait()
				end
				budget = os.clock()
			end
		end
	end
end

local function scatterScenery()
	local folder = Instance.new("Folder")
	folder.Name = "Scenery"
	folder.Parent = workspace

	local treeMaterials = { [M.Grass] = true, [M.LeafyGrass] = true, [M.Ground] = true }

	local function plant(x: number, z: number): boolean
		if inPlotArea(x, z) or inRivalArea(x, z) or (x > FLAT_MIN_X and x < FLAT_MAX_X and z > -60 and z < 0) then
			return false
		end
		local hit = groundAt(x, z)
		if not hit or not treeMaterials[hit.Material] or hit.Normal.Y < 0.82 then
			return false
		end
		local treeline = 125 + fbm(x, z, 1 / 80, 2, 23) * 40
		if hit.Position.Y > treeline or hit.Position.Y < 1.5 then
			return false
		end
		local model
		local s = rng:NextNumber(1, 2.1) * (1 - hit.Position.Y / 400) -- smaller trees higher up
		local r = rng:NextNumber()
		if r < 0.38 then
			model = ModelFactory.pine(rng, s)
		elseif r < 0.8 then
			model = ModelFactory.spruce(rng, s * 1.1)
		else
			model = ModelFactory.birch(rng, s * 0.8)
		end
		model:PivotTo(CFrame.new(hit.Position - Vector3.new(0, 0.4, 0)) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0))
		model.Parent = folder
		return true
	end

	-- Forests grow in patches: noise decides where the woods are dense.
	local planted, tries = 0, 0
	local budget = os.clock()
	while planted < 950 and tries < 9000 do
		tries += 1
		local x, z = rng:NextNumber(MIN_X, MAX_X), rng:NextNumber(MIN_Z + 40, 640)
		local density = fbm(x, z, 1 / 220, 3, 29) + 0.15
		if z > FLAT_MAX_Z - 30 and z < FLAT_MAX_Z + 40 and x > FLAT_MIN_X and x < FLAT_MAX_X then
			density -= 0.35 -- keep the deer meadow open
		end
		if rng:NextNumber() < density * 2 and plant(x, z) then
			planted += 1
		end
		if os.clock() - budget > 0.05 then
			if RunService:IsRunning() then
				task.wait()
			end
			budget = os.clock()
		end
	end

	-- understory: ferns and junipers where the woods are
	local under = 0
	tries = 0
	while under < 450 and tries < 4000 do
		tries += 1
		local x, z = rng:NextNumber(MIN_X, MAX_X), rng:NextNumber(-30, 560)
		if fbm(x, z, 1 / 220, 3, 29) + 0.15 > 0.05 and not inPlotArea(x, z) and not inRivalArea(x, z) then
			local hit = groundAt(x, z)
			if hit and treeMaterials[hit.Material] and hit.Normal.Y > 0.8 and hit.Position.Y < 110 and hit.Position.Y > 1.5 then
				local model = rng:NextNumber() < 0.6 and ModelFactory.fern(rng) or ModelFactory.juniper(rng)
				model:PivotTo(CFrame.new(hit.Position - Vector3.new(0, 0.2, 0)) * CFrame.Angles(0, rng:NextNumber(0, 6), 0))
				model.Parent = folder
				under += 1
			end
		end
		if os.clock() - budget > 0.05 then
			if RunService:IsRunning() then
				task.wait()
			end
			budget = os.clock()
		end
	end

	-- loose boulders
	for _ = 1, 70 do
		local x, z = rng:NextNumber(MIN_X, MAX_X), rng:NextNumber(-60, 500)
		if not inPlotArea(x, z) and not inRivalArea(x, z) then
			local hit = groundAt(x, z)
			if hit and hit.Position.Y < 80 and hit.Material ~= M.Water then
				local model = ModelFactory.boulder(rng, rng:NextNumber(1, 2.6))
				model:PivotTo(CFrame.new(hit.Position) * CFrame.Angles(0, rng:NextNumber(0, 6), 0))
				model.Parent = folder
			end
		end
	end

	-- the shoreline: find where the land meets the water and line it with
	-- foam (animated on the client) and half-sunk rocks
	local foamFolder = Instance.new("Folder")
	foamFolder.Name = "ShoreFoam"
	local function shoreAt(x: number, fromZ: number, toZ: number, step: number): number?
		local wasDry = heightAt(x, fromZ) > 0.2
		for z = fromZ, toZ, step do
			local dry = heightAt(x, z) > 0.2
			if dry ~= wasDry then
				return z
			end
			wasDry = dry
		end
		return nil
	end
	for x = MIN_X + 6, MAX_X - 6, 9 do
		for _, scan in { { SHORE_Z + 10, SHORE_Z - 200, -2 }, { MIN_Z + 20, -480, 3 } } do
			local z = shoreAt(x, scan[1], scan[2], scan[3])
			if z then
				for layer = 0, 1 do
					local foam = Instance.new("Part")
					foam.Name = "Foam"
					foam.Anchored = true
					foam.CanCollide = false
					foam.CanQuery = false
					foam.CastShadow = false
					foam.Material = Enum.Material.SmoothPlastic
					foam.Color = Color3.fromRGB(236, 242, 240)
					foam.Transparency = 0.55 + layer * 0.2
					foam.Size = Vector3.new(10.5, 0.1, 1.6 + layer * 2.5)
					foam.CFrame = CFrame.new(x, 0.06 + layer * 0.02, z + (scan[3] < 0 and -1 or 1) * (1 + layer * 2.2))
						* CFrame.Angles(0, rng:NextNumber(-0.12, 0.12), 0)
					foam.Parent = foamFolder
				end
				if rng:NextNumber() < 0.22 and not (x > FLAT_MIN_X and x < FLAT_MAX_X and scan[3] < 0 and rng:NextNumber() < 0.6) then
					local rock = ModelFactory.boulder(rng, rng:NextNumber(1.2, 2.8))
					rock:PivotTo(CFrame.new(x + rng:NextNumber(-4, 4), -1.2, z + rng:NextNumber(-3, 3)) * CFrame.Angles(0, rng:NextNumber(0, 6), 0))
					rock.Parent = folder
				end
			end
		end
	end
	foamFolder.Parent = workspace

	-- a jetty on the fjord in front of every plot, some with a longship
	local sails = { Color3.fromRGB(160, 40, 36), Color3.fromRGB(46, 70, 120), Color3.fromRGB(150, 120, 50) }
	for i = 1, Config.MAX_PLOTS do
		local o = Grid.plotOrigin(i)
		local dockX = o.X + Grid.PLOT_SIZE * 0.25
		local dock = ModelFactory.dock(48)
		dock:PivotTo(CFrame.new(dockX, 0, -34))
		dock.Parent = folder
		if i % 2 == 1 then
			local ship = ModelFactory.longship(40, sails[(i // 2) % #sails + 1])
			ship:PivotTo(CFrame.new(dockX + 9, 0, -62) * CFrame.Angles(0, math.rad(rng:NextNumber(-4, 4)), 0))
			ship.Parent = folder
		end
		-- torches lighting the path at each corner of the plot
		for _, x in { o.X + 2, o.X + Grid.PLOT_SIZE - 2 } do
			local torch = Instance.new("Model")
			torch.Name = "Torch"
			local pole = ModelFactory.addPart(torch, {
				Size = Vector3.new(0.5, 6, 0.5),
				Position = Vector3.new(x, TOP + 3, -2),
				Color = ModelFactory.Colors.DarkWood,
			})
			local flame = ModelFactory.addPart(torch, {
				Size = Vector3.new(0.7, 0.7, 0.7),
				Position = pole.Position + Vector3.new(0, 3.3, 0),
				Color = Color3.fromRGB(255, 140, 50),
				Material = Enum.Material.Neon,
				CanCollide = false,
			})
			local fire = Instance.new("Fire")
			fire.Size = 1.6
			fire.Heat = 5
			fire.Parent = flame
			local light = Instance.new("PointLight")
			light.Color = Color3.fromRGB(255, 150, 70)
			light.Range = 18
			light.Brightness = 1.6
			light.Parent = flame
			torch.Parent = folder
		end
	end
end

-- A trading longship that sails slowly up and down the fjord forever.
local function sailingShip()
	local ship = ModelFactory.longship(48, Color3.fromRGB(150, 40, 36))
	ship.Name = "TradingShip"
	ship.Parent = workspace:FindFirstChild("Scenery") or workspace
	local z = -300
	local x0, x1 = MIN_X + 200, MAX_X - 200
	task.spawn(function()
		local dir = 1
		local x = x0
		local speed = 9
		while ship.Parent do
			local dt = task.wait(1 / 20)
			x += dir * speed * dt
			if x > x1 or x < x0 then
				dir = -dir
				x = math.clamp(x, x0, x1)
			end
			local bob = math.sin(os.clock() * 0.8) * 0.25
			local roll = math.sin(os.clock() * 0.6) * math.rad(2)
			local heading = dir > 0 and -math.pi / 2 or math.pi / 2
			ship:PivotTo(CFrame.new(x, bob, z + math.sin(x / 300) * 60) * CFrame.Angles(0, heading, 0) * CFrame.Angles(0, 0, roll))
		end
	end)
end

-- Day and night: a full day takes DAY_SECONDS, nights pass faster.
local DAY_SECONDS = 480
local function dayNightCycle()
	local grade = Lighting:FindFirstChildOfClass("ColorCorrectionEffect")
	local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")
	local t = (15.6 - 6) / 14 * (DAY_SECONDS * 0.75) -- start in the afternoon
	while true do
		local dt = task.wait(0.1)
		t = (t + dt) % DAY_SECONDS
		local dayPart = DAY_SECONDS * 0.75
		local clock
		if t < dayPart then
			clock = 6 + 14 * (t / dayPart) -- 06:00 to 20:00
		else
			clock = (20 + 10 * ((t - dayPart) / (DAY_SECONDS - dayPart))) % 24 -- 20:00 to 06:00
		end
		Lighting.ClockTime = clock
		-- 0 at midday, 1 deep at night
		local night = 0
		if clock >= 18.5 or clock < 6.5 then
			local h = clock >= 18.5 and clock - 18.5 or clock + 5.5
			night = math.clamp(math.min(h, 12 - h) / 1.5, 0, 1)
		end
		local golden = math.clamp(1 - math.abs(clock - 18) / 2, 0, 1) + math.clamp(1 - math.abs(clock - 7) / 1.5, 0, 1)
		local season = workspace:GetAttribute("Season")
		local seasonTint = Color3.fromRGB(255, 244, 228)
		if season == "Winter" then
			seasonTint = Color3.fromRGB(222, 234, 255)
		elseif season == "Autumn" then
			seasonTint = Color3.fromRGB(255, 230, 196)
		elseif season == "Spring" then
			seasonTint = Color3.fromRGB(246, 255, 236)
		end
		if grade then
			grade.TintColor = seasonTint:Lerp(Color3.fromRGB(255, 205, 160), golden * 0.6):Lerp(Color3.fromRGB(170, 190, 255), night)
			grade.Brightness = 0.02 + night * 0.05
		end
		if atmosphere then
			atmosphere.Color = Color3.fromRGB(200, 190, 170):Lerp(Color3.fromRGB(230, 170, 120), golden * 0.5):Lerp(Color3.fromRGB(70, 80, 110), night)
			atmosphere.Haze = 1.7 + golden * 0.8 - night * 0.6
		end
		Lighting.OutdoorAmbient = Color3.fromRGB(128, 122, 114):Lerp(Color3.fromRGB(60, 66, 92), night)
	end
end

local function setupLighting()
	for _, child in Lighting:GetChildren() do
		if child:IsA("Sky") or child:IsA("Atmosphere") or child:IsA("PostEffect") then
			child:Destroy()
		end
	end

	Lighting.ClockTime = 15.6
	Lighting.GeographicLatitude = 58
	Lighting.Brightness = 3
	Lighting.Ambient = Color3.fromRGB(58, 60, 68)
	Lighting.OutdoorAmbient = Color3.fromRGB(128, 122, 114)
	Lighting.EnvironmentDiffuseScale = 1
	Lighting.EnvironmentSpecularScale = 0.6
	Lighting.ShadowSoftness = 0.25
	Lighting.GlobalShadows = true

	local atmosphere = Instance.new("Atmosphere")
	atmosphere.Density = 0.38
	atmosphere.Offset = 0.3
	atmosphere.Color = Color3.fromRGB(200, 190, 170)
	atmosphere.Decay = Color3.fromRGB(96, 106, 122)
	atmosphere.Glare = 0.35
	atmosphere.Haze = 1.7
	atmosphere.Parent = Lighting

	local sky = Instance.new("Sky")
	sky.SunAngularSize = 14
	sky.Parent = Lighting

	local grade = Instance.new("ColorCorrectionEffect")
	grade.Brightness = 0.02
	grade.Contrast = 0.14
	grade.Saturation = 0.08
	grade.TintColor = Color3.fromRGB(255, 244, 228)
	grade.Parent = Lighting

	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.5
	bloom.Size = 24
	bloom.Threshold = 0.9
	bloom.Parent = Lighting

	local clouds = Terrain:FindFirstChildOfClass("Clouds") or Instance.new("Clouds")
	clouds.Cover = 0.55
	clouds.Density = 0.55
	clouds.Color = Color3.fromRGB(245, 240, 232)
	clouds.Parent = Terrain

	-- a gentle cinematic blur on the far distance
	local dof = Instance.new("DepthOfFieldEffect")
	dof.FarIntensity = 0.12
	dof.NearIntensity = 0
	dof.FocusDistance = 140
	dof.InFocusRadius = 180
	dof.Parent = Lighting

	local rays = Instance.new("SunRaysEffect")
	rays.Intensity = 0.05
	rays.Spread = 0.7
	rays.Parent = Lighting
end

local function clearPlaceholders()
	-- The flat Baseplate and welcome sign are only there so the place isn't
	-- empty in edit mode; the real world replaces them.
	for _, name in { "Baseplate", "WelcomeSign" } do
		local old = workspace:FindFirstChild(name)
		if old then
			old:Destroy()
		end
	end
end

function WorldService:Init()
	clearPlaceholders()
	if workspace:GetAttribute("WorldBaked") then
		-- The valley was saved into the place (see Bake), so whatever you
		-- changed in Studio is kept: nothing is regenerated.
		print("[WorldService] using the saved valley")
		return
	end
	setupLighting()
	buildTerrain()
	scatterScenery()
	print("[WorldService] valley built")
end

-- Builds the valley in Studio edit mode, so it is saved in the place file
-- and can be edited by hand. Run through EditTools.Setup().
function WorldService:Bake()
	clearPlaceholders()
	for _, name in { "Scenery", "ShoreFoam" } do
		local old = workspace:FindFirstChild(name)
		if old then
			old:Destroy()
		end
	end
	Terrain:Clear()
	setupLighting()
	buildTerrain()
	scatterScenery()
	workspace:SetAttribute("WorldBaked", true)
end

function WorldService:Start()
	sailingShip()
	dayNightCycle()
end

-- Height of the terrain at x, z (used by wildlife).
function WorldService:GroundHeight(x: number, z: number): number
	local hit = groundAt(x, z)
	return hit and hit.Position.Y or TOP
end

return WorldService
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="31">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="32">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="33">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[--[[
	Client entry point.
	Loads every ModuleScript in the Controllers folder, then calls :Init()
	and :Start() on each, the same pattern as the server.
]]

local controllersFolder = script:WaitForChild("Controllers")

local controllers = {}
for _, module in controllersFolder:GetChildren() do
	if module:IsA("ModuleScript") then
		controllers[module.Name] = require(module)
	end
end

for _, controller in controllers do
	if controller.Init then
		controller:Init(controllers)
	end
end

for _, controller in controllers do
	if controller.Start then
		task.spawn(function()
			controller:Start()
		end)
	end
end
]]></string>
        </Properties>
        <Item class="Folder" referent="34">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="35">
            <Properties>
              <string name="Name">AmbienceController</string>
              <string name="Source"><![CDATA[--[[
	AmbienceController
	Little touches of life that only need to run on your screen:
	  - shoreline foam gently washes in and out
	  - gulls circle lazily over the fjord
]]

local RunService = game:GetService("RunService")

local AmbienceController = {}

local GULLS = 14

local function makeGull(): Model
	local model = Instance.new("Model")
	model.Name = "Gull"
	local body = Instance.new("Part")
	body.Name = "Body"
	body.Anchored = true
	body.CanCollide = false
	body.CanQuery = false
	body.CastShadow = false
	body.Size = Vector3.new(0.5, 0.45, 1.4)
	body.Color = Color3.fromRGB(240, 240, 236)
	body.Parent = model
	for _, side in { -1, 1 } do
		local wing = Instance.new("Part")
		wing.Name = side < 0 and "WingL" or "WingR"
		wing.Anchored = true
		wing.CanCollide = false
		wing.CanQuery = false
		wing.CastShadow = false
		wing.Size = Vector3.new(2.2, 0.08, 0.7)
		wing.Color = Color3.fromRGB(225, 228, 230)
		wing.Parent = model
	end
	model.PrimaryPart = body
	return model
end

function AmbienceController:Start()
	-- Wait for the server to finish building the shore.
	local foamFolder = workspace:WaitForChild("ShoreFoam", 120)
	local foam = {}
	if foamFolder then
		for _, part in foamFolder:GetChildren() do
			if part:IsA("BasePart") then
				table.insert(foam, { part = part, base = part.CFrame, alpha = part.Transparency, phase = math.random() * math.pi * 2 })
			end
		end
	end

	local folder = Instance.new("Folder")
	folder.Name = "Gulls"
	folder.Parent = workspace
	local gulls = {}
	for i = 1, GULLS do
		local model = makeGull()
		model.Parent = folder
		gulls[i] = {
			model = model,
			center = Vector3.new(math.random(-200, 1800), math.random(28, 60), math.random(-360, -90)),
			radius = math.random(30, 90),
			speed = (math.random() * 0.15 + 0.1) * (math.random() < 0.5 and -1 or 1),
			angle = math.random() * math.pi * 2,
			flap = math.random() * 10,
		}
	end

	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		local now = os.clock()

		for _, g in gulls do
			g.angle += g.speed * dt
			local pos = g.center + Vector3.new(math.cos(g.angle) * g.radius, math.sin(now * 0.4 + g.flap) * 3, math.sin(g.angle) * g.radius)
			local ahead = g.center + Vector3.new(math.cos(g.angle + 0.05 * math.sign(g.speed)) * g.radius, 0, math.sin(g.angle + 0.05 * math.sign(g.speed)) * g.radius)
			local cf = CFrame.lookAt(pos, Vector3.new(ahead.X, pos.Y, ahead.Z)) * CFrame.Angles(0, 0, math.sign(g.speed) * 0.35)
			local flap = math.sin(now * 6 + g.flap) * 0.5
			local model = g.model
			model.Body.CFrame = cf
			model.WingL.CFrame = cf * CFrame.new(-0.25, 0, 0) * CFrame.Angles(0, 0, -flap) * CFrame.new(-1.1, 0, 0)
			model.WingR.CFrame = cf * CFrame.new(0.25, 0, 0) * CFrame.Angles(0, 0, flap) * CFrame.new(1.1, 0, 0)
		end

		-- foam only needs ~15 updates a second
		accumulator += dt
		if accumulator < 1 / 15 then
			return
		end
		accumulator = 0
		local camPos = workspace.CurrentCamera.CFrame.Position
		for _, f in foam do
			if (f.base.Position - camPos).Magnitude > 450 then
				continue -- too far away to notice
			end
			local wave = math.sin(now * 0.9 + f.phase)
			f.part.Transparency = math.clamp(f.alpha + wave * 0.18, 0, 0.97)
			f.part.CFrame = f.base * CFrame.new(0, 0, wave * 0.6)
		end
	end)
end

return AmbienceController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="36">
            <Properties>
              <string name="Name">AudioController</string>
              <string name="Source"><![CDATA[--[[
	AudioController
	Background sound on your own screen: music, wind, birds by day and the
	sea getting louder as you walk down to the fjord. Which sounds play is
	set in ReplicatedStorage > Shared > Sounds.
]]

local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Sounds = require(Shared.Sounds)

local AudioController = {}

function AudioController:Start()
	local folder = Instance.new("Folder")
	folder.Name = "Ambience"
	folder.Parent = SoundService
	local music = Sounds.loop("Music", folder)
	local wind = Sounds.loop("Wind", folder)
	local birds = Sounds.loop("Birds", folder)
	local waves = Sounds.loop("Waves", folder)
	local base = {}
	for _, s in { music, wind, birds, waves } do
		if s then
			base[s] = s.Volume
		end
	end

	local camera = workspace.CurrentCamera
	RunService.Heartbeat:Connect(function()
		local pos = camera and camera.CFrame.Position or Vector3.zero
		if waves then
			-- the shore starts around z = -40; full volume out on the water
			local t = math.clamp((40 - pos.Z) / 120, 0.1, 1)
			waves.Volume = base[waves] * t
		end
		if birds then
			local hour = Lighting.ClockTime
			local day = (hour > 6 and hour < 19) and 1 or 0
			if workspace:GetAttribute("Season") == "Winter" then
				day *= 0.2
			end
			birds.Volume += (base[birds] * day - birds.Volume) * 0.02
		end
		if wind then
			-- windier up high and in winter
			local t = math.clamp(0.6 + pos.Y / 200, 0.6, 1.6) * (workspace:GetAttribute("Season") == "Winter" and 1.4 or 1)
			wind.Volume = base[wind] * t
		end
	end)
end

return AudioController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="37">
            <Properties>
              <string name="Name">BoatController</string>
              <string name="Source"><![CDATA[--[[
	BoatController
	While you sit at a boat's helm, sends your W/A/S/D (or arrow keys) to the
	server, which moves the boat. F looses a volley of arrows.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Remotes = require(Shared.Remotes)

local BoatController = {}

local player = Players.LocalPlayer

local function down(...)
	for _, key in { ... } do
		if UserInputService:IsKeyDown(key) then
			return true
		end
	end
	return false
end

local function atHelm(): boolean
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local seat = humanoid and humanoid.SeatPart
	return seat ~= nil and seat:GetAttribute("Boat") == true
end

function BoatController:Start()
	UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and input.KeyCode == Enum.KeyCode.F and atHelm() then
			Remotes.BoatFire:FireServer()
		end
	end)

	local last = { 0, 0 }
	local timer = 0
	RunService.Heartbeat:Connect(function(dt)
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local seat = humanoid and humanoid.SeatPart
		if not seat or not seat:GetAttribute("Boat") then
			return
		end
		if UserInputService:GetFocusedTextBox() then
			return
		end
		local K = Enum.KeyCode
		local throttle = (down(K.W, K.Up) and 1 or 0) - (down(K.S, K.Down) and 1 or 0)
		local steer = (down(K.D, K.Right) and 1 or 0) - (down(K.A, K.Left) and 1 or 0)
		timer += dt
		if throttle ~= last[1] or steer ~= last[2] or timer > 0.5 then
			timer = 0
			last = { throttle, steer }
			Remotes.BoatInput:FireServer(throttle, steer)
		end
	end)
end

return BoatController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="38">
            <Properties>
              <string name="Name">BuildController</string>
              <string name="Source"><![CDATA[--[[
	BuildController
	Placement mode: shows a see-through preview of the chosen building that
	snaps to your plot's grid. Green = you can build there, red = you can't.
	Click to build, R to rotate, Q to cancel.

	Demolish mode: hover one of your buildings (it turns red) and click.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Grid = require(Shared.Grid)
local Remotes = require(Shared.Remotes)
local ModelFactory = require(Shared.ModelFactory)

local BuildController = {}

local modeChanged = Instance.new("BindableEvent")
BuildController.ModeChanged = modeChanged.Event

local player = Players.LocalPlayer
local controllers

local mode = nil -- nil | { kind = "place", type = string } | { kind = "demolish" }
local rot = 0
local ghost: Model? = nil
local highlight: Highlight
local current = nil -- placement candidate { cx, cz, ok } or demolish target model
local busy = false

local GOOD = Color3.fromRGB(90, 220, 110)
local BAD = Color3.fromRGB(235, 80, 70)

local function plotGround(): BasePart?
	local index = player:GetAttribute("PlotIndex")
	local plots = workspace:FindFirstChild("Plots")
	local plot = index and plots and plots:FindFirstChild("Plot_" .. index)
	return plot and plot:FindFirstChild("Ground")
end

local function mouseRay(): (Vector3, Vector3)
	local camera = workspace.CurrentCamera
	local pos = UserInputService:GetMouseLocation()
	local ray = camera:ViewportPointToRay(pos.X, pos.Y)
	return ray.Origin, ray.Direction * 1000
end

local function clearGhost()
	if ghost then
		ghost:Destroy()
		ghost = nil
	end
	highlight.Adornee = nil
	current = nil
end

-- Faint grid lines over your plot while you are placing something.
local gridLines: Folder? = nil
local function showGrid(visible: boolean)
	if gridLines then
		gridLines:Destroy()
		gridLines = nil
	end
	local origin = player:GetAttribute("PlotOrigin")
	if not visible or not origin then
		return
	end
	gridLines = Instance.new("Folder")
	gridLines.Name = "BuildGrid"
	local size = Grid.PLOT_SIZE
	for i = 0, Config.PLOT_CELLS do
		for axis = 1, 2 do
			local line = Instance.new("Part")
			line.Anchored = true
			line.CanCollide = false
			line.CanQuery = false
			line.CastShadow = false
			line.Material = Enum.Material.Neon
			line.Color = Color3.fromRGB(255, 236, 190)
			line.Transparency = 0.82
			local offset = i * Config.CELL
			if axis == 1 then
				line.Size = Vector3.new(0.12, 0.05, size)
				line.Position = origin + Vector3.new(offset, 0.08, size / 2)
			else
				line.Size = Vector3.new(size, 0.05, 0.12)
				line.Position = origin + Vector3.new(size / 2, 0.08, offset)
			end
			line.Parent = gridLines
		end
	end
	gridLines.Parent = workspace
end

local function setMode(newMode)
	clearGhost()
	mode = newMode
	showGrid(mode ~= nil and mode.kind == "place")
	if mode and mode.kind == "place" then
		ghost = ModelFactory.building(mode.type)
		ModelFactory.makeGhost(ghost)
		ghost.Parent = workspace
		highlight.Adornee = ghost
	end
	modeChanged:Fire(mode)
end

function BuildController:SelectBuild(buildingType: string)
	if mode and mode.type == buildingType then
		setMode(nil) -- clicking the same button again cancels
	else
		setMode({ kind = "place", type = buildingType })
	end
end

function BuildController:SelectDemolish()
	if mode and mode.kind == "demolish" then
		setMode(nil)
	else
		setMode({ kind = "demolish" })
	end
end

function BuildController:Cancel()
	setMode(nil)
end

local function updatePlacement()
	local ground = plotGround()
	local origin = player:GetAttribute("PlotOrigin")
	if not ground or not origin or not ghost then
		return
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { ground }
	local from, dir = mouseRay()
	local hit = workspace:Raycast(from, dir, params)
	if not hit then
		ghost.Parent = nil
		current = nil
		return
	end
	ghost.Parent = workspace

	local sx, sz = Grid.footprint(mode.type, rot)
	local cx, cz = Grid.worldToCell(origin, hit.Position, sx, sz)
	-- keep the preview inside the plot so it doesn't jump off the edge
	cx = math.clamp(cx, 0, Config.PLOT_CELLS - sx)
	cz = math.clamp(cz, 0, Config.PLOT_CELLS - sz)

	local state = controllers.StateController.State
	local free = Grid.canPlace(controllers.StateController.Blocked, cx, cz, sx, sz)
	local affordable = state ~= nil and Grid.canAfford(state.resources, Config.Buildings[mode.type].Cost)
	local ok = free and affordable

	ghost:PivotTo(Grid.buildingCFrame(origin, cx, cz, sx, sz, rot))
	highlight.FillColor = ok and GOOD or BAD
	highlight.OutlineColor = ok and GOOD or BAD
	current = { cx = cx, cz = cz, ok = ok, affordable = affordable }
end

local function findOwnBuilding(inst: Instance?): Model?
	while inst and inst ~= workspace do
		if inst:IsA("Model") and inst:GetAttribute("BuildingId") then
			if inst:GetAttribute("OwnerUserId") == player.UserId then
				return inst
			end
			return nil
		end
		inst = inst.Parent
	end
	return nil
end

local function updateDemolish()
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { player.Character }
	local from, dir = mouseRay()
	local hit = workspace:Raycast(from, dir, params)
	local target = hit and findOwnBuilding(hit.Instance)
	current = target
	highlight.Adornee = target
	highlight.FillColor = BAD
	highlight.OutlineColor = BAD
end

local function confirm()
	if busy or not mode then
		return
	end
	local StateController = controllers.StateController
	if mode.kind == "place" then
		if not current then
			return
		end
		if not current.affordable then
			StateController:LocalNotify("Not enough resources for " .. Config.Buildings[mode.type].Display, "bad")
			return
		end
		if not current.ok then
			StateController:LocalNotify("Can't build there. Clear trees and rocks first.", "bad")
			return
		end
		busy = true
		local ok, msg = Remotes.PlaceBuilding:InvokeServer(mode.type, current.cx, current.cz, rot)
		busy = false
		StateController:LocalNotify(msg, ok and "good" or "bad")
		-- stay in placement mode so you can place several in a row
	elseif mode.kind == "demolish" then
		if not current then
			return
		end
		busy = true
		local ok, msg = Remotes.DemolishBuilding:InvokeServer(current:GetAttribute("BuildingId"))
		busy = false
		StateController:LocalNotify(msg, ok and "good" or "bad")
	end
end

function BuildController:Init(allControllers)
	controllers = allControllers
end

function BuildController:Start()
	highlight = Instance.new("Highlight")
	highlight.Name = "BuildHighlight"
	highlight.FillTransparency = 0.55
	highlight.OutlineTransparency = 0
	highlight.DepthMode = Enum.HighlightDepthMode.Occluded
	highlight.Enabled = false
	-- Parent it to a plain Folder: a Highlight with no Adornee lights up its
	-- parent, and we never want that to be the whole workspace.
	local fx = Instance.new("Folder")
	fx.Name = "ClientBuildFX"
	fx.Parent = workspace
	highlight.Parent = fx
	highlight:GetPropertyChangedSignal("Adornee"):Connect(function()
		highlight.Enabled = highlight.Adornee ~= nil
	end)

	RunService.RenderStepped:Connect(function()
		if not mode then
			return
		end
		if mode.kind == "place" then
			updatePlacement()
		else
			updateDemolish()
		end
	end)

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			confirm()
		elseif input.KeyCode == Enum.KeyCode.R and mode and mode.kind == "place" then
			rot = (rot + 1) % 4
		elseif input.KeyCode == Enum.KeyCode.Q and mode then
			setMode(nil)
		end
	end)
end

return BuildController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="39">
            <Properties>
              <string name="Name">CameraController</string>
              <string name="Source"><![CDATA[--[[
	CameraController
	A city-builder camera that follows your character from high above at an
	angle, like looking down over your village.

	  Mouse wheel        zoom in / out
	  Right mouse drag   turn and tilt the view
	  V                  switch to the normal Roblox camera and back
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local CameraController = {}

local player = Players.LocalPlayer

local enabled = true
local yaw = math.pi -- looking from the lake toward the mountains (+Z)
local pitch = math.rad(48)
local distance = 75
local targetDistance = 75
local focus: Vector3? = nil
local rotating = false

local MIN_DIST, MAX_DIST = 18, 260
local MIN_PITCH, MAX_PITCH = math.rad(15), math.rad(82)

function CameraController:IsEnabled(): boolean
	return enabled
end

function CameraController:Start()
	local camera = workspace.CurrentCamera

	UserInputService.InputBegan:Connect(function(input, processed)
		if input.UserInputType == Enum.UserInputType.MouseButton2 and enabled then
			rotating = true
			UserInputService.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
		elseif input.KeyCode == Enum.KeyCode.V and not processed then
			enabled = not enabled
			if not enabled then
				camera.CameraType = Enum.CameraType.Custom
			end
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton2 then
			rotating = false
			UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		end
	end)
	UserInputService.InputChanged:Connect(function(input, processed)
		if not enabled then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseWheel and not processed then
			targetDistance = math.clamp(targetDistance * (1 - input.Position.Z * 0.12), MIN_DIST, MAX_DIST)
		elseif input.UserInputType == Enum.UserInputType.MouseMovement and rotating then
			yaw -= input.Delta.X * 0.008
			pitch = math.clamp(pitch + input.Delta.Y * 0.006, MIN_PITCH, MAX_PITCH)
		end
	end)

	RunService:BindToRenderStep("VikingCamera", Enum.RenderPriority.Camera.Value + 1, function(dt)
		if not enabled then
			return
		end
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if not root then
			return
		end
		camera.CameraType = Enum.CameraType.Scriptable
		local target = root.Position
		focus = focus and focus:Lerp(target, math.min(1, dt * 8)) or target
		distance += (targetDistance - distance) * math.min(1, dt * 10)
		-- lower the angle a little when zoomed in close, like a tilt-shift view
		local p = pitch - math.rad(18) * (1 - (distance - MIN_DIST) / (MAX_DIST - MIN_DIST)) ^ 3
		camera.CFrame = CFrame.new(focus) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(-p, 0, 0) * CFrame.new(0, 0, distance)
	end)
end

return CameraController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="40">
            <Properties>
              <string name="Name">HudController</string>
              <string name="Source"><![CDATA[--[[
	HudController
	Draws the on-screen interface entirely from code:
	  - resource bar (top left)
	  - colony panel: population, jobs, happiness, day (top right)
	  - build menu with tabs (Housing, Production, ...) and building cards,
	    tooltips and Demolish (bottom centre)
	  - controls help (bottom left, H hides it)
	  - message feed (top centre)
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Grid = require(Shared.Grid)
local Sounds = require(Shared.Sounds)

local HudController = {}

local controllers
local player = Players.LocalPlayer

local THEME = {
	Panel = Color3.fromRGB(34, 28, 22),
	PanelLight = Color3.fromRGB(58, 47, 36),
	Accent = Color3.fromRGB(214, 170, 92),
	Text = Color3.fromRGB(245, 235, 215),
	Muted = Color3.fromRGB(180, 165, 140),
	Good = Color3.fromRGB(130, 200, 110),
	Bad = Color3.fromRGB(230, 100, 90),
}

local RESOURCE_COLORS = {
	Wood = Color3.fromRGB(150, 100, 60),
	Stone = Color3.fromRGB(150, 150, 158),
	Food = Color3.fromRGB(220, 190, 90),
	Hides = Color3.fromRGB(176, 120, 84),
	Silver = Color3.fromRGB(210, 214, 224),
	Lore = Color3.fromRGB(120, 160, 230),
}

local function new(className: string, props, children)
	local inst = Instance.new(className)
	for k, v in props do
		if k ~= "Parent" then
			inst[k] = v
		end
	end
	for _, child in children or {} do
		child.Parent = inst
	end
	if props.Parent then
		inst.Parent = props.Parent
	end
	return inst
end

local function corner(r)
	return new("UICorner", { CornerRadius = UDim.new(0, r or 8) })
end

local function padding(px)
	return new("UIPadding", {
		PaddingLeft = UDim.new(0, px),
		PaddingRight = UDim.new(0, px),
		PaddingTop = UDim.new(0, px),
		PaddingBottom = UDim.new(0, px),
	})
end

local function label(props)
	local defaults = {
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamMedium,
		TextColor3 = THEME.Text,
		TextSize = 16,
		TextXAlignment = Enum.TextXAlignment.Left,
	}
	for k, v in props do
		defaults[k] = v
	end
	return new("TextLabel", defaults)
end

-- thin gold border used on every panel
local function frameStroke()
	return new("UIStroke", { Color = THEME.Accent, Thickness = 1, Transparency = 0.55, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
end

local DEFAULT_HINT = "Pick a tab and a building. Walk up to trees, rocks and bushes and hold E to gather."

local function moodWord(h: number): string
	if h >= 75 then
		return "Joyful"
	elseif h >= 55 then
		return "Content"
	elseif h >= 35 then
		return "Uneasy"
	end
	return "Miserable"
end

function HudController:Init(allControllers)
	controllers = allControllers
end

function HudController:Start()
	local gui = new("ScreenGui", {
		Name = "VikingHud",
		ResetOnSpawn = false,
		IgnoreGuiInset = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})

	---------------------------------------------------------------- resources
	local resBar = new("Frame", {
		Name = "Resources",
		Position = UDim2.fromOffset(12, 12),
		Size = UDim2.fromOffset(0, 44),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = THEME.Panel,
		BackgroundTransparency = 0.08,
		Parent = gui,
	}, {
		corner(10),
		padding(8),
		frameStroke(),
		new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 14), VerticalAlignment = Enum.VerticalAlignment.Center }),
	})

	local resLabels = {}
	for i, name in Config.ResourceOrder do
		local item = new("Frame", { Size = UDim2.fromOffset(122, 28), BackgroundTransparency = 1, LayoutOrder = i, Parent = resBar })
		new("Frame", {
			Size = UDim2.fromOffset(16, 16),
			Position = UDim2.new(0, 0, 0.5, -8),
			BackgroundColor3 = RESOURCE_COLORS[name],
			Parent = item,
		}, { corner(4) })
		resLabels[name] = label({
			Size = UDim2.new(1, -22, 1, 0),
			Position = UDim2.fromOffset(22, 0),
			Text = name .. " 0",
			Parent = item,
		})
	end

	---------------------------------------------------------------- saga (quest guide)
	local saga = new("Frame", {
		Name = "Saga",
		Position = UDim2.fromOffset(12, 64),
		Size = UDim2.fromOffset(300, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = THEME.Panel,
		BackgroundTransparency = 0.12,
		Parent = gui,
	}, {
		corner(10),
		padding(10),
		frameStroke(),
		new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	local sagaHead = label({ Size = UDim2.new(1, 0, 0, 16), Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = THEME.Muted, LayoutOrder = 1, Parent = saga })
	local sagaTitle = label({ Size = UDim2.new(1, 0, 0, 22), Font = Enum.Font.GothamBold, TextSize = 17, TextColor3 = THEME.Accent, LayoutOrder = 2, Parent = saga })
	local sagaText = label({ Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextWrapped = true, TextSize = 14, LayoutOrder = 3, Parent = saga })
	local sagaBar = new("Frame", { Size = UDim2.new(1, 0, 0, 6), BackgroundColor3 = THEME.PanelLight, LayoutOrder = 4, Parent = saga }, { corner(3) })
	local sagaFill = new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = THEME.Good, Parent = sagaBar }, { corner(3) })
	local sagaReward = label({ Size = UDim2.new(1, 0, 0, 16), TextSize = 12, TextColor3 = THEME.Muted, LayoutOrder = 5, Parent = saga })

	---------------------------------------------------------------- colony panel
	local panel = new("Frame", {
		Name = "Colony",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 12),
		Size = UDim2.fromOffset(230, 150),
		BackgroundColor3 = THEME.Panel,
		BackgroundTransparency = 0.08,
		Parent = gui,
	}, {
		corner(10),
		padding(10),
		frameStroke(),
		new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	local dayLabel = label({ Size = UDim2.new(1, 0, 0, 20), Font = Enum.Font.GothamBold, TextColor3 = THEME.Accent, LayoutOrder = 1, Parent = panel })
	local dayBar = new("Frame", { Size = UDim2.new(1, 0, 0, 4), BackgroundColor3 = THEME.PanelLight, LayoutOrder = 2, Parent = panel }, { corner(2) })
	local dayFill = new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = THEME.Accent, Parent = dayBar }, { corner(2) })
	local popLabel = label({ Size = UDim2.new(1, 0, 0, 20), LayoutOrder = 3, Parent = panel })
	local jobLabel = label({ Size = UDim2.new(1, 0, 0, 20), LayoutOrder = 4, TextColor3 = THEME.Muted, TextSize = 14, Parent = panel })
	local moodLabel = label({ Size = UDim2.new(1, 0, 0, 20), LayoutOrder = 5, Parent = panel })
	local warnLabel = label({ Size = UDim2.new(1, 0, 0, 20), LayoutOrder = 6, TextColor3 = THEME.Bad, TextSize = 14, Parent = panel })

	---------------------------------------------------------------- build menu
	--[[
		A row of tabs (Housing, Production, ...) above a row of building
		cards. Click a tab to open it, click it again to fold the menu away.
		Hovering a card shows a tooltip with everything about the building.
	]]
	local CARD_W, CARD_H = 124, 96
	local buildMenu = new("Frame", {
		Name = "BuildMenu",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -12),
		Size = UDim2.fromOffset(0, 0),
		AutomaticSize = Enum.AutomaticSize.XY,
		BackgroundColor3 = THEME.Panel,
		BackgroundTransparency = 0.08,
		Parent = gui,
	}, {
		corner(12),
		padding(8),
		frameStroke(),
		new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, HorizontalAlignment = Enum.HorizontalAlignment.Center }),
	})

	local tabRow = new("Frame", {
		Name = "Tabs",
		Size = UDim2.fromOffset(0, 34),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundTransparency = 1,
		LayoutOrder = 1,
		Parent = buildMenu,
	}, {
		new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
	})

	local cardRow = new("Frame", {
		Name = "Cards",
		Size = UDim2.fromOffset(0, CARD_H),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundTransparency = 1,
		LayoutOrder = 2,
		Parent = buildMenu,
	}, {
		new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
	})

	-- hint line just above the menu
	local hint = label({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 0, -6),
		Size = UDim2.fromOffset(700, 22),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextSize = 15,
		TextStrokeTransparency = 0.4,
		Text = DEFAULT_HINT,
		Parent = gui,
	})
	local function placeHint()
		hint.Position = UDim2.new(0.5, 0, 1, -12 - buildMenu.AbsoluteSize.Y - 6)
	end
	buildMenu:GetPropertyChangedSignal("AbsoluteSize"):Connect(placeHint)
	placeHint()

	-- tooltip that follows the hovered card
	local tooltip = new("Frame", {
		Name = "Tooltip",
		AnchorPoint = Vector2.new(0.5, 1),
		Size = UDim2.fromOffset(260, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = THEME.Panel,
		Visible = false,
		ZIndex = 20,
		Parent = gui,
	}, {
		corner(8),
		padding(10),
		frameStroke(),
		new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	local tipTitle = label({ Size = UDim2.new(1, 0, 0, 22), Font = Enum.Font.GothamBold, TextSize = 17, TextColor3 = THEME.Accent, LayoutOrder = 1, ZIndex = 21, Parent = tooltip })
	local tipBody = label({ Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextWrapped = true, TextSize = 14, LayoutOrder = 2, ZIndex = 21, Parent = tooltip })
	local tipStats = label({ Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextWrapped = true, TextSize = 13, TextColor3 = THEME.Muted, LayoutOrder = 3, ZIndex = 21, Parent = tooltip })
	local tipCost = label({ Size = UDim2.new(1, 0, 0, 18), TextSize = 14, Font = Enum.Font.GothamBold, LayoutOrder = 4, ZIndex = 21, Parent = tooltip })

	local lastState = nil
	local known = {}

	local function statsText(def): string
		local bits = {}
		if def.Housing then
			table.insert(bits, "Homes for " .. def.Housing)
		end
		if def.Workers then
			table.insert(bits, def.Workers .. (def.Workers == 1 and " job" or " jobs"))
		end
		for res, rate in def.Produces or {} do
			table.insert(bits, string.format("+%.2g %s/s per worker", rate, res))
		end
		if def.Storage then
			table.insert(bits, "+" .. def.Storage .. " storage")
		end
		if def.Happiness then
			table.insert(bits, "+" .. def.Happiness .. " happiness")
		end
		table.insert(bits, def.Size[1] .. "x" .. def.Size[2] .. " tiles")
		return table.concat(bits, "  ·  ")
	end

	local function shortStat(def): string
		if def.Housing then
			return def.Housing .. " homes"
		elseif def.Produces then
			local res = next(def.Produces)
			return res .. ", " .. def.Workers .. (def.Workers == 1 and " job" or " jobs")
		elseif def.Storage then
			return "+" .. def.Storage .. " storage"
		elseif def.Happiness then
			return "+" .. def.Happiness .. " happiness"
		end
		return def.Size[1] .. "x" .. def.Size[2]
	end

	local function showTooltip(buildingType: string, card: GuiObject)
		local def = Config.Buildings[buildingType]
		tipTitle.Text = (Config.BuildingIcons[buildingType] or "") .. "  " .. def.Display
		tipBody.Text = def.Description
		tipStats.Text = statsText(def)
		if def.Requires and not known[def.Requires] then
			tipCost.Text = "🔒 Research " .. Config.Tech[def.Requires].Name .. " first (T)"
			tipCost.TextColor3 = THEME.Bad
		else
			local affordable = lastState and Grid.canAfford(lastState.resources, def.Cost)
			tipCost.Text = "Cost: " .. Grid.costText(def.Cost)
			tipCost.TextColor3 = affordable and THEME.Good or THEME.Bad
		end
		local pos = card.AbsolutePosition
		tooltip.Position = UDim2.fromOffset(pos.X + card.AbsoluteSize.X / 2, pos.Y - 34)
		tooltip.Visible = true
	end

	local buttons = {}
	local function makeCard(key: string, icon: string, title: string, sub: string, order: number)
		local b = new("TextButton", {
			Name = key,
			Size = UDim2.fromOffset(CARD_W, CARD_H),
			BackgroundColor3 = THEME.PanelLight,
			AutoButtonColor = true,
			Text = "",
			LayoutOrder = order,
			Visible = false,
			Parent = cardRow,
		}, {
			corner(8),
			new("UIGradient", { Rotation = 90, Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(190, 180, 170)) }),
		})
		new("UIStroke", { Name = "Stroke", ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Color = THEME.Accent, Thickness = 2, Enabled = false, Parent = b })
		label({ Name = "Icon", Size = UDim2.new(1, 0, 0, 30), Position = UDim2.fromOffset(0, 4), TextSize = 26, TextXAlignment = Enum.TextXAlignment.Center, Text = icon, Parent = b })
		label({ Size = UDim2.new(1, -6, 0, 18), Position = UDim2.fromOffset(3, 36), Font = Enum.Font.GothamBold, TextSize = 14, TextScaled = true, TextXAlignment = Enum.TextXAlignment.Center, Text = title, Parent = b })
		local statLabel = label({ Name = "Stat", Size = UDim2.new(1, -6, 0, 15), Position = UDim2.fromOffset(3, 56), TextSize = 12, TextColor3 = THEME.Muted, TextXAlignment = Enum.TextXAlignment.Center, Text = "", Parent = b })
		local costLabel = label({ Name = "Cost", Size = UDim2.new(1, -8, 0, 16), Position = UDim2.fromOffset(4, 74), TextSize = 12, TextScaled = true, Font = Enum.Font.GothamBold, TextColor3 = THEME.Muted, TextXAlignment = Enum.TextXAlignment.Center, Text = sub, Parent = b })
		buttons[key] = { button = b, cost = costLabel, stat = statLabel }
		return b
	end

	local BuildController = controllers.BuildController
	local tabs = {}
	local openTab = nil

	local function setTab(index)
		openTab = index
		for i, tab in tabs do
			local active = i == index
			tab.button.BackgroundColor3 = active and THEME.Accent or THEME.PanelLight
			tab.button.TextColor3 = active and THEME.Panel or THEME.Text
			for _, buildingType in tab.buildings do
				buttons[buildingType].button.Visible = active
			end
		end
		cardRow.Visible = index ~= nil
		buttons.Demolish.button.Visible = index ~= nil
		tooltip.Visible = false
	end

	for i, category in Config.BuildCategories do
		local tabButton = new("TextButton", {
			Name = category.Name,
			Size = UDim2.fromOffset(0, 34),
			AutomaticSize = Enum.AutomaticSize.X,
			BackgroundColor3 = THEME.PanelLight,
			Font = Enum.Font.GothamBold,
			TextSize = 15,
			TextColor3 = THEME.Text,
			Text = category.Icon .. "  " .. category.Name,
			LayoutOrder = i,
			Parent = tabRow,
		}, { corner(8), new("UIPadding", { PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 14) }) })
		tabs[i] = { button = tabButton, buildings = category.Buildings }
		tabButton.Activated:Connect(function()
			setTab(openTab ~= i and i or nil)
		end)

		for j, buildingType in category.Buildings do
			local def = Config.Buildings[buildingType]
			local card = makeCard(buildingType, Config.BuildingIcons[buildingType] or "", def.Display, Grid.costText(def.Cost), i * 100 + j)
			buttons[buildingType].stat.Text = shortStat(def)
			card.Activated:Connect(function()
				BuildController:SelectBuild(buildingType)
			end)
			card.MouseEnter:Connect(function()
				showTooltip(buildingType, card)
			end)
			card.MouseLeave:Connect(function()
				tooltip.Visible = false
			end)
		end
	end

	-- Demolish lives at the right end of the tab row, always reachable.
	local demolish = new("TextButton", {
		Name = "Demolish",
		Size = UDim2.fromOffset(0, 34),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = Color3.fromRGB(96, 40, 34),
		Font = Enum.Font.GothamBold,
		TextSize = 15,
		TextColor3 = THEME.Text,
		Text = "🔨  Demolish",
		LayoutOrder = 999,
		Parent = tabRow,
	}, { corner(8), new("UIPadding", { PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 14) }) })
	new("UIStroke", { Name = "Stroke", ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Color = THEME.Accent, Thickness = 2, Enabled = false, Parent = demolish })
	buttons.Demolish = { button = { Visible = true }, stroke = demolish.Stroke }
	demolish.Activated:Connect(function()
		BuildController:SelectDemolish()
	end)
	demolish.MouseEnter:Connect(function()
		hint.Text = "Demolish: tear down one of your buildings and get half its cost back."
	end)

	setTab(1)

	BuildController.ModeChanged:Connect(function(mode)
		for key, entry in buttons do
			local stroke = entry.stroke or entry.button.Stroke
			stroke.Enabled = mode ~= nil and (mode.type == key or (mode.kind == "demolish" and key == "Demolish"))
		end
		if mode == nil then
			hint.Text = DEFAULT_HINT
		elseif mode.kind == "place" then
			hint.Text = "Click to place " .. Config.Buildings[mode.type].Display .. ".  R = rotate,  Q = cancel"
		else
			hint.Text = "Click one of your buildings to tear it down.  Q = cancel"
		end
	end)

	---------------------------------------------------------------- controls help
	local helpOpen = true
	local help = new("Frame", {
		Name = "Controls",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 12, 1, -12),
		Size = UDim2.fromOffset(250, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = THEME.Panel,
		BackgroundTransparency = 0.25,
		Parent = gui,
	}, {
		corner(10),
		padding(10),
		frameStroke(),
		new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	label({ Size = UDim2.new(1, 0, 0, 18), Font = Enum.Font.GothamBold, TextColor3 = THEME.Accent, TextSize = 14, Text = "Controls  (H to hide)", LayoutOrder = 1, Parent = help })
	local helpBody = label({
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		TextSize = 13,
		TextColor3 = THEME.Muted,
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
		LayoutOrder = 2,
		Text = "1 Axe: chop trees\n2 Pickaxe: mine rocks\n3 Bow: click to shoot\n4 Torch: F sets enemy buildings alight\n5 Sword: click to fight\nE: gather, loot, talk\nT: research   M: map size\nRaid Greywater Hold: walk west\nWheel: zoom   Right-drag: turn   V: camera",
		Parent = help,
	})
	game:GetService("UserInputService").InputBegan:Connect(function(input, processed)
		if not processed and input.KeyCode == Enum.KeyCode.H then
			helpOpen = not helpOpen
			helpBody.Visible = helpOpen
		end
	end)

	---------------------------------------------------------------- message feed
	local feed = new("Frame", {
		Name = "Feed",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 12),
		Size = UDim2.fromOffset(460, 200),
		BackgroundTransparency = 1,
		Parent = gui,
	}, {
		new("UIListLayout", { Padding = UDim.new(0, 4), HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	local feedOrder = 0
	local kindColor = { good = THEME.Good, bad = THEME.Bad, gain = THEME.Accent, info = THEME.Text }

	-- a big cinematic title for raid moments
	local raidTitle = label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.3),
		Size = UDim2.fromOffset(900, 60),
		Font = Enum.Font.Fantasy,
		TextSize = 42,
		TextColor3 = Color3.fromRGB(240, 210, 150),
		TextStrokeTransparency = 0.2,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextTransparency = 1,
		TextStrokeColor3 = Color3.fromRGB(40, 10, 6),
		Parent = gui,
	})
	local raidToken = 0
	local function showRaidTitle(text: string)
		raidToken += 1
		local token = raidToken
		raidTitle.Text = text
		raidTitle.TextTransparency = 1
		raidTitle.TextStrokeTransparency = 1
		TweenService:Create(raidTitle, TweenInfo.new(0.6), { TextTransparency = 0, TextStrokeTransparency = 0.2 }):Play()
		task.delay(4, function()
			if token == raidToken then
				TweenService:Create(raidTitle, TweenInfo.new(1.2), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
			end
		end)
	end

	controllers.StateController.Notified:Connect(function(text, kind)
		if kind == "raid" then
			showRaidTitle(text)
			return
		end
		if kind == "quest" then
			Sounds.play("QuestDone")
			showRaidTitle(text)
			return
		end
		feedOrder += 1
		local item = new("TextLabel", {
			Size = UDim2.fromOffset(0, 28),
			AutomaticSize = Enum.AutomaticSize.X,
			BackgroundColor3 = THEME.Panel,
			BackgroundTransparency = 0.15,
			Font = Enum.Font.GothamMedium,
			TextSize = 15,
			TextColor3 = kindColor[kind] or THEME.Text,
			Text = text,
			LayoutOrder = feedOrder,
			Parent = feed,
		}, { corner(6), new("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) }), frameStroke() })
		-- fade and grow in
		item.TextTransparency = 1
		item.BackgroundTransparency = 1
		local grow = new("UIScale", { Scale = 0.85, Parent = item })
		TweenService:Create(item, TweenInfo.new(0.25), { TextTransparency = 0, BackgroundTransparency = 0.15 }):Play()
		TweenService:Create(grow, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Scale = 1 }):Play()
		-- keep at most 5 messages
		local items = {}
		for _, c in feed:GetChildren() do
			if c:IsA("TextLabel") then
				table.insert(items, c)
			end
		end
		table.sort(items, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		for i = 1, #items - 5 do
			items[i]:Destroy()
		end
		task.delay(kind == "gain" and 1.5 or 5, function()
			if item.Parent then
				local stroke = item:FindFirstChildOfClass("UIStroke")
				if stroke then
					TweenService:Create(stroke, TweenInfo.new(0.5), { Transparency = 1 }):Play()
				end
				local t = TweenService:Create(item, TweenInfo.new(0.5), { TextTransparency = 1, BackgroundTransparency = 1 })
				t:Play()
				t.Completed:Wait()
				item:Destroy()
			end
		end)
	end)

	---------------------------------------------------------------- updates
	local lastValues = {}
	controllers.StateController.Changed:Connect(function(state)
		for _, name in Config.ResourceOrder do
			local value = state.resources[name] or 0
			local resLabel = resLabels[name]
			resLabel.Text = string.format("%s %d/%d", name, value, state.storage)
			-- flash green when it goes up, red when it goes down
			local before = lastValues[name]
			if before and value ~= before and math.abs(value - before) >= 1 then
				resLabel.TextColor3 = value > before and THEME.Good or THEME.Bad
				TweenService:Create(resLabel, TweenInfo.new(0.8), { TextColor3 = value >= state.storage and THEME.Accent or THEME.Text }):Play()
			elseif value >= state.storage then
				resLabel.TextColor3 = THEME.Accent -- full: build a storehouse
			end
			lastValues[name] = value
		end
		dayLabel.Text = "Day " .. state.day .. "  ·  " .. (state.season or "")
		dayFill.Size = UDim2.fromScale(math.clamp(state.dayProgress, 0, 1), 1)
		popLabel.Text = string.format("Population %d / %d homes", state.population, state.housing)
		jobLabel.Text = string.format("%d working, %d idle, %d children", state.workers, state.idle, state.children)
		moodLabel.Text = string.format("Happiness %d (%s)", state.happiness, moodWord(state.happiness))
		moodLabel.TextColor3 = state.happiness >= 55 and THEME.Good or (state.happiness >= 35 and THEME.Text or THEME.Bad)
		if state.starving then
			warnLabel.Text = "Starving! Get food fast."
		elseif state.population > state.housing then
			warnLabel.Text = "Not enough housing!"
		elseif state.idle > 0 then
			warnLabel.Text = "Idle villagers: build workplaces."
			warnLabel.TextColor3 = THEME.Muted
		else
			warnLabel.Text = ""
		end
		if state.starving or state.population > state.housing then
			warnLabel.TextColor3 = THEME.Bad
		end

		lastState = state
		local q = state.quest
		if q then
			if q.done then
				sagaHead.Text = "SAGA COMPLETE"
				sagaTitle.Text = "Your name will be sung"
				sagaText.Text = "Every goal is done. Keep growing, raiding and sailing!"
				sagaFill.Size = UDim2.fromScale(1, 1)
				sagaReward.Text = ""
			else
				sagaHead.Text = string.format("SAGA  %d / %d", q.index, q.total)
				sagaTitle.Text = q.title
				sagaText.Text = q.text
				sagaFill.Size = UDim2.fromScale(math.clamp(q.have / q.goal, 0, 1), 1)
				sagaReward.Text = string.format("%d / %d   ·   Reward: %s", q.have, q.goal, q.reward)
			end
		end
		table.clear(known)
		for _, id in state.tech or {} do
			known[id] = true
		end
		for _, buildingType in Config.BuildOrder do
			local def = Config.Buildings[buildingType]
			local entry = buttons[buildingType]
			if def.Requires and not known[def.Requires] then
				entry.cost.Text = "🔒 " .. Config.Tech[def.Requires].Name
				entry.cost.TextColor3 = THEME.Muted
				entry.button.BackgroundTransparency = 0.55
			else
				entry.cost.Text = Grid.costText(def.Cost)
				entry.button.BackgroundTransparency = 0
				local affordable = Grid.canAfford(state.resources, def.Cost)
				entry.cost.TextColor3 = affordable and THEME.Good or THEME.Bad
			end
		end
	end)
end

return HudController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="41">
            <Properties>
              <string name="Name">LoadingController</string>
              <string name="Source"><![CDATA[--[[
	LoadingController
	Shows a title card while the server shapes the valley and settles your
	people, then fades it away once your colony arrives.
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local LoadingController = {}

local controllers

function LoadingController:Init(allControllers)
	controllers = allControllers
end

function LoadingController:Start()
	local gui = Instance.new("ScreenGui")
	gui.Name = "Loading"
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 100
	gui.ResetOnSpawn = false

	local bg = Instance.new("Frame")
	bg.Size = UDim2.fromScale(1, 1)
	bg.BackgroundColor3 = Color3.fromRGB(20, 18, 16)
	bg.Parent = gui

	local gradient = Instance.new("UIGradient")
	gradient.Color = ColorSequence.new(Color3.fromRGB(46, 52, 58), Color3.fromRGB(18, 16, 14))
	gradient.Rotation = 90
	gradient.Parent = bg

	local title = Instance.new("TextLabel")
	title.AnchorPoint = Vector2.new(0.5, 0.5)
	title.Position = UDim2.fromScale(0.5, 0.42)
	title.Size = UDim2.fromOffset(700, 90)
	title.BackgroundTransparency = 1
	title.Font = Enum.Font.Fantasy
	title.TextScaled = true
	title.TextColor3 = Color3.fromRGB(232, 206, 150)
	title.Text = "VIKING CITY"
	title.Parent = bg

	local sub = Instance.new("TextLabel")
	sub.AnchorPoint = Vector2.new(0.5, 0.5)
	sub.Position = UDim2.fromScale(0.5, 0.52)
	sub.Size = UDim2.fromOffset(700, 30)
	sub.BackgroundTransparency = 1
	sub.Font = Enum.Font.GothamMedium
	sub.TextSize = 18
	sub.TextColor3 = Color3.fromRGB(200, 190, 170)
	sub.Text = "Shaping the valley..."
	sub.Parent = bg

	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")

	local lines = { "Shaping the valley...", "Growing the forests...", "Filling the fjord...", "Your settlers are landing..." }
	local i = 1
	while not controllers.StateController.State do
		task.wait(1.2)
		i = i % #lines + 1
		sub.Text = lines[i]
	end
	task.wait(0.5)
	local fade = TweenInfo.new(1.2)
	TweenService:Create(bg, fade, { BackgroundTransparency = 1 }):Play()
	TweenService:Create(title, fade, { TextTransparency = 1 }):Play()
	TweenService:Create(sub, fade, { TextTransparency = 1 }):Play()
	task.wait(1.3)
	gui:Destroy()
end

return LoadingController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="42">
            <Properties>
              <string name="Name">MinimapController</string>
              <string name="Source"><![CDATA[--[[
	MinimapController
	A round-cornered map in the top right that turns with your camera:
	your plot (gold), other plots, rival holds (red), Ottar's stalls
	(yellow), ships (blue = yours, red = enemy), other players (white) and
	you (the arrow in the middle). Press M to make it bigger or smaller.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Grid = require(Shared.Grid)

local MinimapController = {}

local player = Players.LocalPlayer
local SIZES = { 200, 320 }
local RANGE = 360 -- studs from the centre to the edge

local function new(className, props)
	local inst = Instance.new(className)
	for k, v in props do
		if k ~= "Parent" then
			inst[k] = v
		end
	end
	inst.Parent = props.Parent
	return inst
end

function MinimapController:Start()
	local gui = new("ScreenGui", { Name = "Minimap", ResetOnSpawn = false, Parent = player:WaitForChild("PlayerGui") })
	local sizeIndex = 1
	local frame = new("Frame", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 216),
		Size = UDim2.fromOffset(SIZES[1], SIZES[1]),
		BackgroundColor3 = Color3.fromRGB(58, 72, 46),
		BackgroundTransparency = 0.15,
		ClipsDescendants = true,
		Parent = gui,
	})
	new("UICorner", { CornerRadius = UDim.new(0, 14), Parent = frame })
	new("UIStroke", { Color = Color3.fromRGB(214, 170, 92), Thickness = 2, Transparency = 0.35, Parent = frame })
	local layer = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = frame })
	new("TextLabel", {
		Position = UDim2.new(0, 0, 1, -18),
		Size = UDim2.new(1, 0, 0, 16),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamMedium,
		TextSize = 11,
		TextColor3 = Color3.fromRGB(230, 220, 200),
		TextStrokeTransparency = 0.5,
		Text = "M: bigger map",
		ZIndex = 5,
		Parent = frame,
	})

	-- fixed things in the world: plots, holds, stalls, the shoreline
	local fixed = {}
	local function addFixed(pos: Vector3, size: Vector2, color: Color3, label: string?, round: boolean?, z: number?)
		local f = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = color, BorderSizePixel = 0, ZIndex = z or 2, Parent = layer })
		if round then
			new("UICorner", { CornerRadius = UDim.new(1, 0), Parent = f })
		end
		local text
		if label then
			text = new("TextLabel", {
				AnchorPoint = Vector2.new(0.5, 1),
				Position = UDim2.new(0.5, 0, 0, -2),
				Size = UDim2.fromOffset(120, 14),
				BackgroundTransparency = 1,
				Font = Enum.Font.GothamBold,
				TextSize = 11,
				TextColor3 = Color3.new(1, 1, 1),
				TextStrokeTransparency = 0.3,
				Text = label,
				ZIndex = 4,
				Parent = f,
			})
		end
		table.insert(fixed, { frame = f, pos = pos, size = size, text = text })
		return f
	end

	-- the fjord: a wide band of water beyond the beach
	local water = addFixed(Vector3.new(800, 0, -40 - 400), Vector2.new(4000, 800), Color3.fromRGB(56, 88, 112), nil, false, 1)
	water.BackgroundTransparency = 0.1
	local plotFrames = {}
	for i = 1, Config.MAX_PLOTS do
		local o = Grid.plotOrigin(i)
		local centre = o + Vector3.new(Grid.PLOT_SIZE / 2, 0, Grid.PLOT_SIZE / 2)
		local f = addFixed(centre, Vector2.new(Grid.PLOT_SIZE, Grid.PLOT_SIZE), Color3.fromRGB(110, 120, 80))
		f.BackgroundTransparency = 0.45
		plotFrames[i] = f
		addFixed(Vector3.new(o.X + 100, 0, -16), Vector2.new(10, 10), Color3.fromRGB(240, 200, 80), nil, true, 3)
	end
	for _, rival in Config.Rivals do
		local f = addFixed(rival.Center, Vector2.new(rival.Radius * 2, rival.Radius * 2), Color3.fromRGB(170, 60, 50), rival.Name, true)
		f.BackgroundTransparency = 0.35
	end

	-- moving markers (pooled)
	local pool = {}
	local function dot(i: number): Frame
		local f = pool[i]
		if not f then
			f = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(7, 7), BorderSizePixel = 0, ZIndex = 6, Parent = layer })
			new("UICorner", { CornerRadius = UDim.new(1, 0), Parent = f })
			new("UIStroke", { Color = Color3.new(0, 0, 0), Thickness = 1, Transparency = 0.4, Parent = f })
			pool[i] = f
		end
		f.Visible = true
		return f
	end

	-- you: an arrow in the middle, always pointing up (the map turns instead)
	new("TextLabel", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(18, 18),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		TextSize = 18,
		TextColor3 = Color3.fromRGB(255, 230, 150),
		TextStrokeTransparency = 0.2,
		Text = "▲",
		ZIndex = 8,
		Parent = frame,
	})
	UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and input.KeyCode == Enum.KeyCode.M then
			sizeIndex = sizeIndex % #SIZES + 1
			frame.Size = UDim2.fromOffset(SIZES[sizeIndex], SIZES[sizeIndex])
		end
	end)

	local camera = workspace.CurrentCamera
	local timer = 0
	RunService.RenderStepped:Connect(function(dt)
		timer += dt
		if timer < 1 / 20 then
			return
		end
		timer = 0
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		local centre = root and root.Position or camera.Focus.Position
		local look = camera.CFrame.LookVector
		local fwd = Vector3.new(look.X, 0, look.Z)
		fwd = fwd.Magnitude > 0.01 and fwd.Unit or Vector3.new(0, 0, 1)
		local right = Vector3.new(-fwd.Z, 0, fwd.X)
		local px = SIZES[sizeIndex]
		local k = (px / 2) / RANGE
		local yaw = math.deg(math.atan2(fwd.X, fwd.Z))

		local function place(f: GuiObject, pos: Vector3)
			local rel = pos - centre
			local sx, sy = rel:Dot(right), rel:Dot(fwd)
			f.Position = UDim2.fromOffset(px / 2 + sx * k, px / 2 - sy * k)
		end

		local mine = player:GetAttribute("PlotIndex")
		for i, f in plotFrames do
			f.BackgroundColor3 = i == mine and Color3.fromRGB(214, 170, 92) or Color3.fromRGB(110, 120, 80)
		end
		for _, item in fixed do
			place(item.frame, item.pos)
			item.frame.Size = UDim2.fromOffset(math.max(item.size.X * k, 4), math.max(item.size.Y * k, 4))
			item.frame.Rotation = yaw
			if item.text then
				item.text.Rotation = -yaw
			end
		end

		local n = 0
		for _, other in Players:GetPlayers() do
			local r = other ~= player and other.Character and other.Character:FindFirstChild("HumanoidRootPart")
			if r then
				n += 1
				local f = dot(n)
				f.BackgroundColor3 = Color3.new(1, 1, 1)
				f.Size = UDim2.fromOffset(7, 7)
				place(f, r.Position)
			end
		end
		for _, child in workspace:GetChildren() do
			if child:IsA("Model") and child:GetAttribute("Ship") then
				n += 1
				local f = dot(n)
				local owner = child:GetAttribute("OwnerUserId")
				f.BackgroundColor3 = owner == player.UserId and Color3.fromRGB(90, 170, 255) or (owner == 0 and Color3.fromRGB(230, 70, 60) or Color3.fromRGB(240, 240, 240))
				f.Size = UDim2.fromOffset(10, 10)
				place(f, child:GetPivot().Position)
			end
		end
		for i = n + 1, #pool do
			pool[i].Visible = false
		end
	end)
end

return MinimapController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="43">
            <Properties>
              <string name="Name">SeasonFxController</string>
              <string name="Source"><![CDATA[--[[
	SeasonFxController
	Weather around your camera that follows the season:
	  Winter  snowfall
	  Autumn  drifting gold and red leaves
	  Spring  a few floating pollen motes
]]

local RunService = game:GetService("RunService")

local SeasonFxController = {}

local SPARKLE = "rbxasset://textures/particles/sparkles_main.dds"

local function emitter(parent: BasePart): ParticleEmitter
	local e = Instance.new("ParticleEmitter")
	e.Texture = SPARKLE
	e.LightEmission = 0
	e.LightInfluence = 1
	e.Rate = 0
	e.Parent = parent
	return e
end

function SeasonFxController:Start()
	local box = Instance.new("Part")
	box.Name = "WeatherBox"
	box.Anchored = true
	box.CanCollide = false
	box.CanQuery = false
	box.CanTouch = false
	box.Transparency = 1
	box.Size = Vector3.new(160, 1, 160)
	box.Parent = workspace

	local snow = emitter(box)
	snow.Color = ColorSequence.new(Color3.new(1, 1, 1))
	snow.Size = NumberSequence.new(0.35)
	snow.Lifetime = NumberRange.new(6, 9)
	snow.Speed = NumberRange.new(6, 10)
	snow.SpreadAngle = Vector2.new(12, 12)
	snow.EmissionDirection = Enum.NormalId.Bottom
	snow.Acceleration = Vector3.new(1.5, 0, 0.8)
	snow.RotSpeed = NumberRange.new(-60, 60)

	local leaves = emitter(box)
	leaves.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(222, 170, 60)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(200, 100, 40)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(170, 60, 36)),
	})
	leaves.Size = NumberSequence.new(0.6)
	leaves.Lifetime = NumberRange.new(7, 10)
	leaves.Speed = NumberRange.new(3, 5)
	leaves.EmissionDirection = Enum.NormalId.Bottom
	leaves.Acceleration = Vector3.new(3, 0, 1)
	leaves.RotSpeed = NumberRange.new(-180, 180)
	leaves.Rotation = NumberRange.new(0, 360)

	local pollen = emitter(box)
	pollen.Color = ColorSequence.new(Color3.fromRGB(255, 250, 220))
	pollen.Size = NumberSequence.new(0.2)
	pollen.Transparency = NumberSequence.new(0.4)
	pollen.Lifetime = NumberRange.new(8, 12)
	pollen.Speed = NumberRange.new(0.5, 1.5)
	pollen.SpreadAngle = Vector2.new(180, 180)
	pollen.LightEmission = 0.6

	local function update()
		local season = workspace:GetAttribute("Season")
		snow.Rate = season == "Winter" and 450 or 0
		leaves.Rate = season == "Autumn" and 25 or 0
		pollen.Rate = season == "Spring" and 18 or 0
	end
	workspace:GetAttributeChangedSignal("Season"):Connect(update)
	update()

	RunService.RenderStepped:Connect(function()
		local cam = workspace.CurrentCamera.CFrame.Position
		-- hover above the camera's focus area so the weather surrounds you
		box.CFrame = CFrame.new(cam.X, cam.Y + 35, cam.Z)
	end)
end

return SeasonFxController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="44">
            <Properties>
              <string name="Name">StateController</string>
              <string name="Source"><![CDATA[--[[
	StateController
	Keeps the latest colony snapshot from the server and tells other
	controllers when it changes.

	StateController.State    -- latest snapshot (nil until the first one)
	StateController.Blocked  -- set of blocked grid cells { ["x,z"] = true }
	StateController.Changed  -- Event, fires with the snapshot
	StateController.Notified -- Event, fires with (text, kind)
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Remotes = require(Shared.Remotes)

local StateController = {}

local changed = Instance.new("BindableEvent")
local notified = Instance.new("BindableEvent")
StateController.Changed = changed.Event
StateController.Notified = notified.Event
StateController.State = nil
StateController.Blocked = {}

function StateController:Start()
	Remotes.ColonyState.OnClientEvent:Connect(function(state)
		if state.blocked then
			local set = {}
			for _, key in state.blocked do
				set[key] = true
			end
			self.Blocked = set
		end
		self.State = state
		changed:Fire(state)
	end)
	Remotes.Notify.OnClientEvent:Connect(function(text, kind)
		notified:Fire(text, kind)
	end)
end

-- Lets other client code show a message in the same feed.
function StateController:LocalNotify(text: string, kind: string?)
	notified:Fire(text, kind or "info")
end

return StateController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="45">
            <Properties>
              <string name="Name">TechController</string>
              <string name="Source"><![CDATA[--[[
	TechController
	The research screen. Press T (or the Research button) to open it.
	Five columns: Buildings, Gear, Boats, Culture, Religion. Each card shows
	what a tech does, what it costs and what it still needs. Click a card
	you can afford to research it.
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Grid = require(Shared.Grid)
local Remotes = require(Shared.Remotes)

local TechController = {}

local controllers
local player = Players.LocalPlayer

local THEME = {
	Panel = Color3.fromRGB(28, 23, 18),
	Card = Color3.fromRGB(52, 42, 32),
	Done = Color3.fromRGB(46, 72, 44),
	Ready = Color3.fromRGB(86, 66, 34),
	Locked = Color3.fromRGB(40, 36, 32),
	Accent = Color3.fromRGB(214, 170, 92),
	Text = Color3.fromRGB(245, 235, 215),
	Muted = Color3.fromRGB(170, 156, 134),
	Bad = Color3.fromRGB(230, 110, 96),
}

local BRANCH_ICON = { Buildings = "Hall", Gear = "Forge", Boats = "Keel", Culture = "Saga", Religion = "Faith" }

local function new(className, props)
	local inst = Instance.new(className)
	for k, v in props do
		if k ~= "Parent" then
			inst[k] = v
		end
	end
	inst.Parent = props.Parent
	return inst
end

local function corner(parent, r)
	new("UICorner", { CornerRadius = UDim.new(0, r or 8), Parent = parent })
end

-- Mirrors TechService:CanResearch on the client for display.
local function status(state, id: string): (string, string?)
	local tech = Config.Tech[id]
	local known = {}
	for _, t in state.tech or {} do
		known[t] = true
	end
	if known[id] then
		return "done", nil
	end
	for _, req in tech.Requires or {} do
		if not known[req] then
			return "locked", "Needs " .. Config.Tech[req].Name
		end
	end
	if tech.Building and not (state.buildingTypes and state.buildingTypes[tech.Building]) then
		return "locked", "Needs a " .. Config.Buildings[tech.Building].Display
	end
	if tech.Group then
		for t in known do
			if Config.Tech[t] and Config.Tech[t].Group == tech.Group then
				return "locked", "You follow " .. Config.Tech[t].Name
			end
		end
	end
	if not Grid.canAfford(state.resources, tech.Cost) then
		return "poor", nil
	end
	return "ready", nil
end

function TechController:Init(allControllers)
	controllers = allControllers
end

function TechController:Start()
	local gui = new("ScreenGui", { Name = "Research", ResetOnSpawn = false, DisplayOrder = 10, Parent = player:WaitForChild("PlayerGui") })

	local openButton = new("TextButton", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 170),
		Size = UDim2.fromOffset(230, 36),
		BackgroundColor3 = Color3.fromRGB(70, 54, 34),
		Font = Enum.Font.GothamBold,
		TextSize = 16,
		TextColor3 = THEME.Accent,
		Text = "Research  (T)",
		Parent = gui,
	})
	corner(openButton)

	local panel = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(1060, 560),
		BackgroundColor3 = THEME.Panel,
		BackgroundTransparency = 0.04,
		Visible = false,
		Parent = gui,
	})
	corner(panel, 12)
	new("UIStroke", { Color = THEME.Accent, Thickness = 2, Transparency = 0.4, Parent = panel })

	new("TextLabel", {
		Position = UDim2.fromOffset(20, 12),
		Size = UDim2.new(1, -40, 0, 34),
		BackgroundTransparency = 1,
		Font = Enum.Font.Fantasy,
		TextSize = 30,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = THEME.Accent,
		Text = "Research",
		Parent = panel,
	})
	local loreLabel = new("TextLabel", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -60, 0, 18),
		Size = UDim2.fromOffset(420, 26),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamMedium,
		TextSize = 16,
		TextXAlignment = Enum.TextXAlignment.Right,
		TextColor3 = Color3.fromRGB(150, 185, 240),
		Text = "",
		Parent = panel,
	})
	local close = new("TextButton", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, 14),
		Size = UDim2.fromOffset(32, 32),
		BackgroundColor3 = THEME.Card,
		Font = Enum.Font.GothamBold,
		TextSize = 18,
		TextColor3 = THEME.Text,
		Text = "X",
		Parent = panel,
	})
	corner(close, 6)

	local columns = new("Frame", {
		Position = UDim2.fromOffset(16, 58),
		Size = UDim2.new(1, -32, 1, -74),
		BackgroundTransparency = 1,
		Parent = panel,
	})
	new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder, Parent = columns })

	local cards = {}
	for i, branch in Config.TechBranches do
		local col = new("Frame", {
			Size = UDim2.new(0.2, -8, 1, 0),
			BackgroundTransparency = 1,
			LayoutOrder = i,
			Parent = columns,
		})
		new("TextLabel", {
			Size = UDim2.new(1, 0, 0, 26),
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamBold,
			TextSize = 17,
			TextColor3 = THEME.Accent,
			Text = string.upper(branch) .. "  ·  " .. BRANCH_ICON[branch],
			Parent = col,
		})
		local list = new("ScrollingFrame", {
			Position = UDim2.fromOffset(0, 30),
			Size = UDim2.new(1, 0, 1, -30),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ScrollBarThickness = 4,
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			CanvasSize = UDim2.new(),
			Parent = col,
		})
		new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = list })

		-- order the techs so prerequisites come first
		local ids = {}
		for id, tech in Config.Tech do
			if tech.Branch == branch then
				table.insert(ids, id)
			end
		end
		table.sort(ids, function(a, b)
			local ra, rb = #(Config.Tech[a].Requires or {}), #(Config.Tech[b].Requires or {})
			if ra ~= rb then
				return ra < rb
			end
			return Config.Tech[a].Name < Config.Tech[b].Name
		end)

		for order, id in ids do
			local tech = Config.Tech[id]
			local card = new("TextButton", {
				Size = UDim2.new(1, -6, 0, 112),
				BackgroundColor3 = THEME.Card,
				AutoButtonColor = true,
				Text = "",
				LayoutOrder = order,
				Parent = list,
			})
			corner(card)
			local stroke = new("UIStroke", { ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Color = THEME.Accent, Thickness = 1.5, Transparency = 0.7, Parent = card })
			new("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), PaddingTop = UDim.new(0, 6), Parent = card })
			new("TextLabel", {
				Size = UDim2.new(1, 0, 0, 20),
				BackgroundTransparency = 1,
				Font = Enum.Font.GothamBold,
				TextSize = 15,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextColor3 = THEME.Text,
				Text = tech.Name,
				Parent = card,
			})
			new("TextLabel", {
				Position = UDim2.fromOffset(0, 22),
				Size = UDim2.new(1, 0, 0, 46),
				BackgroundTransparency = 1,
				Font = Enum.Font.Gotham,
				TextSize = 13,
				TextWrapped = true,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Top,
				TextColor3 = THEME.Muted,
				Text = tech.Description,
				Parent = card,
			})
			local foot = new("TextLabel", {
				Position = UDim2.fromOffset(0, 72),
				Size = UDim2.new(1, 0, 0, 30),
				BackgroundTransparency = 1,
				Font = Enum.Font.GothamMedium,
				TextSize = 12,
				TextWrapped = true,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextColor3 = THEME.Accent,
				Text = Grid.costText(tech.Cost),
				Parent = card,
			})
			card.Activated:Connect(function()
				local ok, msg = Remotes.Research:InvokeServer(id)
				controllers.StateController:LocalNotify(msg, ok and "good" or "bad")
				if ok then
					-- a little flash of gold
					card.BackgroundColor3 = THEME.Accent
					TweenService:Create(card, TweenInfo.new(0.6), { BackgroundColor3 = THEME.Done }):Play()
				end
			end)
			cards[id] = { card = card, foot = foot, stroke = stroke }
		end
	end

	local function refresh(state)
		if not state then
			return
		end
		loreLabel.Text = string.format("Lore %d   ·   build a Lore Hall to gather more", state.resources.Lore or 0)
		for id, c in cards do
			local st, why = status(state, id)
			local tech = Config.Tech[id]
			if st == "done" then
				c.card.BackgroundColor3 = THEME.Done
				c.foot.Text = "Known"
				c.foot.TextColor3 = Color3.fromRGB(150, 220, 140)
				c.stroke.Transparency = 0.9
			elseif st == "locked" then
				c.card.BackgroundColor3 = THEME.Locked
				c.foot.Text = why .. "   ·   " .. Grid.costText(tech.Cost)
				c.foot.TextColor3 = THEME.Muted
				c.stroke.Transparency = 0.9
			elseif st == "poor" then
				c.card.BackgroundColor3 = THEME.Card
				c.foot.Text = Grid.costText(tech.Cost)
				c.foot.TextColor3 = THEME.Bad
				c.stroke.Transparency = 0.7
			else
				c.card.BackgroundColor3 = THEME.Ready
				c.foot.Text = Grid.costText(tech.Cost) .. "   ·   click to research"
				c.foot.TextColor3 = THEME.Accent
				c.stroke.Transparency = 0.1
			end
		end
	end

	local function toggle()
		panel.Visible = not panel.Visible
		if panel.Visible then
			refresh(controllers.StateController.State)
		end
	end
	openButton.Activated:Connect(toggle)
	close.Activated:Connect(toggle)
	UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and input.KeyCode == Enum.KeyCode.T then
			toggle()
		end
	end)
	controllers.StateController.Changed:Connect(function(state)
		if panel.Visible then
			refresh(state)
		end
	end)
end

return TechController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="46">
            <Properties>
              <string name="Name">ToolController</string>
              <string name="Source"><![CDATA[--[[
	ToolController
	Makes the tools feel alive on your side:
	  Bow      click to shoot where the mouse points (the server checks the hit)
	  Axe /
	  Pickaxe  click to swing at a tree or rock (or an enemy)
	  Sword    click to fight
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Remotes = require(Shared.Remotes)
local Config = require(Shared.Config)

local ToolController = {}

local player = Players.LocalPlayer
local lastShot = 0

local function aimPoint(): Vector3
	local camera = workspace.CurrentCamera
	local pos = UserInputService:GetMouseLocation()
	local ray = camera:ViewportPointToRay(pos.X, pos.Y)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { player.Character }
	local hit = workspace:Raycast(ray.Origin, ray.Direction * 1000, params)
	return hit and hit.Position or ray.Origin + ray.Direction * 1000
end

local function swing(tool: Tool)
	local base = tool.Grip
	local info = TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0, true)
	local t = TweenService:Create(tool, info, { Grip = base * CFrame.Angles(math.rad(-70), 0, 0) })
	t:Play()
	t.Completed:Wait()
	tool.Grip = base
end

local function hookTool(tool: Instance)
	if not tool:IsA("Tool") or tool:GetAttribute("Hooked") then
		return
	end
	tool:SetAttribute("Hooked", true)
	tool.Activated:Connect(function()
		if tool.Name == "Bow" then
			local now = os.clock()
			if now - lastShot < Config.Bow.Cooldown then
				return
			end
			lastShot = now
			Remotes.ShootArrow:FireServer(aimPoint())
		else
			if Config.Combat.MeleeDamage[tool.Name] then
				Remotes.Strike:FireServer()
			end
			swing(tool)
		end
	end)
end

function ToolController:Start()
	local function watch(container: Instance)
		for _, child in container:GetChildren() do
			hookTool(child)
		end
		container.ChildAdded:Connect(hookTool)
	end
	local function onCharacter(character)
		watch(character)
		watch(player:WaitForChild("Backpack"))
	end
	player.CharacterAdded:Connect(onCharacter)
	if player.Character then
		onCharacter(player.Character)
	end
end

return ToolController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="47">
            <Properties>
              <string name="Name">TradeController</string>
              <string name="Source"><![CDATA[--[[
	TradeController
	The trade window that opens at Ottar's stall on your beach. Each row
	swaps what you give for what you get; click Trade to do it. Prices that
	change with the season are marked. Walk away or press X to close.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Grid = require(Shared.Grid)
local Remotes = require(Shared.Remotes)

local TradeController = {}

local controllers
local player = Players.LocalPlayer

local THEME = {
	Panel = Color3.fromRGB(28, 23, 18),
	Row = Color3.fromRGB(52, 42, 32),
	Accent = Color3.fromRGB(214, 170, 92),
	Text = Color3.fromRGB(245, 235, 215),
	Muted = Color3.fromRGB(170, 156, 134),
	Good = Color3.fromRGB(130, 200, 110),
	Bad = Color3.fromRGB(230, 110, 96),
}

local function new(className, props)
	local inst = Instance.new(className)
	for k, v in props do
		if k ~= "Parent" then
			inst[k] = v
		end
	end
	inst.Parent = props.Parent
	return inst
end

local function price(offer)
	local season = workspace:GetAttribute("Season") or "Summer"
	local mult = offer.Season and offer.Season[season] or 1
	local give = {}
	for res, n in offer.Give do
		give[res] = math.max(1, math.floor(n * mult + 0.5))
	end
	return give, mult
end

function TradeController:Init(all)
	controllers = all
end

function TradeController:Start()
	local gui = new("ScreenGui", { Name = "Trade", ResetOnSpawn = false, DisplayOrder = 9, Parent = player:WaitForChild("PlayerGui") })
	local panel = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(460, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = THEME.Panel,
		BackgroundTransparency = 0.04,
		Visible = false,
		Parent = gui,
	})
	new("UICorner", { CornerRadius = UDim.new(0, 12), Parent = panel })
	new("UIStroke", { Color = THEME.Accent, Thickness = 2, Transparency = 0.4, Parent = panel })
	new("UIPadding", { PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 14), PaddingTop = UDim.new(0, 12), PaddingBottom = UDim.new(0, 14), Parent = panel })
	new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = panel })

	local header = new("Frame", { Size = UDim2.new(1, 0, 0, 34), BackgroundTransparency = 1, LayoutOrder = 0, Parent = panel })
	new("TextLabel", {
		Size = UDim2.new(1, -40, 1, 0),
		BackgroundTransparency = 1,
		Font = Enum.Font.Fantasy,
		TextSize = 28,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = THEME.Accent,
		Text = "Ottar's Stall",
		Parent = header,
	})
	local close = new("TextButton", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.fromOffset(32, 32),
		BackgroundColor3 = THEME.Row,
		Font = Enum.Font.GothamBold,
		TextSize = 18,
		TextColor3 = THEME.Text,
		Text = "X",
		Parent = header,
	})
	new("UICorner", { CornerRadius = UDim.new(0, 6), Parent = close })
	local seasonLabel = new("TextLabel", {
		Size = UDim2.new(1, 0, 0, 18),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamMedium,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = THEME.Muted,
		LayoutOrder = 1,
		Parent = panel,
	})
	local status = new("TextLabel", {
		Size = UDim2.new(1, 0, 0, 18),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamMedium,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = THEME.Good,
		Text = "",
		LayoutOrder = 999,
		Parent = panel,
	})

	local rows = {}
	for i, offer in Config.Trade.Offers do
		local row = new("Frame", { Size = UDim2.new(1, 0, 0, 40), BackgroundColor3 = THEME.Row, LayoutOrder = 10 + i, Parent = panel })
		new("UICorner", { CornerRadius = UDim.new(0, 8), Parent = row })
		local text = new("TextLabel", {
			Position = UDim2.fromOffset(12, 0),
			Size = UDim2.new(1, -120, 1, 0),
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamMedium,
			TextSize = 15,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = THEME.Text,
			Parent = row,
		})
		local button = new("TextButton", {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -6, 0.5, 0),
			Size = UDim2.fromOffset(96, 30),
			BackgroundColor3 = Color3.fromRGB(86, 66, 34),
			Font = Enum.Font.GothamBold,
			TextSize = 15,
			TextColor3 = THEME.Accent,
			Text = "Trade",
			Parent = row,
		})
		new("UICorner", { CornerRadius = UDim.new(0, 6), Parent = button })
		button.Activated:Connect(function()
			local ok, message = Remotes.Trade:InvokeServer(i)
			status.Text = message or ""
			status.TextColor3 = ok and THEME.Good or THEME.Bad
		end)
		rows[i] = { offer = offer, text = text, button = button }
	end

	local function refresh()
		seasonLabel.Text = "Season: " .. (workspace:GetAttribute("Season") or "Summer") .. ". Food prices change with the seasons."
		local state = controllers.StateController and controllers.StateController.State
		for _, r in rows do
			local give, mult = price(r.offer)
			local tag = mult > 1.01 and "  (dear)" or (mult < 0.99 and "  (cheap)" or "")
			r.text.Text = "Give " .. Grid.costText(give) .. "   →   Get " .. Grid.costText(r.offer.Get) .. tag
			local affordable = state == nil or Grid.canAfford(state.resources, give)
			r.text.TextColor3 = affordable and THEME.Text or THEME.Muted
		end
	end

	local openedAt
	Remotes.OpenTrade.OnClientEvent:Connect(function()
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		openedAt = root and root.Position
		status.Text = ""
		refresh()
		panel.Visible = true
	end)
	close.Activated:Connect(function()
		panel.Visible = false
	end)
	local timer = 0
	RunService.Heartbeat:Connect(function(dt)
		if not panel.Visible then
			return
		end
		timer += dt
		if timer > 0.5 then
			timer = 0
			refresh()
			local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			if root and openedAt and (root.Position - openedAt).Magnitude > 16 then
				panel.Visible = false
			end
		end
	end)
end

return TradeController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="48">
            <Properties>
              <string name="Name">UIScaleController</string>
              <string name="Source"><![CDATA[--[[
	UIScaleController
	Shrinks every screen of the interface to fit smaller windows, laptops,
	tablets and phones, so nothing runs off the edge. Designed at 1500x860;
	never scales up, never below 60%.
]]

local Players = game:GetService("Players")

local UIScaleController = {}

local DESIGN = Vector2.new(1500, 860)

local function scaleFor(viewport: Vector2): number
	return math.clamp(math.min(viewport.X / DESIGN.X, viewport.Y / DESIGN.Y), 0.6, 1)
end

function UIScaleController:Start()
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	local camera = workspace.CurrentCamera
	local scales = {}

	local function apply()
		local s = scaleFor(camera.ViewportSize)
		for _, ui in scales do
			ui.Scale = s
		end
	end

	local function hook(gui: Instance)
		if gui:IsA("ScreenGui") and not gui:FindFirstChild("AutoScale") then
			local ui = Instance.new("UIScale")
			ui.Name = "AutoScale"
			ui.Parent = gui
			table.insert(scales, ui)
			apply()
		end
	end

	for _, gui in playerGui:GetChildren() do
		hook(gui)
	end
	playerGui.ChildAdded:Connect(hook)
	camera:GetPropertyChangedSignal("ViewportSize"):Connect(apply)
end

return UIScaleController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="49">
            <Properties>
              <string name="Name">VillagerAnimController</string>
              <string name="Source"><![CDATA[--[[
	VillagerAnimController
	Makes the little villager figures walk: their arms and legs swing in
	step while they move and come to rest when they stop. Purely visual and
	done on each player's own screen (the server only moves the bodies).
	Only villagers near the camera are animated, to keep it cheap.
]]

local RunService = game:GetService("RunService")

local VillagerAnimController = {}

local figures = {} -- [model] = { body, limbs = { {weld, hip, half, side, isArm} }, last, phase, amount }
local RANGE = 160

local function track(model: Model)
	if figures[model] or not model:GetAttribute("Villager") then
		return
	end
	local body = model.PrimaryPart or model:FindFirstChild("Body")
	if not body then
		return
	end
	local limbs = {}
	for _, part in model:GetChildren() do
		local joint = part:IsA("BasePart") and part:FindFirstChild("Joint")
		if joint and joint:IsA("Weld") and part:GetAttribute("Hip") then
			table.insert(limbs, {
				weld = joint,
				hip = part:GetAttribute("Hip"),
				half = part:GetAttribute("HalfLen") or 0.5,
				side = part:GetAttribute("Side") or 1,
				isArm = part.Name == "Arm",
			})
		end
	end
	if #limbs == 0 then
		return
	end
	figures[model] = { body = body, limbs = limbs, last = body.Position, phase = math.random() * 6, amount = 0 }
end

function VillagerAnimController:Start()
	-- villager models appear inside every plot's Villagers folder; watch the
	-- whole workspace for them (they can be rebuilt when someone grows up)
	workspace.DescendantAdded:Connect(function(inst)
		if inst:IsA("Model") and inst:GetAttribute("Villager") then
			task.defer(track, inst)
		end
	end)
	for _, inst in workspace:GetDescendants() do
		if inst:IsA("Model") and inst:GetAttribute("Villager") then
			track(inst)
		end
	end

	local camera = workspace.CurrentCamera
	RunService.RenderStepped:Connect(function(dt)
		local camPos = camera and camera.CFrame.Position or Vector3.zero
		for model, f in figures do
			if not model.Parent then
				figures[model] = nil
				continue
			end
			local pos = f.body.Position
			if (pos - camPos).Magnitude > RANGE then
				f.last = pos
				continue
			end
			local moved = Vector3.new(pos.X - f.last.X, 0, pos.Z - f.last.Z).Magnitude
			f.last = pos
			local speed = dt > 0 and moved / dt or 0
			local moving = speed > 0.5
			f.amount += ((moving and 1 or 0) - f.amount) * math.min(1, dt * 8)
			f.phase += dt * math.clamp(speed, 0, 12) * 1.4
			local swing = math.sin(f.phase) * 0.7 * f.amount
			for _, limb in f.limbs do
				local angle = swing * limb.side * (limb.isArm and 0.8 or 1)
				limb.weld.C0 = limb.hip * CFrame.Angles(angle, 0, 0) * CFrame.new(0, -limb.half, 0)
			end
		end
	end)
end

return VillagerAnimController
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
