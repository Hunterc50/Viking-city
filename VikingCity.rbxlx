      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Grid</string>
          <string name="Source"><![CDATA[--[[
	Grid
	Pure math helpers for the building grid. Cells are addressed by integer
	(x, z) starting at 0 in the plot's corner. A building is placed by its
	minimum corner cell plus a rotation (0 = default, 1 = turned 90 degrees).
]]

local Config = require(script.Parent.Config)

local Grid = {}

local CELL = Config.CELL
local N = Config.PLOT_CELLS

Grid.PLOT_SIZE = CELL * N

function Grid.key(x: number, z: number): string
	return x .. "," .. z
end

-- World-space corner (min x, min z, ground top) of plot number `index` (1-based).
function Grid.plotOrigin(index: number): Vector3
	return Vector3.new((index - 1) * (Grid.PLOT_SIZE + Config.PLOT_GAP), Config.GROUND_Y, 0)
end

-- Footprint in cells after rotation.
function Grid.footprint(buildingType: string, rot: number): (number, number)
	local def = Config.Buildings[buildingType]
	local sx, sz = def.Size[1], def.Size[2]
	if rot % 2 == 1 then
		return sz, sx
	end
	return sx, sz
end

-- The cell bounds of a plot at land stage `land` (1 = starting size):
-- minX, minZ, maxX, maxZ, with max exclusive. Cells may be negative
-- (minZ < 0 is the beach in front of the plot).
function Grid.bounds(land: number?): (number, number, number, number)
	local stage = Config.LandStages[land or 1] or Config.LandStages[1]
	return stage.MinX, stage.MinZ or 0, stage.MaxX, stage.MaxZ
end

-- The world-space box of the land: min corner and size (studs).
function Grid.landRect(origin: Vector3, land: number?): (Vector3, Vector3)
	local minX, minZ, maxX, maxZ = Grid.bounds(land)
	return origin + Vector3.new(minX * CELL, 0, minZ * CELL), Vector3.new((maxX - minX) * CELL, 0, (maxZ - minZ) * CELL)
end

-- The largest the land can ever grow (used to keep scenery off it).
function Grid.maxBounds(): (number, number, number, number)
	local a, b, c, d = 0, 0, N, N
	for _, stage in Config.LandStages do
		a, b = math.min(a, stage.MinX), math.min(b, stage.MinZ or 0)
		c, d = math.max(c, stage.MaxX), math.max(d, stage.MaxZ)
	end
	return a, b, c, d
end

function Grid.inBounds(cx: number, cz: number, sx: number, sz: number, land: number?): boolean
	local minX, minZ, maxX, maxZ = Grid.bounds(land)
	return cx >= minX and cz >= minZ and cx + sx <= maxX and cz + sz <= maxZ
end

-- Calls fn(x, z) for every cell covered by the rectangle.
function Grid.eachCell(cx: number, cz: number, sx: number, sz: number, fn: (number, number) -> ())
	for x = cx, cx + sx - 1 do
		for z = cz, cz + sz - 1 do
			fn(x, z)
		end
	end
end

-- `blocked` is a set: { ["x,z"] = true/anything }.
-- `buildingType` (optional) adds that building's own rules, like a jetty's
-- place at the water's edge.
function Grid.canPlace(blocked, cx: number, cz: number, sx: number, sz: number, land: number?, buildingType: string?): (boolean, string?)
	if not Grid.inBounds(cx, cz, sx, sz, land) then
		return false, "Outside your land"
	end
	local def = buildingType and Config.Buildings[buildingType]
	if def and def.Shore then
		local _, minZ = Grid.bounds(land)
		if cz ~= minZ then
			return false, "A jetty goes on the front row of your beach, by the water"
		end
	end
	local free = true
	Grid.eachCell(cx, cz, sx, sz, function(x, z)
		if blocked[Grid.key(x, z)] then
			free = false
		end
	end)
	if not free then
		return false, "Something is in the way (clear trees and rocks first)"
	end
	return true, nil
end

-- World position of the centre of a rectangle of cells, at ground level.
function Grid.rectCenter(origin: Vector3, cx: number, cz: number, sx: number, sz: number): Vector3
	return origin + Vector3.new((cx + sx / 2) * CELL, 0, (cz + sz / 2) * CELL)
end

-- The CFrame a building model should be pivoted to.
function Grid.buildingCFrame(origin: Vector3, cx: number, cz: number, sx: number, sz: number, rot: number): CFrame
	return CFrame.new(Grid.rectCenter(origin, cx, cz, sx, sz)) * CFrame.Angles(0, rot * math.pi / 2, 0)
end

-- Converts a world point to the min-corner cell of a footprint centred on it.
function Grid.worldToCell(origin: Vector3, pos: Vector3, sx: number, sz: number): (number, number)
	local local_ = pos - origin
	local cx = math.floor(local_.X / CELL - sx / 2 + 0.5)
	local cz = math.floor(local_.Z / CELL - sz / 2 + 0.5)
	return cx, cz
end

function Grid.canAfford(resources, cost): boolean
	for name, amount in cost do
		if (resources[name] or 0) < amount then
			return false
		end
	end
	return true
end

function Grid.costText(cost): string
	local parts = {}
	for _, name in Config.ResourceOrder do
		if cost[name] then
			table.insert(parts, cost[name] .. " " .. name)
		end
	end
	return table.concat(parts, "  ")
end

return Grid
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">ModelFactory</string>
          <string name="Source"><![CDATA[--[[
	ModelFactory
	Builds every model in the game out of plain Parts, so the game needs no
	imported assets. Every model is built around (0, 0, 0) = centre of its
	footprint at ground level, and its WorldPivot is set there, so callers just
	do model:PivotTo(cframe).

	MESH SWAP: put a model (or Tool) in ReplicatedStorage > Assets with one of
	the slot names in ModelFactory.Slots and the game uses it instead of the
	part-built version. Buildings are scaled to fit their footprint.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(script.Parent.Config)
local SettlerRig = require(script.Parent.SettlerRig)
local AssetIds = require(script.Parent.AssetIds)

local ModelFactory = {}

local CELL = Config.CELL
local V3 = Vector3.new

local Colors = {
	Wood = Color3.fromRGB(128, 90, 58),
	DarkWood = Color3.fromRGB(74, 52, 36),
	Weathered = Color3.fromRGB(104, 92, 78),
	Thatch = Color3.fromRGB(176, 146, 88),
	Shingle = Color3.fromRGB(86, 62, 44),
	Turf = Color3.fromRGB(88, 112, 58),
	Stone = Color3.fromRGB(124, 124, 120),
	Soil = Color3.fromRGB(92, 66, 44),
	Barley = Color3.fromRGB(206, 178, 92),
	Pine = Color3.fromRGB(38, 70, 44),
	PineLight = Color3.fromRGB(52, 86, 50),
	Leaf = Color3.fromRGB(70, 112, 56),
	Birch = Color3.fromRGB(222, 218, 205),
	Berry = Color3.fromRGB(170, 34, 46),
	Skin = Color3.fromRGB(234, 196, 160),
	Lantern = Color3.fromRGB(255, 170, 80),
	Iron = Color3.fromRGB(90, 92, 98),
}
ModelFactory.Colors = Colors

local Hair = {
	Color3.fromRGB(196, 150, 80),
	Color3.fromRGB(150, 74, 40),
	Color3.fromRGB(80, 56, 38),
	Color3.fromRGB(220, 200, 150),
}

local function addPart(model: Instance, props)
	local p = Instance.new(props.Class or "Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if props.Shape then
		p.Shape = props.Shape
	end
	p.Size = props.Size
	p.CFrame = props.CFrame or CFrame.new(props.Position or Vector3.zero)
	p.Color = props.Color or Colors.Wood
	p.Material = props.Material or Enum.Material.Wood
	p.Name = props.Name or "Part"
	if props.CanCollide == false then
		p.CanCollide = false
	end
	p.Parent = model
	return p
end
ModelFactory.addPart = addPart

-- A steady random source for small details (log shades, stones, shingles),
-- so the same building looks the same every time it is built.
local detail = Random.new(1066)

-- `color` a little lighter or darker, for weathered, hand-made variety.
local function vary(color: Color3, amount: number?): Color3
	local a = amount or 0.08
	local k = 1 + detail:NextNumber(-a, a)
	return Color3.new(math.clamp(color.R * k, 0, 1), math.clamp(color.G * k, 0, 1), math.clamp(color.B * k, 0, 1))
end
ModelFactory.vary = vary

-- Small details don't need to cast shadows: much cheaper to draw.
local function noShadow(p: BasePart)
	p.CastShadow = false
	return p
end

-- A vertical log (cylinder) standing at `pos` (its bottom on pos.Y).
local function post(model, pos: Vector3, height: number, diameter: number, color: Color3?)
	return addPart(model, {
		Shape = Enum.PartType.Cylinder,
		Size = V3(height, diameter, diameter),
		CFrame = CFrame.new(pos + V3(0, height / 2, 0)) * CFrame.Angles(0, 0, math.pi / 2),
		Color = color or Colors.DarkWood,
	})
end

local function lantern(model, cf: CFrame)
	local l = addPart(model, {
		Name = "Lantern",
		Size = V3(0.6, 0.8, 0.6),
		CFrame = cf,
		Color = Colors.Lantern,
		Material = Enum.Material.Neon,
		CanCollide = false,
	})
	local light = Instance.new("PointLight")
	light.Color = Colors.Lantern
	light.Range = 16
	light.Brightness = 1.4
	light.Shadows = true
	light.Parent = l
end

local function smoke(model, cf: CFrame)
	local hole = addPart(model, {
		Name = "SmokeHole",
		Size = V3(1.6, 0.8, 1.6),
		CFrame = cf,
		Color = Colors.DarkWood,
	})
	local s = Instance.new("Smoke")
	s.Color = Color3.fromRGB(210, 205, 200)
	s.Opacity = 0.12
	s.RiseVelocity = 3
	s.Size = 1.5
	s.Parent = hole
end

--[[
	A timber hall: stone footing, plank walls with log banding, a pitched
	roof (ridge along local X), filled gable ends, crossed carved boards at
	both gables, a door on the -Z side, a lantern and optional chimney smoke.
	o = { w, d, wallH, roof = "thatch" | "shingle" | "turf", pitch, smoke, lantern }
]]
local function hall(model, cf: CFrame, o)
	local w, d, wallH = o.w, o.d, o.wallH
	local base = 1
	addPart(model, {
		Name = "Foundation",
		Size = V3(w + 1.2, 1, d + 1.2),
		CFrame = cf * CFrame.new(0, 0.5, 0),
		Color = Colors.Stone,
		Material = Enum.Material.Cobblestone,
	})
	-- a solid core (what you bump into), dark where it shows between logs
	addPart(model, {
		Name = "Walls",
		Size = V3(w - 0.3, wallH, d - 0.3),
		CFrame = cf * CFrame.new(0, base + wallH / 2, 0),
		Color = Color3.fromRGB(58, 42, 30),
		Material = Enum.Material.WoodPlanks,
	})
	-- log walls: courses of round logs, notched at the corners so the log
	-- ends stick out, each log a slightly different shade of weathered wood
	local courses = math.max(4, math.floor(wallH / 0.85))
	local dia = wallH / courses * 1.12
	for i = 1, courses do
		local y = base + (i - 0.5) * (wallH / courses)
		local longOut = (i % 2 == 1) and 1.5 or 0.5
		local shortOut = (i % 2 == 1) and 0.5 or 1.5
		for _, side in { 1, -1 } do
			addPart(model, {
				Name = "Log",
				Shape = Enum.PartType.Cylinder,
				Size = V3(w + longOut, dia, dia),
				CFrame = cf * CFrame.new(detail:NextNumber(-0.15, 0.15), y, side * d / 2),
				Color = vary(Colors.Wood, 0.14),
				Material = Enum.Material.Wood,
			})
			addPart(model, {
				Name = "Log",
				Shape = Enum.PartType.Cylinder,
				Size = V3(d + shortOut, dia, dia),
				CFrame = cf * CFrame.new(side * w / 2, y, detail:NextNumber(-0.15, 0.15)) * CFrame.Angles(0, math.pi / 2, 0),
				Color = vary(Colors.Weathered, 0.14),
				Material = Enum.Material.Wood,
			})
		end
	end
	-- a footing of rough fieldstones along the base of the walls
	local function stoneRow(from: Vector3, to: Vector3)
		local len = (to - from).Magnitude
		local n = math.max(2, math.floor(len / 2.3))
		for k = 0, n do
			local p = from:Lerp(to, k / n)
			noShadow(addPart(model, {
				Name = "FootingStone",
				Size = V3(detail:NextNumber(1.4, 2.1), detail:NextNumber(0.7, 1.1), detail:NextNumber(1, 1.5)),
				CFrame = cf * CFrame.new(p) * CFrame.Angles(detail:NextNumber(-0.15, 0.15), detail:NextNumber(0, math.pi), detail:NextNumber(-0.15, 0.15)),
				Color = vary(Colors.Stone, 0.16),
				Material = (k % 3 == 0) and Enum.Material.Rock or Enum.Material.Slate,
			}))
		end
	end
	local fx, fz = w / 2 + 0.55, d / 2 + 0.55
	stoneRow(V3(-fx, 0.45, -fz), V3(fx, 0.45, -fz))
	stoneRow(V3(-fx, 0.45, fz), V3(fx, 0.45, fz))
	stoneRow(V3(-fx, 0.45, -fz), V3(-fx, 0.45, fz))
	stoneRow(V3(fx, 0.45, -fz), V3(fx, 0.45, fz))

	-- roof
	local roofColor = Colors.Thatch
	local roofMaterial = Enum.Material.Grass
	if o.roof == "shingle" then
		roofColor, roofMaterial = Colors.Shingle, Enum.Material.WoodPlanks
	elseif o.roof == "turf" then
		roofColor, roofMaterial = Colors.Turf, Enum.Material.Grass
	end
	local wallTop = base + wallH
	local angle = math.rad(o.pitch or 38)
	local halfD = d / 2 + 1.6
	local rise = halfD * math.tan(angle)
	local slope = halfD / math.cos(angle) + 0.6
	local ridgeY = wallTop + rise
	for _, side in { 1, -1 } do
		local slab = addPart(model, {
			Name = "Roof",
			Size = V3(w + 2.6, 1, slope),
			CFrame = cf * CFrame.new(0, wallTop + rise / 2, side * halfD / 2) * CFrame.Angles(side * angle, 0, 0),
			Color = roofColor:Lerp(Color3.new(0, 0, 0), 0.25),
			Material = roofMaterial,
		})
		-- overlapping courses laid on top, each a touch different, the lower
		-- edge lifted like real shingles or bundles of thatch
		local rows = math.max(3, math.floor(slope / 1.7))
		local rowLen = slope / rows
		local thick = o.roof == "shingle" and 0.3 or 0.55
		for r = 1, rows do
			local z = -side * (slope / 2 - (r - 0.5) * rowLen)
			noShadow(addPart(model, {
				Name = "RoofCourse",
				Size = V3(w + 2.7 + detail:NextNumber(-0.1, 0.1), thick, rowLen + 0.5),
				CFrame = slab.CFrame * CFrame.new(0, 0.5 + thick / 2 + 0.02 * r, z) * CFrame.Angles(side * math.rad(4), 0, 0),
				Color = vary(roofColor, 0.1),
				Material = roofMaterial,
				CanCollide = false,
			}))
		end
		-- patches of moss and grass on thatch and turf
		if o.roof ~= "shingle" then
			for _ = 1, math.max(2, math.floor(w / 7)) do
				noShadow(addPart(model, {
					Name = "Moss",
					Size = V3(detail:NextNumber(1.5, 3.5), 0.2, detail:NextNumber(1, 2.4)),
					CFrame = slab.CFrame * CFrame.new(detail:NextNumber(-w / 2, w / 2), 0.5 + thick + 0.12, detail:NextNumber(-slope / 2.5, slope / 2.5)),
					Color = vary(Color3.fromRGB(86, 108, 52), 0.12),
					Material = Enum.Material.LeafyGrass,
					CanCollide = false,
				}))
			end
		end
	end
	addPart(model, {
		Name = "Ridge",
		Size = V3(w + 3, 0.9, 0.9),
		CFrame = cf * CFrame.new(0, ridgeY + 0.2, 0),
		Color = Colors.DarkWood,
	})

	-- gable ends: stepped planks filling the triangle under the roof
	local steps = 5
	local stepH = rise / steps
	for _, sx in { 1, -1 } do
		for k = 1, steps do
			local hw = math.min(d / 2, halfD * (1 - (k - 0.5) / steps))
			if hw > 0.3 then
				addPart(model, {
					Name = "Gable",
					Size = V3(0.6, stepH + 0.05, hw * 2),
					CFrame = cf * CFrame.new(sx * w / 2, wallTop + (k - 0.5) * stepH, 0),
					Color = Colors.Weathered,
					Material = Enum.Material.WoodPlanks,
				})
			end
		end
		-- crossed carved boards that stick up past the ridge like horns
		for _, side in { 1, -1 } do
			addPart(model, {
				Name = "GableBoard",
				Size = V3(0.5, 0.7, slope + 3.2),
				CFrame = cf
					* CFrame.new(sx * (w / 2 + 1.2), ridgeY + 0.3, 0)
					* CFrame.Angles(side * angle, 0, 0)
					* CFrame.new(0, 0, side * (slope / 2 - 1.6)),
				Color = Colors.DarkWood,
			})
		end
	end

	-- door with frame
	addPart(model, {
		Name = "DoorFrame",
		Size = V3(4, 5.8, 0.4),
		CFrame = cf * CFrame.new(0, base + 2.9, -d / 2 - 0.55),
		Color = Colors.DarkWood,
	})
	addPart(model, {
		Name = "Door",
		Size = V3(3, 5, 0.3),
		CFrame = cf * CFrame.new(0, base + 2.5, -d / 2 - 0.75),
		Color = Color3.fromRGB(60, 40, 28),
		Material = Enum.Material.WoodPlanks,
	})
	-- iron straps across the door
	for _, y in { 1.2, 3.8 } do
		noShadow(addPart(model, { Name = "DoorStrap", Size = V3(2.8, 0.25, 0.1), CFrame = cf * CFrame.new(0, base + y, -d / 2 - 0.92), Color = Colors.Iron, Material = Enum.Material.Metal, CanCollide = false }))
	end
	-- small windows with warm light behind them and open shutters
	if w >= 12 then
		for _, x in { -w / 4 - 1, w / 4 + 1 } do
			local at = cf * CFrame.new(x, base + wallH * 0.55, -d / 2 - 0.5)
			noShadow(addPart(model, { Name = "WindowFrame", Size = V3(1.9, 1.6, 0.3), CFrame = at, Color = Colors.DarkWood, CanCollide = false }))
			local glow = noShadow(addPart(model, { Name = "WindowGlow", Size = V3(1.3, 1.05, 0.12), CFrame = at * CFrame.new(0, 0, -0.12), Color = Color3.fromRGB(255, 168, 86), Material = Enum.Material.Neon, CanCollide = false }))
			glow.Transparency = 0.25
			for _, sx in { -1, 1 } do
				noShadow(addPart(model, { Name = "Shutter", Size = V3(0.8, 1.4, 0.12), CFrame = at * CFrame.new(sx * 1.2, 0, -0.35) * CFrame.Angles(0, sx * math.rad(-50), 0), Color = vary(Color3.fromRGB(96, 50, 38), 0.1), Material = Enum.Material.WoodPlanks, CanCollide = false }))
			end
		end
	end
	if o.lantern ~= false then
		lantern(model, cf * CFrame.new(2.8, base + 4.6, -d / 2 - 0.6))
	end

	-- dark eave trim where the roof overhangs the walls
	for _, side in { 1, -1 } do
		addPart(model, {
			Name = "Eave",
			Size = V3(w + 2.7, 0.35, 0.5),
			CFrame = cf * CFrame.new(0, wallTop + 0.05, side * (halfD - 0.1)),
			Color = Colors.DarkWood,
			CanCollide = false,
		})
	end

	-- carved dragon heads rising from both ends of the ridge
	if o.dragons ~= false and w >= 12 then
		for _, sx in { 1, -1 } do
			local root = cf * CFrame.new(sx * (w / 2 + 1.5), ridgeY + 0.4, 0)
			local neck = root
			for _ = 1, 3 do
				neck = neck * CFrame.Angles(0, 0, sx * math.rad(-18)) * CFrame.new(sx * 0.55, 0.7, 0)
				addPart(model, { Name = "Dragon", Size = V3(0.55, 1.5, 0.5), CFrame = neck, Color = Colors.DarkWood, CanCollide = false })
			end
			local head = neck * CFrame.new(sx * 0.5, 0.9, 0)
			addPart(model, { Name = "Dragon", Size = V3(1.5, 0.7, 0.6), CFrame = head, Color = Colors.DarkWood, CanCollide = false })
			addPart(model, { Name = "Dragon", Size = V3(0.5, 0.5, 0.15), CFrame = head * CFrame.new(-sx * 0.3, 0.5, 0) * CFrame.Angles(0, 0, sx * 0.5), Color = Colors.DarkWood, CanCollide = false })
			for _, ez in { 0.32, -0.32 } do
				addPart(model, { Name = "DragonEye", Shape = Enum.PartType.Ball, Size = Vector3.one * 0.16, CFrame = head * CFrame.new(sx * 0.35, 0.12, ez), Color = Color3.fromRGB(220, 160, 60), Material = Enum.Material.Neon, CanCollide = false })
			end
		end
	end

	-- painted round shields hung along both long walls
	if o.shields ~= false then
		local palette = { Color3.fromRGB(150, 40, 36), Color3.fromRGB(226, 214, 186), Color3.fromRGB(46, 70, 120), Color3.fromRGB(196, 150, 60) }
		local count = math.max(2, math.floor(w / 7))
		for _, side in { 1, -1 } do
			for k = 1, count do
				local x = -w / 2 + (k - 0.5) * (w / count)
				if side == 1 or math.abs(x) > 3 then -- keep the door clear
					local at = cf * CFrame.new(x, base + wallH * 0.62, side * (d / 2 + 0.7)) * CFrame.Angles(0, math.pi / 2, 0)
					addPart(model, { Name = "Shield", Shape = Enum.PartType.Cylinder, Size = V3(0.25, 2.2, 2.2), CFrame = at, Color = palette[(k + (side == 1 and 0 or 2)) % #palette + 1], Material = Enum.Material.Wood, CanCollide = false })
					addPart(model, { Name = "ShieldBoss", Shape = Enum.PartType.Ball, Size = Vector3.one * 0.55, CFrame = at * CFrame.new(side * 0.15, 0, 0), Color = Colors.Iron, Material = Enum.Material.Metal, CanCollide = false })
				end
			end
		end
	end
	if o.smoke then
		smoke(model, cf * CFrame.new(w * 0.22, ridgeY + 0.6, 0))
	end
end

local function logPile(model, cf: CFrame)
	local offsets = { V3(0, 0.6, -1.3), V3(0, 0.6, 0), V3(0, 0.6, 1.3), V3(0, 1.7, -0.65), V3(0, 1.7, 0.65), V3(0, 2.8, 0) }
	for i, offset in offsets do
		addPart(model, {
			Name = "Log" .. i,
			Shape = Enum.PartType.Cylinder,
			Size = V3(6, 1.2, 1.2),
			CFrame = cf * CFrame.new(offset),
			Color = i % 2 == 0 and Colors.Wood or Colors.DarkWood,
		})
	end
end

local function fence(model, w: number, d: number, gapSide: boolean?)
	-- posts every ~4 studs with two rails, leaving a gap on the -Z side
	local hw, hd = w / 2 - 0.6, d / 2 - 0.6
	local corners = { V3(-hw, 0, -hd), V3(hw, 0, -hd), V3(hw, 0, hd), V3(-hw, 0, hd) }
	for i = 1, 4 do
		local a, b = corners[i], corners[i % 4 + 1]
		local len = (b - a).Magnitude
		local mid = (a + b) / 2
		local isGap = gapSide and i == 1
		local n = math.max(1, math.floor(len / 4))
		for j = 0, n do
			local p = a:Lerp(b, j / n)
			post(model, p, 2.6, 0.45)
		end
		if not isGap then
			for _, y in { 1, 2.1 } do
				addPart(model, {
					Name = "Rail",
					Size = V3(len, 0.25, 0.25),
					CFrame = CFrame.lookAt(mid + V3(0, y, 0), b + V3(0, y, 0)) * CFrame.Angles(0, math.pi / 2, 0),
					Color = Colors.Weathered,
				})
			end
		end
	end
end

local Builders = {}

local function campfire(model, pos: Vector3)
	for i = 1, 8 do
		local a = i / 8 * math.pi * 2
		addPart(model, {
			Name = "FireStone",
			Size = V3(0.9, 0.6, 0.9),
			CFrame = CFrame.new(pos + V3(math.cos(a) * 1.5, 0.3, math.sin(a) * 1.5)) * CFrame.Angles(0, a, 0),
			Color = Colors.Stone,
			Material = Enum.Material.Slate,
		})
	end
	for i = 1, 3 do
		addPart(model, {
			Name = "FireLog",
			Size = V3(0.4, 0.4, 2.2),
			CFrame = CFrame.new(pos + V3(0, 0.4, 0)) * CFrame.Angles(0, i * math.pi / 3, 0.15),
			Color = Colors.DarkWood,
			CanCollide = false,
		})
	end
	local core = addPart(model, {
		Name = "Embers",
		Size = V3(1, 0.3, 1),
		Position = pos + V3(0, 0.3, 0),
		Color = Color3.fromRGB(255, 110, 40),
		Material = Enum.Material.Neon,
		CanCollide = false,
	})
	local fire = Instance.new("Fire")
	fire.Size = 3
	fire.Heat = 6
	fire.Color = Color3.fromRGB(255, 140, 50)
	fire.SecondaryColor = Color3.fromRGB(255, 60, 20)
	fire.Parent = core
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 150, 70)
	light.Range = 22
	light.Brightness = 2
	light.Shadows = true
	light.Parent = core
end
ModelFactory.campfire = campfire

-- A tall iron fire basket on three legs, for halls and gates. Its parts are
-- marked KeepWithMesh, so they stay when a mesh replaces the building.
local function brazier(model, pos: Vector3, height: number?)
	local h = height or 4.2
	local parts = {}
	for i = 1, 3 do
		local a = i / 3 * math.pi * 2
		local foot = pos + V3(math.cos(a) * 1.1, 0, math.sin(a) * 1.1)
		local top = pos + V3(0, h, 0)
		local mid = (foot + top) / 2
		table.insert(parts, addPart(model, { Name = "BrazierLeg", Size = V3(0.22, (top - foot).Magnitude, 0.22), CFrame = CFrame.lookAt(mid, top) * CFrame.Angles(math.rad(90), 0, 0), Color = Colors.Iron, Material = Enum.Material.Metal, CanCollide = false }))
	end
	table.insert(parts, addPart(model, { Name = "BrazierBowl", Shape = Enum.PartType.Cylinder, Size = V3(0.7, 2.2, 2.2), CFrame = CFrame.new(pos + V3(0, h + 0.2, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(46, 44, 44), Material = Enum.Material.Metal, CanCollide = false }))
	local coals = addPart(model, { Name = "BrazierCoals", Size = V3(1.5, 0.3, 1.5), Position = pos + V3(0, h + 0.6, 0), Color = Color3.fromRGB(255, 110, 40), Material = Enum.Material.Neon, CanCollide = false })
	table.insert(parts, coals)
	local fire = Instance.new("Fire")
	fire.Size = 3.5
	fire.Heat = 9
	fire.Color = Color3.fromRGB(255, 140, 50)
	fire.SecondaryColor = Color3.fromRGB(255, 60, 20)
	fire.Parent = coals
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 150, 70)
	light.Range = 26
	light.Brightness = 2.2
	light.Shadows = true
	light.Parent = coals
	for _, part in parts do
		part:SetAttribute("KeepWithMesh", true)
	end
	return coals
end
ModelFactory.brazier = brazier

function Builders.Longhouse(model, w, d)
	hall(model, CFrame.new(), { w = w - 4, d = d - 5, wallH = 7, roof = "thatch", smoke = true })
	campfire(model, V3(-w / 2 + 4, 0, -d / 2 + 1.2))
	-- a carved post with a banner by the door
	post(model, V3(w / 2 - 4, 0, -d / 2 + 1), 9, 0.5)
	addPart(model, { Name = "Banner", Size = V3(0.15, 3.6, 2), Position = V3(w / 2 - 4, 6.6, -d / 2 + 2.1), Color = Color3.fromRGB(150, 40, 36), Material = Enum.Material.Fabric, CanCollide = false })
	-- barrels and a chopping block by the door
	for i, x in { 3.4, 4.6 } do
		addPart(model, { Name = "Barrel", Shape = Enum.PartType.Cylinder, Size = V3(1.8, 1.4, 1.4), CFrame = CFrame.new(x, 1.9, -d / 2 + 2.2 + i * 0.2) * CFrame.Angles(0, 0, math.pi / 2), Color = Color3.fromRGB(120, 84, 52) })
	end
	addPart(model, { Name = "Block", Shape = Enum.PartType.Cylinder, Size = V3(1.2, 1.6, 1.6), CFrame = CFrame.new(-4.5, 1.6, -d / 2 + 2.4) * CFrame.Angles(0, 0, math.pi / 2), Color = Colors.Wood })
end

function Builders.Cottage(model, w, d)
	-- A steep A-frame: the roof reaches the ground, ridge runs along local Z.
	local base = 0.8
	addPart(model, {
		Name = "Foundation",
		Size = V3(w - 2, base, d - 2),
		Position = V3(0, base / 2, 0),
		Color = Colors.Stone,
		Material = Enum.Material.Cobblestone,
	})
	local depth = d - 3
	local halfW = (w - 3) / 2
	local angle = math.rad(62)
	local rise = halfW * math.tan(angle)
	local slope = halfW / math.cos(angle) + 0.4
	for _, side in { 1, -1 } do
		local slab = addPart(model, {
			Name = "Roof",
			Size = V3(slope, 0.9, depth + 1.6),
			CFrame = CFrame.new(side * halfW / 2, base + rise / 2, 0) * CFrame.Angles(0, 0, -side * angle),
			Color = Colors.Shingle:Lerp(Color3.new(0, 0, 0), 0.25),
			Material = Enum.Material.WoodPlanks,
		})
		local rows = math.max(4, math.floor(slope / 1.5))
		local rowLen = slope / rows
		for r = 1, rows do
			noShadow(addPart(model, {
				Name = "RoofCourse",
				Size = V3(rowLen + 0.45, 0.28, depth + 1.7),
				CFrame = slab.CFrame * CFrame.new(side * (slope / 2 - (r - 0.5) * rowLen), 0.6 + 0.02 * r, 0) * CFrame.Angles(0, 0, side * math.rad(-4)),
				Color = vary(Colors.Shingle, 0.12),
				Material = Enum.Material.WoodPlanks,
				CanCollide = false,
			}))
		end
	end
	local steps = 7
	local stepH = rise / steps
	for _, sz in { 1, -1 } do
		for k = 1, steps do
			local hw = halfW * (1 - (k - 0.5) / steps)
			addPart(model, {
				Name = "Gable",
				Size = V3(hw * 2, stepH + 0.05, 0.6),
				Position = V3(0, base + (k - 0.5) * stepH, sz * depth / 2),
				Color = Colors.Wood,
				Material = Enum.Material.WoodPlanks,
			})
		end
	end
	-- crossed boards on the front gable
	for _, side in { 1, -1 } do
		addPart(model, {
			Name = "GableBoard",
			Size = V3(slope + 3, 0.6, 0.5),
			CFrame = CFrame.new(0, base + rise, -depth / 2 - 0.9) * CFrame.Angles(0, 0, -side * angle) * CFrame.new(side * (slope / 2 - 1.5), 0, 0),
			Color = Colors.DarkWood,
		})
	end
	addPart(model, { Name = "Door", Size = V3(2.6, 4.4, 0.3), Position = V3(0, base + 2.2, -depth / 2 - 0.4), Color = Color3.fromRGB(60, 40, 28), Material = Enum.Material.WoodPlanks })
	addPart(model, { Name = "Window", Size = V3(1.2, 1.2, 0.2), Position = V3(0, base + 6.5, -depth / 2 - 0.35), Color = Colors.Lantern, Material = Enum.Material.Neon })
	lantern(model, CFrame.new(2.2, base + 3.6, -depth / 2 - 0.8))
	smoke(model, CFrame.new(0, base + rise + 0.3, depth / 4))
end

function Builders.Woodcutter(model, w, d)
	hall(model, CFrame.new(-2, 0, 2.5), { w = 9, d = 7, wallH = 5, roof = "shingle", smoke = false })
	logPile(model, CFrame.new(3, 0, -4.5))
	addPart(model, {
		Name = "Stump",
		Shape = Enum.PartType.Cylinder,
		Size = V3(1.4, 2.2, 2.2),
		CFrame = CFrame.new(5, 0.7, 3) * CFrame.Angles(0, 0, math.pi / 2),
		Color = Colors.Wood,
	})
	-- an axe stuck in the stump
	addPart(model, { Size = V3(0.25, 2.2, 0.25), CFrame = CFrame.new(5, 2.4, 3) * CFrame.Angles(0, 0, 0.5), Color = Colors.Wood })
	addPart(model, { Size = V3(0.9, 0.7, 0.15), CFrame = CFrame.new(5.3, 1.6, 3), Color = Colors.Iron, Material = Enum.Material.Metal })
end

function Builders.Quarry(model, w, d)
	addPart(model, {
		Size = V3(w - 1, 0.4, d - 1),
		Position = V3(0, 0.2, 0),
		Color = Color3.fromRGB(110, 108, 104),
		Material = Enum.Material.Slate,
	})
	local blocks = {
		{ V3(-3, 1.5, -3), V3(4, 2.6, 3) },
		{ V3(3, 1.2, -2), V3(3, 2, 3) },
		{ V3(-2.5, 2.2, 3), V3(5, 4, 4) },
		{ V3(4, 0.9, 4), V3(2, 1.4, 2) },
		{ V3(0.5, 0.8, 0), V3(2.4, 1.2, 1.6) },
	}
	for _, b in blocks do
		addPart(model, { Size = b[2], Position = b[1], Color = Colors.Stone, Material = Enum.Material.Slate })
	end
	-- wooden lifting crane
	post(model, V3(5.5, 0, -5.5), 8, 0.7)
	addPart(model, { Size = V3(0.5, 0.5, 7), Position = V3(5.5, 7.8, -2.5), Color = Colors.DarkWood })
	addPart(model, { Size = V3(0.12, 4, 0.12), Position = V3(5.5, 5.8, 0.6), Color = Colors.Thatch, Material = Enum.Material.Fabric })
	addPart(model, { Size = V3(1.2, 1, 1.2), Position = V3(5.5, 3.3, 0.6), Color = Colors.Stone, Material = Enum.Material.Slate })
end

function Builders.Farm(model, w, d)
	addPart(model, {
		Size = V3(w - 1, 0.3, d - 1),
		Position = V3(0, 0.15, 0),
		Color = Colors.Soil,
		Material = Enum.Material.Ground,
	})
	local rows = 8
	for i = 1, rows do
		local z = -d / 2 + 2.2 + (i - 1) * ((d - 4.4) / (rows - 1))
		addPart(model, {
			Name = "Barley",
			Size = V3(w - 4, 1.2, 1.5),
			Position = V3(0, 0.9, z),
			Color = i % 2 == 0 and Colors.Barley or Color3.fromRGB(184, 168, 84),
			Material = Enum.Material.Grass,
		})
	end
	fence(model, w, d, true)
	-- scarecrow
	post(model, V3(w / 4, 0, d / 4 - 1), 5, 0.3, Colors.Wood)
	addPart(model, { Size = V3(3, 0.3, 0.3), Position = V3(w / 4, 4, d / 4 - 1), Color = Colors.Wood })
	addPart(model, { Size = V3(1.3, 1.8, 0.6), Position = V3(w / 4, 3.4, d / 4 - 1), Color = Color3.fromRGB(120, 60, 50), Material = Enum.Material.Fabric })
	addPart(model, { Shape = Enum.PartType.Ball, Size = Vector3.one * 1, Position = V3(w / 4, 5.1, d / 4 - 1), Color = Colors.Thatch, Material = Enum.Material.Fabric })
end

function Builders.Storehouse(model, w, d)
	-- raised on stilts to keep goods dry; ridge along the long Z side
	for _, x in { -1, 1 } do
		for _, z in { -1, 0, 1 } do
			post(model, V3(x * (w / 2 - 2.5), 0, z * (d / 2 - 3)), 2, 1)
		end
	end
	hall(model, CFrame.new(0, 1, 0) * CFrame.Angles(0, math.pi / 2, 0), { w = d - 5, d = w - 5, wallH = 6, roof = "shingle", smoke = false })
	for i, pos in { V3(-4, 1, -10.3), V3(-1.6, 1, -10.3), V3(4.5, 1, -10.3) } do
		addPart(model, {
			Name = "Crate" .. i,
			Size = V3(2, 2, 2),
			Position = pos,
			Color = Colors.Wood,
			Material = Enum.Material.WoodPlanks,
		})
	end
	addPart(model, {
		Name = "Barrel",
		Shape = Enum.PartType.Cylinder,
		Size = V3(2.2, 1.8, 1.8),
		CFrame = CFrame.new(5.5, 1.1, 9.5) * CFrame.Angles(0, 0, math.pi / 2),
		Color = Colors.Wood,
	})
end

function Builders.Palisade(model, w, d)
	-- five sharpened logs in a row along local X, tied with a beam
	local n = 5
	for i = 1, n do
		local x = -w / 2 + (i - 0.5) * (w / n)
		local h = 8 + ((i * 37) % 7) / 6
		post(model, V3(x, 0, 0), h, 1.55, i % 2 == 0 and Colors.Wood or Colors.Weathered)
		addPart(model, {
			Name = "Point",
			Size = V3(1.05, 1.05, 1.05),
			CFrame = CFrame.new(x, h, 0) * CFrame.Angles(math.pi / 4, 0, math.pi / 4),
			Color = Colors.Weathered,
		})
	end
	addPart(model, { Name = "Beam", Size = V3(w, 0.5, 0.4), Position = V3(0, 3, 0.9), Color = Colors.DarkWood })
	addPart(model, { Name = "Beam", Size = V3(w, 0.5, 0.4), Position = V3(0, 6, 0.9), Color = Colors.DarkWood })
end

-- Decorations (one cell each) ---------------------------------------------------

local function flameAt(model, pos: Vector3, size: number, range: number)
	local flame = noShadow(addPart(model, { Name = "Pitch", Size = V3(0.5, 0.2, 0.5), Position = pos, Color = Color3.fromRGB(255, 120, 40), Material = Enum.Material.Neon, CanCollide = false }))
	flame:SetAttribute("KeepWithMesh", true)
	local fire = Instance.new("Fire")
	fire.Size = size
	fire.Heat = 5
	fire.Color = Color3.fromRGB(255, 140, 50)
	fire.SecondaryColor = Color3.fromRGB(255, 60, 20)
	fire.Parent = flame
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 150, 70)
	light.Range = range
	light.Brightness = 1.5
	light.Parent = flame
	return flame
end

function Builders.DecorTorch(model, _w, _d)
	post(model, V3(0, 0, 0), 5.2, 0.45, Colors.DarkWood)
	addPart(model, { Name = "Wrap", Shape = Enum.PartType.Cylinder, Size = V3(0.5, 0.55, 0.55), CFrame = CFrame.new(0, 3.6, 0) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(110, 78, 50), Material = Enum.Material.Fabric })
	noShadow(addPart(model, { Name = "Cup", Shape = Enum.PartType.Cylinder, Size = V3(0.6, 1, 1), CFrame = CFrame.new(0, 5.4, 0) * CFrame.Angles(0, 0, math.rad(90)), Color = Colors.Iron, Material = Enum.Material.Metal, CanCollide = false }))
	flameAt(model, V3(0, 5.75, 0), 1.8, 18)
	-- a few stones round the foot
	for i = 1, 4 do
		local a = i / 4 * math.pi * 2 + 0.4
		addPart(model, { Name = "Stone", Size = V3(0.8, 0.5, 0.7), CFrame = CFrame.new(math.cos(a) * 0.7, 0.25, math.sin(a) * 0.7) * CFrame.Angles(0, a, 0), Color = vary(Colors.Stone, 0.1), Material = Enum.Material.Slate })
	end
end

function Builders.DecorBrazier(model, _w, _d)
	brazier(model, V3(0, 0, 0), 3.4)
	-- a ring of flagstones under it
	addPart(model, { Name = "Flag", Shape = Enum.PartType.Cylinder, Size = V3(0.25, 5.5, 5.5), CFrame = CFrame.new(0, 0.12, 0) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(96, 96, 94), Material = Enum.Material.Slate })
end

function Builders.DecorRuneStone(model, _w, _d)
	-- a tall grey slab, slightly tapered, with a red-painted serpent band of runes
	local grey = Color3.fromRGB(118, 120, 120)
	addPart(model, { Name = "Stone", Size = V3(3.2, 4.2, 1.1), Position = V3(0, 2.1, 0), Color = grey, Material = Enum.Material.Slate })
	addPart(model, { Name = "Stone", Size = V3(2.6, 2.2, 1.0), Position = V3(0, 5.2, 0), Color = grey, Material = Enum.Material.Slate })
	addPart(model, { Name = "Stone", Size = V3(1.6, 0.9, 0.9), Position = V3(0, 6.7, 0), Color = grey, Material = Enum.Material.Slate })
	local red = Color3.fromRGB(150, 44, 36)
	-- the serpent's band running up both sides and over the top
	for _, x in { -1.15, 1.15 } do
		noShadow(addPart(model, { Name = "Band", Size = V3(0.3, 5.4, 0.08), Position = V3(x * (x > 0 and 0.95 or 1), 3.3, -0.58), Color = red, CanCollide = false }))
	end
	noShadow(addPart(model, { Name = "Band", Size = V3(2.0, 0.3, 0.08), Position = V3(0, 6.1, -0.58), Color = red, CanCollide = false }))
	-- rune marks inside the band
	for i = 0, 5 do
		noShadow(addPart(model, { Name = "Rune", Size = V3(0.12, 0.55, 0.06), CFrame = CFrame.new(-0.55 + (i % 3) * 0.55, 2 + math.floor(i / 3) * 1.3, -0.57) * CFrame.Angles(0, 0, math.rad((i % 2 == 0) and 20 or -15)), Color = Color3.fromRGB(40, 36, 34), CanCollide = false }))
	end
	-- moss at the foot
	addPart(model, { Name = "Moss", Size = V3(3.6, 0.3, 1.6), Position = V3(0, 0.15, 0), Color = Color3.fromRGB(74, 98, 48), Material = Enum.Material.Grass, CanCollide = false })
end

function Builders.DecorBanner(model, _w, _d)
	post(model, V3(0, 0, 0), 11, 0.4, Colors.DarkWood)
	addPart(model, { Name = "BannerPole", Size = V3(3.2, 0.25, 0.25), Position = V3(1.4, 10.4, 0), Color = Colors.DarkWood, CanCollide = false })
	noShadow(addPart(model, { Name = "BannerCloth", Size = V3(2.8, 5.6, 0.1), Position = V3(1.5, 7.5, 0), Color = Color3.fromRGB(122, 30, 30), Material = Enum.Material.Fabric, CanCollide = false }))
	noShadow(addPart(model, { Name = "BannerCloth", Size = V3(0.5, 5.6, 0.12), Position = V3(1.5, 7.5, -0.02), Color = Color3.fromRGB(196, 160, 80), Material = Enum.Material.Fabric, CanCollide = false }))
	-- a raven-wing finial
	addPart(model, { Name = "Finial", Size = V3(0.7, 0.7, 0.2), CFrame = CFrame.new(0, 11.3, 0) * CFrame.Angles(0, 0, math.rad(45)), Color = Colors.Iron, Material = Enum.Material.Metal })
end

function Builders.DecorShieldRack(model, _w, _d)
	for _, x in { -2.6, 2.6 } do
		post(model, V3(x, 0, 0), 4, 0.35, Colors.DarkWood)
	end
	addPart(model, { Name = "Rail", Size = V3(5.8, 0.3, 0.3), Position = V3(0, 3.4, 0), Color = Colors.DarkWood })
	addPart(model, { Name = "Rail", Size = V3(5.8, 0.3, 0.3), Position = V3(0, 0.8, 0.3), Color = Colors.DarkWood })
	local palette = { Color3.fromRGB(150, 40, 36), Color3.fromRGB(196, 160, 80), Color3.fromRGB(52, 76, 112) }
	for i, x in { -1.7, 0, 1.7 } do
		local at = CFrame.new(x, 2.1, -0.35) * CFrame.Angles(math.rad(-8), math.pi / 2, 0)
		addPart(model, { Name = "Shield", Shape = Enum.PartType.Cylinder, Size = V3(0.22, 2.4, 2.4), CFrame = at, Color = palette[i], Material = Enum.Material.Wood })
		addPart(model, { Name = "ShieldBoss", Shape = Enum.PartType.Ball, Size = Vector3.one * 0.6, CFrame = at * CFrame.new(-0.15, 0, 0), Color = Colors.Iron, Material = Enum.Material.Metal })
	end
	-- spears leaning behind
	for _, x in { -2.1, -0.8, 0.9, 2.2 } do
		local at = CFrame.new(x, 3, 0.5) * CFrame.Angles(math.rad(-10), 0, math.rad(x * 2))
		addPart(model, { Name = "Spear", Size = V3(0.15, 6, 0.15), CFrame = at, Color = Colors.Wood, CanCollide = false })
		addPart(model, { Name = "SpearHead", Size = V3(0.25, 0.8, 0.08), CFrame = at * CFrame.new(0, 3.3, 0), Color = Color3.fromRGB(176, 180, 186), Material = Enum.Material.Metal, CanCollide = false })
	end
end

function Builders.DecorTotem(model, _w, _d)
	-- a stout post with three stacked faces, outstretched wings and a raven on top
	post(model, V3(0, 0, 0), 9, 1.3, Color3.fromRGB(96, 70, 48))
	for i, y in { 2.2, 4.6, 7.0 } do
		local face = Color3.fromRGB(116, 84, 56):Lerp(Color3.new(0, 0, 0), i * 0.05)
		addPart(model, { Name = "Face", Size = V3(1.5, 1.6, 0.4), Position = V3(0, y, -0.55), Color = face, Material = Enum.Material.Wood })
		for _, x in { -0.35, 0.35 } do
			noShadow(addPart(model, { Name = "Eye", Size = V3(0.3, 0.2, 0.1), Position = V3(x, y + 0.3, -0.78), Color = i == 2 and Color3.fromRGB(196, 160, 80) or Color3.fromRGB(30, 26, 24), CanCollide = false }))
		end
		noShadow(addPart(model, { Name = "Mouth", Size = V3(0.7, 0.15, 0.1), Position = V3(0, y - 0.45, -0.78), Color = Color3.fromRGB(150, 40, 36), CanCollide = false }))
	end
	for _, x in { -1, 1 } do
		addPart(model, { Name = "Wing", Size = V3(2.2, 0.5, 0.3), CFrame = CFrame.new(x * 1.4, 8.2, 0) * CFrame.Angles(0, 0, math.rad(x * 20)), Color = Colors.DarkWood, Material = Enum.Material.Wood })
	end
	local raven = Color3.fromRGB(28, 28, 32)
	addPart(model, { Name = "Raven", Shape = Enum.PartType.Ball, Size = V3(0.9, 0.9, 0.9), Position = V3(0, 9.4, 0), Color = raven })
	addPart(model, { Name = "Raven", Size = V3(0.6, 0.4, 1.2), Position = V3(0, 9.3, 0.4), Color = raven })
	addPart(model, { Name = "Beak", Size = V3(0.2, 0.2, 0.5), Position = V3(0, 9.5, -0.6), Color = Color3.fromRGB(60, 56, 50) })
end

function Builders.DecorAntlers(model, _w, _d)
	for _, x in { -3, 3 } do
		post(model, V3(x, 0, 0), 7.5, 0.6, Colors.DarkWood)
	end
	addPart(model, { Name = "Beam", Size = V3(7.4, 0.6, 0.6), Position = V3(0, 7.6, 0), Color = Colors.DarkWood })
	local bone = Color3.fromRGB(220, 205, 180)
	addPart(model, { Name = "Skull", Size = V3(0.9, 0.9, 1.2), Position = V3(0, 8.3, -0.2), Color = bone })
	for _, x in { -1, 1 } do
		for k = 0, 2 do
			addPart(model, { Name = "Antler", Size = V3(0.18, 1.6 - k * 0.3, 0.18), CFrame = CFrame.new(x * (0.6 + k * 0.5), 9 + k * 0.45, -0.2) * CFrame.Angles(0, 0, -x * (0.5 + k * 0.25)), Color = bone, CanCollide = false })
		end
	end
	flameAt(model, V3(-3, 7.9, -0.6), 1.2, 12)
	flameAt(model, V3(3, 7.9, -0.6), 1.2, 12)
end

function Builders.DecorWoodpile(model, _w, _d)
	for row = 0, 2 do
		for i = 0, 4 - row do
			addPart(model, {
				Name = "Log",
				Shape = Enum.PartType.Cylinder,
				Size = V3(4.2, 0.9, 0.9),
				CFrame = CFrame.new(0, 0.45 + row * 0.8, -1.8 + i * 0.9 + row * 0.45) * CFrame.Angles(0, 0, 0),
				Color = (i + row) % 2 == 0 and Colors.Wood or Color3.fromRGB(150, 112, 74),
				Material = Enum.Material.Wood,
			})
		end
	end
	addPart(model, { Name = "Axe", Size = V3(0.15, 0.15, 2.4), CFrame = CFrame.new(2.6, 0.8, 1.5) * CFrame.Angles(math.rad(50), 0, 0), Color = Colors.Wood, CanCollide = false })
end

-- A gateway: two thick posts, a lintel with carved dragon heads, and the
-- doors swung open. The way through runs along local Z.
function Builders.PalisadeGate(model, w, _d)
	local half = w / 2
	for _, x in { -half + 0.9, half - 0.9 } do
		post(model, V3(x, 0, 0), 10.5, 1.8, Colors.DarkWood)
		addPart(model, { Name = "Point", Size = V3(1.25, 1.25, 1.25), CFrame = CFrame.new(x, 10.6, 0) * CFrame.Angles(math.pi / 4, 0, math.pi / 4), Color = Colors.Weathered })
	end
	addPart(model, { Name = "Lintel", Size = V3(w + 0.6, 1, 1.2), Position = V3(0, 9.2, 0), Color = Colors.DarkWood, Material = Enum.Material.Wood })
	for _, x in { -1, 1 } do
		addPart(model, { Name = "Dragon", Size = V3(0.7, 0.7, 1.6), CFrame = CFrame.new(x * (half + 0.4), 9.9, 0) * CFrame.Angles(math.rad(35), 0, 0), Color = Color3.fromRGB(150, 40, 36), Material = Enum.Material.Wood, CanCollide = false })
		-- a door swung back against the inside of each post
		local door = addPart(model, { Name = "Door", Size = V3(0.4, 7.5, 2.8), CFrame = CFrame.new(x * (half - 1.4), 3.9, 2.4), Color = Colors.Wood, Material = Enum.Material.WoodPlanks, CanCollide = false })
		addPart(model, { Name = "Band", Size = V3(0.45, 0.3, 2.9), CFrame = door.CFrame * CFrame.new(0, 2, 0), Color = Colors.Iron, Material = Enum.Material.Metal, CanCollide = false })
		addPart(model, { Name = "Band", Size = V3(0.45, 0.3, 2.9), CFrame = door.CFrame * CFrame.new(0, -2, 0), Color = Colors.Iron, Material = Enum.Material.Metal, CanCollide = false })
	end
	-- a shield over the way through
	addPart(model, { Name = "Shield", Shape = Enum.PartType.Cylinder, Size = V3(0.25, 1.8, 1.8), CFrame = CFrame.new(0, 9.2, -0.75) * CFrame.Angles(0, math.pi / 2, 0), Color = Color3.fromRGB(196, 160, 80), Material = Enum.Material.Wood, CanCollide = false })
end

-- A palisade piece shaped by its neighbours: `arms` says which sides join on
-- ({ E, W, S, N } along +X, -X, +Z, -Z). A centre log and a run of logs out to
-- each joined side, so straight walls, corners, T's and crossings all close up.
-- A piece with nothing beside it runs along X. Built in world axes at the origin.
function ModelFactory.palisadeJoined(arms: { boolean }, seed: number?): Model
	local model = Instance.new("Model")
	model.Name = "Palisade"
	local rng = Random.new(seed or 1)
	local half = CELL / 2
	local dirs = { V3(1, 0, 0), V3(-1, 0, 0), V3(0, 0, 1), V3(0, 0, -1) }
	local any = arms[1] or arms[2] or arms[3] or arms[4]
	local use = any and arms or { true, true, false, false }
	local function log(at: Vector3, i: number)
		local h = 8 + rng:NextNumber(0, 1.2)
		post(model, at, h, 1.55, i % 2 == 0 and Colors.Wood or Colors.Weathered)
		addPart(model, { Name = "Point", Size = V3(1.05, 1.05, 1.05), CFrame = CFrame.new(at.X, h, at.Z) * CFrame.Angles(math.pi / 4, 0, math.pi / 4), Color = Colors.Weathered })
	end
	log(V3(0, 0, 0), 0)
	for k, on in use do
		if on then
			local dir = dirs[k]
			-- two more logs out to the edge; the neighbour's arm meets them there
			for i, t in { 1.6, 3.2 } do
				log(dir * t, i + k)
			end
			-- tie beams along the arm, on the inside face
			local side = V3(-dir.Z, 0, dir.X) * 0.85
			for _, y in { 3, 6 } do
				local mid = dir * (half / 2) + side + V3(0, y, 0)
				addPart(model, { Name = "Beam", Size = math.abs(dir.X) > 0 and V3(half, 0.5, 0.4) or V3(0.4, 0.5, half), Position = mid, Color = Colors.DarkWood })
			end
		end
	end
	model.WorldPivot = CFrame.new()
	return model
end

function Builders.Watchtower(model, w, d)
	-- four tall legs, a plank deck with a railing and a little shingle roof
	local h = 14
	local hw, hd = w / 2 - 2, d / 2 - 2
	for _, c in { V3(-hw, 0, -hd), V3(hw, 0, -hd), V3(-hw, 0, hd), V3(hw, 0, hd) } do
		post(model, c, h + 4, 0.9)
	end
	for _, y in { 4, 9 } do
		for _, side in { 1, -1 } do
			addPart(model, { Name = "Brace", Size = V3(hw * 2, 0.4, 0.4), Position = V3(0, y, side * hd), Color = Colors.DarkWood })
			addPart(model, { Name = "Brace", Size = V3(0.4, 0.4, hd * 2), Position = V3(side * hw, y, 0), Color = Colors.DarkWood })
		end
	end
	addPart(model, { Name = "Deck", Size = V3(hw * 2 + 3, 0.6, hd * 2 + 3), Position = V3(0, h, 0), Color = Colors.Wood, Material = Enum.Material.WoodPlanks })
	for _, side in { 1, -1 } do
		addPart(model, { Name = "Rail", Size = V3(hw * 2 + 3, 1.2, 0.3), Position = V3(0, h + 0.9, side * (hd + 1.4)), Color = Colors.DarkWood })
		addPart(model, { Name = "Rail", Size = V3(0.3, 1.2, hd * 2 + 3), Position = V3(side * (hw + 1.4), h + 0.9, 0), Color = Colors.DarkWood })
	end
	for _, side in { 1, -1 } do
		addPart(model, {
			Name = "Roof",
			Size = V3(hw * 2 + 4, 0.5, hd + 2.6),
			CFrame = CFrame.new(0, h + 4.9, side * (hd / 2 + 0.9)) * CFrame.Angles(side * math.rad(32), 0, 0),
			Color = Colors.Shingle,
			Material = Enum.Material.WoodPlanks,
		})
	end
	-- a ladder up the front
	for y = 1, h - 1, 1.5 do
		addPart(model, { Name = "Rung", Size = V3(1.8, 0.25, 0.25), Position = V3(0, y, -hd - 0.6), Color = Colors.Wood })
	end
	lantern(model, CFrame.new(hw + 1, h + 2.5, -hd - 1))
	model:SetAttribute("ArcherPost", V3(0, h + 0.4, 0))
end

local function runestone(model, pos: Vector3, h: number, turn: number)
	local stone = addPart(model, {
		Name = "Runestone",
		Size = V3(2.4, h, 0.9),
		CFrame = CFrame.new(pos + V3(0, h / 2, 0)) * CFrame.Angles(0, turn, 0.04),
		Color = Color3.fromRGB(120, 120, 116),
		Material = Enum.Material.Slate,
	})
	-- carved band of runes, faintly glowing
	addPart(model, {
		Name = "Runes",
		Size = V3(0.25, h * 0.8, 0.95),
		CFrame = stone.CFrame * CFrame.new(-0.6, 0, 0),
		Color = Color3.fromRGB(110, 170, 230),
		Material = Enum.Material.Neon,
		CanCollide = false,
	}).Transparency = 0.55
	return stone
end

function Builders.LoreHall(model, w, d)
	hall(model, CFrame.new(0, 0, 2), { w = w - 4, d = d - 7, wallH = 6, roof = "turf", smoke = true })
	runestone(model, V3(-6, 0, -d / 2 + 2), 5, 0.2)
	runestone(model, V3(6, 0, -d / 2 + 2), 4.2, -0.25)
	-- carved story pole by the door
	post(model, V3(0, 0, -d / 2 + 1.4), 7, 0.6, Colors.Weathered)
	addPart(model, { Name = "Carving", Size = V3(0.9, 1.2, 0.9), Position = V3(0, 7.2, -d / 2 + 1.4), Color = Color3.fromRGB(150, 40, 36), Material = Enum.Material.Wood })
end

function Builders.Smithy(model, w, d)
	-- an open-sided forge shed: four posts and a shingle roof
	for _, x in { -1, 1 } do
		for _, z in { -1, 1 } do
			post(model, V3(x * (w / 2 - 1.5), 0, z * (d / 2 - 1.5)), 7, 0.8)
		end
	end
	addPart(model, { Name = "Floor", Size = V3(w - 1, 0.4, d - 1), Position = V3(0, 0.2, 0), Color = Color3.fromRGB(80, 74, 66), Material = Enum.Material.Cobblestone })
	for _, side in { 1, -1 } do
		addPart(model, {
			Name = "Roof",
			Size = V3(w + 1, 0.8, d / 2 + 2),
			CFrame = CFrame.new(0, 8.6, side * (d / 4)) * CFrame.Angles(side * math.rad(24), 0, 0),
			Color = Colors.Shingle,
			Material = Enum.Material.WoodPlanks,
		})
	end
	-- stone forge with glowing coals
	addPart(model, { Name = "Forge", Size = V3(4, 3, 3.5), Position = V3(-3, 1.5, 2.5), Color = Colors.Stone, Material = Enum.Material.Cobblestone })
	local coals = addPart(model, { Name = "Coals", Size = V3(3, 0.4, 2.4), Position = V3(-3, 3.1, 2.5), Color = Color3.fromRGB(255, 100, 30), Material = Enum.Material.Neon })
	local fire = Instance.new("Fire")
	fire.Size = 3
	fire.Heat = 8
	fire.Parent = coals
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 120, 50)
	light.Range = 20
	light.Brightness = 2.5
	light.Shadows = true
	light.Parent = coals
	smoke(model, CFrame.new(-3, 9.6, 2.5))
	-- anvil on a stump
	addPart(model, { Shape = Enum.PartType.Cylinder, Size = V3(1.8, 1.8, 1.8), CFrame = CFrame.new(3, 0.9, 0) * CFrame.Angles(0, 0, math.pi / 2), Color = Colors.Wood })
	addPart(model, { Name = "Anvil", Size = V3(2.2, 0.9, 1), Position = V3(3, 2.25, 0), Color = Colors.Iron, Material = Enum.Material.Metal })
	addPart(model, { Size = V3(0.8, 0.5, 0.6), Position = V3(4.3, 2.45, 0), Color = Colors.Iron, Material = Enum.Material.Metal })
	-- quenching barrel
	addPart(model, { Shape = Enum.PartType.Cylinder, Size = V3(2.4, 2, 2), CFrame = CFrame.new(4, 1.2, 4.5) * CFrame.Angles(0, 0, math.pi / 2), Color = Colors.Wood })
end

function Builders.Shrine(model, w, d)
	-- a ring of standing stones around a carved idol, with two fire bowls
	addPart(model, { Name = "Floor", Size = V3(w - 2, 0.3, d - 2), Position = V3(0, 0.15, 0), Color = Color3.fromRGB(110, 100, 86), Material = Enum.Material.Pebble })
	for i = 1, 7 do
		local a = i / 7 * math.pi * 2
		local h = 4 + (i % 3) * 0.8
		addPart(model, {
			Name = "StandingStone",
			Size = V3(1.3, h, 0.8),
			CFrame = CFrame.new(math.cos(a) * 5.6, h / 2, math.sin(a) * 5.6) * CFrame.Angles(0, -a, 0.05),
			Color = Color3.fromRGB(116, 118, 114),
			Material = Enum.Material.Slate,
		})
	end
	post(model, V3(0, 0, 0), 8, 1, Colors.Weathered)
	addPart(model, { Name = "IdolFace", Size = V3(1.3, 1.6, 1.3), Position = V3(0, 6.6, 0), Color = Color3.fromRGB(96, 70, 48), Material = Enum.Material.Wood })
	for _, x in { -1, 1 } do
		addPart(model, { Size = V3(0.5, 3, 0.5), Position = V3(x * 1.1, 8.6, 0), CFrame = CFrame.new(x * 1.1, 8.4, 0) * CFrame.Angles(0, 0, -x * 0.5), Color = Color3.fromRGB(220, 205, 180) })
		local bowl = addPart(model, { Name = "FireBowl", Size = V3(1.4, 0.6, 1.4), Position = V3(x * 2.6, 2.3, -2.6), Color = Colors.Iron, Material = Enum.Material.Metal })
		post(model, V3(x * 2.6, 0, -2.6), 2, 0.3, Colors.Iron)
		local fire = Instance.new("Fire")
		fire.Size = 2
		fire.Heat = 6
		fire.Parent = bowl
		local light = Instance.new("PointLight")
		light.Color = Color3.fromRGB(255, 140, 60)
		light.Range = 14
		light.Brightness = 1.6
		light.Parent = bowl
	end
end

function Builders.Shipyard(model, w, d)
	-- a slipway with a longship hull taking shape on it, plus timber stacks
	addPart(model, { Name = "Slipway", Size = V3(10, 0.6, d - 2), Position = V3(-3, 0.3, 0), Color = Colors.Weathered, Material = Enum.Material.WoodPlanks })
	addPart(model, { Name = "Keel", Size = V3(1, 0.8, d - 6), Position = V3(-3, 1, 0), Color = Colors.Wood })
	for i = 1, 7 do
		local z = -d / 2 + 4 + (i - 1) * ((d - 8) / 6)
		local width = 3.5 + math.sin(i / 8 * math.pi) * 3
		for _, side in { 1, -1 } do
			addPart(model, {
				Name = "Rib",
				Size = V3(0.4, 4.5, 0.4),
				CFrame = CFrame.new(-3 + side * width / 2, 3, z) * CFrame.Angles(0, 0, side * 0.45),
				Color = Colors.Wood,
			})
		end
	end
	for _, side in { 1, -1 } do
		addPart(model, { Name = "Strake", Size = V3(0.35, 0.9, d - 10), CFrame = CFrame.new(-3 + side * 4.3, 1.6, 0) * CFrame.Angles(0, 0, side * 0.45), Color = Color3.fromRGB(96, 68, 46), Material = Enum.Material.WoodPlanks })
	end
	-- prow post rising at one end
	for k = 0, 4 do
		addPart(model, { Name = "Prow", Size = V3(0.5, 1.4, 0.8), CFrame = CFrame.new(-3, 2 + k * 1.2, -d / 2 + 2.5 - math.sin(k * 0.4) * 1.2) * CFrame.Angles(-k * 0.2, 0, 0), Color = Colors.DarkWood })
	end
	logPile(model, CFrame.new(w / 2 - 4, 0, 6) * CFrame.Angles(0, math.pi / 2, 0))
	logPile(model, CFrame.new(w / 2 - 4, 0, -6) * CFrame.Angles(0, math.pi / 2, 0))
	-- lifting frame
	post(model, V3(w / 2 - 3, 0, -d / 2 + 2), 10, 0.7)
	post(model, V3(-w / 2 + 1, 0, -d / 2 + 2), 10, 0.7)
	addPart(model, { Name = "Beam", Size = V3(w - 2, 0.6, 0.6), Position = V3(1, 10, -d / 2 + 2), Color = Colors.DarkWood })
end

function Builders.HuntingLodge(model, w, d)
	hall(model, CFrame.new(-1.5, 0, 2.5), { w = 9, d = 7, wallH = 5, roof = "thatch", smoke = true })
	-- hide drying rack
	post(model, V3(2, 0, -5), 5, 0.4)
	post(model, V3(6.5, 0, -5), 5, 0.4)
	addPart(model, { Size = V3(5, 0.3, 0.3), Position = V3(4.25, 4.8, -5), Color = Colors.DarkWood })
	for i = 1, 2 do
		addPart(model, { Name = "Hide", Size = V3(1.8, 3, 0.15), Position = V3(2.9 + (i - 1) * 2.4, 3.2, -5), Color = Color3.fromRGB(160, 116, 80), Material = Enum.Material.Fabric, CanCollide = false })
	end
	-- antlers over the door
	for _, x in { -1, 1 } do
		addPart(model, { Size = V3(0.2, 1.8, 0.2), CFrame = CFrame.new(-1.5 + x * 0.8, 6.8, -1.2) * CFrame.Angles(0, 0, -x * 0.6), Color = Color3.fromRGB(220, 205, 180) })
	end
end

function Builders.Fishery(model, w, d)
	-- a small net shed, racks of drying fish and a boat pulled up beside them
	hall(model, CFrame.new(-3, 0, 3), { w = 7, d = 6, wallH = 4.4, roof = "thatch" })
	for _, z in { -5.5, -2.5 } do
		post(model, V3(0.5, 0, z), 4.6, 0.35)
		post(model, V3(6.5, 0, z), 4.6, 0.35)
		noShadow(addPart(model, { Name = "RackBar", Size = V3(6.4, 0.25, 0.25), Position = V3(3.5, 4.4, z), Color = Colors.DarkWood }))
		for i = 0, 4 do
			noShadow(addPart(model, {
				Name = "Fish",
				Size = V3(0.5, 1.6, 0.18),
				CFrame = CFrame.new(1.2 + i * 1.15, 3.4, z) * CFrame.Angles(0, 0, math.rad(detail:NextNumber(-8, 8))),
				Color = vary(Color3.fromRGB(176, 170, 150), 0.08),
				Material = Enum.Material.SmoothPlastic,
				CanCollide = false,
			}))
		end
	end
	-- a net hung to dry over the shed wall
	noShadow(addPart(model, { Name = "Net", Size = V3(5, 2.6, 0.1), Position = V3(-3, 3, -0.1), Color = Color3.fromRGB(96, 88, 70), Material = Enum.Material.Fabric, CanCollide = false }))
	-- the boat
	for i = -2, 2 do
		local t = 1 - math.abs(i) / 3
		addPart(model, { Name = "Hull", Size = V3(2.4 * t + 0.4, 0.8, 1.1), CFrame = CFrame.new(4, 0.4, 3 + i * 1.05), Color = vary(Color3.fromRGB(96, 68, 46), 0.08), Material = Enum.Material.WoodPlanks })
	end
	for _, x in { -1, 1 } do
		noShadow(addPart(model, { Name = "Oar", Size = V3(0.2, 0.2, 4.4), CFrame = CFrame.new(4 + x * 0.5, 0.9, 3) * CFrame.Angles(0, x * 0.15, 0), Color = Colors.Wood, CanCollide = false }))
	end
	-- barrels of salted fish
	for _, p in { V3(-6, 0, -1), V3(-5, 0, -2.2) } do
		addPart(model, { Name = "Barrel", Shape = Enum.PartType.Cylinder, Size = V3(1.6, 1.2, 1.2), CFrame = CFrame.new(p + V3(0, 0.8, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(110, 76, 48), Material = Enum.Material.WoodPlanks })
	end
end

function Builders.Brewhouse(model, _w, _d)
	-- a small smoky hall with a copper vat out front and barrels of mead
	hall(model, CFrame.new(-1.5, 0, 2), { w = 9, d = 7, wallH = 4.6, roof = "thatch", smoke = true })
	addPart(model, { Name = "Vat", Shape = Enum.PartType.Cylinder, Size = V3(2.4, 3, 3), CFrame = CFrame.new(4.6, 1.2, -4.6) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(176, 110, 64), Material = Enum.Material.Metal })
	for _, x in { 3.2, 6 } do
		post(model, V3(x, 0, -4.6), 1, 0.3, Colors.DarkWood)
	end
	brazier(model, V3(4.6, 0, -2), 1.2)
	for i, p in { V3(-6, 0, -4.4), V3(-4.2, 0, -4.8), V3(-5.1, 1.6, -4.6) } do
		addPart(model, { Name = "Barrel", Shape = Enum.PartType.Cylinder, Size = V3(1.6, 1.4, 1.4), CFrame = CFrame.new(p + V3(0, 0.8, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = vary(Color3.fromRGB(116, 78, 48), 0.08), Material = Enum.Material.WoodPlanks })
		if i == 1 then
			addPart(model, { Name = "Hoop", Shape = Enum.PartType.Cylinder, Size = V3(0.12, 1.5, 1.5), CFrame = CFrame.new(p + V3(0, 0.8, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(60, 58, 56), Material = Enum.Material.Metal })
		end
	end
	-- beehive skeps by the wall
	for _, x in { -6.5, -5 } do
		addPart(model, { Name = "Skep", Shape = Enum.PartType.Ball, Size = V3(1.3, 1.3, 1.3), Position = V3(x, 0.9, 6.6), Color = Color3.fromRGB(196, 160, 88), Material = Enum.Material.Fabric })
	end
end

function Builders.GreatHall(model, w, d)
	hall(model, CFrame.new(), { w = w - 4, d = d - 6, wallH = 9, roof = "shingle", pitch = 42, smoke = true })
	-- tall carved pillars at the entrance and a pair of braziers
	for _, x in { -5, 5 } do
		post(model, V3(x, 0, -d / 2 + 2), 12, 1.1, Colors.DarkWood)
		addPart(model, { Name = "Carving", Size = V3(1.4, 1.4, 1.4), Position = V3(x, 12.4, -d / 2 + 2), Color = Color3.fromRGB(170, 130, 50), Material = Enum.Material.Wood })
	end
	brazier(model, V3(-9, 0, -d / 2 + 1.5), 4.6)
	brazier(model, V3(9, 0, -d / 2 + 1.5), 4.6)
	-- banners on poles beside the door
	for _, x in { -12.5, 12.5 } do
		local pole = addPart(model, { Name = "BannerPole", Size = V3(0.35, 10, 0.35), Position = V3(x, 5, -d / 2 + 1.5), Color = Colors.DarkWood, Material = Enum.Material.Wood })
		local bar = addPart(model, { Name = "BannerPole", Size = V3(2.6, 0.25, 0.25), Position = V3(x, 9.6, -d / 2 + 1.5), Color = Colors.DarkWood, Material = Enum.Material.Wood, CanCollide = false })
		local cloth = addPart(model, { Name = "BannerCloth", Size = V3(2.3, 4.6, 0.1), Position = V3(x, 7.2, -d / 2 + 1.4), Color = Color3.fromRGB(122, 30, 30), Material = Enum.Material.Fabric, CanCollide = false })
		local stripe = addPart(model, { Name = "BannerCloth", Size = V3(0.5, 4.6, 0.12), Position = V3(x, 7.2, -d / 2 + 1.38), Color = Color3.fromRGB(196, 160, 80), Material = Enum.Material.Fabric, CanCollide = false })
		for _, part in { pole, bar, cloth, stripe } do
			part:SetAttribute("KeepWithMesh", true)
		end
	end
	-- red and gold banners along the long wall
	for i = -2, 2 do
		addPart(model, { Name = "Banner", Size = V3(1.8, 3.4, 0.12), Position = V3(i * 6, 6.5, -(d - 6) / 2 - 0.5), Color = i % 2 == 0 and Color3.fromRGB(150, 40, 36) or Color3.fromRGB(190, 150, 60), Material = Enum.Material.Fabric, CanCollide = false })
	end
end

-- Builds a building model for `buildingType` in its unrotated orientation.
function ModelFactory.building(buildingType: string): Model
	local def = Config.Buildings[buildingType]
	local w, d = def.Size[1] * CELL, def.Size[2] * CELL
	local model = Instance.new("Model")
	model.Name = buildingType
	local builder = Builders[buildingType]
	if builder then
		builder(model, w, d)
	else
		addPart(model, { Size = V3(w - 1, 4, d - 1), Position = V3(0, 2, 0) })
	end
	model.WorldPivot = CFrame.new()
	return model
end

-- Makes a model see-through and non-solid, for the placement preview.
function ModelFactory.makeGhost(model: Model)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.Transparency = 0.45
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
			d.CastShadow = false
		elseif d:IsA("Smoke") or d:IsA("Light") then
			d.Enabled = false
		end
	end
end

-- Trees ----------------------------------------------------------------------

-- A layered pine. Returns model, trunk.
function ModelFactory.pine(rng: Random, scale: number?): (Model, BasePart)
	local s = scale or rng:NextNumber(0.85, 1.5)
	local model = Instance.new("Model")
	model.Name = "Pine"
	local trunk = post(model, Vector3.zero, 7 * s, 1.2 * s)
	trunk.Name = "Trunk"
	-- a flared root at the base
	noShadow(addPart(model, { Name = "Root", Shape = Enum.PartType.Cylinder, Size = V3(0.9 * s, 1.9 * s, 1.9 * s), CFrame = CFrame.new(0, 0.3 * s, 0) * CFrame.Angles(0, 0, math.pi / 2), Color = vary(Colors.DarkWood, 0.1), CanCollide = false }))
	local tiers = 5
	local twist = rng:NextNumber(0, math.pi)
	local tint = rng:NextNumber(-0.08, 0.08)
	local function shade(c: Color3, i: number)
		local k = 1 + tint + (i / tiers) * 0.12 + rng:NextNumber(-0.05, 0.05) -- lighter toward the sunlit top
		return Color3.new(math.clamp(c.R * k, 0, 1), math.clamp(c.G * k, 0, 1), math.clamp(c.B * k, 0, 1))
	end
	for i = 1, tiers do
		local t = (i - 1) / (tiers - 1)
		local width = (7.5 - 5.6 * t) * s
		-- two crossed, drooping layers per tier give a ragged star of boughs
		for layer = 0, 1 do
			addPart(model, {
				Name = "Needles",
				Size = V3(width * (1 - layer * 0.12), (2.4 - layer * 0.5) * s, width * (1 - layer * 0.12)),
				CFrame = CFrame.new(0, (3.6 + i * 2.5 + layer * 0.5) * s, 0) * CFrame.Angles(0, twist + i * math.pi / 4 + layer * math.pi / 4, 0) * CFrame.Angles(rng:NextNumber(-0.08, 0.08), 0, rng:NextNumber(-0.08, 0.08)),
				Color = shade(layer == 0 and Colors.Pine or Colors.PineLight, i),
				Material = Enum.Material.Grass,
				CanCollide = false,
			})
		end
	end
	addPart(model, {
		Name = "Tip",
		Size = V3(1.2 * s, 2.4 * s, 1.2 * s),
		Position = V3(0, (3.6 + tiers * 2.5 + 2) * s, 0),
		Color = Colors.Pine,
		Material = Enum.Material.Grass,
		CanCollide = false,
	})
	model.WorldPivot = CFrame.new()
	return model, trunk
end

-- A round-crowned birch. Returns model, trunk.
function ModelFactory.birch(rng: Random, scale: number?): (Model, BasePart)
	local s = scale or rng:NextNumber(0.85, 1.3)
	local model = Instance.new("Model")
	model.Name = "Birch"
	local trunk = post(model, Vector3.zero, 9 * s, 1 * s, Colors.Birch)
	trunk.Name = "Trunk"
	-- dark bark marks up the white trunk
	for i = 1, 5 do
		noShadow(addPart(model, {
			Name = "Bark",
			Size = V3(0.5 * s, 0.18 * s, 1.04 * s),
			CFrame = CFrame.new(0, (1 + i * 1.5 + rng:NextNumber(-0.4, 0.4)) * s, 0) * CFrame.Angles(0, rng:NextNumber(0, math.pi), 0) * CFrame.new(0.3 * s, 0, 0),
			Color = Color3.fromRGB(40, 38, 36),
			Material = Enum.Material.Wood,
			CanCollide = false,
		}))
	end
	-- a few branches reaching into the crown
	for i = 1, 3 do
		local a = i * 2.1
		noShadow(addPart(model, { Name = "Branch", Size = V3(0.35 * s, 3 * s, 0.35 * s), CFrame = CFrame.new(0, 7.5 * s, 0) * CFrame.Angles(0, a, 0) * CFrame.Angles(0, 0, 0.7) * CFrame.new(0, 1.3 * s, 0), Color = Colors.Birch, CanCollide = false }))
	end
	local greens = { Color3.fromRGB(96, 134, 64), Colors.Leaf, Color3.fromRGB(112, 146, 70), Color3.fromRGB(84, 120, 56) }
	for i = 1, 6 do
		local a = i * 2.4 + rng:NextNumber(0, 1)
		local r = (i == 6) and 0 or rng:NextNumber(1.2, 2.4)
		addPart(model, {
			Name = "Leaves",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * rng:NextNumber(3.6, 5.6) * s,
			Position = V3(math.cos(a) * r * s, (8.2 + (i % 3) * 1 + (i == 6 and 1.8 or 0)) * s, math.sin(a) * r * s),
			Color = vary(greens[(i % #greens) + 1], 0.06),
			Material = Enum.Material.Grass,
			CanCollide = false,
		})
	end
	model.WorldPivot = CFrame.new()
	return model, trunk
end

-- A tall, narrow spruce with drooping tiers. Returns model, trunk.
function ModelFactory.spruce(rng: Random, scale: number?): (Model, BasePart)
	local s = scale or rng:NextNumber(1, 1.6)
	local model = Instance.new("Model")
	model.Name = "Spruce"
	local trunk = post(model, Vector3.zero, 6 * s, 1 * s)
	trunk.Name = "Trunk"
	local tiers = 8
	local twist = rng:NextNumber(0, math.pi)
	noShadow(addPart(model, { Name = "Root", Shape = Enum.PartType.Cylinder, Size = V3(0.8 * s, 1.6 * s, 1.6 * s), CFrame = CFrame.new(0, 0.3 * s, 0) * CFrame.Angles(0, 0, math.pi / 2), Color = vary(Colors.DarkWood, 0.1), CanCollide = false }))
	local tint = rng:NextNumber(-0.1, 0.06)
	for i = 1, tiers do
		local t = (i - 1) / (tiers - 1)
		local width = (5.4 - 4.4 * t) * s
		local k = 1 + tint + t * 0.15 + rng:NextNumber(-0.05, 0.05)
		local base = i % 2 == 0 and Color3.fromRGB(34, 60, 42) or Color3.fromRGB(28, 52, 38)
		for layer = 0, 1 do
			addPart(model, {
				Name = "Needles",
				Size = V3(width * (1 - layer * 0.15), (1.9 - layer * 0.4) * s, width * (1 - layer * 0.15)),
				CFrame = CFrame.new(0, (2.6 + i * 1.75 + layer * 0.35) * s, 0) * CFrame.Angles(0, twist + i * 0.7 + layer * math.pi / 4, 0) * CFrame.Angles(0.12, 0, 0.12),
				Color = Color3.new(math.clamp(base.R * k, 0, 1), math.clamp(base.G * k * (1 + layer * 0.08), 0, 1), math.clamp(base.B * k, 0, 1)),
				Material = Enum.Material.Grass,
				CanCollide = false,
			})
		end
	end
	addPart(model, {
		Name = "Tip",
		Size = V3(0.8 * s, 2.6 * s, 0.8 * s),
		Position = V3(0, (2.6 + tiers * 1.75 + 1.8) * s, 0),
		Color = Color3.fromRGB(30, 56, 40),
		Material = Enum.Material.Grass,
		CanCollide = false,
	})
	model.WorldPivot = CFrame.new()
	return model, trunk
end

-- A low, dense juniper shrub.
function ModelFactory.juniper(rng: Random, scale: number?): Model
	local s = scale or rng:NextNumber(0.7, 1.3)
	local model = Instance.new("Model")
	model.Name = "Juniper"
	for i = 1, 4 do
		local h = rng:NextNumber(1.6, 3.2) * s
		addPart(model, {
			Name = "Juniper",
			Size = V3(rng:NextNumber(1.4, 2.2) * s, h, rng:NextNumber(1.4, 2.2) * s),
			CFrame = CFrame.new(rng:NextNumber(-1, 1) * s, h / 2, rng:NextNumber(-1, 1) * s) * CFrame.Angles(0, rng:NextNumber(0, 3), rng:NextNumber(-0.2, 0.2)),
			Color = Color3.fromRGB(48, 76, 56),
			Material = Enum.Material.Grass,
			CanCollide = false,
		})
	end
	model.WorldPivot = CFrame.new()
	return model
end

-- A fern: a fan of fronds close to the ground.
function ModelFactory.fern(rng: Random, scale: number?): Model
	local s = scale or rng:NextNumber(0.8, 1.4)
	local model = Instance.new("Model")
	model.Name = "Fern"
	local n = 6
	local turn = rng:NextNumber(0, math.pi)
	for i = 1, n do
		local a = turn + i / n * math.pi * 2
		addPart(model, {
			Name = "Fern",
			Size = V3(0.7 * s, 0.08, 2.6 * s),
			CFrame = CFrame.Angles(0, a, 0) * CFrame.new(0, 0.7 * s, -1.1 * s) * CFrame.Angles(math.rad(28), 0, 0),
			Color = Color3.fromRGB(70, 112, 48),
			Material = Enum.Material.Grass,
			CanCollide = false,
		})
	end
	model.WorldPivot = CFrame.new()
	return model
end

-- A boulder cluster. Returns model, main part.
function ModelFactory.boulder(rng: Random, scale: number?): (Model, BasePart)
	local s = scale or 1
	local model = Instance.new("Model")
	model.Name = "Boulder"
	local main
	for i = 1, 5 do
		local size = V3(rng:NextNumber(2.5, 5), rng:NextNumber(1.8, 3.5), rng:NextNumber(2.5, 5)) * s * (i == 1 and 1.2 or (i <= 3 and 0.8 or 0.45))
		local p = addPart(model, {
			Name = i == 1 and "Rock" or "RockBit",
			Size = size,
			CFrame = CFrame.new(rng:NextNumber(-1.5, 1.5) * s * (i - 1), size.Y / 2 - 0.4, rng:NextNumber(-1.5, 1.5) * s * (i - 1))
				* CFrame.Angles(rng:NextNumber(-0.25, 0.25), rng:NextNumber(0, math.pi), rng:NextNumber(-0.25, 0.25)),
			Color = vary(i == 1 and Colors.Stone or Color3.fromRGB(108, 110, 106), 0.1),
			Material = (i % 2 == 0) and Enum.Material.Rock or Enum.Material.Slate,
		})
		if i > 3 then
			p.CastShadow = false
		end
		main = main or p
	end
	if rng:NextNumber() < 0.6 then
		-- a cap of moss on top of the biggest stone
		local top = main.CFrame * CFrame.new(0, main.Size.Y / 2 - 0.15, 0)
		addPart(model, {
			Name = "Moss",
			Size = V3(main.Size.X * 0.85, 0.45, main.Size.Z * 0.85),
			CFrame = top,
			Color = Color3.fromRGB(84, 110, 56),
			Material = Enum.Material.LeafyGrass,
			CanCollide = false,
		})
	end
	model.WorldPivot = CFrame.new()
	return model, main
end

-- Wild resource nodes. Returns the model and the part the prompt goes on.
function ModelFactory.node(kind: string, rng: Random): (Model, BasePart)
	if kind == "Tree" then
		local r = rng:NextNumber()
		if r < 0.45 then
			return ModelFactory.pine(rng)
		elseif r < 0.75 then
			return ModelFactory.spruce(rng)
		end
		return ModelFactory.birch(rng)
	elseif kind == "Rock" then
		return ModelFactory.boulder(rng)
	end
	-- Bush
	local model = Instance.new("Model")
	model.Name = "Bush"
	local main = addPart(model, {
		Name = "Bush",
		Shape = Enum.PartType.Ball,
		Size = Vector3.one * 3.6,
		Position = V3(0, 1.4, 0),
		Color = Colors.Leaf,
		Material = Enum.Material.Grass,
	})
	for i = 1, 6 do
		local a = i / 6 * math.pi * 2
		addPart(model, {
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * 0.6,
			Position = V3(math.cos(a) * 1.55, 1.6 + (i % 2) * 0.6, math.sin(a) * 1.55),
			Color = Colors.Berry,
			Material = Enum.Material.SmoothPlastic,
			CanCollide = false,
		})
	end
	model.WorldPivot = CFrame.new()
	return model, main
end

-- A wooden jetty running along local -Z from (0,0,0), `length` studs long.
function ModelFactory.dock(length: number): Model
	local model = Instance.new("Model")
	model.Name = "Dock"
	-- plank by plank, sun-bleached and uneven
	local plank = 1.15
	for z = plank / 2, length - plank / 2, plank + 0.08 do
		addPart(model, {
			Name = "Plank",
			Size = V3(6 + detail:NextNumber(-0.2, 0.3), 0.45, plank),
			CFrame = CFrame.new(detail:NextNumber(-0.1, 0.1), 1.2 + detail:NextNumber(-0.04, 0.04), -z) * CFrame.Angles(0, detail:NextNumber(-0.015, 0.015), 0),
			Color = vary(Colors.Weathered, 0.12),
			Material = Enum.Material.WoodPlanks,
		})
	end
	-- stringers under the planks
	for _, x in { -2.2, 2.2 } do
		noShadow(addPart(model, { Name = "Stringer", Size = V3(0.5, 0.5, length), Position = V3(x, 0.8, -length / 2), Color = Colors.DarkWood }))
	end
	for z = 0, length, 6 do
		for _, x in { -2.8, 2.8 } do
			local pile = post(model, V3(x, -8, -z), 10.2, 0.8, vary(Colors.DarkWood, 0.1))
			pile.Name = "Pile"
			-- a band of rope near the top
			noShadow(addPart(model, { Name = "Rope", Shape = Enum.PartType.Cylinder, Size = V3(0.35, 0.95, 0.95), CFrame = CFrame.new(x, 1.7, -z) * CFrame.Angles(0, 0, math.pi / 2), Color = Color3.fromRGB(176, 150, 104), Material = Enum.Material.Fabric, CanCollide = false }))
		end
	end
	-- crates, a barrel and a coil of rope on the deck
	for i, at in { V3(1.6, 2.4, -6), V3(1.6, 2.4, -8.1), V3(1.7, 4.3, -7) } do
		addPart(model, { Name = "Crate" .. i, Size = V3(1.9, 1.9, 1.9), CFrame = CFrame.new(at) * CFrame.Angles(0, detail:NextNumber(-0.3, 0.3), 0), Color = vary(Colors.Wood, 0.1), Material = Enum.Material.WoodPlanks })
	end
	addPart(model, { Name = "Barrel", Shape = Enum.PartType.Cylinder, Size = V3(1.8, 1.5, 1.5), CFrame = CFrame.new(-1.8, 2.35, -10) * CFrame.Angles(0, 0, math.pi / 2), Color = Color3.fromRGB(116, 80, 50) })
	noShadow(addPart(model, { Name = "RopeCoil", Shape = Enum.PartType.Cylinder, Size = V3(0.4, 1.4, 1.4), CFrame = CFrame.new(-1.8, 1.65, -length + 3) * CFrame.Angles(0, 0, math.pi / 2), Color = Color3.fromRGB(176, 150, 104), Material = Enum.Material.Fabric, CanCollide = false }))
	-- a little rowing boat tied up at the end
	addPart(model, { Name = "Boat", Size = V3(3, 1.2, 9), Position = V3(-5.5, 0.1, -length + 4), Color = Colors.Wood, Material = Enum.Material.WoodPlanks })
	addPart(model, { Size = V3(2.2, 0.3, 7.6), Position = V3(-5.5, 0.6, -length + 4), Color = Colors.DarkWood })
	model.WorldPivot = CFrame.new()
	return model
end

-- A jetty you build yourself: a shorter dock starting at the back of its
-- cell (on the sand) and running out along -Z over the water. Its piles go
-- down to the sea bed, so it keeps its own floor (see ModelFactory.building).
local partDock = ModelFactory.dock -- the block-built one (a mesh may replace ModelFactory.dock)
function Builders.Jetty(model, _w, d)
	local dock = partDock(28)
	for _, child in dock:GetChildren() do
		child.Parent = model
	end
	dock:Destroy()
	-- the building's pivot sits on the ground (GROUND_Y); a dock's at the waterline
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.CFrame = CFrame.new(0, -Config.GROUND_Y, d / 2) * part.CFrame
		end
	end
end

-- A longship, bow toward local -Z, pivot at the waterline in the middle.
function ModelFactory.longship(length: number?, sailColor: Color3?): Model
	local L = length or 44
	local model = Instance.new("Model")
	model.Name = "Longship"
	local maxW = L * 0.2
	local segs = 12
	local segLen = L / segs
	local hullColor = Color3.fromRGB(96, 68, 46)
	for i = 1, segs do
		local t = (i - 0.5) / segs
		local width = maxW * math.sin(math.pi * t) ^ 0.55
		local z = -L / 2 + (i - 0.5) * segLen
		local rise = (math.abs(t - 0.5) * 2) ^ 3 * 2.5 -- the hull sweeps up at both ends
		addPart(model, {
			Name = "Keel",
			Size = V3(math.max(width * 0.55, 0.8), 0.5, segLen + 0.2),
			Position = V3(0, -1.2 + rise * 0.5, z),
			Color = hullColor,
			Material = Enum.Material.WoodPlanks,
		})
		for _, side in { 1, -1 } do
			for strake = 0, 1 do
				addPart(model, {
					Name = "Strake",
					Size = V3(0.35, 1.3, segLen + 0.3),
					CFrame = CFrame.new(side * (width / 2 - 0.3 + strake * 0.45), -0.4 + strake * 1.15 + rise, z) * CFrame.Angles(0, 0, side * math.rad(22 + strake * 10)),
					Color = strake == 0 and hullColor or Color3.fromRGB(80, 56, 38),
					Material = Enum.Material.WoodPlanks,
				})
			end
		end
	end
	-- curling prow and stern posts
	for _, dir in { -1, 1 } do
		for k = 0, 6 do
			local a = k / 6 * math.pi * 0.9
			addPart(model, {
				Name = dir < 0 and "Prow" or "Stern",
				Size = V3(0.5, 1.4, 0.9),
				CFrame = CFrame.new(0, 1.5 + math.sin(a) * 3.2 + k * 0.35, dir * (L / 2 + math.cos(a) * 0.2 - 0.8 + math.sin(a) * 1.4)) * CFrame.Angles(dir * a * 0.7, 0, 0),
				Color = Color3.fromRGB(74, 52, 36),
			})
		end
	end
	-- a carved dragon head on the prow, with glowing eyes
	local head = CFrame.new(0, 1.5 + 3.2 * math.sin(math.pi * 0.9) + 2.9, -L / 2 - 0.6)
	addPart(model, { Name = "DragonHead", Size = V3(0.9, 1.3, 2.4), CFrame = head * CFrame.Angles(math.rad(-15), 0, 0), Color = Color3.fromRGB(74, 52, 36), CanCollide = false })
	addPart(model, { Name = "DragonJaw", Size = V3(0.7, 0.4, 1.6), CFrame = head * CFrame.new(0, -0.7, -0.6) * CFrame.Angles(math.rad(12), 0, 0), Color = Color3.fromRGB(64, 44, 30), CanCollide = false })
	for _, x in { -0.5, 0.5 } do
		noShadow(addPart(model, { Name = "DragonEye", Shape = Enum.PartType.Ball, Size = Vector3.one * 0.28, CFrame = head * CFrame.new(x, 0.25, -0.5), Color = Color3.fromRGB(240, 180, 60), Material = Enum.Material.Neon, CanCollide = false }))
		noShadow(addPart(model, { Name = "DragonHorn", Size = V3(0.2, 1.1, 0.2), CFrame = head * CFrame.new(x * 0.8, 0.9, 0.6) * CFrame.Angles(math.rad(-35), 0, x * 0.6), Color = Color3.fromRGB(210, 196, 168), CanCollide = false }))
	end
	-- rigging: stays from the masthead to bow and stern
	local top = V3(0, 19, -1)
	for _, to in { V3(0, 2.6, -L / 2 + 2), V3(0, 2.6, L / 2 - 2), V3(maxW * 0.45, 1.2, 2), V3(-maxW * 0.45, 1.2, 2) } do
		local mid = (top + to) / 2
		noShadow(addPart(model, { Name = "Stay", Size = V3(0.12, 0.12, (to - top).Magnitude), CFrame = CFrame.lookAt(mid, to), Color = Color3.fromRGB(150, 128, 92), Material = Enum.Material.Fabric, CanCollide = false }))
	end
	-- deck, mast, yard and striped sail
	addPart(model, { Name = "Deck", Size = V3(maxW * 0.8, 0.3, L * 0.72), Position = V3(0, -0.3, 0), Color = Colors.Weathered, Material = Enum.Material.WoodPlanks })
	post(model, V3(0, -0.3, -1), 20, 0.7)
	addPart(model, { Name = "Yard", Size = V3(16, 0.5, 0.5), Position = V3(0, 18, -1.3), Color = Colors.DarkWood })
	local stripeColor = sailColor or Color3.fromRGB(160, 40, 36)
	for i = 1, 5 do
		addPart(model, {
			Name = "Sail",
			Size = V3(3, 11, 0.2),
			Position = V3(-6 + (i - 1) * 3, 12.3, -1.6),
			Color = i % 2 == 0 and Color3.fromRGB(236, 228, 210) or stripeColor,
			Material = Enum.Material.Fabric,
			CanCollide = false,
		})
	end
	-- round shields along both sides
	local shieldColors = { Color3.fromRGB(200, 160, 50), Color3.fromRGB(160, 44, 40), Color3.fromRGB(50, 80, 130), Color3.fromRGB(230, 225, 210) }
	for _, side in { 1, -1 } do
		for i = 1, 8 do
			local z = -L * 0.3 + (i - 1) * (L * 0.6 / 7)
			local t = (z + L / 2) / L
			local width = maxW * math.sin(math.pi * t) ^ 0.55
			addPart(model, {
				Name = "Shield",
				Shape = Enum.PartType.Cylinder,
				Size = V3(0.3, 2, 2),
				Position = V3(side * (width / 2 + 0.6), 1.3, z),
				Color = shieldColors[(i + (side > 0 and 0 or 1)) % 4 + 1],
				Material = Enum.Material.Wood,
				CanCollide = false,
			})
			addPart(model, {
				Name = "Oar",
				Size = V3(7, 0.25, 0.25),
				CFrame = CFrame.new(side * (width / 2 + 3), 0, z + 0.9) * CFrame.Angles(0, 0, side * math.rad(-25)),
				Color = Colors.Wood,
				CanCollide = false,
			})
		end
	end
	model.WorldPivot = CFrame.new()
	return model
end

-- Village props ---------------------------------------------------------------
-- Little things that make the valley feel lived in. ModelFactory.prop(kind)
-- builds one; kinds: Cart, Haystack, FishRack, Barrels, Woodpile, Banner,
-- BoatUpturned, FenceRun. Pivot = centre of the base, at ground level.
local Props = {}

local function barrel(model, at: Vector3, upright: boolean)
	local cf = upright and CFrame.new(at + V3(0, 0.95, 0)) * CFrame.Angles(0, 0, math.pi / 2) or CFrame.new(at + V3(0, 0.75, 0))
	addPart(model, { Name = "Barrel", Shape = Enum.PartType.Cylinder, Size = V3(1.9, 1.5, 1.5), CFrame = cf, Color = vary(Color3.fromRGB(118, 82, 50), 0.1) })
	for _, off in { -0.6, 0.6 } do
		noShadow(addPart(model, { Name = "Hoop", Shape = Enum.PartType.Cylinder, Size = V3(0.14, 1.56, 1.56), CFrame = cf * CFrame.new(off, 0, 0), Color = Colors.Iron, Material = Enum.Material.Metal, CanCollide = false }))
	end
end

function Props.Barrels(model)
	barrel(model, V3(0, 0, 0), true)
	barrel(model, V3(1.6, 0, 0.4), true)
	barrel(model, V3(0.7, 0, -1.6), false)
	addPart(model, { Name = "Crate", Size = V3(1.8, 1.8, 1.8), CFrame = CFrame.new(-1.8, 0.9, -0.6) * CFrame.Angles(0, 0.3, 0), Color = vary(Colors.Wood, 0.1), Material = Enum.Material.WoodPlanks })
end

function Props.Cart(model)
	addPart(model, { Name = "Bed", Size = V3(3.2, 0.35, 5), CFrame = CFrame.new(0, 2, 0) * CFrame.Angles(math.rad(-6), 0, 0), Color = vary(Colors.Wood, 0.08), Material = Enum.Material.WoodPlanks })
	for _, x in { -1.6, 1.6 } do
		noShadow(addPart(model, { Name = "Side", Size = V3(0.25, 0.9, 5), CFrame = CFrame.new(x, 2.55, 0) * CFrame.Angles(math.rad(-6), 0, 0), Color = Colors.Weathered, Material = Enum.Material.WoodPlanks }))
		addPart(model, { Name = "Wheel", Shape = Enum.PartType.Cylinder, Size = V3(0.35, 3, 3), CFrame = CFrame.new(x * 1.12, 1.5, 0.8), Color = Colors.DarkWood })
		noShadow(addPart(model, { Name = "Hub", Shape = Enum.PartType.Cylinder, Size = V3(0.5, 0.7, 0.7), CFrame = CFrame.new(x * 1.18, 1.5, 0.8), Color = Colors.Iron, Material = Enum.Material.Metal }))
	end
	for _, x in { -0.6, 0.6 } do
		noShadow(addPart(model, { Name = "Shaft", Size = V3(0.25, 0.25, 4.5), CFrame = CFrame.new(x, 1.1, -4.2) * CFrame.Angles(math.rad(14), 0, 0), Color = Colors.Wood }))
	end
	-- a load of hay
	addPart(model, { Name = "Load", Size = V3(2.8, 1.3, 3.6), CFrame = CFrame.new(0, 2.9, 0.3) * CFrame.Angles(math.rad(-6), 0, 0), Color = vary(Colors.Thatch, 0.08), Material = Enum.Material.Grass, CanCollide = false })
end

function Props.Haystack(model)
	addPart(model, { Name = "Hay", Shape = Enum.PartType.Ball, Size = Vector3.one * 6, CFrame = CFrame.new(0, 1.6, 0), Color = vary(Colors.Thatch, 0.06), Material = Enum.Material.Grass })
	addPart(model, { Name = "Hay", Shape = Enum.PartType.Ball, Size = Vector3.one * 4.2, CFrame = CFrame.new(0, 4, 0), Color = vary(Colors.Thatch, 0.06), Material = Enum.Material.Grass, CanCollide = false })
	post(model, V3(0, 3, 0), 4.2, 0.3, Colors.Weathered)
	noShadow(addPart(model, { Name = "Fork", Size = V3(0.15, 4, 0.15), CFrame = CFrame.new(2.6, 2.2, 1) * CFrame.Angles(0.3, 0, -0.35), Color = Colors.Wood, CanCollide = false }))
end

function Props.FishRack(model)
	-- a rack of stockfish drying in the wind off the fjord
	for _, x in { -3, 3 } do
		for _, z in { -0.8, 0.8 } do
			addPart(model, { Name = "Leg", Size = V3(0.35, 4.6, 0.35), CFrame = CFrame.new(x, 2.2, z) * CFrame.Angles(z > 0 and -0.25 or 0.25, 0, 0), Color = Colors.Weathered })
		end
	end
	noShadow(addPart(model, { Name = "Pole", Shape = Enum.PartType.Cylinder, Size = V3(7, 0.3, 0.3), CFrame = CFrame.new(0, 4.3, 0), Color = Colors.DarkWood }))
	for i = 1, 9 do
		local x = -2.8 + i * 0.6
		noShadow(addPart(model, { Name = "Fish", Size = V3(0.3, 1.6 + detail:NextNumber(-0.3, 0.3), 0.1), CFrame = CFrame.new(x, 3.4, (i % 2 == 0) and 0.1 or -0.1) * CFrame.Angles(0, 0, detail:NextNumber(-0.1, 0.1)), Color = vary(Color3.fromRGB(190, 176, 150), 0.1), Material = Enum.Material.Fabric, CanCollide = false }))
	end
end

function Props.Woodpile(model)
	for row = 0, 2 do
		for i = 0, 4 - row do
			addPart(model, {
				Name = "Log",
				Shape = Enum.PartType.Cylinder,
				Size = V3(5 + detail:NextNumber(-0.3, 0.3), 1, 1),
				CFrame = CFrame.new(detail:NextNumber(-0.2, 0.2), 0.5 + row * 0.86, (i - (4 - row) / 2) * 1.02),
				Color = vary(Colors.Wood, 0.14),
			})
		end
	end
	noShadow(addPart(model, { Name = "Cover", Size = V3(6, 0.3, 6), CFrame = CFrame.new(0, 3.3, 0) * CFrame.Angles(0, 0, math.rad(8)), Color = Colors.Shingle, Material = Enum.Material.WoodPlanks, CanCollide = false }))
end

function Props.Banner(model)
	post(model, V3(0, 0, 0), 11, 0.5, Colors.DarkWood)
	noShadow(addPart(model, { Name = "Crossbar", Size = V3(3.2, 0.3, 0.3), Position = V3(0, 10.4, 0), Color = Colors.DarkWood }))
	local red = Color3.fromRGB(150, 40, 36)
	addPart(model, { Name = "Cloth", Size = V3(2.8, 5, 0.1), Position = V3(0, 7.6, 0), Color = red, Material = Enum.Material.Fabric, CanCollide = false })
	noShadow(addPart(model, { Name = "Emblem", Shape = Enum.PartType.Cylinder, Size = V3(0.12, 1.6, 1.6), CFrame = CFrame.new(0, 8, -0.08) * CFrame.Angles(0, math.pi / 2, 0), Color = Color3.fromRGB(214, 176, 96), Material = Enum.Material.Fabric, CanCollide = false }))
	for i = 0, 2 do
		noShadow(addPart(model, { Name = "Tail", Size = V3(0.8, 1, 0.1), CFrame = CFrame.new(-1 + i, 4.7, 0) * CFrame.Angles(0, 0, math.rad(45)), Color = red, Material = Enum.Material.Fabric, CanCollide = false }))
	end
end

function Props.TorchPost(model)
	-- a waist-high post with an iron cup of burning pitch, lighting the paths
	post(model, V3(0, 0, 0), 4.6, 0.4, Colors.DarkWood)
	noShadow(addPart(model, { Name = "Cup", Shape = Enum.PartType.Cylinder, Size = V3(0.5, 0.9, 0.9), CFrame = CFrame.new(0, 4.8, 0) * CFrame.Angles(0, 0, math.rad(90)), Color = Colors.Iron, Material = Enum.Material.Metal, CanCollide = false }))
	local flame = noShadow(addPart(model, { Name = "Pitch", Size = V3(0.5, 0.2, 0.5), Position = V3(0, 5.1, 0), Color = Color3.fromRGB(255, 120, 40), Material = Enum.Material.Neon, CanCollide = false }))
	local fire = Instance.new("Fire")
	fire.Size = 1.6
	fire.Heat = 5
	fire.Color = Color3.fromRGB(255, 140, 50)
	fire.SecondaryColor = Color3.fromRGB(255, 60, 20)
	fire.Parent = flame
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 150, 70)
	light.Range = 16
	light.Brightness = 1.4
	light.Parent = flame
end

function Props.BoatUpturned(model)
	-- a small boat pulled up the beach, upside down on two trestles
	for _, z in { -2, 2 } do
		addPart(model, { Name = "Trestle", Size = V3(3.4, 1.4, 0.4), Position = V3(0, 0.7, z), Color = Colors.Weathered })
	end
	for i = -3, 3 do
		local t = 1 - math.abs(i) / 4
		addPart(model, { Name = "Hull", Size = V3(3 * t + 0.6, 0.9, 1.25), CFrame = CFrame.new(0, 1.85 + (1 - t) * 0.5, i * 1.2), Color = vary(Color3.fromRGB(96, 68, 46), 0.08), Material = Enum.Material.WoodPlanks })
	end
	noShadow(addPart(model, { Name = "KeelLine", Size = V3(0.3, 0.3, 8.6), Position = V3(0, 2.4, 0), Color = Colors.DarkWood }))
end

function Props.FenceRun(model)
	-- a split-rail fence 190 studs long along X
	local length = 190
	local step = 5
	for x = -length / 2, length / 2, step do
		post(model, V3(x, 0, detail:NextNumber(-0.2, 0.2)), 3.2, 0.45, vary(Colors.Weathered, 0.12))
	end
	for x = -length / 2, length / 2 - 20, 20 do
		for _, y in { 1.2, 2.4 } do
			noShadow(addPart(model, { Name = "Rail", Size = V3(20.4, 0.3, 0.3), Position = V3(x + 10, y + detail:NextNumber(-0.1, 0.1), 0), Color = vary(Colors.Weathered, 0.1) }))
		end
	end
end

function ModelFactory.prop(kind: string, _rng: Random?): Model
	local custom = ModelFactory.customAsset and ModelFactory.customAsset("Prop_" .. kind)
	if custom and ModelFactory.prepareProp then
		return ModelFactory.prepareProp(custom, kind)
	end
	local model = Instance.new("Model")
	model.Name = kind
	local builder = Props[kind]
	if builder then
		builder(model)
	end
	model.WorldPivot = CFrame.new()
	return model
end

-- Wildlife --------------------------------------------------------------------

-- A deer. The Body is anchored and moved by the server; other parts are
-- welded to it. GroundOffset attribute = body centre height above ground.
function ModelFactory.deer(rng: Random): Model
	local model = Instance.new("Model")
	model.Name = "Deer"
	local coat = Color3.fromRGB(140 + rng:NextInteger(-12, 12), 98, 60)
	local body = Instance.new("Part")
	body.Name = "Body"
	body.Anchored = true
	body.CanCollide = false
	body.Size = V3(1.6, 1.6, 3.6)
	body.Color = coat
	body.Material = Enum.Material.Fabric
	body.CFrame = CFrame.new(0, 3, 0)
	body.Parent = model

	local function attach(name, size, offset: CFrame, color, shape)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.Color = color or coat
		p.Material = Enum.Material.Fabric
		if shape then
			p.Shape = shape
		end
		p.Anchored = false
		p.CanCollide = false
		p.Massless = true
		p.CFrame = body.CFrame * offset
		p.Parent = model
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = body
		weld.Part1 = p
		weld.Parent = p
		return p
	end
	for _, x in { -0.55, 0.55 } do
		for _, z in { -1.3, 1.3 } do
			attach("Leg", V3(0.35, 2.3, 0.35), CFrame.new(x, -1.9, z), Color3.fromRGB(110, 78, 50))
		end
	end
	attach("Neck", V3(0.7, 1.8, 0.7), CFrame.new(0, 1.1, -1.7) * CFrame.Angles(math.rad(-25), 0, 0))
	attach("Head", V3(0.8, 0.8, 1.5), CFrame.new(0, 2, -2.3))
	attach("Tail", V3(0.4, 0.5, 0.3), CFrame.new(0, 0.5, 1.9), Color3.fromRGB(235, 225, 210))
	for _, x in { -0.4, 0.4 } do
		attach("Antler", V3(0.15, 1.4, 0.15), CFrame.new(x, 2.9, -2.1) * CFrame.Angles(0, 0, x * 0.9), Color3.fromRGB(220, 205, 180))
	end
	model.PrimaryPart = body
	model:SetAttribute("GroundOffset", 3)
	return model
end

-- A grey wolf, built like the deer: an anchored Body with welded parts.
function ModelFactory.wolf(rng: Random): Model
	local model = Instance.new("Model")
	model.Name = "Wolf"
	local g = 104 + rng:NextInteger(-14, 14)
	local coat = Color3.fromRGB(g, g - 4, g - 10)
	local pale = Color3.fromRGB(196, 192, 184)
	local body = Instance.new("Part")
	body.Name = "Body"
	body.Anchored = true
	body.CanCollide = false
	body.Size = V3(1.2, 1.2, 3)
	body.Color = coat
	body.Material = Enum.Material.Fabric
	body.CFrame = CFrame.new(0, 2, 0)
	body.Parent = model
	local function attach(name, size, offset: CFrame, color)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.Color = color or coat
		p.Material = Enum.Material.Fabric
		p.Anchored = false
		p.CanCollide = false
		p.Massless = true
		p.CFrame = body.CFrame * offset
		p.Parent = model
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = body
		weld.Part1 = p
		weld.Parent = p
		return p
	end
	for _, x in { -0.4, 0.4 } do
		for _, z in { -1.05, 1.05 } do
			attach("Leg", V3(0.3, 1.6, 0.3), CFrame.new(x, -1.2, z), coat:Lerp(Color3.new(0, 0, 0), 0.25))
		end
	end
	attach("Ruff", V3(1.4, 1.4, 1), CFrame.new(0, 0.15, -1.2), coat:Lerp(pale, 0.2))
	attach("Head", V3(0.9, 0.85, 1), CFrame.new(0, 0.55, -1.9))
	attach("Snout", V3(0.5, 0.45, 0.7), CFrame.new(0, 0.38, -2.6), pale)
	for _, x in { -0.28, 0.28 } do
		attach("Ear", V3(0.22, 0.45, 0.15), CFrame.new(x, 1.15, -1.75))
		attach("Eye", V3(0.12, 0.12, 0.05), CFrame.new(x * 0.8, 0.72, -2.41), Color3.fromRGB(230, 190, 70))
	end
	attach("Tail", V3(0.35, 0.35, 1.6), CFrame.new(0, 0.1, 2) * CFrame.Angles(math.rad(30), 0, 0), coat:Lerp(Color3.new(0, 0, 0), 0.15))
	model.PrimaryPart = body
	model:SetAttribute("GroundOffset", 2)
	return model
end

-- A flying arrow (visual only).
function ModelFactory.arrow(): BasePart
	local shaft = Instance.new("Part")
	shaft.Name = "Arrow"
	shaft.Anchored = true
	shaft.CanCollide = false
	shaft.CanQuery = false
	shaft.Size = V3(0.12, 0.12, 2.6)
	shaft.Color = Colors.Wood
	shaft.Material = Enum.Material.Wood
	local tip = Instance.new("Part")
	tip.Name = "Tip"
	tip.Anchored = false
	tip.Massless = true
	tip.CanCollide = false
	tip.CanQuery = false
	tip.Size = V3(0.25, 0.25, 0.4)
	tip.Color = Colors.Iron
	tip.Material = Enum.Material.Metal
	tip.CFrame = shaft.CFrame * CFrame.new(0, 0, -1.4)
	tip.Parent = shaft
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = shaft
	weld.Part1 = tip
	weld.Parent = tip
	return shaft
end

-- Villagers -------------------------------------------------------------------

-- A small villager figure. The body is anchored and moved by the server;
-- the head, hair and legs are welded to it so they follow.
-- GroundOffset attribute = body centre height above ground.
-- stage: "baby", "child", "adult" or "elder" (defaults from isChild).
-- Arms and legs hang from Welds whose C0 the client swings while walking
-- (attributes Hip = joint CFrame, HalfLen = half the limb length).
--[[
	Villagers are blocky Roblox-style figures (head, torso, two arms, two
	legs). `gear` (1-5, the village's rank) dresses the grown-ups:
	  1 Settler    wool tunic, leather belt and shoes
	  2 Chieftain  + fur mantle and leather boots
	  3 Hersir     + leather jerkin with straps, iron cap, bracers
	  4 Jarl       + mail shirt, helmet with nose guard, cloak, shield on the back
	  5 King       + gold-trimmed mail, crested helmet, red cloak, arm rings
	Children wear plain tunics; babies are swaddled.
]]
local Skins = {
	Color3.fromRGB(234, 196, 160),
	Color3.fromRGB(224, 180, 142),
	Color3.fromRGB(240, 206, 176),
	Color3.fromRGB(204, 160, 122),
}
local Wool = {
	Color3.fromRGB(150, 60, 50),
	Color3.fromRGB(60, 86, 130),
	Color3.fromRGB(86, 110, 66),
	Color3.fromRGB(168, 138, 82),
	Color3.fromRGB(122, 112, 100),
	Color3.fromRGB(196, 184, 160),
}
local LEATHER = Color3.fromRGB(110, 74, 46)
local DARK_LEATHER = Color3.fromRGB(72, 50, 34)
local FUR = Color3.fromRGB(128, 104, 80)
local MAIL = Color3.fromRGB(128, 132, 138)
local STEEL = Color3.fromRGB(162, 166, 172)
local GOLD = Color3.fromRGB(214, 172, 84)

-- Women's names are every other one in Config.Names (Astrid, Sigrid, ...).
local womenNames = {}
for i, n in Config.Names do
	if i % 2 == 1 then
		womenNames[n] = true
	end
end
function ModelFactory.isWoman(name: string): boolean
	return womenNames[string.match(name, "^(%S+)") or name] == true
end

local RIG_PARTS = { Body = true, Head = true, Arm = true, Leg = true }

-- Swaps a villager's blocks for the settler mesh pieces (Settler_<Man|Woman>_<gear>
-- in the imported pack). The blocky rig stays, invisible, so walking and
-- working animations still move the arms and legs.
local function dressWithMesh(model: Model, pack: Instance, rig, s: number): boolean
	local function pieceOf(piece: string): BasePart?
		for _, d in pack:GetDescendants() do
			if d:IsA("BasePart") and (d.Name == piece or d.Name == piece .. "_Node") then
				return d
			end
		end
		return nil
	end
	local sources = {}
	for piece in RIG_PARTS do
		sources[piece] = pieceOf(piece)
		if not sources[piece] or not rig[piece] then
			return false
		end
	end
	for _, d in model:GetChildren() do
		if d:IsA("BasePart") and not RIG_PARTS[d.Name] then
			d:Destroy()
		end
	end
	for _, part in model:GetChildren() do
		if part:IsA("BasePart") and RIG_PARTS[part.Name] then
			local info = rig[part.Name]
			local mesh = sources[part.Name]:Clone()
			mesh.Name = "Mesh" .. part.Name
			mesh.Anchored = false
			mesh.CanCollide = false
			mesh.CanQuery = false
			mesh.CanTouch = false
			mesh.Massless = true
			mesh.Size = info.size * s
			mesh.CFrame = part.CFrame * CFrame.new(info.centre * s)
			for _, c in mesh:GetChildren() do
				if c:IsA("JointInstance") or c:IsA("WeldConstraint") then
					c:Destroy()
				end
			end
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = part
			weld.Part1 = mesh
			weld.Parent = mesh
			mesh.Parent = model
			part.Transparency = 1
			for _, c in part:GetChildren() do
				if c:IsA("Decal") then
					c:Destroy()
				end
			end
		end
	end
	return true
end

function ModelFactory.villager(name: string, isChild: boolean, rng: Random, stage: string?, gear: number?): Model
	stage = stage or (isChild and "child" or "adult")
	gear = (stage == "adult" or stage == "elder") and math.clamp(gear or 1, 1, 5) or 0
	local s = ({ baby = 0.45, child = 0.65, adult = 0.85, elder = 0.82 })[stage] or 0.85
	local model = Instance.new("Model")
	model.Name = name
	model:SetAttribute("Villager", true)
	model:SetAttribute("Stage", stage)
	model:SetAttribute("Gear", gear)

	local skin = Skins[rng:NextInteger(1, #Skins)]
	local tunic = stage == "baby" and Color3.fromRGB(226, 216, 196) or Wool[rng:NextInteger(1, #Wool)]
	local trousers = Color3.fromRGB(70, 62, 54):Lerp(tunic, 0.15)
	local torsoColor, torsoMat = tunic, Enum.Material.Fabric
	if gear >= 4 then
		torsoColor, torsoMat = MAIL, Enum.Material.DiamondPlate
	elseif gear == 3 then
		torsoColor, torsoMat = LEATHER, Enum.Material.Leather
	end

	local legH = 2 * s
	local bodyH = 2 * s
	local body = Instance.new("Part")
	body.Name = "Body"
	body.Anchored = true
	body.CanCollide = false
	body.Size = V3(2 * s, bodyH, 1 * s)
	body.Color = torsoColor
	body.Material = torsoMat
	body.CFrame = CFrame.new(0, legH + bodyH / 2, 0)
	body.Parent = model

	local function weldTo(p: BasePart, to: BasePart)
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = to
		weld.Part1 = p
		weld.Parent = p
	end

	local function piece(partName, size, cf: CFrame, color, material, shape, to: BasePart?)
		local p = Instance.new("Part")
		p.Name = partName
		if shape then
			p.Shape = shape
		end
		p.Anchored = false
		p.CanCollide = false
		p.CanQuery = false
		p.CastShadow = false
		p.Massless = true
		p.Size = size
		p.Color = color
		p.Material = material or Enum.Material.Fabric
		p.CFrame = cf
		p.Parent = model
		weldTo(p, to or body)
		return p
	end
	local function attach(partName, size, offset: CFrame, color, material, shape)
		return piece(partName, size, body.CFrame * offset, color, material, shape)
	end

	-- a limb hanging from `hip` (in body space), swung by its Weld
	local function limb(partName, size: Vector3, hip: CFrame, color, side: number)
		local p = Instance.new("Part")
		p.Name = partName
		p.Anchored = false
		p.CanCollide = false
		p.CanQuery = false
		p.Massless = true
		p.Size = size
		p.Color = color
		p.Material = Enum.Material.Fabric
		p.CFrame = body.CFrame * hip * CFrame.new(0, -size.Y / 2, 0)
		p.Parent = model
		local weld = Instance.new("Weld")
		weld.Name = "Joint"
		weld.Part0 = body
		weld.Part1 = p
		weld.C0 = hip * CFrame.new(0, -size.Y / 2, 0)
		weld.Parent = p
		p:SetAttribute("Hip", hip)
		p:SetAttribute("HalfLen", size.Y / 2)
		p:SetAttribute("Side", side)
		return p
	end

	-- head: the classic Roblox head shape with a face
	local head = attach("Head", V3(2, 1, 1) * s * (stage == "baby" and 1.2 or 1), CFrame.new(0, bodyH / 2 + 0.5 * s, 0), skin, Enum.Material.SmoothPlastic)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Head
	mesh.Scale = V3(1.25, 1.25, 1.25)
	mesh.Parent = head
	local face = Instance.new("Decal")
	face.Name = "face"
	face.Face = Enum.NormalId.Front
	face.Texture = "rbxasset://textures/face.png"
	face.Parent = head
	local hs = 1.25 * s -- how big the head looks
	model:SetAttribute("HeadSize", hs)

	local hairColor = stage == "elder" and Color3.fromRGB(210, 210, 214) or Hair[rng:NextInteger(1, #Hair)]
	local helmet = gear >= 3 and stage == "adult"
	if stage ~= "baby" and not helmet then
		piece("Hair", V3(hs * 1.02, hs * 0.32, hs * 1.02), head.CFrame * CFrame.new(0, hs * 0.38, hs * 0.04), hairColor, Enum.Material.Fabric, nil, head)
		piece("Hair", V3(hs * 1.0, hs * 0.75, hs * 0.22), head.CFrame * CFrame.new(0, hs * 0.05, hs * 0.44), hairColor, Enum.Material.Fabric, nil, head)
	elseif helmet then
		-- hair showing under the helmet at the back
		piece("Hair", V3(hs * 0.9, hs * 0.5, hs * 0.2), head.CFrame * CFrame.new(0, -hs * 0.05, hs * 0.46), hairColor, Enum.Material.Fabric, nil, head)
	end
	if stage == "elder" or (stage == "adult" and gear >= 2 and rng:NextNumber() < 0.5) then
		piece("Beard", V3(hs * 0.8, hs * 0.5, hs * 0.3), head.CFrame * CFrame.new(0, -hs * 0.35, -hs * 0.42), hairColor, Enum.Material.Fabric, nil, head)
	end

	-- arms and legs
	local sleeve = gear >= 4 and MAIL or (gear == 3 and LEATHER or tunic:Lerp(Color3.new(0, 0, 0), 0.12))
	local legs = {}
	for i, x in { -0.5, 0.5 } do
		legs[i] = limb("Leg", V3(1 * s, legH, 1 * s), CFrame.new(x * s, -bodyH / 2, 0), trousers, i == 1 and 1 or -1)
	end
	local arms = {}
	for i, x in { -1.5, 1.5 } do
		arms[i] = limb("Arm", V3(1 * s, bodyH, 1 * s), CFrame.new(x * s, bodyH / 2, 0), sleeve, i == 1 and -1 or 1)
		-- bare hands
		piece("Hand", V3(1.02 * s, 0.45 * s, 1.02 * s), arms[i].CFrame * CFrame.new(0, -bodyH / 2 + 0.22 * s, 0), skin, Enum.Material.SmoothPlastic, nil, arms[i])
	end
	if stage == "baby" then
		attach("Swaddle", V3(2.1 * s, bodyH * 0.9, 1.1 * s), CFrame.new(0, -0.1 * s, 0), Color3.fromRGB(226, 216, 196))
	end

	-- shoes and boots
	for _, leg in legs do
		local h = gear >= 2 and 0.9 or 0.4
		piece("Boot", V3(1.04 * s, h * s, 1.1 * s), leg.CFrame * CFrame.new(0, -legH / 2 + h * s / 2, -0.03 * s), gear >= 2 and DARK_LEATHER or LEATHER, Enum.Material.Leather, nil, leg)
		if gear >= 2 then
			piece("BootFur", V3(1.12 * s, 0.22 * s, 1.16 * s), leg.CFrame * CFrame.new(0, -legH / 2 + h * s, 0), FUR, Enum.Material.Fabric, nil, leg)
		end
	end

	-- the tunic skirt below the belt
	if stage ~= "baby" then
		attach("Hem", V3(2.04 * s, 0.6 * s, 1.04 * s), CFrame.new(0, -bodyH / 2 - 0.2 * s, 0), gear >= 3 and tunic or tunic:Lerp(Color3.new(0, 0, 0), 0.1), Enum.Material.Fabric)
		attach("Belt", V3(2.08 * s, 0.28 * s, 1.08 * s), CFrame.new(0, -bodyH * 0.3, 0), DARK_LEATHER, Enum.Material.Leather)
		attach("Buckle", V3(0.36 * s, 0.32 * s, 0.1 * s), CFrame.new(0, -bodyH * 0.3, -0.56 * s), gear >= 5 and GOLD or STEEL, Enum.Material.Metal)
	end

	if gear >= 2 then
		-- fur mantle over the shoulders
		attach("Mantle", V3(2.3 * s, 0.45 * s, 1.25 * s), CFrame.new(0, bodyH / 2 - 0.1 * s, 0), FUR, Enum.Material.Fabric)
	end
	if gear == 3 then
		-- leather jerkin: crossed straps and stitched panels
		attach("Strap", V3(0.25 * s, bodyH * 1.1, 0.06 * s), CFrame.new(0, 0, -0.52 * s) * CFrame.Angles(0, 0, math.rad(35)), DARK_LEATHER, Enum.Material.Leather)
		attach("Strap", V3(0.25 * s, bodyH * 1.1, 0.06 * s), CFrame.new(0, 0, -0.52 * s) * CFrame.Angles(0, 0, math.rad(-35)), DARK_LEATHER, Enum.Material.Leather)
	end
	if gear >= 3 then
		for _, arm in arms do
			piece("Bracer", V3(1.06 * s, 0.7 * s, 1.06 * s), arm.CFrame * CFrame.new(0, -bodyH / 2 + 0.85 * s, 0), gear >= 5 and GOLD or DARK_LEATHER, gear >= 5 and Enum.Material.Metal or Enum.Material.Leather, nil, arm)
		end
	end
	if gear >= 4 then
		-- a cloak down the back, pinned at the shoulder
		local cloak = gear >= 5 and Color3.fromRGB(150, 36, 34) or Color3.fromRGB(52, 70, 104)
		attach("Cloak", V3(2.1 * s, bodyH * 1.35, 0.14 * s), CFrame.new(0, -0.3 * s, 0.6 * s), cloak, Enum.Material.Fabric)
		attach("Brooch", V3(0.35 * s, 0.35 * s, 0.12 * s), CFrame.new(0.7 * s, bodyH / 2 - 0.25 * s, -0.56 * s), gear >= 5 and GOLD or STEEL, Enum.Material.Metal)
		if stage == "adult" then
			local paint = ({ Color3.fromRGB(168, 44, 38), Color3.fromRGB(214, 176, 96), Color3.fromRGB(46, 74, 120) })[rng:NextInteger(1, 3)]
			attach("BackShield", V3(0.2 * s, 2.2 * s, 2.2 * s), CFrame.new(0, 0.1 * s, 0.8 * s) * CFrame.Angles(0, math.pi / 2, 0), paint, Enum.Material.Wood, Enum.PartType.Cylinder)
			attach("BackBoss", V3(0.3 * s, 0.5 * s, 0.5 * s), CFrame.new(0, 0.1 * s, 0.92 * s) * CFrame.Angles(0, math.pi / 2, 0), STEEL, Enum.Material.Metal, Enum.PartType.Cylinder)
		end
	end
	if gear >= 5 then
		attach("Trim", V3(2.06 * s, 0.14 * s, 1.06 * s), CFrame.new(0, -bodyH / 2 + 0.07 * s, 0), GOLD, Enum.Material.Metal)
		attach("Trim", V3(2.06 * s, 0.14 * s, 1.06 * s), CFrame.new(0, bodyH / 2 - 0.4 * s, 0), GOLD, Enum.Material.Metal)
	end
	if helmet then
		local steel = gear >= 5 and STEEL or Color3.fromRGB(118, 122, 128)
		piece("Helmet", V3(hs * 1.08, hs * 0.7, hs * 1.08), head.CFrame * CFrame.new(0, hs * 0.3, 0), steel, Enum.Material.Metal, Enum.PartType.Ball, head)
		piece("HelmetRim", V3(hs * 1.1, hs * 0.12, hs * 1.1), head.CFrame * CFrame.new(0, hs * 0.2, 0), gear >= 5 and GOLD or DARK_LEATHER, Enum.Material.Metal, nil, head)
		if gear >= 4 then
			piece("Nasal", V3(hs * 0.12, hs * 0.45, hs * 0.1), head.CFrame * CFrame.new(0, hs * 0.02, -hs * 0.55), steel, Enum.Material.Metal, nil, head)
		end
		if gear >= 5 then
			-- spectacle guard and a crest
			for _, x in { -0.22, 0.22 } do
				piece("Spectacle", V3(hs * 0.3, hs * 0.08, hs * 0.08), head.CFrame * CFrame.new(x * hs, hs * 0.12, -hs * 0.55), GOLD, Enum.Material.Metal, nil, head)
			end
			piece("Crest", V3(hs * 0.12, hs * 0.3, hs * 0.8), head.CFrame * CFrame.new(0, hs * 0.68, 0), GOLD, Enum.Material.Metal, nil, head)
			for _, arm in arms do
				piece("ArmRing", V3(1.12 * s, 0.16 * s, 1.12 * s), arm.CFrame * CFrame.new(0, bodyH * 0.15, 0), GOLD, Enum.Material.Metal, nil, arm)
			end
		end
	elseif gear >= 2 and stage == "adult" then
		-- a fur-lined leather cap
		piece("Cap", V3(hs * 1.06, hs * 0.4, hs * 1.06), head.CFrame * CFrame.new(0, hs * 0.42, 0), LEATHER, Enum.Material.Leather, nil, head)
		piece("CapFur", V3(hs * 1.12, hs * 0.16, hs * 1.12), head.CFrame * CFrame.new(0, hs * 0.24, 0), FUR, Enum.Material.Fabric, nil, head)
	end

	-- the settler meshes, when the pack is imported (grown-ups only)
	if (stage == "adult" or stage == "elder") and ModelFactory.customAsset then
		local woman = ModelFactory.isWoman(name)
		local slot = "Settler_" .. (woman and "Woman" or "Man") .. "_" .. math.max(gear, 1)
		local rig = SettlerRig[slot]
		local pack = rig and ModelFactory.customAsset(slot)
		if pack then
			if dressWithMesh(model, pack, rig, s) then
				model:SetAttribute("Helmeted", not woman and gear >= 3)
				model:SetAttribute("Meshed", true)
			end
			pack:Destroy()
		end
	end

	local tag = Instance.new("BillboardGui")
	tag.Name = "NameTag"
	tag.Size = UDim2.fromOffset(140, 22)
	tag.StudsOffset = V3(0, bodyH / 2 + 1.9 * s, 0)
	tag.MaxDistance = 60
	tag.Adornee = body
	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamMedium
	label.TextSize = 13
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.5
	label.Text = name
	label.Parent = tag
	tag.Parent = body

	model.PrimaryPart = body
	model:SetAttribute("GroundOffset", legH + bodyH / 2)
	return model
end

-- Puts a crew on a longship: rowers on both sides facing the stern, a
-- helmsman at the steering oar and a lookout at the bow. Works for the
-- built-in ship and for an imported mesh (it reads the ship's size).
function ModelFactory.addCrew(ship: Model, rowers: number, rng: Random, gear: number?)
	local pivot = ship:GetPivot()
	local cf, size = ship:GetBoundingBox()
	local centre = pivot:PointToObjectSpace(cf.Position)
	local bottom = centre.Y - size.Y / 2
	local L = math.max(size.Z, 20) * 0.9
	local beam = L * 0.2
	local seat = bottom + 1.55 -- hips on the rowing benches
	local crew = Instance.new("Model")
	crew.Name = "Crew"
	local function place(fig: Model, local_: CFrame)
		local body = fig.PrimaryPart
		local half = body and body.Size.Y / 2 or 1
		fig:PivotTo(pivot * local_ * CFrame.new(0, half, 0))
		fig.Parent = crew
	end
	local pairs_ = math.max(1, math.floor(rowers / 2))
	for i = 1, pairs_ do
		local z = -L * 0.28 + (i - 1) * (L * 0.56 / math.max(1, pairs_ - 1))
		for _, side in { -1, 1 } do
			place(ModelFactory.figure(rng, gear, true), CFrame.new(side * beam * 0.24, seat, z) * CFrame.Angles(0, math.pi, 0))
		end
	end
	-- helmsman (standing) and lookout
	local legs = 1.7
	place(ModelFactory.figure(rng, gear), CFrame.new(beam * 0.15, seat - 0.4 + legs, L * 0.4))
	place(ModelFactory.figure(rng, gear), CFrame.new(0, seat - 0.4 + legs, -L * 0.38))
	crew.Parent = ship
	return crew
end

-- A still figure for decoration (ship crews): everything anchored, no name tag.
function ModelFactory.figure(rng: Random, gear: number?, seated: boolean?): Model
	local model = ModelFactory.villager("Crew", false, rng, "adult", gear)
	model:SetAttribute("Villager", nil) -- not walked or swung by the villager animator
	local tag = model.PrimaryPart and model.PrimaryPart:FindFirstChild("NameTag")
	if tag then
		tag:Destroy()
	end
	if seated then
		for _, leg in model:GetChildren() do
			if leg.Name == "Leg" and leg:IsA("BasePart") then
				local joint = leg:FindFirstChild("Joint") :: Weld
				if joint then
					joint.C0 = leg:GetAttribute("Hip") * CFrame.Angles(math.rad(90), 0, 0) * CFrame.new(0, -leg:GetAttribute("HalfLen"), 0)
				end
			end
		end
	end
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.CanCollide = false
			d.CanQuery = false
			d.CastShadow = false
		end
	end
	return model
end

-- Gives a villager figure a helmet, a round shield on the left arm and an axe
-- in the right hand, for the war band. Safe to call twice.
function ModelFactory.armWarrior(model: Model)
	if model:GetAttribute("Warrior") then
		return
	end
	local body = model.PrimaryPart
	if not body then
		return
	end
	model:SetAttribute("Warrior", true)
	local function piece(name, size, cf: CFrame, color, material, shape, to: BasePart?)
		local p = Instance.new("Part")
		p.Name = name
		if shape then
			p.Shape = shape
		end
		p.Anchored = false
		p.CanCollide = false
		p.CanQuery = false
		p.Massless = true
		p.Size = size
		p.Color = color
		p.Material = material
		p.CFrame = cf
		p.Parent = model
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = to or body
		weld.Part1 = p
		weld.Parent = p
		return p
	end
	local head = model:FindFirstChild("Head")
	if head and head:IsA("BasePart") and not model:FindFirstChild("Helmet") and not model:GetAttribute("Helmeted") then
		local r = model:GetAttribute("HeadSize") or head.Size.X
		piece("Helmet", Vector3.new(r * 1.08, r * 0.6, r * 1.08), head.CFrame * CFrame.new(0, r * 0.22, 0), Color3.fromRGB(120, 124, 130), Enum.Material.Metal, Enum.PartType.Ball, head)
		piece("Nasal", Vector3.new(r * 0.12, r * 0.45, r * 0.12), head.CFrame * CFrame.new(0, 0, -r * 0.5), Color3.fromRGB(120, 124, 130), Enum.Material.Metal, nil, head)
	end
	local left, right
	for _, arm in model:GetChildren() do
		if arm.Name == "Arm" and arm:IsA("BasePart") then
			if arm:GetAttribute("Side") == -1 then
				left = arm
			else
				right = arm
			end
		end
	end
	local paint = ({ Color3.fromRGB(168, 44, 38), Color3.fromRGB(214, 176, 96), Color3.fromRGB(46, 74, 120) })[math.random(1, 3)]
	if left then
		local cf = left.CFrame * CFrame.new(-left.Size.X / 2 - 0.15, -0.1, 0) -- a cylinder lies along X: a disc on the arm
		piece("Shield", Vector3.new(0.2, 2.4, 2.4), cf, paint, Enum.Material.Wood, Enum.PartType.Cylinder, left)
		piece("ShieldBoss", Vector3.new(0.35, 0.6, 0.6), cf * CFrame.new(-0.15, 0, 0), Color3.fromRGB(150, 150, 156), Enum.Material.Metal, Enum.PartType.Cylinder, left)
	end
	if right then
		local hand = right.CFrame * CFrame.new(0, -right.Size.Y / 2, 0)
		piece("AxeHaft", Vector3.new(0.18, 2.6, 0.18), hand * CFrame.Angles(math.rad(-80), 0, 0) * CFrame.new(0, 0.9, 0), Color3.fromRGB(92, 66, 42), Enum.Material.Wood, nil, right)
		piece("AxeHead", Vector3.new(0.12, 0.7, 0.8), hand * CFrame.Angles(math.rad(-80), 0, 0) * CFrame.new(0, 2, -0.3), Color3.fromRGB(150, 152, 158), Enum.Material.Metal, nil, right)
	end
end

-- Tools -----------------------------------------------------------------------

-- Builds a hand tool ("Axe", "Pickaxe", "Bow" or "Torch") that players hold.
function ModelFactory.tool(kind: string): Tool
	local tool = Instance.new("Tool")
	tool.Name = kind
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	tool.ToolTip = ({ Axe = "Chop trees, fight", Pickaxe = "Mine rocks", Bow = "Shoot deer and enemies", Torch = "Set enemy buildings alight (F)", Sword = "Your weapon: click to fight" })[kind] or kind

	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = V3(0.3, 3.6, 0.3)
	handle.Color = Colors.Wood
	handle.Material = Enum.Material.Wood
	handle.CanCollide = false
	handle.Massless = true
	handle.Parent = tool

	local function head(size, offset: CFrame)
		local p = Instance.new("Part")
		p.Name = "Head"
		p.Size = size
		p.Color = Colors.Iron
		p.Material = Enum.Material.Metal
		p.CanCollide = false
		p.Massless = true
		p.CFrame = handle.CFrame * offset
		p.Parent = tool
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = handle
		weld.Part1 = p
		weld.Parent = p
	end
	if kind == "Torch" then
		handle.Size = V3(0.35, 3, 0.35)
		local flame = Instance.new("Part")
		flame.Name = "Flame"
		flame.Size = V3(0.6, 0.7, 0.6)
		flame.Color = Color3.fromRGB(255, 150, 60)
		flame.Material = Enum.Material.Neon
		flame.CanCollide = false
		flame.Massless = true
		flame.CFrame = handle.CFrame * CFrame.new(0, 1.7, 0)
		flame.Parent = tool
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = handle
		weld.Part1 = flame
		weld.Parent = flame
		local fire = Instance.new("Fire")
		fire.Size = 2
		fire.Heat = 7
		fire.Parent = flame
		local light = Instance.new("PointLight")
		light.Color = Colors.Lantern
		light.Range = 18
		light.Brightness = 2
		light.Parent = flame
		tool.Grip = CFrame.new(0, -0.8, 0)
		return tool
	elseif kind == "Bow" then
		-- the handle is the grip; two angled limbs and a string make the bow
		handle.Size = V3(0.3, 1, 0.3)
		local function limb(size, offset: CFrame, color, material)
			local p = Instance.new("Part")
			p.Name = "Limb"
			p.Size = size
			p.Color = color
			p.Material = material
			p.CanCollide = false
			p.Massless = true
			p.CFrame = handle.CFrame * offset
			p.Parent = tool
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = handle
			weld.Part1 = p
			weld.Parent = p
		end
		limb(V3(0.25, 2.2, 0.25), CFrame.new(0, 1.4, 0.3) * CFrame.Angles(math.rad(-15), 0, 0), Colors.DarkWood, Enum.Material.Wood)
		limb(V3(0.25, 2.2, 0.25), CFrame.new(0, -1.4, 0.3) * CFrame.Angles(math.rad(15), 0, 0), Colors.DarkWood, Enum.Material.Wood)
		limb(V3(0.06, 4.9, 0.06), CFrame.new(0, 0, 0.9), Color3.fromRGB(230, 225, 210), Enum.Material.Fabric)
		tool.Grip = CFrame.new(0, 0, 0) * CFrame.Angles(0, math.pi / 2, 0)
		return tool
	elseif kind == "Sword" then
		-- a short grip, a crossguard and a long double-edged blade
		handle.Size = V3(0.3, 1.2, 0.3)
		handle.Color = Colors.DarkWood
		head(V3(0.35, 0.35, 0.35), CFrame.new(0, -0.7, 0)) -- pommel
		head(V3(0.25, 0.25, 1.6), CFrame.new(0, 0.7, 0)) -- crossguard
		head(V3(0.12, 3.8, 0.4), CFrame.new(0, 2.7, 0)) -- blade
		tool.Grip = CFrame.new(0, -0.2, 0)
		return tool
	elseif kind == "Axe" then
		head(V3(0.25, 1, 1.3), CFrame.new(0, 1.4, -0.7))
	else
		head(V3(0.25, 0.4, 3), CFrame.new(0, 1.6, 0))
		head(V3(0.2, 0.3, 0.6), CFrame.new(0, 1.5, -1.6) * CFrame.Angles(math.rad(25), 0, 0))
		head(V3(0.2, 0.3, 0.6), CFrame.new(0, 1.5, 1.6) * CFrame.Angles(math.rad(-25), 0, 0))
	end
	-- hold it near the bottom of the shaft; the axe is turned round so its
	-- blade faces out, away from the player
	tool.Grip = CFrame.new(0, -1.2, 0) * (kind == "Axe" and CFrame.Angles(0, math.pi, 0) or CFrame.identity)
	return tool
end

-- Mesh swap ---------------------------------------------------------------------
--[[
	If ReplicatedStorage.Assets has a child named after a slot below, that
	model is used instead of the part-built one. Its pivot is moved to the
	bottom-centre of the model automatically, so it sits on the ground.
]]
ModelFactory.Slots = {
	"Longhouse", "Cottage", "Woodcutter", "Quarry", "Farm", "Storehouse", "Palisade",
	"LoreHall", "Smithy", "Shrine", "Shipyard", "HuntingLodge", "GreatHall", "Watchtower", "Fishery", "Brewhouse", "TraderStall",
	"Tree_Pine", "Tree_Spruce", "Tree_Birch", "Rock", "Bush", "Dock", "Deer",
	"Axe", "Pickaxe", "Bow", "Torch", "Sword", "Longship",
	"Prop_Cart", "Prop_Haystack", "Prop_FishRack", "Prop_Barrels", "Prop_Woodpile", "Prop_Banner", "Prop_BoatUpturned",
	"PalisadeGate", "Jetty", "DecorTorch", "DecorBrazier", "DecorRuneStone", "DecorBanner", "DecorShieldRack", "DecorTotem", "DecorAntlers", "DecorWoodpile",
}

-- Models laid out in Workspace > ModelWorkshop (see bakeTemplates) are
-- looked at first, so edits made there in Studio are used straight away.
--
-- The ready-made meshes (meshes/VikingAssets.glb) import as one model named
-- VikingAssets holding every slot. It works dropped straight into Assets, or
-- even left in the Workspace where Studio's importer puts it: the server
-- tucks it away into Assets when the game starts.
local slotSet = {}
for _, slot in ModelFactory.Slots do
	slotSet[slot] = true
end
for slot in SettlerRig do
	slotSet[slot] = true
end

local dressMaterials
local function assetsFolder(): Instance?
	local folder = ReplicatedStorage:FindFirstChild("Assets")
	local pack = workspace:FindFirstChild("VikingAssets")
	if pack and game:GetService("RunService"):IsServer() then
		if not folder then
			folder = Instance.new("Folder")
			folder.Name = "Assets"
			folder.Parent = ReplicatedStorage
		end
		-- imported parts come in loose: pin them before physics knocks them over
		-- and stand every piece upright (our meshes are modelled upright, so
		-- any turn on a part is from the importer or from tumbling)
		for _, d in pack:GetDescendants() do
			if d:IsA("BasePart") then
				d.Anchored = true
				if d:IsA("MeshPart") then
					d.CFrame = CFrame.new(d.Position)
				end
			end
		end
		-- Studio's importer wraps each slot in "<Slot>_Node": drop the suffix
		for _, d in pack:GetDescendants() do
			local slot = string.match(d.Name, "^(.+)_Node$")
			if slot and slotSet[slot] then
				d.Name = slot
			end
		end
		pack.Parent = folder
	end
	return folder
end

-- Tuck the pack away as soon as the game starts, before anything is built,
-- so its models (all stacked on one spot) never show up in the village.
if game:GetService("RunService"):IsServer() then
	assetsFolder()
end

-- A slot inside a pack, however the importer nested it.
local function findInPack(pack: Instance, name: string): Instance?
	return pack:FindFirstChild(name) or pack:FindFirstChild(name .. "_Node") or pack:FindFirstChild(name, true) or pack:FindFirstChild(name .. "_Node", true)
end

-- Mesh pieces named Mat_<Material>_<rrggbb> (tools/meshgen/materials.py) get
-- Roblox's own textured material in that shade: wood grain, rough slate,
-- woven fabric. The flat palette texture they were imported with goes.
local MESH_MATERIALS = {
	Wood = Enum.Material.Wood,
	Stone = Enum.Material.Slate,
	Thatch = Enum.Material.Fabric,
	Leaves = Enum.Material.LeafyGrass,
	Cloth = Enum.Material.Fabric,
	Metal = Enum.Material.Metal,
}
-- Our own textures (textures/*.png, uploaded; see AssetIds) for each piece kind,
-- and how many studs one copy of the texture covers.
local MESH_TEXTURES = {
	Wood = { "Planks", 6 },
	Stone = { "Stone", 8 },
	Thatch = { "Thatch", 5 },
	Cloth = { "Cloth", 6 },
	Metal = { "Iron", 4 },
}
local FACES = { Enum.NormalId.Top, Enum.NormalId.Bottom, Enum.NormalId.Front, Enum.NormalId.Back, Enum.NormalId.Left, Enum.NormalId.Right }

-- Puts texture `name` on a piece: a SurfaceAppearance named after it in
-- ReplicatedStorage.Textures if you made one, else the uploaded image on
-- every face, tinted with the piece's colour.
local function applyTexture(part: MeshPart, name: string, studs: number)
	if part:FindFirstChild("OwnTexture") then
		return
	end
	local templates = ReplicatedStorage:FindFirstChild("Textures")
	local template = templates and templates:FindFirstChild(name)
	if template and template:IsA("SurfaceAppearance") then
		local sa = template:Clone()
		sa.Name = "OwnTexture"
		local ok = pcall(function()
			sa.Parent = part
		end)
		if ok then
			return
		end
		sa:Destroy()
	end
	local url = AssetIds.texture(name)
	if not url then
		return
	end
	-- the images are pale (about 75% bright), so lift the tint to match
	local c = part.Color
	local tintColor = Color3.new(math.min(c.R / 0.75, 1), math.min(c.G / 0.75, 1), math.min(c.B / 0.75, 1))
	local marker = Instance.new("Folder")
	marker.Name = "OwnTexture"
	marker.Parent = part
	for _, face in FACES do
		local t = Instance.new("Texture")
		t.Name = "OwnTexture_" .. face.Name
		t.Texture = url
		t.Face = face
		t.StudsPerTileU = studs
		t.StudsPerTileV = studs
		t.Color3 = tintColor
		t.Parent = part
	end
end
ModelFactory.applyTexture = applyTexture

-- Textures every mesh piece under `root` that has none yet (used once the
-- uploaded textures have been looked up, for things built before that).
function ModelFactory.textureAll(root: Instance)
	for _, d in root:GetDescendants() do
		if d:IsA("MeshPart") and not d:FindFirstChild("OwnTexture") then
			local kind = string.match(d.Name, "^Mat_(%a+)_%x%x%x%x%x%x")
			local tex = kind and MESH_TEXTURES[kind]
			if tex then
				applyTexture(d, tex[1], tex[2])
				ModelFactory.retintTexture(d)
			end
		end
	end
end

-- After a piece changes colour (seasons, clan colours), match its texture;
-- under snow the texture steps aside so the white shows.
function ModelFactory.retintTexture(part: BasePart)
	if not part:FindFirstChild("OwnTexture") then
		return
	end
	local c = part.Color
	local tintColor = Color3.new(math.min(c.R / 0.75, 1), math.min(c.G / 0.75, 1), math.min(c.B / 0.75, 1))
	local hidden = part.Material == Enum.Material.Snow or part.Transparency >= 1
	for _, t in part:GetChildren() do
		if t:IsA("Texture") and string.sub(t.Name, 1, 11) == "OwnTexture_" then
			t.Color3 = tintColor
			t.Transparency = hidden and 1 or 0
		end
	end
end

dressMaterials = function(root: Instance)
	for _, d in root:GetDescendants() do
		if d:IsA("MeshPart") then
			local kind, hex = string.match(d.Name, "^Mat_(%a+)_(%x%x%x%x%x%x)")
			local material = kind and MESH_MATERIALS[kind]
			if material then
				d.Material = material
				d.Color = Color3.fromHex(hex)
				pcall(function()
					d.TextureID = ""
				end)
				if kind == "Metal" then
					d.Reflectance = 0.05
				end
				local tex = MESH_TEXTURES[kind]
				if tex then
					applyTexture(d, tex[1], tex[2])
				end
			end
		end
	end
end

local function customAsset(name: string): Instance?
	local folder = assetsFolder() -- always, so an imported pack never sits in the world
	local workshop = workspace:FindFirstChild("ModelWorkshop")
	local item = workshop and workshop:FindFirstChild(name)
	-- a block-built copy left in the ModelWorkshop never hides a real mesh
	if item and not item:FindFirstChildWhichIsA("MeshPart", true) and folder then
		local hasMesh = folder:FindFirstChild(name)
		if not hasMesh then
			for _, child in folder:GetChildren() do
				if not slotSet[child.Name] and (child:IsA("Model") or child:IsA("Folder")) then
					hasMesh = findInPack(child, name)
					if hasMesh then
						break
					end
				end
			end
		end
		if hasMesh and hasMesh:FindFirstChildWhichIsA("MeshPart", true) then
			item = nil
		end
	end
	local fromPack = false
	if folder and not item then
		item = folder:FindFirstChild(name)
		if not item then
			-- one level down: a pack of slots (like VikingAssets) inside Assets
			for _, child in folder:GetChildren() do
				if not slotSet[child.Name] and (child:IsA("Model") or child:IsA("Folder")) then
					item = findInPack(child, name)
					if item then
						fromPack = true
						break
					end
				end
			end
		end
	end
	if not item then
		return nil
	end
	local clone = item:Clone()
	dressMaterials(clone)
	-- never bring along another slot that the importer nested inside this one
	if fromPack then
		for _, d in clone:GetDescendants() do
			local base = string.match(d.Name, "^(.+)_Node$") or d.Name
			if slotSet[base] and base ~= name and d.Parent then
				d:Destroy()
			end
		end
	end
	return clone
end
ModelFactory.customAsset = customAsset

local function largestPart(model: Model): BasePart?
	local best, bestVolume = nil, -1
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			local v = d.Size.X * d.Size.Y * d.Size.Z
			if v > bestVolume then
				best, bestVolume = d, v
			end
		end
	end
	return best
end

-- Wraps loose parts in a Model, anchors it, optionally scales it to fit
-- `fit` (x/z), and puts its pivot at the bottom-centre at (0, 0, 0).
local function wrap(item: Instance): Model
	local model: Model
	if item:IsA("Model") then
		model = item
	else
		model = Instance.new("Model")
		model.Name = item.Name
		item.Parent = model
	end
	-- free models can hide scripts inside; never run them
	for _, d in model:GetDescendants() do
		if d:IsA("LuaSourceContainer") then
			d:Destroy()
		end
	end
	return model
end

local function setAnchored(model: Instance, anchored: boolean)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = anchored
		end
	end
end

--[[
	Fits a custom model (an imported mesh or a free model) onto the built-in
	version `reference`: scaled to the same size and placed in the same spot,
	so a mesh drops in whatever units or position it was exported with.
	  mode "height"     match the height (trees, tools, deer)
	  mode "footprint"  fit inside the ground footprint (buildings, ships)
	Templates (the built-in models baked into the ModelWorkshop and edited by
	hand) are kept exactly as they are.
]]
-- Studio's 3D importer can leave imported MeshParts turned (a rotation
-- baked into each part), which made trees and halls lean. Our meshes are
-- modelled upright, so when every part is a MeshPart sharing one rotation,
-- that rotation is taken off.
local function standUp(custom: Model)
	local parts = {}
	for _, d in custom:GetDescendants() do
		if d:IsA("BasePart") then
			if not d:IsA("MeshPart") then
				return
			end
			table.insert(parts, d)
		end
	end
	if #parts == 0 then
		return
	end
	local turn = parts[1].CFrame.Rotation
	for _, part in parts do
		local diff = turn:ToObjectSpace(part.CFrame.Rotation)
		local _, angle = diff:ToAxisAngle()
		if math.abs(angle) > 0.01 then
			-- each piece knocked a different way: stand each one up where it is
			for _, p in parts do
				p.CFrame = CFrame.new(p.Position)
			end
			return
		end
	end
	local _, angle = turn:ToAxisAngle()
	if math.abs(angle) < 0.001 then
		return
	end
	local undo = turn:Inverse()
	for _, part in parts do
		part.CFrame = undo * part.CFrame
	end
end

-- `floorY` (optional) is where the bottom goes, in the built-in model's own
-- space: 0 = the ground line, so a mesh never sinks to the depth of a
-- built-in model's buried footing.
local function fitTo(custom: Model, reference: Model, mode: string, extraScale: number?, floorY: number?)
	local refCF, refSize = reference:GetBoundingBox()
	local refBottom = reference:GetPivot():PointToObjectSpace(refCF.Position - V3(0, refSize.Y / 2, 0))
	if floorY then
		refBottom = V3(refBottom.X, floorY, refBottom.Z)
	end
	if custom:GetAttribute("Template") then
		-- keep its own pivot (the built-in one), just bring it home
		custom:PivotTo(CFrame.new())
		return
	end
	standUp(custom)
	-- measure in world axes, not along a part's own turn
	custom.PrimaryPart = nil
	custom.WorldPivot = CFrame.new(custom:GetPivot().Position)
	local _, size = custom:GetBoundingBox()
	if size.X <= 0 or size.Y <= 0 or size.Z <= 0 then
		return
	end
	local factor
	if mode == "height" then
		factor = refSize.Y / size.Y
	else
		factor = math.min(refSize.X / size.X, refSize.Z / size.Z)
	end
	factor *= extraScale or 1
	if math.abs(factor - 1) > 0.005 then
		custom:ScaleTo(custom:GetScale() * factor)
	end
	local cf, newSize = custom:GetBoundingBox()
	custom.WorldPivot = CFrame.new(cf.Position - V3(0, newSize.Y / 2, 0))
	-- the same bottom-centre spot as the built-in model, relative to its pivot
	custom:PivotTo(CFrame.new(refBottom))
	custom.WorldPivot = CFrame.new()
end

-- Lights, fires and smoke from the built-in model go along with a custom
-- one (a mesh can't carry them), as do attributes like a tower's ArcherPost.
local function keepGlow(custom: Model, reference: Model)
	for _, d in reference:GetDescendants() do
		-- crop rows stay the game's own too, so fields still change with the seasons
		if d:IsA("BasePart") and (d.Name == "Barley" or d:GetAttribute("KeepWithMesh") or d:FindFirstChildWhichIsA("Light") or d:FindFirstChildOfClass("Fire") or d:FindFirstChildOfClass("Smoke") or d:FindFirstChildOfClass("ParticleEmitter")) then
			d.Parent = custom
		end
	end
	for name, value in reference:GetAttributes() do
		if custom:GetAttribute(name) == nil then
			custom:SetAttribute(name, value)
		end
	end
end

local partBuilt = {
	building = ModelFactory.building,
	pine = ModelFactory.pine,
	spruce = ModelFactory.spruce,
	birch = ModelFactory.birch,
	boulder = ModelFactory.boulder,
	node = ModelFactory.node,
	dock = ModelFactory.dock,
	deer = ModelFactory.deer,
	tool = ModelFactory.tool,
}

-- The mesh for `slot`, fitted onto the block-built `reference` (built at the
-- origin, front at -Z), or nil if there is no mesh. Lights and fires from
-- the reference come along. The reference is left as it is.
function ModelFactory.meshFor(slot: string, reference: Model): Model?
	local custom = customAsset(slot)
	if not custom then
		return nil
	end
	local model = wrap(custom)
	setAnchored(model, true)
	fitTo(model, reference, "footprint", nil, 0)
	model.Name = slot
	return model
end

function ModelFactory.building(buildingType: string): Model
	local custom = customAsset(buildingType)
	if not custom then
		return partBuilt.building(buildingType)
	end
	local reference = partBuilt.building(buildingType)
	local model = wrap(custom)
	setAnchored(model, true)
	-- buildings stand on the ground; a jetty's piles reach down into the water
	fitTo(model, reference, "footprint", nil, not Config.Buildings[buildingType].Shore and 0 or nil)
	keepGlow(model, reference)
	reference:Destroy()
	model.Name = buildingType
	return model
end

-- A custom tree, rock or bush, sized like the built-in one it replaces.
local function customNature(slot: string, reference: Model, mainOf: BasePart?)
	local custom = customAsset(slot)
	if not custom then
		return nil
	end
	local model = wrap(custom)
	setAnchored(model, true)
	fitTo(model, reference, "height")
	reference:Destroy()
	model.Name = slot
	return model, largestPart(model) or mainOf
end

function ModelFactory.pine(rng: Random, scale: number?): (Model, BasePart)
	local reference, trunk = partBuilt.pine(rng, scale)
	local model, main = customNature("Tree_Pine", reference, trunk)
	if model then
		return model, main
	end
	return reference, trunk
end

function ModelFactory.birch(rng: Random, scale: number?): (Model, BasePart)
	local reference, trunk = partBuilt.birch(rng, scale)
	local model, main = customNature("Tree_Birch", reference, trunk)
	if model then
		return model, main
	end
	return reference, trunk
end

function ModelFactory.spruce(rng: Random, scale: number?): (Model, BasePart)
	local reference, trunk = partBuilt.spruce(rng, scale)
	local model, main = customNature("Tree_Spruce", reference, trunk)
	if model then
		return model, main
	end
	return reference, trunk
end

function ModelFactory.boulder(rng: Random, scale: number?): (Model, BasePart)
	local reference, rock = partBuilt.boulder(rng, scale)
	local model, main = customNature("Rock", reference, rock)
	if model then
		-- every rock turned its own way
		model:PivotTo(CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0))
		model.WorldPivot = CFrame.new()
		return model, main
	end
	return reference, rock
end

function ModelFactory.node(kind: string, rng: Random): (Model, BasePart)
	if kind == "Bush" then
		local reference, bush = partBuilt.node(kind, rng)
		local model, main = customNature("Bush", reference, bush)
		if model then
			return model, main
		end
		return reference, bush
	end
	return partBuilt.node(kind, rng)
end

function ModelFactory.dock(length: number): Model
	local custom = customAsset("Dock")
	if not custom then
		return partBuilt.dock(length)
	end
	local reference = partBuilt.dock(length)
	local model = wrap(custom)
	setAnchored(model, true)
	fitTo(model, reference, "footprint")
	reference:Destroy()
	return model
end

function ModelFactory.deer(rng: Random): Model
	local custom = customAsset("Deer")
	if not custom then
		return partBuilt.deer(rng)
	end
	local reference = partBuilt.deer(rng)
	local model = wrap(custom)
	setAnchored(model, false)
	fitTo(model, reference, "height")
	reference:Destroy()
	model.Name = "Deer"
	local body = model.PrimaryPart or largestPart(model)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.CanCollide = false
			if d ~= body then
				d.Massless = true
				local weld = Instance.new("WeldConstraint")
				weld.Part0 = body
				weld.Part1 = d
				weld.Parent = d
			end
		end
	end
	body.Anchored = true
	model.PrimaryPart = body
	-- how high the body sits above the hooves, measured from the model's real bottom
	local boxCF, boxSize = model:GetBoundingBox()
	model:SetAttribute("GroundOffset", body.Position.Y - (boxCF.Position.Y - boxSize.Y / 2))
	return model
end

local partLongship = ModelFactory.longship
function ModelFactory.longship(length: number?, sailColor: Color3?): Model
	local custom = customAsset("Longship")
	if not custom then
		return partLongship(length, sailColor)
	end
	local reference = partLongship(length, sailColor)
	local model = wrap(custom)
	setAnchored(model, true)
	-- same length as the built-in ship, riding a little higher: a mesh hull
	-- is solid all the way down, so it looked swamped at the keel's depth
	local _, refSize = reference:GetBoundingBox()
	local keel = reference:GetPivot():PointToObjectSpace(reference:GetBoundingBox().Position).Y - refSize.Y / 2
	fitTo(model, reference, "footprint", nil, keel + 1.8)
	reference:Destroy()
	return model
end

-- Village props (Prop_Cart, Prop_Haystack, ...): sized like the built-in prop.
function ModelFactory.prepareProp(custom: Instance, kind: string): Model
	local reference = Instance.new("Model")
	if Props[kind] then
		Props[kind](reference)
	end
	reference.WorldPivot = CFrame.new()
	local model = wrap(custom)
	setAnchored(model, true)
	if #reference:GetChildren() > 0 then
		fitTo(model, reference, "footprint", nil, 0)
	end
	reference:Destroy()
	model.Name = kind
	return model
end

--[[
	Tools: a slot can hold a ready-made Tool (used as it is), or just a model
	or mesh. A model is fitted over the built-in tool, whose own parts are
	hidden, so the grip, swing and fire all keep working.
]]
function ModelFactory.tool(kind: string): Tool
	local custom = customAsset(kind)
	if not custom then
		return partBuilt.tool(kind)
	end
	if custom:IsA("Tool") then
		custom.Name = kind
		for _, d in custom:GetDescendants() do
			if d:IsA("LuaSourceContainer") then
				d:Destroy() -- the game drives its tools itself
			end
		end
		return custom
	end
	local tool = partBuilt.tool(kind)
	local handle = tool:FindFirstChild("Handle") :: BasePart
	local model = wrap(custom)
	setAnchored(model, false)
	-- fit over the built-in tool (measured with its handle at the origin)
	local reference = Instance.new("Model")
	for _, d in tool:GetChildren() do
		if d:IsA("BasePart") then
			d:Clone().Parent = reference
		end
	end
	reference.WorldPivot = handle.CFrame
	fitTo(model, reference, "height")
	reference:Destroy()
	for _, d in tool:GetChildren() do
		if d:IsA("BasePart") and not d:FindFirstChildOfClass("Fire") and not d:FindFirstChildWhichIsA("Light") then
			d.Transparency = 1
		end
	end
	model:PivotTo(handle.CFrame * model:GetPivot())
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.CanCollide = false
			d.Massless = true
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = handle
			weld.Part1 = d
			weld.Parent = d
			d.Parent = tool
		end
	end
	model:Destroy()
	return tool
end

-- Editing models in Studio ------------------------------------------------------
--[[
	bakeTemplates() is run once from Studio's Command Bar (in edit mode, not
	while playing):
	    require(game.ServerScriptService.Server.EditTools).Setup()
	It puts a copy of every built-in model into Workspace > ModelWorkshop, in
	a row you can see and edit. When the game starts, the server moves them
	into ReplicatedStorage > Assets and uses them everywhere. Delete one to go
	back to the built-in version (which has more random variety for trees).
]]
local function moveBy(item: Instance, offset: CFrame)
	if item:IsA("PVInstance") then
		item:PivotTo(offset * item:GetPivot())
		return
	end
	for _, d in item:GetDescendants() do
		if d:IsA("BasePart") then
			d.CFrame = offset * d.CFrame
		end
	end
end

function ModelFactory.bakeTemplates(): number
	local workshop = workspace:FindFirstChild("ModelWorkshop")
	if not workshop then
		workshop = Instance.new("Folder")
		workshop.Name = "ModelWorkshop"
		workshop.Parent = workspace
	end
	local rng = Random.new(7)
	local makers = {
		Tree_Pine = function()
			return partBuilt.pine(rng, 1)
		end,
		Tree_Spruce = function()
			return partBuilt.spruce(rng, 1)
		end,
		Tree_Birch = function()
			return partBuilt.birch(rng, 1)
		end,
		Rock = function()
			return partBuilt.boulder(rng, 1)
		end,
		Bush = function()
			return partBuilt.node("Bush", rng)
		end,
		Dock = function()
			return partBuilt.dock(48)
		end,
		Deer = function()
			return partBuilt.deer(rng)
		end,
	}
	for _, kind in Config.Tools do
		makers[kind] = function()
			return partBuilt.tool(kind)
		end
	end
	for b in Config.Buildings do
		makers[b] = function()
			return partBuilt.building(b)
		end
	end
	for kind, build in Props do
		makers["Prop_" .. kind] = function()
			local m = Instance.new("Model")
			m.Name = kind
			build(m)
			m.WorldPivot = CFrame.new()
			return m
		end
	end

	-- Lay them out in a row in the meadow behind the first plot.
	local x, z, made = -20, 200, 0
	for _, slot in ModelFactory.Slots do
		local make = makers[slot]
		if make and not workshop:FindFirstChild(slot) then
			-- Start from your own model if one is already in Assets.
			local own = customAsset(slot)
			local item = own or make()
			item.Name = slot
			if not own then
				item:SetAttribute("Template", true)
			end
			local width = 8
			if item:IsA("Model") then
				local _, size = item:GetBoundingBox()
				width = math.max(size.X, size.Z, 6)
			end
			x += width / 2 + 6
			local hit = workspace:Raycast(V3(x, 400, z), V3(0, -800, 0))
			local y = hit and hit.Position.Y or 1
			if item:IsA("Tool") then
				local handle = item:FindFirstChild("Handle")
				if handle then
					moveBy(item, CFrame.new(V3(x, y + 2.5, z) - handle.Position))
				end
			else
				item:PivotTo(CFrame.new(x, y, z))
			end
			item.Parent = workshop
			x += width / 2
			made += 1
		end
	end
	return made
end

-- Called by the server as the game starts: hands the workshop models to the
-- game (ReplicatedStorage > Assets) and clears them out of the world.
function ModelFactory.collectWorkshop()
	local workshop = workspace:FindFirstChild("ModelWorkshop")
	if not workshop then
		return
	end
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	if not assets then
		assets = Instance.new("Folder")
		assets.Name = "Assets"
		assets.Parent = ReplicatedStorage
	end
	for _, item in workshop:GetChildren() do
		local handle = item:IsA("Tool") and item:FindFirstChild("Handle")
		if handle and handle:IsA("BasePart") then
			handle.CanTouch = true
		end
		local old = assets:FindFirstChild(item.Name)
		if old then
			old:Destroy()
		end
		item.Parent = assets
	end
	workshop:Destroy()
end

return ModelFactory
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">Pointer</string>
          <string name="Source"><![CDATA[--[[
	Pointer (client only)
	Where the player is pointing on screen, in viewport pixels (the same space
	as UserInputService:GetMouseLocation and Camera:ViewportPointToRay).
	With a mouse that is the mouse; on a phone or tablet it is the last spot
	tapped on the 3D world (taps on buttons and the thumbstick are ignored).
]]

local GuiService = game:GetService("GuiService")
local UserInputService = game:GetService("UserInputService")

local Pointer = {}

local lastTouch: Vector2? = nil
local usingTouch = false

UserInputService.TouchStarted:Connect(function(input, processed)
	if not processed then
		usingTouch = true
		lastTouch = Vector2.new(input.Position.X, input.Position.Y) + GuiService:GetGuiInset()
	end
end)
UserInputService.TouchMoved:Connect(function(input, processed)
	if not processed and lastTouch then
		lastTouch = Vector2.new(input.Position.X, input.Position.Y) + GuiService:GetGuiInset()
	end
end)
UserInputService.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement then
		usingTouch = false
	end
end)

function Pointer.location(): Vector2
	if usingTouch and lastTouch then
		return lastTouch
	end
	return UserInputService:GetMouseLocation()
end

function Pointer.isTouch(): boolean
	return usingTouch
end

return Pointer
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[--[[
	Remotes
	The server creates the network objects; the client waits for them.
	Require this module from either side and use e.g. Remotes.PlaceBuilding.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local EVENTS = {
	"ColonyState", -- server -> client: full colony snapshot every tick
	"Notify", -- server -> client: short message for the toast feed
	"ShootArrow", -- client -> server: (aimPosition) when the Bow is used
	"Strike", -- client -> server: an Axe swing (server finds who it hits)
	"BoatInput", -- client -> server: (throttle, steer) while sailing
	"OpenTrade", -- server -> client: you're at a trading stall, show the trade window
	"BoatFire", -- client -> server: loose a volley from your ship (F at the helm)
	"WarReport", -- server -> client: your war band came home, here is what happened
}

local FUNCTIONS = {
	"PlaceBuilding", -- client -> server: (type, cx, cz, rot) -> ok, message
	"DemolishBuilding", -- client -> server: (buildingId) -> ok, message
	"Research", -- client -> server: (techId) -> ok, message
	"Trade", -- client -> server: (offerIndex) -> ok, message
	"Council", -- client -> server: Jarl's Table actions (action, arg) -> ok, message
}

local Remotes = {}

if RunService:IsServer() then
	local folder = Instance.new("Folder")
	folder.Name = "Remotes"
	for _, name in EVENTS do
		local remote = Instance.new("RemoteEvent")
		remote.Name = name
		remote.Parent = folder
		Remotes[name] = remote
	end
	for _, name in FUNCTIONS do
		local remote = Instance.new("RemoteFunction")
		remote.Name = name
		remote.Parent = folder
		Remotes[name] = remote
	end
	folder.Parent = ReplicatedStorage
else
	local folder = ReplicatedStorage:WaitForChild("Remotes")
	for _, name in EVENTS do
		Remotes[name] = folder:WaitForChild(name)
	end
	for _, name in FUNCTIONS do
		Remotes[name] = folder:WaitForChild(name)
	end
end

return Remotes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">SettlerRig</string>
          <string name="Source"><![CDATA[-- Generated by tools/meshgen/build.py. Do not edit by hand.
-- For each settler mesh piece: its size and its centre, in the space of
-- the villager rig part it rides on (studs, full adult size).
return {
	Settler_Man_1 = {
		Head = { size = Vector3.new(1.260, 1.699, 1.406), centre = Vector3.new(0.000, -0.121, 0.003) },
		Body = { size = Vector3.new(2.100, 2.650, 1.230), centre = Vector3.new(0.000, -0.375, -0.015) },
		Arm = { size = Vector3.new(0.974, 2.287, 0.941), centre = Vector3.new(-0.005, -0.071, 0.000) },
		Leg = { size = Vector3.new(0.924, 2.000, 1.012), centre = Vector3.new(0.000, 0.000, -0.044) },
	},
	Settler_Man_2 = {
		Head = { size = Vector3.new(1.436, 1.820, 1.454), centre = Vector3.new(-0.001, -0.140, 0.027) },
		Body = { size = Vector3.new(2.494, 2.932, 1.397), centre = Vector3.new(-0.010, -0.234, -0.000) },
		Arm = { size = Vector3.new(0.963, 2.309, 0.934), centre = Vector3.new(0.001, -0.076, 0.001) },
		Leg = { size = Vector3.new(0.950, 2.000, 1.025), centre = Vector3.new(0.000, 0.000, -0.037) },
	},
	Settler_Man_3 = {
		Head = { size = Vector3.new(1.380, 2.020, 1.440), centre = Vector3.new(0.000, -0.120, 0.020) },
		Body = { size = Vector3.new(2.482, 2.914, 1.458), centre = Vector3.new(0.023, -0.243, 0.037) },
		Arm = { size = Vector3.new(0.965, 2.290, 0.928), centre = Vector3.new(0.004, -0.077, -0.002) },
		Leg = { size = Vector3.new(0.950, 2.000, 1.025), centre = Vector3.new(0.000, 0.000, -0.037) },
	},
	Settler_Man_4 = {
		Head = { size = Vector3.new(1.380, 2.100, 1.520), centre = Vector3.new(0.000, -0.160, 0.040) },
		Body = { size = Vector3.new(2.900, 3.144, 1.870), centre = Vector3.new(0.000, -0.378, 0.215) },
		Arm = { size = Vector3.new(0.968, 2.280, 0.958), centre = Vector3.new(-0.004, -0.072, 0.000) },
		Leg = { size = Vector3.new(0.950, 2.000, 1.025), centre = Vector3.new(0.000, 0.000, -0.037) },
	},
	Settler_Man_5 = {
		Head = { size = Vector3.new(1.380, 2.490, 1.520), centre = Vector3.new(0.000, -0.045, 0.040) },
		Body = { size = Vector3.new(2.900, 3.163, 1.870), centre = Vector3.new(0.000, -0.369, 0.215) },
		Arm = { size = Vector3.new(0.963, 2.283, 0.958), centre = Vector3.new(-0.002, -0.075, 0.000) },
		Leg = { size = Vector3.new(0.950, 2.000, 1.025), centre = Vector3.new(0.000, 0.000, -0.037) },
	},
	Settler_Woman_1 = {
		Head = { size = Vector3.new(1.260, 2.329, 1.427), centre = Vector3.new(0.000, -0.386, 0.014) },
		Body = { size = Vector3.new(2.240, 3.700, 1.171), centre = Vector3.new(0.000, -0.900, -0.045) },
		Arm = { size = Vector3.new(0.821, 2.287, 0.792), centre = Vector3.new(-0.002, -0.076, 0.000) },
		Leg = { size = Vector3.new(0.798, 2.000, 0.950), centre = Vector3.new(0.000, 0.000, -0.075) },
	},
	Settler_Woman_2 = {
		Head = { size = Vector3.new(1.441, 2.320, 1.466), centre = Vector3.new(-0.007, -0.390, 0.033) },
		Body = { size = Vector3.new(2.452, 3.959, 1.458), centre = Vector3.new(0.041, -0.771, 0.022) },
		Arm = { size = Vector3.new(0.832, 2.279, 0.796), centre = Vector3.new(0.003, -0.076, -0.000) },
		Leg = { size = Vector3.new(0.821, 2.000, 0.960), centre = Vector3.new(0.000, 0.000, -0.070) },
	},
	Settler_Woman_3 = {
		Head = { size = Vector3.new(1.284, 2.325, 1.422), centre = Vector3.new(0.012, -0.387, 0.011) },
		Body = { size = Vector3.new(2.474, 3.965, 1.334), centre = Vector3.new(-0.021, -0.768, 0.008) },
		Arm = { size = Vector3.new(0.817, 2.282, 0.793), centre = Vector3.new(-0.002, -0.073, -0.000) },
		Leg = { size = Vector3.new(0.821, 2.000, 0.960), centre = Vector3.new(0.000, 0.000, -0.070) },
	},
	Settler_Woman_4 = {
		Head = { size = Vector3.new(1.260, 2.326, 1.424), centre = Vector3.new(0.000, -0.387, 0.012) },
		Body = { size = Vector3.new(2.900, 3.795, 1.434), centre = Vector3.new(0.000, -0.703, -0.003) },
		Arm = { size = Vector3.new(0.822, 2.303, 0.821), centre = Vector3.new(0.001, -0.080, 0.000) },
		Leg = { size = Vector3.new(0.821, 2.000, 0.960), centre = Vector3.new(0.000, 0.000, -0.070) },
	},
	Settler_Woman_5 = {
		Head = { size = Vector3.new(1.260, 2.309, 1.424), centre = Vector3.new(0.000, -0.396, 0.012) },
		Body = { size = Vector3.new(2.900, 3.830, 1.492), centre = Vector3.new(0.000, -0.685, 0.026) },
		Arm = { size = Vector3.new(0.833, 2.306, 0.821), centre = Vector3.new(0.002, -0.075, 0.000) },
		Leg = { size = Vector3.new(0.821, 2.000, 0.960), centre = Vector3.new(0.000, 0.000, -0.070) },
	},
}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">Sounds</string>
          <string name="Source"><![CDATA[--[[
	Sounds
	Every sound in the game, by slot name. To change one, put a different
	sound's ID in its slot, written like "rbxassetid://1234567890".

	How to find a sound in Studio:
	  1. Open the Toolbox (View or Window menu > Toolbox).
	  2. Pick the Audio tab (the music-note icon), search e.g. "wind",
	     "ocean waves", "viking", "war horn", "fire crackle".
	  3. Click a sound to listen. Right-click it > Copy Asset ID.
	  4. In the Explorer open ReplicatedStorage > Shared and double-click
	     Sounds (this script). Paste the number between the quotes, after
	     rbxassetid://  e.g.  Wind = "rbxassetid://9112854440",
	  5. Press Play.
	An empty slot ("") is silent. The ones filled in already are Roblox's
	built-in sounds that come with every Roblox install.
]]

local AssetIds = require(script.Parent.AssetIds)

local Sounds = {}

Sounds.Slots = {
	-- background, loops forever (empty until you pick one you like)
	Music = { Id = "", Volume = 0.25 }, -- a calm Nordic / folk track
	Wind = { Id = "", Volume = 0.3 }, -- soft wind
	Birds = { Id = "", Volume = 0.25 }, -- daytime birdsong (quiet at night)
	Waves = { Id = "", Volume = 0.45 }, -- sea on the shore (louder near the fjord)
	Fire = { Id = "", Volume = 0.6 }, -- crackling flames on burning buildings
	Rain = { Id = "", Volume = 0.5 }, -- steady rain, plays during sea storms
	Thunder = { Id = "", Volume = 0.8 }, -- one thunder clap after each lightning flash

	-- one-off effects
	Chop = { Id = "rbxasset://sounds/swordslash.wav", Volume = 0.5, Pitch = 0.6 },
	Mine = { Id = "rbxasset://sounds/swordlunge.wav", Volume = 0.5, Pitch = 0.55 },
	Swing = { Id = "rbxasset://sounds/swordslash.wav", Volume = 0.6, Pitch = 1 },
	Bow = { Id = "rbxasset://sounds/swordlunge.wav", Volume = 0.5, Pitch = 1.7 },
	Build = { Id = "rbxasset://sounds/action_jump_land.mp3", Volume = 0.8, Pitch = 0.6 },
	Splash = { Id = "rbxasset://sounds/impact_water.mp3", Volume = 1, Pitch = 0.7 },
	QuestDone = { Id = "rbxasset://sounds/unsheath.wav", Volume = 0.5, Pitch = 1 },
	WarHorn = { Id = "", Volume = 1 }, -- a long horn blast when a raid begins
}

-- A slot left empty can still be filled from Studio: upload the game's own
-- sound (music/sfx/<Name>.ogg), insert it, and leave the Sound named after
-- the slot (WarHorn, Wind, Waves, Fire) in Workspace. It is found here.
local found = {} -- [name] = id or false
local lastLook = {}
local function idFor(name: string): string?
	local slot = Sounds.Slots[name]
	if not slot then
		return nil
	end
	if slot.Id ~= "" then
		return slot.Id
	end
	local uploaded = AssetIds.sound(name)
	if uploaded then
		return uploaded
	end
	if found[name] then
		return found[name]
	end
	if lastLook[name] and os.clock() - lastLook[name] < 30 then
		return nil
	end
	lastLook[name] = os.clock()
	for _, root in { workspace, game:GetService("ReplicatedStorage") } do
		for _, d in root:GetDescendants() do
			if d:IsA("Sound") and d.Name == name and d.SoundId ~= "" then
				found[name] = d.SoundId
				return d.SoundId
			end
		end
	end
	return nil
end
Sounds.idFor = idFor

-- Plays slot `name` once, at a part or a position (or everywhere if nil).
function Sounds.play(name: string, where: (Instance | Vector3)?)
	local slot = Sounds.Slots[name]
	local id = idFor(name)
	if not slot or not id then
		return
	end
	local sound = Instance.new("Sound")
	sound.SoundId = id
	sound.Volume = slot.Volume or 0.5
	sound.PlaybackSpeed = slot.Pitch or 1
	sound.RollOffMaxDistance = 160
	local holder
	if typeof(where) == "Vector3" then
		holder = Instance.new("Attachment")
		holder.WorldPosition = where
		holder.Parent = workspace.Terrain
		sound.Parent = holder
	elseif typeof(where) == "Instance" then
		sound.Parent = where
	else
		sound.Parent = workspace
	end
	sound:Play()
	task.delay(8, function()
		sound:Destroy()
		if holder then
			holder:Destroy()
		end
	end)
end

-- A looping sound inside `parent` for slot `name`, or nil if the slot is empty.
function Sounds.loop(name: string, parent: Instance): Sound?
	local slot = Sounds.Slots[name]
	local id = idFor(name)
	if not slot or not id then
		return nil
	end
	local sound = Instance.new("Sound")
	sound.Name = name
	sound.SoundId = id
	sound.Volume = slot.Volume or 0.5
	sound.PlaybackSpeed = slot.Pitch or 1
	sound.Looped = true
	sound.Parent = parent
	sound:Play()
	return sound
end

return Sounds
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="13">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="14">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--[[
	Server entry point.
	Loads every ModuleScript in the Services folder, calls :Init() on all of
	them (set-up, no cross-service calls yet), then :Start() (begin running).
	To add a new system, drop a new module in src/server/Services.
]]

local servicesFolder = script:WaitForChild("Services")

-- Models you edited in Workspace > ModelWorkshop become the game's models.
local ModelFactory = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("ModelFactory"))
local okCollect, errCollect = pcall(ModelFactory.collectWorkshop)
if not okCollect then
	warn("[VikingCity] couldn't use ModelWorkshop: " .. tostring(errCollect))
end

-- Our uploaded textures arrive as decals: find the image inside each one in
-- the background (never holding up the world), then dress what is built.
local AssetIds = require(game:GetService("ReplicatedStorage").Shared.AssetIds)
task.spawn(function()
	local okTex, errTex = pcall(AssetIds.resolveTextures, 20)
	if not okTex then
		warn("[VikingCity] couldn't look up textures: " .. tostring(errTex))
		return
	end
	local okDress, errDress = pcall(ModelFactory.textureAll, workspace)
	if not okDress then
		warn("[VikingCity] couldn't put textures on: " .. tostring(errDress))
	end
end)

local services = {}
for _, module in servicesFolder:GetChildren() do
	if module:IsA("ModuleScript") then
		services[module.Name] = require(module)
	end
end

-- Each service starts on its own, so one error can't stop the whole game.
for name, service in services do
	if service.Init then
		local ok, err = pcall(service.Init, service, services)
		if not ok then
			warn("[VikingCity] " .. name .. " failed to set up: " .. tostring(err))
		end
	end
end

-- Workspace > ShowModelWorkshop ticked: lay out every model in the meadow
-- while playing, so it can be copied (Ctrl+C), then pasted back in after
-- pressing Stop, where it can be edited and saved.
local show = workspace:FindFirstChild("ShowModelWorkshop")
if show and show:IsA("BoolValue") and show.Value then
	local ok, err = pcall(function()
		ModelFactory.bakeTemplates()
		for _, item in workspace.ModelWorkshop:GetChildren() do
			local handle = item:IsA("Tool") and item:FindFirstChild("Handle")
			if handle and handle:IsA("BasePart") then
				handle.CanTouch = false -- so walking past doesn't pick the tool up
			end
		end
	end)
	if not ok then
		warn("[VikingCity] couldn't lay out ModelWorkshop: " .. tostring(err))
	end
	print("[VikingCity] ModelWorkshop is in Workspace: copy it, press Stop, paste it into Workspace")
end

for name, service in services do
	if service.Start then
		task.spawn(function()
			service:Start()
		end)
	end
	print("[VikingCity] started " .. name)
end
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">EditTools</string>
          <string name="Source"><![CDATA[--[[
	EditTools
	Run from Studio's Command Bar (View > Command Bar) while NOT playing:

	    require(game.ServerScriptService.Server.EditTools).Setup()

	It does two things, so you can see and change the game's world and
	models in edit mode, then save them in your place:
	  1. builds the whole valley (terrain, forests, rocks, docks, lighting)
	     into Workspace, and marks it as saved so the game doesn't rebuild it
	  2. puts a copy of every building, tree, rock, bush, deer and tool in
	     Workspace > ModelWorkshop, in a row in the meadow behind your plot

	Studio may freeze for up to a minute while it builds. Run it once; run
	it again later only if you want to start the valley from scratch (your
	ModelWorkshop edits are kept).

	Other commands:
	    require(game.ServerScriptService.Server.EditTools).Models()  -- only step 2
	    require(game.ServerScriptService.Server.EditTools).Reset()   -- undo step 1
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local EditTools = {}

local function factory()
	return require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("ModelFactory"))
end

function EditTools.Models()
	local made = factory().bakeTemplates()
	print("[EditTools] added " .. made .. " models to Workspace > ModelWorkshop")
end

function EditTools.Setup()
	local start = os.clock()
	local WorldService = require(script.Parent:WaitForChild("Services"):WaitForChild("WorldService"))
	WorldService:Bake()
	EditTools.Models()
	print(string.format("[EditTools] done in %.0f seconds. Now File > Save to File As to keep it.", os.clock() - start))
end

-- Throws the saved valley away, so the game builds a fresh one each time again.
function EditTools.Reset()
	for _, name in { "Scenery", "ShoreFoam" } do
		local old = workspace:FindFirstChild(name)
		if old then
			old:Destroy()
		end
	end
	workspace.Terrain:Clear()
	workspace:SetAttribute("WorldBaked", nil)
	print("[EditTools] saved valley removed; the game will build a new one when you press Play")
end

return EditTools
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="16">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">BoatService</string>
            <string name="Source"><![CDATA[--[[
	BoatService
	Sailing and sea battles.

	Research Karve (needs a Shipyard) and walk to the end of the jetty in
	front of your plot: hold E to launch a boat and take the helm.
	  W/S  row forward and back      A/D  steer
	  F    loose a volley of arrows at the nearest enemy ship
	  Space jump off
	Ram an enemy at speed to smash its hull. Every ship has a hull bar; at
	zero it sinks and the crew swims for it. Sink a ship and you take its
	cargo. Research Longship for a bigger, faster, tougher war ship.

	A Greywater raider longship patrols the fjord and attacks player ships
	that come close. It comes back a few minutes after you sink it.
	Boats stay on the water: land, sand and ice stop them, so you can beach
	one near Greywater Hold for a raid.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Sounds = require(Shared.Sounds)
local Grid = require(Shared.Grid)
local Remotes = require(Shared.Remotes)
local ModelFactory = require(Shared.ModelFactory)

local BoatService = {}

local N = Config.Naval
local services
local ships = {} -- [ship] = true, every ship afloat (players' and raiders)
local boats = {} -- [player] = ship
local inputs = {} -- [player] = { throttle, steer }
local rng = Random.new()

local KINDS = {
	Karve = { length = 26, speed = 24, turn = 0.9, sail = Color3.fromRGB(200, 190, 170), hull = N.KarveHull, ram = 1 },
	Longship = { length = 44, speed = 38, turn = 0.6, sail = Color3.fromRGB(160, 40, 36), hull = N.LongshipHull, ram = 1.5 },
	Raider = { length = 40, speed = N.RaiderSpeed, turn = 0.55, sail = Color3.fromRGB(40, 50, 70), hull = N.RaiderHull, ram = 1.3 },
}

function BoatService:Init(allServices)
	services = allServices
end

local waterParams = RaycastParams.new()
waterParams.FilterType = Enum.RaycastFilterType.Include
waterParams.IgnoreWater = false

local function isWater(pos: Vector3): boolean
	waterParams.FilterDescendantsInstances = { workspace.Terrain }
	local hit = workspace:Raycast(pos + Vector3.new(0, 30, 0), Vector3.new(0, -60, 0), waterParams)
	return hit ~= nil and hit.Material == Enum.Material.Water
end

-- Hull bar ------------------------------------------------------------------

local function makeHullBar(ship)
	local anchor = ship.model.PrimaryPart or ship.model:FindFirstChildWhichIsA("BasePart", true)
	local gui = Instance.new("BillboardGui")
	gui.Name = "HullBar"
	gui.Size = UDim2.fromOffset(150, 30)
	gui.StudsOffsetWorldSpace = Vector3.new(0, 26, 0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 260
	gui.Adornee = anchor
	local title = Instance.new("TextLabel")
	title.BackgroundTransparency = 1
	title.Size = UDim2.new(1, 0, 0, 16)
	title.Font = Enum.Font.GothamBold
	title.TextSize = 14
	title.TextColor3 = ship.owner and Color3.fromRGB(245, 235, 215) or Color3.fromRGB(240, 120, 100)
	title.TextStrokeTransparency = 0.4
	title.Text = ship.title
	title.Parent = gui
	local back = Instance.new("Frame")
	back.Position = UDim2.fromOffset(10, 18)
	back.Size = UDim2.new(1, -20, 0, 8)
	back.BackgroundColor3 = Color3.fromRGB(30, 22, 18)
	back.BorderSizePixel = 0
	back.Parent = gui
	local fill = Instance.new("Frame")
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = Color3.fromRGB(120, 200, 100)
	fill.BorderSizePixel = 0
	fill.Parent = back
	gui.Parent = ship.model
	ship.bar = fill
end

local function updateBar(ship)
	if ship.bar then
		local t = math.clamp(ship.hp / ship.maxHp, 0, 1)
		ship.bar.Size = UDim2.fromScale(t, 1)
		ship.bar.BackgroundColor3 = Color3.fromRGB(230, 90, 70):Lerp(Color3.fromRGB(120, 200, 100), t)
	end
end

-- Ships ---------------------------------------------------------------------

local function newShip(kindName: string, start: CFrame, owner: Player?, title: string)
	local kind = KINDS[kindName]
	local model = ModelFactory.longship(kind.length, kind.sail)
	model.Name = title
	model:SetAttribute("Ship", true)
	model:SetAttribute("OwnerUserId", owner and owner.UserId or 0)
	if not owner then
		-- raiders crew their own ship, in war gear
		ModelFactory.addCrew(model, 8, rng, 4)
	end
	if owner then
		local colony = services.ColonyService:Get(owner)
		if colony then
			services.ClanService:Apply(colony, model) -- the sail in the clan's colours
		end
	end
	model:PivotTo(start)
	model.Parent = workspace
	local ship = {
		kind = kindName,
		model = model,
		owner = owner,
		title = title,
		cf = start,
		speed = 0,
		maxSpeed = kind.speed,
		turn = kind.turn,
		length = kind.length,
		ramPower = kind.ram,
		hp = kind.hull,
		maxHp = kind.hull,
		idle = 0,
		lastVolley = 0,
		lastRam = 0,
	}
	makeHullBar(ship)
	ships[ship] = true
	return ship
end

local function destroyShip(ship)
	ships[ship] = nil
	if ship.owner and boats[ship.owner] == ship then
		boats[ship.owner] = nil
	end
	if ship.model then
		ship.model:Destroy()
	end
end

local function removeBoat(player: Player)
	local ship = boats[player]
	if ship then
		destroyShip(ship)
	end
end

local function notify(player: Player?, text: string, kind: string)
	if player then
		local colony = services.ColonyService:Get(player)
		if colony then
			services.ColonyService:Notify(colony, text, kind)
		end
	end
end

local function jettyCFrame(player: Player): CFrame?
	local colony = services.ColonyService:Get(player)
	if not colony then
		return nil
	end
	local o = Grid.plotOrigin(colony.plotIndex)
	return CFrame.new(o.X + Grid.PLOT_SIZE * 0.25, 4, -70)
end

local function sink(ship, attacker: Player?)
	if ship.sinking then
		return
	end
	ship.sinking = true
	ships[ship] = nil
	if ship.owner and boats[ship.owner] == ship then
		boats[ship.owner] = nil
	end

	-- the crew jumps clear and is fished out at their jetty
	local seat = ship.seat
	local occupant = seat and seat.Occupant
	if occupant then
		occupant.Sit = false
		occupant.Jump = true
		local player = Players:GetPlayerFromCharacter(occupant.Parent)
		task.delay(2.5, function()
			local cf = player and jettyCFrame(player)
			if cf and player.Character then
				player.Character:PivotTo(cf)
			end
		end)
	end

	if ship.owner then
		notify(ship.owner, "Your ship has been sunk! Build another at the jetty.", "bad")
	end
	if attacker then
		local colony = services.ColonyService:Get(attacker)
		if colony and ship.owner ~= attacker then
			local loot = ship.owner and { Silver = 8, Food = 15 } or N.RaiderLoot
			for res, amount in loot do
				services.ColonyService:Add(colony, res, amount)
			end
			services.QuestService:Count(colony, "sunk")
			services.ColonyService:Notify(colony, ship.title .. " sinks beneath the waves! Plundered " .. Grid.costText(loot), "raid")
		end
	end

	Sounds.play("Splash", ship.cf.Position)
	-- list, settle and slip under
	local model = ship.model
	local startCf = ship.cf
	local tilt = rng:NextNumber(-1, 1) > 0 and 1 or -1
	task.spawn(function()
		local t0 = os.clock()
		while model.Parent and os.clock() - t0 < 6 do
			local t = (os.clock() - t0) / 6
			model:PivotTo(startCf * CFrame.new(0, -t * t * 22, 0) * CFrame.Angles(t * 0.5, 0, tilt * t * 0.9))
			task.wait()
		end
		model:Destroy()
	end)
	if ship.kind == "Raider" then
		task.delay(N.RaiderRespawn, function()
			BoatService:SpawnRaider()
		end)
	end
end

local function damage(ship, amount: number, attacker: Player?)
	if ship.sinking or not ships[ship] then
		return
	end
	ship.hp -= amount
	updateBar(ship)
	if ship.hp <= 0 then
		sink(ship, attacker)
	end
end

-- Combat --------------------------------------------------------------------

-- An arrow from a player's bow landed on `inst`: if it's part of an enemy ship, hurt it.
-- The player's own ship while they are at its helm (nil otherwise).
function BoatService:ShipOf(player: Player)
	local ship = boats[player]
	if ship and ships[ship] and not ship.sinking and ship.seat and ship.seat.Occupant and ship.seat.Occupant.Parent == player.Character then
		return ship
	end
	return nil
end

function BoatService:ArrowHit(inst: Instance, player: Player)
	for ship in ships do
		if ship.owner ~= player and inst:IsDescendantOf(ship.model) then
			damage(ship, N.VolleyDamage * 0.6, player)
			return
		end
	end
end

-- Distance from a point to a ship's keel line (so long ships are hit along their length).
local function distanceToShip(ship, point: Vector3): number
	local half = ship.length / 2
	local rel = ship.cf:PointToObjectSpace(point)
	local z = math.clamp(rel.Z, -half, half)
	return (Vector3.new(rel.X, 0, rel.Z - z)).Magnitude
end

local function isEnemy(a, b): boolean
	if a == b or b.sinking then
		return false
	end
	if a.owner == nil and b.owner == nil then
		return false -- raiders don't fight each other
	end
	return a.owner ~= b.owner
end

local function nearestEnemy(ship, range: number)
	local best, bestDist = nil, range
	for other in ships do
		-- raiders leave you alone in your own harbour
		local safe = ship.owner == nil and other.dock ~= nil and (other.cf.Position - other.dock).Magnitude < 50
		if isEnemy(ship, other) and not safe then
			local d = (other.cf.Position - ship.cf.Position).Magnitude
			if d < bestDist then
				best, bestDist = other, d
			end
		end
	end
	return best
end

local function volley(ship)
	local now = os.clock()
	local cooldown = ship.owner and N.VolleyCooldown or N.VolleyCooldown * 1.7
	if ship.sinking or now - ship.lastVolley < cooldown then
		return false
	end
	local target = nearestEnemy(ship, N.VolleyRange)
	if not target then
		return false
	end
	ship.lastVolley = now
	Sounds.play("Bow", ship.cf.Position)
	local attacker = ship.owner
	local hits = 0
	local accuracy = attacker and 0.75 or 0.55
	if attacker and services.ColonyService:Has(services.ColonyService:Get(attacker), "Longbows") then
		accuracy = 0.9
	end
	-- every warrior aboard looses one more arrow
	local arrows = N.VolleyArrows + (attacker and services.WarbandService and services.WarbandService:CrewCount(attacker) or 0)
	for i = 1, arrows do
		local from = ship.cf * CFrame.new(rng:NextNumber(-2, 2), 4, (i - arrows / 2) * ship.length / (arrows + 1))
		local hit = rng:NextNumber() < accuracy
		local aim = target.cf * CFrame.new(rng:NextNumber(-2, 2), 3, rng:NextNumber(-target.length / 2.5, target.length / 2.5))
		local to = hit and aim.Position or (aim.Position + Vector3.new(rng:NextNumber(-10, 10), -3, rng:NextNumber(-10, 10)))
		if hit then
			hits += 1
		end
		task.delay(i * 0.08, function()
			local arrow = ModelFactory.arrow()
			local mid = (from.Position + to) / 2 + Vector3.new(0, (to - from.Position).Magnitude * 0.15, 0)
			arrow.CFrame = CFrame.lookAt(from.Position, mid)
			arrow.Parent = workspace
			local flight = (to - from.Position).Magnitude / 120
			TweenService:Create(arrow, TweenInfo.new(flight / 2, Enum.EasingStyle.Linear), { CFrame = CFrame.lookAt(mid, to) }):Play()
			task.delay(flight / 2, function()
				if arrow.Parent then
					TweenService:Create(arrow, TweenInfo.new(flight / 2, Enum.EasingStyle.Linear), { CFrame = CFrame.lookAt(to, to + (to - mid).Unit) }):Play()
				end
			end)
			Debris:AddItem(arrow, flight + 2)
		end)
	end
	local flight = (target.cf.Position - ship.cf.Position).Magnitude / 120
	task.delay(flight, function()
		damage(target, hits * N.VolleyDamage, attacker)
	end)
	return true
end

local function checkRam(ship, now: number)
	if ship.sinking or now - ship.lastRam < 1.5 or ship.speed < ship.maxSpeed * 0.45 then
		return
	end
	local bow = ship.cf.Position + ship.cf.LookVector * ship.length / 2
	for other in ships do
		if other ~= ship and not other.sinking and distanceToShip(other, bow) < 5.5 then
			ship.lastRam = now
			local force = ship.speed / ship.maxSpeed
			if isEnemy(ship, other) then
				damage(other, N.RamDamage * ship.ramPower * force, ship.owner)
			end
			damage(ship, N.RamSelfDamage * force, other.owner)
			other.cf += ship.cf.LookVector * 4
			ship.speed = -ship.speed * 0.3
			notify(ship.owner, "RAM! Timber splinters!", "gain")
			notify(other.owner, "You've been rammed!", "bad")
			return
		end
	end
end

-- Movement shared by every ship. Returns the turn rate used (for the roll).
local function steerShip(ship, throttle: number, steerInput: number, step: number): number
	local weather = services.WeatherService
	-- warriors at the oars row faster (WarbandService)
	local crew = ship.owner and services.WarbandService and services.WarbandService:CrewBonus(ship.owner) or 0
	local target = throttle * ship.maxSpeed * (throttle < 0 and 0.4 or 1) * (weather and weather:ShipSpeed() or 1) * (1 + crew)
	ship.speed += (target - ship.speed) * math.min(1, step * 0.8)
	local turnRate = steerInput * ship.turn * math.clamp(math.abs(ship.speed) / 10, 0.25, 1)
	local heading = ship.cf * CFrame.Angles(0, -turnRate * step, 0)
	local nextPos = heading.Position + heading.LookVector * ship.speed * step
	if isWater(nextPos + heading.LookVector * 8 * math.sign(ship.speed)) then
		ship.cf = CFrame.new(nextPos) * heading.Rotation
	else
		ship.speed = 0 -- ran aground
		ship.cf = heading
	end
	return turnRate
end

-- The raider's brain: patrol, then close in, keep broadside on, and loose volleys.
local function raiderThink(ship): (number, number)
	local target = nearestEnemy(ship, N.RaiderAggro * (services.WeatherService and services.WeatherService:Sight() or 1))
	local goal
	if target then
		local d = (target.cf.Position - ship.cf.Position).Magnitude
		if d > 45 then
			goal = target.cf.Position
		else
			-- circle the target so the archers have a clear line
			local side = ship.cf.RightVector
			goal = ship.cf.Position + ship.cf.LookVector * 30 + side * 10
		end
		volley(ship)
	else
		if not ship.waypoint or (ship.waypoint - ship.cf.Position).Magnitude < 20 then
			for _ = 1, 12 do
				local p = Vector3.new(rng:NextNumber(-320, 520), 0, rng:NextNumber(-230, -120))
				if isWater(p) then
					ship.waypoint = p
					break
				end
			end
		end
		goal = ship.waypoint or ship.cf.Position
	end
	local localGoal = ship.cf:PointToObjectSpace(goal)
	local steer = math.clamp(localGoal.X / 20, -1, 1)
	local throttle = target and 1 or 0.6
	if ship.speed < 1 and ship.stuckSince and os.clock() - ship.stuckSince > 3 then
		ship.waypoint = nil
		steer = 1
		throttle = -1
	end
	if math.abs(ship.speed) < 1 then
		ship.stuckSince = ship.stuckSince or os.clock()
	else
		ship.stuckSince = nil
	end
	return throttle, steer
end

function BoatService:SpawnRaider()
	for _ = 1, 30 do
		local p = Vector3.new(rng:NextNumber(-250, 400), 0, rng:NextNumber(-220, -140))
		if isWater(p) then
			newShip("Raider", CFrame.new(p) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0), nil, "Greywater Raider")
			return
		end
	end
	task.delay(30, function()
		self:SpawnRaider()
	end)
end

-- Launching -----------------------------------------------------------------

local function launch(player: Player, dockIndex: number)
	local ColonyService = services.ColonyService
	local colony = ColonyService:Get(player)
	if not colony then
		return
	end
	if colony.plotIndex ~= dockIndex then
		ColonyService:Notify(colony, "This is someone else's jetty. Use the one in front of your plot.", "bad")
		return
	end
	local kindName = ColonyService:Has(colony, "Longship") and "Longship" or (ColonyService:Has(colony, "Karve") and "Karve")
	if not kindName then
		ColonyService:Notify(colony, "Build a Shipyard and research Karve first (press T).", "bad")
		return
	end
	local kind = KINDS[kindName]
	removeBoat(player)

	local o = Grid.plotOrigin(dockIndex)
	local start = CFrame.new(o.X + Grid.PLOT_SIZE * 0.25 - 16, 0, -100)
	local ship = newShip(kindName, start, player, player.DisplayName .. "'s " .. kindName)
	local seat = Instance.new("Seat")
	seat.Name = "Helm"
	seat.Anchored = true
	seat.Size = Vector3.new(2, 0.6, 2)
	seat.Color = Color3.fromRGB(90, 64, 44)
	seat.Material = Enum.Material.Wood
	-- on the deck: a mesh hull rides higher than the block-built one
	local deckY = ship.model:FindFirstChildWhichIsA("MeshPart", true) and 1.1 or 0.2
	seat.CFrame = start * CFrame.new(0, deckY, kind.length * 0.32)
	seat:SetAttribute("Boat", true)
	seat.Parent = ship.model
	ship.seat = seat
	ship.dock = start.Position
	boats[player] = ship
	Sounds.play("Splash", start.Position)
	services.QuestService:Count(colony, "launch")

	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		character:PivotTo(seat.CFrame * CFrame.new(0, 3, 0))
		task.wait(0.1)
		seat:Sit(humanoid)
	end
	ColonyService:Notify(colony, "Your " .. kindName .. " is in the water! W/S row, A/D steer, F volley of arrows, ram enemies at speed.", "good")
end

function BoatService:Start()
	-- a launch prompt at the end of every plot's jetty
	for i = 1, Config.MAX_PLOTS do
		local o = Grid.plotOrigin(i)
		local anchor = Instance.new("Part")
		anchor.Name = "LaunchPoint"
		anchor.Anchored = true
		anchor.CanCollide = false
		anchor.CanQuery = false
		anchor.Transparency = 1
		anchor.Size = Vector3.new(1, 1, 1)
		anchor.Position = Vector3.new(o.X + Grid.PLOT_SIZE * 0.25, 3, -76)
		anchor.Parent = workspace
		local prompt = Instance.new("ProximityPrompt")
		prompt.ActionText = "Launch boat"
		prompt.ObjectText = "Jetty"
		prompt.HoldDuration = 1
		prompt.MaxActivationDistance = 12
		prompt.RequiresLineOfSight = false
		prompt.Parent = anchor
		prompt.Triggered:Connect(function(player)
			launch(player, i)
		end)
	end

	Remotes.BoatInput.OnServerEvent:Connect(function(player, throttle, steer)
		if typeof(throttle) ~= "number" or typeof(steer) ~= "number" or throttle ~= throttle or steer ~= steer then
			return
		end
		inputs[player] = { math.clamp(throttle, -1, 1), math.clamp(steer, -1, 1) }
	end)
	Remotes.BoatFire.OnServerEvent:Connect(function(player)
		local ship = boats[player]
		if ship and ship.seat and ship.seat.Occupant and ship.seat.Occupant.Parent == player.Character then
			if not volley(ship) and os.clock() - ship.lastVolley >= N.VolleyCooldown then
				notify(player, "No enemy ship in bow range (" .. N.VolleyRange .. " studs).", "info")
			end
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		removeBoat(player)
		inputs[player] = nil
	end)

	self:SpawnRaider()

	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		if accumulator < 1 / 30 then
			return
		end
		local step = accumulator
		accumulator = 0
		local now = os.clock()
		for ship in ships do
			local throttle, steer = 0, 0
			if ship.owner then
				local occupied = ship.seat.Occupant ~= nil
				if occupied then
					ship.idle = 0
					local input = inputs[ship.owner] or { 0, 0 }
					throttle, steer = input[1], input[2]
				else
					ship.idle += step
					if ship.idle > 90 then
						destroyShip(ship)
						continue
					end
				end
				-- moored near your own jetty: the shipwrights patch the hull
				if ship.hp < ship.maxHp and (ship.cf.Position - ship.dock).Magnitude < 40 then
					ship.hp = math.min(ship.maxHp, ship.hp + N.RepairPerSecond * step)
					updateBar(ship)
				end
			else
				throttle, steer = raiderThink(ship)
			end
			local turnRate = steerShip(ship, throttle, steer, step)
			checkRam(ship, now)
			if ships[ship] then
				-- storms toss the ships about
				local storm = 1 + (workspace:GetAttribute("StormLevel") or 0) * 3
				local bob = math.sin(now * 1.3 + ship.length) * 0.25 * storm
				local roll = math.sin(now * 0.9) * math.rad(2) * storm - turnRate * 0.08
				local pitch = math.sin(now * 1.1 + ship.length) * math.rad(1) * storm
				ship.model:PivotTo(ship.cf * CFrame.new(0, bob, 0) * CFrame.Angles(pitch, 0, roll))
			end
		end
	end)
end

return BoatService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">BuildingService</string>
            <string name="Source"><![CDATA[--[[
	BuildingService
	Validates and performs building placement and demolition requested by
	clients. The server always re-checks everything (cost, bounds, overlap)
	because clients can't be trusted.
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Sounds = require(Shared.Sounds)
local Grid = require(Shared.Grid)
local Remotes = require(Shared.Remotes)
local ModelFactory = require(Shared.ModelFactory)

local BuildingService = {}

local services

function BuildingService:Init(allServices)
	services = allServices
end

-- Construction effect: the building rises out of the ground in a puff of dust.
local function raiseUp(model: Model, finalCFrame: CFrame)
	local _, size = model:GetBoundingBox()
	local depth = size.Y + 1
	local dust = Instance.new("Part")
	dust.Anchored = true
	dust.CanCollide = false
	dust.CanQuery = false
	dust.Transparency = 1
	dust.Size = Vector3.new(size.X, 1, size.Z)
	dust.CFrame = finalCFrame
	dust.Parent = model.Parent
	local puff = Instance.new("Smoke")
	puff.Color = Color3.fromRGB(150, 130, 100)
	puff.Opacity = 0.25
	puff.RiseVelocity = 2
	puff.Size = math.max(size.X, size.Z) / 3
	puff.Parent = dust
	task.spawn(function()
		local duration = 1.2
		local start = os.clock()
		while model.Parent do
			local t = math.min((os.clock() - start) / duration, 1)
			local e = 1 - (1 - t) ^ 3 -- ease out
			model:PivotTo(finalCFrame * CFrame.new(0, -depth * (1 - e), 0))
			if t >= 1 then
				break
			end
			task.wait()
		end
		puff.Enabled = false
		task.wait(2)
		dust:Destroy()
	end)
end

-- Creates the building without any checks or cost. Returns the building record.
-- Walls -------------------------------------------------------------------------
-- Palisade pieces join their neighbours (walls and gates) into one closed wall.

local SIDES = { { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } } -- E, W, S, N in cells

local function wallAt(colony, cx: number, cz: number)
	for _, b in colony.buildings do
		if b.cx == cx and b.cz == cz and Config.Buildings[b.type].Wall then
			return b
		end
	end
	return nil
end

-- Does the piece `b` join onto whatever is on side `k`?
local function joins(colony, b, k: number): boolean
	local n = wallAt(colony, b.cx + SIDES[k][1], b.cz + SIDES[k][2])
	if not n then
		return false
	end
	if Config.Buildings[n.type].Gate then
		-- a gate takes walls only on its post sides, never across the way through
		return (n.rot % 2 == 0) == (k <= 2)
	end
	return true
end

local function reshapeWall(colony, b)
	if b.type ~= "Palisade" or not b.model.Parent then
		return
	end
	local arms = { joins(colony, b, 1), joins(colony, b, 2), joins(colony, b, 3), joins(colony, b, 4) }
	local fresh = ModelFactory.palisadeJoined(arms, b.id)
	fresh:PivotTo(CFrame.new(b.center))
	for _, child in b.model:GetChildren() do
		if child:IsA("BasePart") or child:IsA("Model") then
			child:Destroy()
		end
	end
	for _, child in fresh:GetChildren() do
		child.Parent = b.model
	end
	fresh:Destroy()
	b.model.WorldPivot = CFrame.new(b.center)
	services.SeasonService:ApplyTo(b.model)
end

-- Reshapes the wall at a cell and the four around it.
local function refreshWallsAround(colony, cx: number, cz: number)
	local here = wallAt(colony, cx, cz)
	if here then
		reshapeWall(colony, here)
	end
	for _, side in SIDES do
		local n = wallAt(colony, cx + side[1], cz + side[2])
		if n then
			reshapeWall(colony, n)
		end
	end
end

function BuildingService:Create(colony, buildingType: string, cx: number, cz: number, rot: number, animate: boolean?)
	local ColonyService = services.ColonyService
	local sx, sz = Grid.footprint(buildingType, rot)
	local id = ColonyService:NewId(colony)

	local model = ModelFactory.building(buildingType)
	model.Name = buildingType .. "_" .. id
	model:SetAttribute("BuildingId", id)
	model:SetAttribute("BuildingType", buildingType)
	model:SetAttribute("OwnerUserId", colony.player.UserId)
	local finalCFrame = Grid.buildingCFrame(colony.origin, cx, cz, sx, sz, rot)
	model:PivotTo(finalCFrame)
	-- clear and level the ground under it (palisades are too small to bother)
	if not Config.Buildings[buildingType].Wall and not Config.Buildings[buildingType].Decor and services.WorldService.LevelUnder then
		services.WorldService:LevelUnder(finalCFrame, sx * Config.CELL, sz * Config.CELL)
	end
	-- stand it on the ground as it is really drawn (terrain voxels can leave the
	-- surface a little above GROUND_Y), so nothing sits sunk in the dirt
	if not Config.Buildings[buildingType].Shore and services.WorldService.GroundUnder then
		local y = services.WorldService:GroundUnder(finalCFrame.Position, sx * Config.CELL, sz * Config.CELL)
		local lift = math.clamp(y - finalCFrame.Position.Y, 0, 4)
		if lift > 0.05 then
			finalCFrame += Vector3.new(0, lift, 0)
			model:PivotTo(finalCFrame)
		end
	end
	services.SeasonService:ApplyTo(model) -- e.g. snow on the roof in winter
	services.ClanService:Apply(colony, model) -- banners in the clan's colours
	model.Parent = colony.plot.Buildings
	if animate and not Config.Buildings[buildingType].Wall then
		raiseUp(model, finalCFrame)
	end

	local building = {
		id = id,
		type = buildingType,
		cx = cx,
		cz = cz,
		rot = rot,
		sx = sx,
		sz = sz,
		model = model,
		center = Grid.rectCenter(colony.origin, cx, cz, sx, sz),
	}
	colony.buildings[id] = building

	Grid.eachCell(cx, cz, sx, sz, function(x, z)
		ColonyService:Block(colony, x, z, "building")
	end)
	if Config.Buildings[buildingType].Wall then
		refreshWallsAround(colony, cx, cz)
	end
	return building
end

function BuildingService:PlaceStarting(colony)
	local sx, sz = Grid.footprint("Longhouse", 0)
	local cx = math.floor((Config.PLOT_CELLS - sx) / 2)
	local cz = math.floor((Config.PLOT_CELLS - sz) / 2)
	self:Create(colony, "Longhouse", cx, cz, 0)
end

function BuildingService:TryPlace(player: Player, buildingType, cx, cz, rot)
	local ColonyService = services.ColonyService
	local colony = ColonyService:Get(player)
	if not colony then
		return false, "Your colony isn't ready yet"
	end
	-- Validate the types of everything the client sent.
	if typeof(buildingType) ~= "string" or not Config.Buildings[buildingType] then
		return false, "Unknown building"
	end
	if typeof(cx) ~= "number" or typeof(cz) ~= "number" or typeof(rot) ~= "number" then
		return false, "Bad position"
	end
	cx, cz, rot = math.floor(cx), math.floor(cz), math.floor(rot) % 4
	if rot ~= rot or cx ~= cx or cz ~= cz then -- NaN / infinity guard
		return false, "Bad position"
	end

	local def = Config.Buildings[buildingType]
	if def.Rank and services.RankService:Rank(colony) < def.Rank then
		return false, "Become a " .. Config.Ranks[def.Rank].Name .. " first (grow your village)"
	end
	if def.Requires and not ColonyService:Has(colony, def.Requires) then
		return false, "Research " .. Config.Tech[def.Requires].Name .. " first (press T)"
	end
	if def.Shore then
		rot = 0 -- a jetty always runs out to sea
	end
	local sx, sz = Grid.footprint(buildingType, rot)
	local ok, reason = Grid.canPlace(colony.blocked, cx, cz, sx, sz, colony.land, buildingType)
	if not ok then
		return false, reason
	end
	if not ColonyService:Spend(colony, def.Cost) then
		return false, "Not enough resources (" .. Grid.costText(def.Cost) .. ")"
	end

	local building = self:Create(colony, buildingType, cx, cz, rot, true)
	Sounds.play("Build", building.center)
	ColonyService:Sync(colony)
	return true, def.Display .. " built"
end

function BuildingService:TryDemolish(player: Player, id)
	local ColonyService = services.ColonyService
	local colony = ColonyService:Get(player)
	if not colony or typeof(id) ~= "number" then
		return false, "Nothing to demolish"
	end
	local building = colony.buildings[id]
	if not building then
		return false, "That isn't yours"
	end
	local def = Config.Buildings[building.type]
	if def.Housing then
		local homes = 0
		for _, b in colony.buildings do
			if Config.Buildings[b.type].Housing then
				homes += 1
			end
		end
		if homes <= 1 then
			return false, "You can't tear down your last home"
		end
	end

	colony.buildings[id] = nil
	building.model:Destroy()
	Grid.eachCell(building.cx, building.cz, building.sx, building.sz, function(x, z)
		ColonyService:Unblock(colony, x, z)
	end)
	for name, amount in def.Cost do
		ColonyService:Add(colony, name, math.floor(amount * Config.DemolishRefund))
	end
	services.VillagerService:OnBuildingRemoved(colony, id)
	if def.Wall then
		refreshWallsAround(colony, building.cx, building.cz)
	end
	ColonyService:Sync(colony)
	return true, def.Display .. " demolished"
end

function BuildingService:Start()
	Remotes.PlaceBuilding.OnServerInvoke = function(player, buildingType, cx, cz, rot)
		return self:TryPlace(player, buildingType, cx, cz, rot)
	end
	Remotes.DemolishBuilding.OnServerInvoke = function(player, id)
		return self:TryDemolish(player, id)
	end
end

return BuildingService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">ClanService</string>
            <string name="Source"><![CDATA[--[[
	ClanService
	Your clan's colours (Jarl's Table > Land & clan). They go on the banners
	of your halls, the Great Hall's standards and the sail of your longship.
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local ModelFactory = require(Shared.ModelFactory)

local ClanService = {}

local services

function ClanService:Init(all)
	services = all
end

local function colours(colony)
	local name = colony.clan or "Blood"
	for _, c in Config.ClanColours do
		if c.Name == name then
			return c
		end
	end
	return Config.ClanColours[1]
end

-- Is this part a banner, standard or sail cloth (and is it the main colour)?
local function role(part: BasePart): string?
	local n = part.Name
	if n == "Banner" or n == "Cloth" or n == "Sail" then
		return "main"
	elseif n == "BannerCloth" then
		return part.Size.X < 1 and "trim" or "main"
	elseif n == "Emblem" or n == "SailStripe" then
		return "trim"
	end
	local kind, hex = string.match(n, "^Mat_(%a+)_(%x%x%x%x%x%x)")
	if kind == "Cloth" then
		local c = Color3.fromHex(hex)
		if c.R > c.G * 1.6 and c.R > c.B * 1.6 then
			return "main" -- the red cloth of a mesh banner or sail
		end
	end
	return nil
end

-- Paints the clan's colours onto every banner and sail inside `root`.
function ClanService:Apply(colony, root: Instance)
	local c = colours(colony)
	for _, d in root:GetDescendants() do
		if d:IsA("BasePart") then
			local r = role(d)
			if r == "main" then
				d.Color = c.Main
			elseif r == "trim" then
				d.Color = c.Trim
			end
			if r then
				ModelFactory.retintTexture(d)
			end
		end
	end
end

function ClanService:ApplyAll(colony)
	if colony.plot then
		self:Apply(colony, colony.plot)
	end
	local ship = services.BoatService and services.BoatService:ShipOf(colony.player)
	if ship and ship.model then
		self:Apply(colony, ship.model)
	end
end

function ClanService:SetColours(colony, name: string?): (boolean, string)
	for _, c in Config.ClanColours do
		if c.Name == name then
			colony.clan = name
			self:ApplyAll(colony)
			services.ColonyService:Notify(colony, "Your banners now fly the colours of the " .. c.Label .. ".", "good")
			services.ColonyService:Sync(colony)
			return true, c.Label
		end
	end
	return false, "Unknown colours."
end

return ClanService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">ColonyService</string>
            <string name="Source"><![CDATA[--[[
	ColonyService
	Owns each player's colony: resources, the grid of blocked cells, and the
	main simulation loop. Other services read and change the colony table
	through the helpers here, and ColonyService sends a snapshot to the
	player's HUD every tick.

	colony = {
		player, plotIndex, origin, plot,
		resources = { Wood = n, Stone = n, Food = n },
		blocked = { ["x,z"] = "building" | "node" },
		buildings = { [id] = building },
		villagers = { [id] = villager },
		nodes = { [key] = node },
		happiness, day, dayTimer, starving, nextId, gridDirty,
	}
]]

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Grid = require(Shared.Grid)
local Remotes = require(Shared.Remotes)

local ColonyService = {}

local services
local colonies = {} -- [player] = colony

function ColonyService:Init(allServices)
	services = allServices
end

function ColonyService:Get(player: Player)
	return colonies[player]
end

function ColonyService:All()
	return colonies
end

-- Has this colony researched `techId`?
function ColonyService:Has(colony, techId: string): boolean
	return colony ~= nil and colony.tech[techId] == true
end

function ColonyService:HasBuilding(colony, buildingType: string): boolean
	for _, b in colony.buildings do
		if b.type == buildingType then
			return true
		end
	end
	return false
end

function ColonyService:NewId(colony): number
	colony.nextId += 1
	return colony.nextId
end

-- Resources -----------------------------------------------------------------

function ColonyService:Storage(colony): number
	local total = Config.BaseStorage
	for _, b in colony.buildings do
		total += Config.Buildings[b.type].Storage or 0
	end
	return total
end

function ColonyService:Housing(colony): number
	local total = 0
	for _, b in colony.buildings do
		total += Config.Buildings[b.type].Housing or 0
	end
	return total
end

function ColonyService:Add(colony, resource: string, amount: number)
	local cap = self:Storage(colony)
	colony.resources[resource] = math.clamp((colony.resources[resource] or 0) + amount, 0, cap)
end

function ColonyService:CanAfford(colony, cost): boolean
	return Grid.canAfford(colony.resources, cost)
end

function ColonyService:Spend(colony, cost): boolean
	if not self:CanAfford(colony, cost) then
		return false
	end
	for name, amount in cost do
		colony.resources[name] -= amount
	end
	return true
end

-- Grid ----------------------------------------------------------------------

function ColonyService:Block(colony, x: number, z: number, what: string)
	colony.blocked[Grid.key(x, z)] = what
	colony.gridDirty = true
end

function ColonyService:Unblock(colony, x: number, z: number)
	colony.blocked[Grid.key(x, z)] = nil
	colony.gridDirty = true
end

-- Messages ------------------------------------------------------------------

function ColonyService:Notify(colony, text: string, kind: string?)
	Remotes.Notify:FireClient(colony.player, text, kind or "info")
end

-- Sync ----------------------------------------------------------------------

function ColonyService:Sync(colony)
	local adults, children, workers = 0, 0, 0
	for _, v in colony.villagers do
		if v.isChild then
			children += 1
		else
			adults += 1
			if v.job then
				workers += 1
			end
		end
	end

	local resources = {}
	for _, name in Config.ResourceOrder do
		resources[name] = math.floor(colony.resources[name] or 0)
	end

	local state = {
		resources = resources,
		storage = self:Storage(colony),
		population = adults + children,
		adults = adults,
		children = children,
		workers = workers,
		idle = adults - workers,
		housing = self:Housing(colony),
		happiness = math.floor(colony.happiness + 0.5),
		starving = colony.starving,
		cold = colony.cold,
		day = colony.day,
		season = workspace:GetAttribute("Season") or "Summer",
		tech = (function()
			local list = {}
			for id in colony.tech do
				table.insert(list, id)
			end
			return list
		end)(),
		buildingTypes = (function()
			local set = {}
			for _, b in colony.buildings do
				set[b.type] = true
			end
			return set
		end)(),
		dayProgress = colony.dayTimer / Config.DAY_LENGTH,
		quest = services.QuestService:State(colony),
		rank = services.RankService:State(colony),
		land = colony.land or 1,
		council = (function()
			local ok, council = pcall(services.CouncilService.State, services.CouncilService, colony)
			return ok and council or nil
		end)(),
	}

	if colony.gridDirty then
		local blocked = {}
		for key in colony.blocked do
			table.insert(blocked, key)
		end
		state.blocked = blocked
		colony.gridDirty = false
	end

	Remotes.ColonyState:FireClient(colony.player, state)
end

-- Lifecycle -----------------------------------------------------------------

function ColonyService:Create(player: Player)
	local index, origin, plot = services.PlotService:Assign(player)
	if not index then
		return
	end

	local colony = {
		player = player,
		plotIndex = index,
		origin = origin,
		plot = plot,
		resources = table.clone(Config.StartingResources),
		blocked = {},
		buildings = {},
		villagers = {},
		nodes = {},
		tech = {},
		stats = {},
		quest = 1,
		happiness = 60,
		day = 1,
		dayTimer = 0,
		starving = false,
		nextId = 0,
		gridDirty = true,
	}
	local SaveService = services.SaveService
	local data, canSave = SaveService:Load(player)
	if not player.Parent then
		return -- left while loading
	end
	colony.canSave = canSave
	colonies[player] = colony
	player:SetAttribute("PlotIndex", index) -- for the minimap

	if data then
		SaveService:Restore(colony, data)
	else
		services.BuildingService:PlaceStarting(colony)
		services.VillagerService:SpawnStarting(colony)
	end
	services.ResourceNodeService:SpawnInitial(colony)

	if data then
		self:Notify(colony, "Welcome back! Your village is as you left it (day " .. colony.day .. ").", "good")
	else
		self:Notify(colony, "Your people have landed. Build a farm and a woodcutter to get started!", "good")
	end
	if not canSave then
		task.delay(4, function()
			self:Notify(colony, SaveService:WhyOff(), "bad")
		end)
	end
	self:Sync(colony)
end

function ColonyService:Start()
	Players.PlayerAdded:Connect(function(player)
		self:Create(player)
	end)
	for _, player in Players:GetPlayers() do
		if not colonies[player] then
			self:Create(player)
		end
	end
	Players.PlayerRemoving:Connect(function(player)
		local colony = colonies[player]
		if colony then
			services.SaveService:Save(colony)
			services.VillagerService:Cleanup(colony)
		end
		colonies[player] = nil
	end)

	-- Main simulation loop.
	while true do
		local dt = task.wait(Config.TICK)
		for _, colony in colonies do
			local ok, err = pcall(function()
				services.VillagerService:Tick(colony, dt)
				services.ResourceNodeService:Tick(colony, dt)
				self:Sync(colony)
			end)
			if not ok then
				warn("[ColonyService] tick error: " .. tostring(err))
			end
		end
	end
end

return ColonyService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">CouncilService</string>
            <string name="Source"><![CDATA[--[[
	CouncilService
	The Jarl's Table (J): one remote, "Council", for buying land, the war
	band, diplomacy and rites. Each action checks everything on the server.
	Also builds the table's state that goes out with every colony sync.
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Remotes = require(Shared.Remotes)

local CouncilService = {}

local services
local lastCall = {} -- [player] = os.clock(), a small guard against spam

function CouncilService:Init(all)
	services = all
end

function CouncilService:State(colony)
	return {
		land = services.LandService:State(colony),
		warband = services.WarbandService:State(colony),
		clan = colony.clan or "Blood",
		diplomacy = services.DiplomacyService:State(colony),
		rites = services.RiteService:State(colony),
	}
end

local function handle(colony, action: string, arg)
	if action == "BuyLand" then
		return services.LandService:Buy(colony)
	elseif action == "Hire" then
		return services.WarbandService:Hire(colony)
	elseif action == "Dismiss" then
		return services.WarbandService:Dismiss(colony)
	elseif action == "Follow" then
		return services.WarbandService:SetMode(colony, "follow")
	elseif action == "StayHome" then
		return services.WarbandService:SetMode(colony, "home")
	elseif action == "Colours" then
		return services.ClanService:SetColours(colony, arg)
	elseif action == "Formation" then
		return services.WarbandService:SetFormation(colony, arg)
	elseif action == "Expedition" then
		return services.WarbandService:Expedition(colony, arg)
	elseif action == "Gift" then
		return services.DiplomacyService:Gift(colony, arg)
	elseif action == "Demand" then
		return services.DiplomacyService:Demand(colony, arg)
	elseif action == "Ally" then
		return services.DiplomacyService:Ally(colony, arg)
	elseif action == "Deal" then
		return services.DiplomacyService:Deal(colony, arg)
	elseif action == "Feast" then
		return services.RiteService:Feast(colony)
	elseif action == "Blot" then
		return services.RiteService:Blot(colony)
	end
	return false, "Unknown action."
end

function CouncilService:Start()
	Remotes.Council.OnServerInvoke = function(player, action, arg)
		if typeof(action) ~= "string" or (arg ~= nil and typeof(arg) ~= "string") then
			return false, "Bad request."
		end
		local now = os.clock()
		if now - (lastCall[player] or 0) < 0.25 then
			return false, "Slow down."
		end
		lastCall[player] = now
		local colony = services.ColonyService:Get(player)
		if not colony then
			return false, "Your village isn't ready yet."
		end
		local ok, a, b = pcall(handle, colony, action, arg)
		if not ok then
			warn("[CouncilService] " .. action .. ": " .. tostring(a))
			return false, "Something went wrong."
		end
		services.ColonyService:Sync(colony)
		return a, b
	end
	game:GetService("Players").PlayerRemoving:Connect(function(player)
		lastCall[player] = nil
	end)
end

return CouncilService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">DiplomacyService</string>
            <string name="Source"><![CDATA[--[[
	DiplomacyService
	Each rival hold has a mood toward each village (Config.Diplomacy),
	from -100 (blood feud) to 100 (sworn allies). Instead of raiding them you can:
	  Gift      pay silver to warm their mood
	  Demand    a strong war band can force them to pay tribute for a few days
	  Ally      at a high mood: allied guards leave you alone, and allies never
	            send warbands against your village
	  Deal      at a friendly mood: a daily trade caravan swaps goods with you
	Attacking a hold (striking its guards, looting its chests, sending the war
	band) breaks any alliance, deal or tribute, and sours the mood.
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Grid = require(Shared.Grid)

local DiplomacyService = {}

local D = Config.Diplomacy
local services
local rng = Random.new()

function DiplomacyService:Init(all)
	services = all
end

local function holdNamed(name)
	if typeof(name) ~= "string" then
		return nil
	end
	for _, def in Config.Rivals do
		if def.Name == name then
			return def
		end
	end
	return nil
end

local function rel(colony, name: string)
	colony.relations = colony.relations or {}
	local r = colony.relations[name]
	if not r then
		r = { mood = 0, allied = false, deal = false, tributeDays = 0 }
		colony.relations[name] = r
	end
	return r
end

local function notify(colony, text, kind)
	services.ColonyService:Notify(colony, text, kind)
end

function DiplomacyService:IsAllied(colony, name: string): boolean
	local r = colony.relations and colony.relations[name]
	return r ~= nil and r.allied == true
end

-- Will this hold send warbands against the village? Not if allied or paying tribute.
function DiplomacyService:WillRaid(colony, name: string): boolean
	local r = colony.relations and colony.relations[name]
	if not r then
		return true
	end
	return not r.allied and (r.tributeDays or 0) <= 0 and r.mood < D.DealMood
end

-- Is the player at peace with this hold (its guards leave them alone)?
function DiplomacyService:IsAlliedPlayer(player: Player, name: string): boolean
	local colony = services.ColonyService:Get(player)
	return colony ~= nil and self:IsAllied(colony, name)
end

function DiplomacyService:OnHostile(colony, name: string)
	if not holdNamed(name) then
		return
	end
	local r = rel(colony, name)
	local was = r.allied or r.deal or r.tributeDays > 0
	r.allied = false
	r.deal = false
	r.tributeDays = 0
	r.mood = math.min(r.mood, D.AttackMood)
	if was then
		notify(colony, name .. " will remember this. Your pact with them is broken.", "bad")
	end
end

function DiplomacyService:Gift(colony, name: string): (boolean, string)
	local def = holdNamed(name)
	if not def then
		return false, "Pick a hold."
	end
	if not services.ColonyService:Spend(colony, D.GiftCost) then
		return false, "A fitting gift costs " .. Grid.costText(D.GiftCost) .. "."
	end
	local r = rel(colony, name)
	r.mood = math.min(100, r.mood + D.GiftGain)
	notify(colony, name .. " accepts your gift. (Mood " .. r.mood .. ")", "good")
	return true, "Gift sent"
end

function DiplomacyService:Demand(colony, name: string): (boolean, string)
	local def = holdNamed(name)
	if not def then
		return false, "Pick a hold."
	end
	local r = rel(colony, name)
	if r.allied then
		return false, "You don't demand tribute from an ally."
	end
	if r.tributeDays > 0 then
		return false, name .. " is already paying you tribute."
	end
	local Warband = services.WarbandService
	local ratio = Warband:Power(colony) / Warband:HoldPower(def)
	if ratio < D.DemandMinPower then
		return false, "Your war band is too weak to frighten them (" .. math.floor(ratio * 100) .. "% of what's needed: " .. math.floor(D.DemandMinPower * 100) .. "%)."
	end
	-- the stronger you are, the likelier they bend the knee
	if rng:NextNumber() < math.clamp(ratio * 0.8, 0.2, 0.9) then
		r.tributeDays = D.TributeDays
		r.mood = math.max(-100, r.mood - 15)
		notify(colony, name .. " bends the knee and will pay " .. Grid.costText(D.TributePerDay) .. " a day for " .. D.TributeDays .. " days.", "good")
		return true, "They pay"
	end
	r.mood = math.max(-100, r.mood - 30)
	-- an insult: they send a warband soon
	colony.nextRaidDay = math.min(colony.nextRaidDay or math.huge, colony.day + 1)
	notify(colony, name .. " laughs at your demand. Expect their warband!", "bad")
	return false, "They refused"
end

function DiplomacyService:Ally(colony, name: string): (boolean, string)
	local def = holdNamed(name)
	if not def then
		return false, "Pick a hold."
	end
	local r = rel(colony, name)
	if r.allied then
		return false, "Already allies."
	end
	if r.mood < D.AllianceMood then
		return false, name .. " needs a mood of " .. D.AllianceMood .. " to swear an alliance (now " .. r.mood .. "). Send gifts."
	end
	if not services.ColonyService:Spend(colony, D.AllianceCost) then
		return false, "The oath feast costs " .. Grid.costText(D.AllianceCost) .. "."
	end
	r.allied = true
	r.tributeDays = 0
	notify(colony, "You and " .. name .. " swear an alliance! Their guards are friends now and they will never raid you.", "good")
	services.QuestService:Count(colony, "ally")
	return true, "Allied"
end

function DiplomacyService:Deal(colony, name: string): (boolean, string)
	local def = holdNamed(name)
	local deal = def and D.Deals[name]
	if not deal then
		return false, "No trade with them."
	end
	local r = rel(colony, name)
	if r.deal then
		r.deal = false
		notify(colony, "You end the trade deal with " .. name .. ".", "info")
		return true, "Deal ended"
	end
	if r.mood < D.DealMood and not r.allied then
		return false, name .. " needs a mood of " .. D.DealMood .. " to trade (now " .. r.mood .. ")."
	end
	r.deal = true
	notify(colony, "Trade deal with " .. name .. ": each day you send " .. Grid.costText(deal.Give) .. " and get " .. Grid.costText(deal.Get) .. ".", "good")
	return true, "Deal made"
end

-- Once a day: caravans, tribute, and moods drifting back toward 0.
local function newDay(colony)
	local ColonyService = services.ColonyService
	for _, def in Config.Rivals do
		local r = colony.relations and colony.relations[def.Name]
		if r then
			if r.deal then
				local deal = D.Deals[def.Name]
				if deal and ColonyService:Spend(colony, deal.Give) then
					for res, n in deal.Get do
						ColonyService:Add(colony, res, n)
					end
					notify(colony, def.Name .. "'s caravan: +" .. Grid.costText(deal.Get), "gain")
				elseif deal then
					notify(colony, "You couldn't pay " .. def.Name .. "'s caravan (" .. Grid.costText(deal.Give) .. ").", "bad")
				end
			end
			if r.tributeDays > 0 then
				r.tributeDays -= 1
				for res, n in D.TributePerDay do
					ColonyService:Add(colony, res, n)
				end
				notify(colony, def.Name .. " pays tribute: +" .. Grid.costText(D.TributePerDay), "gain")
			end
			if not r.allied then
				if r.mood > 0 then
					r.mood = math.max(0, r.mood - D.DriftPerDay)
				elseif r.mood < 0 then
					r.mood = math.min(0, r.mood + D.DriftPerDay)
				end
			end
		end
	end
end

function DiplomacyService:State(colony)
	local list = {}
	local Warband = services.WarbandService
	local power = Warband:Power(colony)
	for _, def in Config.Rivals do
		local r = (colony.relations and colony.relations[def.Name]) or { mood = 0, allied = false, deal = false, tributeDays = 0 }
		local deal = D.Deals[def.Name]
		table.insert(list, {
			name = def.Name,
			mood = r.mood,
			allied = r.allied,
			deal = r.deal,
			tributeDays = r.tributeDays,
			dealText = deal and ("Send " .. Grid.costText(deal.Give) .. ", get " .. Grid.costText(deal.Get) .. " each day") or nil,
			fear = math.floor(power / Warband:HoldPower(def) * 100),
		})
	end
	return {
		holds = list,
		giftCost = D.GiftCost,
		allianceCost = D.AllianceCost,
		allianceMood = D.AllianceMood,
		dealMood = D.DealMood,
		demandNeed = math.floor(D.DemandMinPower * 100),
	}
end

function DiplomacyService:Start()
	while true do
		task.wait(1)
		for _, colony in services.ColonyService:All() do
			if colony.dipDay == nil then
				colony.dipDay = colony.day
			elseif colony.day > colony.dipDay then
				colony.dipDay = colony.day
				local ok, err = pcall(newDay, colony)
				if not ok then
					warn("[DiplomacyService] " .. tostring(err))
				end
			end
		end
	end
end

return DiplomacyService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">EventService</string>
            <string name="Source"><![CDATA[--[[
	EventService
	Small happenings that keep a village's life going: a skald visits, a
	great catch of herring, wolves at the stores, amber on the beach, a family
	asking to settle, a rich harvest, storm damage. Every few minutes one
	event that fits the season and your village happens, with a message.
	What you have built changes how some of them go: a Watchtower drives the
	wolves off, a Storehouse keeps the rats out.
]]

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Grid = require(Shared.Grid)

local EventService = {}

local services
local rng = Random.new()

local FIRST = 180 -- seconds after joining before the first event
local MIN_GAP, MAX_GAP = 240, 420

function EventService:Init(all)
	services = all
end

local function population(colony): number
	local n = 0
	for _ in colony.villagers do
		n += 1
	end
	return n
end

local function season(): string
	return workspace:GetAttribute("Season") or "Summer"
end

local function gain(colony, loot)
	for res, n in loot do
		services.ColonyService:Add(colony, res, n)
	end
	return Grid.costText(loot)
end

local function lose(colony, res: string, share: number): number
	local have = colony.resources[res] or 0
	local n = math.floor(have * share)
	if n > 0 then
		colony.resources[res] = have - n
	end
	return n
end

-- Each event: when it can happen (weight 0 = not now) and what it does.
local EVENTS = {
	{
		name = "Skald",
		weight = function()
			return 1
		end,
		run = function(colony)
			colony.happiness = math.min(100, (colony.happiness or 60) + 8)
			local text = gain(colony, { Lore = 12 })
			return "A wandering skald sings of old heroes in your hall. Your people are cheered (+" .. text .. ").", "good"
		end,
	},
	{
		name = "Herring",
		weight = function()
			return season() == "Winter" and 0.3 or 1
		end,
		run = function(colony)
			local text = gain(colony, { Food = 15 + population(colony) * 3 })
			return "The herring are running! Your people haul in nets full of fish (+" .. text .. ").", "good"
		end,
	},
	{
		name = "Wolves",
		weight = function(colony)
			return (season() == "Winter" and 1.6 or 0.6) * ((colony.resources.Food or 0) > 30 and 1 or 0)
		end,
		run = function(colony)
			if services.ColonyService:HasBuilding(colony, "Watchtower") then
				local text = gain(colony, { Hides = 6 })
				return "Wolves crept toward your stores, but your watchmen saw them and drove them off (+" .. text .. ").", "good"
			end
			local n = lose(colony, "Food", 0.15)
			return "Wolves got into your stores in the night and took " .. n .. " Food. A Watchtower would keep watch.", "bad"
		end,
	},
	{
		name = "Amber",
		weight = function()
			return season() == "Winter" and 0.4 or 0.8
		end,
		run = function(colony)
			local text = gain(colony, { Silver = rng:NextInteger(6, 12) })
			return "A storm tide washed amber up on your beach. Traders pay well for it (+" .. text .. ").", "good"
		end,
	},
	{
		name = "Newcomers",
		weight = function(colony)
			local free = services.ColonyService:Housing(colony) - population(colony)
			local cap = services.RankService:PopCap(colony) - population(colony)
			return (free >= 2 and cap >= 2) and 1.2 or 0
		end,
		run = function(colony)
			local VillagerService = services.VillagerService
			local a = VillagerService:Add(colony, false)
			local b = VillagerService:Add(colony, false)
			return a.name .. " and " .. b.name .. " left a feuding jarl in the south and ask to live under your roof. You take them in.", "good"
		end,
	},
	{
		name = "Harvest",
		weight = function(colony)
			return (season() == "Autumn" and services.ColonyService:HasBuilding(colony, "Farm")) and 1.5 or 0
		end,
		run = function(colony)
			local text = gain(colony, { Food = 30 + population(colony) * 2 })
			return "A rich harvest! The barley stands tall and heavy this year (+" .. text .. ").", "good"
		end,
	},
	{
		name = "Rats",
		weight = function(colony)
			return ((colony.resources.Food or 0) > 60 and not services.ColonyService:HasBuilding(colony, "Storehouse")) and 0.7 or 0
		end,
		run = function(colony)
			local n = lose(colony, "Food", 0.1)
			return "Rats got into the grain and spoiled " .. n .. " Food. A Storehouse keeps them out.", "bad"
		end,
	},
	{
		name = "StormDamage",
		weight = function(colony)
			return ((workspace:GetAttribute("StormLevel") or 0) > 0.3 and (colony.resources.Wood or 0) > 20) and 2 or 0
		end,
		run = function(colony)
			local n = lose(colony, "Wood", 0.12)
			return "The storm tore at your roofs. Repairs took " .. n .. " Wood.", "bad"
		end,
	},
}

local function pick(colony)
	local total = 0
	local weights = {}
	for i, e in EVENTS do
		local ok, w = pcall(e.weight, colony)
		w = ok and w or 0
		weights[i] = w
		total += w
	end
	if total <= 0 then
		return nil
	end
	local r = rng:NextNumber() * total
	for i, e in EVENTS do
		r -= weights[i]
		if r <= 0 then
			return e
		end
	end
	return nil
end

function EventService:Start()
	local nextAt = {}
	Players.PlayerRemoving:Connect(function(player)
		nextAt[player] = nil
	end)
	while true do
		task.wait(5)
		local now = os.clock()
		for _, colony in services.ColonyService:All() do
			local player = colony.player
			if not nextAt[player] then
				nextAt[player] = now + FIRST
			elseif now >= nextAt[player] then
				nextAt[player] = now + rng:NextNumber(MIN_GAP, MAX_GAP)
				local event = pick(colony)
				if event then
					local ok, text, kind = pcall(event.run, colony)
					if ok and text then
						services.ColonyService:Notify(colony, text, kind)
						services.ColonyService:Sync(colony)
					elseif not ok then
						warn("[EventService] " .. event.name .. ": " .. tostring(text))
					end
				end
			end
		end
	end
end

return EventService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">LandService</string>
            <string name="Source"><![CDATA[--[[
	LandService
	Buying bigger land (Config.LandStages). The next stage costs resources and
	may need a rank. The plot's borders, the build grid and where trees and
	rocks can grow all follow colony.land.
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Grid = require(Shared.Grid)

local LandService = {}

local services

function LandService:Init(all)
	services = all
end

-- Why the next stage can't be bought yet, or nil if it can.
function LandService:Blocker(colony): string?
	local nextStage = Config.LandStages[(colony.land or 1) + 1]
	if not nextStage then
		return "Your land is as big as it can grow."
	end
	if nextStage.Rank and services.RankService:Rank(colony) < nextStage.Rank then
		return "Needs the rank of " .. Config.Ranks[nextStage.Rank].Name .. "."
	end
	if not services.ColonyService:CanAfford(colony, nextStage.Cost) then
		return "Needs " .. Grid.costText(nextStage.Cost) .. "."
	end
	return nil
end

function LandService:Buy(colony): (boolean, string)
	local why = self:Blocker(colony)
	if why then
		return false, why
	end
	local nextIndex = (colony.land or 1) + 1
	local stage = Config.LandStages[nextIndex]
	if not services.ColonyService:Spend(colony, stage.Cost) then
		return false, "You can't afford that."
	end
	colony.land = nextIndex
	services.PlotService:ApplyLand(colony)
	-- a few new trees and rocks grow on the new ground
	for _ = 1, 4 do
		services.ResourceNodeService:Tick(colony, Config.NodeRegrowInterval)
	end
	colony.gridDirty = true
	services.ColonyService:Notify(colony, "Your land grows: " .. stage.Name .. "! New ground marked by the border stakes.", "good")
	services.ColonyService:Sync(colony)
	return true, "Bought " .. stage.Name
end

function LandService:State(colony)
	local i = colony.land or 1
	local nextStage = Config.LandStages[i + 1]
	local minX, _, maxX, maxZ = Grid.bounds(i)
	return {
		index = i,
		name = Config.LandStages[i].Name,
		size = (maxX - minX) .. " x " .. maxZ,
		nextName = nextStage and nextStage.Name,
		nextCost = nextStage and nextStage.Cost,
		nextRank = nextStage and nextStage.Rank and Config.Ranks[nextStage.Rank].Name,
		nextSize = nextStage and ((nextStage.MaxX - nextStage.MinX) .. " x " .. nextStage.MaxZ),
		blocker = self:Blocker(colony),
	}
end

return LandService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">PathWearService</string>
            <string name="Source"><![CDATA[--[[
	PathWearService
	Paths form where people walk. Every couple of seconds each villager and
	each player leaves a little wear on the 4x4-stud patch of ground under
	their feet. Grass on a well-trodden patch turns to bare earth, and a
	really busy one becomes a stone road. Paved paths, fields and water are
	left alone.
]]

local Players = game:GetService("Players")

local PathWearService = {}

local services
local Terrain = workspace.Terrain
local M = Enum.Material

local STEP = 2 -- seconds between footstep passes
local DIRT = 14 -- wear for grass to become bare earth
local GRAVEL = 60 -- wear for earth to become a stone road
local VOXEL = 4

local wear = {} -- ["x,z"] = wear
local lastCell = setmetatable({}, { __mode = "k" }) -- [part] = key (only walking wears a path)
local stage = {} -- ["x,z"] = 1 earth, 2 gravel

function PathWearService:Init(all)
	services = all
end

local function cellOf(pos: Vector3): (number, number)
	return math.floor(pos.X / VOXEL), math.floor(pos.Z / VOXEL)
end

local function repaint(cx: number, cz: number, y: number, from: { Enum.Material }, to: Enum.Material)
	local lo = Vector3.new(cx * VOXEL, math.floor((y - 6) / VOXEL) * VOXEL, cz * VOXEL)
	local region = Region3.new(lo, lo + Vector3.new(VOXEL, 12, VOXEL)):ExpandToGrid(VOXEL)
	for _, m in from do
		Terrain:ReplaceMaterial(region, VOXEL, m, to)
	end
end

local function step(who: BasePart, pos: Vector3, groundY: number, amount: number)
	local cx, cz = cellOf(pos)
	local key = cx .. "," .. cz
	if lastCell[who] == key then
		return -- standing still
	end
	lastCell[who] = key
	local w = (wear[key] or 0) + amount
	wear[key] = w
	local s = stage[key] or 0
	if s < 1 and w >= DIRT then
		stage[key] = 1
		repaint(cx, cz, groundY, { M.Grass, M.LeafyGrass }, M.Ground)
	elseif s < 2 and w >= GRAVEL then
		stage[key] = 2
		repaint(cx, cz, groundY, { M.Ground, M.Grass, M.LeafyGrass }, M.Cobblestone)
	end
end

function PathWearService:Start()
	task.spawn(function()
		while true do
			task.wait(STEP)
			for _, colony in services.ColonyService:All() do
				for _, v in colony.villagers do
					local body = v.body
					if body and body.Parent and not v.away then
						step(body, body.Position, body.Position.Y - (v.height or 2), 1)
					end
				end
			end
			for _, player in Players:GetPlayers() do
				local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
				if root and root:IsA("BasePart") then
					step(root, root.Position, root.Position.Y - 3, 1)
				end
			end
		end
	end)
end

return PathWearService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">PlotService</string>
            <string name="Source"><![CDATA[--[[
	PlotService
	Gives each player their own square of land, builds the ground for it,
	and moves their character there when they spawn.
]]

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Grid = require(Shared.Grid)

local PlotService = {}

local plotsFolder: Folder
local used = {} -- [index] = player
local drawBorders

local function makePart(props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in props do
		p[k] = v
	end
	return p
end

-- Your borders: tall carved posts with a red cloth at the corners, and a
-- line of stakes joined by rope all the way round (across the beach too).
-- Redrawn when the land grows.
drawBorders = function(plot: Model, origin: Vector3, land: number)
	for _, child in plot:GetChildren() do
		if child.Name == "BorderPost" or child.Name == "BorderStake" or child.Name == "BorderRope" or child.Name == "BorderCloth" then
			child:Destroy()
		end
	end
	local corner, size = Grid.landRect(origin, land)
	local first
	for _, x in { 0, size.X } do
		for _, z in { 0, size.Z } do
			local post = makePart({
				Name = "BorderPost",
				Size = Vector3.new(1.1, 7, 1.1),
				Position = corner + Vector3.new(x, 3.5, z),
				Color = Color3.fromRGB(78, 54, 36),
				Material = Enum.Material.Wood,
				Parent = plot,
			})
			makePart({
				Name = "BorderCloth",
				Size = Vector3.new(0.12, 2.2, 1.4),
				Position = post.Position + Vector3.new(0, 2.2, 0.8),
				Color = Color3.fromRGB(150, 36, 32),
				Material = Enum.Material.Fabric,
				CanCollide = false,
				CastShadow = false,
				Parent = plot,
			})
			first = first or post
		end
	end
	-- stakes every 2 cells, a rope from each one to the next
	local step = Config.CELL * 2
	local function stake(p: Vector3)
		makePart({
			Name = "BorderStake",
			Size = Vector3.new(0.45, 2.6, 0.45),
			Position = p + Vector3.new(0, 1.3, 0),
			Color = Color3.fromRGB(96, 70, 46),
			Material = Enum.Material.Wood,
			CanCollide = false,
			Parent = plot,
		})
	end
	local function rope(a: Vector3, b: Vector3)
		local mid = (a + b) / 2 + Vector3.new(0, 2.1, 0)
		makePart({
			Name = "BorderRope",
			Size = Vector3.new(0.14, 0.14, (b - a).Magnitude),
			CFrame = CFrame.lookAt(mid, b + Vector3.new(0, 2.1, 0)),
			Color = Color3.fromRGB(196, 170, 120),
			Material = Enum.Material.Fabric,
			CanCollide = false,
			CastShadow = false,
			Parent = plot,
		})
	end
	local function side(from: Vector3, to: Vector3)
		local len = (to - from).Magnitude
		local dir = (to - from).Unit
		local last = from
		for d = step, len - 1, step do
			local p = from + dir * d
			stake(p)
			rope(last, p)
			last = p
		end
		rope(last, to)
	end
	local c00, c10 = corner, corner + Vector3.new(size.X, 0, 0)
	local c01, c11 = corner + Vector3.new(0, 0, size.Z), corner + Vector3.new(size.X, 0, size.Z)
	side(c00, c10)
	side(c10, c11)
	side(c11, c01)
	side(c01, c00)
	local ground = plot:FindFirstChild("Ground")
	if ground then
		ground.Size = Vector3.new(size.X, 1, size.Z)
		ground.Position = corner + Vector3.new(size.X / 2, -0.5, size.Z / 2)
	end
	local sign = plot:FindFirstChild("OwnerSign")
	if sign and first then
		sign.Adornee = first
	end
end

-- Grows (or restores) the plot's visible borders to the colony's land stage.
function PlotService:ApplyLand(colony)
	if colony.plot then
		drawBorders(colony.plot, colony.origin, colony.land or 1)
	end
end

function PlotService:Init()
	plotsFolder = Instance.new("Folder")
	plotsFolder.Name = "Plots"
	plotsFolder.Parent = workspace
end

function PlotService:Start()
	Players.PlayerRemoving:Connect(function(player)
		self:Release(player)
	end)
end

-- Returns plotIndex, origin, plotModel. Called by ColonyService.
function PlotService:Assign(player: Player)
	local index
	for i = 1, Config.MAX_PLOTS do
		if not used[i] then
			index = i
			break
		end
	end
	if not index then
		warn("[PlotService] no free plots for " .. player.Name)
		return nil
	end
	used[index] = player

	local origin = Grid.plotOrigin(index)
	local size = Grid.PLOT_SIZE

	local plot = Instance.new("Model")
	plot.Name = "Plot_" .. index
	plot:SetAttribute("OwnerUserId", player.UserId)

	makePart({
		-- Invisible: the grass you see is Terrain (WorldService). This part
		-- is what the build preview aims at. Resized when you buy land.
		Name = "Ground",
		Size = Vector3.new(size, 1, size),
		Position = origin + Vector3.new(size / 2, -0.5, size / 2),
		Transparency = 1,
		CanCollide = false,
		Parent = plot,
	})

	local sign = Instance.new("BillboardGui")
	sign.Name = "OwnerSign"
	sign.Size = UDim2.fromOffset(260, 40)
	sign.StudsOffset = Vector3.new(0, 4, 0)
	sign.MaxDistance = 400
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.TextScaled = true
	label.TextColor3 = Color3.fromRGB(255, 240, 210)
	label.TextStrokeTransparency = 0.4
	label.Text = player.DisplayName .. "'s settlement"
	label.Parent = sign
	sign.Parent = plot
	drawBorders(plot, origin, 1)

	for _, name in { "Buildings", "Nodes", "Villagers" } do
		local f = Instance.new("Folder")
		f.Name = name
		f.Parent = plot
	end

	plot.Parent = plotsFolder

	player:SetAttribute("PlotIndex", index)
	player:SetAttribute("PlotOrigin", origin)
	player.CameraMaxZoomDistance = 160

	local function spawnAtPlot(character: Model)
		task.defer(function()
			character:PivotTo(CFrame.new(origin + Vector3.new(size / 2, 4, -Config.CELL)) * CFrame.Angles(0, math.pi, 0))
		end)
	end
	player.CharacterAdded:Connect(spawnAtPlot)
	if player.Character then
		spawnAtPlot(player.Character)
	end

	return index, origin, plot
end

function PlotService:Release(player: Player)
	for i, p in used do
		if p == player then
			used[i] = nil
			local plot = plotsFolder:FindFirstChild("Plot_" .. i)
			if plot then
				plot:Destroy()
			end
		end
	end
end

return PlotService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">QuestService</string>
            <string name="Source"><![CDATA[--[[
	QuestService
	The saga: Config.Quests is a chain of goals that walks a new player
	through the game (chop, farm, hunt, build, research, raid, sail...).
	One goal is active at a time; finishing it pays its reward and opens
	the next. Progress is sent to the HUD with the colony snapshot and
	saved with the village.

	Other services report things the player did with
	QuestService:Count(colony, "chop" | "mine" | "deer" | "plunder" | ...).
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Grid = require(Shared.Grid)

local QuestService = {}

local services

function QuestService:Init(allServices)
	services = allServices
end

function QuestService:Count(colony, stat: string, amount: number?)
	if not colony then
		return
	end
	colony.stats = colony.stats or {}
	colony.stats[stat] = (colony.stats[stat] or 0) + (amount or 1)
	self:Check(colony)
end

local function progress(colony, quest): number
	if quest.Kind == "stat" then
		-- things you did before the goal opened count too
		return colony.stats and colony.stats[quest.Stat] or 0
	elseif quest.Kind == "building" then
		local n = 0
		for _, b in colony.buildings do
			if b.type == quest.Building then
				n += 1
			end
		end
		return n
	elseif quest.Kind == "population" then
		local n = 0
		for _ in colony.villagers do
			n += 1
		end
		return n
	elseif quest.Kind == "tech" then
		local n = 0
		for _ in colony.tech do
			n += 1
		end
		return n
	end
	return 0
end

function QuestService:Check(colony)
	colony.quest = colony.quest or 1
	local quest = Config.Quests[colony.quest]
	if not quest then
		return
	end
	if progress(colony, quest) >= quest.Goal then
		local ColonyService = services.ColonyService
		for res, amount in quest.Reward or {} do
			ColonyService:Add(colony, res, amount)
		end
		ColonyService:Notify(colony, "Saga: \"" .. quest.Title .. "\" done! +" .. Grid.costText(quest.Reward or {}), "quest")
		colony.quest += 1
		self:Check(colony) -- the next one may already be done
	end
end

-- What the HUD shows.
function QuestService:State(colony)
	local index = colony.quest or 1
	local quest = Config.Quests[index]
	if not quest then
		return { done = true, index = index, total = #Config.Quests }
	end
	return {
		index = index,
		total = #Config.Quests,
		title = quest.Title,
		text = quest.Text,
		have = math.min(progress(colony, quest), quest.Goal),
		goal = quest.Goal,
		reward = Grid.costText(quest.Reward or {}),
	}
end

function QuestService:Start()
	-- buildings, population and research are checked once a second
	while true do
		task.wait(1)
		for _, colony in services.ColonyService:All() do
			self:Check(colony)
		end
	end
end

return QuestService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">RaidService</string>
            <string name="Source"><![CDATA[--[[
	RaidService
	Rival NPC villages behind palisades (Config.Rivals): Greywater Hold at
	the west end of the valley (walk past plot 1) and Ravensfell at the far
	east end. You can raid them:

	  - Sound the war horn at the gate (optional) and the guards form a
	    shield wall, then charge.
	  - Fight the guards with the Axe (click) or the Bow.
	  - Hold the Torch and press F at a building to set it alight. Fire
	    chars it black and can spread to neighbours. Buildings are never
	    deleted, only scorched.
	  - Plunder the chests by the storehouses for food, silver and wood.
	  - Once every guard has fallen, the hold's villagers may accept your
	    offer of a new home and join your settlement (needs free housing).

	After a raid the hold rebuilds itself (fires out, walls repaired, chests
	refilled, guards back) after Config.Rival.RegenSeconds.
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Grid = require(Shared.Grid)
local Sounds = require(Shared.Sounds)
local ModelFactory = require(Shared.ModelFactory)

local RaidService = {}

local services
-- Builds one rival hold from its settings (an entry of Config.Rivals).
local function newHold(R)
	local hold = { def = R }
	local rng = Random.new()
	local folder: Folder
	local statusLabel: TextLabel

	local state = {
		raidedAt = nil, -- os.clock() of the first hostile act, nil when peaceful
		alarm = false, -- guards hunt anyone nearby
		buildings = {},
		chests = {},
		defenders = {},
		folk = {},
		horn = nil,
	}

	local CENTER = R.Center
	-- the gate faces this way (0 = east, toward the player plots from the west end)
	local GATE = R.GateAngle or 0
	local gateDir = Vector3.new(math.cos(GATE), 0, math.sin(GATE))
	local gateSide = Vector3.new(-gateDir.Z, 0, gateDir.X)
	local CHAR = Color3.fromRGB(34, 28, 24)
	local WALK_ANIM = "rbxassetid://507777826"
	local IDLE_ANIM = "rbxassetid://507766388"


	local function flat(v: Vector3): Vector3
		return Vector3.new(v.X, 0, v.Z)
	end

	local function notifyAll(text: string, kind: string)
		local ColonyService = services.ColonyService
		for _, colony in ColonyService:All() do
			ColonyService:Notify(colony, text, kind)
		end
	end

	local function markRaid()
		if not state.raidedAt then
			state.raidedAt = os.clock()
		end
	end

	local function gateBroken(): boolean
		return state.gate == nil or state.gate.broken
	end

	local function lockedOut(player: Player): boolean
		if gateBroken() then
			return false
		end
		local colony = services.ColonyService:Get(player)
		if colony then
			services.ColonyService:Notify(colony, "Break the gate of " .. R.Name .. " first!", "bad")
		end
		return true
	end

	local function makePrompt(parent: Instance, action: string, objectText: string, key: Enum.KeyCode, holdTime: number)
		local prompt = Instance.new("ProximityPrompt")
		prompt.ActionText = action
		prompt.ObjectText = objectText
		prompt.KeyboardKeyCode = key
		prompt.HoldDuration = holdTime
		prompt.MaxActivationDistance = 14
		prompt.RequiresLineOfSight = false
		prompt.Parent = parent
		return prompt
	end

	local function anchorPart(cf: CFrame, parent: Instance): BasePart
		local p = Instance.new("Part")
		p.Name = "PromptAnchor"
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.Transparency = 1
		p.Size = Vector3.new(1, 1, 1)
		p.CFrame = cf
		p.Parent = parent
		return p
	end

	-- Fire ------------------------------------------------------------------------

	local function ignite(building)
		if building.burning then
			return
		end
		building.burning = true
		building.firePrompt.Enabled = false
		markRaid()

		local parts = {}
		for _, d in building.model:GetDescendants() do
			if d:IsA("BasePart") and d.Name ~= "PromptAnchor" then
				if d:GetAttribute("PreBurnColor") == nil then
					d:SetAttribute("PreBurnColor", d.Color)
					d:SetAttribute("PreBurnTransparency", d.Transparency)
				end
				table.insert(parts, d)
				TweenService:Create(d, TweenInfo.new(R.BurnSeconds), { Color = CHAR }):Play()
			end
		end
		-- flames on a handful of the bigger parts
		table.sort(parts, function(a, b)
			return a.Size.Magnitude > b.Size.Magnitude
		end)
		local flames = {}
		for i = 1, math.min(6, #parts) do
			local part = parts[i]
			local fire = Instance.new("Fire")
			fire.Name = "BurnFx"
			fire.Size = 9
			fire.Heat = 16
			fire.Color = Color3.fromRGB(255, 130, 40)
			fire.SecondaryColor = Color3.fromRGB(255, 50, 10)
			fire.Parent = part
			local smoke = Instance.new("Smoke")
			smoke.Name = "BurnFx"
			smoke.Color = Color3.fromRGB(40, 36, 34)
			smoke.Opacity = 0.35
			smoke.RiseVelocity = 9
			smoke.Size = 7
			smoke.Parent = part
			local light = Instance.new("PointLight")
			light.Name = "BurnFx"
			light.Color = Color3.fromRGB(255, 120, 40)
			light.Range = 34
			light.Brightness = 3
			light.Parent = part
			table.insert(flames, { fire = fire, light = light })
			if i == 1 then
				local crackle = Sounds.loop("Fire", part)
				if crackle then
					crackle.Name = "BurnFx"
				end
			end
		end

		-- spread to close neighbours, then die down to embers
		task.delay(8, function()
			for _, other in state.buildings do
				if other ~= building and not other.burning and (other.position - building.position).Magnitude < 48 and rng:NextNumber() < 0.45 then
					ignite(other)
				end
			end
		end)
		task.delay(R.BurnSeconds, function()
			if not building.burning then
				return
			end
			for _, f in flames do
				f.fire.Size = 3
				f.light.Brightness = 1
			end
			for _, part in parts do
				if part.Name == "Roof" or part.Name == "Gable" then
					part.Transparency = 0.45 -- burned through
				end
			end
		end)
	end

	local function restoreBuilding(building)
		building.burning = false
		building.firePrompt.Enabled = true
		for _, d in building.model:GetDescendants() do
			if d.Name == "BurnFx" then
				d:Destroy()
			elseif d:IsA("BasePart") and d:GetAttribute("PreBurnColor") then
				d.Color = d:GetAttribute("PreBurnColor")
				d.Transparency = d:GetAttribute("PreBurnTransparency") or 0
			end
		end
	end

	-- Chests ----------------------------------------------------------------------

	local function makeChest(cf: CFrame)
		local model = Instance.new("Model")
		model.Name = "LootChest"
		local add = ModelFactory.addPart
		add(model, { Name = "Box", Size = Vector3.new(4, 2.2, 2.6), CFrame = cf * CFrame.new(0, 1.1, 0), Color = Color3.fromRGB(110, 70, 40), Material = Enum.Material.WoodPlanks })
		local lid = add(model, { Name = "Lid", Size = Vector3.new(4.1, 0.6, 2.7), CFrame = cf * CFrame.new(0, 2.5, 0), Color = Color3.fromRGB(96, 60, 34), Material = Enum.Material.WoodPlanks })
		for _, x in { -1.4, 1.4 } do
			add(model, { Name = "Band", Size = Vector3.new(0.3, 2.9, 2.8), CFrame = cf * CFrame.new(x, 1.4, 0), Color = Color3.fromRGB(70, 70, 76), Material = Enum.Material.Metal })
		end
		local glint = add(model, { Name = "Silver", Size = Vector3.new(3, 0.4, 1.8), CFrame = cf * CFrame.new(0, 2.15, 0), Color = Color3.fromRGB(220, 220, 230), Material = Enum.Material.Foil })
		local light = Instance.new("PointLight")
		light.Color = Color3.fromRGB(255, 230, 160)
		light.Range = 8
		light.Brightness = 0.8
		light.Parent = glint
		model.Parent = folder

		local chest = { model = model, lid = lid, lidClosed = lid.CFrame, hinge = cf * CFrame.new(0, 2.5, 1.3), looted = false }
		chest.prompt = makePrompt(lid, "Plunder", "Chest", Enum.KeyCode.E, 1.5)
		chest.prompt.Triggered:Connect(function(player)
			if chest.looted or lockedOut(player) then
				return
			end
			local ColonyService = services.ColonyService
			local colony = ColonyService:Get(player)
			if not colony then
				return
			end
			chest.looted = true
			chest.prompt.Enabled = false
			services.QuestService:Count(colony, "plunder")
			if services.DiplomacyService then
				services.DiplomacyService:OnHostile(colony, R.Name)
			end
			markRaid()
			-- swing the lid open
			lid.CFrame = chest.hinge * CFrame.Angles(math.rad(-100), 0, 0) * chest.hinge:Inverse() * chest.lidClosed
			local parts = {}
			local mult = 1
			if ColonyService:Has(colony, "SeaRaiders") then
				mult *= 1.5
			end
			if ColonyService:Has(colony, "PathStorm") then
				mult *= 1.5
			end
			for resource, base in R.ChestLoot do
				local amount = math.floor(base * mult)
				ColonyService:Add(colony, resource, amount)
				table.insert(parts, "+" .. amount .. " " .. resource)
			end
			ColonyService:Notify(colony, "Plundered! " .. table.concat(parts, ", "), "gain")
			ColonyService:Sync(colony)
		end)
		table.insert(state.chests, chest)
	end

	local function weld(part: BasePart, to: BasePart)
		local w = Instance.new("WeldConstraint")
		w.Part0 = to
		w.Part1 = part
		w.Parent = part
	end

	local buildGate
	local spawnDefender
	-- Gate ------------------------------------------------------------------------
	-- A pair of heavy doors between two towers in the palisade gap. Raiders must
	-- break it before they can plunder or burn anything inside.

	local function updateGateLabel()
		local g = state.gate
		if not g then
			return
		end
		if g.broken then
			g.label.Text = "The gate is broken!"
			g.label.TextColor3 = Color3.fromRGB(255, 150, 120)
		else
			g.label.Text = string.format("Gate %d / %d", math.ceil(g.hp), g.max)
			g.label.TextColor3 = g.hp < g.max and Color3.fromRGB(255, 205, 140) or Color3.fromRGB(240, 235, 225)
		end
		g.bar.Size = UDim2.fromScale(math.clamp(g.hp / g.max, 0, 1), 1)
	end

	local function setGateOpen(open: boolean)
		local g = state.gate
		for _, leaf in g.leaves do
			leaf.part.CanCollide = not open
			if open then
				TweenService:Create(leaf.part, TweenInfo.new(1.1, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { CFrame = leaf.fallen }):Play()
			else
				leaf.part.CFrame = leaf.closed
			end
		end
		g.bar.Parent.Visible = not open
	end

	buildGate = function(segments: number)
		-- the gap's half-width, from the nearest wall segment on either side
		local step = math.pi * 2 / segments
		local aMin = math.huge
		for i = 0, segments - 1 do
			local a = i * step - GATE
			a = math.abs(math.atan2(math.sin(a), math.cos(a)))
			if a > 0.2 then
				aMin = math.min(aMin, a)
			end
		end
		local half = math.max(8, R.Radius * math.sin(aMin) - Config.CELL / 2 + 1)
		local centre = CENTER + gateDir * (R.Radius * math.cos(aMin * 0.5))
		local frame = CFrame.lookAt(centre, centre + gateDir) -- X along the wall, -Z outward
		local model = Instance.new("Model")
		model.Name = "Gate"
		local add = ModelFactory.addPart
		local WOOD = Color3.fromRGB(96, 66, 42)
		local DARK = Color3.fromRGB(70, 48, 32)
		local IRON = Color3.fromRGB(58, 58, 62)
		local H = 13
		-- the two gate towers, with a fighting platform across the top
		for _, side in { -1, 1 } do
			local x = side * (half + 2)
			add(model, { Name = "GateTower", Size = Vector3.new(5, 19, 5), CFrame = frame * CFrame.new(x, 9.5, 0), Color = DARK, Material = Enum.Material.WoodPlanks })
			add(model, { Name = "GateTowerTop", Size = Vector3.new(6.4, 1, 6.4), CFrame = frame * CFrame.new(x, 19.5, 0), Color = WOOD, Material = Enum.Material.WoodPlanks })
			add(model, { Name = "Roof", Size = Vector3.new(4.6, 4.6, 4.6), CFrame = frame * CFrame.new(x, 21.6, 0) * CFrame.Angles(0, math.rad(45), 0) * CFrame.Angles(math.rad(45), 0, 0), Color = Color3.fromRGB(58, 44, 34), Material = Enum.Material.Wood })
			for _, y in { 4, 11 } do
				add(model, { Name = "Band", Size = Vector3.new(5.2, 0.5, 5.2), CFrame = frame * CFrame.new(x, y, 0), Color = IRON, Material = Enum.Material.Metal })
			end
		end
		add(model, { Name = "GateWalk", Size = Vector3.new(half * 2 + 4, 1.4, 4.6), CFrame = frame * CFrame.new(0, H + 2.6, 0), Color = WOOD, Material = Enum.Material.WoodPlanks })
		for k = -3, 3 do
			add(model, { Name = "Stake", Size = Vector3.new(0.9, 2.6, 0.9), CFrame = frame * CFrame.new(k * half / 3.2, H + 4.4, -2), Color = DARK, Material = Enum.Material.Wood })
		end
		-- the doors: two heavy leaves that fall outward when the gate breaks
		local leaves = {}
		for _, side in { -1, 1 } do
			local x = side * half / 2
			local closed = frame * CFrame.new(x, H / 2, 0)
			local leaf = add(model, { Name = "GateDoor", Size = Vector3.new(half - 0.1, H, 1.6), CFrame = closed, Color = WOOD, Material = Enum.Material.WoodPlanks })
			leaf.CanCollide = true
			for _, y in { -H * 0.3, H * 0.3 } do
				local band = add(model, { Name = "Band", Size = Vector3.new(half - 0.4, 0.6, 1.9), CFrame = closed * CFrame.new(0, y, 0), Color = IRON, Material = Enum.Material.Metal })
				band.Anchored = false
				band.CanCollide = false
				weld(band, leaf)
			end
			local boss = add(model, { Name = "Band", Size = Vector3.new(1.2, 1.2, 2), CFrame = closed * CFrame.new(-side * (half / 2 - 1.2), 0, 0), Color = IRON, Material = Enum.Material.Metal })
			boss.Anchored = false
			boss.CanCollide = false
			weld(boss, leaf)
			-- fallen flat on the ground outside, a little askew
			local fallen = frame * CFrame.new(x, 0.9, -H / 2 - 0.5) * CFrame.Angles(math.rad(-88), math.rad(side * 6), 0)
			table.insert(leaves, { part = leaf, closed = closed, fallen = fallen })
		end
		-- fire baskets either side of the gate, outside
		for _, side in { -1, 1 } do
			ModelFactory.brazier(model, (frame * CFrame.new(side * (half + 6), 0, -5)).Position, 4.4)
		end
		model.Parent = folder

		-- health over the gate
		local anchor = anchorPart(frame * CFrame.new(0, H + 7, 0), model)
		local gui = Instance.new("BillboardGui")
		gui.Size = UDim2.fromOffset(220, 46)
		gui.MaxDistance = 160
		gui.Parent = anchor
		local label = Instance.new("TextLabel")
		label.Size = UDim2.new(1, 0, 0.55, 0)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.GothamBold
		label.TextScaled = true
		label.TextStrokeTransparency = 0.4
		label.Parent = gui
		local back = Instance.new("Frame")
		back.Position = UDim2.fromScale(0.1, 0.66)
		back.Size = UDim2.fromScale(0.8, 0.22)
		back.BackgroundColor3 = Color3.fromRGB(30, 24, 20)
		back.BorderSizePixel = 0
		back.Parent = gui
		local bar = Instance.new("Frame")
		bar.Size = UDim2.fromScale(1, 1)
		bar.BackgroundColor3 = Color3.fromRGB(200, 120, 60)
		bar.BorderSizePixel = 0
		bar.Parent = back

		state.gate = {
			hold = hold,
			model = model,
			leaves = leaves,
			position = centre,
			out = gateDir,
			side = gateSide,
			half = half,
			hp = Config.Siege.GateHealth,
			max = Config.Siege.GateHealth,
			broken = false,
			label = label,
			bar = bar,
		}
		updateGateLabel()
	end

	-- A blow on the gate. Returns true when it landed.
	function hold:DamageGate(amount: number, attacker: Player?): boolean
		local g = state.gate
		if not g or g.broken then
			return false
		end
		markRaid()
		local colony = attacker and services.ColonyService:Get(attacker)
		if colony and services.DiplomacyService then
			services.DiplomacyService:OnHostile(colony, R.Name)
		end
		if not state.alarm then
			state.alarm = true
			notifyAll((attacker and attacker.DisplayName or "Raiders") .. " is storming the gate of " .. R.Name .. "!", "raid")
		end
		g.hp -= amount
		Sounds.play("Chop", g.position + Vector3.new(0, 4, 0))
		-- the doors shudder
		for _, leaf in g.leaves do
			leaf.part.CFrame = leaf.closed * CFrame.new(0, 0, -0.25)
			task.delay(0.08, function()
				if not g.broken then
					leaf.part.CFrame = leaf.closed
				end
			end)
		end
		if g.hp <= 0 then
			g.hp = 0
			g.broken = true
			setGateOpen(true)
			Sounds.play("Build", g.position)
			Sounds.play("WarHorn", g.position)
			notifyAll("The gate of " .. R.Name .. " is broken! Its champion steps out to meet you!", "raid")
			spawnDefender(g.position - g.out * 12, false, true)
			if colony then
				services.QuestService:Count(colony, "gate")
			end
		end
		updateGateLabel()
		return true
	end

	-- The standing gate if `position` is within `range` of it.
	function hold:GateNear(position: Vector3, range: number)
		local g = state.gate
		if not g or g.broken then
			return nil
		end
		local rel = position - g.position
		local along = math.abs(rel:Dot(g.side))
		local depth = math.abs(rel:Dot(g.out))
		if along <= g.half + range * 0.5 and depth <= range then
			return g
		end
		return nil
	end

	local function restoreGate()
		local g = state.gate
		if g then
			g.hp = g.max
			g.broken = false
			setGateOpen(false)
			updateGateLabel()
		end
	end

	-- Guards ----------------------------------------------------------------------


	local function gear(parent: Model, attachTo: BasePart, name: string, size: Vector3, offset: CFrame, color: Color3, material, shape)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.Color = color
		p.Material = material or Enum.Material.Metal
		if shape then
			p.Shape = shape
		end
		p.CanCollide = false
		p.Massless = true
		p.CFrame = attachTo.CFrame * offset
		p.Parent = parent
		weld(p, attachTo)
		return p
	end

	local shieldColors = { Color3.fromRGB(46, 70, 120), Color3.fromRGB(220, 214, 200), Color3.fromRGB(40, 90, 80) }

	local archerShoot -- defined below (archers use it from the guard loop)

	spawnDefender = function(post: Vector3, archer: boolean?, champion: boolean?)
		local desc = Instance.new("HumanoidDescription")
		local skin = Color3.fromRGB(226, 186, 150)
		desc.HeadColor = skin
		desc.LeftArmColor = skin
		desc.RightArmColor = skin
		desc.TorsoColor = Color3.fromRGB(58, 66, 84)
		desc.LeftLegColor = Color3.fromRGB(60, 52, 44)
		desc.RightLegColor = Color3.fromRGB(60, 52, 44)
		local ok, model = pcall(function()
			return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
		end)
		if not ok or not model then
			warn("[RaidService] could not create guard: " .. tostring(model))
			return
		end
		local folk = string.match(R.Name, "^(%S+)") or R.Name
		local title = champion and (folk .. " Champion") or (archer and (folk .. " Archer") or (folk .. " Guard"))
		model.Name = title
		model:SetAttribute("Defender", true)
		local humanoid = model:FindFirstChildOfClass("Humanoid")
		humanoid.DisplayName = title
		local health = R.DefenderHealth * (champion and 5 or 1)
		humanoid.MaxHealth = health
		humanoid.Health = health
		humanoid.WalkSpeed = 13
		humanoid.NameDisplayDistance = 60
		humanoid.HealthDisplayDistance = 60

		local head = model:FindFirstChild("Head")
		local leftHand = model:FindFirstChild("LeftHand")
		local rightHand = model:FindFirstChild("RightHand")
		if head then
			gear(model, head, "Helmet", Vector3.new(1.35, 0.7, 1.35), CFrame.new(0, 0.45, 0), Color3.fromRGB(90, 92, 98), Enum.Material.Metal, Enum.PartType.Ball)
			gear(model, head, "NoseGuard", Vector3.new(0.15, 0.6, 0.15), CFrame.new(0, 0.1, -0.62), Color3.fromRGB(90, 92, 98))
		end
		if archer and leftHand then
			gear(model, leftHand, "BowLimb", Vector3.new(0.2, 4.2, 0.2), CFrame.new(0, 0, -0.3), Color3.fromRGB(80, 56, 36), Enum.Material.Wood)
		elseif leftHand then
			gear(model, leftHand, "Shield", Vector3.new(0.3, 3.4, 3.4), CFrame.new(-0.3, 0, 0), shieldColors[rng:NextInteger(1, #shieldColors)], Enum.Material.Wood, Enum.PartType.Cylinder)
		end
		if rightHand and not archer then
			gear(model, rightHand, "Haft", Vector3.new(0.25, 3.2, 0.25), CFrame.new(0, -0.6, -0.4) * CFrame.Angles(math.rad(90), 0, 0), Color3.fromRGB(110, 76, 46), Enum.Material.Wood)
			gear(model, rightHand, "AxeHead", Vector3.new(0.2, 1, 1.1), CFrame.new(0, 0.1, -1.9), Color3.fromRGB(120, 122, 130))
		end

		if champion then
			-- a head taller, in a gilded helm and a bear-fur cloak
			model:SetAttribute("Champion", true)
			pcall(function()
				model:ScaleTo(1.35)
			end)
			local helm = model:FindFirstChild("Helmet", true)
			if helm and helm:IsA("BasePart") then
				helm.Color = Color3.fromRGB(196, 160, 72)
			end
			local torso = model:FindFirstChild("UpperTorso")
			if torso then
				gear(model, torso, "Cloak", Vector3.new(2.4, 2.6, 0.3), CFrame.new(0, -0.3, 0.75), Color3.fromRGB(70, 52, 38), Enum.Material.Fabric)
			end
			humanoid.WalkSpeed = 11
		end
		model:PivotTo(CFrame.new(post + Vector3.new(0, 3, 0)) * CFrame.Angles(0, math.pi / 2, 0))
		model.Parent = folder.Guards
		local root = model:FindFirstChild("HumanoidRootPart")
		if root then
			pcall(function()
				root:SetNetworkOwner(nil)
			end)
		end

		-- walk / idle animations (Roblox's standard R15 ones)
		local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator", humanoid)
		local tracks = {}
		pcall(function()
			local walk = Instance.new("Animation")
			walk.AnimationId = WALK_ANIM
			tracks.walk = animator:LoadAnimation(walk)
			local idle = Instance.new("Animation")
			idle.AnimationId = IDLE_ANIM
			tracks.idle = animator:LoadAnimation(idle)
			tracks.idle:Play()
		end)
		humanoid.Running:Connect(function(speed)
			if not tracks.walk then
				return
			end
			if speed > 0.5 and not tracks.walk.IsPlaying then
				tracks.walk:Play()
			elseif speed <= 0.5 and tracks.walk.IsPlaying then
				tracks.walk:Stop()
			end
		end)

		local guard = { model = model, humanoid = humanoid, root = root, post = post, home = post, lastHit = 0, rightHand = rightHand, archer = archer, champion = champion }
		humanoid.Died:Connect(function()
			guard.dead = true
			markRaid()
			if champion then
				-- whoever struck last takes the champion's arm rings
				local killer = Players:GetPlayerByUserId(model:GetAttribute("LastHitBy") or 0)
				local colony = killer and services.ColonyService:Get(killer)
				if colony then
					for res, n in Config.Siege.ChampionLoot do
						services.ColonyService:Add(colony, res, n)
					end
					services.QuestService:Count(colony, "champion")
					services.ColonyService:Notify(colony, "You struck down the champion of " .. R.Name .. "! +" .. Grid.costText(Config.Siege.ChampionLoot), "gain")
					services.ColonyService:Sync(colony)
				end
				notifyAll("The champion of " .. R.Name .. " has fallen!", "raid")
			end
			task.delay(6, function()
				model:Destroy()
			end)
			local alive = 0
			for _, g in state.defenders do
				if not g.dead then
					alive += 1
				end
			end
			if alive == 0 then
				notifyAll(R.Name .. " has fallen! Its people may accept a new home with you.", "raid")
				for _, f in state.folk do
					f.prompt.Enabled = true
				end
			end
		end)
		table.insert(state.defenders, guard)
	end

	-- Called by ToolService when an axe blow or arrow lands on a guard.
	function hold:DamageDefender(model: Model, amount: number, attacker: Player)
		local humanoid = model:FindFirstChildOfClass("Humanoid")
		if not humanoid or humanoid.Health <= 0 then
			return
		end
		humanoid:TakeDamage(amount)
		if attacker then
			model:SetAttribute("LastHitBy", attacker.UserId)
		end
		local colony = attacker and services.ColonyService:Get(attacker)
		if colony and services.DiplomacyService then
			services.DiplomacyService:OnHostile(colony, R.Name)
		end
		if not state.alarm then
			state.alarm = true
			notifyAll(attacker.DisplayName .. " is raiding " .. R.Name .. "!", "raid")
		end
		markRaid()
	end

	function hold:FindDefender(inst: Instance?): Model?
		while inst and inst ~= workspace do
			if inst:IsA("Model") and inst:GetAttribute("Defender") then
				return inst
			end
			inst = inst.Parent
		end
		return nil
	end

	-- Guards within reach of `player`, in front of them. Used for axe blows.
	function hold:DefendersNear(position: Vector3, look: Vector3, range: number)
		local found = {}
		for _, g in state.defenders do
			if not g.dead and g.root then
				local offset = flat(g.root.Position - position)
				if offset.Magnitude <= range and (offset.Magnitude < 2 or offset.Unit:Dot(flat(look).Unit) > 0.2) then
					table.insert(found, g.model)
				end
			end
		end
		return found
	end

	-- The closest living guard to `position` (for the war band).
	function hold:NearestDefender(position: Vector3, range: number): (Model?, BasePart?)
		local best, bestRoot, bestD = nil, nil, range
		for _, g in state.defenders do
			if not g.dead and g.root and g.root.Parent then
				local d = (g.root.Position - position).Magnitude
				if d < bestD then
					best, bestRoot, bestD = g.model, g.root, d
				end
			end
		end
		return best, bestRoot
	end

	local function nearestTarget(from: Vector3, maxDist: number): (Model?, number)
		local best, bestDist = nil, maxDist
		for _, player in Players:GetPlayers() do
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")
			local hum = character and character:FindFirstChildOfClass("Humanoid")
			-- allies of this hold are left alone (DiplomacyService)
			local allied = services.DiplomacyService and services.DiplomacyService:IsAlliedPlayer(player, R.Name)
			if root and hum and hum.Health > 0 and not allied then
				local inTerritory = flat(root.Position - CENTER).Magnitude < R.DefenderAggro
				local d = (root.Position - from).Magnitude
				if (inTerritory or state.alarm) and d < bestDist then
					best, bestDist = character, d
				end
			end
		end
		return best, bestDist
	end

	local function swingAxe(guard)
		local hand = guard.rightHand
		if not hand then
			return
		end
		-- a quick lean forward with the axe arm
		local shoulder = guard.model:FindFirstChild("RightUpperArm")
		local motor = shoulder and shoulder:FindFirstChild("RightShoulder")
		if motor and motor:IsA("Motor6D") then
			task.spawn(function()
				motor.Transform = CFrame.Angles(math.rad(-110), 0, 0)
				task.wait(0.2)
				motor.Transform = CFrame.new()
			end)
		end
	end

	-- Archers hold their tower and loose arrows at raiders in range.
	archerShoot = function(g, now: number)
		if now - g.lastHit < R.ArcherCooldown then
			return
		end
		local target = nearestTarget(g.root.Position, R.ArcherRange)
		local troot = target and target:FindFirstChild("HumanoidRootPart")
		if not troot then
			return
		end
		g.lastHit = now
		local from = g.root.Position + Vector3.new(0, 1.5, 0)
		g.root.CFrame = CFrame.lookAt(g.root.Position, Vector3.new(troot.Position.X, g.root.Position.Y, troot.Position.Z))
		local hit = rng:NextNumber() < 0.6
		local to = hit and troot.Position or (troot.Position + Vector3.new(rng:NextNumber(-6, 6), -2, rng:NextNumber(-6, 6)))
		local arrow = ModelFactory.arrow()
		arrow.CFrame = CFrame.lookAt(from, to)
		arrow.Parent = workspace
		Sounds.play("Bow", from)
		local flight = (to - from).Magnitude / 140
		TweenService:Create(arrow, TweenInfo.new(flight, Enum.EasingStyle.Linear), { CFrame = CFrame.lookAt(to, to + (to - from).Unit) }):Play()
		task.delay(flight + 2, function()
			arrow:Destroy()
		end)
		if hit then
			task.delay(flight, function()
				local hum = target:FindFirstChildOfClass("Humanoid")
				if hum then
					local victim = Players:GetPlayerFromCharacter(target)
					local colony = victim and services.ColonyService:Get(victim)
					hum:TakeDamage(R.ArcherDamage * (services.ColonyService:Has(colony, "PathStorm") and 0.7 or 1))
				end
			end)
		end
	end

	local function guardLoop()
		while true do
			task.wait(0.25)
			local now = os.clock()
			for _, g in state.defenders do
				if g.archer and not g.dead and g.root then
					archerShoot(g, now)
				elseif not g.dead and g.root then
					local target, dist = nearestTarget(g.root.Position, state.alarm and R.DefenderAggro * 1.6 or R.DefenderAggro)
					if target then
						local troot = target:FindFirstChild("HumanoidRootPart")
						g.humanoid:MoveTo(troot.Position)
						if dist < 6 and now - g.lastHit > 1.1 then
							g.lastHit = now
							swingAxe(g)
							local hum = target:FindFirstChildOfClass("Humanoid")
							if hum then
								local victim = Players:GetPlayerFromCharacter(target)
								local colony = victim and services.ColonyService:Get(victim)
								local damage = R.DefenderDamage * (g.champion and 2 or 1)
								if services.ColonyService:Has(colony, "PathStorm") then
									damage *= 0.7
								end
								hum:TakeDamage(damage)
							end
						end
					elseif flat(g.root.Position - g.post).Magnitude > 3 then
						g.humanoid:MoveTo(g.post)
					end
				end
			end
		end
	end

	-- Folk (the hold's villagers) ---------------------------------------------------

	local function spawnFolk()
		local model = ModelFactory.villager(Config.Names[rng:NextInteger(1, #Config.Names)], false, rng, nil, rng:NextInteger(1, 2))
		local offset = model:GetAttribute("GroundOffset")
		local pos = CENTER + Vector3.new(rng:NextNumber(-25, 25), 0, rng:NextNumber(-25, 25))
		model:PivotTo(CFrame.new(pos + Vector3.new(0, offset, 0)))
		model.Parent = folder.Folk
		local folk = { model = model, offset = offset, busyUntil = 0 }
		folk.prompt = makePrompt(model.PrimaryPart, "Offer a new home", model.Name .. " of " .. R.Name, Enum.KeyCode.E, 1)
		folk.prompt.Enabled = false
		folk.prompt.Triggered:Connect(function(player)
			local ColonyService = services.ColonyService
			local colony = ColonyService:Get(player)
			if not colony or not model.Parent then
				return
			end
			local pop = 0
			for _ in colony.villagers do
				pop += 1
			end
			if ColonyService:Housing(colony) - pop <= 0 then
				ColonyService:Notify(colony, "You need a free home first. Build a longhouse or cottage.", "bad")
				return
			end
			local name = model.Name
			model:Destroy()
			table.remove(state.folk, table.find(state.folk, folk))
			local v = services.VillagerService:Add(colony, false, colony.origin + Vector3.new(80, 0, -6))
			v.name = name
			local tag = v.model:FindFirstChild("NameTag", true)
			if tag and tag:FindFirstChild("Label") then
				tag.Label.Text = name
			end
			ColonyService:Notify(colony, name .. " of " .. R.Name .. " accepted a new home in your settlement.", "good")
			ColonyService:Sync(colony)
		end)
		table.insert(state.folk, folk)
	end

	local function folkLoop()
		while true do
			task.wait(1)
			local now = os.clock()
			for _, f in state.folk do
				local body = f.model.PrimaryPart
				if body and now >= f.busyUntil then
					local fearful = state.alarm
					local target = CENTER + Vector3.new(rng:NextNumber(-30, 30), 0, rng:NextNumber(10, 45) * (fearful and 1 or (rng:NextNumber() < 0.5 and -1 or 1)))
					local from = body.Position
					local to = Vector3.new(target.X, CENTER.Y + f.offset, target.Z)
					local flatDir = flat(to - from)
					if flatDir.Magnitude > 1 then
						local t = flatDir.Magnitude / (fearful and 12 or 5)
						body.CFrame = CFrame.lookAt(from, from + flatDir)
						TweenService:Create(body, TweenInfo.new(t, Enum.EasingStyle.Linear), { CFrame = CFrame.lookAt(to, to + flatDir) }):Play()
						f.busyUntil = now + t + rng:NextNumber(2, 6)
					end
				end
			end
		end
	end

	-- Building the hold -------------------------------------------------------------

	local LAYOUT = R.Layout or {
		{ "Longhouse", Vector3.new(0, 0, 52) },
		{ "Cottage", Vector3.new(-55, 0, -30) },
		{ "Cottage", Vector3.new(55, 0, -32) },
		{ "Cottage", Vector3.new(-62, 0, 35) },
		{ "Cottage", Vector3.new(60, 0, 40) },
		{ "Storehouse", Vector3.new(-30, 0, -58) },
		{ "Storehouse", Vector3.new(30, 0, -58) },
	}

	local function buildHold()
		folder = Instance.new("Folder")
		folder.Name = "RivalVillage_" .. R.Name:gsub("%s", "")
		for _, name in { "Guards", "Folk" } do
			local f = Instance.new("Folder")
			f.Name = name
			f.Parent = folder
		end
		folder.Parent = workspace

		for _, entry in LAYOUT do
			local kind, offset = entry[1], entry[2]
			local pos = CENTER + offset
			local cf = CFrame.lookAt(pos, Vector3.new(CENTER.X, pos.Y, CENTER.Z))
			local model = ModelFactory.building(kind)
			model:PivotTo(cf)
			model:SetAttribute("RivalBuilding", true)
			model.Parent = folder
			local building = { model = model, position = pos, kind = kind, burning = false }
			local anchor = anchorPart(cf * CFrame.new(0, 4, 0), model)
			building.firePrompt = makePrompt(anchor, "Set alight", kind, Enum.KeyCode.F, 1)
			building.firePrompt.MaxActivationDistance = 18
			building.firePrompt.Triggered:Connect(function(player)
				if lockedOut(player) then
					return
				end
				if not services.ToolService:IsHolding(player, "Torch") then
					local colony = services.ColonyService:Get(player)
					if colony then
						services.ColonyService:Notify(colony, "Hold your Torch first (press 4)", "bad")
					end
					return
				end
				if not state.alarm then
					state.alarm = true
					notifyAll(player.DisplayName .. " is raiding " .. R.Name .. "!", "raid")
				end
				ignite(building)
			end)
			table.insert(state.buildings, building)
			if kind == "Storehouse" then
				makeChest(cf * CFrame.new(0, 0, -15))
			end
		end

		-- the village square
		local square = Instance.new("Model")
		square.Name = "Square"
		ModelFactory.campfire(square, CENTER)
		square.Parent = folder

		-- palisade ring with a gate facing east, toward the player settlements
		local segments = math.floor(2 * math.pi * R.Radius / Config.CELL)
		for i = 0, segments - 1 do
			local a = i / segments * math.pi * 2
			local fromGate = a - GATE
			if math.abs(math.atan2(math.sin(fromGate), math.cos(fromGate))) > 0.2 then
				local pos = CENTER + Vector3.new(math.cos(a) * R.Radius, 0, math.sin(a) * R.Radius)
				local wall = ModelFactory.building("Palisade")
				wall:PivotTo(CFrame.lookAt(pos, Vector3.new(CENTER.X, pos.Y, CENTER.Z)))
				wall.Parent = folder
			end
		end
		buildGate(segments)

		-- the war horn on a post just outside the gate
		local gate = CENTER + gateDir * (R.Radius + 10) + gateSide * 14
		local hornModel = Instance.new("Model")
		hornModel.Name = "WarHorn"
		local add = ModelFactory.addPart
		add(hornModel, { Size = Vector3.new(0.8, 7, 0.8), Position = gate + Vector3.new(0, 3.5, 0), Color = Color3.fromRGB(74, 52, 36) })
		for k = 0, 4 do
			add(hornModel, {
				Name = "Horn",
				Size = Vector3.new(0.5 + k * 0.18, 0.5 + k * 0.18, 0.9),
				CFrame = CFrame.new(gate + Vector3.new(0, 6.2 + math.sin(k * 0.5) * 0.6, -0.6 - k * 0.7)) * CFrame.Angles(k * 0.25, 0, 0),
				Color = Color3.fromRGB(230, 214, 180),
				Material = Enum.Material.SmoothPlastic,
			})
		end
		hornModel.Parent = folder
		state.hornPrompt = makePrompt(hornModel:FindFirstChild("Horn"), "Sound the war horn", R.Name, Enum.KeyCode.E, 1.5)
		state.hornPrompt.Triggered:Connect(function(player)
			state.hornPrompt.Enabled = false
			Sounds.play("WarHorn", CENTER)
			markRaid()
			notifyAll("The war horn sounds! " .. R.Name .. " forms a shield wall!", "raid")
			-- guards line up shoulder to shoulder at the gate, then charge
			local n = #state.defenders
			for i, g in state.defenders do
				g.post = CENTER + gateDir * (R.Radius - 14) + gateSide * ((i - (n + 1) / 2) * 3.6)
			end
			task.delay(7, function()
				state.alarm = true
			end)
		end)

		-- a status sign above the hold
		local signPart = anchorPart(CFrame.new(CENTER + Vector3.new(0, 30, 0)), folder)
		local sign = Instance.new("BillboardGui")
		sign.Size = UDim2.fromOffset(320, 60)
		sign.MaxDistance = 600
		sign.AlwaysOnTop = true
		sign.Parent = signPart
		local title = Instance.new("TextLabel")
		title.Size = UDim2.new(1, 0, 0.55, 0)
		title.BackgroundTransparency = 1
		title.Font = Enum.Font.Garamond
		title.TextScaled = true
		title.TextColor3 = Color3.fromRGB(232, 206, 150)
		title.TextStrokeTransparency = 0.3
		title.Text = R.Name
		title.Parent = sign
		statusLabel = Instance.new("TextLabel")
		statusLabel.Position = UDim2.fromScale(0, 0.58)
		statusLabel.Size = UDim2.new(1, 0, 0.42, 0)
		statusLabel.BackgroundTransparency = 1
		statusLabel.Font = Enum.Font.GothamMedium
		statusLabel.TextScaled = true
		statusLabel.TextColor3 = Color3.fromRGB(240, 235, 225)
		statusLabel.TextStrokeTransparency = 0.4
		statusLabel.Parent = sign
	end

	local function populate()
		for i = 1, R.Defenders do
			local a = (i / R.Defenders) * math.pi * 2
			spawnDefender(CENTER + Vector3.new(math.cos(a) * 28, 0, math.sin(a) * 28))
		end
		-- archers on wooden towers just inside the palisade
		for i = 1, R.Archers do
			local a = (i / R.Archers) * math.pi * 2 + math.pi / R.Archers
			local p = CENTER + Vector3.new(math.cos(a) * (R.Radius - 14), 0, math.sin(a) * (R.Radius - 14))
			if not folder:FindFirstChild("Tower" .. i) then
				local tower = Instance.new("Model")
				tower.Name = "Tower" .. i
				for _, c in { { -2, -2 }, { 2, -2 }, { -2, 2 }, { 2, 2 } } do
					ModelFactory.addPart(tower, { Name = "Leg", Size = Vector3.new(0.8, 9, 0.8), Position = p + Vector3.new(c[1], 4.5, c[2]), Color = Color3.fromRGB(96, 70, 48) })
				end
				ModelFactory.addPart(tower, { Name = "Deck", Size = Vector3.new(6, 0.8, 6), Position = p + Vector3.new(0, 9, 0), Color = Color3.fromRGB(110, 80, 54), Material = Enum.Material.WoodPlanks })
				tower.Parent = folder
			end
			spawnDefender(p + Vector3.new(0, 9.4, 0), true)
		end
		for _ = 1, R.Villagers do
			spawnFolk()
		end
	end

	local function rebuild()
		for _, b in state.buildings do
			restoreBuilding(b)
		end
		for _, c in state.chests do
			c.looted = false
			c.prompt.Enabled = true
			c.lid.CFrame = c.lidClosed
		end
		for _, g in state.defenders do
			if not g.dead then
				g.model:Destroy()
			end
		end
		state.defenders = {}
		for _, f in state.folk do
			f.model:Destroy()
		end
		state.folk = {}
		populate()
		state.alarm = false
		state.raidedAt = nil
		state.hornPrompt.Enabled = true
		restoreGate()
		notifyAll(R.Name .. " has rebuilt its walls and restocked its stores.", "info")
	end

	function hold:Start()
		buildHold()
		hold.folder = folder
		populate()
		task.spawn(guardLoop)
		task.spawn(folkLoop)

		while true do
			task.wait(1)
			if state.raidedAt then
				local left = R.RegenSeconds - (os.clock() - state.raidedAt)
				if left <= 0 then
					rebuild()
				else
					local secs = math.floor(left)
					statusLabel.Text = string.format("Raided! Rebuilds in %d:%02d", secs // 60, secs % 60)
					statusLabel.TextColor3 = Color3.fromRGB(255, 150, 120)
				end
			end
			if not state.raidedAt then
				statusLabel.Text = "Guarded. Raid it for food and silver"
				statusLabel.TextColor3 = Color3.fromRGB(240, 235, 225)
			end
		end
	end

	return hold
end

function RaidService:Init(allServices)
	services = allServices
end

local holds = {}

local function holdOf(model: Instance)
	for _, h in holds do
		if h.folder and model:IsDescendantOf(h.folder) then
			return h
		end
	end
	return nil
end

-- Called by ToolService when an axe blow or arrow lands on a guard.
function RaidService:DamageDefender(model: Model, amount: number, attacker: Player)
	local h = holdOf(model)
	if h then
		h:DamageDefender(model, amount, attacker)
	end
end

function RaidService:FindDefender(inst: Instance?): Model?
	while inst and inst ~= workspace do
		if inst:IsA("Model") and inst:GetAttribute("Defender") then
			return inst
		end
		inst = inst.Parent
	end
	return nil
end

-- Guards within reach, in front of `look`, from every hold. Used for melee blows.
function RaidService:DefendersNear(position: Vector3, look: Vector3, range: number)
	local found = {}
	for _, h in holds do
		for _, m in h:DefendersNear(position, look, range) do
			table.insert(found, m)
		end
	end
	return found
end

-- The closest living guard of any hold (for the war band), and its damage.
function RaidService:NearestDefender(position: Vector3, range: number): (Model?, BasePart?, number?)
	local best, bestRoot, bestDmg, bestD = nil, nil, nil, range
	for _, h in holds do
		local m, root = h:NearestDefender(position, bestD)
		if m and root then
			best, bestRoot, bestDmg, bestD = m, root, h.def.DefenderDamage, (root.Position - position).Magnitude
		end
	end
	return best, bestRoot, bestDmg
end

-- The standing gate of any hold near `position` (for the war band), or nil.
function RaidService:GateNear(position: Vector3, range: number)
	for _, h in holds do
		local g = h:GateNear(position, range)
		if g then
			return g
		end
	end
	return nil
end

function RaidService:DamageGate(gate, amount: number, attacker: Player?): boolean
	return gate and gate.hold and gate.hold:DamageGate(amount, attacker) or false
end

-- A player's melee blow: lands on a gate in front of them within `range`.
function RaidService:StrikeGate(position: Vector3, look: Vector3, range: number, amount: number, attacker: Player): boolean
	local g = self:GateNear(position, range)
	if not g then
		return false
	end
	-- facing the doors (from either side)
	local toward = (g.position - position) * Vector3.new(1, 0, 1)
	local facing = toward:Dot(g.out) * look:Dot(g.out) > 0 or math.abs((position - g.position):Dot(g.out)) < 2
	if not facing then
		return false
	end
	return g.hold:DamageGate(amount, attacker)
end

function RaidService:Start()
	for _, def in Config.Rivals do
		local h = newHold(def)
		table.insert(holds, h)
		task.spawn(function()
			h:Start()
		end)
	end
end

return RaidService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">RankService</string>
            <string name="Source"><![CDATA[--[[
	RankService
	Your title: Settler -> Chieftain -> Hersir -> Jarl -> King (Config.Ranks).
	You rise as soon as your village meets the next rank's needs (people,
	buildings, research). Each rank raises the population cap and unlocks
	bigger buildings (Config.Buildings[...].Rank).
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Grid = require(Shared.Grid)

local RankService = {}

local services

function RankService:Init(allServices)
	services = allServices
end

local function counts(colony)
	local pop, buildings, tech = 0, 0, 0
	for _ in colony.villagers do
		pop += 1
	end
	for _, b in colony.buildings do
		if not Config.Buildings[b.type].Wall and not Config.Buildings[b.type].Decor then
			buildings += 1
		end
	end
	for _ in colony.tech do
		tech += 1
	end
	return { Population = pop, Buildings = buildings, Tech = tech }
end

function RankService:Rank(colony): number
	return colony.rank or 1
end

function RankService:PopCap(colony): number
	return Config.Ranks[self:Rank(colony)].PopCap
end

-- What the HUD shows about your rank and the next one.
function RankService:State(colony)
	local r = self:Rank(colony)
	local nextRank = Config.Ranks[r + 1]
	local state = { index = r, name = Config.Ranks[r].Name, cap = Config.Ranks[r].PopCap }
	if nextRank then
		local have = counts(colony)
		local bits = {}
		for _, key in { "Population", "Buildings", "Tech" } do
			local need = nextRank.Needs[key]
			if need then
				local word = ({ Population = "people", Buildings = "buildings", Tech = "research" })[key]
				table.insert(bits, math.min(have[key], need) .. "/" .. need .. " " .. word)
			end
		end
		state.nextName = nextRank.Name
		state.nextText = table.concat(bits, ", ")
	end
	return state
end

function RankService:Check(colony)
	local r = self:Rank(colony)
	local nextRank = Config.Ranks[r + 1]
	if not nextRank then
		return
	end
	local have = counts(colony)
	for key, need in nextRank.Needs do
		if (have[key] or 0) < need then
			return
		end
	end
	colony.rank = r + 1
	for res, n in nextRank.Reward or {} do
		services.ColonyService:Add(colony, res, n)
	end
	local unlocked = {}
	for _, id in Config.BuildOrder do
		if Config.Buildings[id].Rank == colony.rank then
			table.insert(unlocked, Config.Buildings[id].Display)
		end
	end
	local extra = #unlocked > 0 and (" Unlocked: " .. table.concat(unlocked, ", ") .. ".") or ""
	services.ColonyService:Notify(colony, "You are now " .. nextRank.Name .. "!", "raid")
	-- everyone dresses up for the new rank
	for _, v in colony.villagers do
		if v.model and not v.away then
			services.VillagerService:Rebuild(colony, v)
		end
	end
	services.ColonyService:Notify(colony, "Your people put on finer gear to honour their " .. nextRank.Name .. ".", "good")
	services.ColonyService:Notify(colony, "Room for " .. nextRank.PopCap .. " people. +" .. Grid.costText(nextRank.Reward or {}) .. "." .. extra, "good")
	self:Check(colony)
end

function RankService:Start()
	while true do
		task.wait(2)
		for _, colony in services.ColonyService:All() do
			self:Check(colony)
		end
	end
end

return RankService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">ResourceNodeService</string>
            <string name="Source"><![CDATA[--[[
	ResourceNodeService
	Scatters trees, rocks and berry bushes on each plot. Walk up to a tree
	with the Axe (or a rock with the Pickaxe) and click to swing: chips fly,
	it shakes, a bar shows how many blows are left, then the tree topples or
	the rock breaks apart. Better tools (Iron Blades, Steel Edges, Masonry)
	need fewer blows. Berries are picked by hand: hold E. Gathering also
	clears land for building. Nodes slowly regrow.
]]

local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Sounds = require(Shared.Sounds)
local Grid = require(Shared.Grid)
local ModelFactory = require(Shared.ModelFactory)

local ResourceNodeService = {}

local services
local rng = Random.new()

function ResourceNodeService:Init(allServices)
	services = allServices
end

local function randomFreeCell(colony)
	local minX, minZ, maxX, maxZ = Grid.bounds(colony.land)
	for _ = 1, 60 do
		local x = rng:NextInteger(minX, maxX - 1)
		local z = rng:NextInteger(math.max(minZ, 0), maxZ - 1) -- trees and rocks stay off the beach
		if not colony.blocked[Grid.key(x, z)] then
			return x, z
		end
	end
	return nil
end

local function countKind(colony, kind: string): number
	local n = 0
	for _, node in colony.nodes do
		if node.kind == kind then
			n += 1
		end
	end
	return n
end

function ResourceNodeService:Spawn(colony, kind: string, x: number, z: number)
	local ColonyService = services.ColonyService
	local def = Config.Nodes[kind]
	local key = Grid.key(x, z)

	local model, main = ModelFactory.node(kind, rng)
	local jitter = Vector3.new(rng:NextNumber(-1.5, 1.5), 0, rng:NextNumber(-1.5, 1.5))
	model:PivotTo(CFrame.new(Grid.rectCenter(colony.origin, x, z, 1, 1) + jitter) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0))
	services.SeasonService:ApplyTo(model)
	model:SetAttribute("NodeKind", kind) -- the saga's gold marker finds trees and rocks by this
	model.Parent = colony.plot.Nodes

	local node = { kind = kind, x = x, z = z, model = model, main = main, key = key, hp = def.Hits, maxHp = def.Hits }
	colony.nodes[key] = node
	ColonyService:Block(colony, x, z, "node")

	if def.Hits then
		return -- trees and rocks are cut by swinging the tool at them (see Hit)
	end

	-- berries are picked by hand: hold E
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = def.Action
	prompt.ObjectText = "Berry bush"
	prompt.HoldDuration = def.Hold
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.Parent = main
	prompt.Triggered:Connect(function(player)
		if player ~= colony.player or colony.nodes[key] ~= node then
			return
		end
		Sounds.play("Chop", model:GetPivot().Position)
		ResourceNodeService:Harvest(colony, node)
		model:Destroy()
	end)
end

-- Gives the node's resources and frees its cell.
function ResourceNodeService:Harvest(colony, node)
	local ColonyService = services.ColonyService
	local def = Config.Nodes[node.kind]
	colony.nodes[node.key] = nil
	ColonyService:Unblock(colony, node.x, node.z)
	services.QuestService:Count(colony, node.kind == "Rock" and "mine" or (node.kind == "Tree" and "chop" or "forage"))
	local amount = def.Amount
	if node.kind == "Tree" and ColonyService:Has(colony, "IronAxes") then
		amount *= 1.5
	end
	if ColonyService:Has(colony, "PathWoods") then
		amount *= 2
	end
	amount = math.floor(amount)
	ColonyService:Add(colony, def.Gives, amount)
	ColonyService:Notify(colony, "+" .. amount .. " " .. def.Gives, "gain")
	ColonyService:Sync(colony)
end

-- Little bits flying off with each blow: wood chips or stone grit and sparks.
local function chips(at: Vector3, stone: boolean)
	local holder = Instance.new("Attachment")
	holder.WorldPosition = at
	holder.Parent = workspace.Terrain
	local p = Instance.new("ParticleEmitter")
	p.Rate = 0
	p.Lifetime = NumberRange.new(0.4, 0.9)
	p.Speed = NumberRange.new(8, 16)
	p.SpreadAngle = Vector2.new(60, 60)
	p.Acceleration = Vector3.new(0, -40, 0)
	p.Size = NumberSequence.new(stone and 0.25 or 0.35, 0.1)
	p.Color = ColorSequence.new(stone and Color3.fromRGB(170, 168, 160) or Color3.fromRGB(196, 150, 96))
	p.Parent = holder
	p:Emit(stone and 10 or 14)
	if stone then
		local spark = Instance.new("ParticleEmitter")
		spark.Rate = 0
		spark.LightEmission = 1
		spark.Lifetime = NumberRange.new(0.15, 0.3)
		spark.Speed = NumberRange.new(14, 22)
		spark.SpreadAngle = Vector2.new(70, 70)
		spark.Size = NumberSequence.new(0.15, 0)
		spark.Color = ColorSequence.new(Color3.fromRGB(255, 210, 120))
		spark.Parent = holder
		spark:Emit(6)
	end
	task.delay(2, function()
		holder:Destroy()
	end)
end

local function healthBar(node)
	if node.bar then
		return node.bar
	end
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(70, 8)
	gui.StudsOffsetWorldSpace = Vector3.new(0, node.kind == "Tree" and 9 or 5, 0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 40
	gui.Adornee = node.main
	local back = Instance.new("Frame")
	back.Size = UDim2.fromScale(1, 1)
	back.BackgroundColor3 = Color3.fromRGB(30, 24, 18)
	back.BorderSizePixel = 0
	back.Parent = gui
	local fill = Instance.new("Frame")
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = node.kind == "Tree" and Color3.fromRGB(150, 200, 90) or Color3.fromRGB(190, 190, 200)
	fill.BorderSizePixel = 0
	fill.Parent = back
	gui.Parent = node.model
	node.bar = fill
	return fill
end

local function shake(model: Model)
	local base = model:GetPivot()
	task.spawn(function()
		for i = 1, 6 do
			if not model.Parent then
				return
			end
			local a = math.rad(2.2) * (7 - i) / 6 * (i % 2 == 0 and 1 or -1)
			model:PivotTo(base * CFrame.Angles(a, 0, a * 0.6))
			task.wait(0.03)
		end
		if model.Parent then
			model:PivotTo(base)
		end
	end)
end

-- The tree topples away from you, or the rock breaks apart, then fades.
local function fell(node, from: Vector3)
	local model = node.model
	local base = model:GetPivot()
	if node.kind == "Tree" then
		local away = Vector3.new(base.Position.X - from.X, 0, base.Position.Z - from.Z)
		away = away.Magnitude > 0.1 and away.Unit or Vector3.new(1, 0, 0)
		local axis = Vector3.new(0, 1, 0):Cross(away)
		task.spawn(function()
			local t0 = os.clock()
			while model.Parent do
				local t = math.min((os.clock() - t0) / 1.3, 1)
				local angle = (t * t) * math.rad(88)
				model:PivotTo(CFrame.fromAxisAngle(axis, angle) * (base - base.Position) + base.Position)
				if t >= 1 then
					break
				end
				task.wait()
			end
			Sounds.play("Build", base.Position + away * 8)
			task.wait(1.5)
			for _, d in model:GetDescendants() do
				if d:IsA("BasePart") then
					TweenService:Create(d, TweenInfo.new(1), { Transparency = 1 }):Play()
				end
			end
			task.wait(1)
			model:Destroy()
		end)
	else
		for _, d in model:GetDescendants() do
			if d:IsA("BasePart") then
				d.Anchored = false
				d.CanCollide = true
				d:ApplyImpulse(Vector3.new(rng:NextNumber(-1, 1), 1.5, rng:NextNumber(-1, 1)) * d.AssemblyMass * 18)
				TweenService:Create(d, TweenInfo.new(2.5), { Size = d.Size * 0.4 }):Play()
			end
		end
		task.delay(2.5, function()
			model:Destroy()
		end)
	end
end

-- A swing from `player` holding `toolName`: hits the nearest tree or rock in
-- front of them. Returns true if it hit something.
function ResourceNodeService:Hit(player: Player, toolName: string, root: BasePart): boolean
	local ColonyService = services.ColonyService
	local colony = ColonyService:Get(player)
	if not colony then
		return false
	end
	local best, bestDist = nil, 9
	for _, node in colony.nodes do
		if node.hp and node.model.Parent then
			local p = node.model:GetPivot().Position
			local offset = Vector3.new(p.X - root.Position.X, 0, p.Z - root.Position.Z)
			local d = offset.Magnitude
			local facing = d < 3 or offset.Unit:Dot(Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z).Unit) > 0.3
			if d < bestDist and facing then
				best, bestDist = node, d
			end
		end
	end
	if not best then
		return false
	end
	local def = Config.Nodes[best.kind]
	if def.Tool ~= toolName then
		if toolName ~= "Sword" then
			local slot = table.find(Config.Tools, def.Tool) or 1
			ColonyService:Notify(colony, "Use the " .. def.Tool .. " for that (press " .. slot .. ")", "bad")
		end
		return false
	end
	local power = 1
	if best.kind == "Tree" then
		power = ColonyService:Has(colony, "SteelEdges") and 2 or (ColonyService:Has(colony, "IronAxes") and 1.5 or 1)
	elseif best.kind == "Rock" then
		power = ColonyService:Has(colony, "Masonry") and 1.5 or 1
	end
	best.hp -= power
	local p = best.model:GetPivot().Position
	local at = Vector3.new(p.X, p.Y + (best.kind == "Tree" and 2.5 or 1.5), p.Z):Lerp(root.Position, 0.25)
	Sounds.play(best.kind == "Rock" and "Mine" or "Chop", at)
	chips(at, best.kind == "Rock")
	local bar = healthBar(best)
	bar.Size = UDim2.fromScale(math.max(best.hp, 0) / best.maxHp, 1)
	if best.hp <= 0 then
		best.hp = nil
		if best.bar then
			best.bar.Parent.Parent:Destroy()
		end
		self:Harvest(colony, best)
		fell(best, root.Position)
	else
		shake(best.model)
	end
	return true
end

function ResourceNodeService:SpawnInitial(colony)
	for kind, def in Config.Nodes do
		for _ = 1, def.Count do
			local x, z = randomFreeCell(colony)
			if x then
				self:Spawn(colony, kind, x, z)
			end
		end
	end
end

function ResourceNodeService:Tick(colony, dt: number)
	colony.regrowTimer = (colony.regrowTimer or 0) + dt
	if colony.regrowTimer < Config.NodeRegrowInterval then
		return
	end
	colony.regrowTimer = 0
	for kind, def in Config.Nodes do
		if def.Regrow > 0 and countKind(colony, kind) < def.Regrow then
			local x, z = randomFreeCell(colony)
			if x then
				self:Spawn(colony, kind, x, z)
			end
		end
	end
end

return ResourceNodeService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">RiteService</string>
            <string name="Source"><![CDATA[--[[
	RiteService
	Feasts and seasonal blóts (Config.Rites), held from the Jarl's Table.
	  Feast  at a Longhouse or Great Hall: costs food, lifts happiness for a
	         day, then needs a rest before the next one
	  Blót   once each season at the Shrine; the season decides the blessing
	         (faster farms in spring, joy and newcomers in summer, faster wood
	         and stone in autumn, joy and less hunger at Yule)
	A bonfire burns while the rite lasts and the villagers gather round it.
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Grid = require(Shared.Grid)
local Sounds = require(Shared.Sounds)

local RiteService = {}

local R = Config.Rites
local services

function RiteService:Init(all)
	services = all
end

local function rites(colony)
	colony.rites = colony.rites or { feastUntil = 0, feastReady = 0 }
	return colony.rites
end

local function findBuilding(colony, types)
	for _, b in colony.buildings do
		if table.find(types, b.type) then
			return b
		end
	end
	return nil
end

-- A crackling bonfire beside the building, for `seconds`.
local function bonfire(colony, building, seconds: number)
	local at = building.center + Vector3.new(0, 0, -(building.sz * Config.CELL / 2 + 6))
	local model = Instance.new("Model")
	model.Name = "RiteFire"
	for i = 1, 6 do
		local log = Instance.new("Part")
		log.Anchored = true
		log.CanCollide = false
		log.Size = Vector3.new(0.6, 0.6, 3.2)
		log.Color = Color3.fromRGB(70, 48, 30)
		log.Material = Enum.Material.Wood
		log.CFrame = CFrame.new(at + Vector3.new(0, 0.4, 0)) * CFrame.Angles(0, i * math.pi / 3, math.rad(18))
		log.Parent = model
	end
	local core = Instance.new("Part")
	core.Name = "Core"
	core.Anchored = true
	core.CanCollide = false
	core.Transparency = 1
	core.Size = Vector3.new(2, 1, 2)
	core.Position = at + Vector3.new(0, 1, 0)
	core.Parent = model
	local fire = Instance.new("Fire")
	fire.Size = 9
	fire.Heat = 14
	fire.Parent = core
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 170, 90)
	light.Range = 30
	light.Brightness = 2.5
	light.Parent = core
	Sounds.loop("Fire", core)
	model.Parent = colony.plot
	task.delay(seconds, function()
		model:Destroy()
	end)
	-- everyone comes to warm their hands
	for _, v in colony.villagers do
		if v.body and not v.warrior and not v.away then
			local a = math.random() * math.pi * 2
			local r = 6 + math.random() * 5
			local spot = at + Vector3.new(math.cos(a) * r, v.height, math.sin(a) * r)
			v.body.CFrame = CFrame.lookAt(spot, Vector3.new(at.X, spot.Y, at.Z))
			v.busyUntil = os.clock() + 25
		end
	end
end

-- Feast ------------------------------------------------------------------------

function RiteService:Feast(colony): (boolean, string)
	local F = R.Feast
	local r = rites(colony)
	local hall = findBuilding(colony, { "GreatHall", F.Needs })
	if not hall then
		return false, "You need a " .. Config.Buildings[F.Needs].Display .. " to feast in."
	end
	if colony.day < r.feastReady then
		return false, "Your people are still full from the last feast (ready on day " .. r.feastReady .. ")."
	end
	if not services.ColonyService:Spend(colony, F.Cost) then
		return false, "A feast needs " .. Grid.costText(F.Cost) .. "."
	end
	-- with your own Brewhouse the mead lasts, and so does the feast
	local brewed = services.ColonyService:HasBuilding(colony, "Brewhouse")
	local days = F.Days + (brewed and 1 or 0)
	r.feastUntil = colony.day + days
	r.feastReady = math.max(colony.day + F.CooldownDays, r.feastUntil)
	bonfire(colony, hall, 60)
	Sounds.play("QuestDone", hall.center)
	services.ColonyService:Notify(colony, "Skål! Mead flows and the hall roars with song. +" .. F.Happiness .. " happiness for " .. (days == 1 and "a day." or days .. " days (your own mead)."), "quest")
	services.ColonyService:Sync(colony)
	return true, "Feast held"
end

function RiteService:FeastBonus(colony): number
	local r = colony.rites
	if r and colony.day < (r.feastUntil or 0) then
		return R.Feast.Happiness
	end
	return 0
end

-- Blót -------------------------------------------------------------------------

local function seasonName(): string
	return workspace:GetAttribute("Season") or "Summer"
end

local function seasonTurn(): number
	return workspace:GetAttribute("SeasonTurn") or 1
end

-- The blessing active this season, or nil.
function RiteService:Blessing(colony)
	local r = colony.rites
	if r and r.blotTurn == seasonTurn() then
		return R.Blot[seasonName()]
	end
	return nil
end

function RiteService:Blot(colony): (boolean, string)
	local r = rites(colony)
	local def = R.Blot[seasonName()]
	if not def then
		return false, "No rite for this season."
	end
	local shrine = findBuilding(colony, { R.Blot.Needs })
	if not shrine then
		return false, "Build a Shrine to hold a blót."
	end
	if r.blotTurn == seasonTurn() then
		return false, "You already held the " .. def.Name .. " this season."
	end
	if not services.ColonyService:Spend(colony, def.Cost) then
		return false, "The " .. def.Name .. " needs " .. Grid.costText(def.Cost) .. "."
	end
	r.blotTurn = seasonTurn()
	bonfire(colony, shrine, 60)
	Sounds.play("QuestDone", shrine.center)
	services.ColonyService:Notify(colony, "The " .. def.Name .. " is held at the shrine. " .. def.Text, "quest")
	services.QuestService:Count(colony, "blot")
	services.ColonyService:Sync(colony)
	return true, "Blót held"
end

function RiteService:State(colony)
	local r = rites(colony)
	local def = R.Blot[seasonName()]
	local hall = findBuilding(colony, { "GreatHall", R.Feast.Needs }) ~= nil
	local shrine = findBuilding(colony, { R.Blot.Needs }) ~= nil
	return {
		feastCost = R.Feast.Cost,
		feastHappiness = R.Feast.Happiness,
		feastActive = colony.day < (r.feastUntil or 0),
		feastReadyDay = r.feastReady or 0,
		hasHall = hall,
		blotName = def and def.Name,
		blotText = def and def.Text,
		blotCost = def and def.Cost,
		blotDone = r.blotTurn == seasonTurn(),
		hasShrine = shrine,
		season = seasonName(),
	}
end

return RiteService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">SaveService</string>
            <string name="Source"><![CDATA[--[[
	SaveService
	Saves each player's village with a DataStore, so it's still there next
	time: buildings (type and spot), resources, research, villagers (name,
	age, child or adult), happiness and the day count.

	Saves every Config.AutosaveSeconds, when the player leaves, and when the
	server shuts down. Loading happens in ColonyService:Create.

	DataStores only work in a PUBLISHED place with API access turned on
	(Studio: File > Publish to Roblox, then Game Settings > Security >
	"Enable Studio Access to API Services"). Without that, the game runs
	normally and simply tells the player that saving is off.

	If loading fails (DataStores down), saving is switched off for that
	player for the session, so a fresh village can never overwrite a good save.
]]

local DataStoreService = game:GetService("DataStoreService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)

local SaveService = {}

local services
local store = nil
local storeError = nil
local SAVE_VERSION = 1

function SaveService:Init(allServices)
	services = allServices
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore("VikingCity_Villages_v1")
	end)
	if ok then
		store = result
	else
		storeError = tostring(result)
	end
end

local function keyFor(player: Player): string
	return "village_" .. player.UserId
end

-- Loads a player's saved village. Returns data or nil, and whether saving is safe.
function SaveService:Load(player: Player): (any, boolean)
	if not store then
		return nil, false
	end
	local data
	local ok, err
	for attempt = 1, 3 do
		ok, err = pcall(function()
			data = store:GetAsync(keyFor(player))
		end)
		if ok then
			break
		end
		task.wait(attempt)
	end
	if not ok then
		warn("[SaveService] couldn't load " .. player.Name .. ": " .. tostring(err))
		storeError = tostring(err)
		return nil, false
	end
	if type(data) ~= "table" or data.version ~= SAVE_VERSION then
		return nil, true
	end
	return data, true
end

-- Turns a colony into plain data a DataStore can hold.
function SaveService:Snapshot(colony)
	local buildings = {}
	for _, b in colony.buildings do
		table.insert(buildings, { t = b.type, x = b.cx, z = b.cz, r = b.rot })
	end
	local villagers = {}
	local index = {}
	for _, v in colony.villagers do
		table.insert(villagers, v)
		index[v.id] = #villagers
	end
	for i, v in villagers do
		local parents = {}
		for _, pid in v.parents or {} do
			table.insert(parents, index[pid])
		end
		villagers[i] = { n = v.name, c = v.isChild, a = v.age, p = v.partner and index[v.partner], f = parents, w = v.warrior or nil }
	end
	local resources = {}
	for name, amount in colony.resources do
		resources[name] = math.floor(amount)
	end
	local tech = {}
	for id in colony.tech do
		table.insert(tech, id)
	end
	return {
		version = SAVE_VERSION,
		savedAt = os.time(),
		resources = resources,
		tech = tech,
		buildings = buildings,
		villagers = villagers,
		happiness = colony.happiness,
		day = colony.day,
		quest = colony.quest,
		rank = colony.rank,
		stats = colony.stats,
		land = colony.land,
		relations = colony.relations,
		rites = colony.rites,
		clan = colony.clan,
		warbandMode = colony.warband and colony.warband.mode == "follow" and "follow" or nil,
	}
end

-- Rebuilds a colony from saved data (called on a fresh, empty colony).
function SaveService:Restore(colony, data)
	for name, amount in data.resources or {} do
		if type(amount) == "number" then
			colony.resources[name] = amount
		end
	end
	for _, id in data.tech or {} do
		if Config.Tech[id] then
			colony.tech[id] = true
		end
	end
	colony.happiness = tonumber(data.happiness) or colony.happiness
	colony.day = tonumber(data.day) or colony.day
	colony.quest = tonumber(data.quest) or 1
	colony.rank = tonumber(data.rank) or 1
	-- land first, so buildings out on the bought ground fit
	local land = tonumber(data.land)
	if land and Config.LandStages[math.floor(land)] then
		colony.land = math.floor(land)
		services.PlotService:ApplyLand(colony)
	end
	if type(data.relations) == "table" then
		colony.relations = {}
		for name, rel in data.relations do
			if type(name) == "string" and type(rel) == "table" then
				colony.relations[name] = {
					mood = tonumber(rel.mood) or 0,
					allied = rel.allied == true,
					deal = rel.deal == true,
					tributeDays = tonumber(rel.tributeDays) or 0,
				}
			end
		end
	end
	if type(data.rites) == "table" then
		colony.rites = {
			feastUntil = tonumber(data.rites.feastUntil) or 0,
			feastReady = tonumber(data.rites.feastReady) or 0,
		}
	end
	if type(data.stats) == "table" then
		for k, n in data.stats do
			if type(k) == "string" and type(n) == "number" then
				colony.stats[k] = n
			end
		end
	end

	local placed = 0
	for _, b in data.buildings or {} do
		if Config.Buildings[b.t] then
			local ok, err = pcall(function()
				services.BuildingService:Create(colony, b.t, b.x, b.z, b.r)
			end)
			if ok then
				placed += 1
			else
				warn("[SaveService] skipped a " .. tostring(b.t) .. ": " .. tostring(err))
			end
		end
	end
	if placed == 0 then
		services.BuildingService:PlaceStarting(colony)
	end

	local villagers = data.villagers or {}
	local made = {}
	for i, saved in villagers do
		made[i] = services.VillagerService:Add(colony, saved.c == true, nil, type(saved.n) == "string" and saved.n or nil, tonumber(saved.a) or 0)
		if saved.w == true and saved.c ~= true then
			made[i].warrior = true
			services.VillagerService:Rebuild(colony, made[i])
		end
	end
	if type(data.clan) == "string" then
		colony.clan = data.clan
		services.ClanService:ApplyAll(colony)
	end
	if data.warbandMode == "follow" then
		colony.warband = { mode = "follow" }
	end
	-- re-link families
	for i, saved in villagers do
		local v = made[i]
		local partner = saved.p and made[saved.p]
		if partner then
			v.partner = partner.id
		end
		if type(saved.f) == "table" then
			v.parents = {}
			for _, pi in saved.f do
				if made[pi] then
					table.insert(v.parents, made[pi].id)
				end
			end
		end
	end
	for _, v in made do
		services.VillagerService:RefreshLabel(colony, v)
	end
	if #villagers == 0 then
		services.VillagerService:SpawnStarting(colony)
	end
	task.defer(function()
		services.ToolService:ApplyArmor(colony.player)
	end)
end

function SaveService:Save(colony)
	if not store or not colony.canSave then
		return
	end
	local data = self:Snapshot(colony)
	local key = keyFor(colony.player)
	task.spawn(function()
		local ok, err = pcall(function()
			store:SetAsync(key, data)
		end)
		if not ok then
			warn("[SaveService] save failed: " .. tostring(err))
		end
	end)
end

-- Explains in the message feed why saving is off.
function SaveService:WhyOff(): string
	local e = (storeError or ""):lower()
	if e:find("403") or e:find("publish") or e:find("api") then
		return "Saving is off: publish the game and turn on API access in Game Settings > Security (see README)."
	end
	return "Saving is off right now (DataStores unavailable). Your village won't be saved this time."
end

function SaveService:Start()
	game:BindToClose(function()
		for _, colony in services.ColonyService:All() do
			if colony.canSave then
				pcall(function()
					store:SetAsync(keyFor(colony.player), self:Snapshot(colony))
				end)
			end
		end
	end)

	while true do
		task.wait(Config.AutosaveSeconds)
		for _, colony in services.ColonyService:All() do
			self:Save(colony)
		end
	end
end

return SaveService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">SeasonService</string>
            <string name="Source"><![CDATA[--[[
	SeasonService
	Turns the year: Summer -> Autumn -> Winter -> Spring, each lasting
	Config.SeasonSeconds. A season changes how the world looks:
	  Spring  fresh light-green leaves, young green barley
	  Summer  full green, golden barley
	  Autumn  birches turn gold and orange, ferns go rust-red, grass yellows
	  Winter  snow on the ground, roofs and trees, birches bare, the fjord's
	          edges freeze, and snow falls (the snowfall is drawn on clients)
	and how the colony works (Config.Seasons): farms stop in winter and
	everyone eats more.

	The current season is stored as workspace attributes "Season" (name) and
	"SeasonIndex" so the client can react (snowfall, falling leaves, HUD).
]]

local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local ModelFactory = require(Shared.ModelFactory)

local SeasonService = {}

local services
local Terrain = Workspace.Terrain
local M = Enum.Material
local currentIndex = 1
local turn = 0 -- how many seasons have begun since the server started

local SNOW = Color3.fromRGB(236, 240, 246)

-- Terrain colours per season, by material.
local TERRAIN = {
	Summer = { Grass = Color3.fromRGB(88, 118, 58), LeafyGrass = Color3.fromRGB(78, 106, 52), Ground = Color3.fromRGB(104, 88, 64) },
	Autumn = { Grass = Color3.fromRGB(126, 118, 62), LeafyGrass = Color3.fromRGB(132, 96, 52), Ground = Color3.fromRGB(110, 86, 60) },
	Winter = { Grass = Color3.fromRGB(226, 230, 238), LeafyGrass = Color3.fromRGB(214, 220, 228), Ground = Color3.fromRGB(190, 190, 196) },
	Spring = { Grass = Color3.fromRGB(100, 136, 62), LeafyGrass = Color3.fromRGB(90, 128, 58), Ground = Color3.fromRGB(100, 84, 62) },
}

function SeasonService:Init(allServices)
	services = allServices
end

function SeasonService:Current()
	return Config.Seasons[currentIndex]
end

-- A stable pseudo-random 0..1 per part, so a birch keeps its autumn colour.
local function hash(part: BasePart): number
	local p = part.Position
	return (math.sin(p.X * 12.9898 + p.Z * 78.233) * 43758.5453) % 1
end

local function base(part: BasePart): Color3
	local c = part:GetAttribute("BaseColor")
	if not c then
		c = part.Color
		part:SetAttribute("BaseColor", c)
	end
	return c
end

-- Imported mesh pieces are named Mat_<Material>_<rrggbb> (see ModelFactory):
-- leaves on a birch fall like Leaves, conifer needles frost like Needles,
-- and thatch and turf roofs take snow like Roof.
local function meshRole(part: BasePart): string?
	local kind = string.match(part.Name, "^Mat_(%a+)_")
	if not kind then
		return nil
	end
	local model = part:FindFirstAncestorOfClass("Model")
	local owner = model and model.Name or ""
	if kind == "Leaves" then
		if string.find(owner, "Birch") then
			return "Leaves"
		elseif string.find(owner, "Tree") or string.find(owner, "Bush") then
			return "Needles"
		end
		return "Moss" -- turf on roofs
	elseif kind == "Thatch" and not string.find(owner, "Ship") then
		return "Roof"
	end
	return nil
end

local function paintBase(part: BasePart, season: string)
	local name = meshRole(part) or part.Name
	if name == "Needles" or name == "Tip" then
		local c = base(part)
		if season == "Winter" then
			part.Color = c:Lerp(SNOW, 0.5)
		elseif season == "Spring" then
			part.Color = c:Lerp(Color3.fromRGB(70, 110, 60), 0.2)
		else
			part.Color = c
		end
	elseif name == "Leaves" then
		local c = base(part)
		part.Transparency = 0
		if season == "Spring" then
			part.Color = Color3.fromRGB(128, 176, 84)
		elseif season == "Autumn" then
			local golds = { Color3.fromRGB(222, 176, 58), Color3.fromRGB(206, 120, 42), Color3.fromRGB(190, 150, 50), Color3.fromRGB(170, 70, 36) }
			part.Color = golds[math.floor(hash(part) * #golds) + 1]
		elseif season == "Winter" then
			part.Transparency = 1 -- bare branches
		else
			part.Color = c
		end
	elseif name == "Fern" then
		local c = base(part)
		if season == "Autumn" then
			part.Color = Color3.fromRGB(150, 70, 38)
		elseif season == "Winter" then
			part.Color = Color3.fromRGB(170, 150, 120):Lerp(SNOW, 0.6)
		else
			part.Color = c
		end
	elseif name == "Juniper" or name == "Bush" then
		local c = base(part)
		part.Color = season == "Winter" and c:Lerp(SNOW, 0.45) or c
	elseif name == "Moss" then
		local c = base(part)
		part.Color = season == "Winter" and c:Lerp(SNOW, 0.8) or (season == "Autumn" and c:Lerp(Color3.fromRGB(130, 110, 60), 0.4) or c)
	elseif name == "Roof" then
		local c = base(part)
		part.Color = season == "Winter" and c:Lerp(SNOW, 0.8) or c
		if string.sub(part.Name, 1, 4) == "Mat_" then
			part.Material = season == "Winter" and Enum.Material.Snow or Enum.Material.Fabric
		end
	elseif name == "Barley" then
		local c = base(part)
		if season == "Spring" then
			part.Color = Color3.fromRGB(104, 146, 66)
		elseif season == "Autumn" then
			part.Color = c:Lerp(Color3.fromRGB(170, 130, 70), 0.4)
		elseif season == "Winter" then
			part.Color = Color3.fromRGB(110, 92, 70):Lerp(SNOW, 0.6) -- fallow and frosted
		else
			part.Color = c
		end
	end
end

-- Our own textures on mesh pieces (ModelFactory.applyTexture) follow the
-- piece's colour, and step aside when a roof is under snow.
local function paint(part: BasePart, season: string)
	paintBase(part, season)
	ModelFactory.retintTexture(part)
end

-- Paints every part inside `root` for the current season. Called for the
-- whole world on a season change, and for each new building or tree.
function SeasonService:ApplyTo(root: Instance)
	local season = self:Current().Name
	for _, d in root:GetDescendants() do
		if d:IsA("BasePart") then
			paint(d, season)
		end
	end
end

-- Ice floes drifting out on the open fjord in winter.
local floes
local function makeFloes(): Folder
	local folder = Instance.new("Folder")
	folder.Name = "IceFloes"
	local rng = Random.new(1203)
	local avoid = {}
	for _, rival in Config.Rivals do
		if rival.Sea then
			table.insert(avoid, rival)
		end
	end
	local made, tries = 0, 0
	while made < 90 and tries < 600 do
		tries += 1
		local x = rng:NextNumber(-900, 2900)
		local z = rng:NextNumber(-500, -130)
		local clear = math.abs(z + 300) > 45 -- leave the trading ship's lane open
		for _, rival in avoid do
			if (Vector3.new(x, 0, z) - Vector3.new(rival.Center.X, 0, rival.Center.Z)).Magnitude < rival.Radius + 90 then
				clear = false
			end
		end
		if clear then
			made += 1
			local w, d = rng:NextNumber(6, 24), rng:NextNumber(5, 18)
			local spin = CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0)
			local floe = Instance.new("Part")
			floe.Name = "IceFloe"
			floe.Anchored = true
			floe.CanCollide = false
			floe.CanQuery = false
			floe.Size = Vector3.new(w, 1.4, d)
			floe.CFrame = CFrame.new(x, 0.15, z) * spin * CFrame.Angles(rng:NextNumber(-0.04, 0.04), 0, rng:NextNumber(-0.04, 0.04))
			floe.Material = M.Glacier
			floe.Color = Color3.fromRGB(206, 226, 238)
			floe.Parent = folder
			-- a crust of snow and a broken chunk or two on top
			local crust = floe:Clone()
			crust.Name = "IceSnow"
			crust.Size = Vector3.new(w * rng:NextNumber(0.5, 0.85), 0.5, d * rng:NextNumber(0.5, 0.85))
			crust.CFrame = floe.CFrame * CFrame.new(rng:NextNumber(-w, w) * 0.1, 0.9, rng:NextNumber(-d, d) * 0.1)
			crust.Material = M.Snow
			crust.Color = Color3.fromRGB(240, 244, 250)
			crust.Parent = folder
			if rng:NextNumber() < 0.4 then
				local chunk = floe:Clone()
				chunk.Name = "IceChunk"
				chunk.Size = Vector3.new(rng:NextNumber(2, 5), rng:NextNumber(1.5, 3.5), rng:NextNumber(2, 5))
				chunk.CFrame = floe.CFrame * CFrame.new(rng:NextNumber(-w, w) * 0.3, 1.4, rng:NextNumber(-d, d) * 0.3) * CFrame.Angles(rng:NextNumber(-0.5, 0.5), rng:NextNumber(0, 3), rng:NextNumber(-0.5, 0.5))
				chunk.Parent = folder
			end
		end
	end
	return folder
end

local frozen = false
local function setIce(on: boolean)
	if on == frozen then
		return
	end
	frozen = on
	floes = floes or makeFloes()
	floes.Parent = on and (Workspace:FindFirstChild("Scenery") or Workspace) or nil
	-- freeze a band of shallow water along both shores
	local from, to = M.Water, M.Glacier
	if not on then
		from, to = M.Glacier, M.Water
	end
	local bands = {
		Region3.new(Vector3.new(-1200, -12, -112), Vector3.new(3200, 0, -36)),
		Region3.new(Vector3.new(-1200, -12, -640), Vector3.new(3200, 0, -520)),
	}
	for _, region in bands do
		Terrain:ReplaceMaterial(region:ExpandToGrid(4), 4, from, to)
	end
end

local function apply(index: number, announce: boolean)
	currentIndex = index
	local season = Config.Seasons[index]
	Workspace:SetAttribute("Season", season.Name)
	Workspace:SetAttribute("SeasonIndex", index)
	turn += 1
	Workspace:SetAttribute("SeasonTurn", turn)

	for material, color in TERRAIN[season.Name] do
		Terrain:SetMaterialColor(M[material], color)
	end
	Terrain:SetMaterialColor(M.Glacier, Color3.fromRGB(196, 222, 236))
	setIce(season.Name == "Winter")
	SeasonService:ApplyTo(Workspace)

	if announce then
		local lines = {
			Summer = "Summer is here. Long days and golden fields.",
			Autumn = "Autumn has come. Fill your stores with food, and stack firewood: homes burn Wood all winter.",
			Winter = "Winter has come! Farms lie frozen, your people eat more, homes burn Wood, and wolves prowl the meadow.",
			Spring = "Spring thaw. The fields can be sown again.",
		}
		local ColonyService = services.ColonyService
		for _, colony in ColonyService:All() do
			ColonyService:Notify(colony, lines[season.Name], season.Name == "Winter" and "bad" or "good")
		end
	end
end

function SeasonService:Start()
	-- WorldService builds the world during Init, so it is ready here.
	apply(1, false)
	while true do
		task.wait(Config.SeasonSeconds)
		apply(currentIndex % #Config.Seasons + 1, true)
	end
end

return SeasonService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">TechService</string>
            <string name="Source"><![CDATA[--[[
	TechService
	Research. Players spend Lore (made in a Lore Hall) and sometimes other
	resources to unlock techs from Config.Tech. Some techs need a building
	(Smithy, Shipyard, Shrine) or other techs first, and patron paths are
	exclusive: a settlement follows only one.

	Effects are read where they matter through ColonyService:Has(colony, id).
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Grid = require(Shared.Grid)
local Remotes = require(Shared.Remotes)

local TechService = {}

local services

function TechService:Init(allServices)
	services = allServices
end

-- Returns ok, reason for whether `colony` can research `id` right now.
function TechService:CanResearch(colony, id: string): (boolean, string?)
	local tech = Config.Tech[id]
	if not tech then
		return false, "Unknown research"
	end
	local ColonyService = services.ColonyService
	if colony.tech[id] then
		return false, "Already known"
	end
	for _, req in tech.Requires or {} do
		if not colony.tech[req] then
			return false, "Needs " .. Config.Tech[req].Name
		end
	end
	if tech.Building and not ColonyService:HasBuilding(colony, tech.Building) then
		return false, "Build a " .. Config.Buildings[tech.Building].Display .. " first"
	end
	if tech.Group then
		for known in colony.tech do
			if Config.Tech[known].Group == tech.Group then
				return false, "You already follow " .. Config.Tech[known].Name
			end
		end
	end
	if not Grid.canAfford(colony.resources, tech.Cost) then
		return false, "Needs " .. Grid.costText(tech.Cost)
	end
	return true, nil
end

function TechService:Research(player: Player, id)
	local ColonyService = services.ColonyService
	local colony = ColonyService:Get(player)
	if not colony or typeof(id) ~= "string" then
		return false, "Not ready"
	end
	local ok, reason = self:CanResearch(colony, id)
	if not ok then
		return false, reason
	end
	ColonyService:Spend(colony, Config.Tech[id].Cost)
	colony.tech[id] = true
	if id == "ChainMail" or id == "IronAxes" or id == "SteelEdges" then
		services.ToolService:ApplyArmor(player)
	end
	ColonyService:Notify(colony, "Researched " .. Config.Tech[id].Name .. "! " .. Config.Tech[id].Description, "good")
	ColonyService:Sync(colony)
	return true, Config.Tech[id].Name .. " researched"
end

function TechService:Start()
	Remotes.Research.OnServerInvoke = function(player, id)
		return self:Research(player, id)
	end
end

return TechService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">ToolService</string>
            <string name="Source"><![CDATA[--[[
	ToolService
	Gives every player an Axe, a Pickaxe and a Bow each time they spawn
	(keys 1, 2, 3), and handles Bow shots: the client sends where it aimed,
	the server checks the shot, flies an arrow and tells WildlifeService if a
	deer was hit.
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Sounds = require(Shared.Sounds)
local Remotes = require(Shared.Remotes)
local ModelFactory = require(Shared.ModelFactory)

local ToolService = {}

local services
local lastShot = {} -- [player] = os.clock()

function ToolService:Init(allServices)
	services = allServices
end

-- Ring Mail research gives 150 health.
-- Welds a piece of gear to a body part (removed with the character).
local function wear(character: Model, onto: BasePart, name: string, size: Vector3, offset: CFrame, color: Color3, material, shape)
	local old = character:FindFirstChild(name)
	if old then
		old:Destroy()
	end
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = material or Enum.Material.Metal
	if shape then
		p.Shape = shape
	end
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.CFrame = onto.CFrame * offset
	p.Parent = character
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = onto
	weld.Part1 = p
	weld.Parent = p
	return p
end

-- Research shows on your Viking: chain mail and a helmet with Chain Mail,
-- darker iron then bright steel axe heads with Iron Axes / Steel Edges.
function ToolService:ApplyGear(player: Player)
	local character = player.Character
	local colony = services.ColonyService:Get(player)
	if not character or not colony then
		return
	end
	local Has = function(id)
		return services.ColonyService:Has(colony, id)
	end
	if Has("ChainMail") then
		local torso = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
		local head = character:FindFirstChild("Head")
		local mail = Color3.fromRGB(128, 130, 136)
		if torso then
			wear(character, torso, "GearMail", torso.Size + Vector3.new(0.12, 0.3, 0.12), CFrame.new(0, -0.1, 0), mail, Enum.Material.DiamondPlate)
		end
		local lower = character:FindFirstChild("LowerTorso")
		if lower then
			wear(character, lower, "GearSkirt", lower.Size + Vector3.new(0.14, 0.5, 0.14), CFrame.new(0, -0.2, 0), mail, Enum.Material.DiamondPlate)
		end
		if head then
			wear(character, head, "GearHelm", Vector3.new(1.3, 0.75, 1.3), CFrame.new(0, 0.38, 0), Color3.fromRGB(96, 98, 104), Enum.Material.Metal, Enum.PartType.Ball)
			wear(character, head, "GearNose", Vector3.new(0.14, 0.55, 0.14), CFrame.new(0, 0.05, -0.6), Color3.fromRGB(96, 98, 104), Enum.Material.Metal)
		end
	end
	local steel = Has("SteelEdges")
	local iron = Has("IronAxes")
	if steel or iron then
		local containers = { player:FindFirstChild("Backpack"), character }
		for _, c in containers do
			for _, toolName in { "Axe", "Sword" } do
				local axe = c and c:FindFirstChild(toolName) -- the axe or the sword
				if axe and axe:IsA("Tool") then
					for _, d in axe:GetChildren() do
						if d:IsA("BasePart") and d.Name == "Head" then
							d.Color = steel and Color3.fromRGB(210, 215, 225) or Color3.fromRGB(80, 82, 90)
							d.Material = steel and Enum.Material.Foil or Enum.Material.Metal
						end
					end
				end
			end
		end
	end
end

function ToolService:ApplyArmor(player: Player)
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	local colony = services.ColonyService:Get(player)
	if humanoid and services.ColonyService:Has(colony, "ChainMail") then
		humanoid.MaxHealth = 150
		humanoid.Health = math.max(humanoid.Health, 150)
	end
	self:ApplyGear(player)
end

-- True if the player is currently holding the named tool.
function ToolService:IsHolding(player: Player, toolName: string): boolean
	local character = player.Character
	local tool = character and character:FindFirstChildOfClass("Tool")
	return tool ~= nil and tool.Name == toolName
end

local function giveTools(player: Player)
	local backpack = player:WaitForChild("Backpack")
	for _, name in Config.Tools do
		if not backpack:FindFirstChild(name) and not (player.Character and player.Character:FindFirstChild(name)) then
			ModelFactory.tool(name).Parent = backpack
		end
	end
end

local function findDeer(inst: Instance?): Model?
	while inst and inst ~= workspace do
		if inst:IsA("Model") and inst:GetAttribute("DeerId") then
			return inst
		end
		inst = inst.Parent
	end
	return nil
end

local function shoot(player: Player, aim)
	if typeof(aim) ~= "Vector3" or aim ~= aim then
		return
	end
	local now = os.clock()
	if lastShot[player] and now - lastShot[player] < Config.Bow.Cooldown then
		return
	end
	if not ToolService:IsHolding(player, "Bow") then
		return
	end
	local character = player.Character
	local head = character and character:FindFirstChild("Head")
	if not head then
		return
	end
	lastShot[player] = now

	local origin = head.Position + Vector3.new(0, 0.3, 0)
	local delta = aim - origin
	if delta.Magnitude < 1 then
		return
	end
	local colony = services.ColonyService:Get(player)
	local longbows = services.ColonyService:Has(colony, "Longbows")
	local dir = delta.Unit * (Config.Bow.Range + (longbows and 60 or 0))
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character }
	local hit = workspace:Raycast(origin, dir, params)
	local endPoint = hit and hit.Position or origin + dir

	Sounds.play("Bow", head)
	-- the visible arrow
	local arrow = ModelFactory.arrow()
	arrow.CFrame = CFrame.lookAt(origin, endPoint)
	arrow.Parent = workspace
	local flight = (endPoint - origin).Magnitude / Config.Bow.ArrowSpeed
	TweenService:Create(arrow, TweenInfo.new(flight, Enum.EasingStyle.Linear), { CFrame = CFrame.lookAt(endPoint, endPoint + dir) }):Play()
	Debris:AddItem(arrow, flight + 3)

	local deer = hit and findDeer(hit.Instance)
	if deer then
		task.delay(flight, function()
			services.WildlifeService:Kill(deer, player)
		end)
	end
	local guard = hit and services.RaidService:FindDefender(hit.Instance)
	if guard then
		task.delay(flight, function()
			services.RaidService:DamageDefender(guard, Config.Combat.ArrowDamage * (longbows and 1.5 or 1), player)
		end)
	end
	local raider = hit and services.VillageDefenseService:FindRaider(hit.Instance)
	if raider then
		task.delay(flight, function()
			services.VillageDefenseService:DamageRaider(raider, Config.Combat.ArrowDamage * (longbows and 1.5 or 1))
		end)
	end
	local militia = hit and services.TownRaidService:FindMilitia(hit.Instance)
	if militia then
		task.delay(flight, function()
			services.TownRaidService:DamageMilitia(militia, Config.Combat.ArrowDamage * (longbows and 1.5 or 1), player)
		end)
	end
	if hit then
		task.delay(flight, function()
			services.BoatService:ArrowHit(hit.Instance, player)
		end)
	end
end

local lastStrike = {}
local function strike(player: Player)
	local now = os.clock()
	if lastStrike[player] and now - lastStrike[player] < Config.Combat.StrikeCooldown then
		return
	end
	local character = player.Character
	local held = character and character:FindFirstChildOfClass("Tool")
	local base = held and Config.Combat.MeleeDamage[held.Name]
	if not base then
		return
	end
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	lastStrike[player] = now
	Sounds.play("Swing", root)
	if held.Name ~= "Sword" then
		services.ResourceNodeService:Hit(player, held.Name, root)
	end
	local colony = services.ColonyService:Get(player)
	local damage = base
	if held.Name == "Sword" then
		if services.ColonyService:Has(colony, "SteelEdges") then
			damage *= 2
		elseif services.ColonyService:Has(colony, "IronAxes") then
			damage *= 1.5
		end
	end
	for _, guard in services.RaidService:DefendersNear(root.Position, root.CFrame.LookVector, Config.Combat.StrikeRange) do
		services.RaidService:DamageDefender(guard, damage, player)
	end
	for _, raider in services.VillageDefenseService:RaidersNear(root.Position, root.CFrame.LookVector, Config.Combat.StrikeRange) do
		services.VillageDefenseService:DamageRaider(raider, damage)
	end
	for _, militia in services.TownRaidService:MilitiaNear(root.Position, root.CFrame.LookVector, Config.Combat.StrikeRange) do
		services.TownRaidService:DamageMilitia(militia, damage, player)
	end
	-- a hold's gate: axes bite into the doors best
	local gateDamage = Config.Siege.ToolDamage[held.Name]
	if gateDamage then
		services.RaidService:StrikeGate(root.Position, root.CFrame.LookVector, Config.Combat.StrikeRange, gateDamage * (damage / base), player)
	end
end

function ToolService:Start()
	local function onPlayer(player: Player)
		player.CharacterAdded:Connect(function(character)
			giveTools(player)
			character:WaitForChild("Head", 5)
			task.wait(0.5) -- let the avatar's look load first
			ToolService:ApplyArmor(player)
		end)
		if player.Character then
			giveTools(player)
		end
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in Players:GetPlayers() do
		onPlayer(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		lastShot[player] = nil
		lastStrike[player] = nil
	end)

	Remotes.ShootArrow.OnServerEvent:Connect(shoot)
	Remotes.Strike.OnServerEvent:Connect(strike)
end

return ToolService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">TownRaidService</string>
            <string name="Source"><![CDATA[--[[
	TownRaidService
	Raid other players' villages, Clash-of-Clans style. Each plot has a war
	horn post on its west edge. Another player can hold E on it to start a
	raid:
	  - the village calls up its militia (half its adults, 2 to 6 fighters)
	  - beat every militia within Config.TownRaid.Duration seconds
	  - then plunder the chest by their longhouse: you take a share of their
	    stores (20%, at most 150 of each resource)
	Villages are never destroyed and no buildings are harmed. A raided
	village gets a shield so it can't be raided again for a while, new
	villages are protected for their first days, and raiders have a cooldown.
]]

local Players = game:GetService("Players")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Sounds = require(Shared.Sounds)
local Grid = require(Shared.Grid)
local ModelFactory = require(Shared.ModelFactory)

local TownRaidService = {}

local T = Config.TownRaid
local services
local folder: Folder
local raids = {} -- [targetPlayer] = raid
local shields = {} -- [userId] = os.clock() until which a village is shielded
local cooldowns = {} -- [userId] = os.clock() until which a player can't raid
local WALK_ANIM = "rbxassetid://507777826"

function TownRaidService:Init(allServices)
	services = allServices
	folder = Instance.new("Folder")
	folder.Name = "TownRaids"
	folder.Parent = workspace
end

local function notify(player: Player?, text: string, kind: string?)
	local colony = player and services.ColonyService:Get(player)
	if colony then
		services.ColonyService:Notify(colony, text, kind)
	end
end

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

local function villageCentre(colony): Vector3
	for _, b in colony.buildings do
		if Config.Buildings[b.type].Housing then
			return b.center
		end
	end
	return colony.origin + Vector3.new(Grid.PLOT_SIZE / 2, 0, Grid.PLOT_SIZE / 2)
end

-- Militia ---------------------------------------------------------------------

local function spawnMilitia(raid, pos: Vector3, ownerName: string)
	local desc = Instance.new("HumanoidDescription")
	local skin = Color3.fromRGB(226, 186, 150)
	desc.HeadColor = skin
	desc.LeftArmColor = skin
	desc.RightArmColor = skin
	desc.TorsoColor = Color3.fromRGB(120, 50, 40)
	desc.LeftLegColor = Color3.fromRGB(70, 56, 44)
	desc.RightLegColor = Color3.fromRGB(70, 56, 44)
	local ok, model = pcall(function()
		return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	end)
	if not ok or not model then
		warn("[TownRaidService] could not create militia: " .. tostring(model))
		return
	end
	model.Name = ownerName .. "'s Militia"
	model:SetAttribute("Militia", true)
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	humanoid.DisplayName = ownerName .. "'s Militia"
	humanoid.MaxHealth = T.MilitiaHealth
	humanoid.Health = T.MilitiaHealth
	humanoid.WalkSpeed = 14
	local rightHand = model:FindFirstChild("RightHand")
	if rightHand then
		local spear = Instance.new("Part")
		spear.Name = "Spear"
		spear.Size = Vector3.new(0.25, 0.25, 6)
		spear.Color = Color3.fromRGB(110, 76, 46)
		spear.Material = Enum.Material.Wood
		spear.CanCollide = false
		spear.Massless = true
		spear.CFrame = rightHand.CFrame * CFrame.new(0, 0, -1.5)
		spear.Parent = model
		local w = Instance.new("WeldConstraint")
		w.Part0 = rightHand
		w.Part1 = spear
		w.Parent = spear
	end
	model:PivotTo(CFrame.new(pos + Vector3.new(0, 3, 0)))
	model.Parent = folder
	local root = model:FindFirstChild("HumanoidRootPart")
	if root then
		pcall(function()
			root:SetNetworkOwner(nil)
		end)
	end
	local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator", humanoid)
	local walkTrack
	pcall(function()
		local anim = Instance.new("Animation")
		anim.AnimationId = WALK_ANIM
		walkTrack = animator:LoadAnimation(anim)
	end)
	humanoid.Running:Connect(function(speed)
		if walkTrack then
			if speed > 0.5 and not walkTrack.IsPlaying then
				walkTrack:Play()
			elseif speed <= 0.5 and walkTrack.IsPlaying then
				walkTrack:Stop()
			end
		end
	end)
	local m = { model = model, humanoid = humanoid, root = root, lastHit = 0 }
	humanoid.Died:Connect(function()
		m.dead = true
		task.delay(5, function()
			model:Destroy()
		end)
		TownRaidService:CheckWon(raid)
	end)
	table.insert(raid.militia, m)
end

-- Raids -----------------------------------------------------------------------

local function endRaid(raid, won: boolean, reason: string?)
	if raid.over then
		return
	end
	raid.over = true
	raids[raid.target] = nil
	for _, m in raid.militia do
		if m.model.Parent then
			m.model:Destroy()
		end
	end
	if raid.chest then
		raid.chest:Destroy()
	end
	if raid.diedConn then
		raid.diedConn:Disconnect()
	end
	local now = os.clock()
	cooldowns[raid.attacker.UserId] = now + T.AttackerCooldown
	shields[raid.target.UserId] = now + (won and T.ShieldSeconds or T.FailedShieldSeconds)
	if not won then
		notify(raid.attacker, "The raid on " .. raid.target.DisplayName .. "'s village failed" .. (reason and (": " .. reason) or "."), "bad")
		notify(raid.target, "Your militia drove off " .. raid.attacker.DisplayName .. "! Your stores are safe.", "good")
	end
end

local function plunder(raid, player: Player)
	if raid.over or player ~= raid.attacker or not raid.won then
		return
	end
	local ColonyService = services.ColonyService
	local attacker = ColonyService:Get(raid.attacker)
	local target = ColonyService:Get(raid.target)
	if not attacker or not target then
		endRaid(raid, false, "the village is gone")
		return
	end
	local mult = 1
	if ColonyService:Has(attacker, "SeaRaiders") then
		mult *= 1.25
	end
	local taken = {}
	for _, res in Config.ResourceOrder do
		if res ~= "Lore" then
			local amount = math.floor(math.min((target.resources[res] or 0) * T.LootShare * mult, T.LootCap))
			if amount > 0 then
				target.resources[res] -= amount
				ColonyService:Add(attacker, res, amount)
				taken[res] = amount
			end
		end
	end
	local text = next(taken) and Grid.costText(taken) or "nothing (their stores were empty)"
	ColonyService:Notify(attacker, "Victory! You carried off " .. text .. " from " .. raid.target.DisplayName .. ".", "raid")
	ColonyService:Notify(target, raid.attacker.DisplayName .. " plundered " .. text .. ". Your village is shielded for " .. math.floor(T.ShieldSeconds / 60) .. " minutes.", "bad")
	ColonyService:Sync(attacker)
	ColonyService:Sync(target)
	endRaid(raid, true)
end

function TownRaidService:CheckWon(raid)
	if raid.over or raid.won then
		return
	end
	for _, m in raid.militia do
		if not m.dead then
			return
		end
	end
	raid.won = true
	notify(raid.attacker, "The militia has fallen! Plunder the chest by their longhouse (hold E).", "raid")
	notify(raid.target, "Your militia has fallen! " .. raid.attacker.DisplayName .. " is going for your stores.", "bad")

	local centre = villageCentre(services.ColonyService:Get(raid.target))
	local chest = Instance.new("Model")
	chest.Name = "RaidChest"
	local add = ModelFactory.addPart
	local cf = CFrame.new(centre + Vector3.new(0, 0, -12))
	local box = add(chest, { Name = "Box", Size = Vector3.new(4, 2.2, 2.6), CFrame = cf * CFrame.new(0, 1.1, 0), Color = Color3.fromRGB(110, 70, 40), Material = Enum.Material.WoodPlanks })
	add(chest, { Name = "Silver", Size = Vector3.new(3, 0.4, 1.8), CFrame = cf * CFrame.new(0, 2.4, 0), Color = Color3.fromRGB(220, 220, 230), Material = Enum.Material.Foil })
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 220, 150)
	light.Range = 10
	light.Parent = box
	chest.Parent = folder
	raid.chest = chest
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Plunder"
	prompt.ObjectText = raid.target.DisplayName .. "'s stores"
	prompt.HoldDuration = 2
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.Parent = box
	prompt.Triggered:Connect(function(player)
		plunder(raid, player)
	end)
end

local function canRaid(attacker: Player, target: Player): (boolean, string?)
	local ColonyService = services.ColonyService
	local a, t = ColonyService:Get(attacker), ColonyService:Get(target)
	if attacker == target then
		return false, "This is your own village's war horn."
	end
	if not a or not t then
		return false, "That village isn't ready."
	end
	local now = os.clock()
	if raids[target] then
		return false, target.DisplayName .. "'s village is already under attack."
	end
	for _, r in raids do
		if r.attacker == attacker then
			return false, "You're already raiding someone."
		end
	end
	if (shields[target.UserId] or 0) > now then
		return false, target.DisplayName .. "'s village is shielded for " .. math.ceil((shields[target.UserId] - now) / 60) .. " more minute(s)."
	end
	if (cooldowns[attacker.UserId] or 0) > now then
		return false, "Your warriors are resting. Raid again in " .. math.ceil(cooldowns[attacker.UserId] - now) .. "s."
	end
	if a.day < T.MinDay then
		return false, "Your village must reach day " .. T.MinDay .. " before raiding others."
	end
	if t.day < T.MinDay then
		return false, target.DisplayName .. "'s village is too new to raid (protected until day " .. T.MinDay .. ")."
	end
	return true, nil
end

local function startRaid(attacker: Player, target: Player)
	local ok, reason = canRaid(attacker, target)
	if not ok then
		notify(attacker, reason, "bad")
		return
	end
	local colony = services.ColonyService:Get(target)
	local adults = 0
	for _, v in colony.villagers do
		if not v.isChild then
			adults += 1
		end
	end
	local count = math.clamp(math.floor(adults * T.MilitiaPerAdult), T.MinMilitia, T.MaxMilitia)
	local raid = { attacker = attacker, target = target, militia = {}, endsAt = os.clock() + T.Duration }
	raids[target] = raid
	local centre = villageCentre(colony)
	for i = 1, count do
		local a = i / count * math.pi * 2
		local p = centre + Vector3.new(math.cos(a) * 10, 0, math.sin(a) * 10)
		local y = services.WorldService:GroundHeight(p.X, p.Z)
		spawnMilitia(raid, Vector3.new(p.X, y, p.Z), target.DisplayName)
	end
	local hum = attacker.Character and attacker.Character:FindFirstChildOfClass("Humanoid")
	if hum then
		raid.diedConn = hum.Died:Connect(function()
			endRaid(raid, false, "you fell in battle")
		end)
	end
	Sounds.play("WarHorn", centre)
	notify(attacker, "RAID on " .. target.DisplayName .. "'s village! Defeat " .. count .. " militia in " .. T.Duration .. "s.", "raid")
	notify(target, attacker.DisplayName .. " sounds the war horn! Your militia (" .. count .. ") takes up arms.", "raid")
end

-- Combat hooks used by ToolService -----------------------------------------------

function TownRaidService:FindMilitia(inst: Instance?): Model?
	while inst and inst ~= workspace do
		if inst:IsA("Model") and inst:GetAttribute("Militia") then
			return inst
		end
		inst = inst.Parent
	end
	return nil
end

function TownRaidService:MilitiaNear(position: Vector3, look: Vector3, range: number)
	local found = {}
	for _, raid in raids do
		for _, m in raid.militia do
			if not m.dead and m.root then
				local offset = flat(m.root.Position - position)
				if offset.Magnitude <= range and (offset.Magnitude < 2 or offset.Unit:Dot(flat(look).Unit) > 0.2) then
					table.insert(found, m.model)
				end
			end
		end
	end
	return found
end

-- The closest militia fighting `attacker`'s raid (for the war band).
function TownRaidService:NearestMilitia(attacker: Player, position: Vector3, range: number): (Model?, BasePart?)
	local best, bestRoot, bestD = nil, nil, range
	for _, raid in raids do
		if raid.attacker == attacker then
			for _, m in raid.militia do
				if not m.dead and m.root and m.root.Parent then
					local d = (m.root.Position - position).Magnitude
					if d < bestD then
						best, bestRoot, bestD = m.model, m.root, d
					end
				end
			end
		end
	end
	return best, bestRoot
end

function TownRaidService:DamageMilitia(model: Model, amount: number, attacker: Player)
	local raid
	for _, r in raids do
		for _, m in r.militia do
			if m.model == model then
				raid = r
			end
		end
	end
	if not raid or raid.attacker ~= attacker then
		return -- only the raider fights the militia
	end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.Health > 0 then
		humanoid:TakeDamage(amount)
	end
end

-- Loop ------------------------------------------------------------------------

function TownRaidService:Start()
	-- a war horn post on the west edge of every plot
	for i = 1, Config.MAX_PLOTS do
		local o = Grid.plotOrigin(i)
		local x, z = o.X - Config.PLOT_GAP / 2, o.Z + Grid.PLOT_SIZE / 2
		local y = services.WorldService:GroundHeight(x, z)
		local post = Instance.new("Part")
		post.Name = "WarHornPost"
		post.Anchored = true
		post.Size = Vector3.new(0.8, 6, 0.8)
		post.Position = Vector3.new(x, y + 3, z)
		post.Color = Color3.fromRGB(96, 70, 48)
		post.Material = Enum.Material.Wood
		post.Parent = folder
		local horn = Instance.new("Part")
		horn.Name = "Horn"
		horn.Anchored = true
		horn.CanCollide = false
		horn.Shape = Enum.PartType.Cylinder
		horn.Size = Vector3.new(2.4, 0.6, 0.6)
		horn.CFrame = CFrame.new(x, y + 5.6, z) * CFrame.Angles(0, 0, math.rad(20))
		horn.Color = Color3.fromRGB(226, 214, 186)
		horn.Material = Enum.Material.SmoothPlastic
		horn.Parent = folder
		local prompt = Instance.new("ProximityPrompt")
		prompt.ActionText = "Raid this village"
		prompt.ObjectText = "War horn"
		prompt.HoldDuration = 1.5
		prompt.MaxActivationDistance = 10
		prompt.RequiresLineOfSight = false
		prompt.Parent = post
		prompt.Triggered:Connect(function(player)
			for _, target in Players:GetPlayers() do
				local colony = services.ColonyService:Get(target)
				if colony and colony.plotIndex == i then
					startRaid(player, target)
					return
				end
			end
			notify(player, "Nobody lives here yet.", "info")
		end)
	end

	Players.PlayerRemoving:Connect(function(player)
		for _, raid in raids do
			if raid.attacker == player or raid.target == player then
				endRaid(raid, false, "a chieftain left")
			end
		end
	end)

	while true do
		task.wait(0.25)
		local now = os.clock()
		for _, raid in raids do
			if now > raid.endsAt and not raid.over then
				endRaid(raid, false, "time ran out")
				continue
			end
			local character = raid.attacker.Character
			local troot = character and character:FindFirstChild("HumanoidRootPart")
			local thum = character and character:FindFirstChildOfClass("Humanoid")
			for _, m in raid.militia do
				if not m.dead and m.root and troot and thum and thum.Health > 0 then
					local dist = (troot.Position - m.root.Position).Magnitude
					m.humanoid:MoveTo(troot.Position)
					if dist < 6.5 and now - m.lastHit > 1.2 then
						m.lastHit = now
						thum:TakeDamage(T.MilitiaDamage)
					end
				end
			end
		end
	end
end

return TownRaidService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">TradeService</string>
            <string name="Source"><![CDATA[--[[
	TradeService
	A trader's stall on the beach in front of every plot. Hold E there to
	open the trade window and swap goods for silver (or silver for goods).
	Prices follow the seasons: food is dear in winter and cheap at harvest.
	Offers are in Config.Trade.
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Grid = require(Shared.Grid)
local Remotes = require(Shared.Remotes)
local ModelFactory = require(Shared.ModelFactory)
local Sounds = require(Shared.Sounds)

local TradeService = {}

local services
local stalls = {} -- [plotIndex] = position

function TradeService:Init(allServices)
	services = allServices
end

-- What offer `i` costs right now (season-adjusted), and what it gives.
function TradeService.Price(i: number, season: string?)
	local offer = Config.Trade.Offers[i]
	if not offer then
		return nil, nil
	end
	local mult = offer.Season and offer.Season[season or "Summer"] or 1
	local give = {}
	for res, n in offer.Give do
		give[res] = math.max(1, math.floor(n * mult + 0.5))
	end
	return give, offer.Get
end

local function nearStall(player: Player): boolean
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not root then
		return false
	end
	for _, pos in stalls do
		if (root.Position - pos).Magnitude < 18 then
			return true
		end
	end
	return false
end

function TradeService:Trade(player: Player, i)
	local ColonyService = services.ColonyService
	local colony = ColonyService:Get(player)
	if not colony or typeof(i) ~= "number" then
		return false, "Not ready"
	end
	if not nearStall(player) then
		return false, "Walk back to the trader's stall"
	end
	local give, get = TradeService.Price(math.floor(i), workspace:GetAttribute("Season"))
	if not give then
		return false, "Unknown offer"
	end
	if not ColonyService:Spend(colony, give) then
		return false, "You need " .. Grid.costText(give)
	end
	for res, n in get do
		ColonyService:Add(colony, res, n)
	end
	services.QuestService:Count(colony, "trade")
	Sounds.play("Build", player.Character and player.Character:FindFirstChild("HumanoidRootPart"))
	ColonyService:Sync(colony)
	return true, "Traded " .. Grid.costText(give) .. " for " .. Grid.costText(get)
end

local function buildStall(index: number)
	local o = Grid.plotOrigin(index)
	local x, z = o.X + 100, -16
	local y = services.WorldService:GroundHeight(x, z)
	-- built at the origin with its counter at -Z, then turned to face the
	-- village (+Z), where players come from
	local world = CFrame.new(x, y, z) * CFrame.Angles(0, math.pi, 0)
	local base = CFrame.new()
	local model = Instance.new("Model")
	model.Name = "TraderStall"
	local add = ModelFactory.addPart
	local wood = Color3.fromRGB(110, 78, 50)
	for _, c in { { -4, -2.5 }, { 4, -2.5 }, { -4, 2.5 }, { 4, 2.5 } } do
		add(model, { Name = "Post", Size = Vector3.new(0.6, 7, 0.6), CFrame = base * CFrame.new(c[1], 3.5, c[2]), Color = wood })
	end
	add(model, { Name = "Counter", Size = Vector3.new(9, 3, 2), CFrame = base * CFrame.new(0, 1.5, -2.2), Color = Color3.fromRGB(96, 68, 44), Material = Enum.Material.WoodPlanks })
	-- striped awning
	for i = 0, 4 do
		add(model, {
			Name = "Awning",
			Size = Vector3.new(1.9, 0.2, 6.6),
			CFrame = base * CFrame.new(-3.8 + i * 1.9, 7.3, 0) * CFrame.Angles(math.rad(-12), 0, 0),
			Color = i % 2 == 0 and Color3.fromRGB(160, 46, 40) or Color3.fromRGB(226, 214, 186),
			Material = Enum.Material.Fabric,
			CanCollide = false,
		})
	end
	-- goods on the counter
	add(model, { Name = "Crate", Size = Vector3.new(1.6, 1.4, 1.4), CFrame = base * CFrame.new(-3, 3.7, -2.2), Color = Color3.fromRGB(150, 110, 70) })
	add(model, { Name = "Pelts", Size = Vector3.new(2.4, 0.4, 1.4), CFrame = base * CFrame.new(0, 3.2, -2.2), Color = Color3.fromRGB(140, 96, 60), Material = Enum.Material.Fabric })
	add(model, { Name = "Silver", Size = Vector3.new(1.2, 0.5, 1.2), CFrame = base * CFrame.new(3, 3.25, -2.2), Color = Color3.fromRGB(220, 220, 230), Material = Enum.Material.Foil })
	-- the mesh stall, if there is one, replaces the block-built one
	local mesh = ModelFactory.meshFor("TraderStall", model)
	if mesh then
		local counter = model:FindFirstChild("Counter")
		for _, d in model:GetChildren() do
			if d ~= counter then
				d:Destroy()
			end
		end
		-- keep an invisible counter for the trade prompt
		if counter then
			counter.Transparency = 1
			counter.CanCollide = false
		end
		for _, d in mesh:GetChildren() do
			d.Parent = model
		end
		mesh:Destroy()
	end
	-- Ottar stands behind the counter, looking out over it at his customers
	local trader = ModelFactory.villager("Ottar the Trader", false, Random.new(index), "elder", 2)
	local offset = trader:GetAttribute("GroundOffset") or 2
	trader:PivotTo(base * CFrame.new(0, offset, 0.9))
	trader.Parent = model
	model.WorldPivot = CFrame.new()
	model:PivotTo(world)
	model.Parent = workspace

	local anchor = model:FindFirstChild("Counter")
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Trade"
	prompt.ObjectText = "Ottar's stall"
	prompt.HoldDuration = 0.3
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.Parent = anchor
	prompt.Triggered:Connect(function(player)
		Remotes.OpenTrade:FireClient(player)
	end)
	stalls[index] = Vector3.new(x, y, z)
end

function TradeService:Start()
	for i = 1, Config.MAX_PLOTS do
		buildStall(i)
	end
	Remotes.Trade.OnServerInvoke = function(player, i)
		return self:Trade(player, i)
	end
end

return TradeService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">VillageDefenseService</string>
            <string name="Source"><![CDATA[--[[
	VillageDefenseService
	Every few days (Config.VillageRaids) a warband from one of the rival
	holds raids YOUR village:
	  - you get a warning first, then they march in from the edge of your plot
	  - they head for your stores (Storehouse, or your Longhouse)
	  - Palisades are in the way: they have to stop and hack through (the
	    wall is down for a while, then your people put it back up)
	  - Watchtowers with an archer at work shoot them; you fight with your
	    Sword and Bow
	  - every raider who reaches the stores carries off a share and leaves
	Nothing is ever destroyed. Beat the whole warband for a reward.
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Grid = require(Shared.Grid)
local ModelFactory = require(Shared.ModelFactory)
local Sounds = require(Shared.Sounds)

local VillageDefenseService = {}

local VR = Config.VillageRaids
local services
local rng = Random.new()
local folder: Folder
local raids = {} -- [colony] = raid
local WALK_ANIM = "rbxassetid://507777826"

function VillageDefenseService:Init(allServices)
	services = allServices
	folder = Instance.new("Folder")
	folder.Name = "VillageRaiders"
	folder.Parent = workspace
end

local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

local function notify(colony, text: string, kind: string?)
	services.ColonyService:Notify(colony, text, kind)
end

-- Where the raiders are going: a storehouse, else any home.
local function storesOf(colony)
	local best
	for _, b in colony.buildings do
		if b.type == "Storehouse" then
			return b
		end
		if not best and Config.Buildings[b.type].Housing then
			best = b
		end
	end
	return best
end

local function spawnRaider(raid, pos: Vector3, holdName: string)
	local desc = Instance.new("HumanoidDescription")
	local skin = Color3.fromRGB(220, 182, 146)
	desc.HeadColor = skin
	desc.LeftArmColor = skin
	desc.RightArmColor = skin
	desc.TorsoColor = Color3.fromRGB(46, 52, 70)
	desc.LeftLegColor = Color3.fromRGB(50, 44, 38)
	desc.RightLegColor = Color3.fromRGB(50, 44, 38)
	local ok, model = pcall(function()
		return Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	end)
	if not ok or not model then
		warn("[VillageDefenseService] could not create raider: " .. tostring(model))
		return
	end
	model.Name = holdName .. " Raider"
	model:SetAttribute("Raider", true)
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	humanoid.DisplayName = holdName .. " Raider"
	humanoid.MaxHealth = VR.RaiderHealth
	humanoid.Health = VR.RaiderHealth
	humanoid.WalkSpeed = 12
	local head = model:FindFirstChild("Head")
	local hand = model:FindFirstChild("RightHand")
	local function gear(onto, name, size, offset, color, material, shape)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.Color = color
		p.Material = material or Enum.Material.Metal
		if shape then
			p.Shape = shape
		end
		p.CanCollide = false
		p.Massless = true
		p.CFrame = onto.CFrame * offset
		p.Parent = model
		local w = Instance.new("WeldConstraint")
		w.Part0 = onto
		w.Part1 = p
		w.Parent = p
	end
	if head then
		gear(head, "Helmet", Vector3.new(1.35, 0.7, 1.35), CFrame.new(0, 0.45, 0), Color3.fromRGB(70, 72, 78), Enum.Material.Metal, Enum.PartType.Ball)
	end
	if hand then
		gear(hand, "Haft", Vector3.new(0.25, 3.2, 0.25), CFrame.new(0, -0.6, -0.4) * CFrame.Angles(math.rad(90), 0, 0), Color3.fromRGB(110, 76, 46), Enum.Material.Wood)
		gear(hand, "AxeHead", Vector3.new(0.2, 1, 1.1), CFrame.new(0, 0.1, -1.9), Color3.fromRGB(120, 122, 130))
	end
	model:PivotTo(CFrame.new(pos + Vector3.new(0, 3, 0)))
	model.Parent = folder
	local root = model:FindFirstChild("HumanoidRootPart")
	if root then
		pcall(function()
			root:SetNetworkOwner(nil)
		end)
	end
	local animator = humanoid:FindFirstChildOfClass("Animator") or Instance.new("Animator", humanoid)
	local walkTrack
	pcall(function()
		local anim = Instance.new("Animation")
		anim.AnimationId = WALK_ANIM
		walkTrack = animator:LoadAnimation(anim)
	end)
	humanoid.Running:Connect(function(speed)
		if walkTrack then
			if speed > 0.5 and not walkTrack.IsPlaying then
				walkTrack:Play()
			elseif speed <= 0.5 and walkTrack.IsPlaying then
				walkTrack:Stop()
			end
		end
	end)
	local r = { model = model, humanoid = humanoid, root = root, lastHit = 0, lastPos = pos, stuckFor = 0 }
	humanoid.Died:Connect(function()
		r.dead = true
		task.delay(5, function()
			model:Destroy()
		end)
		VillageDefenseService:CheckBeaten(raid)
	end)
	table.insert(raid.raiders, r)
end

-- Raid lifecycle ----------------------------------------------------------------

local function endRaid(raid, text: string?, kind: string?)
	if raid.over then
		return
	end
	raid.over = true
	raids[raid.colony] = nil
	for _, r in raid.raiders do
		if not r.dead and r.model.Parent then
			r.model:Destroy()
		end
	end
	raid.colony.nextRaidDay = raid.colony.day + rng:NextInteger(VR.EveryDays[1], VR.EveryDays[2])
	if text then
		notify(raid.colony, text, kind)
	end
end

function VillageDefenseService:CheckBeaten(raid)
	if raid.over then
		return
	end
	local fought = 0
	for _, r in raid.raiders do
		if not r.dead and not r.fled then
			return
		end
		if r.dead then
			fought += 1
		end
	end
	local colony = raid.colony
	if fought > 0 and raid.stolen == 0 then
		for res, n in VR.Reward do
			services.ColonyService:Add(colony, res, n)
		end
		colony.happiness = math.min(100, colony.happiness + 8)
		services.QuestService:Count(colony, "defend")
		endRaid(raid, "The " .. raid.hold .. " warband is beaten! Your people cheer. +" .. Grid.costText(VR.Reward), "raid")
	elseif raid.stolen > 0 then
		endRaid(raid, "The raiders are gone, but they carried off some of your stores. Build Watchtowers and Palisades!", "bad")
	else
		endRaid(raid)
	end
end

local function steal(raid, r)
	local colony = raid.colony
	local taken = {}
	for _, res in Config.ResourceOrder do
		if res ~= "Lore" then
			local n = math.floor(math.min((colony.resources[res] or 0) * VR.StealShare, VR.StealCap))
			if n > 0 then
				colony.resources[res] -= n
				taken[res] = n
			end
		end
	end
	raid.stolen += 1
	r.fled = true
	notify(colony, "A raider reached your stores and ran off with " .. (next(taken) and Grid.costText(taken) or "nothing") .. "!", "bad")
	TweenService:Create(r.root, TweenInfo.new(0.6), { Transparency = 1 }):Play()
	task.delay(0.6, function()
		if r.model.Parent then
			r.model:Destroy()
		end
	end)
	services.ColonyService:Sync(colony)
	VillageDefenseService:CheckBeaten(raid)
end

-- A palisade in the way gets hacked down for a while (never destroyed).
local function breach(colony, near: Vector3): boolean
	for _, b in colony.buildings do
		if Config.Buildings[b.type].Wall and not b.breached and flat(b.center - near).Magnitude < 9 then
			b.breached = true
			for _, p in b.model:GetDescendants() do
				if p:IsA("BasePart") then
					p:SetAttribute("PreBreach", p.Transparency)
					p.Transparency = 0.75
					p.CanCollide = false
				end
			end
			notify(colony, "Raiders are hacking through your palisade!", "bad")
			task.delay(30, function()
				b.breached = false
				if b.model.Parent then
					for _, p in b.model:GetDescendants() do
						if p:IsA("BasePart") then
							p.Transparency = p:GetAttribute("PreBreach") or 0
							p.CanCollide = true
						end
					end
				end
			end)
			return true
		end
	end
	return false
end

local function startRaid(colony, hold)
	local count = math.min(VR.BaseRaiders + math.floor(colony.day / 4), VR.MaxRaiders)
	local raid = { colony = colony, raiders = {}, stolen = 0, hold = hold.Name, startedAt = os.clock() }
	raids[colony] = raid
	-- they come from the side of the plot nearest their hold
	local o = colony.origin
	local fromWest = hold.Center.X < o.X
	-- the middle of the gap beside the plot, clear of even the biggest land
	local x = fromWest and (o.X - Config.PLOT_GAP / 2) or (o.X + Grid.PLOT_SIZE + Config.PLOT_GAP / 2)
	for i = 1, count do
		local z = o.Z + Grid.PLOT_SIZE * 0.3 + i * 6
		local y = services.WorldService:GroundHeight(x, z)
		spawnRaider(raid, Vector3.new(x + rng:NextNumber(-3, 3), y, z), hold.Name)
	end
	Sounds.play("WarHorn", Vector3.new(x, o.Y, o.Z + Grid.PLOT_SIZE / 2))
	notify(colony, "RAID! " .. count .. " " .. hold.Name .. " raiders storm your village!", "raid")
end

-- Warbands march overland, so only the valley holds send them.
local landHolds = {}
for _, r in Config.Rivals do
	if not r.Sea then
		table.insert(landHolds, r)
	end
end

local function warnOf(colony)
	-- allies and holds paying you tribute don't raid you (DiplomacyService)
	local hostile = {}
	for _, r in landHolds do
		if not services.DiplomacyService or services.DiplomacyService:WillRaid(colony, r.Name) then
			table.insert(hostile, r)
		end
	end
	if #hostile == 0 then
		colony.nextRaidDay = colony.day + rng:NextInteger(VR.EveryDays[1], VR.EveryDays[2])
		return
	end
	local hold = hostile[rng:NextInteger(1, #hostile)]
	colony.raidWarned = true
	notify(colony, "Scouts report a " .. hold.Name .. " warband marching on your village! They arrive in " .. VR.WarningSeconds .. " seconds.", "raid")
	task.delay(VR.WarningSeconds, function()
		colony.raidWarned = false
		if colony.player.Parent and services.ColonyService:Get(colony.player) == colony then
			startRaid(colony, hold)
		end
	end)
end

-- Tick ------------------------------------------------------------------------

local function towerArrow(from: Vector3, to: Vector3)
	local arrow = ModelFactory.arrow()
	arrow.CFrame = CFrame.lookAt(from, to)
	arrow.Parent = workspace
	local flight = (to - from).Magnitude / 150
	TweenService:Create(arrow, TweenInfo.new(flight, Enum.EasingStyle.Linear), { CFrame = CFrame.lookAt(to, to + (to - from).Unit) }):Play()
	task.delay(flight + 2, function()
		arrow:Destroy()
	end)
	Sounds.play("Bow", from)
	return flight
end

local function tickRaid(raid, now: number, step: number)
	local colony = raid.colony
	if now - raid.startedAt > VR.LeaveAfter then
		for _, r in raid.raiders do
			r.fled = true
		end
		endRaid(raid, "The raiders lost heart and went home.", "info")
		return
	end
	local stores = storesOf(colony)
	local character = colony.player.Character
	local proot = character and character:FindFirstChild("HumanoidRootPart")
	local phum = character and character:FindFirstChildOfClass("Humanoid")

	for _, r in raid.raiders do
		if not r.dead and not r.fled and r.root then
			local pos = r.root.Position
			local goal = stores and stores.center or (colony.origin + Vector3.new(Grid.PLOT_SIZE / 2, 0, Grid.PLOT_SIZE / 2))
			local nearPlayer = proot and phum and phum.Health > 0 and (proot.Position - pos).Magnitude < 22
			if nearPlayer then
				r.humanoid:MoveTo(proot.Position)
				if (proot.Position - pos).Magnitude < 6 and now - r.lastHit > 1.2 then
					r.lastHit = now
					local dmg = VR.RaiderDamage * (services.ColonyService:Has(colony, "PathStorm") and 0.7 or 1)
					phum:TakeDamage(dmg)
				end
			else
				r.humanoid:MoveTo(goal)
				if flat(goal - pos).Magnitude < 11 then
					steal(raid, r)
					continue
				end
			end
			-- stuck against a wall? hack through it
			if (pos - r.lastPos).Magnitude < 0.6 * step * 4 then
				r.stuckFor += step
				if r.stuckFor > 2 and breach(colony, pos) then
					r.stuckFor = 0
				end
			else
				r.stuckFor = 0
			end
			r.lastPos = pos
		end
	end

	-- watchtowers with an archer at work shoot the nearest raider
	local manned = {}
	for _, v in colony.villagers do
		if v.job then
			manned[v.job] = true
		end
	end
	for id, b in colony.buildings do
		if b.type == "Watchtower" and manned[id] and now - (b.lastShot or 0) > VR.TowerCooldown then
			local top = b.center + Vector3.new(0, 15.5, 0)
			local target, best = nil, VR.TowerRange
			for _, r in raid.raiders do
				if not r.dead and not r.fled and r.root then
					local d = (r.root.Position - top).Magnitude
					if d < best then
						target, best = r, d
					end
				end
			end
			if target then
				b.lastShot = now
				local flight = towerArrow(top, target.root.Position)
				task.delay(flight, function()
					if not target.dead then
						target.humanoid:TakeDamage(VR.TowerDamage)
					end
				end)
			end
		end
	end
end

-- Combat hooks for ToolService -----------------------------------------------------

function VillageDefenseService:FindRaider(inst: Instance?): Model?
	while inst and inst ~= workspace do
		if inst:IsA("Model") and inst:GetAttribute("Raider") then
			return inst
		end
		inst = inst.Parent
	end
	return nil
end

function VillageDefenseService:RaidersNear(position: Vector3, look: Vector3, range: number)
	local found = {}
	for _, raid in raids do
		for _, r in raid.raiders do
			if not r.dead and not r.fled and r.root then
				local offset = flat(r.root.Position - position)
				if offset.Magnitude <= range and (offset.Magnitude < 2 or offset.Unit:Dot(flat(look).Unit) > 0.2) then
					table.insert(found, r.model)
				end
			end
		end
	end
	return found
end

-- The closest raider attacking `colony` (for the war band).
function VillageDefenseService:NearestRaider(colony, position: Vector3, range: number): (Model?, BasePart?)
	local raid = raids[colony]
	if not raid then
		return nil, nil
	end
	local best, bestRoot, bestD = nil, nil, range
	for _, r in raid.raiders do
		if not r.dead and not r.fled and r.root and r.root.Parent then
			local d = (r.root.Position - position).Magnitude
			if d < bestD then
				best, bestRoot, bestD = r.model, r.root, d
			end
		end
	end
	return best, bestRoot
end

function VillageDefenseService:DamageRaider(model: Model, amount: number)
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.Health > 0 then
		humanoid:TakeDamage(amount)
	end
end

function VillageDefenseService:Start()
	if not VR.Enabled then
		return
	end
	local last = os.clock()
	while true do
		task.wait(0.25)
		local now = os.clock()
		local step = now - last
		last = now
		for _, colony in services.ColonyService:All() do
			colony.nextRaidDay = colony.nextRaidDay or math.max(VR.FirstDay, colony.day + 2)
			local raid = raids[colony]
			if raid then
				tickRaid(raid, now, step)
			elseif not colony.raidWarned and colony.day >= colony.nextRaidDay then
				warnOf(colony)
			end
		end
	end
end

return VillageDefenseService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">VillagerService</string>
            <string name="Source"><![CDATA[--[[
	VillagerService
	Your people. Each villager is a record plus a small figure that walks
	around the plot. Every tick this service:
	  1. gives idle adults a job at a building with a free slot
	  2. lets workers produce resources
	  3. feeds everyone (and notices starvation)
	  4. moves happiness toward a target based on food and shelter
	  5. once per in-game day: villagers age (baby -> child -> adult ->
	     elder), single adults may marry and share a home, married couples
	     have babies, immigrants arrive from neighbouring tribes, or unhappy
	     villagers leave
	Families: a child is named after a parent (Astrid Bjornsdottir), keeps
	close to its parents while small, and lives in the family home.
	  6. moves the little figures around
]]

local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Grid = require(Shared.Grid)
local ModelFactory = require(Shared.ModelFactory)

local VillagerService = {}

local services
local rng = Random.new()
local V = Config.Villagers

function VillagerService:Init(allServices)
	services = allServices
end

-- Helpers -------------------------------------------------------------------

-- Where the ground really is under a point (the terrain surface can sit a
-- little above GROUND_Y), so villagers walk on it, not in it.
local function groundY(pos: Vector3): number
	local ws = services and services.WorldService
	if ws and ws.GroundHeight then
		return math.max(ws:GroundHeight(pos.X, pos.Z), Config.GROUND_Y)
	end
	return Config.GROUND_Y
end

local function counts(colony)
	local adults, children = 0, 0
	for _, v in colony.villagers do
		if v.isChild then
			children += 1
		else
			adults += 1
		end
	end
	return adults, children
end

local function clampToPlot(colony, pos: Vector3): Vector3
	local o, size = Grid.landRect(colony.origin, colony.land)
	return Vector3.new(math.clamp(pos.X, o.X + 2, o.X + size.X - 2), o.Y, math.clamp(pos.Z, o.Z + 2, o.Z + size.Z - 2))
end

-- A random spot just outside the edge of a building.
local function pointNear(colony, building): Vector3
	local hx = building.sx * Config.CELL / 2 + 2
	local hz = building.sz * Config.CELL / 2 + 2
	local p
	if rng:NextNumber() < 0.5 then
		p = building.center + Vector3.new(rng:NextNumber(-hx, hx), 0, (rng:NextNumber() < 0.5 and -hz or hz))
	else
		p = building.center + Vector3.new((rng:NextNumber() < 0.5 and -hx or hx), 0, rng:NextNumber(-hz, hz))
	end
	return clampToPlot(colony, p)
end

local function randomHome(colony)
	local homes = {}
	for _, b in colony.buildings do
		if Config.Buildings[b.type].Housing then
			table.insert(homes, b)
		end
	end
	if #homes == 0 then
		return nil
	end
	return homes[rng:NextInteger(1, #homes)]
end

local function stageOf(v): string
	if v.isChild then
		return (v.age < V.BabyDays) and "baby" or "child"
	end
	return (v.age >= V.ElderAge) and "elder" or "adult"
end

-- The villager's home building (kept with their family), picking one if needed.
local function homeOf(colony, v)
	local home = v.home and colony.buildings[v.home]
	if home then
		return home
	end
	local partner = v.partner and colony.villagers[v.partner]
	home = partner and partner.home and colony.buildings[partner.home]
	if not home and v.parents then
		for _, pid in v.parents do
			local parent = colony.villagers[pid]
			home = parent and parent.home and colony.buildings[parent.home]
			if home then
				break
			end
		end
	end
	home = home or randomHome(colony)
	v.home = home and home.id or nil
	return home
end

local function firstName(v): string
	return (string.split(v.name, " "))[1]
end

local function updateLabel(colony, v)
	local label = v.model:FindFirstChild("NameTag", true)
	label = label and label:FindFirstChild("Label")
	if not label then
		return
	end
	local stage = stageOf(v)
	local heart = v.partner and colony.villagers[v.partner] and " ♥" or ""
	if stage == "baby" or stage == "child" then
		label.Text = v.name .. " (" .. stage .. ")"
	elseif v.warrior then
		label.Text = v.name .. heart .. " (Warrior)"
	elseif v.job and colony.buildings[v.job] then
		label.Text = v.name .. heart .. " (" .. Config.Buildings[colony.buildings[v.job].type].Display .. ")"
	else
		label.Text = v.name .. heart .. (stage == "elder" and " (elder)" or "")
	end
end

local function makeModel(colony, v, groundPos: Vector3)
	if v.model then
		v.model:Destroy()
	end
	v.stage = stageOf(v)
	v.model = ModelFactory.villager(v.name, v.isChild, rng, v.stage, services.RankService:Rank(colony))
	v.body = v.model.PrimaryPart
	v.height = v.model:GetAttribute("GroundOffset") or v.body.Size.Y / 2
	v.model:PivotTo(CFrame.new(groundPos.X, groundY(groundPos), groundPos.Z) + Vector3.new(0, v.height, 0))
	if v.warrior then
		ModelFactory.armWarrior(v.model)
	end
	-- away on an expedition: the figure waits until they come home
	v.model.Parent = (not v.away) and colony.plot.Villagers or nil
	v.busyUntil = 0
	updateLabel(colony, v)
end

-- Builds a fresh figure for `v` where they stand (e.g. after leaving the war band).
function VillagerService:Rebuild(colony, v)
	local pos = v.body and (v.body.Position - Vector3.new(0, v.height or 0, 0)) or colony.origin
	makeModel(colony, v, pos)
end

-- Redraws the name tag (after a name or age is restored from a save).
function VillagerService:RefreshLabel(colony, v)
	updateLabel(colony, v)
end

-- Adding / removing ---------------------------------------------------------

function VillagerService:Add(colony, isChild: boolean, groundPos: Vector3?, name: string?, age: number?)
	local id = services.ColonyService:NewId(colony)
	local v = {
		id = id,
		name = name or Config.Names[rng:NextInteger(1, #Config.Names)],
		isChild = isChild,
		-- days lived here; newcomers arrive as grown adults
		age = age or (isChild and 0 or rng:NextInteger(4, 12)),
		job = nil,
	}
	if not groundPos then
		local home = randomHome(colony)
		groundPos = home and pointNear(colony, home) or colony.origin + Vector3.new(Grid.PLOT_SIZE / 2, 0, Grid.PLOT_SIZE / 2)
	end
	makeModel(colony, v, groundPos)
	colony.villagers[id] = v
	return v
end

function VillagerService:Remove(colony, v)
	colony.villagers[v.id] = nil
	local partner = v.partner and colony.villagers[v.partner]
	if partner then
		partner.partner = nil
		updateLabel(colony, partner)
	end
	if v.model then
		v.model:Destroy()
	end
end

function VillagerService:SpawnStarting(colony)
	local first = {}
	for i = 1, V.Starting do
		first[i] = self:Add(colony, false)
	end
	-- the first two settlers are a married couple
	if first[1] and first[2] then
		first[1].partner, first[2].partner = first[2].id, first[1].id
		local home = homeOf(colony, first[1])
		first[2].home = home and home.id or nil
		updateLabel(colony, first[1])
		updateLabel(colony, first[2])
	end
end

function VillagerService:OnBuildingRemoved(colony, buildingId: number)
	for _, v in colony.villagers do
		if v.job == buildingId then
			v.job = nil
			updateLabel(colony, v)
		end
	end
end

function VillagerService:Cleanup(colony)
	-- Models live inside the plot, which PlotService destroys.
	colony.villagers = {}
end

-- Simulation steps ------------------------------------------------------------

local function assignJobs(colony)
	local filled = {}
	for _, v in colony.villagers do
		if v.job and v.warrior then
			v.job = nil
		end
		if v.job then
			if colony.buildings[v.job] then
				filled[v.job] = (filled[v.job] or 0) + 1
			else
				v.job = nil
			end
		end
	end

	local openings = {}
	for id, b in colony.buildings do
		local slots = Config.Buildings[b.type].Workers or 0
		for _ = 1, slots - (filled[id] or 0) do
			table.insert(openings, id)
		end
	end
	table.sort(openings)

	for _, v in colony.villagers do
		if #openings == 0 then
			break
		end
		if not v.isChild and not v.job and not v.warrior then
			v.job = table.remove(openings, 1)
			v.busyUntil = 0 -- walk to work right away
			updateLabel(colony, v)
		end
	end
end

local function produce(colony, dt: number)
	local ColonyService = services.ColonyService
	local efficiency = 0.5 + colony.happiness / 200
	if colony.starving then
		efficiency *= 0.5
	end
	local workers = {}
	for _, v in colony.villagers do
		if v.job then
			workers[v.job] = (workers[v.job] or 0) + 1
		end
	end
	local season = services.SeasonService:Current()
	local blessing = services.RiteService and services.RiteService:Blessing(colony) or nil
	for id, b in colony.buildings do
		local produces = Config.Buildings[b.type].Produces
		local n = workers[id]
		if produces and n then
			for resource, rate in produces do
				-- crops only grow outside winter
				local seasonal = b.type == "Farm" and season.FarmRate or 1
				local bonus = 1
				if b.type == "Farm" and ColonyService:Has(colony, "CropRotation") then
					bonus *= 1.25
				elseif b.type == "Quarry" and ColonyService:Has(colony, "Masonry") then
					bonus *= 1.3
				elseif b.type == "Woodcutter" and ColonyService:Has(colony, "Woodcraft") then
					bonus *= 1.3
				elseif b.type == "LoreHall" and ColonyService:Has(colony, "SagaTellers") then
					bonus *= 1.5
				end
				if blessing then
					if b.type == "Farm" and blessing.Farm then
						bonus *= blessing.Farm
					elseif (b.type == "Woodcutter" or b.type == "Quarry") and blessing.Work then
						bonus *= blessing.Work
					end
				end
				ColonyService:Add(colony, resource, rate * n * dt * efficiency * seasonal * bonus)
			end
		end
	end
end

local function eat(colony, dt: number)
	local adults, children = counts(colony)
	local foodUse = services.SeasonService:Current().FoodUse
	if services.ColonyService:Has(colony, "MidwinterRite") then
		foodUse = 1
	end
	local blessing = services.RiteService and services.RiteService:Blessing(colony)
	if blessing and blessing.FoodUse then
		foodUse *= blessing.FoodUse
	end
	local need = (adults * V.FoodPerAdultPerSecond + children * V.FoodPerChildPerSecond) * dt * foodUse
	local food = colony.resources.Food or 0
	local wasStarving = colony.starving
	if food >= need then
		colony.resources.Food = food - need
		colony.starving = false
	else
		colony.resources.Food = 0
		colony.starving = need > 0
	end
	if colony.starving and not wasStarving then
		services.ColonyService:Notify(colony, "Your people are starving! Hold E on red berry bushes, hunt deer with the Bow (3), and build Barley Farms.", "bad")
	end
end

-- Winter hearths: each lived-in home burns firewood from the Wood store.
local function burnFirewood(colony, dt: number)
	local wasCold = colony.cold
	if services.SeasonService:Current().Name ~= "Winter" then
		colony.cold = false
		return
	end
	local homes = 0
	for _, b in colony.buildings do
		local def = Config.Buildings[b.type]
		if def and (def.Housing or 0) > 0 then
			homes += 1
		end
	end
	local adults, children = counts(colony)
	if homes == 0 or adults + children == 0 then
		colony.cold = false
		return
	end
	local need = homes * V.FirewoodPerHomePerSecond * dt
	if services.ColonyService:Has(colony, "TurfWalls") then
		need *= 0.5
	end
	local wood = colony.resources.Wood or 0
	if wood >= need then
		colony.resources.Wood = wood - need
		colony.cold = false
	else
		colony.resources.Wood = 0
		colony.cold = true
	end
	if colony.cold and not wasCold then
		services.ColonyService:Notify(colony, "Your hearths have gone cold! Homes burn Wood in winter. Chop trees (1) or build a Woodcutter.", "bad")
	end
end

local function updateHappiness(colony, dt: number)
	local adults, children = counts(colony)
	local pop = adults + children
	local housing = services.ColonyService:Housing(colony)
	local dailyFood = adults * V.FoodPerAdultPerSecond * Config.DAY_LENGTH

	local target = 55
	if colony.starving then
		target -= 45
	elseif (colony.resources.Food or 0) >= dailyFood * 2 then
		target += 15 -- two days of food in store
	end
	local homeless = math.max(0, pop - housing)
	target -= homeless * 8
	if colony.cold then
		target -= V.ColdHappiness
	end
	-- buildings and traits that cheer people up (each building type counts once)
	local cheered = {}
	for _, b in colony.buildings do
		local bonus = Config.Buildings[b.type].Happiness
		if bonus and not cheered[b.type] then
			cheered[b.type] = true
			target += bonus
		end
	end
	local ColonyService = services.ColonyService
	if ColonyService:Has(colony, "Feasting") then
		target += 10
	end
	if ColonyService:Has(colony, "PathHearth") then
		target += 10
	end
	-- feasts and blóts (RiteService)
	local Rites = services.RiteService
	if Rites then
		target += Rites:FeastBonus(colony)
		local blessing = Rites:Blessing(colony)
		if blessing and blessing.Happiness then
			target += blessing.Happiness
		end
	end
	target = math.clamp(target, 0, 100)

	colony.happiness += (target - colony.happiness) * math.min(1, 0.05 * dt)
	colony.homeless = homeless
end

local function blessingOf(colony)
	return (services.RiteService and services.RiteService:Blessing(colony)) or {}
end

local function newDay(self, colony)
	local ColonyService = services.ColonyService
	colony.day += 1

	-- Everyone ages: babies start walking, children come of age, adults grey.
	for _, v in colony.villagers do
		v.age += 1
		if v.isChild and v.age >= V.DaysToAdulthood then
			v.isChild = false
		end
		local stage = stageOf(v)
		if stage ~= v.stage then
			makeModel(colony, v, v.body.Position - Vector3.new(0, v.height, 0))
			if stage == "child" then
				ColonyService:Notify(colony, v.name .. " is toddling about on their own now.", "info")
			elseif stage == "adult" then
				ColonyService:Notify(colony, v.name .. " has come of age and can now work.", "good")
			elseif stage == "elder" then
				ColonyService:Notify(colony, v.name .. " is now one of the village elders.", "info")
			end
		end
	end

	-- Two single adults may marry and move into one home.
	if rng:NextNumber() < V.MarriageChancePerDay then
		local singles = {}
		for _, v in colony.villagers do
			if not v.isChild and not (v.partner and colony.villagers[v.partner]) then
				v.partner = nil
				table.insert(singles, v)
			end
		end
		if #singles >= 2 then
			local a = table.remove(singles, rng:NextInteger(1, #singles))
			local b = table.remove(singles, rng:NextInteger(1, #singles))
			a.partner, b.partner = b.id, a.id
			local home = homeOf(colony, a)
			b.home = home and home.id or nil
			updateLabel(colony, a)
			updateLabel(colony, b)
			ColonyService:Notify(colony, a.name .. " and " .. b.name .. " were wed! They share a home now.", "good")
		end
	end

	local adults, children = counts(colony)
	-- free beds, but never past the population cap of your rank
	local free = math.min(ColonyService:Housing(colony), services.RankService:PopCap(colony)) - adults - children
	local h = colony.happiness

	-- Unhappy people leave first.
	if h < V.LeaveBelowHappiness and adults > 1 then
		for _, v in colony.villagers do
			if not v.isChild then
				ColonyService:Notify(colony, v.name .. " was unhappy and left the settlement.", "bad")
				self:Remove(colony, v)
				break
			end
		end
		return
	end

	-- Births: a married couple has a baby, named after one of them.
	local couples = {}
	for _, v in colony.villagers do
		local partner = v.partner and colony.villagers[v.partner]
		if partner and v.id < partner.id and not v.isChild then
			table.insert(couples, { v, partner })
		end
	end
	if #couples > 0 and free > 0 and not colony.starving and h >= V.BirthMinHappiness and rng:NextNumber() < V.BirthChancePerDay * (ColonyService:Has(colony, "PathHearth") and 2 or 1) then
		local couple = couples[rng:NextInteger(1, #couples)]
		local namesake = couple[rng:NextInteger(1, 2)]
		local daughter = rng:NextNumber() < 0.5
		-- names alternate: odd ones are girls' names, even ones boys'
		local pick = rng:NextInteger(0, #Config.Names // 2 - 1) * 2 + (daughter and 1 or 2)
		local name = Config.Names[pick] .. " " .. firstName(namesake) .. (daughter and "sdottir" or "sson")
		local home = homeOf(colony, couple[1])
		local spawnAt = couple[1].body and (couple[1].body.Position - Vector3.new(0, couple[1].height, 0)) or nil
		local v = self:Add(colony, true, spawnAt, name)
		v.parents = { couple[1].id, couple[2].id }
		v.home = home and home.id or nil
		free -= 1
		ColonyService:Notify(colony, couple[1].name .. " and " .. couple[2].name .. " had a baby: " .. name .. "!", "good")
	end

	-- Immigration from neighbouring tribes.
	if free > 0 and not colony.starving and h >= V.ImmigrationMinHappiness and rng:NextNumber() < V.ImmigrationChancePerDay * (blessingOf(colony).Immigration or 1) then
		local maxGroup = V.ImmigrationMaxGroup * (ColonyService:Has(colony, "OpenArms") and 2 or 1)
		local n = rng:NextInteger(1, math.min(maxGroup, free))
		local tribe = Config.Tribes[rng:NextInteger(1, #Config.Tribes)]
		local arrival = colony.origin + Vector3.new(rng:NextNumber(10, Grid.PLOT_SIZE - 10), 0, -4)
		for _ = 1, n do
			self:Add(colony, false, arrival + Vector3.new(rng:NextNumber(-3, 3), 0, 0))
		end
		ColonyService:Notify(colony, n .. (n == 1 and " settler" or " settlers") .. " from the " .. tribe .. " joined you.", "good")
	elseif free <= 0 and h >= V.ImmigrationMinHappiness then
		ColonyService:Notify(colony, "Travellers passed by, but you had no free housing. Build a longhouse!", "info")
	end
end

-- What a worker visibly does at each workplace, and what they carry away.
local WORK = {
	Woodcutter = { task = "Chop", carry = "Log" },
	Quarry = { task = "Mine", carry = "Stone" },
	Farm = { task = "Farm", carry = "Sack" },
	Smithy = { task = "Hammer" },
	Shipyard = { task = "Hammer", carry = "Log" },
	HuntingLodge = { task = "Hammer", carry = "Hide" },
	Fishery = { task = "Farm", carry = "Sack" },
	Brewhouse = { task = "Hammer", carry = "Sack" },
}

-- Where goods are taken: the storehouse, or else the biggest hall.
local function storeOf(colony)
	local best
	for _, b in colony.buildings do
		if b.type == "Storehouse" then
			return b
		elseif (b.type == "GreatHall" or b.type == "Longhouse") and not best then
			best = b
		end
	end
	return best
end

local function walk(colony, v, now: number)
	if now < v.busyUntil or not v.body then
		return
	end
	local target
	local facing -- where to look on arrival
	local work, carry
	local job = v.job and colony.buildings[v.job]
	local stage = v.stage or stageOf(v)
	-- little ones stay close to a parent
	local parent
	if stage == "baby" or stage == "child" then
		for _, pid in v.parents or {} do
			local p = colony.villagers[pid]
			if p and p.body and (not parent or rng:NextNumber() < 0.5) then
				parent = p
			end
		end
	end
	if parent and rng:NextNumber() < (stage == "baby" and 0.9 or 0.55) then
		target = clampToPlot(colony, parent.body.Position + Vector3.new(rng:NextNumber(-4, 4), 0, rng:NextNumber(-4, 4)))
	elseif job and v.atJob and WORK[job.type] and WORK[job.type].carry and storeOf(colony) and rng:NextNumber() < 0.45 then
		-- haul what they made to the store
		target = pointNear(colony, storeOf(colony))
		carry = WORK[job.type].carry
	elseif job and rng:NextNumber() < 0.85 then
		if job.type == "Farm" then
			-- out among the crop rows
			local h = job.sx * Config.CELL / 2 - 2.5
			target = job.center + Vector3.new(rng:NextNumber(-h, h), 0, rng:NextNumber(-h, h))
		else
			target = pointNear(colony, job)
		end
		facing = job.center
		work = WORK[job.type] and WORK[job.type].task
	else
		local home = homeOf(colony, v)
		local wander = stage == "child" and 30 or (stage == "baby" and 6 or 20)
		if home and rng:NextNumber() < 0.7 then
			target = pointNear(colony, home)
		else
			target = clampToPlot(colony, v.body.Position + Vector3.new(rng:NextNumber(-wander, wander), 0, rng:NextNumber(-wander, wander)))
		end
	end

	-- the client animates these: working while standing, carrying while walking
	v.atJob = work ~= nil
	if v.model then
		v.model:SetAttribute("Task", work)
		v.model:SetAttribute("Carry", carry)
	end

	local from = v.body.Position
	local to = Vector3.new(target.X, groundY(target) + v.height, target.Z)
	local flat = Vector3.new(to.X - from.X, 0, to.Z - from.Z)
	local dist = flat.Magnitude
	if dist < 1 then
		v.busyUntil = now + 2
		return
	end
	local speed = V.WalkSpeed * (({ baby = 0.45, child = 1.25, elder = 0.7 })[stage] or 1)
	local duration = dist / speed
	local look = flat
	if facing then
		local toward = Vector3.new(facing.X - to.X, 0, facing.Z - to.Z)
		if toward.Magnitude > 0.5 then
			look = toward
		end
	end
	v.body.CFrame = CFrame.lookAt(from, from + flat)
	local tween = TweenService:Create(v.body, TweenInfo.new(duration, Enum.EasingStyle.Linear), { CFrame = CFrame.lookAt(to, to + flat) })
	tween:Play()
	if look ~= flat then
		-- turn to face the work once there
		tween.Completed:Connect(function(state)
			if state == Enum.PlaybackState.Completed and v.body and v.body.Parent then
				TweenService:Create(v.body, TweenInfo.new(0.4), { CFrame = CFrame.lookAt(to, to + look) }):Play()
			end
		end)
	end
	-- workers linger at their job; others idle a while
	v.busyUntil = now + duration + rng:NextNumber(job and 3 or 2, job and 8 or 6)
end

function VillagerService:Tick(colony, dt: number)
	assignJobs(colony)
	produce(colony, dt)
	eat(colony, dt)
	burnFirewood(colony, dt)
	updateHappiness(colony, dt)

	colony.dayTimer += dt
	if colony.dayTimer >= Config.DAY_LENGTH then
		colony.dayTimer -= Config.DAY_LENGTH
		newDay(self, colony)
	end

	local now = os.clock()
	for _, v in colony.villagers do
		if not v.warrior then -- the war band moves itself (WarbandService)
			walk(colony, v, now)
		end
	end
end

return VillagerService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">WarbandService</string>
            <string name="Source"><![CDATA[--[[
	WarbandService
	Hire grown villagers as warriors (Config.Warband). A warrior stops working
	and joins your war band. The band has three orders:
	  home    they drill around the village and fight raiders who come
	  follow  they walk with you, fight whatever you fight, and crew your
	          longship (faster rowing, more arrows per volley)
	  away    an expedition: they march (or sail) off to a rival hold on their
	          own and come back with loot and a report, so you can stay home
	          and build
	Warriors are villagers with v.warrior = true, so they are saved with
	everyone else and still eat. A warrior who falls is gone for good.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Grid = require(Shared.Grid)
local Remotes = require(Shared.Remotes)
local Sounds = require(Shared.Sounds)
local ModelFactory = require(Shared.ModelFactory)

local WarbandService = {}

local W = Config.Warband
local services
local rng = Random.new()

function WarbandService:Init(all)
	services = all
end

local function band(colony)
	colony.warband = colony.warband or { mode = "home" }
	return colony.warband
end

local function warriors(colony)
	local list = {}
	for _, v in colony.villagers do
		if v.warrior then
			table.insert(list, v)
		end
	end
	table.sort(list, function(a, b)
		return a.id < b.id
	end)
	return list
end
WarbandService.Warriors = function(_, colony)
	return warriors(colony)
end

function WarbandService:Max(colony): number
	return W.MaxByRank[services.RankService:Rank(colony)] or W.MaxByRank[#W.MaxByRank]
end

local function maxHealth(colony): number
	return W.Health + (services.ColonyService:Has(colony, "ChainMail") and 40 or 0)
end

local function blowDamage(colony): number
	local ColonyService = services.ColonyService
	return W.Damage + (ColonyService:Has(colony, "SteelEdges") and 8 or (ColonyService:Has(colony, "IronAxes") and 4 or 0))
end

-- How strong one warrior is on an expedition.
function WarbandService:WarriorPower(colony): number
	local ColonyService = services.ColonyService
	local p = W.WarriorPower
	for _, t in { "ChainMail", "IronAxes", "SteelEdges" } do
		if ColonyService:Has(colony, t) then
			p += 1
		end
	end
	return p
end

-- The whole band's strength (counted whether home or following).
function WarbandService:Power(colony): number
	local n = 0
	for _, v in warriors(colony) do
		if not v.away then
			n += 1
		end
	end
	return n * self:WarriorPower(colony)
end

-- A hold's strength, to weigh an expedition (or a tribute demand) against.
function WarbandService:HoldPower(def): number
	return def.Defenders * 2 + def.Archers * 2
end

local function holdNamed(name: string)
	for _, def in Config.Rivals do
		if def.Name == name then
			return def
		end
	end
	return nil
end

local function relabel(colony, v)
	services.VillagerService:RefreshLabel(colony, v)
end

-- Hiring and dismissing --------------------------------------------------------

function WarbandService:Hire(colony): (boolean, string)
	local ColonyService = services.ColonyService
	local list = warriors(colony)
	if #list >= self:Max(colony) then
		return false, "Your rank allows " .. self:Max(colony) .. " warriors. Rise in rank for more."
	end
	if band(colony).mode == "away" then
		return false, "Wait until the war band is home."
	end
	-- the youngest grown villager without a family to look after is keenest
	local pick
	for _, v in colony.villagers do
		if not v.isChild and not v.warrior and v.stage ~= "elder" then
			if not pick or (v.job == nil and pick.job ~= nil) or ((v.job == nil) == (pick.job == nil) and v.age < pick.age) then
				pick = v
			end
		end
	end
	if not pick then
		return false, "No grown villager is free to take up arms."
	end
	if not ColonyService:Spend(colony, W.HireCost) then
		return false, "Needs " .. Grid.costText(W.HireCost) .. "."
	end
	pick.warrior = true
	pick.job = nil
	pick.hp = maxHealth(colony)
	if pick.model then
		ModelFactory.armWarrior(pick.model)
	end
	relabel(colony, pick)
	Sounds.play("QuestDone", pick.body and pick.body.Position or nil)
	ColonyService:Notify(colony, pick.name .. " takes up axe and shield and joins your war band!", "good")
	ColonyService:Sync(colony)
	return true, pick.name .. " joined"
end

function WarbandService:Dismiss(colony): (boolean, string)
	if band(colony).mode == "away" then
		return false, "Wait until the war band is home."
	end
	local list = warriors(colony)
	local v = list[#list]
	if not v then
		return false, "You have no warriors."
	end
	v.warrior = nil
	v.hp = nil
	-- a fresh figure without the gear
	services.VillagerService:Rebuild(colony, v)
	services.ColonyService:Notify(colony, v.name .. " hangs up the axe and goes back to work.", "info")
	services.ColonyService:Sync(colony)
	return true, v.name .. " went back to work"
end

function WarbandService:SetMode(colony, mode: string): (boolean, string)
	if mode ~= "home" and mode ~= "follow" then
		return false, "Unknown order."
	end
	local b = band(colony)
	if b.mode == "away" then
		return false, "The war band is away on an expedition."
	end
	if #warriors(colony) == 0 then
		return false, "Hire some warriors first."
	end
	b.mode = mode
	for _, v in warriors(colony) do
		if v.model then
			v.model:SetAttribute("Guard", (mode == "follow" and b.formation == "wall") or nil)
		end
	end
	services.ColonyService:Notify(colony, mode == "follow" and "Your war band falls in behind you." or "Your war band stays to guard the village.", "info")
	services.ColonyService:Sync(colony)
	return true, mode
end

local FORMATIONS = { "loose", "wall", "wedge" }
local formationSpot, assaultGate
local F = Config.Formations

function WarbandService:SetFormation(colony, formation: string?): (boolean, string)
	local b = band(colony)
	if b.mode == "away" then
		return false, "The war band is away on an expedition."
	end
	if #warriors(colony) == 0 then
		return false, "Hire some warriors first."
	end
	if formation == nil or formation == "next" then
		-- cycle to the next one (the G key)
		local i = table.find(FORMATIONS, b.formation or "loose") or 1
		formation = FORMATIONS[i % #FORMATIONS + 1]
	end
	if not F[formation] then
		return false, "Unknown formation."
	end
	b.formation = formation
	if formation ~= "loose" then
		services.QuestService:Count(colony, "formation")
	end
	if b.mode ~= "follow" then
		b.mode = "follow"
	end
	for _, v in warriors(colony) do
		if v.model then
			v.model:SetAttribute("Guard", formation == "wall" or nil)
		end
	end
	Sounds.play("WarHorn", colony.player.Character and colony.player.Character:FindFirstChild("HumanoidRootPart") and colony.player.Character.HumanoidRootPart.Position or nil)
	local text = F[formation].Label .. "! Your war band forms " .. F[formation].Text .. "."
	services.ColonyService:Notify(colony, text, "info")
	services.ColonyService:Sync(colony)
	return true, F[formation].Label
end

-- Following and fighting ---------------------------------------------------------

local function groundY(x: number, z: number): number
	return services.WorldService:GroundHeight(x, z)
end

local function moveTo(v, target: Vector3, speed: number, dt: number)
	local from = v.body.Position
	local flat = Vector3.new(target.X - from.X, 0, target.Z - from.Z)
	local dist = flat.Magnitude
	if dist < 0.6 then
		return
	end
	local stepLen = math.min(dist, speed * dt)
	local nx, nz = from.X + flat.Unit.X * stepLen, from.Z + flat.Unit.Z * stepLen
	local to = Vector3.new(nx, math.max(groundY(nx, nz), 0.5) + v.height, nz)
	-- a short tween so the motion is smooth between our updates
	TweenService:Create(v.body, TweenInfo.new(dt, Enum.EasingStyle.Linear), { CFrame = CFrame.lookAt(to, to + flat) }):Play()
end

local function swing(v)
	for _, arm in v.model:GetChildren() do
		if arm.Name == "Arm" and arm:GetAttribute("Side") == 1 then
			local joint = arm:FindFirstChild("Joint")
			if joint and joint:IsA("Weld") then
				local rest = joint.C0
				local hip = arm:GetAttribute("Hip")
				local half = arm:GetAttribute("HalfLen") or 0.7
				if typeof(hip) == "CFrame" then
					joint.C0 = hip * CFrame.Angles(math.rad(-120), 0, 0) * CFrame.new(0, -half, 0)
					task.delay(0.2, function()
						if joint.Parent then
							joint.C0 = rest
						end
					end)
				end
			end
		end
	end
end

-- The nearest enemy of this colony to `pos`: rival guards, raiders attacking
-- the village, or militia in a town raid you started.
local function nearestEnemy(colony, pos: Vector3, range: number)
	local best, bestRoot, bestDmg = services.RaidService:NearestDefender(pos, range)
	local bestD = bestRoot and (bestRoot.Position - pos).Magnitude or range
	local kind = best and "defender"
	local m, root = services.VillageDefenseService:NearestRaider(colony, pos, bestD)
	if m and root then
		best, bestRoot, bestDmg, kind = m, root, Config.VillageRaids.RaiderDamage, "raider"
		bestD = (root.Position - pos).Magnitude
	end
	m, root = services.TownRaidService:NearestMilitia(colony.player, pos, bestD)
	if m and root then
		best, bestRoot, bestDmg, kind = m, root, Config.TownRaid.MilitiaDamage or 8, "militia"
	end
	return best, bestRoot, bestDmg, kind
end

local function hit(colony, kind: string, model: Model, amount: number)
	if kind == "defender" then
		services.RaidService:DamageDefender(model, amount, colony.player)
	elseif kind == "raider" then
		services.VillageDefenseService:DamageRaider(model, amount)
	elseif kind == "militia" then
		services.TownRaidService:DamageMilitia(model, amount, colony.player)
	end
end

local function fall(colony, v)
	services.ColonyService:Notify(colony, v.name .. " fell in battle. Their name will be sung in the hall.", "bad")
	services.VillagerService:Remove(colony, v)
end

-- One fighting step for a warrior near an enemy. Returns true if it fought.
-- `f` is the formation's settings: Sight, Speed, Damage, DamageTaken, and
-- Leash (how far from `anchor` they may chase; a shield wall holds its line).
local function fight(colony, v, now: number, dt: number, anchor: Vector3, f): boolean
	f = f or {}
	local sight = W.Sight * (f.Sight or 1)
	local leash = f.Leash or sight * 1.5
	local enemy, root, dmg, kind = nearestEnemy(colony, v.body.Position, sight)
	if not enemy or not root or (root.Position - anchor).Magnitude > leash then
		return false
	end
	local d = (root.Position - v.body.Position) * Vector3.new(1, 0, 1)
	if d.Magnitude > W.Reach then
		moveTo(v, root.Position - d.Unit * (W.Reach - 1.5), Config.Villagers.WalkSpeed * 2.4 * (f.Speed or 1), dt)
	else
		v.body.CFrame = CFrame.lookAt(v.body.Position, v.body.Position + d)
		if now - (v.lastBlow or 0) >= W.HitCooldown then
			v.lastBlow = now
			swing(v)
			Sounds.play("Swing", v.body.Position)
			hit(colony, kind, enemy, blowDamage(colony) * (f.Damage or 1))
		end
		-- the enemy hits back now and then
		if now - (v.lastHurt or 0) >= W.HitCooldown * 1.3 then
			v.lastHurt = now
			if rng:NextNumber() < 0.5 then
				v.hp = (v.hp or maxHealth(colony)) - (dmg or 10) * 0.6 * (f.DamageTaken or 1)
				if v.hp <= 0 then
					fall(colony, v)
				end
			end
		end
	end
	v.fighting = now
	return true
end

-- Places for the band on the deck of the player's longship.
local function deckSpot(ship, i: number): CFrame
	local side = (i % 2 == 0) and 1 or -1
	local row = math.floor((i - 1) / 2)
	local z = -ship.length * 0.28 + row * 4.5
	return ship.seat.CFrame * CFrame.new(side * 2.4, -0.2, z - ship.length * 0.32)
end

function WarbandService:CrewCount(player: Player): number
	local colony = services.ColonyService:Get(player)
	if not colony or band(colony).mode ~= "follow" then
		return 0
	end
	if not services.BoatService:ShipOf(player) then
		return 0
	end
	local n = 0
	for _, v in warriors(colony) do
		if not v.away then
			n += 1
		end
	end
	return n
end

function WarbandService:CrewBonus(player: Player): number
	return math.min(self:CrewCount(player) * W.CrewSpeed, W.CrewSpeedMax)
end

-- Where warrior i of n stands, around the player at `anchor` facing `look`.
formationSpot = function(formation: string, i: number, n: number, anchor: Vector3, look: Vector3, right: Vector3): Vector3
	if formation == "wall" then
		-- two ranks of shields in front of you, the second rank staggered
		local perRank = math.max(2, math.ceil(n / 2))
		local rank = (i - 1) // perRank
		local inRank = math.min(perRank, n - rank * perRank)
		local k = (i - 1) % perRank
		local offset = (k - (inRank - 1) / 2) * 3 + rank * 1.5
		return anchor + look * (5 - rank * 2.8) + right * offset
	elseif formation == "wedge" then
		-- the boar's snout: a point ahead of you, widening back
		local row = math.ceil(i / 2)
		local side = (i % 2 == 0) and 1 or -1
		return anchor + look * (5.5 - row * 2.6) + right * side * (1.2 + row * 2.2)
	end
	-- loose: a crowd at your back
	local row = math.ceil(i / 2)
	return anchor - look * (3 + row * 3) + right * ((i % 2 == 0) and 2.5 or -2.5) * row * 0.8
end

-- Near a rival gate with no one to fight: hack at the doors beside you.
assaultGate = function(colony, v, i: number, now: number, dt: number, root: BasePart, formation: string): boolean
	if formation == "wall" then
		return false
	end
	local gate = services.RaidService:GateNear(root.Position, 30)
	if not gate then
		return false
	end
	-- spread along the outside of the doors
	local sideOf = (root.Position - gate.position):Dot(gate.out) >= 0 and 1 or -1
	local slot = ((i - 1) % 6 - 2.5) / 2.5 * (gate.half - 1.5)
	local spot = gate.position + gate.out * (3 * sideOf) + gate.side * slot
	local d = (spot - v.body.Position) * Vector3.new(1, 0, 1)
	if d.Magnitude > 1.5 then
		moveTo(v, spot, Config.Villagers.WalkSpeed * 2.4 * (formation == "wedge" and Config.Formations.wedge.Speed or 1), dt)
	else
		v.body.CFrame = CFrame.lookAt(v.body.Position, v.body.Position - gate.out * sideOf)
		if now - (v.lastBlow or 0) >= W.HitCooldown then
			v.lastBlow = now
			swing(v)
			local ram = formation == "wedge" and Config.Siege.WedgeRam or 1
			services.RaidService:DamageGate(gate, blowDamage(colony) * ram, colony.player)
		end
	end
	v.fighting = now
	return true
end

local function stepColony(colony, now: number, dt: number)
	local b = band(colony)
	if b.mode == "away" then
		return
	end
	local list = warriors(colony)
	if #list == 0 then
		return
	end
	local player = colony.player
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local ship = b.mode == "follow" and services.BoatService:ShipOf(player)
	local heal = maxHealth(colony)

	for i, v in list do
		if not v.body or not v.model or not v.model.Parent then
			continue
		end
		local guard = (b.mode == "follow" and b.formation == "wall" and not ship) or nil
		if v.model:GetAttribute("Guard") ~= guard then
			v.model:SetAttribute("Guard", guard)
		end
		if now - (v.fighting or 0) > 4 and (v.hp or heal) < heal then
			v.hp = math.min(heal, (v.hp or heal) + W.HealPerSecond * dt)
		end
		if b.mode == "follow" and root then
			if ship then
				-- aboard: stand at the oars, riding with the ship
				v.body.CFrame = deckSpot(ship, i) * CFrame.new(0, v.height, 0)
				continue
			end
			local anchor = root.Position
			local look = root.CFrame.LookVector * Vector3.new(1, 0, 1)
			look = look.Magnitude > 0.1 and look.Unit or Vector3.new(0, 0, 1)
			local right = Vector3.new(-look.Z, 0, look.X)
			local formation = b.formation or "loose"
			local spot = formationSpot(formation, i, #list, anchor, look, right)
			local f = F[formation]
			local opts = { Sight = f.Sight, Speed = f.Speed, Damage = f.Damage, DamageTaken = f.DamageTaken }
			if formation == "wall" then
				-- hold the line: only strike what comes close to their place in it
				opts.Sight = (W.Reach + 6) / W.Sight
				opts.Leash = W.Reach + 8
			end
			if not fight(colony, v, now, dt, formation == "wall" and spot or anchor, opts) and not assaultGate(colony, v, i, now, dt, root, formation) then
				local far = (spot - v.body.Position).Magnitude
				if far > 120 then
					-- left far behind (you sailed off or respawned): catch up at once
					local y = math.max(groundY(spot.X, spot.Z), 0.5)
					v.body.CFrame = CFrame.new(spot.X, y + v.height, spot.Z)
				elseif far > 1.2 then
					moveTo(v, spot, (root.AssemblyLinearVelocity.Magnitude > 10 and 20 or Config.Villagers.WalkSpeed * 2) * (f.Speed or 1), dt)
				elseif formation == "wall" then
					-- shields to the front
					v.body.CFrame = CFrame.lookAt(v.body.Position, v.body.Position + look)
				end
			end
		else
			-- at home: guard the village, fight raiders who come in
			local corner, size = Grid.landRect(colony.origin, colony.land)
			local middle = corner + size / 2
			if not fight(colony, v, now, dt, middle) then
				v.homeWalk = v.homeWalk or 0
				if now > v.homeWalk then
					v.homeWalk = now + rng:NextNumber(4, 9)
					v.homeSpot = middle + Vector3.new(rng:NextNumber(-size.X * 0.4, size.X * 0.4), 0, rng:NextNumber(-size.Z * 0.45, -size.Z * 0.2))
				end
				if v.homeSpot and (v.homeSpot - v.body.Position).Magnitude > 120 then
					v.body.CFrame = CFrame.new(v.homeSpot + Vector3.new(0, v.height, 0))
				elseif v.homeSpot then
					moveTo(v, v.homeSpot, Config.Villagers.WalkSpeed, dt)
				end
			end
		end
	end
end

-- Expeditions ------------------------------------------------------------------

function WarbandService:Expedition(colony, holdName: string): (boolean, string)
	local ColonyService = services.ColonyService
	local b = band(colony)
	if b.mode == "away" then
		return false, "The war band is already away."
	end
	local def = typeof(holdName) == "string" and holdNamed(holdName)
	if not def then
		return false, "Pick a hold to raid."
	end
	local list = warriors(colony)
	if #list == 0 then
		return false, "Hire some warriors first."
	end
	if def.Sea and not ColonyService:Has(colony, "Karve") then
		return false, def.Name .. " is across the water: research Karve first."
	end
	if services.DiplomacyService and services.DiplomacyService:IsAllied(colony, def.Name) then
		return false, def.Name .. " is your ally."
	end
	local seconds = def.Sea and W.SeaExpeditionSeconds or W.ExpeditionSeconds
	b.mode = "away"
	b.target = def.Name
	b.returnAt = os.clock() + seconds
	b.seconds = seconds
	b.power = #list * self:WarriorPower(colony)
	for _, v in list do
		v.away = true
		if v.model then
			v.model.Parent = nil
		end
	end
	-- raiding them sours the mood straight away
	if services.DiplomacyService then
		services.DiplomacyService:OnHostile(colony, def.Name)
	end
	Sounds.play("WarHorn", colony.origin + Vector3.new(Grid.PLOT_SIZE / 2, 0, 0))
	ColonyService:Notify(colony, "Your war band of " .. #list .. " " .. (def.Sea and "sails" or "marches") .. " for " .. def.Name .. ". Back in about " .. math.floor(seconds / 60 + 0.5) .. " minutes.", "raid")
	ColonyService:Sync(colony)
	return true, "Off they go"
end

local function finishExpedition(colony)
	local ColonyService = services.ColonyService
	local b = band(colony)
	local def = holdNamed(b.target or "") or Config.Rival
	local list = {}
	for _, v in warriors(colony) do
		if v.away then
			table.insert(list, v)
		end
	end
	local ratio = (b.power or 0) / WarbandService:HoldPower(def)
	local won = rng:NextNumber() < math.clamp(ratio * 0.75, 0.05, 0.95)

	-- losses
	local deathChance = math.clamp(0.3 - 0.2 * ratio, 0.03, 0.3) * (won and 1 or 2)
	local fallen, wounded = {}, {}
	local heal = maxHealth(colony)
	for _, v in list do
		v.away = nil
		if rng:NextNumber() < deathChance then
			table.insert(fallen, v.name)
			services.VillagerService:Remove(colony, v)
		else
			if rng:NextNumber() < 0.4 then
				v.hp = heal * rng:NextNumber(0.3, 0.7)
				table.insert(wounded, v.name)
			end
			if v.model then
				v.model.Parent = colony.plot.Villagers
				local arrive = colony.origin + Vector3.new(Grid.PLOT_SIZE / 2 + rng:NextNumber(-8, 8), 0, -6)
				v.body.CFrame = CFrame.new(arrive + Vector3.new(0, v.height, 0))
			end
		end
	end

	-- loot
	local loot = {}
	local share = won and W.LootShare * math.clamp(ratio, 0.6, 1.25) or 0.2
	if #list - #fallen <= 0 then
		share = 0 -- nobody came back to carry it
	end
	if ColonyService:Has(colony, "SeaRaiders") and def.Sea then
		share *= 1.5
	end
	for res, base in def.ChestLoot do
		local n = math.floor(base * share)
		if n > 0 then
			loot[res] = n
			ColonyService:Add(colony, res, n)
		end
	end
	if won then
		services.QuestService:Count(colony, "plunder")
	end

	b.mode = "home"
	b.target = nil
	b.returnAt = nil
	local report = {
		hold = def.Name,
		won = won,
		sent = #list,
		loot = loot,
		fallen = fallen,
		wounded = wounded,
	}
	Remotes.WarReport:FireClient(colony.player, report)
	local lootText = next(loot) and Grid.costText(loot) or "nothing"
	ColonyService:Notify(colony, (won and "Victory! " or "Beaten back! ") .. "Your war band is home from " .. def.Name .. " with " .. lootText .. ".", won and "good" or "bad")
	ColonyService:Sync(colony)
end

function WarbandService:State(colony)
	local b = band(colony)
	local list = warriors(colony)
	local heal = maxHealth(colony)
	local members = {}
	for _, v in list do
		table.insert(members, { name = v.name, hp = math.floor(((v.hp or heal) / heal) * 100 + 0.5), away = v.away == true })
	end
	local targets = {}
	for _, def in Config.Rivals do
		local hp = self:HoldPower(def)
		table.insert(targets, {
			name = def.Name,
			sea = def.Sea == true,
			power = hp,
			chance = math.floor(math.clamp((#list * self:WarriorPower(colony)) / hp * 0.75, 0.05, 0.95) * 100),
			allied = services.DiplomacyService and services.DiplomacyService:IsAllied(colony, def.Name) or false,
		})
	end
	return {
		mode = b.mode,
		formation = b.formation or "loose",
		target = b.target,
		secondsLeft = b.returnAt and math.max(0, math.floor(b.returnAt - os.clock())) or nil,
		count = #list,
		max = self:Max(colony),
		power = #list * self:WarriorPower(colony),
		members = members,
		targets = targets,
		hireCost = W.HireCost,
	}
end

function WarbandService:Start()
	Players.PlayerRemoving:Connect(function(player)
		local colony = services.ColonyService:Get(player)
		if colony and band(colony).mode == "away" then
			-- they come home safe (and empty-handed) so the save keeps them
			for _, v in warriors(colony) do
				v.away = nil
			end
			band(colony).mode = "home"
		end
	end)

	local last = os.clock()
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc < 0.25 then
			-- on a ship they need to ride smoothly, every frame
			for _, colony in services.ColonyService:All() do
				local b = colony.warband
				if b and b.mode == "follow" then
					local ship = services.BoatService:ShipOf(colony.player)
					if ship then
						for i, v in warriors(colony) do
							if v.body and not v.away then
								v.body.CFrame = deckSpot(ship, i) * CFrame.new(0, v.height, 0)
							end
						end
					end
				end
			end
			return
		end
		local now = os.clock()
		local step = now - last
		last = now
		acc = 0
		for _, colony in services.ColonyService:All() do
			local ok, err = pcall(function()
				local b = band(colony)
				if b.mode == "away" and b.returnAt and now >= b.returnAt then
					finishExpedition(colony)
				else
					stepColony(colony, now, step)
				end
			end)
			if not ok then
				warn("[WarbandService] " .. tostring(err))
			end
		end
	end)
end

return WarbandService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">WeatherService</string>
            <string name="Source"><![CDATA[--[[
	WeatherService
	Picks the weather every few minutes (Config.Weather): Clear, Fog or Storm.
	It sets workspace attributes that everything else reads:
	  Weather     "Clear" | "Fog" | "Storm"  (what it is turning into)
	  FogLevel    0..1, eases in and out over RampSeconds
	  StormLevel  0..1, eases in and out over RampSeconds
	WorldService thickens the haze and darkens the clouds from these,
	BoatService slows ships in storms and blinds the raider in fog, and the
	client (WeatherFxController) draws rain, lightning and thunder.
]]

local Lighting = game:GetService("Lighting")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)

local WeatherService = {}

local W = Config.Weather
local services
local rng = Random.new()

local MESSAGES = {
	Clear = { "The skies clear over the fjord.", "info" },
	Fog = { "A fog bank rolls in off the sea. Ships can slip past the raiders unseen.", "info" },
	Storm = { "A sea storm is coming! Ships will be slowed and tossed about.", "bad" },
}

function WeatherService:Init(all)
	services = all
	workspace:SetAttribute("Weather", "Clear")
	workspace:SetAttribute("FogLevel", 0)
	workspace:SetAttribute("StormLevel", 0)
end

local function pick(current: string): string
	-- never the same twice in a row, so there is always something to notice
	local total = 0
	for name, chance in W.Chances do
		if name ~= current then
			total += chance
		end
	end
	local roll = rng:NextNumber() * total
	for name, chance in W.Chances do
		if name ~= current then
			roll -= chance
			if roll <= 0 then
				return name
			end
		end
	end
	return "Clear"
end

function WeatherService:Set(name: string)
	workspace:SetAttribute("Weather", name)
	local msg = MESSAGES[name]
	if msg and services.ColonyService then
		for _, colony in services.ColonyService:All() do
			services.ColonyService:Notify(colony, msg[1], msg[2])
		end
	end
end

-- How much the weather slows ships (1 = not at all).
function WeatherService:ShipSpeed(): number
	return 1 - (1 - W.StormShipSpeed) * (workspace:GetAttribute("StormLevel") or 0)
end

-- How far the raider ship can see, as a share of its normal range.
function WeatherService:Sight(): number
	return 1 - (1 - W.FogRaiderSight) * (workspace:GetAttribute("FogLevel") or 0)
end

function WeatherService:Start()
	local nextChange = os.clock() + W.FirstChangeSeconds
	local fog, storm = 0, 0
	local clouds = workspace.Terrain:FindFirstChildOfClass("Clouds")
	while true do
		local dt = task.wait(0.25)
		if os.clock() >= nextChange then
			self:Set(pick(workspace:GetAttribute("Weather") or "Clear"))
			nextChange = os.clock() + rng:NextNumber(W.MinSeconds, W.MaxSeconds)
		end
		local now = workspace:GetAttribute("Weather")
		local step = dt / W.RampSeconds
		local function toward(v: number, goal: number): number
			if v < goal then
				return math.min(goal, v + step)
			end
			return math.max(goal, v - step)
		end
		fog = toward(fog, now == "Fog" and 1 or 0)
		storm = toward(storm, now == "Storm" and 1 or 0)
		workspace:SetAttribute("FogLevel", math.floor(fog * 100 + 0.5) / 100)
		workspace:SetAttribute("StormLevel", math.floor(storm * 100 + 0.5) / 100)

		-- the sea and sky (haze and light are handled in WorldService's day cycle)
		workspace.Terrain.WaterWaveSize = 0.16 + storm * 0.5
		workspace.Terrain.WaterWaveSpeed = 9 + storm * 14
		clouds = clouds or workspace.Terrain:FindFirstChildOfClass("Clouds")
		if clouds then
			clouds.Cover = 0.55 + storm * 0.4 + fog * 0.2
			clouds.Density = 0.55 + storm * 0.4
			clouds.Color = Color3.fromRGB(245, 240, 232):Lerp(Color3.fromRGB(90, 96, 108), storm)
		end
		Lighting.EnvironmentDiffuseScale = 1 - storm * 0.4
	end
end

return WeatherService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">WildlifeService</string>
            <string name="Source"><![CDATA[--[[
	WildlifeService
	Deer graze in the meadow behind each plot. They wander slowly and bolt
	when a player comes close, so you hunt them with the Bow from a distance.
	A deer gives meat (Food) and Hides, then a new one wanders in later.
	In winter a wolf pack prowls the meadow behind each settled plot. Wolves
	slink closer when you are near and circle you at a distance; shoot one
	for its pelt (Hides). They leave when winter ends.
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Grid = require(Shared.Grid)
local ModelFactory = require(Shared.ModelFactory)

local WildlifeService = {}

local W = Config.Wildlife
local services
local rng = Random.new()
local folder: Folder
local herd = {} -- [model] = deer record
local nextId = 0

local _, _, _, LAND_MAX_Z = Grid.maxBounds()
local MEADOW_MIN_Z, MEADOW_MAX_Z = LAND_MAX_Z * Config.CELL + 16, Grid.PLOT_SIZE + 135

function WildlifeService:Init(allServices)
	services = allServices
end

local function areaFor(index: number)
	local o = Grid.plotOrigin(index)
	return { minX = o.X - 16, maxX = o.X + Grid.PLOT_SIZE + 16, minZ = MEADOW_MIN_Z, maxZ = MEADOW_MAX_Z, plot = index }
end

local function clampToArea(area, x: number, z: number): (number, number)
	return math.clamp(x, area.minX, area.maxX), math.clamp(z, area.minZ, area.maxZ)
end

local STEP = 5 -- studs per leg of a walk, so the deer follows hills and dips

-- Walks the deer to (x, z) in short legs, each one set on the ground, so it
-- never cuts through a hill or floats over a hollow. Returns the total time.
local function moveTo(deer, x: number, z: number, speed: number)
	local body = deer.body
	local from = body.Position
	local flat = Vector3.new(x - from.X, 0, z - from.Z)
	if flat.Magnitude < 1 then
		return 0
	end
	local legs = math.max(1, math.ceil(flat.Magnitude / STEP))
	local legTime = flat.Magnitude / legs / speed
	if deer.tween then
		deer.tween:Cancel()
	end
	deer.walk = (deer.walk or 0) + 1
	local walk = deer.walk
	local dir = flat.Unit
	task.spawn(function()
		for i = 1, legs do
			if deer.walk ~= walk or not body.Parent then
				return
			end
			local p = Vector3.new(from.X, 0, from.Z) + flat * (i / legs)
			local y = services.WorldService:GroundHeight(p.X, p.Z) + deer.offset
			local to = Vector3.new(p.X, y, p.Z)
			deer.tween = TweenService:Create(body, TweenInfo.new(legTime, Enum.EasingStyle.Linear), { CFrame = CFrame.lookAt(to, to + dir) })
			deer.tween:Play()
			task.wait(legTime)
		end
	end)
	return legTime * legs
end

function WildlifeService:Spawn(area)
	nextId += 1
	local model = ModelFactory.deer(rng)
	model:SetAttribute("DeerId", nextId)
	local x = rng:NextNumber(area.minX, area.maxX)
	local z = rng:NextNumber(area.minZ, area.maxZ)
	local offset = model:GetAttribute("GroundOffset")
	model:PivotTo(CFrame.new(x, services.WorldService:GroundHeight(x, z) + offset, z) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0))
	model.Parent = folder

	herd[model] = {
		model = model,
		body = model.PrimaryPart,
		offset = offset,
		area = area,
		busyUntil = 0,
	}
end

-- Called by ToolService when an arrow hits a deer.
function WildlifeService:Kill(model: Model, hunter: Player)
	local deer = herd[model]
	if not deer then
		return
	end
	herd[model] = nil
	deer.walk = (deer.walk or 0) + 1
	if deer.tween then
		deer.tween:Cancel()
	end
	-- topple over, then vanish
	deer.body.CFrame = deer.body.CFrame * CFrame.new(0, -1.2, 0) * CFrame.Angles(0, 0, math.pi / 2)
	task.delay(2, function()
		model:Destroy()
	end)

	local ColonyService = services.ColonyService
	local colony = ColonyService:Get(hunter)
	if deer.wolf then
		if colony then
			ColonyService:Add(colony, "Hides", W.WolfHides)
			services.QuestService:Count(colony, "wolf")
			ColonyService:Notify(colony, "A wolf brought down! +" .. W.WolfHides .. " Hides", "gain")
			ColonyService:Sync(colony)
		end
		return
	end
	if colony then
		local mult = ColonyService:Has(colony, "PathWoods") and 2 or 1
		ColonyService:Add(colony, "Food", W.Meat * mult)
		ColonyService:Add(colony, "Hides", W.Hides * mult)
		services.QuestService:Count(colony, "deer")
		ColonyService:Notify(colony, "Deer hunted! +" .. W.Meat * mult .. " Food, +" .. W.Hides * mult .. " Hides", "gain")
		ColonyService:Sync(colony)
	end

	task.delay(W.RespawnSeconds, function()
		self:Spawn(deer.area)
	end)
end

local function spawnWolf(area)
	nextId += 1
	local model = ModelFactory.wolf(rng)
	model:SetAttribute("DeerId", nextId) -- so arrows find it like a deer
	model:SetAttribute("Wolf", true)
	local x = rng:NextNumber(area.minX, area.maxX)
	local z = area.maxZ - rng:NextNumber(0, 20) -- they come down from the woods
	local offset = model:GetAttribute("GroundOffset")
	model:PivotTo(CFrame.new(x, services.WorldService:GroundHeight(x, z) + offset, z) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0))
	model.Parent = folder
	herd[model] = { model = model, body = model.PrimaryPart, offset = offset, area = area, busyUntil = 0, wolf = true }
end

local lastPack = {} -- [plot index] = os.clock() of the last wolf that came in

-- Keeps a pack behind every settled plot in winter, and sends them off after.
local function tendPacks()
	local winter = workspace:GetAttribute("Season") == "Winter"
	local counts = {}
	for model, rec in herd do
		if rec.wolf then
			if not winter then
				herd[model] = nil
				rec.walk = (rec.walk or 0) + 1
				model:Destroy()
			else
				counts[rec.area.plot] = (counts[rec.area.plot] or 0) + 1
			end
		end
	end
	if not winter then
		return
	end
	local settled = {}
	for _, player in Players:GetPlayers() do
		local index = player:GetAttribute("PlotIndex")
		if typeof(index) == "number" then
			settled[index] = true
		end
	end
	local now = os.clock()
	for index in settled do
		local have = counts[index] or 0
		if have < W.WolvesPerPack and (have == 0 or now - (lastPack[index] or 0) > W.WolfRespawnSeconds) then
			lastPack[index] = now
			local area = areaFor(index)
			for _ = have + 1, (have == 0 and W.WolvesPerPack or have + 1) do
				spawnWolf(area)
			end
		end
	end
end

local function nearestPlayer(pos: Vector3): (Vector3?, number)
	local best, bestDist = nil, math.huge
	for _, player in Players:GetPlayers() do
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if root then
			local d = (root.Position - pos).Magnitude
			if d < bestDist then
				best, bestDist = root.Position, d
			end
		end
	end
	return best, bestDist
end

function WildlifeService:Start()
	folder = Instance.new("Folder")
	folder.Name = "Wildlife"
	folder.Parent = workspace

	for i = 1, Config.MAX_PLOTS do
		local area = areaFor(i)
		for _ = 1, W.DeerPerPlot do
			self:Spawn(area)
		end
	end

	local packTimer = 0
	while true do
		task.wait(0.4)
		local now = os.clock()
		packTimer += 0.4
		if packTimer >= 5 then
			packTimer = 0
			tendPacks()
		end
		for _, deer in herd do
			local pos = deer.body.Position
			local threat, dist = nearestPlayer(pos)
			if deer.wolf then
				if threat and dist < W.WolfStalk and now >= deer.busyUntil then
					-- slink to a spot on a ring around you, a little further round each time
					local from = Vector3.new(pos.X - threat.X, 0, pos.Z - threat.Z)
					local angle = math.atan2(from.Z, from.X) + rng:NextNumber(0.3, 0.9) * (deer.side or 1)
					local x, z = clampToArea(deer.area, threat.X + math.cos(angle) * W.WolfKeepAway, threat.Z + math.sin(angle) * W.WolfKeepAway)
					local t = moveTo(deer, x, z, W.WolfSpeed * rng:NextNumber(0.6, 1))
					deer.busyUntil = now + t + rng:NextNumber(0.5, 2)
				elseif now >= deer.busyUntil then
					deer.side = rng:NextNumber() < 0.5 and -1 or 1
					local x, z = clampToArea(deer.area, pos.X + rng:NextNumber(-30, 30), pos.Z + rng:NextNumber(-30, 30))
					local t = moveTo(deer, x, z, W.WolfSpeed * rng:NextNumber(0.3, 0.6))
					deer.busyUntil = now + t + rng:NextNumber(2, 6)
				end
				continue
			end
			-- deer also bolt from a wolf that comes close
			for _, other in herd do
				if other.wolf and other.area.plot == deer.area.plot then
					local d = (other.body.Position - pos).Magnitude
					if d < dist then
						threat, dist = other.body.Position, d
					end
				end
			end
			if threat and dist < W.FleeDistance and not deer.fleeing then
				-- bolt directly away
				local away = Vector3.new(pos.X - threat.X, 0, pos.Z - threat.Z)
				away = away.Magnitude > 0.1 and away.Unit or Vector3.new(0, 0, 1)
				local x, z = clampToArea(deer.area, pos.X + away.X * 40, pos.Z + away.Z * 40)
				local t = moveTo(deer, x, z, W.FleeSpeed)
				deer.fleeing = true
				deer.busyUntil = now + t + 1
			elseif now >= deer.busyUntil then
				deer.fleeing = false
				local x, z = clampToArea(deer.area, pos.X + rng:NextNumber(-25, 25), pos.Z + rng:NextNumber(-25, 25))
				local t = moveTo(deer, x, z, W.Speed * rng:NextNumber(0.4, 1))
				deer.busyUntil = now + t + rng:NextNumber(3, 9) -- graze a while
			end
		end
	end
end

return WildlifeService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">WorldService</string>
            <string name="Source"><![CDATA[--[[
	WorldService
	Builds the world when the server starts: a Nordic valley made of Terrain,
	generated from layered noise (a heightmap) so it looks natural, then
	painted by height and steepness: grass and meadow flowers in the valley,
	bare rock and slate on cliffs, snow above the snowline, sand and mud at
	the fjord. The build area stays perfectly flat.

	Layout (looking from the lake toward the mountains):
	  z < -44      a fjord lake, with a far shore and peaks across the water
	  z -44..0     sandy beach and docks (the front of each plot's land)
	  z 0..160     the row of player plots (grass), growing back to z 224
	  z 240..300   an open meadow where deer roam
	  z 270..470   pine forest, rolling hills and rock outcrops
	  z 480+       snow-capped mountains
	Also sets up warm afternoon light, haze, sky and colour grading.

	Everything here is decoration: change the numbers freely.
]]

local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Grid = require(Shared.Grid)
local ModelFactory = require(Shared.ModelFactory)

local WorldService = {}

local Terrain = workspace.Terrain
local M = Enum.Material
local rng = Random.new(1066) -- fixed seed: the valley looks the same every time

local PLOTS_END_X = Config.MAX_PLOTS * (Grid.PLOT_SIZE + Config.PLOT_GAP) - Config.PLOT_GAP
local TOP = Config.GROUND_Y
local VOXEL = 4

-- World bounds (multiples of 4 so they line up with the terrain voxel grid)
local MIN_X = -760
local MAX_X = math.ceil((PLOTS_END_X + 760) / VOXEL) * VOXEL
local MIN_Z, MAX_Z = -800, 840

-- The flat, buildable part of the valley
-- (extends west to hold the rival village, Config.Rival)
local FLAT_MIN_X, FLAT_MAX_X = -290, PLOTS_END_X + 40
for _, rival in Config.Rivals do
	FLAT_MIN_X = math.min(FLAT_MIN_X, rival.Center.X - rival.Radius - 30)
	FLAT_MAX_X = math.max(FLAT_MAX_X, rival.Center.X + rival.Radius + 30)
end
local FLAT_MIN_Z, FLAT_MAX_Z = -40, Grid.PLOT_SIZE + 145
local SHORE_Z = -40 -- where the beach starts to slope into the fjord
local SEED = 7.31

-- Noise helpers ---------------------------------------------------------------

local function smooth(edge0: number, edge1: number, x: number): number
	local t = math.clamp((x - edge0) / (edge1 - edge0), 0, 1)
	return t * t * (3 - 2 * t)
end

local function lerp(a: number, b: number, t: number): number
	return a + (b - a) * t
end

-- fractal noise, roughly -0.5..0.5
local function fbm(x: number, z: number, freq: number, octaves: number, salt: number): number
	local amp, sum, norm = 1, 0, 0
	for o = 1, octaves do
		sum += math.noise(x * freq, z * freq, SEED + salt + o * 17.3) * amp
		norm += amp
		amp *= 0.5
		freq *= 2
	end
	return sum / norm
end

-- ridged noise, 0..1, sharp crests: good for mountain ridges
local function ridged(x: number, z: number, freq: number, octaves: number): number
	local amp, sum, norm = 1, 0, 0
	for o = 1, octaves do
		local n = 1 - math.abs(math.noise(x * freq, z * freq, SEED + 91 + o * 31.7) * 1.6)
		n = math.max(n, 0)
		sum += n * n * amp
		norm += amp
		amp *= 0.5
		freq *= 2.1
	end
	return sum / norm
end

-- 0 outside the build zone, 1 inside, with a soft 60-stud edge
local function flatMask(x: number, z: number): number
	local fx = math.min(smooth(FLAT_MIN_X - 60, FLAT_MIN_X, x), smooth(FLAT_MAX_X + 60, FLAT_MAX_X, x))
	local fz = math.min(smooth(FLAT_MIN_Z - 70, FLAT_MIN_Z, z), smooth(FLAT_MAX_Z + 90, FLAT_MAX_Z, z))
	return math.min(fx, fz)
end

local function mountainMask(x: number, z: number): (number, number)
	local wobble = fbm(x, z, 1 / 320, 2, 5) * 160
	local back = smooth(380, 660, z + wobble)
	local far = smooth(-540, -720, z - wobble * 0.5)
	local side = math.max(smooth(FLAT_MIN_X - 220, FLAT_MIN_X - 520, x + wobble), smooth(FLAT_MAX_X + 220, FLAT_MAX_X + 520, x + wobble))
	return math.max(back, far, side), far
end

-- Two rivers run down from the mountains into the fjord, one past each end
-- of the valley (beyond the rival holds), through a terraced, cliffy upland.
local RIVERS = { FLAT_MIN_X - 80, FLAT_MAX_X + 80 }
local RIVER_HALF = 7 -- half the water's width
local RIVER_TOP_Z = 760
local riversOn = true -- switched off if the river carving ever fails

local function riverCentre(base: number, z: number): number
	return base + math.sin(z / 110 + base) * 30 + math.sin(z / 47) * 12
end

-- distance to the nearest river's centre line, and that line's x
local function nearestRiver(x: number, z: number): (number, number)
	local best, bx = math.huge, 0
	if not riversOn or z < SHORE_Z - 30 or z > RIVER_TOP_Z then
		return best, bx
	end
	for _, base in RIVERS do
		local cx = riverCentre(base, z)
		local d = math.abs(x - cx)
		if d < best then
			best, bx = d, cx
		end
	end
	return best, bx
end

-- rock steps on the uplands: soft slopes broken by short cliffs
local function terrace(v: number, step: number): number
	local s = math.floor(v / step)
	local f = v / step - s
	return (s + smooth(0.62, 1, f)) * step
end

-- The height of the land at x, z
local landHeight
-- 0..1: how far inside a settler plot (x, z) is (1 = well inside)
local function inPlot(x: number, z: number): number
	if z < -4 or z > Grid.PLOT_SIZE + 4 then
		return 0
	end
	for i = 1, Config.MAX_PLOTS do
		local o = Grid.plotOrigin(i)
		if x >= o.X - 4 and x <= o.X + Grid.PLOT_SIZE + 4 then
			local edge = math.min(x - (o.X - 4), o.X + Grid.PLOT_SIZE + 4 - x, z + 4, Grid.PLOT_SIZE + 4 - z)
			return math.clamp(edge / 6, 0, 1)
		end
	end
	return 0
end

-- 0..1: inside the deep berth dug beside each jetty, where ships are moored
local function inBerth(x: number, z: number): number
	if z > -34 then
		return 0
	end
	local best = 0
	for i = 1, Config.MAX_PLOTS do
		local o = Grid.plotOrigin(i)
		local dockX = o.X + Grid.PLOT_SIZE * 0.25
		local dx = math.abs(x - (dockX + 6))
		best = math.max(best, smooth(26, 14, dx) * smooth(-36, -50, z))
	end
	return best
end

local function heightAt(x: number, z: number): number
	local h = landHeight(x, z)
	-- plots are dead level, so buildings sit on the ground, not in it
	local plot = inPlot(x, z)
	if plot > 0 then
		h = lerp(h, TOP, plot)
	end
	-- a deep berth by every jetty, so moored ships float instead of running aground
	local berth = inBerth(x, z)
	if berth > 0 then
		h = lerp(h, math.min(h, -8), berth)
	end
	local d, cx = nearestRiver(x, z)
	if d < 18 then
		-- carve the river bed below the bank on its centre line
		local bank = landHeight(cx, z)
		local bed = math.min(bank, TOP) - 9
		if bank > TOP + 1 then
			bed = bank - 9
		end
		h = lerp(h, math.min(h, bed), smooth(18, RIVER_HALF, d))
	end
	return h
end

-- Where water stands in a column: the river surface near a river, else sea level.
local function waterLevelAt(x: number, z: number): number
	local d, cx = nearestRiver(x, z)
	if d < RIVER_HALF + 3 then
		local bank = landHeight(cx, z)
		return math.max(0, bank > TOP + 1 and bank - 2 or 0)
	end
	return 0
end

function landHeight(x: number, z: number): number
	local m, far = mountainMask(x, z)
	local mountains = m * (40 + 210 * ridged(x, z, 1 / 380, 5))
	local hills = 26 * (fbm(x, z, 1 / 170, 4, 1) + 0.5) * smooth(200, 340, z)
	local detail = fbm(x, z, 1 / 36, 2, 3) * 2.5
	local h = TOP + hills + mountains + detail
	-- terraces and cliffs on the uplands behind the valley
	local cliffy = smooth(170, 300, z) * (1 - flatMask(x, z)) * smooth(-0.2, 0.15, fbm(x, z, 1 / 260, 2, 71))
	if cliffy > 0 then
		h = lerp(h, TOP + terrace(h - TOP, 11), cliffy * 0.9)
	end

	-- the fjord: slope down from the beach, rise again at the far shore
	if z < SHORE_Z then
		local lake = smooth(SHORE_Z, SHORE_Z - 80, z) * (1 - far)
		-- shallow near the beach, dropping into a deep dark channel
		local bed = lerp(-5, -42, smooth(SHORE_Z - 20, SHORE_Z - 260, z) * (1 - far)) + fbm(x, z, 1 / 90, 3, 7) * 6
		h = lerp(h, bed, lake)
	end

	-- islands for the sea holds: a flat top with a sandy shelf around it
	for _, rival in Config.Rivals do
		if rival.Sea then
			local dx, dz = x - rival.Center.X, z - rival.Center.Z
			local dist = math.sqrt(dx * dx + dz * dz) + fbm(x, z, 1 / 40, 2, 53) * 18
			local land = smooth(rival.Radius + 95, rival.Radius + 25, dist)
			h = lerp(h, TOP + fbm(x, z, 1 / 30, 2, 57) * 1.2 * smooth(rival.Radius + 25, rival.Radius + 60, dist), land)
			-- a rocky knoll behind the hold, away from the gate
			local back = rival.Center - Vector3.new(math.cos(rival.GateAngle or 0), 0, math.sin(rival.GateAngle or 0)) * (rival.Radius + 85)
			local kd = math.sqrt((x - back.X) ^ 2 + (z - back.Z) ^ 2)
			h += smooth(70, 10, kd) * (26 + ridged(x, z, 1 / 60, 3) * 30)
		end
	end

	return lerp(h, TOP, flatMask(x, z))
end

-- (covers the biggest the land can grow, see Config.LandStages)
local LAND_MIN_X, _, LAND_MAX_X, LAND_MAX_Z = Grid.maxBounds()
local function inPlotArea(x: number, z: number): boolean
	if z < -50 or z > LAND_MAX_Z * Config.CELL + 12 then
		return false
	end
	for i = 1, Config.MAX_PLOTS do
		local o = Grid.plotOrigin(i)
		if x > o.X + LAND_MIN_X * Config.CELL - 8 and x < o.X + LAND_MAX_X * Config.CELL + 8 then
			return true
		end
	end
	return false
end

-- The rival hold whose walls cover x, z (nil if none).
local function rivalAt(x: number, z: number)
	for _, rival in Config.Rivals do
		local dx, dz = x - rival.Center.X, z - rival.Center.Z
		if dx * dx + dz * dz < (rival.Radius + 22) ^ 2 then
			return rival
		end
	end
	return nil
end

local function inRivalArea(x: number, z: number): boolean
	return rivalAt(x, z) ~= nil
end

-- A cobbled path from the front of each plot down to its jetty, wandering a little.
local function inPath(x: number, z: number): boolean
	if z > 1 or z < -36 then
		return false
	end
	for i = 1, Config.MAX_PLOTS do
		local o = Grid.plotOrigin(i)
		local dockX = o.X + Grid.PLOT_SIZE * 0.25 + math.sin(z / 9) * 1.5
		if math.abs(x - dockX) < 3.2 + fbm(x, z, 1 / 6, 2, 71) * 1.6 then
			return true
		end
	end
	return false
end

local function inApron(x: number, z: number): boolean
	if z < -4 or z > 0 then
		return false
	end
	for i = 1, Config.MAX_PLOTS do
		local o = Grid.plotOrigin(i)
		if x >= o.X and x <= o.X + Grid.PLOT_SIZE then
			return true
		end
	end
	return false
end

local function groundAt(x: number, z: number): RaycastResult?
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { Terrain }
	return workspace:Raycast(Vector3.new(x, 600, z), Vector3.new(0, -700, 0), params)
end

-- Picks the surface material from height, steepness and position.
local function surfaceMaterial(x: number, z: number, h: number, slope: number)
	if inPath(x, z) then
		return M.Cobblestone
	end
	if inApron(x, z) then
		return M.Ground
	end
	if inPlotArea(x, z) then
		-- the front of every plot is beach, down to the water
		return z < -4 and M.Sand or M.Grass
	end
	local rival = rivalAt(x, z)
	if rival then
		local dx, dz = x - rival.Center.X, z - rival.Center.Z
		return (dx * dx + dz * dz < 36 * 36 or fbm(x, z, 1 / 25, 2, 41) > 0.2) and M.Ground or M.Grass
	end
	local rd = nearestRiver(x, z)
	if rd < RIVER_HALF + 2 then
		return M.Mud
	elseif rd < 14 then
		return fbm(x, z, 1 / 12, 2, 77) > 0 and M.Rock or M.Ground -- stony banks (Pebble isn't a terrain material)
	end
	if h < -6 then
		return M.Mud
	end
	for _, r in Config.Rivals do
		if r.Sea and h > 0.4 and h < 6 then
			local dx, dz = x - r.Center.X, z - r.Center.Z
			if dx * dx + dz * dz < (r.Radius + 48) ^ 2 then
				return fbm(x, z, 1 / 28, 2, 61) > 0.15 and M.Ground or M.LeafyGrass
			end
		end
	end
	if h < 3 and z < SHORE_Z + 12 then
		return M.Sand
	end
	local snowline = 150 + fbm(x, z, 1 / 80, 2, 11) * 50
	if h > snowline and slope < 1.3 then
		return M.Snow
	end
	if slope > 1.15 then
		return M.Rock
	end
	if slope > 0.75 then
		return M.Slate
	end
	if h > snowline - 45 then
		return fbm(x, z, 1 / 30, 2, 13) > 0 and M.Rock or M.Ground
	end
	local n = fbm(x, z, 1 / 70, 3, 17)
	if n > 0.22 then
		return M.LeafyGrass
	elseif n < -0.28 then
		return M.Ground
	end
	return M.Grass
end

local function buildTerrain()
	Terrain:Clear()

	-- Materials and water look
	Terrain:SetMaterialColor(M.Grass, Color3.fromRGB(88, 118, 58))
	Terrain:SetMaterialColor(M.LeafyGrass, Color3.fromRGB(78, 106, 52))
	Terrain:SetMaterialColor(M.Rock, Color3.fromRGB(104, 104, 102))
	Terrain:SetMaterialColor(M.Slate, Color3.fromRGB(88, 90, 88))
	Terrain:SetMaterialColor(M.Snow, Color3.fromRGB(240, 244, 250))
	Terrain:SetMaterialColor(M.Sand, Color3.fromRGB(176, 164, 134))
	Terrain:SetMaterialColor(M.Ground, Color3.fromRGB(104, 88, 64))
	Terrain:SetMaterialColor(M.Mud, Color3.fromRGB(62, 56, 46))
	Terrain:SetMaterialColor(M.Cobblestone, Color3.fromRGB(112, 108, 100))
	-- deep fjord teal: low transparency so depth reads as colour, full
	-- reflectance so the sky and mountains mirror in it
	Terrain.WaterColor = Color3.fromRGB(22, 50, 60)
	Terrain.WaterTransparency = 0.18
	Terrain.WaterReflectance = 1
	Terrain.WaterWaveSize = 0.16
	Terrain.WaterWaveSpeed = 9
	pcall(function()
		Terrain.Decoration = true -- animated grass blades on Grass
	end)

	-- 1. Heightmap: one height per 4x4-stud column
	local nx = (MAX_X - MIN_X) // VOXEL
	local nz = (MAX_Z - MIN_Z) // VOXEL
	local heights = table.create(nx + 2)
	local waters = table.create(nx + 2)
	local budget = os.clock()
	for i = 0, nx + 1 do
		local row = table.create(nz + 2)
		local wrow = table.create(nz + 2)
		local x = MIN_X + (i - 0.5) * VOXEL
		for k = 0, nz + 1 do
			local z = MIN_Z + (k - 0.5) * VOXEL
			row[k] = heightAt(x, z)
			wrow[k] = waterLevelAt(x, z)
		end
		heights[i] = row
		waters[i] = wrow
		if os.clock() - budget > 0.05 then
			if RunService:IsRunning() then
				task.wait()
			end
			budget = os.clock()
		end
	end

	-- 2. Write voxels chunk by chunk
	local failed, firstError = 0, nil
	local CHUNK = 32
	for ci = 1, nx, CHUNK do
		for ck = 1, nz, CHUNK do
			local ci2 = math.min(ci + CHUNK - 1, nx)
			local ck2 = math.min(ck + CHUNK - 1, nz)
			local lo, hi = math.huge, -math.huge
			for i = ci, ci2 do
				local row = heights[i]
				for k = ck, ck2 do
					local h = row[k]
					lo = math.min(lo, h)
					hi = math.max(hi, h)
				end
			end
			for i = ci, ci2 do
				for k = ck, ck2 do
					hi = math.max(hi, waters[i][k])
				end
			end
			hi = math.max(hi, 0) -- room for water
			local yMin = math.floor((lo - 14) / VOXEL) * VOXEL
			local yMax = math.ceil((hi + 1) / VOXEL) * VOXEL
			local ny = (yMax - yMin) // VOXEL

			local materials = table.create(ci2 - ci + 1)
			local occupancy = table.create(ci2 - ci + 1)
			for i = ci, ci2 do
				local mx, ox = table.create(ny), table.create(ny)
				local x = MIN_X + (i - 0.5) * VOXEL
				local row, rowL, rowR = heights[i], heights[i - 1], heights[i + 1]
				local wrow = waters[i]
				for j = 1, ny do
					mx[j] = table.create(ck2 - ck + 1)
					ox[j] = table.create(ck2 - ck + 1)
				end
				for k = ck, ck2 do
					local z = MIN_Z + (k - 0.5) * VOXEL
					local h = row[k]
					local slope = math.max(math.abs(rowR[k] - rowL[k]), math.abs(row[k + 1] - row[k - 1])) / (2 * VOXEL)
					local surface = surfaceMaterial(x, z, h, slope)
					local under = (surface == M.Grass or surface == M.LeafyGrass) and M.Ground or surface
					local kk = k - ck + 1
					for j = 1, ny do
						local y0 = yMin + (j - 1) * VOXEL
						local mat, occ
						if h >= y0 + VOXEL then
							local depth = h - (y0 + VOXEL)
							occ = 1
							if depth < 3 then
								mat = surface
							elseif depth < 9 then
								mat = under
							else
								mat = M.Rock
							end
						elseif h > y0 then
							occ = (h - y0) / VOXEL
							mat = surface
						elseif y0 + VOXEL <= wrow[k] + 0.01 then
							-- the top layer of water is only partly full, so the surface
							-- sits a little below 0: ships ride high and jetties stay dry
							occ = (y0 + VOXEL > wrow[k] - VOXEL + 0.01) and 0.6 or 1
							mat = M.Water
						else
							occ = 0
							mat = M.Air
						end
						mx[j][kk] = mat
						ox[j][kk] = occ
					end
				end
				materials[i - ci + 1] = mx
				occupancy[i - ci + 1] = ox
			end

			local regionMin = Vector3.new(MIN_X + (ci - 1) * VOXEL, yMin, MIN_Z + (ck - 1) * VOXEL)
			local regionMax = Vector3.new(MIN_X + ci2 * VOXEL, yMax, MIN_Z + ck2 * VOXEL)
			local ok, err = pcall(function()
				Terrain:WriteVoxels(Region3.new(regionMin, regionMax), VOXEL, materials, occupancy)
			end)
			if not ok then
				failed += 1
				firstError = firstError or tostring(err)
			end

			if os.clock() - budget > 0.05 then
				if RunService:IsRunning() then
					task.wait()
				end
				budget = os.clock()
			end
		end
	end
	if failed > 0 then
		error(failed .. " terrain chunks failed: " .. tostring(firstError))
	end
end

local function scatterScenery()
	local folder = Instance.new("Folder")
	folder.Name = "Scenery"
	folder.Parent = workspace

	local treeMaterials = { [M.Grass] = true, [M.LeafyGrass] = true, [M.Ground] = true }

	local function plant(x: number, z: number): boolean
		if inPlotArea(x, z) or inRivalArea(x, z) or (x > FLAT_MIN_X and x < FLAT_MAX_X and z > -60 and z < 0) then
			return false
		end
		local hit = groundAt(x, z)
		if not hit or not treeMaterials[hit.Material] or hit.Normal.Y < 0.82 then
			return false
		end
		local treeline = 125 + fbm(x, z, 1 / 80, 2, 23) * 40
		if hit.Position.Y > treeline or hit.Position.Y < 1.5 then
			return false
		end
		local model
		local s = rng:NextNumber(1.15, 2.4) * (1 - hit.Position.Y / 400) -- smaller trees higher up
		local r = rng:NextNumber()
		if r < 0.42 then
			model = ModelFactory.pine(rng, s)
		elseif r < 0.89 then
			model = ModelFactory.spruce(rng, s * 1.1)
		else
			model = ModelFactory.birch(rng, s * 0.8)
		end
		model:PivotTo(CFrame.new(hit.Position - Vector3.new(0, 0.4, 0)) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0))
		model.Parent = folder
		return true
	end

	-- Forests grow in patches: noise decides where the woods are dense.
	local planted, tries = 0, 0
	local budget = os.clock()
	while planted < 1300 and tries < 12000 do
		tries += 1
		local x, z = rng:NextNumber(MIN_X, MAX_X), rng:NextNumber(MIN_Z + 40, 640)
		local density = fbm(x, z, 1 / 220, 3, 29) + 0.15
		if z > FLAT_MAX_Z - 70 and z < FLAT_MAX_Z + 40 and x > FLAT_MIN_X and x < FLAT_MAX_X then
			density -= 0.35 -- keep the deer meadow open
		end
		if rng:NextNumber() < density * 2 and plant(x, z) then
			planted += 1
		end
		if os.clock() - budget > 0.05 then
			if RunService:IsRunning() then
				task.wait()
			end
			budget = os.clock()
		end
	end

	-- understory: ferns and junipers where the woods are
	local under = 0
	tries = 0
	while under < 450 and tries < 4000 do
		tries += 1
		local x, z = rng:NextNumber(MIN_X, MAX_X), rng:NextNumber(-30, 560)
		if fbm(x, z, 1 / 220, 3, 29) + 0.15 > 0.05 and not inPlotArea(x, z) and not inRivalArea(x, z) then
			local hit = groundAt(x, z)
			if hit and treeMaterials[hit.Material] and hit.Normal.Y > 0.8 and hit.Position.Y < 110 and hit.Position.Y > 1.5 then
				local model = rng:NextNumber() < 0.6 and ModelFactory.fern(rng) or ModelFactory.juniper(rng)
				model:PivotTo(CFrame.new(hit.Position - Vector3.new(0, 0.2, 0)) * CFrame.Angles(0, rng:NextNumber(0, 6), 0))
				model.Parent = folder
				under += 1
			end
		end
		if os.clock() - budget > 0.05 then
			if RunService:IsRunning() then
				task.wait()
			end
			budget = os.clock()
		end
	end

	-- loose boulders
	for _ = 1, 70 do
		local x, z = rng:NextNumber(MIN_X, MAX_X), rng:NextNumber(-60, 500)
		if not inPlotArea(x, z) and not inRivalArea(x, z) then
			local hit = groundAt(x, z)
			if hit and hit.Position.Y < 80 and hit.Material ~= M.Water then
				local model = ModelFactory.boulder(rng, rng:NextNumber(1, 2.6))
				model:PivotTo(CFrame.new(hit.Position) * CFrame.Angles(0, rng:NextNumber(0, 6), 0))
				model.Parent = folder
			end
		end
	end

	-- the shoreline: find where the land meets the water and line it with
	-- foam (animated on the client) and half-sunk rocks
	local foamFolder = Instance.new("Folder")
	foamFolder.Name = "ShoreFoam"
	local function shoreAt(x: number, fromZ: number, toZ: number, step: number): number?
		local wasDry = heightAt(x, fromZ) > 0.2
		for z = fromZ, toZ, step do
			local dry = heightAt(x, z) > 0.2
			if dry ~= wasDry then
				return z
			end
			wasDry = dry
		end
		return nil
	end
	for x = MIN_X + 6, MAX_X - 6, 9 do
		for _, scan in { { SHORE_Z + 10, SHORE_Z - 200, -2 }, { MIN_Z + 20, -480, 3 } } do
			local z = shoreAt(x, scan[1], scan[2], scan[3])
			if z then
				for layer = 0, 1 do
					local foam = Instance.new("Part")
					foam.Name = "Foam"
					foam.Anchored = true
					foam.CanCollide = false
					foam.CanQuery = false
					foam.CastShadow = false
					foam.Material = Enum.Material.SmoothPlastic
					foam.Color = Color3.fromRGB(236, 242, 240)
					foam.Transparency = 0.55 + layer * 0.2
					foam.Size = Vector3.new(10.5, 0.1, 1.6 + layer * 2.5)
					foam.CFrame = CFrame.new(x, 0.06 + layer * 0.02, z + (scan[3] < 0 and -1 or 1) * (1 + layer * 2.2))
						* CFrame.Angles(0, rng:NextNumber(-0.12, 0.12), 0)
					foam.Parent = foamFolder
				end
				if rng:NextNumber() < 0.22 and not (x > FLAT_MIN_X and x < FLAT_MAX_X and scan[3] < 0 and rng:NextNumber() < 0.6) then
					local rock = ModelFactory.boulder(rng, rng:NextNumber(1.2, 2.8))
					rock:PivotTo(CFrame.new(x + rng:NextNumber(-4, 4), -1.2, z + rng:NextNumber(-3, 3)) * CFrame.Angles(0, rng:NextNumber(0, 6), 0))
					rock.Parent = folder
				end
			end
		end
	end
	foamFolder.Parent = workspace

	-- a jetty on the fjord in front of every plot, some with a longship
	local sails = { Color3.fromRGB(160, 40, 36), Color3.fromRGB(46, 70, 120), Color3.fromRGB(150, 120, 50) }
	for i = 1, Config.MAX_PLOTS do
		local o = Grid.plotOrigin(i)
		local dockX = o.X + Grid.PLOT_SIZE * 0.25
		local dock = ModelFactory.dock(48)
		dock:PivotTo(CFrame.new(dockX, 0, -34))
		dock.Parent = folder
		if i % 2 == 1 then
			local ship = ModelFactory.longship(40, sails[(i // 2) % #sails + 1])
			ship:PivotTo(CFrame.new(dockX + 9, 0, -62) * CFrame.Angles(0, math.rad(rng:NextNumber(-4, 4)), 0))
			ship.Parent = folder
		end
		-- village life on the beach and in the gaps between plots
		local function placeProp(kind: string, x: number, z: number, turn: number)
			local prop = ModelFactory.prop(kind, rng)
			local hit = groundAt(x, z)
			local y = hit and hit.Position.Y or TOP
			prop:PivotTo(CFrame.new(x, y, z) * CFrame.Angles(0, turn, 0))
			prop.Parent = folder
		end
		-- torch posts down the path to the jetty, warm against the cold
		-- (all at the water's edge, below your beach, so the sand is free to build on)
		for _, dx in { -4.6, 4.6 } do
			placeProp("TorchPost", dockX + dx, -35, 0)
		end
		placeProp("FishRack", dockX - 14, -38, rng:NextNumber(-0.3, 0.3))
		placeProp("Barrels", dockX + 7, -37, rng:NextNumber(0, 6))
		placeProp("BoatUpturned", dockX + 22, -38, math.rad(80) + rng:NextNumber(-0.2, 0.2))
		local gapX = o.X - Config.PLOT_GAP / 2
		do
			placeProp("Banner", gapX, -6, 0)
			placeProp("Haystack", gapX + rng:NextNumber(-3, 3), 60 + rng:NextNumber(-10, 10), rng:NextNumber(0, 6))
			placeProp("Cart", gapX + rng:NextNumber(-2, 2), 110 + rng:NextNumber(-10, 10), math.rad(90) + rng:NextNumber(-0.4, 0.4))
			placeProp("Woodpile", gapX, 170, math.rad(90))
		end
		-- a split-rail fence between the village and the deer meadow
		local fence = ModelFactory.prop("FenceRun", rng)
		fence:PivotTo(CFrame.new(o.X + Grid.PLOT_SIZE / 2, TOP, LAND_MAX_Z * Config.CELL + 6))
		fence.Parent = folder
	end
end

-- A trading longship that sails slowly up and down the fjord forever.
local function sailingShip()
	local ship = ModelFactory.longship(48, Color3.fromRGB(150, 40, 36))
	ship.Name = "TradingShip"
	ModelFactory.addCrew(ship, 6, Random.new(48), 2)
	ship.Parent = workspace:FindFirstChild("Scenery") or workspace
	local z = -300
	local x0, x1 = MIN_X + 200, MAX_X - 200
	task.spawn(function()
		local dir = 1
		local x = x0
		local speed = 9
		while ship.Parent do
			local dt = task.wait(1 / 20)
			x += dir * speed * dt
			if x > x1 or x < x0 then
				dir = -dir
				x = math.clamp(x, x0, x1)
			end
			local bob = math.sin(os.clock() * 0.8) * 0.25
			local roll = math.sin(os.clock() * 0.6) * math.rad(2)
			local heading = dir > 0 and -math.pi / 2 or math.pi / 2
			ship:PivotTo(CFrame.new(x, bob, z + math.sin(x / 300) * 60) * CFrame.Angles(0, heading, 0) * CFrame.Angles(0, 0, roll))
		end
	end)
end

-- Day and night: a full day takes DAY_SECONDS, nights pass faster.
local DAY_SECONDS = 480
local function dayNightCycle()
	local grade = Lighting:FindFirstChildOfClass("ColorCorrectionEffect")
	local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere")
	local t = (15.6 - 6) / 14 * (DAY_SECONDS * 0.75) -- start in the afternoon
	while true do
		local dt = task.wait(0.1)
		t = (t + dt) % DAY_SECONDS
		local dayPart = DAY_SECONDS * 0.75
		local clock
		if t < dayPart then
			clock = 6 + 14 * (t / dayPart) -- 06:00 to 20:00
		else
			clock = (20 + 10 * ((t - dayPart) / (DAY_SECONDS - dayPart))) % 24 -- 20:00 to 06:00
		end
		Lighting.ClockTime = clock
		-- 0 at midday, 1 deep at night
		local night = 0
		if clock >= 18.5 or clock < 6.5 then
			local h = clock >= 18.5 and clock - 18.5 or clock + 5.5
			night = math.clamp(math.min(h, 12 - h) / 1.5, 0, 1)
		end
		local golden = math.clamp(1 - math.abs(clock - 18) / 2, 0, 1) + math.clamp(1 - math.abs(clock - 7) / 1.5, 0, 1)
		local season = workspace:GetAttribute("Season")
		-- a cold northern light all year, warmer only in autumn
		local seasonTint = Color3.fromRGB(238, 244, 255)
		if season == "Winter" then
			seasonTint = Color3.fromRGB(212, 228, 255)
		elseif season == "Autumn" then
			seasonTint = Color3.fromRGB(252, 238, 220)
		elseif season == "Spring" then
			seasonTint = Color3.fromRGB(234, 246, 246)
		end
		local winter = season == "Winter" and 1 or 0
		-- weather (WeatherService): fog thickens the air, storms darken it
		local fog = workspace:GetAttribute("FogLevel") or 0
		local storm = workspace:GetAttribute("StormLevel") or 0
		golden *= 1 - math.max(fog, storm) * 0.8
		if grade then
			grade.TintColor = seasonTint:Lerp(Color3.fromRGB(255, 205, 160), golden * 0.35):Lerp(Color3.fromRGB(170, 190, 255), night):Lerp(Color3.fromRGB(196, 206, 214), storm * 0.5)
			grade.Brightness = 0.01 + night * 0.04 - storm * 0.06
			grade.Saturation = -0.1 - winter * 0.06 - storm * 0.2 - fog * 0.12
		end
		if atmosphere then
			atmosphere.Color = Color3.fromRGB(184, 196, 210):Lerp(Color3.fromRGB(214, 176, 140), golden * 0.35):Lerp(Color3.fromRGB(70, 80, 110), night):Lerp(Color3.fromRGB(196, 202, 206), fog * (1 - night * 0.7)):Lerp(Color3.fromRGB(96, 104, 114), storm * (1 - night * 0.5))
			atmosphere.Decay = Color3.fromRGB(88, 102, 124):Lerp(Color3.fromRGB(150, 158, 168), fog)
			-- blue-grey haze that swallows the far mountains, thicker in winter
			atmosphere.Haze = 2.1 + golden * 0.5 - night * 0.6 + winter * 0.4 + fog * 1.0 + storm * 0.6
			atmosphere.Density = 0.36 + winter * 0.04 + fog * 0.14 + storm * 0.08 -- fog is a veil, never a wall
		end
		Lighting.OutdoorAmbient = Color3.fromRGB(116, 122, 134):Lerp(Color3.fromRGB(60, 66, 92), night):Lerp(Color3.fromRGB(100, 104, 110), storm * 0.6)
		Lighting.Brightness = 2.6 * (1 - storm * 0.45 - fog * 0.2)
	end
end

local function setupLighting()
	for _, child in Lighting:GetChildren() do
		if child:IsA("Sky") or child:IsA("Atmosphere") or child:IsA("PostEffect") then
			child:Destroy()
		end
	end

	Lighting.ClockTime = 15.6
	Lighting.GeographicLatitude = 58
	Lighting.Brightness = 2.6
	Lighting.Ambient = Color3.fromRGB(52, 56, 66)
	Lighting.OutdoorAmbient = Color3.fromRGB(116, 122, 134)
	Lighting.EnvironmentDiffuseScale = 1
	Lighting.EnvironmentSpecularScale = 1 -- wet stone, metal and water catch the light
	Lighting.ShadowSoftness = 0.25
	Lighting.GlobalShadows = true

	local atmosphere = Instance.new("Atmosphere")
	atmosphere.Density = 0.36
	atmosphere.Offset = 0.25
	atmosphere.Color = Color3.fromRGB(184, 196, 210)
	atmosphere.Decay = Color3.fromRGB(88, 102, 124)
	atmosphere.Glare = 0.2
	atmosphere.Haze = 2.1
	atmosphere.Parent = Lighting

	local sky = Instance.new("Sky")
	sky.SunAngularSize = 14
	sky.Parent = Lighting

	local grade = Instance.new("ColorCorrectionEffect")
	grade.Brightness = 0.01
	grade.Contrast = 0.2
	grade.Saturation = -0.1
	grade.TintColor = Color3.fromRGB(238, 244, 255)
	grade.Parent = Lighting

	local bloom = Instance.new("BloomEffect")
	-- fires and lanterns glow warm against the cold
	bloom.Intensity = 0.8
	bloom.Size = 28
	bloom.Threshold = 0.82
	bloom.Parent = Lighting

	local clouds = Terrain:FindFirstChildOfClass("Clouds") or Instance.new("Clouds")
	clouds.Cover = 0.68
	clouds.Density = 0.62
	clouds.Color = Color3.fromRGB(212, 218, 228)
	clouds.Parent = Terrain

	-- a gentle cinematic blur on the far distance
	local dof = Instance.new("DepthOfFieldEffect")
	dof.FarIntensity = 0.16
	dof.NearIntensity = 0
	dof.FocusDistance = 140
	dof.InFocusRadius = 180
	dof.Parent = Lighting

	local rays = Instance.new("SunRaysEffect")
	rays.Intensity = 0.05
	rays.Spread = 0.7
	rays.Parent = Lighting
end

-- A plank landing jetty on the beach of each island hold, so you know where
-- to bring your longship in.
local function buildLandings()
	for _, rival in Config.Rivals do
		if rival.Sea then
			local a = rival.GateAngle or 0
			local dir = Vector3.new(math.cos(a), 0, math.sin(a))
			local side = Vector3.new(-dir.Z, 0, dir.X)
			-- walk out from the gate until the water starts
			local startD = rival.Radius + 20
			local waterD = startD
			for d = startD, rival.Radius + 160, 2 do
				local p = rival.Center + dir * d
				if heightAt(p.X, p.Z) < -0.5 then
					waterD = d
					break
				end
			end
			local model = Instance.new("Model")
			model.Name = "Landing_" .. rival.Name
			local wood = Color3.fromRGB(104, 78, 54)
			local from, to = waterD - 10, waterD + 34
			for d = from, to, 2.2 do
				local p = rival.Center + dir * d
				local plank = ModelFactory.addPart(model, {
					Name = "Plank",
					Size = Vector3.new(9, 0.5, 2),
					Color = wood:Lerp(Color3.new(0, 0, 0), rng:NextNumber(0, 0.15)),
					Material = M.WoodPlanks,
				})
				plank.CFrame = CFrame.lookAt(Vector3.new(p.X, 1.6, p.Z), Vector3.new(p.X, 1.6, p.Z) + dir)
					* CFrame.Angles(0, 0, math.rad(rng:NextNumber(-1.5, 1.5)))
			end
			for d = from + 6, to, 9 do
				for s = -1, 1, 2 do
					local p = rival.Center + dir * d + side * s * 4.6
					local post = ModelFactory.addPart(model, { Name = "Post", Size = Vector3.new(0.9, 10, 0.9), Color = wood:Lerp(Color3.new(0, 0, 0), 0.3), Material = M.Wood })
					post.CFrame = CFrame.new(p.X, -2.5, p.Z)
				end
			end
			model.Parent = workspace:FindFirstChild("Scenery") or workspace
		end
	end
end

-- True if there is ground under the middle of the first plot.
local function hasGround(): boolean
	local o = Grid.plotOrigin(1)
	return groundAt(o.X + Grid.PLOT_SIZE / 2, o.Z + Grid.PLOT_SIZE / 2) ~= nil
end

-- A flat slab of ground for the whole valley: only if the terrain could not
-- be made at all, so nobody falls through the world.
local function emergencyGround()
	local floor = Instance.new("Part")
	floor.Name = "EmergencyGround"
	floor.Anchored = true
	floor.Size = Vector3.new(MAX_X - MIN_X, 4, 900)
	floor.Position = Vector3.new((MIN_X + MAX_X) / 2, TOP - 2, 300)
	floor.Material = Enum.Material.Grass
	floor.Color = Color3.fromRGB(88, 118, 58)
	floor.Parent = workspace
end

-- Builds the terrain and never leaves the world without ground: if it
-- fails, it tries again without rivers, and as a last resort lays a slab.
-- The error is put on screen (workspace attribute TerrainError) so it can
-- be reported.
local function buildTerrainSafely()
	local ok, err = pcall(buildTerrain)
	if ok and hasGround() then
		return
	end
	local first = ok and "no ground after building" or tostring(err)
	warn("[WorldService] terrain failed (" .. first .. "), trying again without rivers")
	riversOn = false
	local ok2, err2 = pcall(buildTerrain)
	if ok2 and hasGround() then
		workspace:SetAttribute("TerrainError", "Rivers were switched off: " .. first)
		return
	end
	warn("[WorldService] terrain failed again: " .. tostring(err2))
	workspace:SetAttribute("TerrainError", "The valley could not be built: " .. first)
	emergencyGround()
end

local function clearPlaceholders()
	-- The flat Baseplate and welcome sign are only there so the place isn't
	-- empty in edit mode; the real world replaces them.
	for _, name in { "Baseplate", "WelcomeSign" } do
		local old = workspace:FindFirstChild(name)
		if old then
			old:Destroy()
		end
	end
end

-- Tells the minimap where the rivers run (it draws them with riverCentre's maths).
local function shareRivers()
	workspace:SetAttribute("RiverBases", riversOn and Vector2.new(RIVERS[1], RIVERS[2]) or nil)
	workspace:SetAttribute("RiverZ", Vector2.new(SHORE_Z - 30, RIVER_TOP_Z))
end

-- Bump this whenever the valley's shape changes, so an old valley saved into
-- the place file is rebuilt instead of fighting the new layout.
local WORLD_VERSION = 5

-- Does a valley saved into the place still fit this version's layout?
local function bakedValleyFits(): boolean
	if workspace:GetAttribute("WorldVersion") ~= WORLD_VERSION then
		return false
	end
	-- the middle of plot 1 must be flat ground at the plot's height
	local o = Grid.plotOrigin(1)
	local hit = groundAt(o.X + Grid.PLOT_SIZE / 2, o.Z + Grid.PLOT_SIZE / 2)
	if not hit or math.abs(hit.Position.Y - TOP) > 2.5 then
		return false
	end
	-- and the ships' moorings must be out on the water
	local sea = groundAt(o.X + Grid.PLOT_SIZE * 0.25 + 9, -62)
	return sea ~= nil and sea.Material == M.Water
end

-- Makes the ground level under a building's footprint (sizes along world X and Z): digs out any hill
-- poking up into it and fills any dip, so nothing is half-buried or floating.
function WorldService:LevelUnder(cf: CFrame, sizeX: number, sizeZ: number)
	local pos = cf.Position
	local w, d = sizeX + 4, sizeZ + 4
	pcall(function()
		Terrain:FillBlock(CFrame.new(pos.X, TOP + 30, pos.Z), Vector3.new(w, 60, d), M.Air)
		Terrain:FillBlock(CFrame.new(pos.X, TOP - 4, pos.Z), Vector3.new(w, 8, d), M.Ground)
	end)
end

-- The highest ground under a footprint centred on `pos` (sizes in studs),
-- sampled at the middle and near each corner.
function WorldService:GroundUnder(pos: Vector3, sizeX: number, sizeZ: number): number
	local best = -math.huge
	local hx, hz = math.max(sizeX / 2 - 1.5, 0), math.max(sizeZ / 2 - 1.5, 0)
	for _, o in { Vector2.new(0, 0), Vector2.new(hx, hz), Vector2.new(-hx, hz), Vector2.new(hx, -hz), Vector2.new(-hx, -hz) } do
		best = math.max(best, self:GroundHeight(pos.X + o.X, pos.Z + o.Y))
	end
	return best
end

function WorldService:Init()
	clearPlaceholders()
	shareRivers()
	if workspace:GetAttribute("WorldBaked") and not bakedValleyFits() then
		-- saved by an older version of the game: its hills and shore no longer
		-- match where plots, docks and ships go, so make the valley fresh
		warn("[WorldService] the saved valley is from an older version: building a new one")
		workspace:SetAttribute("WorldBaked", nil)
		for _, name in { "Scenery", "ShoreFoam" } do
			local old = workspace:FindFirstChild(name)
			if old then
				old:Destroy()
			end
		end
		Terrain:Clear()
	end
	if workspace:GetAttribute("WorldBaked") then
		if hasGround() then
			-- The valley was saved into the place (see Bake), so whatever you
			-- changed in Studio is kept: nothing is regenerated.
			print("[WorldService] using the saved valley")
			return
		end
		-- marked as saved, but the terrain is empty: build it after all
		warn("[WorldService] the place says the valley is saved, but there is no ground: building it")
		workspace:SetAttribute("WorldBaked", nil)
	end
	setupLighting()
	buildTerrainSafely()
	shareRivers()
	scatterScenery()
	buildLandings()
	print("[WorldService] valley built")
end

-- Builds the valley in Studio edit mode, so it is saved in the place file
-- and can be edited by hand. Run through EditTools.Setup().
function WorldService:Bake()
	clearPlaceholders()
	for _, name in { "Scenery", "ShoreFoam" } do
		local old = workspace:FindFirstChild(name)
		if old then
			old:Destroy()
		end
	end
	Terrain:Clear()
	setupLighting()
	buildTerrain()
	scatterScenery()
	buildLandings()
	workspace:SetAttribute("WorldBaked", true)
	workspace:SetAttribute("WorldVersion", WORLD_VERSION)
end

function WorldService:Start()
	sailingShip()
	dayNightCycle()
end

-- Height of the terrain surface at x, z, where it is really drawn (terrain
-- voxels can leave it a little above GROUND_Y). Water counts as ground.
function WorldService:GroundHeight(x: number, z: number): number
	local hit = groundAt(x, z)
	return hit and hit.Position.Y or TOP
end

return WorldService
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="44">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="45">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="46">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[--[[
	Client entry point.
	Loads every ModuleScript in the Controllers folder, then calls :Init()
	and :Start() on each, the same pattern as the server.
]]

local controllersFolder = script:WaitForChild("Controllers")

local controllers = {}
for _, module in controllersFolder:GetChildren() do
	if module:IsA("ModuleScript") then
		controllers[module.Name] = require(module)
	end
end

for _, controller in controllers do
	if controller.Init then
		controller:Init(controllers)
	end
end

for _, controller in controllers do
	if controller.Start then
		task.spawn(function()
			controller:Start()
		end)
	end
end
]]></string>
        </Properties>
        <Item class="Folder" referent="47">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="48">
            <Properties>
              <string name="Name">AmbienceController</string>
              <string name="Source"><![CDATA[--[[
	AmbienceController
	Little touches of life that only need to run on your screen:
	  - shoreline foam gently washes in and out
	  - gulls circle lazily over the fjord
]]

local RunService = game:GetService("RunService")

local AmbienceController = {}

local GULLS = 14

local function makeGull(): Model
	local model = Instance.new("Model")
	model.Name = "Gull"
	local body = Instance.new("Part")
	body.Name = "Body"
	body.Anchored = true
	body.CanCollide = false
	body.CanQuery = false
	body.CastShadow = false
	body.Size = Vector3.new(0.5, 0.45, 1.4)
	body.Color = Color3.fromRGB(240, 240, 236)
	body.Parent = model
	for _, side in { -1, 1 } do
		local wing = Instance.new("Part")
		wing.Name = side < 0 and "WingL" or "WingR"
		wing.Anchored = true
		wing.CanCollide = false
		wing.CanQuery = false
		wing.CastShadow = false
		wing.Size = Vector3.new(2.2, 0.08, 0.7)
		wing.Color = Color3.fromRGB(225, 228, 230)
		wing.Parent = model
	end
	model.PrimaryPart = body
	return model
end

function AmbienceController:Start()
	-- Wait for the server to finish building the shore.
	local foamFolder = workspace:WaitForChild("ShoreFoam", 120)
	local foam = {}
	if foamFolder then
		for _, part in foamFolder:GetChildren() do
			if part:IsA("BasePart") then
				table.insert(foam, { part = part, base = part.CFrame, alpha = part.Transparency, phase = math.random() * math.pi * 2 })
			end
		end
	end

	local folder = Instance.new("Folder")
	folder.Name = "Gulls"
	folder.Parent = workspace
	local gulls = {}
	for i = 1, GULLS do
		local model = makeGull()
		model.Parent = folder
		gulls[i] = {
			model = model,
			center = Vector3.new(math.random(-200, 1800), math.random(28, 60), math.random(-360, -90)),
			radius = math.random(30, 90),
			speed = (math.random() * 0.15 + 0.1) * (math.random() < 0.5 and -1 or 1),
			angle = math.random() * math.pi * 2,
			flap = math.random() * 10,
		}
	end

	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		local now = os.clock()

		for _, g in gulls do
			g.angle += g.speed * dt
			local pos = g.center + Vector3.new(math.cos(g.angle) * g.radius, math.sin(now * 0.4 + g.flap) * 3, math.sin(g.angle) * g.radius)
			local ahead = g.center + Vector3.new(math.cos(g.angle + 0.05 * math.sign(g.speed)) * g.radius, 0, math.sin(g.angle + 0.05 * math.sign(g.speed)) * g.radius)
			local cf = CFrame.lookAt(pos, Vector3.new(ahead.X, pos.Y, ahead.Z)) * CFrame.Angles(0, 0, math.sign(g.speed) * 0.35)
			local flap = math.sin(now * 6 + g.flap) * 0.5
			local model = g.model
			model.Body.CFrame = cf
			model.WingL.CFrame = cf * CFrame.new(-0.25, 0, 0) * CFrame.Angles(0, 0, -flap) * CFrame.new(-1.1, 0, 0)
			model.WingR.CFrame = cf * CFrame.new(0.25, 0, 0) * CFrame.Angles(0, 0, flap) * CFrame.new(1.1, 0, 0)
		end

		-- foam only needs ~15 updates a second
		accumulator += dt
		if accumulator < 1 / 15 then
			return
		end
		accumulator = 0
		local camPos = workspace.CurrentCamera.CFrame.Position
		for _, f in foam do
			if (f.base.Position - camPos).Magnitude > 450 then
				continue -- too far away to notice
			end
			local wave = math.sin(now * 0.9 + f.phase)
			f.part.Transparency = math.clamp(f.alpha + wave * 0.18, 0, 0.97)
			f.part.CFrame = f.base * CFrame.new(0, 0, wave * 0.6)
		end
	end)
end

return AmbienceController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="49">
            <Properties>
              <string name="Name">AudioController</string>
              <string name="Source"><![CDATA[--[[
	AudioController
	Background sound on your own screen: music, wind, birds by day and the
	sea getting louder as you walk down to the fjord. Which sounds play is
	set in ReplicatedStorage > Shared > Sounds.
]]

local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Sounds = require(Shared.Sounds)

local AudioController = {}

-- The game's theme, "Over the Fjord" (music/VikingTheme.ogg in the project).
-- Once it's imported into Studio it shows up as a Sound named VikingTheme;
-- otherwise the Music slot in Sounds is used, if it has an ID.
local function themeId(): string?
	local uploaded = require(game:GetService("ReplicatedStorage").Shared.AssetIds).sound("VikingTheme")
	if uploaded then
		return uploaded
	end
	for _, root in { workspace, game:GetService("ReplicatedStorage"), SoundService } do
		for _, d in root:GetDescendants() do
			if d:IsA("Sound") and string.find(d.Name, "VikingTheme") and d.SoundId ~= "" then
				return d.SoundId
			end
		end
	end
	local slot = Sounds.Slots.Music
	return slot and slot.Id ~= "" and slot.Id or nil
end

local theme: Sound?
local themeStarted = false

-- Plays the theme now (the title screen), then again now and then: a quiet
-- stretch of wind and birds between plays keeps it from wearing thin.
function AudioController:PlayTheme()
	if themeStarted then
		return
	end
	local id = themeId()
	if not id then
		return
	end
	themeStarted = true
	theme = Instance.new("Sound")
	theme.Name = "Theme"
	theme.SoundId = id
	theme.Volume = (Sounds.Slots.Music and Sounds.Slots.Music.Volume) or 0.3
	theme.Parent = SoundService
	task.spawn(function()
		while theme and theme.Parent do
			theme:Play()
			theme.Ended:Wait()
			task.wait(math.random(70, 150))
		end
	end)
end

function AudioController:Start()
	local folder = Instance.new("Folder")
	folder.Name = "Ambience"
	folder.Parent = SoundService
	task.delay(8, function()
		AudioController:PlayTheme() -- in case the title screen didn't start it
	end)
	local wind = Sounds.loop("Wind", folder)
	local birds = Sounds.loop("Birds", folder)
	local waves = Sounds.loop("Waves", folder)
	local base = {}
	for _, s in { wind, birds, waves } do
		if s then
			base[s] = s.Volume
		end
	end

	local camera = workspace.CurrentCamera
	RunService.Heartbeat:Connect(function()
		local pos = camera and camera.CFrame.Position or Vector3.zero
		if waves then
			-- the shore starts around z = -40; full volume out on the water
			local t = math.clamp((40 - pos.Z) / 120, 0.1, 1)
			waves.Volume = base[waves] * t
		end
		if birds then
			local hour = Lighting.ClockTime
			local day = (hour > 6 and hour < 19) and 1 or 0
			if workspace:GetAttribute("Season") == "Winter" then
				day *= 0.2
			end
			birds.Volume += (base[birds] * day - birds.Volume) * 0.02
		end
		if wind then
			-- windier up high and in winter
			local t = math.clamp(0.6 + pos.Y / 200, 0.6, 1.6) * (workspace:GetAttribute("Season") == "Winter" and 1.4 or 1)
			wind.Volume = base[wind] * t
		end
	end)
end

return AudioController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="50">
            <Properties>
              <string name="Name">AuroraController</string>
              <string name="Source"><![CDATA[--[[
	AuroraController
	Northern lights over the mountains on clear nights in autumn and winter:
	tall green and violet curtains that ripple slowly across the sky.
	Drawn only on your own screen.
]]

local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")

local AuroraController = {}

local BANDS = 3
local STRIPS = 46 -- narrow upright strips per band: together they ripple

local function strength(): number
	local clock = Lighting.ClockTime
	local night = 0
	if clock >= 20 or clock < 5 then
		local h = clock >= 20 and clock - 20 or clock + 4
		night = math.clamp(math.min(h, 9 - h) / 1.2, 0, 1)
	end
	local season = workspace:GetAttribute("Season")
	local seasonal = (season == "Winter" and 1) or (season == "Autumn" and 0.6) or (season == "Spring" and 0.25) or 0
	-- clouds and storms hide it
	local fog = workspace:GetAttribute("FogLevel") or 0
	local storm = workspace:GetAttribute("StormLevel") or 0
	return night * seasonal * (1 - math.max(fog, storm))
end

function AuroraController:Start()
	local folder = Instance.new("Folder")
	folder.Name = "Aurora"
	local strips = {}
	for b = 1, BANDS do
		local band = {
			z = 820 + b * 120, -- just behind the mountains
			x0 = -700 + b * 200,
			width = 3000 - b * 300,
			height = 220 + b * 50,
			base = 330 + b * 50,
			phase = b * 1.7,
			color = (b == 2) and Color3.fromRGB(150, 110, 255) or Color3.fromRGB(90, 255, 160),
			strips = {},
		}
		for s = 1, STRIPS do
			local p = Instance.new("Part")
			p.Name = "AuroraStrip"
			p.Anchored = true
			p.CanCollide = false
			p.CanQuery = false
			p.CanTouch = false
			p.CastShadow = false
			p.Material = Enum.Material.Neon
			p.Color = band.color
			p.Transparency = 1
			p.Size = Vector3.new(band.width / STRIPS + 6, band.height, 0.4)
			p.Parent = folder
			table.insert(band.strips, { part = p, u = (s - 0.5) / STRIPS })
		end
		table.insert(strips, band)
	end
	folder.Parent = workspace.CurrentCamera

	local shown = 0
	local acc = 0
	RunService.RenderStepped:Connect(function(dt)
		acc += dt
		if acc < 1 / 20 then
			return
		end
		acc = 0
		local target = strength()
		shown += (target - shown) * 0.02
		local t = os.clock()
		for _, band in strips do
			for _, s in band.strips do
				local p = s.part
				if shown < 0.02 then
					if p.Transparency < 1 then
						p.Transparency = 1
					end
				else
					local u = s.u
					local x = band.x0 + u * band.width
					local wave = math.sin(u * 7 + t * 0.15 + band.phase) * 140 + math.sin(u * 17 - t * 0.27) * 40
					local glow = (0.5 + 0.5 * math.sin(u * 11 + t * 0.4 + band.phase)) * (0.6 + 0.4 * math.sin(u * 3.1 - t * 0.2))
					local y = band.base + math.sin(u * 5 + t * 0.2) * 30
					p.CFrame = CFrame.new(x, y, band.z + wave) * CFrame.Angles(0, math.sin(u * 9 + t * 0.1) * 0.35, 0)
					p.Transparency = 1 - math.clamp(shown * glow * 0.55, 0, 0.55)
				end
			end
		end
	end)
end

return AuroraController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="51">
            <Properties>
              <string name="Name">BoatController</string>
              <string name="Source"><![CDATA[--[[
	BoatController
	While you sit at a boat's helm, sends your W/A/S/D (or arrow keys) to the
	server, which moves the boat. F looses a volley of arrows.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Remotes = require(Shared.Remotes)

local BoatController = {}

local player = Players.LocalPlayer

-- set by the on-screen buttons on phones and tablets (TouchController)
BoatController.TouchThrottle = 0
BoatController.TouchSteer = 0

local function down(...)
	for _, key in { ... } do
		if UserInputService:IsKeyDown(key) then
			return true
		end
	end
	return false
end

function BoatController:Volley()
	Remotes.BoatFire:FireServer()
end

local function atHelm(): boolean
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local seat = humanoid and humanoid.SeatPart
	return seat ~= nil and seat:GetAttribute("Boat") == true
end

BoatController.AtHelm = atHelm

function BoatController:Start()
	UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and input.KeyCode == Enum.KeyCode.F and atHelm() then
			Remotes.BoatFire:FireServer()
		end
	end)

	local last = { 0, 0 }
	local timer = 0
	RunService.Heartbeat:Connect(function(dt)
		local character = player.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		local seat = humanoid and humanoid.SeatPart
		if not seat or not seat:GetAttribute("Boat") then
			return
		end
		if UserInputService:GetFocusedTextBox() then
			return
		end
		local K = Enum.KeyCode
		local throttle = math.clamp((down(K.W, K.Up) and 1 or 0) - (down(K.S, K.Down) and 1 or 0) + BoatController.TouchThrottle, -1, 1)
		local steer = math.clamp((down(K.D, K.Right) and 1 or 0) - (down(K.A, K.Left) and 1 or 0) + BoatController.TouchSteer, -1, 1)
		timer += dt
		if throttle ~= last[1] or steer ~= last[2] or timer > 0.5 then
			timer = 0
			last = { throttle, steer }
			Remotes.BoatInput:FireServer(throttle, steer)
		end
	end)
end

return BoatController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="52">
            <Properties>
              <string name="Name">BuildController</string>
              <string name="Source"><![CDATA[--[[
	BuildController
	Placement mode: shows a see-through preview of the chosen building that
	snaps to your plot's grid. Green = you can build there, red = you can't.
	Click to build, R to rotate, Q to cancel.

	Demolish mode: hover one of your buildings (it turns red) and click.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Grid = require(Shared.Grid)
local Pointer = require(Shared.Pointer)
local Remotes = require(Shared.Remotes)
local ModelFactory = require(Shared.ModelFactory)

local BuildController = {}

local modeChanged = Instance.new("BindableEvent")
BuildController.ModeChanged = modeChanged.Event

local player = Players.LocalPlayer
local controllers

local mode = nil -- nil | { kind = "place", type = string } | { kind = "demolish" }
local rot = 0
local ghost: Model? = nil
local highlight: Highlight
local current = nil -- placement candidate { cx, cz, ok } or demolish target model
local busy = false

local GOOD = Color3.fromRGB(90, 220, 110)
local BAD = Color3.fromRGB(235, 80, 70)

local function plotGround(): BasePart?
	local index = player:GetAttribute("PlotIndex")
	local plots = workspace:FindFirstChild("Plots")
	local plot = index and plots and plots:FindFirstChild("Plot_" .. index)
	return plot and plot:FindFirstChild("Ground")
end

local function mouseRay(): (Vector3, Vector3)
	local camera = workspace.CurrentCamera
	local pos = Pointer.location()
	local ray = camera:ViewportPointToRay(pos.X, pos.Y)
	return ray.Origin, ray.Direction * 1000
end

local function clearGhost()
	if ghost then
		ghost:Destroy()
		ghost = nil
	end
	highlight.Adornee = nil
	current = nil
end

-- Faint grid lines over your plot while you are placing something.
local gridLines: Folder? = nil
local function showGrid(visible: boolean)
	if gridLines then
		gridLines:Destroy()
		gridLines = nil
	end
	local origin = player:GetAttribute("PlotOrigin")
	if not visible or not origin then
		return
	end
	gridLines = Instance.new("Folder")
	gridLines.Name = "BuildGrid"
	local state = controllers.StateController.State
	local minX, minZ, maxX, maxZ = Grid.bounds(state and state.land)
	local corner = origin + Vector3.new(minX * Config.CELL, 0, minZ * Config.CELL)
	local sizeX, sizeZ = (maxX - minX) * Config.CELL, (maxZ - minZ) * Config.CELL
	for axis = 1, 2 do
		for i = 0, (axis == 1 and (maxX - minX) or (maxZ - minZ)) do
			local line = Instance.new("Part")
			line.Anchored = true
			line.CanCollide = false
			line.CanQuery = false
			line.CastShadow = false
			line.Material = Enum.Material.Neon
			line.Color = Color3.fromRGB(255, 236, 190)
			line.Transparency = 0.82
			local offset = i * Config.CELL
			if axis == 1 then
				line.Size = Vector3.new(0.12, 0.05, sizeZ)
				line.Position = corner + Vector3.new(offset, 0.08, sizeZ / 2)
			else
				line.Size = Vector3.new(sizeX, 0.05, 0.12)
				line.Position = corner + Vector3.new(sizeX / 2, 0.08, offset)
			end
			line.Parent = gridLines
		end
	end
	gridLines.Parent = workspace
end

local function setMode(newMode)
	clearGhost()
	mode = newMode
	showGrid(mode ~= nil and mode.kind == "place")
	if mode and mode.kind == "place" then
		ghost = ModelFactory.building(mode.type)
		ModelFactory.makeGhost(ghost)
		ghost.Parent = workspace
		highlight.Adornee = ghost
	end
	modeChanged:Fire(mode)
end

function BuildController:SelectBuild(buildingType: string)
	if mode and mode.type == buildingType then
		setMode(nil) -- clicking the same button again cancels
	else
		setMode({ kind = "place", type = buildingType })
	end
end

function BuildController:SelectDemolish()
	if mode and mode.kind == "demolish" then
		setMode(nil)
	else
		setMode({ kind = "demolish" })
	end
end

function BuildController:Cancel()
	setMode(nil)
end

local function updatePlacement()
	local ground = plotGround()
	local origin = player:GetAttribute("PlotOrigin")
	if not ground or not origin or not ghost then
		return
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { ground }
	local from, dir = mouseRay()
	local hit = workspace:Raycast(from, dir, params)
	if not hit then
		ghost.Parent = nil
		current = nil
		return
	end
	ghost.Parent = workspace

	local r = Config.Buildings[mode.type].Shore and 0 or rot -- a jetty always points out to sea
	local sx, sz = Grid.footprint(mode.type, r)
	local cx, cz = Grid.worldToCell(origin, hit.Position, sx, sz)
	-- keep the preview inside the plot so it doesn't jump off the edge
	local state = controllers.StateController.State
	local land = state and state.land
	local minX, minZ, maxX, maxZ = Grid.bounds(land)
	cx = math.clamp(cx, minX, maxX - sx)
	cz = math.clamp(cz, minZ, maxZ - sz)

	local free = Grid.canPlace(controllers.StateController.Blocked, cx, cz, sx, sz, land, mode.type)
	local affordable = state ~= nil and Grid.canAfford(state.resources, Config.Buildings[mode.type].Cost)
	local ok = free and affordable

	ghost:PivotTo(Grid.buildingCFrame(origin, cx, cz, sx, sz, r))
	highlight.FillColor = ok and GOOD or BAD
	highlight.OutlineColor = ok and GOOD or BAD
	current = { cx = cx, cz = cz, ok = ok, affordable = affordable }
end

local function findOwnBuilding(inst: Instance?): Model?
	while inst and inst ~= workspace do
		if inst:IsA("Model") and inst:GetAttribute("BuildingId") then
			if inst:GetAttribute("OwnerUserId") == player.UserId then
				return inst
			end
			return nil
		end
		inst = inst.Parent
	end
	return nil
end

local function updateDemolish()
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { player.Character }
	local from, dir = mouseRay()
	local hit = workspace:Raycast(from, dir, params)
	local target = hit and findOwnBuilding(hit.Instance)
	current = target
	highlight.Adornee = target
	highlight.FillColor = BAD
	highlight.OutlineColor = BAD
end

local function confirm()
	if busy or not mode then
		return
	end
	local StateController = controllers.StateController
	if mode.kind == "place" then
		if not current then
			return
		end
		if not current.affordable then
			StateController:LocalNotify("Not enough resources for " .. Config.Buildings[mode.type].Display, "bad")
			return
		end
		if not current.ok then
			StateController:LocalNotify("Can't build there. Clear trees and rocks first.", "bad")
			return
		end
		busy = true
		local ok, msg = Remotes.PlaceBuilding:InvokeServer(mode.type, current.cx, current.cz, rot)
		busy = false
		StateController:LocalNotify(msg, ok and "good" or "bad")
		-- stay in placement mode so you can place several in a row
	elseif mode.kind == "demolish" then
		if not current then
			return
		end
		busy = true
		local ok, msg = Remotes.DemolishBuilding:InvokeServer(current:GetAttribute("BuildingId"))
		busy = false
		StateController:LocalNotify(msg, ok and "good" or "bad")
	end
end

-- For the touch buttons (TouchController).
function BuildController:Confirm()
	confirm()
end

function BuildController:Rotate()
	if mode and mode.kind == "place" then
		rot = (rot + 1) % 4
	end
end

function BuildController:Mode()
	return mode
end

function BuildController:Init(allControllers)
	controllers = allControllers
end

function BuildController:Start()
	highlight = Instance.new("Highlight")
	highlight.Name = "BuildHighlight"
	highlight.FillTransparency = 0.55
	highlight.OutlineTransparency = 0
	highlight.DepthMode = Enum.HighlightDepthMode.Occluded
	highlight.Enabled = false
	-- Parent it to a plain Folder: a Highlight with no Adornee lights up its
	-- parent, and we never want that to be the whole workspace.
	local fx = Instance.new("Folder")
	fx.Name = "ClientBuildFX"
	fx.Parent = workspace
	highlight.Parent = fx
	highlight:GetPropertyChangedSignal("Adornee"):Connect(function()
		highlight.Enabled = highlight.Adornee ~= nil
	end)

	RunService.RenderStepped:Connect(function()
		if not mode then
			return
		end
		if mode.kind == "place" then
			updatePlacement()
		else
			updateDemolish()
		end
	end)

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			confirm()
		elseif input.UserInputType == Enum.UserInputType.Touch then
			-- on a touch screen a tap moves the preview; the Place button builds
			-- (TouchController), so a stray tap never spends your wood
			return
		elseif input.KeyCode == Enum.KeyCode.R and mode and mode.kind == "place" then
			rot = (rot + 1) % 4
		elseif input.KeyCode == Enum.KeyCode.Q and mode then
			setMode(nil)
		end
	end)
end

return BuildController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="53">
            <Properties>
              <string name="Name">CameraController</string>
              <string name="Source"><![CDATA[--[[
	CameraController
	A city-builder camera that follows your character from high above at an
	angle, like looking down over your village.

	  Mouse wheel        zoom in / out
	  Right mouse drag   turn and tilt the view
	  V                  switch to the normal Roblox camera and back
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local CameraController = {}
CameraController.Suspended = false -- the title screen and intro drive the camera

local player = Players.LocalPlayer

local enabled = true
local yaw = math.pi -- looking from the lake toward the mountains (+Z)
local pitch = math.rad(48)
local distance = 75
local targetDistance = 75
local focus: Vector3? = nil
local rotating = false

local MIN_DIST, MAX_DIST = 18, 260
local MIN_PITCH, MAX_PITCH = math.rad(15), math.rad(82)

function CameraController:IsEnabled(): boolean
	return enabled
end

function CameraController:Toggle()
	enabled = not enabled
	if not enabled then
		workspace.CurrentCamera.CameraType = Enum.CameraType.Custom
	end
end

function CameraController:Start()
	local camera = workspace.CurrentCamera

	-- phones and tablets: pinch to zoom, twist two fingers to turn,
	-- drag two fingers up or down to tilt
	local pinchStart = targetDistance
	UserInputService.TouchPinch:Connect(function(_, scale, _, state, processed)
		if not enabled or processed then
			return
		end
		if state == Enum.UserInputState.Begin then
			pinchStart = targetDistance
		end
		targetDistance = math.clamp(pinchStart / math.max(scale, 0.05), MIN_DIST, MAX_DIST)
	end)
	local rotateStart = yaw
	UserInputService.TouchRotate:Connect(function(_, rotation, _, state, processed)
		if not enabled or processed then
			return
		end
		if state == Enum.UserInputState.Begin then
			rotateStart = yaw
		end
		yaw = rotateStart - math.rad(rotation)
	end)
	local panStart = pitch
	UserInputService.TouchPan:Connect(function(positions, translation, _, state, processed)
		if not enabled or processed or #positions < 2 then
			return
		end
		if state == Enum.UserInputState.Begin then
			panStart = pitch
		end
		pitch = math.clamp(panStart + translation.Y * 0.005, MIN_PITCH, MAX_PITCH)
	end)

	UserInputService.InputBegan:Connect(function(input, processed)
		if input.UserInputType == Enum.UserInputType.MouseButton2 and enabled then
			rotating = true
			UserInputService.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
		elseif input.KeyCode == Enum.KeyCode.V and not processed then
			CameraController:Toggle()
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton2 then
			rotating = false
			UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		end
	end)
	UserInputService.InputChanged:Connect(function(input, processed)
		if not enabled then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseWheel and not processed then
			targetDistance = math.clamp(targetDistance * (1 - input.Position.Z * 0.12), MIN_DIST, MAX_DIST)
		elseif input.UserInputType == Enum.UserInputType.MouseMovement and rotating then
			yaw -= input.Delta.X * 0.008
			pitch = math.clamp(pitch + input.Delta.Y * 0.006, MIN_PITCH, MAX_PITCH)
		end
	end)

	RunService:BindToRenderStep("VikingCamera", Enum.RenderPriority.Camera.Value + 1, function(dt)
		if not enabled or CameraController.Suspended then
			return
		end
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if not root then
			return
		end
		camera.CameraType = Enum.CameraType.Scriptable
		local target = root.Position
		focus = focus and focus:Lerp(target, math.min(1, dt * 8)) or target
		distance += (targetDistance - distance) * math.min(1, dt * 10)
		-- lower the angle a little when zoomed in close, like a tilt-shift view
		local p = pitch - math.rad(18) * (1 - (distance - MIN_DIST) / (MAX_DIST - MIN_DIST)) ^ 3
		camera.CFrame = CFrame.new(focus) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(-p, 0, 0) * CFrame.new(0, 0, distance)
	end)
end

return CameraController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="54">
            <Properties>
              <string name="Name">CouncilController</string>
              <string name="Source"><![CDATA[--[[
	CouncilController
	The Jarl's Table: press J (or the button under the colony panel).
	Four tabs:
	  Land       buy the next, bigger stage of land
	  War band   hire warriors, give orders, send them on expeditions
	  Diplomacy  gifts, tribute, alliances and trade deals with the holds
	  Rites      feasts and the season's blót
	Also shows the report when the war band comes home from an expedition.
	Everything it shows comes from state.council (CouncilService on the server).
]]

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Grid = require(Shared.Grid)
local Remotes = require(Shared.Remotes)

local CouncilController = {}

local controllers
local player = Players.LocalPlayer

local THEME = {
	Panel = Color3.fromRGB(20, 20, 22),
	Card = Color3.fromRGB(38, 38, 41),
	Button = Color3.fromRGB(60, 55, 48),
	ButtonOff = Color3.fromRGB(30, 30, 32),
	Accent = Color3.fromRGB(226, 206, 160),
	Text = Color3.fromRGB(238, 234, 226),
	Muted = Color3.fromRGB(156, 152, 146),
	Good = Color3.fromRGB(130, 200, 110),
	Bad = Color3.fromRGB(230, 110, 96),
}

local TABS = {
	{ id = "land", title = "🗺  Land" },
	{ id = "warband", title = "⚔️  War band" },
	{ id = "diplomacy", title = "🤝  Diplomacy" },
	{ id = "rites", title = "🔥  Rites" },
}

local function new(className, props)
	local inst = Instance.new(className)
	for k, v in props do
		if k ~= "Parent" then
			inst[k] = v
		end
	end
	inst.Parent = props.Parent
	return inst
end

local function corner(parent, r)
	new("UICorner", { CornerRadius = UDim.new(0, r or 8), Parent = parent })
end

local function text(parent, str: string, props)
	local defaults = {
		Size = UDim2.new(1, 0, 0, 20),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamMedium,
		TextSize = 15,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = THEME.Text,
		Text = str,
		Parent = parent,
	}
	for k, v in props or {} do
		defaults[k] = v
	end
	return new("TextLabel", defaults)
end

-- Sends an action to the server and shows the answer as a toast.
local function act(action: string, arg: string?)
	local ok, msg = Remotes.Council:InvokeServer(action, arg)
	if msg then
		controllers.StateController:LocalNotify(msg, ok and "good" or "bad")
	end
end

local function button(parent, label: string, enabled: boolean, onClick, width: number?)
	local b = new("TextButton", {
		Size = UDim2.fromOffset(width or 170, 34),
		BackgroundColor3 = enabled and THEME.Button or THEME.ButtonOff,
		AutoButtonColor = enabled,
		Font = Enum.Font.GothamBold,
		TextSize = 14,
		TextColor3 = enabled and THEME.Accent or THEME.Muted,
		Text = label,
		Parent = parent,
	})
	corner(b, 6)
	b.Activated:Connect(function()
		-- disabled buttons still ask the server, which explains what's missing
		onClick()
	end)
	return b
end

local function row(parent, order: number)
	local f = new("Frame", { Size = UDim2.new(1, 0, 0, 34), BackgroundTransparency = 1, LayoutOrder = order, Parent = parent })
	new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), Parent = f })
	return f
end

local function card(parent, order: number)
	local c = new("Frame", {
		Size = UDim2.new(1, -8, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = THEME.Card,
		LayoutOrder = order,
		Parent = parent,
	})
	corner(c)
	new("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12), PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 10), Parent = c })
	new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = c })
	return c
end

local function have(state, cost): boolean
	return state ~= nil and cost ~= nil and Grid.canAfford(state.resources, cost)
end

-- Tab builders ------------------------------------------------------------------

local function buildLand(body, state)
	local land = state.council.land
	local c = card(body, 1)
	text(c, "Your land: " .. land.name, { Font = Enum.Font.GothamBold, TextSize = 18, TextColor3 = THEME.Accent, LayoutOrder = 1 })
	text(c, "Size " .. land.size .. " cells. The border stakes show where it ends.", { TextColor3 = THEME.Muted, LayoutOrder = 2 })
	local n = card(body, 2)
	if land.nextName then
		text(n, "Next: " .. land.nextName .. "  (" .. land.nextSize .. " cells)", { Font = Enum.Font.GothamBold, TextSize = 17, LayoutOrder = 1 })
		local need = Grid.costText(land.nextCost)
		if land.nextRank then
			need ..= "   ·   rank " .. land.nextRank
		end
		text(n, "Costs " .. need, { TextColor3 = have(state, land.nextCost) and THEME.Good or THEME.Bad, LayoutOrder = 2 })
		if land.blocker then
			text(n, land.blocker, { TextColor3 = THEME.Muted, TextSize = 13, LayoutOrder = 3 })
		end
		local r = row(n, 4)
		button(r, "Buy land", land.blocker == nil, function()
			act("BuyLand")
		end)
	else
		text(n, "Your land is as big as it can grow. A true Great Steading!", { TextColor3 = THEME.Good, LayoutOrder = 1 })
	end
	text(body, "Bigger land grows toward the meadow and into the gaps beside your plot. It never touches a neighbour.", { TextColor3 = THEME.Muted, TextSize = 13, LayoutOrder = 3 })

	-- clan colours for your banners and sail
	local cc = card(body, 4)
	text(cc, "Clan colours", { Font = Enum.Font.GothamBold, TextSize = 16, TextColor3 = THEME.Accent, LayoutOrder = 1 })
	text(cc, "They fly on your banners, your Great Hall's standards and your longship's sail.", { TextSize = 13, TextColor3 = THEME.Muted, LayoutOrder = 2 })
	local cr = row(cc, 3)
	local current = state.council.clan or "Blood"
	for _, clan in Config.ClanColours do
		local on = clan.Name == current
		local b = button(cr, (on and "» " or "") .. clan.Label, not on, function()
			act("Colours", clan.Name)
		end, 128)
		local swatch = Instance.new("Frame")
		swatch.Size = UDim2.new(0, 6, 1, -8)
		swatch.Position = UDim2.fromOffset(4, 4)
		swatch.BackgroundColor3 = clan.Main
		swatch.BorderSizePixel = 0
		swatch.Parent = b
	end
end

local function buildWarband(body, state)
	local w = state.council.warband
	local c = card(body, 1)
	local modeText = ({ home = "guarding the village", follow = "following you", away = "away raiding " .. tostring(w.target) })[w.mode] or w.mode
	text(c, "War band: " .. w.count .. " / " .. w.max .. " warriors, " .. modeText, { Font = Enum.Font.GothamBold, TextSize = 17, TextColor3 = THEME.Accent, LayoutOrder = 1 })
	if w.mode == "away" and w.secondsLeft then
		text(c, "Back in about " .. math.max(1, math.ceil(w.secondsLeft / 60)) .. " min (" .. w.secondsLeft .. " s).", { TextColor3 = THEME.Muted, LayoutOrder = 2 })
	end
	local names = {}
	for _, m in w.members do
		table.insert(names, m.name .. (m.away and "" or (" " .. m.hp .. "%")))
	end
	text(c, #names > 0 and table.concat(names, ",  ") or "No warriors yet. Hire grown villagers below; they stop working while they serve.", { TextSize = 13, TextColor3 = THEME.Muted, LayoutOrder = 3 })
	local r = row(c, 4)
	button(r, "Hire (" .. Grid.costText(w.hireCost) .. ")", w.mode ~= "away" and w.count < w.max and have(state, w.hireCost), function()
		act("Hire")
	end, 210)
	button(r, "Dismiss one", w.mode ~= "away" and w.count > 0, function()
		act("Dismiss")
	end, 130)
	local r2 = row(c, 5)
	button(r2, "Follow me", w.mode == "home" and w.count > 0, function()
		act("Follow")
	end, 150)
	button(r2, "Guard the village", w.mode == "follow", function()
		act("StayHome")
	end, 180)
	local r4 = row(c, 6)
	for _, key in { "loose", "wall", "wedge" } do
		local f = Config.Formations[key]
		local on = w.formation == key and w.mode == "follow"
		button(r4, (on and "» " or "") .. f.Label, w.mode ~= "away" and w.count > 0 and not on, function()
			act("Formation", key)
		end, 140)
	end
	local f = Config.Formations[w.formation or "loose"]
	text(c, "Formation: " .. f.Label .. ", " .. f.Text .. ". Press G in the field to switch.", { TextSize = 12, TextColor3 = THEME.Muted, LayoutOrder = 7 })
	text(c, "Following warriors fight beside you and row your longship: faster ship, one more arrow each per volley. At a rival hold they hack at the gate with you; a wedge rams it twice as hard.", { TextSize = 12, TextColor3 = THEME.Muted, LayoutOrder = 8 })

	local e = card(body, 2)
	text(e, "Send them raiding on their own (strength " .. w.power .. ")", { Font = Enum.Font.GothamBold, TextSize = 16, LayoutOrder = 1 })
	text(e, "They're away a few minutes and bring back loot, so you can stay home and build. Some may not come back.", { TextSize = 13, TextColor3 = THEME.Muted, LayoutOrder = 2 })
	for i, t in w.targets do
		local r3 = row(e, 2 + i)
		local label = t.name .. (t.sea and " (by sea)" or "") .. "   ·   " .. (t.allied and "ally" or (t.chance .. "% to win"))
		text(r3, label, { Size = UDim2.new(0, 330, 0, 34), AutomaticSize = Enum.AutomaticSize.None, TextColor3 = t.allied and THEME.Muted or (t.chance >= 50 and THEME.Good or THEME.Bad) })
		button(r3, "Send", w.mode ~= "away" and w.count > 0 and not t.allied, function()
			act("Expedition", t.name)
		end, 90)
	end
end

local function moodWord(m: number): string
	if m >= 60 then
		return "friendly"
	elseif m >= 30 then
		return "warm"
	elseif m > -30 then
		return "wary"
	elseif m > -60 then
		return "hostile"
	end
	return "blood feud"
end

local function buildDiplomacy(body, state)
	local d = state.council.diplomacy
	for i, h in d.holds do
		local c = card(body, i)
		local status = h.allied and "Sworn allies" or (h.tributeDays > 0 and ("Paying you tribute (" .. h.tributeDays .. " days left)") or ("Mood " .. h.mood .. " (" .. moodWord(h.mood) .. ")"))
		text(c, h.name .. "   ·   " .. status, { Font = Enum.Font.GothamBold, TextSize = 16, TextColor3 = h.allied and THEME.Good or (h.mood < -30 and THEME.Bad or THEME.Accent), LayoutOrder = 1 })
		if h.dealText then
			text(c, (h.deal and "Trade deal running: " or "Trade deal: ") .. h.dealText .. (h.deal and "" or ("  (needs mood " .. d.dealMood .. ")")), { TextSize = 13, TextColor3 = THEME.Muted, LayoutOrder = 2 })
		end
		local r = row(c, 3)
		button(r, "Gift (" .. Grid.costText(d.giftCost) .. ")", have(state, d.giftCost), function()
			act("Gift", h.name)
		end, 170)
		button(r, "Demand tribute", not h.allied and h.tributeDays <= 0 and h.fear >= d.demandNeed, function()
			act("Demand", h.name)
		end, 150)
		button(r, h.allied and "Allied" or ("Alliance (" .. Grid.costText(d.allianceCost) .. ")"), not h.allied and h.mood >= d.allianceMood, function()
			act("Ally", h.name)
		end, 190)
		if h.dealText then
			button(r, h.deal and "End deal" or "Trade deal", h.deal or h.allied or h.mood >= d.dealMood, function()
				act("Deal", h.name)
			end, 120)
		end
	end
	text(body, "Gifts warm a hold's mood. Allies never raid you and their guards leave you be. Tribute needs a war band at least " .. d.demandNeed .. "% as strong as the hold. Attacking a hold breaks every pact with it.", { TextSize = 13, TextColor3 = THEME.Muted, LayoutOrder = 10 })
end

local function buildRites(body, state)
	local r = state.council.rites
	local f = card(body, 1)
	text(f, "Feast in the hall", { Font = Enum.Font.GothamBold, TextSize = 17, TextColor3 = THEME.Accent, LayoutOrder = 1 })
	local fText = "Mead, meat and song: +" .. r.feastHappiness .. " happiness for a day. Costs " .. Grid.costText(r.feastCost) .. "."
	if not r.hasHall then
		fText ..= " Needs a Longhouse or Great Hall."
	elseif r.feastActive then
		fText ..= " The feast is on!"
	elseif state.day < r.feastReadyDay then
		fText ..= " Next feast from day " .. r.feastReadyDay .. "."
	end
	text(f, fText, { TextSize = 14, TextColor3 = THEME.Muted, LayoutOrder = 2 })
	local fr = row(f, 3)
	button(fr, "Hold a feast", r.hasHall and state.day >= r.feastReadyDay and have(state, r.feastCost), function()
		act("Feast")
	end)

	local b = card(body, 2)
	text(b, (r.blotName or "Blót") .. "  ·  " .. r.season, { Font = Enum.Font.GothamBold, TextSize = 17, TextColor3 = THEME.Accent, LayoutOrder = 1 })
	local bText = (r.blotText or "") .. " Once per season, at the Shrine. Costs " .. (r.blotCost and Grid.costText(r.blotCost) or "?") .. "."
	if not r.hasShrine then
		bText ..= " Build a Shrine first."
	elseif r.blotDone then
		bText ..= " Held this season: the gods are pleased."
	end
	text(b, bText, { TextSize = 14, TextColor3 = THEME.Muted, LayoutOrder = 2 })
	local br = row(b, 3)
	button(br, "Hold the blót", r.hasShrine and not r.blotDone and have(state, r.blotCost), function()
		act("Blot")
	end)
end

local BUILDERS = { land = buildLand, warband = buildWarband, diplomacy = buildDiplomacy, rites = buildRites }

function CouncilController:Init(all)
	controllers = all
end

function CouncilController:Start()
	local gui = new("ScreenGui", { Name = "JarlsTable", ResetOnSpawn = false, DisplayOrder = 11, Parent = player:WaitForChild("PlayerGui") })

	local openButton = new("TextButton", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -129, 0, 170),
		Size = UDim2.fromOffset(113, 36),
		BackgroundColor3 = Color3.fromRGB(70, 54, 34),
		Font = Enum.Font.GothamBold,
		TextSize = 13,
		TextColor3 = THEME.Accent,
		Text = "Jarl's Table (J)",
		Parent = gui,
	})
	corner(openButton)

	local panel = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(760, 560),
		BackgroundColor3 = THEME.Panel,
		BackgroundTransparency = 0.04,
		Visible = false,
		Parent = gui,
	})
	corner(panel, 12)
	new("UIStroke", { Color = THEME.Accent, Thickness = 2, Transparency = 0.4, Parent = panel })
	text(panel, "The Jarl's Table", { Position = UDim2.fromOffset(20, 12), Size = UDim2.new(1, -80, 0, 34), AutomaticSize = Enum.AutomaticSize.None, Font = Enum.Font.Garamond, TextSize = 30, TextColor3 = THEME.Accent })
	local close = new("TextButton", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, 14),
		Size = UDim2.fromOffset(32, 32),
		BackgroundColor3 = THEME.Card,
		Font = Enum.Font.GothamBold,
		TextSize = 18,
		TextColor3 = THEME.Text,
		Text = "X",
		Parent = panel,
	})
	corner(close, 6)

	local tabBar = new("Frame", { Position = UDim2.fromOffset(16, 56), Size = UDim2.new(1, -32, 0, 36), BackgroundTransparency = 1, Parent = panel })
	new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = tabBar })
	local body = new("ScrollingFrame", {
		Position = UDim2.fromOffset(16, 102),
		Size = UDim2.new(1, -32, 1, -118),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 5,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = panel,
	})

	local current = "land"
	local lastKey = ""
	local tabButtons = {}

	local function render(force: boolean?)
		local state = controllers.StateController.State
		if not state or not state.council then
			return
		end
		local tabState = state.council[current]
		-- rebuild only when something shown actually changed (keeps buttons steady)
		local key = current .. HttpService:JSONEncode(tabState) .. HttpService:JSONEncode(state.resources) .. tostring(state.day)
		if key == lastKey and not force then
			return
		end
		lastKey = key
		for _, child in body:GetChildren() do
			if not child:IsA("UIListLayout") then
				child:Destroy()
			end
		end
		if not body:FindFirstChildOfClass("UIListLayout") then
			new("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder, Parent = body })
		end
		local ok, err = pcall(BUILDERS[current], body, state)
		if not ok then
			warn("[CouncilController] " .. tostring(err))
		end
		for id, b in tabButtons do
			b.BackgroundColor3 = id == current and THEME.Button or THEME.Card
			b.TextColor3 = id == current and THEME.Accent or THEME.Text
		end
	end

	for i, tab in TABS do
		local b = new("TextButton", {
			Size = UDim2.fromOffset(170, 36),
			BackgroundColor3 = THEME.Card,
			Font = Enum.Font.GothamBold,
			TextSize = 15,
			TextColor3 = THEME.Text,
			Text = tab.title,
			LayoutOrder = i,
			Parent = tabBar,
		})
		corner(b, 6)
		b.Activated:Connect(function()
			current = tab.id
			render(true)
		end)
		tabButtons[tab.id] = b
	end

	local function toggle()
		panel.Visible = not panel.Visible
		if panel.Visible then
			render(true)
		end
	end
	CouncilController.Toggle = toggle
	openButton.Activated:Connect(toggle)
	close.Activated:Connect(toggle)
	UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and input.KeyCode == Enum.KeyCode.J then
			toggle()
		elseif not processed and input.KeyCode == Enum.KeyCode.G then
			act("Formation", "next")
		end
	end)
	controllers.StateController.Changed:Connect(function()
		if panel.Visible then
			render(false)
		end
	end)

	-------------------------------------------------------------- war report
	local report = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.45),
		Size = UDim2.fromOffset(460, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = THEME.Panel,
		Visible = false,
		Parent = gui,
	})
	corner(report, 12)
	new("UIStroke", { Color = THEME.Accent, Thickness = 2, Transparency = 0.3, Parent = report })
	new("UIPadding", { PaddingLeft = UDim.new(0, 18), PaddingRight = UDim.new(0, 18), PaddingTop = UDim.new(0, 14), PaddingBottom = UDim.new(0, 14), Parent = report })
	new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, HorizontalAlignment = Enum.HorizontalAlignment.Center, Parent = report })
	local rTitle = text(report, "", { Font = Enum.Font.Garamond, TextSize = 28, TextXAlignment = Enum.TextXAlignment.Center, LayoutOrder = 1 })
	local rBody = text(report, "", { TextSize = 15, TextXAlignment = Enum.TextXAlignment.Center, LayoutOrder = 2 })
	local okRow = new("Frame", { Size = UDim2.fromOffset(140, 34), BackgroundTransparency = 1, LayoutOrder = 3, Parent = report })
	button(okRow, "Skål!", true, function()
		report.Visible = false
	end, 140)

	Remotes.WarReport.OnClientEvent:Connect(function(r)
		if type(r) ~= "table" then
			return
		end
		rTitle.Text = (r.won and "Victory at " or "Beaten back at ") .. tostring(r.hold)
		rTitle.TextColor3 = r.won and THEME.Accent or THEME.Bad
		local lines = { "You sent " .. tostring(r.sent) .. " warriors." }
		local loot = r.loot and next(r.loot) and Grid.costText(r.loot) or "nothing"
		table.insert(lines, "They brought home: " .. loot)
		if r.fallen and #r.fallen > 0 then
			table.insert(lines, "Fallen: " .. table.concat(r.fallen, ", "))
		else
			table.insert(lines, "Every warrior came home.")
		end
		if r.wounded and #r.wounded > 0 then
			table.insert(lines, "Wounded (healing at home): " .. table.concat(r.wounded, ", "))
		end
		rBody.Text = table.concat(lines, "\n")
		report.Visible = true
	end)
end

return CouncilController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="55">
            <Properties>
              <string name="Name">GuideController</string>
              <string name="Source"><![CDATA[--[[
	GuideController
	The tutorial's gold marker. It points at the thing your current saga goal
	needs: the nearest tree to chop, rock to break, deer to hunt, Ottar's
	stall, Greywater's gate or your jetty. For a building goal it points home
	and says which tab to open. It fades once you are close.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Grid = require(Shared.Grid)

local GuideController = {}

local controllers
local player = Players.LocalPlayer
local GOLD = Color3.fromRGB(240, 196, 92)

function GuideController:Init(all)
	controllers = all
end

-- Which build-menu tab holds a building.
local function tabOf(building: string): string?
	for _, cat in Config.BuildCategories or {} do
		for _, b in cat.Buildings do
			if b == building then
				return cat.Name
			end
		end
	end
	return nil
end

local function myPlot(): Instance?
	local index = player:GetAttribute("PlotIndex")
	local plots = workspace:FindFirstChild("Plots")
	return index and plots and plots:FindFirstChild("Plot_" .. index)
end

local function nearestIn(container: Instance?, from: Vector3, accept): Vector3?
	if not container then
		return nil
	end
	local best, bestD = nil, math.huge
	for _, m in container:GetChildren() do
		if m:IsA("Model") and accept(m) then
			local p = m:GetPivot().Position
			local d = (p - from).Magnitude
			if d < bestD then
				best, bestD = p, d
			end
		end
	end
	return best
end

local function home(): Vector3
	local origin = player:GetAttribute("PlotOrigin")
	if typeof(origin) ~= "Vector3" then
		return Vector3.zero
	end
	return origin + Vector3.new(Grid.PLOT_SIZE / 2, 0, Grid.PLOT_SIZE / 2)
end

-- Where the current goal is, and a short line on what to do there.
local function target(from: Vector3): (Vector3?, string?)
	local state = controllers.StateController.State
	local q = state and state.quest
	if not q or q.done then
		return nil
	end
	local quest = Config.Quests[q.index]
	if not quest then
		return nil
	end
	if quest.Kind == "building" then
		local tab = tabOf(quest.Building)
		local def = Config.Buildings[quest.Building]
		local name = def and def.Display or quest.Building
		local line = "Build a " .. name .. (tab and (" (" .. tab .. " tab)") or "")
		if (from - home()).Magnitude < Grid.PLOT_SIZE * 0.8 then
			return nil, line -- already home: the tip is enough
		end
		return home(), line
	elseif quest.Stat == "chop" or quest.Stat == "mine" then
		local kind = quest.Stat == "chop" and "Tree" or "Rock"
		local plot = myPlot()
		local p = nearestIn(plot and plot:FindFirstChild("Nodes"), from, function(m)
			return m:GetAttribute("NodeKind") == kind
		end)
		return p, quest.Stat == "chop" and "Press 1, then click the tree" or "Press 2, then click the rock"
	elseif quest.Stat == "deer" or quest.Stat == "wolf" then
		local wolf = quest.Stat == "wolf"
		return nearestIn(workspace:FindFirstChild("Wildlife"), from, function(m)
			return (m:GetAttribute("Wolf") == true) == wolf
		end), "Press 3, aim and click to shoot"
	elseif quest.Stat == "trade" then
		return nearestIn(workspace, from, function(m)
			return m.Name == "TraderStall"
		end), "Hold E at Ottar's stall"
	elseif quest.Stat == "plunder" or quest.Stat == "gate" then
		local rival = Config.Rivals[1]
		local a = rival.GateAngle or 0
		return rival.Center + Vector3.new(math.cos(a), 0, math.sin(a)) * (rival.Radius + 6), "Chop down the gate, then plunder a chest"
	elseif quest.Stat == "launch" then
		local origin = player:GetAttribute("PlotOrigin")
		if typeof(origin) == "Vector3" then
			return Vector3.new(origin.X + Grid.PLOT_SIZE * 0.25, 2, -76), "Hold E at the end of your jetty"
		end
	elseif quest.Kind == "tech" then
		return nil, "Press T to research"
	end
	return nil
end

-- If the server couldn't build the valley, say so on screen, so a
-- screenshot shows what went wrong.
local function showTerrainError()
	local function show()
		local text = workspace:GetAttribute("TerrainError")
		if not text then
			return
		end
		local gui = Instance.new("ScreenGui")
		gui.Name = "TerrainError"
		gui.ResetOnSpawn = false
		gui.DisplayOrder = 200
		local label = Instance.new("TextLabel")
		label.AnchorPoint = Vector2.new(0.5, 0)
		label.Position = UDim2.new(0.5, 0, 0, 60)
		label.Size = UDim2.fromOffset(720, 60)
		label.BackgroundColor3 = Color3.fromRGB(90, 24, 20)
		label.BackgroundTransparency = 0.1
		label.TextColor3 = Color3.new(1, 1, 1)
		label.Font = Enum.Font.GothamMedium
		label.TextSize = 14
		label.TextWrapped = true
		label.Text = "World problem (please send a screenshot): " .. tostring(text)
		label.Parent = gui
		gui.Parent = player:WaitForChild("PlayerGui")
		task.delay(40, function()
			gui:Destroy()
		end)
	end
	show()
	workspace:GetAttributeChangedSignal("TerrainError"):Connect(show)
end

function GuideController:Start()
	task.spawn(showTerrainError)
	-- the marker: a soft pillar of light and a sign above it
	local beam = Instance.new("Part")
	beam.Name = "GuideBeam"
	beam.Anchored = true
	beam.CanCollide = false
	beam.CanQuery = false
	beam.CanTouch = false
	beam.CastShadow = false
	beam.Material = Enum.Material.Neon
	beam.Color = GOLD
	beam.Transparency = 0.75
	beam.Shape = Enum.PartType.Cylinder
	beam.Size = Vector3.new(60, 1.2, 1.2)
	local light = Instance.new("PointLight")
	light.Color = GOLD
	light.Range = 14
	light.Brightness = 1.2
	light.Parent = beam

	local sign = Instance.new("BillboardGui")
	sign.Size = UDim2.fromOffset(260, 70)
	sign.StudsOffsetWorldSpace = Vector3.new(0, 34, 0)
	sign.AlwaysOnTop = true
	sign.LightInfluence = 0
	sign.Adornee = beam
	local arrow = Instance.new("TextLabel")
	arrow.Size = UDim2.new(1, 0, 0, 30)
	arrow.BackgroundTransparency = 1
	arrow.Font = Enum.Font.GothamBold
	arrow.TextSize = 28
	arrow.TextColor3 = GOLD
	arrow.TextStrokeTransparency = 0.3
	arrow.Text = "▼"
	arrow.Position = UDim2.fromOffset(0, 38)
	arrow.Parent = sign
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 0, 38)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.Garamond
	label.TextSize = 20
	label.TextWrapped = true
	label.TextColor3 = Color3.fromRGB(245, 235, 210)
	label.TextStrokeTransparency = 0.35
	label.Parent = sign

	local folder = Instance.new("Folder")
	folder.Name = "Guide"
	folder.Parent = workspace.CurrentCamera -- only you can see it
	sign.Parent = player:WaitForChild("PlayerGui")

	local current: Vector3? = nil
	local acc = 0
	RunService.RenderStepped:Connect(function(dt)
		acc += dt
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local intro = controllers.IntroController and controllers.IntroController.Active
		if acc > 0.5 then
			acc = 0
			if root and not intro then
				local line
				current, line = target(root.Position)
				GuideController.Target = current -- the minimap shows it too
				label.Text = line or ""
			else
				current = nil
				GuideController.Target = nil
			end
		end
		local show = current ~= nil and root ~= nil and (current - root.Position).Magnitude > 12
		if show then
			local pulse = 0.72 + math.sin(os.clock() * 3) * 0.06
			beam.Transparency = pulse
			beam.CFrame = CFrame.new(current + Vector3.new(0, 30, 0)) * CFrame.Angles(0, 0, math.rad(90))
			beam.Parent = folder
			sign.Enabled = true
			local d = math.floor((current - root.Position).Magnitude)
			arrow.Text = "▼  " .. d .. " m"
		else
			beam.Parent = nil
			sign.Enabled = false
		end
	end)
end

return GuideController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="56">
            <Properties>
              <string name="Name">HearthGlowController</string>
              <string name="Source"><![CDATA[--[[
	HearthGlowController
	At dusk the homes light up: a soft, flickering firelight shines from every
	house in every village (Longhouse, Cottage, Great Hall), and goes out at
	dawn. Done on the client, so it costs the server nothing.
]]

local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)

local HearthGlowController = {}

local function isNight(): boolean
	local t = Lighting.ClockTime
	return t >= 18.2 or t <= 6.2
end

local function isHome(model: Instance): boolean
	local kind = model:GetAttribute("BuildingType")
	local def = kind and Config.Buildings[kind]
	return def ~= nil and (def.Housing or 0) > 0
end

function HearthGlowController:Start()
	local lights = {} -- [model] = PointLight
	local phase = {} -- [PointLight] = flicker offset
	local timer = 0
	local flicker = 0

	local function refresh()
		local night = isNight()
		local plots = workspace:FindFirstChild("Plots")
		local seen = {}
		if plots then
			for _, plot in plots:GetChildren() do
				local buildings = plot:FindFirstChild("Buildings")
				if buildings then
					for _, model in buildings:GetChildren() do
						if model:IsA("Model") and isHome(model) then
							seen[model] = true
							local light = lights[model]
							if not light or not light.Parent then
								local anchor = Instance.new("Attachment")
								anchor.Name = "HearthGlow"
								local root = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
								if root then
									anchor.Parent = root
									anchor.WorldPosition = model:GetPivot().Position + Vector3.new(0, 3.5, 0)
									light = Instance.new("PointLight")
									light.Color = Color3.fromRGB(255, 164, 86)
									light.Range = 20
									light.Shadows = false
									light.Parent = anchor
									lights[model] = light
									phase[light] = math.random() * 10
								end
							end
							if light then
								light.Enabled = night
							end
						end
					end
				end
			end
		end
		for model, light in lights do
			if not seen[model] then
				lights[model] = nil
				phase[light] = nil
				if light.Parent then
					light.Parent:Destroy()
				end
			end
		end
	end

	RunService.Heartbeat:Connect(function(dt)
		timer += dt
		if timer >= 2 then
			timer = 0
			refresh()
		end
		-- a gentle flicker, as from a fire inside
		flicker += dt
		if flicker >= 0.12 then
			flicker = 0
			local t = os.clock()
			for _, light in lights do
				if light.Enabled then
					light.Brightness = 1.1 + math.sin(t * 7 + (phase[light] or 0)) * 0.12 + math.random() * 0.15
				end
			end
		end
	end)
end

return HearthGlowController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="57">
            <Properties>
              <string name="Name">HudController</string>
              <string name="Source"><![CDATA[--[[
	HudController
	Draws the on-screen interface entirely from code:
	  - resource bar (top left)
	  - colony panel: population, jobs, happiness, day (top right)
	  - build menu with tabs (Housing, Production, ...) and building cards,
	    tooltips and Demolish (bottom centre)
	  - controls help (bottom left, H hides it)
	  - message feed (top centre)
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Grid = require(Shared.Grid)
local Sounds = require(Shared.Sounds)

local HudController = {}

local controllers
local player = Players.LocalPlayer

local THEME = {
	Panel = Color3.fromRGB(20, 20, 22),
	PanelLight = Color3.fromRGB(44, 44, 47),
	Accent = Color3.fromRGB(226, 206, 160),
	Text = Color3.fromRGB(238, 234, 226),
	Muted = Color3.fromRGB(156, 152, 146),
	Good = Color3.fromRGB(130, 200, 110),
	Bad = Color3.fromRGB(230, 100, 90),
}

local RESOURCE_COLORS = {
	Wood = Color3.fromRGB(150, 100, 60),
	Stone = Color3.fromRGB(150, 150, 158),
	Food = Color3.fromRGB(220, 190, 90),
	Hides = Color3.fromRGB(176, 120, 84),
	Silver = Color3.fromRGB(210, 214, 224),
	Lore = Color3.fromRGB(120, 160, 230),
}

local function new(className: string, props, children)
	local inst = Instance.new(className)
	for k, v in props do
		if k ~= "Parent" then
			inst[k] = v
		end
	end
	for _, child in children or {} do
		child.Parent = inst
	end
	if props.Parent then
		inst.Parent = props.Parent
	end
	return inst
end

local function corner(r)
	return new("UICorner", { CornerRadius = UDim.new(0, r or 8) })
end

local function padding(px)
	return new("UIPadding", {
		PaddingLeft = UDim.new(0, px),
		PaddingRight = UDim.new(0, px),
		PaddingTop = UDim.new(0, px),
		PaddingBottom = UDim.new(0, px),
	})
end

local function label(props)
	local defaults = {
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamMedium,
		TextColor3 = THEME.Text,
		TextSize = 16,
		TextXAlignment = Enum.TextXAlignment.Left,
	}
	for k, v in props do
		defaults[k] = v
	end
	return new("TextLabel", defaults)
end

-- thin gold border used on every panel
local function frameStroke()
	return new("UIStroke", { Color = THEME.Accent, Thickness = 1, Transparency = 0.55, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
end

local DEFAULT_HINT = "Pick a tab and a building. Swing the Axe at trees and the Pickaxe at rocks to gather."

local function moodWord(h: number): string
	if h >= 75 then
		return "Joyful"
	elseif h >= 55 then
		return "Content"
	elseif h >= 35 then
		return "Uneasy"
	end
	return "Miserable"
end

function HudController:Init(allControllers)
	controllers = allControllers
end

function HudController:Start()
	local gui = new("ScreenGui", {
		Name = "VikingHud",
		ResetOnSpawn = false,
		IgnoreGuiInset = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		Parent = player:WaitForChild("PlayerGui"),
	})

	---------------------------------------------------------------- resources
	local resBar = new("Frame", {
		Name = "Resources",
		Position = UDim2.fromOffset(12, 12),
		Size = UDim2.fromOffset(0, 44),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = THEME.Panel,
		BackgroundTransparency = 0.08,
		Parent = gui,
	}, {
		corner(10),
		padding(8),
		frameStroke(),
		new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 14), VerticalAlignment = Enum.VerticalAlignment.Center }),
	})

	local resLabels = {}
	for i, name in Config.ResourceOrder do
		local item = new("Frame", { Size = UDim2.fromOffset(122, 28), BackgroundTransparency = 1, LayoutOrder = i, Parent = resBar })
		new("Frame", {
			Size = UDim2.fromOffset(16, 16),
			Position = UDim2.new(0, 0, 0.5, -8),
			BackgroundColor3 = RESOURCE_COLORS[name],
			Parent = item,
		}, { corner(4) })
		resLabels[name] = label({
			Size = UDim2.new(1, -22, 1, 0),
			Position = UDim2.fromOffset(22, 0),
			Text = name .. " 0",
			Parent = item,
		})
	end

	---------------------------------------------------------------- saga (quest guide)
	local saga = new("Frame", {
		Name = "Saga",
		Position = UDim2.fromOffset(12, 64),
		Size = UDim2.fromOffset(300, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = THEME.Panel,
		BackgroundTransparency = 0.12,
		Parent = gui,
	}, {
		corner(10),
		padding(10),
		frameStroke(),
		new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	local sagaHead = label({ Size = UDim2.new(1, 0, 0, 16), Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = THEME.Muted, LayoutOrder = 1, Parent = saga })
	local sagaTitle = label({ Size = UDim2.new(1, 0, 0, 22), Font = Enum.Font.GothamBold, TextSize = 17, TextColor3 = THEME.Accent, LayoutOrder = 2, Parent = saga })
	local sagaText = label({ Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextWrapped = true, TextSize = 14, LayoutOrder = 3, Parent = saga })
	local sagaBar = new("Frame", { Size = UDim2.new(1, 0, 0, 6), BackgroundColor3 = THEME.PanelLight, LayoutOrder = 4, Parent = saga }, { corner(3) })
	local sagaFill = new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = THEME.Good, Parent = sagaBar }, { corner(3) })
	local sagaReward = label({ Size = UDim2.new(1, 0, 0, 16), TextSize = 12, TextColor3 = THEME.Muted, LayoutOrder = 5, Parent = saga })

	---------------------------------------------------------------- colony panel
	local panel = new("Frame", {
		Name = "Colony",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 12),
		Size = UDim2.fromOffset(230, 150),
		BackgroundColor3 = THEME.Panel,
		BackgroundTransparency = 0.08,
		Parent = gui,
	}, {
		corner(10),
		padding(10),
		frameStroke(),
		new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	local dayLabel = label({ Size = UDim2.new(1, 0, 0, 20), Font = Enum.Font.GothamBold, TextColor3 = THEME.Accent, LayoutOrder = 1, Parent = panel })
	local dayBar = new("Frame", { Size = UDim2.new(1, 0, 0, 4), BackgroundColor3 = THEME.PanelLight, LayoutOrder = 2, Parent = panel }, { corner(2) })
	local dayFill = new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = THEME.Accent, Parent = dayBar }, { corner(2) })
	local popLabel = label({ Size = UDim2.new(1, 0, 0, 20), LayoutOrder = 3, Parent = panel })
	local jobLabel = label({ Size = UDim2.new(1, 0, 0, 20), LayoutOrder = 4, TextColor3 = THEME.Muted, TextSize = 14, Parent = panel })
	local moodLabel = label({ Size = UDim2.new(1, 0, 0, 20), LayoutOrder = 5, Parent = panel })
	local warnLabel = label({ Size = UDim2.new(1, 0, 0, 20), LayoutOrder = 6, TextColor3 = THEME.Bad, TextSize = 14, TextScaled = true, Parent = panel })

	---------------------------------------------------------------- build menu
	--[[
		A row of tabs (Housing, Production, ...) above a row of building
		cards. Click a tab to open it, click it again to fold the menu away.
		Hovering a card shows a tooltip with everything about the building.
	]]
	local CARD_W, CARD_H = 124, 96
	-- sits above Roblox's tool hotbar (Axe, Pickaxe, ...) so they don't overlap
	local MENU_BOTTOM = 84
	local buildMenu = new("Frame", {
		Name = "BuildMenu",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -MENU_BOTTOM),
		Size = UDim2.fromOffset(0, 0),
		AutomaticSize = Enum.AutomaticSize.XY,
		BackgroundColor3 = THEME.Panel,
		BackgroundTransparency = 0.08,
		Parent = gui,
	}, {
		corner(12),
		padding(8),
		frameStroke(),
		new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, HorizontalAlignment = Enum.HorizontalAlignment.Center }),
	})

	local tabRow = new("Frame", {
		Name = "Tabs",
		Size = UDim2.fromOffset(0, 34),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundTransparency = 1,
		LayoutOrder = 1,
		Parent = buildMenu,
	}, {
		new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }),
	})

	local cardRow = new("Frame", {
		Name = "Cards",
		Size = UDim2.fromOffset(0, CARD_H),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundTransparency = 1,
		LayoutOrder = 2,
		Parent = buildMenu,
	}, {
		new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
	})

	-- hint line just above the menu
	local hint = label({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 0, -6),
		Size = UDim2.fromOffset(700, 22),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextSize = 15,
		TextStrokeTransparency = 0.4,
		Text = DEFAULT_HINT,
		Parent = gui,
	})
	local function placeHint()
		hint.Position = UDim2.new(0.5, 0, 1, -MENU_BOTTOM - buildMenu.AbsoluteSize.Y - 6)
	end
	buildMenu:GetPropertyChangedSignal("AbsoluteSize"):Connect(placeHint)
	placeHint()

	-- tooltip that follows the hovered card
	local tooltip = new("Frame", {
		Name = "Tooltip",
		AnchorPoint = Vector2.new(0.5, 1),
		Size = UDim2.fromOffset(260, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = THEME.Panel,
		Visible = false,
		ZIndex = 20,
		Parent = gui,
	}, {
		corner(8),
		padding(10),
		frameStroke(),
		new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	local tipTitle = label({ Size = UDim2.new(1, 0, 0, 22), Font = Enum.Font.GothamBold, TextSize = 17, TextColor3 = THEME.Accent, LayoutOrder = 1, ZIndex = 21, Parent = tooltip })
	local tipBody = label({ Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextWrapped = true, TextSize = 14, LayoutOrder = 2, ZIndex = 21, Parent = tooltip })
	local tipStats = label({ Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextWrapped = true, TextSize = 13, TextColor3 = THEME.Muted, LayoutOrder = 3, ZIndex = 21, Parent = tooltip })
	local tipCost = label({ Size = UDim2.new(1, 0, 0, 18), TextSize = 14, Font = Enum.Font.GothamBold, LayoutOrder = 4, ZIndex = 21, Parent = tooltip })

	local lastState = nil
	local known = {}

	local function statsText(def): string
		local bits = {}
		if def.Housing then
			table.insert(bits, "Homes for " .. def.Housing)
		end
		if def.Workers then
			table.insert(bits, def.Workers .. (def.Workers == 1 and " job" or " jobs"))
		end
		for res, rate in def.Produces or {} do
			table.insert(bits, string.format("+%.2g %s/s per worker", rate, res))
		end
		if def.Storage then
			table.insert(bits, "+" .. def.Storage .. " storage")
		end
		if def.Happiness then
			table.insert(bits, "+" .. def.Happiness .. " happiness")
		end
		table.insert(bits, def.Size[1] .. "x" .. def.Size[2] .. " tiles")
		return table.concat(bits, "  ·  ")
	end

	local function shortStat(def): string
		if def.Housing then
			return def.Housing .. " homes"
		elseif def.Produces then
			local res = next(def.Produces)
			return res .. ", " .. def.Workers .. (def.Workers == 1 and " job" or " jobs")
		elseif def.Storage then
			return "+" .. def.Storage .. " storage"
		elseif def.Happiness then
			return "+" .. def.Happiness .. " happiness"
		end
		return def.Size[1] .. "x" .. def.Size[2]
	end

	local function showTooltip(buildingType: string, card: GuiObject)
		local def = Config.Buildings[buildingType]
		tipTitle.Text = (Config.BuildingIcons[buildingType] or "") .. "  " .. def.Display
		tipBody.Text = def.Description
		tipStats.Text = statsText(def)
		local rank = lastState and lastState.rank and lastState.rank.index or 1
		if def.Rank and rank < def.Rank then
			tipCost.Text = "🔒 Become a " .. Config.Ranks[def.Rank].Name .. " first"
			tipCost.TextColor3 = THEME.Bad
		elseif def.Requires and not known[def.Requires] then
			tipCost.Text = "🔒 Research " .. Config.Tech[def.Requires].Name .. " first (T)"
			tipCost.TextColor3 = THEME.Bad
		else
			local affordable = lastState and Grid.canAfford(lastState.resources, def.Cost)
			tipCost.Text = "Cost: " .. Grid.costText(def.Cost)
			tipCost.TextColor3 = affordable and THEME.Good or THEME.Bad
		end
		local pos = card.AbsolutePosition
		tooltip.Position = UDim2.fromOffset(pos.X + card.AbsoluteSize.X / 2, pos.Y - 34)
		tooltip.Visible = true
	end

	local buttons = {}
	local function makeCard(key: string, icon: string, title: string, sub: string, order: number)
		local b = new("TextButton", {
			Name = key,
			Size = UDim2.fromOffset(CARD_W, CARD_H),
			BackgroundColor3 = THEME.PanelLight,
			AutoButtonColor = true,
			Text = "",
			LayoutOrder = order,
			Visible = false,
			Parent = cardRow,
		}, {
			corner(8),
			new("UIGradient", { Rotation = 90, Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(190, 180, 170)) }),
		})
		new("UIStroke", { Name = "Stroke", ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Color = THEME.Accent, Thickness = 2, Enabled = false, Parent = b })
		label({ Name = "Icon", Size = UDim2.new(1, 0, 0, 30), Position = UDim2.fromOffset(0, 4), TextSize = 26, TextXAlignment = Enum.TextXAlignment.Center, Text = icon, Parent = b })
		label({ Size = UDim2.new(1, -6, 0, 18), Position = UDim2.fromOffset(3, 36), Font = Enum.Font.GothamBold, TextSize = 14, TextScaled = true, TextXAlignment = Enum.TextXAlignment.Center, Text = title, Parent = b })
		local statLabel = label({ Name = "Stat", Size = UDim2.new(1, -6, 0, 15), Position = UDim2.fromOffset(3, 56), TextSize = 12, TextColor3 = THEME.Muted, TextXAlignment = Enum.TextXAlignment.Center, Text = "", Parent = b })
		local costLabel = label({ Name = "Cost", Size = UDim2.new(1, -8, 0, 16), Position = UDim2.fromOffset(4, 74), TextSize = 12, TextScaled = true, Font = Enum.Font.GothamBold, TextColor3 = THEME.Muted, TextXAlignment = Enum.TextXAlignment.Center, Text = sub, Parent = b })
		buttons[key] = { button = b, cost = costLabel, stat = statLabel }
		return b
	end

	local BuildController = controllers.BuildController
	local tabs = {}
	local openTab = nil

	local function setTab(index)
		openTab = index
		for i, tab in tabs do
			local active = i == index
			tab.button.BackgroundColor3 = active and THEME.Accent or THEME.PanelLight
			tab.button.TextColor3 = active and THEME.Panel or THEME.Text
			for _, buildingType in tab.buildings do
				buttons[buildingType].button.Visible = active
			end
		end
		cardRow.Visible = index ~= nil
		buttons.Demolish.button.Visible = index ~= nil
		tooltip.Visible = false
	end

	for i, category in Config.BuildCategories do
		local tabButton = new("TextButton", {
			Name = category.Name,
			Size = UDim2.fromOffset(0, 34),
			AutomaticSize = Enum.AutomaticSize.X,
			BackgroundColor3 = THEME.PanelLight,
			Font = Enum.Font.GothamBold,
			TextSize = 15,
			TextColor3 = THEME.Text,
			Text = category.Icon .. "  " .. category.Name,
			LayoutOrder = i,
			Parent = tabRow,
		}, { corner(8), new("UIPadding", { PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 14) }) })
		tabs[i] = { button = tabButton, buildings = category.Buildings }
		tabButton.Activated:Connect(function()
			setTab(openTab ~= i and i or nil)
		end)

		for j, buildingType in category.Buildings do
			local def = Config.Buildings[buildingType]
			local card = makeCard(buildingType, Config.BuildingIcons[buildingType] or "", def.Display, Grid.costText(def.Cost), i * 100 + j)
			buttons[buildingType].stat.Text = shortStat(def)
			card.Activated:Connect(function()
				BuildController:SelectBuild(buildingType)
			end)
			card.MouseEnter:Connect(function()
				showTooltip(buildingType, card)
			end)
			card.MouseLeave:Connect(function()
				tooltip.Visible = false
			end)
		end
	end

	-- Demolish lives at the right end of the tab row, always reachable.
	local demolish = new("TextButton", {
		Name = "Demolish",
		Size = UDim2.fromOffset(0, 34),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = Color3.fromRGB(96, 40, 34),
		Font = Enum.Font.GothamBold,
		TextSize = 15,
		TextColor3 = THEME.Text,
		Text = "🔨  Demolish",
		LayoutOrder = 999,
		Parent = tabRow,
	}, { corner(8), new("UIPadding", { PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 14) }) })
	new("UIStroke", { Name = "Stroke", ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Color = THEME.Accent, Thickness = 2, Enabled = false, Parent = demolish })
	buttons.Demolish = { button = { Visible = true }, stroke = demolish.Stroke }
	demolish.Activated:Connect(function()
		BuildController:SelectDemolish()
	end)
	demolish.MouseEnter:Connect(function()
		hint.Text = "Demolish: tear down one of your buildings and get half its cost back."
	end)

	setTab(1)

	BuildController.ModeChanged:Connect(function(mode)
		for key, entry in buttons do
			local stroke = entry.stroke or entry.button.Stroke
			stroke.Enabled = mode ~= nil and (mode.type == key or (mode.kind == "demolish" and key == "Demolish"))
		end
		if mode == nil then
			hint.Text = DEFAULT_HINT
		elseif mode.kind == "place" then
			hint.Text = "Click to place " .. Config.Buildings[mode.type].Display .. ".  R = rotate,  Q = cancel"
		else
			hint.Text = "Click one of your buildings to tear it down.  Q = cancel"
		end
	end)

	---------------------------------------------------------------- controls help
	local helpOpen = true
	local help = new("Frame", {
		Name = "Controls",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 12, 1, -12),
		Size = UDim2.fromOffset(250, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = THEME.Panel,
		BackgroundTransparency = 0.25,
		Parent = gui,
	}, {
		corner(10),
		padding(10),
		frameStroke(),
		new("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	label({ Size = UDim2.new(1, 0, 0, 18), Font = Enum.Font.GothamBold, TextColor3 = THEME.Accent, TextSize = 14, Text = "Controls  (H to hide)", LayoutOrder = 1, Parent = help })
	local helpBody = label({
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		TextSize = 13,
		TextColor3 = THEME.Muted,
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
		LayoutOrder = 2,
		Text = "1 Axe: chop trees\n2 Pickaxe: mine rocks\n3 Bow: click to shoot\n4 Torch: F sets enemy buildings alight\n5 Sword: click to fight\nE: gather, loot, talk\nT: research   J: Jarl's Table\nM: map size   E at a berry bush: pick\nG: war band formation   X: hide the screen\nRaid Greywater Hold: walk west, chop the gate\nWheel: zoom   Right-drag: turn   V: camera",
		Parent = help,
	})
	if game:GetService("UserInputService").TouchEnabled and not game:GetService("UserInputService").KeyboardEnabled then
		-- phone or tablet: explain the touch controls instead (TouchController)
		helpBody.Text = "Tools: tap the slots at the bottom\nTap a tree, rock or enemy to swing\nBow: tap where to shoot\nBuilding: tap to move it, then Place\nPinch: zoom   Twist: turn   2-finger drag: tilt\nAt the helm: arrows to sail, Volley to shoot"
		task.delay(25, function()
			helpOpen = false
			helpBody.Visible = false
		end)
		-- tap the box to show or hide it
		help.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch then
				helpOpen = not helpOpen
				helpBody.Visible = helpOpen
			end
		end)
	end
	game:GetService("UserInputService").InputBegan:Connect(function(input, processed)
		if not processed and input.KeyCode == Enum.KeyCode.H then
			helpOpen = not helpOpen
			helpBody.Visible = helpOpen
		end
	end)

	---------------------------------------------------------------- message feed
	local feed = new("Frame", {
		Name = "Feed",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 12),
		Size = UDim2.fromOffset(460, 200),
		BackgroundTransparency = 1,
		Parent = gui,
	}, {
		new("UIListLayout", { Padding = UDim.new(0, 4), HorizontalAlignment = Enum.HorizontalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	local feedOrder = 0
	local kindColor = { good = THEME.Good, bad = THEME.Bad, gain = THEME.Accent, info = THEME.Text }

	-- a big cinematic title for raid moments
	local raidTitle = label({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.3),
		Size = UDim2.fromOffset(900, 60),
		Font = Enum.Font.Garamond,
		TextSize = 42,
		TextColor3 = Color3.fromRGB(240, 210, 150),
		TextStrokeTransparency = 0.2,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextTransparency = 1,
		TextStrokeColor3 = Color3.fromRGB(40, 10, 6),
		Parent = gui,
	})
	local raidToken = 0
	local function showRaidTitle(text: string)
		raidToken += 1
		local token = raidToken
		raidTitle.Text = text
		raidTitle.TextTransparency = 1
		raidTitle.TextStrokeTransparency = 1
		TweenService:Create(raidTitle, TweenInfo.new(0.6), { TextTransparency = 0, TextStrokeTransparency = 0.2 }):Play()
		task.delay(4, function()
			if token == raidToken then
				TweenService:Create(raidTitle, TweenInfo.new(1.2), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
			end
		end)
	end

	controllers.StateController.Notified:Connect(function(text, kind)
		if kind == "raid" then
			showRaidTitle(text)
			return
		end
		if kind == "quest" then
			Sounds.play("QuestDone")
			showRaidTitle(text)
			return
		end
		feedOrder += 1
		local item = new("TextLabel", {
			Size = UDim2.fromOffset(0, 28),
			AutomaticSize = Enum.AutomaticSize.X,
			BackgroundColor3 = THEME.Panel,
			BackgroundTransparency = 0.15,
			Font = Enum.Font.GothamMedium,
			TextSize = 15,
			TextColor3 = kindColor[kind] or THEME.Text,
			Text = text,
			LayoutOrder = feedOrder,
			Parent = feed,
		}, { corner(6), new("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) }), frameStroke() })
		-- fade and grow in
		item.TextTransparency = 1
		item.BackgroundTransparency = 1
		local grow = new("UIScale", { Scale = 0.85, Parent = item })
		TweenService:Create(item, TweenInfo.new(0.25), { TextTransparency = 0, BackgroundTransparency = 0.15 }):Play()
		TweenService:Create(grow, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Scale = 1 }):Play()
		-- keep at most 5 messages
		local items = {}
		for _, c in feed:GetChildren() do
			if c:IsA("TextLabel") then
				table.insert(items, c)
			end
		end
		table.sort(items, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		for i = 1, #items - 5 do
			items[i]:Destroy()
		end
		task.delay(kind == "gain" and 1.5 or 5, function()
			if item.Parent then
				local stroke = item:FindFirstChildOfClass("UIStroke")
				if stroke then
					TweenService:Create(stroke, TweenInfo.new(0.5), { Transparency = 1 }):Play()
				end
				local t = TweenService:Create(item, TweenInfo.new(0.5), { TextTransparency = 1, BackgroundTransparency = 1 })
				t:Play()
				t.Completed:Wait()
				item:Destroy()
			end
		end)
	end)

	---------------------------------------------------------------- updates
	local lastValues = {}
	controllers.StateController.Changed:Connect(function(state)
		for _, name in Config.ResourceOrder do
			local value = state.resources[name] or 0
			local resLabel = resLabels[name]
			resLabel.Text = string.format("%s %d/%d", name, value, state.storage)
			-- flash green when it goes up, red when it goes down
			local before = lastValues[name]
			if before and value ~= before and math.abs(value - before) >= 1 then
				resLabel.TextColor3 = value > before and THEME.Good or THEME.Bad
				TweenService:Create(resLabel, TweenInfo.new(0.8), { TextColor3 = value >= state.storage and THEME.Accent or THEME.Text }):Play()
			elseif value >= state.storage then
				resLabel.TextColor3 = THEME.Accent -- full: build a storehouse
			end
			lastValues[name] = value
		end
		local rank = state.rank
		local weather = workspace:GetAttribute("Weather")
		local weatherText = weather == "Storm" and "  ·  ⛈ Storm" or (weather == "Fog" and "  ·  🌫 Fog" or "")
		dayLabel.Text = (rank and (rank.name .. "  ·  ") or "") .. "Day " .. state.day .. "  ·  " .. (state.season or "") .. weatherText
		dayFill.Size = UDim2.fromScale(math.clamp(state.dayProgress, 0, 1), 1)
		popLabel.Text = string.format("Population %d / %d homes", state.population, math.min(state.housing, rank and rank.cap or state.housing))
		jobLabel.Text = string.format("%d working, %d idle, %d children", state.workers, state.idle, state.children)
		moodLabel.Text = string.format("Happiness %d (%s)", state.happiness, moodWord(state.happiness))
		moodLabel.TextColor3 = state.happiness >= 55 and THEME.Good or (state.happiness >= 35 and THEME.Text or THEME.Bad)
		local food = state.resources.Food or 0
		local dailyFood = state.population * Config.Villagers.FoodPerAdultPerSecond * Config.DAY_LENGTH
		if state.starving then
			warnLabel.Text = "Starving! Hold E on berry bushes, hunt deer (3), build farms."
		elseif state.cold then
			warnLabel.Text = "Hearths are cold! Homes burn Wood in winter: chop trees or build a Woodcutter."
			warnLabel.TextColor3 = THEME.Bad
		elseif food < dailyFood then
			warnLabel.Text = "Food is running low: forage berries or build a Barley Farm."
			warnLabel.TextColor3 = THEME.Bad
		elseif state.season == "Autumn" and food < dailyFood * 4 then
			warnLabel.Text = "Winter is coming: store food now, and Wood for the hearths."
			warnLabel.TextColor3 = THEME.Bad
		elseif state.population > state.housing then
			warnLabel.Text = "Not enough housing!"
		elseif state.idle > 0 then
			warnLabel.Text = "Idle villagers: build workplaces."
			warnLabel.TextColor3 = THEME.Muted
		elseif rank and rank.nextName then
			warnLabel.Text = "Next: " .. rank.nextName .. " (" .. rank.nextText .. ")"
			warnLabel.TextColor3 = THEME.Muted
		else
			warnLabel.Text = ""
		end
		if state.starving or state.population > state.housing then
			warnLabel.TextColor3 = THEME.Bad
		end

		lastState = state
		local q = state.quest
		if q then
			if q.done then
				sagaHead.Text = "SAGA COMPLETE"
				sagaTitle.Text = "Your name will be sung"
				sagaText.Text = "Every goal is done. Keep growing, raiding and sailing!"
				sagaFill.Size = UDim2.fromScale(1, 1)
				sagaReward.Text = ""
			else
				sagaHead.Text = string.format("SAGA  %d / %d", q.index, q.total)
				sagaTitle.Text = q.title
				sagaText.Text = q.text
				sagaFill.Size = UDim2.fromScale(math.clamp(q.have / q.goal, 0, 1), 1)
				sagaReward.Text = string.format("%d / %d   ·   Reward: %s", q.have, q.goal, q.reward)
			end
		end
		table.clear(known)
		for _, id in state.tech or {} do
			known[id] = true
		end
		for _, buildingType in Config.BuildOrder do
			local def = Config.Buildings[buildingType]
			local entry = buttons[buildingType]
			local rankIndex = state.rank and state.rank.index or 1
			if def.Rank and rankIndex < def.Rank then
				entry.cost.Text = "🔒 " .. Config.Ranks[def.Rank].Name
				entry.cost.TextColor3 = THEME.Muted
				entry.button.BackgroundTransparency = 0.55
			elseif def.Requires and not known[def.Requires] then
				entry.cost.Text = "🔒 " .. Config.Tech[def.Requires].Name
				entry.cost.TextColor3 = THEME.Muted
				entry.button.BackgroundTransparency = 0.55
			else
				entry.cost.Text = Grid.costText(def.Cost)
				entry.button.BackgroundTransparency = 0
				local affordable = Grid.canAfford(state.resources, def.Cost)
				entry.cost.TextColor3 = affordable and THEME.Good or THEME.Bad
			end
		end
	end)
end

return HudController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="58">
            <Properties>
              <string name="Name">IntroController</string>
              <string name="Source"><![CDATA[--[[
	IntroController
	The title screen and the short intro story.

	When the valley has loaded, the camera drifts slowly over your village
	behind the title. Play goes into the game. A new chieftain (still on the
	first saga goal) sees the intro story first: five short scenes over the
	fjord, the forest, your land and Greywater Hold. Click to go on, or Skip.
	The Story button plays it again.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Grid = require(Shared.Grid)

local IntroController = {}

local controllers
local player = Players.LocalPlayer

local BONE = Color3.fromRGB(226, 206, 160)
local TEXT = Color3.fromRGB(238, 234, 226)
local MUTED = Color3.fromRGB(156, 152, 146)
local SERIF = Enum.Font.Garamond

IntroController.Active = false

function IntroController:Init(all)
	controllers = all
end

local function new(class: string, props, children)
	local inst = Instance.new(class)
	for k, v in props do
		if k ~= "Parent" then
			inst[k] = v
		end
	end
	for _, c in children or {} do
		c.Parent = inst
	end
	inst.Parent = props.Parent
	return inst
end

-- The middle of your plot, and handy spots around the valley.
local function places()
	local origin = player:GetAttribute("PlotOrigin")
	if typeof(origin) ~= "Vector3" then
		origin = Vector3.new(0, 1, 0)
	end
	local half = Grid.PLOT_SIZE / 2
	local home = origin + Vector3.new(half, 0, half)
	local rival = Config.Rivals[1]
	return home, rival
end

-- Camera shots: each is a start and end CFrame the camera glides between.
local function shots()
	local home, rival = places()
	local gate = rival.Center + Vector3.new(math.cos(rival.GateAngle or 0), 0, math.sin(rival.GateAngle or 0)) * rival.Radius
	local function look(from: Vector3, at: Vector3)
		return CFrame.lookAt(from, at)
	end
	return {
		-- 1. low over the fjord, looking in at the land
		{ look(home + Vector3.new(-160, 14, -340), home + Vector3.new(0, 30, 200)), look(home + Vector3.new(-40, 16, -260), home + Vector3.new(60, 30, 200)) },
		-- 2. over the pine forest toward the mountains
		{ look(home + Vector3.new(-60, 70, 160), home + Vector3.new(-20, 120, 600)), look(home + Vector3.new(40, 80, 220), home + Vector3.new(80, 130, 620)) },
		-- 3. down onto your land
		{ look(home + Vector3.new(90, 90, -110), home), look(home + Vector3.new(50, 55, -80), home) },
		-- 4. the walls of Greywater Hold
		{ look(gate + Vector3.new(60, 30, -70), rival.Center + Vector3.new(0, 10, 0)), look(gate + Vector3.new(30, 18, -30), rival.Center + Vector3.new(0, 12, 0)) },
		-- 5. back home, rising over the village
		{ look(home + Vector3.new(-30, 20, -60), home + Vector3.new(0, 8, 20)), look(home + Vector3.new(-60, 70, -120), home + Vector3.new(0, 0, 40)) },
	}
end

local STORY = {
	"The old jarl is dead, and his sons have drawn swords over his hall.",
	"You took a longship and a handful of your kin, and sailed north up the cold fjord.",
	"Here, between the mountains and the sea, is land no one has claimed. Here you will build.",
	"But you are not alone. Greywater Hold watches from behind its walls, and raiders come by sea.",
	"Feed your people. Raise your hall. Make your name one the skalds will sing.",
}

local function camera(): Camera
	return workspace.CurrentCamera
end

-- Glides the camera along `shot` over `seconds`, until `stop()` is true.
local function glide(shot, seconds: number, stop)
	local cam = camera()
	cam.CameraType = Enum.CameraType.Scriptable
	local t0 = os.clock()
	while not stop() do
		local a = math.clamp((os.clock() - t0) / seconds, 0, 1)
		local e = a * a * (3 - 2 * a)
		cam.CFrame = shot[1]:Lerp(shot[2], e)
		if a >= 1 then
			break
		end
		RunService.RenderStepped:Wait()
	end
end

function IntroController:Start()
	local state = controllers.StateController
	while not state.State do
		task.wait(0.2)
	end
	IntroController.Active = true
	local camCtl = controllers.CameraController
	camCtl.Suspended = true
	-- no walking off while the title is up
	local controls
	pcall(function()
		controls = require(player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule")):GetControls()
		controls:Disable()
	end)

	local gui = new("ScreenGui", { Name = "Title", IgnoreGuiInset = true, DisplayOrder = 90, ResetOnSpawn = false })

	-- film bars and a dark vignette
	local top = new("Frame", { Size = UDim2.new(1, 0, 0.11, 0), BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0, Parent = gui })
	local bottom = new("Frame", { AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0.11, 0), BackgroundColor3 = Color3.new(0, 0, 0), BorderSizePixel = 0, Parent = gui })
	local shade = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(8, 10, 14), BackgroundTransparency = 0.35, BorderSizePixel = 0, Parent = gui }, {
		new("UIGradient", { Rotation = 0, Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(0.45, 0.85), NumberSequenceKeypoint.new(1, 1) }) }),
	})

	-- the title block, left of centre
	local block = new("Frame", { Position = UDim2.fromScale(0.07, 0.24), Size = UDim2.fromOffset(620, 400), BackgroundTransparency = 1, Parent = gui })
	new("TextLabel", { Size = UDim2.fromOffset(620, 26), BackgroundTransparency = 1, Font = SERIF, TextSize = 22, TextColor3 = MUTED, TextXAlignment = Enum.TextXAlignment.Left, Text = "A  SAGA  OF  THE  NORTH", Parent = block })
	local title = new("TextLabel", { Position = UDim2.fromOffset(0, 26), Size = UDim2.fromOffset(620, 110), BackgroundTransparency = 1, Font = SERIF, TextSize = 96, TextColor3 = TEXT, TextXAlignment = Enum.TextXAlignment.Left, Text = "VIKING CITY", Parent = block })
	new("UIStroke", { Color = Color3.new(0, 0, 0), Transparency = 0.6, Thickness = 1.5, Parent = title })
	new("Frame", { Position = UDim2.fromOffset(2, 142), Size = UDim2.fromOffset(420, 2), BackgroundColor3 = BONE, BorderSizePixel = 0, Parent = block }, {
		new("UIGradient", { Transparency = NumberSequence.new(0, 1) }),
	})
	new("TextLabel", { Position = UDim2.fromOffset(0, 156), Size = UDim2.fromOffset(560, 50), BackgroundTransparency = 1, Font = SERIF, TextSize = 22, TextWrapped = true, TextColor3 = TEXT, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, Text = "Settle the fjord. Grow a village into a kingdom. Raid your rivals by land and sea.", Parent = block })

	local buttons = new("Frame", { Position = UDim2.fromOffset(0, 230), Size = UDim2.fromOffset(300, 170), BackgroundTransparency = 1, Parent = block }, {
		new("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	local function button(label: string, order: number, main: boolean?)
		local b = new("TextButton", {
			Size = UDim2.fromOffset(main and 260 or 200, main and 52 or 40),
			BackgroundColor3 = main and Color3.fromRGB(60, 55, 48) or Color3.fromRGB(26, 26, 28),
			BackgroundTransparency = 0.1,
			AutoButtonColor = true,
			Font = SERIF,
			TextSize = main and 30 or 22,
			TextColor3 = main and BONE or TEXT,
			Text = label,
			LayoutOrder = order,
			Parent = buttons,
		}, {
			new("UICorner", { CornerRadius = UDim.new(0, 4) }),
			new("UIStroke", { Color = BONE, Transparency = main and 0.3 or 0.7, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }),
		})
		return b
	end
	local q = state.State.quest
	local fresh = q and q.index == 1
	local play = button(fresh and "BEGIN" or "CONTINUE", 1, true)
	local story = button("THE STORY", 2)
	local hint = new("TextLabel", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -16), Size = UDim2.fromOffset(700, 24), BackgroundTransparency = 1, Font = SERIF, TextSize = 18, TextColor3 = MUTED, Text = "In the game, press H for the controls", Parent = gui })

	-- the story caption, centred low over the film bar
	local caption = new("TextLabel", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 0.86, 0), Size = UDim2.new(0.7, 0, 0, 110), BackgroundTransparency = 1, Font = SERIF, TextSize = 32, TextWrapped = true, TextColor3 = TEXT, TextTransparency = 1, Text = "", Parent = gui })
	new("UIStroke", { Color = Color3.new(0, 0, 0), Transparency = 0.4, Thickness = 1.5, Parent = caption })
	local skip = new("TextButton", { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -24, 1, -14), Size = UDim2.fromOffset(110, 34), BackgroundColor3 = Color3.fromRGB(26, 26, 28), BackgroundTransparency = 0.2, Font = SERIF, TextSize = 20, TextColor3 = TEXT, Text = "Skip  »", Visible = false, Parent = gui }, {
		new("UICorner", { CornerRadius = UDim.new(0, 4) }),
	})
	local moreHint = new("TextLabel", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -18), Size = UDim2.fromOffset(400, 22), BackgroundTransparency = 1, Font = SERIF, TextSize = 17, TextColor3 = MUTED, Text = "Click to continue", Visible = false, Parent = gui })

	gui.Parent = player:WaitForChild("PlayerGui")

	-- the game's own panels (saga, build menu, hotbar...) hide behind the title
	local hidden = {}
	task.spawn(function()
		local playerGui = player:WaitForChild("PlayerGui")
		while gui.Parent and IntroController.Active do
			for _, other in playerGui:GetChildren() do
				if other:IsA("ScreenGui") and other ~= gui and other.Name ~= "Loading" and other.Enabled and hidden[other] == nil then
					hidden[other] = true
					other.Enabled = false
				end
			end
			task.wait(0.1)
		end
	end)
	local function showHud()
		for other in hidden do
			if other.Parent then
				other.Enabled = true
			end
		end
		hidden = {}
	end
	if controllers.AudioController and controllers.AudioController.PlayTheme then
		controllers.AudioController:PlayTheme()
	end

	-- the slow drift behind the title
	local mode = "title"
	local home = places()
	task.spawn(function()
		local cam = camera()
		local t0 = os.clock()
		while gui.Parent do
			if mode == "title" then
				cam.CameraType = Enum.CameraType.Scriptable
				local a = (os.clock() - t0) * 0.035 + math.pi * 1.15
				local from = home + Vector3.new(math.cos(a) * 170, 70, math.sin(a) * 170 - 60)
				cam.CFrame = CFrame.lookAt(from, home + Vector3.new(0, 6, 30))
			end
			RunService.RenderStepped:Wait()
		end
	end)

	local function fadeMenu(show: boolean)
		local info = TweenInfo.new(0.6)
		block.Visible = true
		for _, d in block:GetDescendants() do
			if d:IsA("TextLabel") or d:IsA("TextButton") then
				TweenService:Create(d, info, { TextTransparency = show and 0 or 1 }):Play()
			end
			if d:IsA("TextButton") then
				TweenService:Create(d, info, { BackgroundTransparency = show and 0.1 or 1 }):Play()
			end
			if d:IsA("UIStroke") then
				TweenService:Create(d, info, { Transparency = show and 0.5 or 1 }):Play()
			end
		end
		TweenService:Create(shade, info, { BackgroundTransparency = show and 0.35 or 0.75 }):Play()
		hint.Visible = show
		task.delay(0.6, function()
			if not show then
				block.Visible = false
			end
		end)
	end

	local busy = false
	local function runStory()
		if busy then
			return
		end
		busy = true
		mode = "story"
		fadeMenu(false)
		skip.Visible = true
		local skipped = false
		local advance = false
		local skipConn = skip.Activated:Connect(function()
			skipped = true
		end)
		local clickConn = UserInputService.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch or input.KeyCode == Enum.KeyCode.Space or input.KeyCode == Enum.KeyCode.Return then
				advance = true
			end
		end)
		local list = shots()
		for i, line in STORY do
			if skipped then
				break
			end
			advance = false
			caption.Text = line
			TweenService:Create(caption, TweenInfo.new(1.2), { TextTransparency = 0 }):Play()
			moreHint.Visible = true
			local t0 = os.clock()
			glide(list[i], 9, function()
				return skipped or advance or os.clock() - t0 > 9
			end)
			TweenService:Create(caption, TweenInfo.new(0.5), { TextTransparency = 1 }):Play()
			task.wait(0.5)
		end
		skipConn:Disconnect()
		clickConn:Disconnect()
		skip.Visible = false
		moreHint.Visible = false
		caption.Text = ""
		busy = false
		return true
	end

	local function enterGame()
		mode = "done"
		local info = TweenInfo.new(0.9)
		for _, f in { top, bottom } do
			TweenService:Create(f, info, { BackgroundTransparency = 1 }):Play()
		end
		TweenService:Create(shade, info, { BackgroundTransparency = 1 }):Play()
		fadeMenu(false)
		task.wait(0.4)
		camCtl.Suspended = false
		IntroController.Active = false
		showHud()
		if controls then
			controls:Enable()
		end
		task.wait(0.6)
		gui:Destroy()
		state:LocalNotify("Follow the gold marker to your next goal. Press H for the controls.", "info")
	end

	play.Activated:Connect(function()
		if busy then
			return
		end
		if fresh and not IntroController.SeenStory then
			IntroController.SeenStory = true
			runStory()
		end
		enterGame()
	end)
	story.Activated:Connect(function()
		IntroController.SeenStory = true
		runStory()
		mode = "title"
		fadeMenu(true)
	end)
end

return IntroController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="59">
            <Properties>
              <string name="Name">LoadingController</string>
              <string name="Source"><![CDATA[--[[
	LoadingController
	Shows a title card while the server shapes the valley and settles your
	people, then fades it away once your colony arrives.
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local LoadingController = {}

local controllers

function LoadingController:Init(allControllers)
	controllers = allControllers
end

function LoadingController:Start()
	local gui = Instance.new("ScreenGui")
	gui.Name = "Loading"
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 100
	gui.ResetOnSpawn = false

	local bg = Instance.new("Frame")
	bg.Size = UDim2.fromScale(1, 1)
	bg.BackgroundColor3 = Color3.fromRGB(14, 15, 17)
	bg.Parent = gui

	local gradient = Instance.new("UIGradient")
	gradient.Color = ColorSequence.new(Color3.fromRGB(40, 46, 54), Color3.fromRGB(12, 13, 15))
	gradient.Rotation = 90
	gradient.Parent = bg

	local title = Instance.new("TextLabel")
	title.AnchorPoint = Vector2.new(0.5, 0.5)
	title.Position = UDim2.fromScale(0.5, 0.42)
	title.Size = UDim2.fromOffset(700, 90)
	title.BackgroundTransparency = 1
	title.Font = Enum.Font.Garamond
	title.TextScaled = true
	title.TextColor3 = Color3.fromRGB(238, 234, 226)
	title.Text = "VIKING CITY"
	title.Parent = bg

	local sub = Instance.new("TextLabel")
	sub.AnchorPoint = Vector2.new(0.5, 0.5)
	sub.Position = UDim2.fromScale(0.5, 0.52)
	sub.Size = UDim2.fromOffset(700, 30)
	sub.BackgroundTransparency = 1
	sub.Font = Enum.Font.GothamMedium
	sub.TextSize = 18
	sub.TextColor3 = Color3.fromRGB(200, 190, 170)
	sub.Text = "Shaping the valley..."
	sub.Parent = bg

	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")

	local lines = { "Shaping the valley...", "Growing the forests...", "Filling the fjord...", "Your settlers are landing..." }
	local i = 1
	while not controllers.StateController.State do
		task.wait(1.2)
		i = i % #lines + 1
		sub.Text = lines[i]
	end
	task.wait(0.5)
	local fade = TweenInfo.new(1.2)
	TweenService:Create(bg, fade, { BackgroundTransparency = 1 }):Play()
	TweenService:Create(title, fade, { TextTransparency = 1 }):Play()
	TweenService:Create(sub, fade, { TextTransparency = 1 }):Play()
	task.wait(1.3)
	gui:Destroy()
end

return LoadingController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="60">
            <Properties>
              <string name="Name">MinimapController</string>
              <string name="Source"><![CDATA[--[[
	MinimapController
	A round-cornered map in the top right that turns with your camera:
	your plot (gold), other plots, rival holds (red), Ottar's stalls
	(yellow), ships (blue = yours, red = enemy), deer (brown), wolves (grey),
	other players (white) and
	you (the arrow in the middle). Press M to make it bigger or smaller.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Grid = require(Shared.Grid)

local MinimapController = {}

local controllers

function MinimapController:Init(all)
	controllers = all
end

local player = Players.LocalPlayer
local SIZES = { 200, 320 }
local RANGE = 360 -- studs from the centre to the edge

local function new(className, props)
	local inst = Instance.new(className)
	for k, v in props do
		if k ~= "Parent" then
			inst[k] = v
		end
	end
	inst.Parent = props.Parent
	return inst
end

function MinimapController:Start()
	local gui = new("ScreenGui", { Name = "Minimap", ResetOnSpawn = false, Parent = player:WaitForChild("PlayerGui") })
	local sizeIndex = 1
	local frame = new("Frame", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 216),
		Size = UDim2.fromOffset(SIZES[1], SIZES[1]),
		BackgroundColor3 = Color3.fromRGB(58, 72, 46),
		BackgroundTransparency = 0.15,
		ClipsDescendants = true,
		Parent = gui,
	})
	new("UICorner", { CornerRadius = UDim.new(0, 14), Parent = frame })
	new("UIStroke", { Color = Color3.fromRGB(214, 170, 92), Thickness = 2, Transparency = 0.35, Parent = frame })
	local layer = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = frame })
	new("TextLabel", {
		Position = UDim2.new(0, 0, 1, -18),
		Size = UDim2.new(1, 0, 0, 16),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamMedium,
		TextSize = 11,
		TextColor3 = Color3.fromRGB(230, 220, 200),
		TextStrokeTransparency = 0.5,
		Text = "M: bigger map",
		ZIndex = 5,
		Parent = frame,
	})

	-- fixed things in the world: plots, holds, stalls, the shoreline
	local fixed = {}
	local function addFixed(pos: Vector3, size: Vector2, color: Color3, label: string?, round: boolean?, z: number?)
		local f = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), BackgroundColor3 = color, BorderSizePixel = 0, ZIndex = z or 2, Parent = layer })
		if round then
			new("UICorner", { CornerRadius = UDim.new(1, 0), Parent = f })
		end
		local text
		if label then
			text = new("TextLabel", {
				AnchorPoint = Vector2.new(0.5, 1),
				Position = UDim2.new(0.5, 0, 0, -2),
				Size = UDim2.fromOffset(120, 14),
				BackgroundTransparency = 1,
				Font = Enum.Font.GothamBold,
				TextSize = 11,
				TextColor3 = Color3.new(1, 1, 1),
				TextStrokeTransparency = 0.3,
				Text = label,
				ZIndex = 4,
				Parent = f,
			})
		end
		table.insert(fixed, { frame = f, pos = pos, size = size, text = text })
		return f
	end

	-- the fjord: a wide band of water beyond the beach
	local water = addFixed(Vector3.new(800, 0, -40 - 400), Vector2.new(4000, 800), Color3.fromRGB(56, 88, 112), nil, false, 1)
	water.BackgroundTransparency = 0.1
	-- the two rivers, drawn as a chain of short pieces (same curve as the server's)
	local riverFrames = {}
	local function drawRivers()
		for _, f in riverFrames do
			f:Destroy()
		end
		table.clear(riverFrames)
		for i = #fixed, 1, -1 do
			if fixed[i].river then
				table.remove(fixed, i)
			end
		end
		local bases = workspace:GetAttribute("RiverBases")
		local span = workspace:GetAttribute("RiverZ")
		if typeof(bases) ~= "Vector2" or typeof(span) ~= "Vector2" then
			return
		end
		for _, base in { bases.X, bases.Y } do
			for z = span.X, span.Y, 16 do
				local x = base + math.sin(z / 110 + base) * 30 + math.sin(z / 47) * 12
				local f = addFixed(Vector3.new(x, 0, z), Vector2.new(16, 18), Color3.fromRGB(56, 88, 112), nil, false, 1)
				fixed[#fixed].river = true
				table.insert(riverFrames, f)
			end
		end
	end
	drawRivers()
	workspace:GetAttributeChangedSignal("RiverBases"):Connect(drawRivers)

	local plotFrames = {}
	for i = 1, Config.MAX_PLOTS do
		local o = Grid.plotOrigin(i)
		local centre = o + Vector3.new(Grid.PLOT_SIZE / 2, 0, Grid.PLOT_SIZE / 2)
		local f = addFixed(centre, Vector2.new(Grid.PLOT_SIZE, Grid.PLOT_SIZE), Color3.fromRGB(110, 120, 80))
		f.BackgroundTransparency = 0.45
		plotFrames[i] = f
		addFixed(Vector3.new(o.X + 100, 0, -16), Vector2.new(10, 10), Color3.fromRGB(240, 200, 80), nil, true, 3)
	end
	for _, rival in Config.Rivals do
		local f = addFixed(rival.Center, Vector2.new(rival.Radius * 2, rival.Radius * 2), Color3.fromRGB(170, 60, 50), rival.Name, true)
		f.BackgroundTransparency = 0.35
	end

	-- moving markers (pooled)
	local pool = {}
	local function dot(i: number): Frame
		local f = pool[i]
		if not f then
			f = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(7, 7), BorderSizePixel = 0, ZIndex = 6, Parent = layer })
			new("UICorner", { CornerRadius = UDim.new(1, 0), Parent = f })
			new("UIStroke", { Color = Color3.new(0, 0, 0), Thickness = 1, Transparency = 0.4, Parent = f })
			pool[i] = f
		end
		f.Visible = true
		return f
	end

	-- you: an arrow in the middle, always pointing up (the map turns instead)
	new("TextLabel", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(18, 18),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		TextSize = 18,
		TextColor3 = Color3.fromRGB(255, 230, 150),
		TextStrokeTransparency = 0.2,
		Text = "▲",
		ZIndex = 8,
		Parent = frame,
	})
	-- the saga's next goal: a gold star, held at the edge when it's far away
	local goal = new("TextLabel", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromOffset(18, 18),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold,
		TextSize = 18,
		TextColor3 = Color3.fromRGB(240, 196, 92),
		TextStrokeTransparency = 0.1,
		Text = "★",
		ZIndex = 9,
		Visible = false,
		Parent = frame,
	})
	MinimapController.Toggle = function()
		sizeIndex = sizeIndex % #SIZES + 1
		frame.Size = UDim2.fromOffset(SIZES[sizeIndex], SIZES[sizeIndex])
	end
	UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and input.KeyCode == Enum.KeyCode.M then
			MinimapController:Toggle()
		end
	end)

	local camera = workspace.CurrentCamera
	local timer = 0
	RunService.RenderStepped:Connect(function(dt)
		timer += dt
		if timer < 1 / 20 then
			return
		end
		timer = 0
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		local centre = root and root.Position or camera.Focus.Position
		local look = camera.CFrame.LookVector
		local fwd = Vector3.new(look.X, 0, look.Z)
		fwd = fwd.Magnitude > 0.01 and fwd.Unit or Vector3.new(0, 0, 1)
		local right = Vector3.new(-fwd.Z, 0, fwd.X)
		local px = SIZES[sizeIndex]
		local k = (px / 2) / RANGE
		local yaw = math.deg(math.atan2(fwd.X, fwd.Z))

		local function place(f: GuiObject, pos: Vector3)
			local rel = pos - centre
			local sx, sy = rel:Dot(right), rel:Dot(fwd)
			f.Position = UDim2.fromOffset(px / 2 + sx * k, px / 2 - sy * k)
		end

		local mine = player:GetAttribute("PlotIndex")
		for i, f in plotFrames do
			f.BackgroundColor3 = i == mine and Color3.fromRGB(214, 170, 92) or Color3.fromRGB(110, 120, 80)
		end
		for _, item in fixed do
			place(item.frame, item.pos)
			item.frame.Size = UDim2.fromOffset(math.max(item.size.X * k, 4), math.max(item.size.Y * k, 4))
			item.frame.Rotation = yaw
			if item.text then
				item.text.Rotation = -yaw
			end
		end

		local n = 0
		for _, other in Players:GetPlayers() do
			local r = other ~= player and other.Character and other.Character:FindFirstChild("HumanoidRootPart")
			if r then
				n += 1
				local f = dot(n)
				f.BackgroundColor3 = Color3.new(1, 1, 1)
				f.Size = UDim2.fromOffset(7, 7)
				place(f, r.Position)
			end
		end
		for _, child in workspace:GetChildren() do
			if child:IsA("Model") and child:GetAttribute("Ship") then
				n += 1
				local f = dot(n)
				local owner = child:GetAttribute("OwnerUserId")
				f.BackgroundColor3 = owner == player.UserId and Color3.fromRGB(90, 170, 255) or (owner == 0 and Color3.fromRGB(230, 70, 60) or Color3.fromRGB(240, 240, 240))
				f.Size = UDim2.fromOffset(10, 10)
				place(f, child:GetPivot().Position)
			end
		end
		-- deer (brown) and, in winter, wolves (grey)
		local wild = workspace:FindFirstChild("Wildlife")
		if wild then
			for _, m in wild:GetChildren() do
				local body = m:IsA("Model") and m.PrimaryPart
				if body and (body.Position - centre).Magnitude < RANGE * 1.5 then
					n += 1
					local f = dot(n)
					local wolf = m:GetAttribute("Wolf") == true
					f.BackgroundColor3 = wolf and Color3.fromRGB(150, 150, 156) or Color3.fromRGB(176, 124, 74)
					f.Size = UDim2.fromOffset(wolf and 6 or 5, wolf and 6 or 5)
					place(f, body.Position)
				end
			end
		end
		for i = n + 1, #pool do
			pool[i].Visible = false
		end
		local target = controllers and controllers.GuideController and controllers.GuideController.Target
		if target then
			local rel = target - centre
			local sx, sy = rel:Dot(right) * k, rel:Dot(fwd) * k
			local edge = px / 2 - 10
			local far = math.max(math.abs(sx), math.abs(sy))
			if far > edge then
				sx, sy = sx / far * edge, sy / far * edge
			end
			goal.Position = UDim2.fromOffset(px / 2 + sx, px / 2 - sy)
			goal.Visible = true
		else
			goal.Visible = false
		end
	end)
end

return MinimapController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="61">
            <Properties>
              <string name="Name">ScreenToggleController</string>
              <string name="Source"><![CDATA[--[[
	ScreenToggleController
	Press X to hide every panel on screen (for screenshots and for just
	looking at your village), and X again to bring them back.
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local ScreenToggleController = {}

local controllers

function ScreenToggleController:Init(all)
	controllers = all
end

function ScreenToggleController:Start()
	local player = Players.LocalPlayer
	local hidden: { [ScreenGui]: boolean }? = nil
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed or input.KeyCode ~= Enum.KeyCode.X then
			return
		end
		if controllers.IntroController and controllers.IntroController.Active then
			return -- the title screen manages the panels itself
		end
		local playerGui = player:FindFirstChildOfClass("PlayerGui")
		if not playerGui then
			return
		end
		if hidden then
			for gui in hidden do
				if gui.Parent then
					gui.Enabled = true
				end
			end
			hidden = nil
		else
			hidden = {}
			for _, gui in playerGui:GetChildren() do
				if gui:IsA("ScreenGui") and gui.Enabled and gui.Name ~= "TerrainError" then
					hidden[gui] = true
					gui.Enabled = false
				end
			end
		end
	end)
end

return ScreenToggleController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="62">
            <Properties>
              <string name="Name">SeasonFxController</string>
              <string name="Source"><![CDATA[--[[
	SeasonFxController
	Weather around your camera that follows the season:
	  Winter  snowfall
	  Autumn  drifting gold and red leaves
	  Spring  a few floating pollen motes
	and in winter you leave footprints in the snow that slowly fill in.
]]

local RunService = game:GetService("RunService")

local SeasonFxController = {}

local SPARKLE = "rbxasset://textures/particles/sparkles_main.dds"

local function emitter(parent: BasePart): ParticleEmitter
	local e = Instance.new("ParticleEmitter")
	e.Texture = SPARKLE
	e.LightEmission = 0
	e.LightInfluence = 1
	e.Rate = 0
	e.Parent = parent
	return e
end

function SeasonFxController:Start()
	local box = Instance.new("Part")
	box.Name = "WeatherBox"
	box.Anchored = true
	box.CanCollide = false
	box.CanQuery = false
	box.CanTouch = false
	box.Transparency = 1
	box.Size = Vector3.new(160, 1, 160)
	box.Parent = workspace

	local snow = emitter(box)
	snow.Color = ColorSequence.new(Color3.new(1, 1, 1))
	snow.Size = NumberSequence.new(0.35)
	snow.Lifetime = NumberRange.new(6, 9)
	snow.Speed = NumberRange.new(6, 10)
	snow.SpreadAngle = Vector2.new(12, 12)
	snow.EmissionDirection = Enum.NormalId.Bottom
	snow.Acceleration = Vector3.new(1.5, 0, 0.8)
	snow.RotSpeed = NumberRange.new(-60, 60)

	local leaves = emitter(box)
	leaves.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(222, 170, 60)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(200, 100, 40)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(170, 60, 36)),
	})
	leaves.Size = NumberSequence.new(0.6)
	leaves.Lifetime = NumberRange.new(7, 10)
	leaves.Speed = NumberRange.new(3, 5)
	leaves.EmissionDirection = Enum.NormalId.Bottom
	leaves.Acceleration = Vector3.new(3, 0, 1)
	leaves.RotSpeed = NumberRange.new(-180, 180)
	leaves.Rotation = NumberRange.new(0, 360)

	local pollen = emitter(box)
	pollen.Color = ColorSequence.new(Color3.fromRGB(255, 250, 220))
	pollen.Size = NumberSequence.new(0.2)
	pollen.Transparency = NumberSequence.new(0.4)
	pollen.Lifetime = NumberRange.new(8, 12)
	pollen.Speed = NumberRange.new(0.5, 1.5)
	pollen.SpreadAngle = Vector2.new(180, 180)
	pollen.LightEmission = 0.6

	local function update()
		local season = workspace:GetAttribute("Season")
		-- a winter storm is a blizzard
		snow.Rate = season == "Winter" and (450 + (workspace:GetAttribute("StormLevel") or 0) * 1100) or 0
		leaves.Rate = season == "Autumn" and 25 or 0
		pollen.Rate = season == "Spring" and 18 or 0
	end
	workspace:GetAttributeChangedSignal("Season"):Connect(update)
	workspace:GetAttributeChangedSignal("StormLevel"):Connect(update)
	update()

	-- low morning mist that hangs over the water and the valley floor
	local mistBox = Instance.new("Part")
	mistBox.Name = "MistBox"
	mistBox.Anchored = true
	mistBox.CanCollide = false
	mistBox.CanQuery = false
	mistBox.CanTouch = false
	mistBox.Transparency = 1
	mistBox.Size = Vector3.new(220, 1, 220)
	mistBox.Parent = workspace
	local mist = emitter(mistBox)
	mist.Texture = "rbxasset://textures/particles/smoke_main.dds"
	mist.Color = ColorSequence.new(Color3.fromRGB(214, 222, 232))
	mist.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 14), NumberSequenceKeypoint.new(1, 30) })
	mist.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.3, 0.86), NumberSequenceKeypoint.new(0.7, 0.88), NumberSequenceKeypoint.new(1, 1) })
	mist.Lifetime = NumberRange.new(14, 20)
	mist.Speed = NumberRange.new(0.6, 1.6)
	mist.SpreadAngle = Vector2.new(180, 10)
	mist.Rotation = NumberRange.new(0, 360)
	mist.RotSpeed = NumberRange.new(-4, 4)
	mist.Acceleration = Vector3.new(0.4, 0, 0.2)
	mist.LightInfluence = 0.8

	-- footprints in the snow: left, right, left... each fades away
	local Players = game:GetService("Players")
	local TweenService = game:GetService("TweenService")
	local prints = Instance.new("Folder")
	prints.Name = "Footprints"
	prints.Parent = workspace
	local lastPrint: Vector3? = nil
	local leftFoot = true
	local printParams = RaycastParams.new()
	printParams.FilterType = Enum.RaycastFilterType.Include
	printParams.FilterDescendantsInstances = { workspace.Terrain }
	local function stepPrints()
		if workspace:GetAttribute("Season") ~= "Winter" then
			lastPrint = nil
			return
		end
		local character = Players.LocalPlayer.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if not root or not humanoid or humanoid.FloorMaterial == Enum.Material.Air then
			return
		end
		local pos = root.Position
		if lastPrint and (pos - lastPrint).Magnitude < 2.2 then
			return
		end
		local move = lastPrint and (pos - lastPrint) or root.CFrame.LookVector
		lastPrint = pos
		local flat = Vector3.new(move.X, 0, move.Z)
		if flat.Magnitude < 0.01 then
			return
		end
		flat = flat.Unit
		local side = Vector3.new(-flat.Z, 0, flat.X) * (leftFoot and -0.45 or 0.45)
		leftFoot = not leftFoot
		local hit = workspace:Raycast(pos + side + Vector3.new(0, 2, 0), Vector3.new(0, -10, 0), printParams)
		if not hit then
			return
		end
		local p = Instance.new("Part")
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.CastShadow = false
		p.Size = Vector3.new(0.55, 0.05, 1)
		p.Color = Color3.fromRGB(176, 186, 200)
		p.Material = Enum.Material.SmoothPlastic
		p.Transparency = 0.35
		p.CFrame = CFrame.lookAt(hit.Position, hit.Position + flat, hit.Normal) * CFrame.new(0, 0.03, 0)
		p.Parent = prints
		TweenService:Create(p, TweenInfo.new(10, Enum.EasingStyle.Linear), { Transparency = 1 }):Play()
		task.delay(10.5, function()
			p:Destroy()
		end)
	end

	local Lighting = game:GetService("Lighting")
	local mistTimer = 0
	RunService.RenderStepped:Connect(function(dt)
		local cam = workspace.CurrentCamera.CFrame.Position
		-- hover above the camera's focus area so the weather surrounds you
		box.CFrame = CFrame.new(cam.X, cam.Y + 35, cam.Z)
		-- the mist stays low, at the water and on the valley floor
		mistBox.CFrame = CFrame.new(cam.X, 2.5, cam.Z)
		stepPrints()
		mistTimer += dt
		if mistTimer > 1 then
			mistTimer = 0
			local clock = Lighting.ClockTime
			-- strongest at dawn, a little in the evening, more in fog and autumn
			local dawn = math.clamp(1 - math.abs(clock - 6.5) / 2.5, 0, 1)
			local dusk = math.clamp(1 - math.abs(clock - 20.5) / 2, 0, 1) * 0.5
			local fog = workspace:GetAttribute("FogLevel") or 0
			local autumn = workspace:GetAttribute("Season") == "Autumn" and 0.3 or 0
			local high = math.clamp((cam.Y - 30) / 60, 0, 1) -- from high up it would only blur the view
			mist.Rate = math.max(dawn, dusk, fog * 0.6, autumn) * 5 * (1 - high)
		end
	end)
end

return SeasonFxController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="63">
            <Properties>
              <string name="Name">StateController</string>
              <string name="Source"><![CDATA[--[[
	StateController
	Keeps the latest colony snapshot from the server and tells other
	controllers when it changes.

	StateController.State    -- latest snapshot (nil until the first one)
	StateController.Blocked  -- set of blocked grid cells { ["x,z"] = true }
	StateController.Changed  -- Event, fires with the snapshot
	StateController.Notified -- Event, fires with (text, kind)
]]

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Remotes = require(Shared.Remotes)

local StateController = {}

local changed = Instance.new("BindableEvent")
local notified = Instance.new("BindableEvent")
StateController.Changed = changed.Event
StateController.Notified = notified.Event
StateController.State = nil
StateController.Blocked = {}

function StateController:Start()
	Remotes.ColonyState.OnClientEvent:Connect(function(state)
		if state.blocked then
			local set = {}
			for _, key in state.blocked do
				set[key] = true
			end
			self.Blocked = set
		end
		self.State = state
		changed:Fire(state)
	end)
	Remotes.Notify.OnClientEvent:Connect(function(text, kind)
		notified:Fire(text, kind)
	end)
end

-- Lets other client code show a message in the same feed.
function StateController:LocalNotify(text: string, kind: string?)
	notified:Fire(text, kind or "info")
end

return StateController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="64">
            <Properties>
              <string name="Name">TechController</string>
              <string name="Source"><![CDATA[--[[
	TechController
	The research screen. Press T (or the Research button) to open it.
	Five columns: Buildings, Gear, Boats, Culture, Religion. Each card shows
	what a tech does, what it costs and what it still needs. Click a card
	you can afford to research it.
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Grid = require(Shared.Grid)
local Remotes = require(Shared.Remotes)

local TechController = {}

local controllers
local player = Players.LocalPlayer

local THEME = {
	Panel = Color3.fromRGB(20, 20, 22),
	Card = Color3.fromRGB(38, 38, 41),
	Done = Color3.fromRGB(46, 72, 44),
	Ready = Color3.fromRGB(74, 62, 42),
	Locked = Color3.fromRGB(32, 32, 34),
	Accent = Color3.fromRGB(226, 206, 160),
	Text = Color3.fromRGB(238, 234, 226),
	Muted = Color3.fromRGB(156, 152, 146),
	Bad = Color3.fromRGB(230, 110, 96),
}

local BRANCH_ICON = { Buildings = "Hall", Gear = "Forge", Boats = "Keel", Culture = "Saga", Religion = "Faith" }

local function new(className, props)
	local inst = Instance.new(className)
	for k, v in props do
		if k ~= "Parent" then
			inst[k] = v
		end
	end
	inst.Parent = props.Parent
	return inst
end

local function corner(parent, r)
	new("UICorner", { CornerRadius = UDim.new(0, r or 8), Parent = parent })
end

-- Mirrors TechService:CanResearch on the client for display.
local function status(state, id: string): (string, string?)
	local tech = Config.Tech[id]
	local known = {}
	for _, t in state.tech or {} do
		known[t] = true
	end
	if known[id] then
		return "done", nil
	end
	for _, req in tech.Requires or {} do
		if not known[req] then
			return "locked", "Needs " .. Config.Tech[req].Name
		end
	end
	if tech.Building and not (state.buildingTypes and state.buildingTypes[tech.Building]) then
		return "locked", "Needs a " .. Config.Buildings[tech.Building].Display
	end
	if tech.Group then
		for t in known do
			if Config.Tech[t] and Config.Tech[t].Group == tech.Group then
				return "locked", "You follow " .. Config.Tech[t].Name
			end
		end
	end
	if not Grid.canAfford(state.resources, tech.Cost) then
		return "poor", nil
	end
	return "ready", nil
end

function TechController:Init(allControllers)
	controllers = allControllers
end

function TechController:Start()
	local gui = new("ScreenGui", { Name = "Research", ResetOnSpawn = false, DisplayOrder = 10, Parent = player:WaitForChild("PlayerGui") })

	local openButton = new("TextButton", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 170),
		Size = UDim2.fromOffset(113, 36),
		BackgroundColor3 = Color3.fromRGB(70, 54, 34),
		Font = Enum.Font.GothamBold,
		TextSize = 14,
		TextColor3 = THEME.Accent,
		Text = "Research (T)",
		Parent = gui,
	})
	corner(openButton)

	local panel = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(1060, 560),
		BackgroundColor3 = THEME.Panel,
		BackgroundTransparency = 0.04,
		Visible = false,
		Parent = gui,
	})
	corner(panel, 12)
	new("UIStroke", { Color = THEME.Accent, Thickness = 2, Transparency = 0.4, Parent = panel })

	new("TextLabel", {
		Position = UDim2.fromOffset(20, 12),
		Size = UDim2.new(1, -40, 0, 34),
		BackgroundTransparency = 1,
		Font = Enum.Font.Garamond,
		TextSize = 30,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = THEME.Accent,
		Text = "Research",
		Parent = panel,
	})
	local loreLabel = new("TextLabel", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -60, 0, 18),
		Size = UDim2.fromOffset(420, 26),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamMedium,
		TextSize = 16,
		TextXAlignment = Enum.TextXAlignment.Right,
		TextColor3 = Color3.fromRGB(150, 185, 240),
		Text = "",
		Parent = panel,
	})
	local close = new("TextButton", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -14, 0, 14),
		Size = UDim2.fromOffset(32, 32),
		BackgroundColor3 = THEME.Card,
		Font = Enum.Font.GothamBold,
		TextSize = 18,
		TextColor3 = THEME.Text,
		Text = "X",
		Parent = panel,
	})
	corner(close, 6)

	local columns = new("Frame", {
		Position = UDim2.fromOffset(16, 58),
		Size = UDim2.new(1, -32, 1, -74),
		BackgroundTransparency = 1,
		Parent = panel,
	})
	new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder, Parent = columns })

	local cards = {}
	for i, branch in Config.TechBranches do
		local col = new("Frame", {
			Size = UDim2.new(0.2, -8, 1, 0),
			BackgroundTransparency = 1,
			LayoutOrder = i,
			Parent = columns,
		})
		new("TextLabel", {
			Size = UDim2.new(1, 0, 0, 26),
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamBold,
			TextSize = 17,
			TextColor3 = THEME.Accent,
			Text = string.upper(branch) .. "  ·  " .. BRANCH_ICON[branch],
			Parent = col,
		})
		local list = new("ScrollingFrame", {
			Position = UDim2.fromOffset(0, 30),
			Size = UDim2.new(1, 0, 1, -30),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ScrollBarThickness = 4,
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			CanvasSize = UDim2.new(),
			Parent = col,
		})
		new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = list })

		-- order the techs so prerequisites come first
		local ids = {}
		for id, tech in Config.Tech do
			if tech.Branch == branch then
				table.insert(ids, id)
			end
		end
		table.sort(ids, function(a, b)
			local ra, rb = #(Config.Tech[a].Requires or {}), #(Config.Tech[b].Requires or {})
			if ra ~= rb then
				return ra < rb
			end
			return Config.Tech[a].Name < Config.Tech[b].Name
		end)

		for order, id in ids do
			local tech = Config.Tech[id]
			local card = new("TextButton", {
				Size = UDim2.new(1, -6, 0, 112),
				BackgroundColor3 = THEME.Card,
				AutoButtonColor = true,
				Text = "",
				LayoutOrder = order,
				Parent = list,
			})
			corner(card)
			local stroke = new("UIStroke", { ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Color = THEME.Accent, Thickness = 1.5, Transparency = 0.7, Parent = card })
			new("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), PaddingTop = UDim.new(0, 6), Parent = card })
			new("TextLabel", {
				Size = UDim2.new(1, 0, 0, 20),
				BackgroundTransparency = 1,
				Font = Enum.Font.GothamBold,
				TextSize = 15,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextColor3 = THEME.Text,
				Text = tech.Name,
				Parent = card,
			})
			new("TextLabel", {
				Position = UDim2.fromOffset(0, 22),
				Size = UDim2.new(1, 0, 0, 46),
				BackgroundTransparency = 1,
				Font = Enum.Font.Gotham,
				TextSize = 13,
				TextWrapped = true,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Top,
				TextColor3 = THEME.Muted,
				Text = tech.Description,
				Parent = card,
			})
			local foot = new("TextLabel", {
				Position = UDim2.fromOffset(0, 72),
				Size = UDim2.new(1, 0, 0, 30),
				BackgroundTransparency = 1,
				Font = Enum.Font.GothamMedium,
				TextSize = 12,
				TextWrapped = true,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextColor3 = THEME.Accent,
				Text = Grid.costText(tech.Cost),
				Parent = card,
			})
			card.Activated:Connect(function()
				local ok, msg = Remotes.Research:InvokeServer(id)
				controllers.StateController:LocalNotify(msg, ok and "good" or "bad")
				if ok then
					-- a little flash of gold
					card.BackgroundColor3 = THEME.Accent
					TweenService:Create(card, TweenInfo.new(0.6), { BackgroundColor3 = THEME.Done }):Play()
				end
			end)
			cards[id] = { card = card, foot = foot, stroke = stroke }
		end
	end

	local function refresh(state)
		if not state then
			return
		end
		loreLabel.Text = string.format("Lore %d   ·   build a Lore Hall to gather more", state.resources.Lore or 0)
		for id, c in cards do
			local st, why = status(state, id)
			local tech = Config.Tech[id]
			if st == "done" then
				c.card.BackgroundColor3 = THEME.Done
				c.foot.Text = "Known"
				c.foot.TextColor3 = Color3.fromRGB(150, 220, 140)
				c.stroke.Transparency = 0.9
			elseif st == "locked" then
				c.card.BackgroundColor3 = THEME.Locked
				c.foot.Text = why .. "   ·   " .. Grid.costText(tech.Cost)
				c.foot.TextColor3 = THEME.Muted
				c.stroke.Transparency = 0.9
			elseif st == "poor" then
				c.card.BackgroundColor3 = THEME.Card
				c.foot.Text = Grid.costText(tech.Cost)
				c.foot.TextColor3 = THEME.Bad
				c.stroke.Transparency = 0.7
			else
				c.card.BackgroundColor3 = THEME.Ready
				c.foot.Text = Grid.costText(tech.Cost) .. "   ·   click to research"
				c.foot.TextColor3 = THEME.Accent
				c.stroke.Transparency = 0.1
			end
		end
	end

	local function toggle()
		panel.Visible = not panel.Visible
		if panel.Visible then
			refresh(controllers.StateController.State)
		end
	end
	TechController.Toggle = toggle
	openButton.Activated:Connect(toggle)
	close.Activated:Connect(toggle)
	UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and input.KeyCode == Enum.KeyCode.T then
			toggle()
		end
	end)
	controllers.StateController.Changed:Connect(function(state)
		if panel.Visible then
			refresh(state)
		end
	end)
end

return TechController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="65">
            <Properties>
              <string name="Name">ToolController</string>
              <string name="Source"><![CDATA[--[[
	ToolController
	Makes the tools feel alive on your side:
	  Bow      click to shoot where the mouse points (the server checks the hit)
	  Axe /
	  Pickaxe  click to swing at a tree or rock (or an enemy)
	  Sword    click to fight
]]

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Remotes = require(Shared.Remotes)
local Config = require(Shared.Config)
local Pointer = require(Shared.Pointer)

local ToolController = {}

local player = Players.LocalPlayer
local lastShot = 0

local function aimPoint(): Vector3
	local camera = workspace.CurrentCamera
	local pos = Pointer.location()
	local ray = camera:ViewportPointToRay(pos.X, pos.Y)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { player.Character }
	local hit = workspace:Raycast(ray.Origin, ray.Direction * 1000, params)
	return hit and hit.Position or ray.Origin + ray.Direction * 1000
end

-- A two-handed overhead chop: wind the arm up and back, lean in, bring it
-- down hard, then recover. Works on the character's own shoulder and waist
-- joints, so there's no animation to upload. Other tools get a quicker swing.
local swinging = false

local function joint(character: Model, r15: string, r15Part: string, r6: string): Motor6D?
	local part = character:FindFirstChild(r15Part)
	local j = part and part:FindFirstChild(r15)
	if j and j:IsA("Motor6D") then
		return j
	end
	local torso = character:FindFirstChild("Torso") or character:FindFirstChild("HumanoidRootPart")
	j = torso and torso:FindFirstChild(r6)
	return (j and j:IsA("Motor6D")) and j or nil
end

local function swing(tool: Tool)
	if swinging then
		return
	end
	swinging = true
	local character = player.Character
	local heavy = tool.Name == "Axe" or tool.Name == "Pickaxe"
	local shoulder = character and joint(character, "RightShoulder", "RightUpperArm", "Right Shoulder")
	local waist = character and joint(character, "Waist", "UpperTorso", "RootJoint")
	local r6 = shoulder ~= nil and shoulder.Name == "Right Shoulder"
	-- the tool's true resting grip, remembered once, so quick clicks can never
	-- leave it turned (that was the sideways axe)
	local baseGrip = tool:GetAttribute("RestGrip")
	if typeof(baseGrip) ~= "CFrame" then
		baseGrip = tool.Grip
		tool:SetAttribute("RestGrip", baseGrip)
	end
	local baseShoulder = shoulder and shoulder.C0
	local baseWaist = waist and waist.C0

	-- arm angle: how far the arm is raised forward from hanging (degrees)
	local function arm(deg: number): CFrame?
		if not baseShoulder then
			return nil
		end
		if r6 then
			return baseShoulder * CFrame.Angles(0, 0, math.rad(deg))
		end
		return baseShoulder * CFrame.Angles(math.rad(deg), 0, 0)
	end
	local function lean(deg: number, twist: number): CFrame?
		if not baseWaist or r6 then
			return baseWaist
		end
		return baseWaist * CFrame.Angles(math.rad(deg), math.rad(twist), 0)
	end
	local function step(duration: number, style: Enum.EasingStyle, dir: Enum.EasingDirection, armDeg: number, leanDeg: number, twist: number, gripDeg: number)
		local info = TweenInfo.new(duration, style, dir)
		-- tilt in the hand's own frame, so a tool turned round in its grip (the axe) still chops forward
		local tweens = { TweenService:Create(tool, info, { Grip = CFrame.new(baseGrip.Position) * CFrame.Angles(math.rad(gripDeg), 0, 0) * baseGrip.Rotation }) }
		if shoulder then
			table.insert(tweens, TweenService:Create(shoulder, info, { C0 = arm(armDeg) }))
		end
		if waist and not r6 then
			table.insert(tweens, TweenService:Create(waist, info, { C0 = lean(leanDeg, twist) }))
		end
		for _, t in tweens do
			t:Play()
		end
		task.wait(duration)
	end

	local ok = pcall(function()
		if heavy then
			-- wind up: arm high and back, body turning away, blade cocked
			step(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 165, 8, 20, 35)
			task.wait(0.04)
			-- the chop: fast and hard, leaning into it
			step(0.11, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 45, -18, -10, -60)
			task.wait(0.08)
			-- recover
			step(0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.Out, 0, 0, 0, 0)
		else
			step(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 120, 4, 25, 20)
			step(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 40, -10, -25, -50)
			step(0.15, Enum.EasingStyle.Sine, Enum.EasingDirection.Out, 0, 0, 0, 0)
		end
	end)
	-- always put everything back exactly, even if the character changed
	if tool.Parent then
		tool.Grip = baseGrip
	end
	if shoulder and shoulder.Parent and baseShoulder then
		shoulder.C0 = baseShoulder
	end
	if waist and waist.Parent and baseWaist then
		waist.C0 = baseWaist
	end
	if not ok then
		warn("[ToolController] swing failed")
	end
	swinging = false
end

local function hookTool(tool: Instance)
	if not tool:IsA("Tool") or tool:GetAttribute("Hooked") then
		return
	end
	tool:SetAttribute("Hooked", true)
	tool:SetAttribute("RestGrip", tool.Grip)
	tool.Activated:Connect(function()
		if tool.Name == "Bow" then
			local now = os.clock()
			if now - lastShot < Config.Bow.Cooldown then
				return
			end
			lastShot = now
			Remotes.ShootArrow:FireServer(aimPoint())
		else
			if Config.Combat.MeleeDamage[tool.Name] then
				Remotes.Strike:FireServer()
			end
			task.spawn(swing, tool)
		end
	end)
end

function ToolController:Start()
	local function watch(container: Instance)
		for _, child in container:GetChildren() do
			hookTool(child)
		end
		container.ChildAdded:Connect(hookTool)
	end
	local function onCharacter(character)
		watch(character)
		watch(player:WaitForChild("Backpack"))
	end
	player.CharacterAdded:Connect(onCharacter)
	if player.Character then
		onCharacter(player.Character)
	end
end

return ToolController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="66">
            <Properties>
              <string name="Name">TouchController</string>
              <string name="Source"><![CDATA[--[[
	TouchController
	On-screen buttons for phones and tablets (only shown on touch screens).
	  Always      Map size, Camera mode
	  Building    Place, Rotate, Cancel (a tap moves the preview first)
	  At a helm   hold Row / Back / Left / Right, and Volley
	The camera: pinch to zoom, twist two fingers to turn, drag two fingers to
	tilt (CameraController). Tools work by tapping where you want to strike
	or shoot. Prompts (gather, loot, talk) are tapped like buttons.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local TouchController = {}

local controllers
local player = Players.LocalPlayer

local ACCENT = Color3.fromRGB(214, 170, 92)
local PANEL = Color3.fromRGB(20, 20, 22)

local function new(className, props)
	local inst = Instance.new(className)
	for k, v in props do
		if k ~= "Parent" then
			inst[k] = v
		end
	end
	inst.Parent = props.Parent
	return inst
end

local function roundButton(parent, text: string, size: number, pos: UDim2, textSize: number?)
	local b = new("TextButton", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = pos,
		Size = UDim2.fromOffset(size, size),
		BackgroundColor3 = PANEL,
		BackgroundTransparency = 0.15,
		AutoButtonColor = true,
		Font = Enum.Font.GothamBold,
		TextSize = textSize or 16,
		TextColor3 = ACCENT,
		TextWrapped = true,
		Text = text,
		Parent = parent,
	})
	new("UICorner", { CornerRadius = UDim.new(1, 0), Parent = b })
	new("UIStroke", { Color = ACCENT, Thickness = 1.5, Transparency = 0.4, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = b })
	return b
end

-- A button that sets a value while held down.
local function holdButton(parent, text: string, pos: UDim2, onDown, onUp)
	local b = roundButton(parent, text, 64, pos, 26)
	b.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
			onDown()
		end
	end)
	b.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
			onUp()
		end
	end)
	return b
end

function TouchController:Init(all)
	controllers = all
end

function TouchController:Start()
	if not UserInputService.TouchEnabled then
		return
	end
	local gui = new("ScreenGui", { Name = "TouchControls", ResetOnSpawn = false, DisplayOrder = 5, Parent = player:WaitForChild("PlayerGui") })

	-- always: small helpers on the right edge, above the jump button
	local side = new("Frame", {
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -16, 1, -190),
		Size = UDim2.fromOffset(60, 130),
		BackgroundTransparency = 1,
		Parent = gui,
	})
	local mapButton = roundButton(side, "Map", 54, UDim2.new(0.5, 0, 0, 27), 14)
	mapButton.Activated:Connect(function()
		if controllers.MinimapController and controllers.MinimapController.Toggle then
			controllers.MinimapController:Toggle()
		end
	end)
	local camButton = roundButton(side, "Cam", 54, UDim2.new(0.5, 0, 0, 95), 14)
	camButton.Activated:Connect(function()
		controllers.CameraController:Toggle()
	end)

	-- building: Place / Rotate / Cancel, above the build menu
	local build = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -320),
		Size = UDim2.fromOffset(300, 70),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = gui,
	})
	local place = roundButton(build, "✔\nPlace", 68, UDim2.new(0.5, 0, 0.5, 0), 15)
	place.BackgroundColor3 = Color3.fromRGB(46, 84, 44)
	place.Activated:Connect(function()
		controllers.BuildController:Confirm()
	end)
	local rotate = roundButton(build, "⟳\nTurn", 60, UDim2.new(0.5, -96, 0.5, 0), 14)
	rotate.Activated:Connect(function()
		controllers.BuildController:Rotate()
	end)
	local cancel = roundButton(build, "✖\nStop", 60, UDim2.new(0.5, 96, 0.5, 0), 14)
	cancel.Activated:Connect(function()
		controllers.BuildController:Cancel()
	end)
	controllers.BuildController.ModeChanged:Connect(function(mode)
		build.Visible = mode ~= nil
		rotate.Visible = mode ~= nil and mode.kind == "place"
		place.Text = (mode and mode.kind == "demolish") and "✔\nTear down" or "✔\nPlace"
	end)

	-- sailing: hold buttons for the oars and rudder, and the volley
	local boat = new("Frame", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 24, 1, -40),
		Size = UDim2.fromOffset(220, 220),
		BackgroundTransparency = 1,
		Visible = false,
		Parent = gui,
	})
	local Boat = controllers.BoatController
	holdButton(boat, "▲", UDim2.fromOffset(110, 40), function()
		Boat.TouchThrottle = 1
	end, function()
		Boat.TouchThrottle = 0
	end)
	holdButton(boat, "▼", UDim2.fromOffset(110, 180), function()
		Boat.TouchThrottle = -1
	end, function()
		Boat.TouchThrottle = 0
	end)
	holdButton(boat, "◀", UDim2.fromOffset(40, 110), function()
		Boat.TouchSteer = -1
	end, function()
		Boat.TouchSteer = 0
	end)
	holdButton(boat, "▶", UDim2.fromOffset(180, 110), function()
		Boat.TouchSteer = 1
	end, function()
		Boat.TouchSteer = 0
	end)
	local volley = roundButton(gui, "🏹\nVolley", 76, UDim2.new(1, -150, 1, -110), 15)
	volley.Visible = false
	volley.Activated:Connect(function()
		Boat:Volley()
	end)

	local wasAtHelm = false
	RunService.Heartbeat:Connect(function()
		local atHelm = Boat.AtHelm and Boat.AtHelm() or false
		if atHelm ~= wasAtHelm then
			wasAtHelm = atHelm
			boat.Visible = atHelm
			volley.Visible = atHelm
			if not atHelm then
				Boat.TouchThrottle = 0
				Boat.TouchSteer = 0
			end
		end
	end)
end

return TouchController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="67">
            <Properties>
              <string name="Name">TradeController</string>
              <string name="Source"><![CDATA[--[[
	TradeController
	The trade window that opens at Ottar's stall on your beach. Each row
	swaps what you give for what you get; click Trade to do it. Prices that
	change with the season are marked. Walk away or press X to close.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Config = require(Shared.Config)
local Grid = require(Shared.Grid)
local Remotes = require(Shared.Remotes)

local TradeController = {}

local controllers
local player = Players.LocalPlayer

local THEME = {
	Panel = Color3.fromRGB(20, 20, 22),
	Row = Color3.fromRGB(38, 38, 41),
	Accent = Color3.fromRGB(226, 206, 160),
	Text = Color3.fromRGB(238, 234, 226),
	Muted = Color3.fromRGB(156, 152, 146),
	Good = Color3.fromRGB(130, 200, 110),
	Bad = Color3.fromRGB(230, 110, 96),
}

local function new(className, props)
	local inst = Instance.new(className)
	for k, v in props do
		if k ~= "Parent" then
			inst[k] = v
		end
	end
	inst.Parent = props.Parent
	return inst
end

local function price(offer)
	local season = workspace:GetAttribute("Season") or "Summer"
	local mult = offer.Season and offer.Season[season] or 1
	local give = {}
	for res, n in offer.Give do
		give[res] = math.max(1, math.floor(n * mult + 0.5))
	end
	return give, mult
end

function TradeController:Init(all)
	controllers = all
end

function TradeController:Start()
	local gui = new("ScreenGui", { Name = "Trade", ResetOnSpawn = false, DisplayOrder = 9, Parent = player:WaitForChild("PlayerGui") })
	local panel = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(460, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = THEME.Panel,
		BackgroundTransparency = 0.04,
		Visible = false,
		Parent = gui,
	})
	new("UICorner", { CornerRadius = UDim.new(0, 12), Parent = panel })
	new("UIStroke", { Color = THEME.Accent, Thickness = 2, Transparency = 0.4, Parent = panel })
	new("UIPadding", { PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 14), PaddingTop = UDim.new(0, 12), PaddingBottom = UDim.new(0, 14), Parent = panel })
	new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = panel })

	local header = new("Frame", { Size = UDim2.new(1, 0, 0, 34), BackgroundTransparency = 1, LayoutOrder = 0, Parent = panel })
	new("TextLabel", {
		Size = UDim2.new(1, -40, 1, 0),
		BackgroundTransparency = 1,
		Font = Enum.Font.Garamond,
		TextSize = 28,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = THEME.Accent,
		Text = "Ottar's Stall",
		Parent = header,
	})
	local close = new("TextButton", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.fromOffset(32, 32),
		BackgroundColor3 = THEME.Row,
		Font = Enum.Font.GothamBold,
		TextSize = 18,
		TextColor3 = THEME.Text,
		Text = "X",
		Parent = header,
	})
	new("UICorner", { CornerRadius = UDim.new(0, 6), Parent = close })
	local seasonLabel = new("TextLabel", {
		Size = UDim2.new(1, 0, 0, 18),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamMedium,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = THEME.Muted,
		LayoutOrder = 1,
		Parent = panel,
	})
	local status = new("TextLabel", {
		Size = UDim2.new(1, 0, 0, 18),
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamMedium,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = THEME.Good,
		Text = "",
		LayoutOrder = 999,
		Parent = panel,
	})

	local rows = {}
	for i, offer in Config.Trade.Offers do
		local row = new("Frame", { Size = UDim2.new(1, 0, 0, 40), BackgroundColor3 = THEME.Row, LayoutOrder = 10 + i, Parent = panel })
		new("UICorner", { CornerRadius = UDim.new(0, 8), Parent = row })
		local text = new("TextLabel", {
			Position = UDim2.fromOffset(12, 0),
			Size = UDim2.new(1, -120, 1, 0),
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamMedium,
			TextSize = 15,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextColor3 = THEME.Text,
			Parent = row,
		})
		local button = new("TextButton", {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -6, 0.5, 0),
			Size = UDim2.fromOffset(96, 30),
			BackgroundColor3 = Color3.fromRGB(86, 66, 34),
			Font = Enum.Font.GothamBold,
			TextSize = 15,
			TextColor3 = THEME.Accent,
			Text = "Trade",
			Parent = row,
		})
		new("UICorner", { CornerRadius = UDim.new(0, 6), Parent = button })
		button.Activated:Connect(function()
			local ok, message = Remotes.Trade:InvokeServer(i)
			status.Text = message or ""
			status.TextColor3 = ok and THEME.Good or THEME.Bad
		end)
		rows[i] = { offer = offer, text = text, button = button }
	end

	local function refresh()
		seasonLabel.Text = "Season: " .. (workspace:GetAttribute("Season") or "Summer") .. ". Food prices change with the seasons."
		local state = controllers.StateController and controllers.StateController.State
		for _, r in rows do
			local give, mult = price(r.offer)
			local tag = mult > 1.01 and "  (dear)" or (mult < 0.99 and "  (cheap)" or "")
			r.text.Text = "Give " .. Grid.costText(give) .. "   →   Get " .. Grid.costText(r.offer.Get) .. tag
			local affordable = state == nil or Grid.canAfford(state.resources, give)
			r.text.TextColor3 = affordable and THEME.Text or THEME.Muted
		end
	end

	local openedAt
	Remotes.OpenTrade.OnClientEvent:Connect(function()
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		openedAt = root and root.Position
		status.Text = ""
		refresh()
		panel.Visible = true
	end)
	close.Activated:Connect(function()
		panel.Visible = false
	end)
	local timer = 0
	RunService.Heartbeat:Connect(function(dt)
		if not panel.Visible then
			return
		end
		timer += dt
		if timer > 0.5 then
			timer = 0
			refresh()
			local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			if root and openedAt and (root.Position - openedAt).Magnitude > 16 then
				panel.Visible = false
			end
		end
	end)
end

return TradeController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="68">
            <Properties>
              <string name="Name">UIScaleController</string>
              <string name="Source"><![CDATA[--[[
	UIScaleController
	Shrinks every screen of the interface to fit smaller windows, laptops,
	tablets and phones, so nothing runs off the edge. Designed at 1500x860;
	never scales up, never below 60%.
]]

local Players = game:GetService("Players")

local UIScaleController = {}

local DESIGN = Vector2.new(1500, 860)

local function scaleFor(viewport: Vector2): number
	return math.clamp(math.min(viewport.X / DESIGN.X, viewport.Y / DESIGN.Y), 0.6, 1)
end

function UIScaleController:Start()
	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
	local camera = workspace.CurrentCamera
	local scales = {}

	local function apply()
		local s = scaleFor(camera.ViewportSize)
		for _, ui in scales do
			ui.Scale = s
		end
	end

	local function hook(gui: Instance)
		if gui:IsA("ScreenGui") and not gui:FindFirstChild("AutoScale") then
			local ui = Instance.new("UIScale")
			ui.Name = "AutoScale"
			ui.Parent = gui
			table.insert(scales, ui)
			apply()
		end
	end

	for _, gui in playerGui:GetChildren() do
		hook(gui)
	end
	playerGui.ChildAdded:Connect(hook)
	camera:GetPropertyChangedSignal("ViewportSize"):Connect(apply)
end

return UIScaleController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="69">
            <Properties>
              <string name="Name">VillagerAnimController</string>
              <string name="Source"><![CDATA[--[[
	VillagerAnimController
	Makes the little villager figures walk: their arms and legs swing in
	step while they move and come to rest when they stop. Purely visual and
	done on each player's own screen (the server only moves the bodies).
	Only villagers near the camera are animated, to keep it cheap.
	Workers also show their work (the server sets the model's Task and Carry):
	  Chop / Mine   an axe or pick raised and brought down
	  Farm          a hoe worked along the rows
	  Hammer        a hammer beating, the other hand steadying
	  Carry         a log, stone, sack or hide held in both arms on the way
	                to the storehouse
]]

local RunService = game:GetService("RunService")

local VillagerAnimController = {}

local figures = {} -- [model] = { body, limbs = { {weld, hip, half, side, isArm} }, last, phase, amount }
local RANGE = 160

local function track(model: Model)
	if figures[model] or not model:GetAttribute("Villager") then
		return
	end
	local body = model.PrimaryPart or model:FindFirstChild("Body")
	if not body then
		return
	end
	local limbs = {}
	for _, part in model:GetChildren() do
		local joint = part:IsA("BasePart") and part:FindFirstChild("Joint")
		if joint and joint:IsA("Weld") and part:GetAttribute("Hip") then
			table.insert(limbs, {
				weld = joint,
				hip = part:GetAttribute("Hip"),
				half = part:GetAttribute("HalfLen") or 0.5,
				side = part:GetAttribute("Side") or 1,
				isArm = part.Name == "Arm",
			})
		end
	end
	if #limbs == 0 then
		return
	end
	figures[model] = { model = model, body = body, limbs = limbs, last = body.Position, phase = math.random() * 6, amount = 0, work = math.random() * 4 }
end

-- Little props made on this screen only and welded to the figure.
local function prop(parent: BasePart, size: Vector3, offset: CFrame, color: Color3, material: Enum.Material?, shape: Enum.PartType?): BasePart
	local p = Instance.new("Part")
	p.Name = "WorkProp"
	p.Size = size
	p.Color = color
	p.Material = material or Enum.Material.Wood
	if shape then
		p.Shape = shape
	end
	p.Anchored = false
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Massless = true
	p.CFrame = parent.CFrame * offset
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = parent
	weld.Part1 = p
	weld.Parent = p
	p.Parent = parent
	return p
end

local WOOD = Color3.fromRGB(138, 100, 64)
local IRON = Color3.fromRGB(110, 112, 118)

-- A tool in the right hand, pointing forward out of the fist.
local function makeTool(arm: BasePart, kind: string): { BasePart }
	local k = arm.Size.X -- scales with the figure
	local hand = CFrame.new(0, -arm.Size.Y / 2, 0)
	local parts = {}
	local function add(size, offset, color, material, shape)
		table.insert(parts, prop(arm, size * k, hand * offset, color, material, shape))
	end
	local along = CFrame.Angles(math.pi / 2, 0, 0) -- haft along -Z (forward)
	if kind == "Chop" then
		add(Vector3.new(0.16, 2.4, 0.16), CFrame.new(0, 0, -0.8 * k) * along, WOOD)
		add(Vector3.new(0.12, 0.7, 0.75), CFrame.new(0, 0.35 * k, -1.9 * k), IRON, Enum.Material.Metal)
	elseif kind == "Mine" then
		add(Vector3.new(0.16, 2.4, 0.16), CFrame.new(0, 0, -0.8 * k) * along, WOOD)
		add(Vector3.new(0.18, 2.0, 0.22), CFrame.new(0, 0, -1.95 * k), IRON, Enum.Material.Metal)
	elseif kind == "Farm" then
		add(Vector3.new(0.14, 3.2, 0.14), CFrame.new(0, 0, -1.1 * k) * along, WOOD)
		add(Vector3.new(0.9, 0.1, 0.5), CFrame.new(0, -0.25 * k, -2.65 * k), IRON, Enum.Material.Metal)
	elseif kind == "Hammer" then
		add(Vector3.new(0.14, 1.3, 0.14), CFrame.new(0, 0, -0.45 * k) * along, WOOD)
		add(Vector3.new(0.3, 0.5, 0.3), CFrame.new(0, 0.1 * k, -1.05 * k), IRON, Enum.Material.Metal)
	end
	return parts
end

-- A load held in front with both arms.
local function makeLoad(body: BasePart, kind: string): { BasePart }
	local k = body.Size.Y / 2
	local front = CFrame.new(0, -0.1 * k, -body.Size.Z / 2 - 0.55 * k)
	if kind == "Log" then
		return { prop(body, Vector3.new(3.0, 0.75, 0.75) * k, front * CFrame.new(0, 0.2 * k, 0), Color3.fromRGB(122, 86, 54), Enum.Material.Wood, Enum.PartType.Cylinder) }
	elseif kind == "Stone" then
		return { prop(body, Vector3.new(1.3, 0.9, 0.9) * k, front, Color3.fromRGB(140, 138, 132), Enum.Material.Slate) }
	elseif kind == "Sack" then
		return { prop(body, Vector3.new(1.2, 1.4, 1.0) * k, front, Color3.fromRGB(176, 156, 112), Enum.Material.Fabric) }
	elseif kind == "Hide" then
		return { prop(body, Vector3.new(1.6, 0.5, 1.0) * k, front * CFrame.new(0, 0.2 * k, 0), Color3.fromRGB(150, 108, 72), Enum.Material.Fabric) }
	end
	return {}
end

local function clearProps(list)
	for _, p in list or {} do
		p:Destroy()
	end
end

-- Arm angle (forward swing, radians) for a work pose at time t.
local function workAngle(kind: string, t: number, right: boolean): number
	if kind == "Chop" or kind == "Mine" then
		-- raise slowly over the head, strike fast; both hands on the haft
		local p = (t * 0.9) % 1
		if p < 0.7 then
			return 0.5 + 2.3 * (p / 0.7)
		end
		return 2.8 - 2.3 * ((p - 0.7) / 0.3)
	elseif kind == "Farm" then
		return 0.7 + 0.45 * math.sin(t * 3)
	elseif kind == "Hammer" then
		if right then
			return 1.1 + 0.8 * math.abs(math.sin(t * 4.5))
		end
		return 0.8
	end
	return 0
end

function VillagerAnimController:Start()
	-- villager models appear inside every plot's Villagers folder; watch the
	-- whole workspace for them (they can be rebuilt when someone grows up)
	workspace.DescendantAdded:Connect(function(inst)
		if inst:IsA("Model") and inst:GetAttribute("Villager") then
			task.defer(track, inst)
		end
	end)
	for _, inst in workspace:GetDescendants() do
		if inst:IsA("Model") and inst:GetAttribute("Villager") then
			track(inst)
		end
	end

	local camera = workspace.CurrentCamera
	RunService.RenderStepped:Connect(function(dt)
		local camPos = camera and camera.CFrame.Position or Vector3.zero
		for model, f in figures do
			if not model.Parent then
				figures[model] = nil
				continue
			end
			local pos = f.body.Position
			if (pos - camPos).Magnitude > RANGE then
				f.last = pos
				continue
			end
			local moved = Vector3.new(pos.X - f.last.X, 0, pos.Z - f.last.Z).Magnitude
			f.last = pos
			local speed = dt > 0 and moved / dt or 0
			local moving = speed > 0.5
			f.amount += ((moving and 1 or 0) - f.amount) * math.min(1, dt * 8)
			f.phase += dt * math.clamp(speed, 0, 12) * 1.4
			local swing = math.sin(f.phase) * 0.7 * f.amount
			local work = f.model:GetAttribute("Task")
			local carry = f.model:GetAttribute("Carry")
			local working = work ~= nil and f.amount < 0.3
			-- tools and loads appear and go as the work changes
			if work ~= f.toolKind then
				clearProps(f.tool)
				f.tool = nil
				f.toolKind = work
				if work then
					for _, limb in f.limbs do
						if limb.isArm and limb.side == 1 then
							f.tool = makeTool(limb.weld.Part1, work)
						end
					end
				end
			end
			if carry ~= f.loadKind then
				clearProps(f.load)
				f.loadKind = carry
				f.load = carry and makeLoad(f.body, carry) or nil
			end
			if working then
				f.work += dt
			end
			local guard = f.model:GetAttribute("Guard")
			for _, limb in f.limbs do
				local angle = swing * limb.side * (limb.isArm and 0.8 or 1)
				if limb.isArm and guard and limb.side ~= 1 then
					-- in the wall: the arm comes up and turns so the shield faces front
					limb.weld.C0 = limb.hip * CFrame.Angles(0.7, 0, 0) * CFrame.Angles(0, -math.pi / 2, 0) * CFrame.new(0, -limb.half, 0)
					continue
				elseif limb.isArm and carry then
					angle = 0.95 -- both arms hold the load
				elseif limb.isArm and working then
					angle = workAngle(work, f.work, limb.side == 1)
				end
				limb.weld.C0 = limb.hip * CFrame.Angles(angle, 0, 0) * CFrame.new(0, -limb.half, 0)
			end
		end
	end)
end

return VillagerAnimController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="70">
            <Properties>
              <string name="Name">WeatherFxController</string>
              <string name="Source"><![CDATA[--[[
	WeatherFxController
	Draws the weather that WeatherService picks (workspace attributes
	Weather, FogLevel, StormLevel):
	  Storm  slanting rain around the camera, lightning flashes, thunder,
	         and a rain sound (Sounds slots Rain / Thunder)
	  Fog    low drifting mist close to the ground and water
	The haze itself is thickened on the server, so everyone sees the same sky.
]]

local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Sounds = require(Shared.Sounds)

local WeatherFxController = {}

local SPARKLE = "rbxasset://textures/particles/sparkles_main.dds"
local SMOKE = "rbxasset://textures/particles/smoke_main.dds"

function WeatherFxController:Start()
	local box = Instance.new("Part")
	box.Name = "StormBox"
	box.Anchored = true
	box.CanCollide = false
	box.CanQuery = false
	box.CanTouch = false
	box.Transparency = 1
	box.Size = Vector3.new(140, 1, 140)
	box.Parent = workspace

	-- rain: long thin streaks, falling fast and a little sideways in the wind
	local rain = Instance.new("ParticleEmitter")
	rain.Texture = SPARKLE
	rain.Color = ColorSequence.new(Color3.fromRGB(190, 205, 220))
	rain.Transparency = NumberSequence.new(0.35)
	rain.LightInfluence = 1
	rain.Size = NumberSequence.new(0.12)
	rain.Squash = NumberSequence.new(-3.5) -- stretched into streaks
	rain.Orientation = Enum.ParticleOrientation.VelocityParallel
	rain.Lifetime = NumberRange.new(0.9, 1.2)
	rain.Speed = NumberRange.new(70, 85)
	rain.SpreadAngle = Vector2.new(4, 4)
	rain.EmissionDirection = Enum.NormalId.Bottom
	rain.Acceleration = Vector3.new(14, 0, 6)
	rain.Rate = 0
	rain.Parent = box

	-- fog: big soft puffs drifting low
	local mistBox = Instance.new("Part")
	mistBox.Name = "MistBox"
	mistBox.Anchored = true
	mistBox.CanCollide = false
	mistBox.CanQuery = false
	mistBox.CanTouch = false
	mistBox.Transparency = 1
	mistBox.Size = Vector3.new(220, 6, 220)
	mistBox.Parent = workspace
	local mist = Instance.new("ParticleEmitter")
	mist.Texture = SMOKE
	mist.Color = ColorSequence.new(Color3.fromRGB(220, 224, 226))
	mist.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.3, 0.82),
		NumberSequenceKeypoint.new(0.7, 0.85),
		NumberSequenceKeypoint.new(1, 1),
	})
	mist.LightInfluence = 1
	mist.Size = NumberSequence.new(28, 40)
	mist.Lifetime = NumberRange.new(10, 16)
	mist.Speed = NumberRange.new(1, 2.5)
	mist.SpreadAngle = Vector2.new(180, 10)
	mist.RotSpeed = NumberRange.new(-6, 6)
	mist.Rotation = NumberRange.new(0, 360)
	mist.Rate = 0
	mist.Parent = mistBox

	-- the flash is a brief bright grade on this screen only
	local flash = Instance.new("ColorCorrectionEffect")
	flash.Name = "LightningFlash"
	flash.Brightness = 0
	flash.Parent = Lighting

	local rainSound = Sounds.loop("Rain", SoundService)
	if rainSound then
		rainSound.Volume = 0
	end
	local rainVolume = Sounds.Slots.Rain and Sounds.Slots.Rain.Volume or 0.5

	local function lightning()
		local seq = { 0.55, 0, 0.35, 0 }
		task.spawn(function()
			for i, b in seq do
				flash.Brightness = b
				task.wait(i % 2 == 1 and 0.06 or 0.09)
			end
			flash.Brightness = 0
			task.wait(Random.new():NextNumber(0.6, 2.4)) -- sound is slower than light
			Sounds.play("Thunder", SoundService)
		end)
	end

	local nextBolt = os.clock() + 8
	local rng = Random.new()
	RunService.RenderStepped:Connect(function()
		local cam = workspace.CurrentCamera.CFrame.Position
		local storm = workspace:GetAttribute("StormLevel") or 0
		local fog = workspace:GetAttribute("FogLevel") or 0
		local season = workspace:GetAttribute("Season")

		box.CFrame = CFrame.new(cam.X - 20, cam.Y + 40, cam.Z - 8)
		-- in winter the storm falls as heavy snow (SeasonFxController), not rain
		rain.Rate = season == "Winter" and 0 or storm * 900
		if rainSound then
			rainSound.Volume = rainVolume * storm
		end

		mistBox.CFrame = CFrame.new(cam.X, math.max(2, cam.Y - 30), cam.Z)
		mist.Rate = fog * 5

		if storm > 0.6 and os.clock() > nextBolt then
			lightning()
			nextBolt = os.clock() + rng:NextNumber(6, 16)
		end
	end)

	-- fade the flash back if anything left it on
	workspace:GetAttributeChangedSignal("Weather"):Connect(function()
		TweenService:Create(flash, TweenInfo.new(0.3), { Brightness = 0 }):Play()
	end)
end

return WeatherFxController
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="71">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="NeedsPivotMigration">false</bool>
    </Properties>
    <Item class="Part" referent="72">
      <Properties>
        <string name="Name">Baseplate</string>
        <bool name="Anchored">true</bool>
        <token name="BottomSurface">0</token>
